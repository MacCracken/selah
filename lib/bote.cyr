# Requires (compile-verified; the leaves of dist/bote.deps):
include "lib/hashmap.cyr"
include "lib/ws_server.cyr"
include "lib/bayan.cyr"
include "lib/syscalls.cyr"

# --- log.cyr ---

# bote::log — operational logging through sakshi.
#
# ## Before you compile this (it is the first module of both dist bundles)
#
# Minimum cyrius: 6.7.13
#
#   6.7.13 and later compile both bundles, pass the core-only smoke test and
#   answer a ping. 6.7.2 through 6.7.12 still compile dist/bote-core.cyr, but
#   stop on dist/bote.cyr with "undefined variable
#   'SANDHI_SERVER_FAIL_CONFIG'": its transports need sandhi 1.10.10. 6.7.1 and
#   earlier stop at the first `const` below, with "expected '=', got
#   identifier". scripts/bundle-min-cyrius.sh measures this on every installed
#   toolchain. Re-run it at every pin move, and whenever bote starts using a
#   newer language feature.
#
#   A copied bundle (src/vendor/bote-core.cyr) rather than a [deps.bote]
#   pin must also declare "sakshi" in its own [deps] stdlib. This module
#   calls sakshi, and the bundle's requires block does not include it. A
#   pinned consumer gets sakshi through bote's deps.libro (patra includes
#   it); a copied file brings neither. Without it the build stops on
#   undefined sakshi_* functions.
#
# ## Contract
#
# - **Every line goes through sakshi**, to sakshi's configured output, which
#   is stderr unless an embedder or `BOTE_LOG_FILE` says otherwise. Never
#   stdout: on the stdio transport stdout is the JSON-RPC wire, and one stray
#   byte there corrupts the client's stream.
# - **Library code never configures sakshi.** Modules call `bote_log_*` and
#   sakshi's level filter decides. Only an entry point calls `bote_log_init`,
#   which reads `BOTE_LOG` / `BOTE_LOG_FILE`. An embedder that vendors a dist
#   bundle keeps its own `sakshi_set_level` / `sakshi_output_*` choices, and
#   bote's lines land wherever it sends sakshi's.
# - **Levels** (sakshi's): ERROR for a failure an operator must act on
#   (a bind that failed, a listener given up), WARN for a refusal or an
#   anomaly the process survives (an auth rejection, an SSRF block, a path
#   escape), INFO for lifecycle (starting, listening, stopped), DEBUG for
#   one line per request, TRACE for what is under a request (it also turns
#   on sandhi's spans in the binaries).
# - **Never log a secret.** No bearer token, JWT, cookie, request body or
#   tool argument goes into a line. A tool name, a method name, a status,
#   a length or an errno does.
#
# ## Building a line without the heap
#
# A line lives in a buffer on the caller's stack, `BOTE_LOG_LINE_BYTES` long:
#
#   var ln[BOTE_LOG_LINE_BYTES];
#   bote_log_line(&ln, SK_INFO, "listening");
#   bote_log_str(&ln, "transport", "http");
#   bote_log_int(&ln, "port", port);
#   bote_log_emit(&ln);
#
# renders `listening transport=http port=8390`. When the level is filtered
# out, `bote_log_line` marks the buffer dead and every later call on it
# returns at once, so a suppressed line costs one compare and builds nothing.
# Nothing here allocates: the dispatch hot path can carry a DEBUG line at no
# measurable cost while the level is INFO (benches: 3.4.0 CHANGELOG).
#
# Buffer layout: +0 level, +8 used bytes (-1 = dead), +16 truncated flag,
# +24 text (`BOTE_LOG_TEXT_CAP` bytes).
#
# ## Values are logfmt, and request-derived ones are escaped
#
# `bote_log_str` writes `key=value`. A value made only of printable ASCII,
# with no space, `"`, `=` or `\`, goes out bare. Anything else is quoted:
# `"` and `\` are backslash-escaped, `\n` `\r` `\t` are spelled out, and any
# other control byte (and 0x7F) is `\xHH`. Bytes 0x80 and up pass through, so
# UTF-8 survives. A tool name or a JSON-RPC method comes from the client, so
# without this a value holding `\n[1] [ERROR] ...` would forge a second log
# line. A value longer than `BOTE_LOG_VALUE_MAX` bytes is cut and ends `...`.
# A line that outgrows its buffer ends `...` too.

# A compiler older than cyrius 6.7.2 stops on the next line with "expected
# '=', got identifier": it has no `const`. See "Minimum cyrius" at the top of
# this module.
const BOTE_LOG_LINE_BYTES = 280;
const BOTE_LOG_TEXT_CAP = 216;

var BOTE_LOG_OFF = 0 - 1;
var BOTE_LOG_UNKNOWN = 0 - 100;
var BOTE_LOG_VALUE_MAX = 96;

# ================================================================
# Level names
# ================================================================

# ASCII-case-insensitive equality of cstring `s` and lowercase literal `lit`.
fn _bote_log_name_is(s, lit): i64 {
    var i = 0;
    while (1 == 1) {
        var a = load8(s + i) & 0xFF;
        var b = load8(lit + i) & 0xFF;
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (a != b) { return 0; }
        if (a == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Map a level name to sakshi's SK_*. `off` / `none` give BOTE_LOG_OFF, which
# filters out even FATAL. Anything else, and a null pointer, gives
# BOTE_LOG_UNKNOWN so the caller can leave the level where it is.
fn bote_log_level_from_name(name): i64 {
    if (name == 0) { return BOTE_LOG_UNKNOWN; }
    if (_bote_log_name_is(name, "off") == 1) { return BOTE_LOG_OFF; }
    if (_bote_log_name_is(name, "none") == 1) { return BOTE_LOG_OFF; }
    if (_bote_log_name_is(name, "fatal") == 1) { return SK_FATAL; }
    if (_bote_log_name_is(name, "error") == 1) { return SK_ERROR; }
    if (_bote_log_name_is(name, "warn") == 1) { return SK_WARN; }
    if (_bote_log_name_is(name, "warning") == 1) { return SK_WARN; }
    if (_bote_log_name_is(name, "info") == 1) { return SK_INFO; }
    if (_bote_log_name_is(name, "debug") == 1) { return SK_DEBUG; }
    if (_bote_log_name_is(name, "trace") == 1) { return SK_TRACE; }
    return BOTE_LOG_UNKNOWN;
}

# Lowercase name of a level, as `BOTE_LOG` spells it: the inverse of
# bote_log_level_from_name for every level it returns. Below FATAL is "off".
fn bote_log_level_name(level): i64 {
    if (level < SK_FATAL) { return "off"; }
    if (level == SK_FATAL) { return "fatal"; }
    if (level == SK_ERROR) { return "error"; }
    if (level == SK_WARN) { return "warn"; }
    if (level == SK_INFO) { return "info"; }
    if (level == SK_DEBUG) { return "debug"; }
    return "trace";
}

# 1 when a line at `level` would be emitted at sakshi's current level.
fn bote_log_enabled(level): i64 {
    if (level <= sakshi_get_level()) { return 1; }
    return 0;
}

# ================================================================
# Plain messages (a trusted cstring literal, no fields)
# ================================================================

# Hand `len` bytes at `msg` to sakshi at `level`. The per-level calls keep
# sakshi's compile-time elision (`SAKSHI_LEVEL`, `SAKSHI_DISABLE_*`) working.
fn _bote_log_send(level, msg, len): i64 {
    if (level == SK_FATAL) { return sakshi_fatal(msg, len); }
    if (level == SK_ERROR) { return sakshi_error(msg, len); }
    if (level == SK_WARN) { return sakshi_warn(msg, len); }
    if (level == SK_INFO) { return sakshi_info(msg, len); }
    if (level == SK_DEBUG) { return sakshi_debug(msg, len); }
    return sakshi_trace(msg, len);
}

# The level check here is a fast path that skips the strlen. sakshi's own
# filter is the authority: its per-level calls check again, so dropping this
# line changes cost, not output.
fn bote_log(level, msg): i64 {
    if (level > sakshi_get_level()) { return 0; }
    return _bote_log_send(level, msg, strlen(msg));
}

fn bote_log_fatal(msg): i64 { return bote_log(SK_FATAL, msg); }
fn bote_log_error(msg): i64 { return bote_log(SK_ERROR, msg); }
fn bote_log_warn(msg): i64 { return bote_log(SK_WARN, msg); }
fn bote_log_info(msg): i64 { return bote_log(SK_INFO, msg); }
fn bote_log_debug(msg): i64 { return bote_log(SK_DEBUG, msg); }
fn bote_log_trace(msg): i64 { return bote_log(SK_TRACE, msg); }

# ================================================================
# Lines with fields
# ================================================================

# Append one byte to the line. When it is full, end the text with "..."
# once and drop the rest.
fn _bote_log_put(ln, b): i64 {
    var used = load64(ln + 8);
    if (used < 0) { return 0; }
    if (used >= BOTE_LOG_TEXT_CAP) {
        if (load64(ln + 16) == 0) {
            store64(ln + 16, 1);
            store8(ln + 24 + BOTE_LOG_TEXT_CAP - 3, 46);
            store8(ln + 24 + BOTE_LOG_TEXT_CAP - 2, 46);
            store8(ln + 24 + BOTE_LOG_TEXT_CAP - 1, 46);
        }
        return 0;
    }
    store8(ln + 24 + used, b);
    store64(ln + 8, used + 1);
    return 0;
}

fn _bote_log_put_cstr(ln, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        _bote_log_put(ln, load8(s + i));
        i = i + 1;
    }
    return 0;
}

fn _bote_log_hex_digit(n): i64 {
    if (n < 10) { return 48 + n; }
    return 87 + n;                  # 'a' - 10
}

# 1 when byte `c` may appear in a bare (unquoted) logfmt value.
fn _bote_log_bare_byte(c): i64 {
    if (c <= 32) { return 0; }      # control bytes and space
    if (c >= 127) { return 0; }     # DEL, and 0x80+ (quoted so UTF-8 stays one token)
    if (c == 34) { return 0; }      # "
    if (c == 61) { return 0; }      # =
    if (c == 92) { return 0; }      # backslash
    return 1;
}

# Start a line at `level` with the trusted message `msg`. When the level is
# filtered out the line is dead, and every call on it is a no-op.
fn bote_log_line(ln, level, msg): i64 {
    store64(ln, level);
    store64(ln + 16, 0);
    if (level > sakshi_get_level()) {
        store64(ln + 8, 0 - 1);
        return 0;
    }
    store64(ln + 8, 0);
    _bote_log_put_cstr(ln, msg);
    return 0;
}

# Append ` key=value`. `key` is a trusted literal; `val` is any cstring
# (request-derived or not) and is escaped as the header describes. A null
# `val` is written as `""`.
fn bote_log_str(ln, key, val): i64 {
    if (load64(ln + 8) < 0) { return 0; }
    _bote_log_put(ln, 32);
    _bote_log_put_cstr(ln, key);
    _bote_log_put(ln, 61);
    if (val == 0) {
        _bote_log_put(ln, 34);
        _bote_log_put(ln, 34);
        return 0;
    }
    var n = strlen(val);
    var cut = 0;
    if (n > BOTE_LOG_VALUE_MAX) { n = BOTE_LOG_VALUE_MAX; cut = 1; }
    var bare = 1;
    if (n == 0) { bare = 0; }
    var i = 0;
    while (i < n) {
        if (_bote_log_bare_byte(load8(val + i) & 0xFF) == 0) { bare = 0; }
        i = i + 1;
    }
    if (bare == 0) { _bote_log_put(ln, 34); }
    i = 0;
    while (i < n) {
        var c = load8(val + i) & 0xFF;
        if (bare == 1) {
            _bote_log_put(ln, c);
        } elif (c == 34 || c == 92) {
            _bote_log_put(ln, 92);
            _bote_log_put(ln, c);
        } elif (c == 10) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 110);
        } elif (c == 13) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 114);
        } elif (c == 9) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 116);
        } elif (c < 32 || c == 127) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 120);
            _bote_log_put(ln, _bote_log_hex_digit(c >> 4));
            _bote_log_put(ln, _bote_log_hex_digit(c & 15));
        } else {
            _bote_log_put(ln, c);
        }
        i = i + 1;
    }
    if (cut == 1) {
        _bote_log_put(ln, 46); _bote_log_put(ln, 46); _bote_log_put(ln, 46);
    }
    if (bare == 0) { _bote_log_put(ln, 34); }
    return 0;
}

# Append ` key=<decimal n>`.
fn bote_log_int(ln, key, n): i64 {
    if (load64(ln + 8) < 0) { return 0; }
    _bote_log_put(ln, 32);
    _bote_log_put_cstr(ln, key);
    _bote_log_put(ln, 61);
    if (n == 0) { return _bote_log_put(ln, 48); }
    var digits[24];
    var k = 0;
    var neg = 0;
    if (n < 0) { neg = 1; }
    # Digits from the (possibly negative) value without negating it, so
    # i64::MIN formats instead of overflowing back to itself.
    while (n != 0) {
        var q = n / 10;
        var d = n - q * 10;
        if (d < 0) { d = 0 - d; }
        store8(&digits + k, 48 + d);
        k = k + 1;
        n = q;
    }
    if (neg == 1) { _bote_log_put(ln, 45); }
    while (k > 0) {
        k = k - 1;
        _bote_log_put(ln, load8(&digits + k));
    }
    return 0;
}

# Hand the line to sakshi. A dead line emits nothing.
fn bote_log_emit(ln): i64 {
    var used = load64(ln + 8);
    if (used < 0) { return 0; }
    return _bote_log_send(load64(ln), ln + 24, used);
}

# The text built so far and its length — for tests, and for an embedder that
# wants the rendered bytes without emitting them.
fn bote_log_line_text(ln): i64 { return ln + 24; }
fn bote_log_line_len(ln): i64 { return load64(ln + 8); }

# ================================================================
# Entry-point configuration
# ================================================================

# Configure sakshi from the environment. Call once, from a binary's main,
# after alloc_init(). Library code must not call it.
#
#   BOTE_LOG       off | fatal | error | warn | info | debug | trace
#                  (case-insensitive; `none` = off, `warning` = warn).
#                  Default: info. An unrecognised value keeps the default
#                  and is reported as a warning.
#   BOTE_LOG_FILE  append lines to this file instead of stderr. When it
#                  cannot be opened, lines stay on stderr and the failure is
#                  reported. Operator-supplied, never request-derived.
#
# Returns the level now in force.
fn bote_log_init(): i64 {
    sakshi_set_level(SK_INFO);
    var name = getenv("BOTE_LOG");
    var unknown = 0;
    if (name != 0) {
        var lv = bote_log_level_from_name(name);
        if (lv == BOTE_LOG_UNKNOWN) { unknown = 1; }
        else { sakshi_set_level(lv); }
    }
    var path = getenv("BOTE_LOG_FILE");
    if (path != 0 && load8(path) != 0) {
        var fd = sakshi_output_file(path);
        if (fd < 0) {
            var ln[BOTE_LOG_LINE_BYTES];
            bote_log_line(&ln, SK_WARN, "BOTE_LOG_FILE could not be opened; logging to stderr");
            bote_log_str(&ln, "path", path);
            bote_log_int(&ln, "errno", 0 - fd);
            bote_log_emit(&ln);
        }
    }
    if (unknown == 1) {
        var ul[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ul, SK_WARN, "BOTE_LOG not recognised; using info");
        bote_log_str(&ul, "value", name);
        bote_log_emit(&ul);
    }
    return sakshi_get_level();
}

# --- error.cyr ---

# bote::error — BoteError tags and JSON-RPC code mapping
# Mirrors rust-old/src/error.rs

enum BoteErrTag {
    BOTE_ERR_TOOL_NOT_FOUND = 0;
    BOTE_ERR_INVALID_PARAMS = 1;
    BOTE_ERR_EXEC_FAILED = 2;
    BOTE_ERR_PROTOCOL = 3;
    BOTE_ERR_PARSE = 4;
    BOTE_ERR_TRANSPORT_CLOSED = 5;
    BOTE_ERR_BIND_FAILED = 6;
    BOTE_ERR_REQUEST_CANCELLED = 7;
    BOTE_ERR_SCHEMA_VIOLATION = 8;
    BOTE_ERR_SANDBOX = 9;
    BOTE_ERR_JSON = 10;
    BOTE_ERR_IO = 11;
    BOTE_ERR_TAG_COUNT = 12;
}

# BoteError struct (32 bytes):
#   +0  tag       i64
#   +8  tool      cstr or 0
#   +16 reason    cstr or 0
#   +24 extra     vec of cstr (SCHEMA_VIOLATION violations) or 0

fn bote_err_new(tag, tool, reason) {
    return bote_err_new_a(default_alloc(), tag, tool, reason);
}

fn bote_err_new_a(a, tag, tool, reason) {
    var e = alloc_via(a, 32);
    store64(e, tag);
    store64(e + 8, tool);
    store64(e + 16, reason);
    store64(e + 24, 0);
    return e;
}

fn bote_err_with_violations(tag, tool, violations_vec) {
    return bote_err_with_violations_a(default_alloc(), tag, tool, violations_vec);
}

fn bote_err_with_violations_a(a, tag, tool, violations_vec) {
    var e = alloc_via(a, 32);
    store64(e, tag);
    store64(e + 8, tool);
    store64(e + 16, 0);
    store64(e + 24, violations_vec);
    return e;
}

fn bote_err_tag(e) { return load64(e); }
fn bote_err_tool(e) { return load64(e + 8); }
fn bote_err_reason(e) { return load64(e + 16); }
fn bote_err_violations(e) { return load64(e + 24); }

# Map a BoteErrTag to its JSON-RPC error code (negative).
#
# TOOL_NOT_FOUND is -32602 (invalid params), not -32601 (method not found).
# The method, tools/call, exists; only the `name` it was given names nothing.
# That is the MCP tools spec's own example since 2025-06-18:
# {"code":-32602,"message":"Unknown tool: invalid_tool_name"}. bote answered
# -32601 through 3.4.4. A client could read that as "this server does not
# implement tools/call".
fn bote_err_rpc_code(tag) {
    if (tag == BOTE_ERR_PARSE) { return 0 - 32700; }
    if (tag == BOTE_ERR_PROTOCOL) { return 0 - 32600; }
    if (tag == BOTE_ERR_TOOL_NOT_FOUND) { return 0 - 32602; }
    if (tag == BOTE_ERR_INVALID_PARAMS) { return 0 - 32602; }
    if (tag == BOTE_ERR_SCHEMA_VIOLATION) { return 0 - 32602; }
    if (tag == BOTE_ERR_EXEC_FAILED) { return 0 - 32000; }
    if (tag == BOTE_ERR_SANDBOX) { return 0 - 32000; }
    if (tag == BOTE_ERR_TRANSPORT_CLOSED) { return 0 - 32003; }
    if (tag == BOTE_ERR_BIND_FAILED) { return 0 - 32003; }
    if (tag == BOTE_ERR_REQUEST_CANCELLED) { return 0 - 32800; }
    if (tag == BOTE_ERR_JSON) { return 0 - 32700; }
    if (tag == BOTE_ERR_IO) { return 0 - 32603; }
    return 0 - 32603;
}

# Build a Display string for a BoteError. Mirrors the Rust thiserror messages.
fn bote_err_format(e) { return bote_err_format_a(default_alloc(), e); }

fn bote_err_format_a(a, e) {
    var tag = bote_err_tag(e);
    var tool = bote_err_tool(e);
    var reason = bote_err_reason(e);
    var sb = str_builder_new_a(a);

    if (tag == BOTE_ERR_TOOL_NOT_FOUND) {
        str_builder_add_cstr_a(a, sb, "tool not found: ");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
    } elif (tag == BOTE_ERR_INVALID_PARAMS) {
        str_builder_add_cstr_a(a, sb, "invalid params for tool '");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, "': ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_EXEC_FAILED) {
        str_builder_add_cstr_a(a, sb, "tool execution failed: ");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, " - ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_PROTOCOL) {
        str_builder_add_cstr_a(a, sb, "protocol error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_PARSE) {
        str_builder_add_cstr_a(a, sb, "parse error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_TRANSPORT_CLOSED) {
        str_builder_add_cstr_a(a, sb, "transport closed");
    } elif (tag == BOTE_ERR_BIND_FAILED) {
        str_builder_add_cstr_a(a, sb, "transport bind failed: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_REQUEST_CANCELLED) {
        str_builder_add_cstr_a(a, sb, "request cancelled: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_SCHEMA_VIOLATION) {
        str_builder_add_cstr_a(a, sb, "schema violation for tool '");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, "': ");
        var vs = bote_err_violations(e);
        if (vs != 0) {
            var n = vec_len(vs);
            var i = 0;
            while (i < n) {
                if (i > 0) { str_builder_add_cstr_a(a, sb, "; "); }
                str_builder_add_cstr_a(a, sb, vec_get(vs, i));
                i = i + 1;
            }
        }
    } elif (tag == BOTE_ERR_SANDBOX) {
        str_builder_add_cstr_a(a, sb, "sandbox error for tool '");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, "': ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_JSON) {
        str_builder_add_cstr_a(a, sb, "json error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_IO) {
        str_builder_add_cstr_a(a, sb, "io error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } else {
        str_builder_add_cstr_a(a, sb, "unknown error");
    }
    return str_builder_build_a(a, sb);
}

# --- protocol.cyr ---

# bote::protocol — JSON-RPC 2.0 types
# Mirrors rust-old/src/protocol.rs
#
# Cyrius has no nested JSON value type, so id/params/result/data are
# carried as raw JSON-literal C strings ("1", "\"abc\"", "null", "{...}").
# A 0 sentinel for `id` means "not present" (notification).

# JsonRpcRequest (32 bytes):
#   +0  jsonrpc  cstr ("2.0")
#   +8  id       cstr or 0 (0 = notification)
#   +16 method   cstr
#   +24 params   cstr or 0 (raw JSON literal, defaults to "null")

fn req_new(id, method) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, method);
    store64(r + 24, "null");
    return r;
}

fn req_notification(method) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, 0);
    store64(r + 16, method);
    store64(r + 24, "null");
    return r;
}

fn req_with_params(r, params) {
    store64(r + 24, params);
    return r;
}

fn req_jsonrpc(r) { return load64(r); }
fn req_id(r) { return load64(r + 8); }
fn req_method(r) { return load64(r + 16); }
fn req_params(r) { return load64(r + 24); }

fn req_is_notification(r) {
    if (load64(r + 8) == 0) { return 1; }
    return 0;
}

# JsonRpcError (24 bytes):
#   +0  code    i64 (i32 in Rust; cyrius is i64 always)
#   +8  message cstr
#   +16 data    cstr or 0 (raw JSON literal)

fn rpc_err_new(code, message, data) {
    var e = alloc(24);
    store64(e, code);
    store64(e + 8, message);
    store64(e + 16, data);
    return e;
}

fn rpc_err_code(e) { return load64(e); }
fn rpc_err_message(e) { return load64(e + 8); }
fn rpc_err_data(e) { return load64(e + 16); }

# JsonRpcResponse (32 bytes):
#   +0  jsonrpc  cstr ("2.0")
#   +8  id       cstr (raw JSON literal — required, even on error)
#   +16 result   cstr or 0 (raw JSON literal)
#   +24 error    ptr to JsonRpcError or 0

fn resp_success(id, result) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, result);
    store64(r + 24, 0);
    return r;
}

# The request arena (3.4.15). `alloc` never frees, so what a request leaves on
# the heap stays for the life of the process. Every byte bote allocates to
# answer one message goes here instead, and each transport rewinds it when the
# next message starts. What outlives a request stays on the heap: `args` and
# everything else a handler or a sink is handed, since either may keep it, and
# sessions.
#
# The arena is part of a request's state, a block of BOTE_REQ_STATE_BYTES:
#   +0  arena   made on first use
#   +8  token   the token an accepted request presented, on the arena
#   +16 kept    its copy on the heap, once a handler has been handed one
#   +24 why     why this thread's last bote_fetch_in_child failed (src/fetch.cyr), or 0
#   +32 stream  what can hold a `subscriptions/listen` stream open for this message: 0,
#               nothing; 1, an HTTP transport, which opens it itself once the dispatcher
#               has accepted it (3.7.2); or a BoteStream, a connection that is the stream
#               (3.7.3), whose functions the codec calls
#   +40 cancel  (3.7.5) how the connection says the request being served is cancelled:
#               fn(ctx, a, id) → 1 when it has been, or 0 for a transport that cannot say
#   +48 ctx     its context
#   +56 id      the raw id of the request being served, or 0
#   +64 gone    1 once bote_cancelled has found it cancelled
#   +72 claims  (3.7.5) the claims a `subscriptions/listen` was judged with, for the
#               transport that holds its stream, or 0
#   +80 progress (3.7.6) how the connection sends a notification on the request's own
#               stream: fn(ctx, a, json) → 0, or below 0 when it would not take it; 0 for none
#   +88 ctx     its context
#   +96 params  the raw params of the request being served, where its progressToken is
#   +104 last   the last `progress` sent for it
#   +112 sent   how many progress notifications have gone for it
#   +120 owner  (3.7.7) the thread that set the check or the writer: bote_cancelled and
#               bote_progress answer any other with nothing, before they touch the arena
#   +128 caps   (3.8.2) the raw `clientCapabilities` a 2026-07-28 request declared, or 0
#   +136 input  1 when this request may be answered with an InputRequiredResult: a
#               2026-07-28 tools/call, prompts/get or resources/read
#   +144 state  the `requestState` it brought, opened by the dispatcher's sealer, or 0
#   +152 answers the `inputResponses` it brought, as the dispatcher judged them, or 0
#   +160 taken  (3.8.8) 1 once the codec has taken a request with an id from this message,
#               past its admission (3.8.9: not a notification); 0 when nothing in it was one
#               (codec_unanswerable). Cleared by bote_req_begin and by each codec call
#   +168 pool   (3.8.10) the schema budget's base a batch's argument judgements share, plus
#               one, or 0 for none: each judgement has its own (_sch_root_budget). Set by the
#               codec around a batch's requests, cleared by bote_req_begin
#   +176 pool_out (3.8.11) the same for its results', apart from the arguments'
# A transport that serves one message at a time uses the process's block. A server
# that serves on worker threads (3.7.0, src/conn.cyr) sets _bote_req_state_fp to a
# function returning the calling thread's block, before its first worker starts.
var BOTE_REQ_STATE_BYTES = 184;
var BOTE_REQ_STATE_WHY = 24;
var BOTE_REQ_STATE_STREAM = 32;
var BOTE_REQ_STATE_CANCEL = 40;
var BOTE_REQ_STATE_PROGRESS = 80;
var BOTE_REQ_STATE_OWNER = 120;
var BOTE_REQ_STATE_INPUT = 128;
var BOTE_REQ_STATE_TAKEN = 160;
var BOTE_REQ_STATE_POOL = 168;
var BOTE_REQ_STATE_POOL_OUT = 176;
var _bote_req_g[23];
var _bote_req_state_fp = 0;

fn bote_req_state() {
    if (_bote_req_state_fp == 0) { return &_bote_req_g; }
    return fncall0(_bote_req_state_fp);
}

fn bote_req_alloc() {
    var s = &_bote_req_g;
    if (_bote_req_state_fp != 0) { s = fncall0(_bote_req_state_fp); }
    var a = load64(s);
    if (a == 0) {
        a = bote_req_arena_new();
        store64(s, a);
    }
    return a;
}

# The registries' lock (3.7.1). A threaded server's workers read the tool, prompt and
# resource registries and the dispatcher's handler maps for every request, and registering
# while it serves writes them: a map that grows moves its entries, and a reader at that
# moment misses a tool or reads past the old table. Readers share the lock, a writer has it
# alone, and a writer that is waiting holds new readers off. It is one word, the readers
# counted in its low bits and BOTE_RW_WRITER above them, and it is taken only once a thread
# exists (`_threads_active`, which a section cannot see change: only thread_create sets it,
# and nothing it guards creates a thread).
#
# ⚠ Not re-entrant either way: a holder that takes it again waits for a writer that waits
# for the holder. Each registry's public functions take it for their own body only and call
# their `_u` forms, which take nothing, inside it.
var BOTE_RW_WRITER = 1099511627776;   # 2^40: far above any count of readers
var _bote_reg_lock = 0;

# A thread waiting on the lock gives its CPU up every BOTE_RW_SPINS turns (3.7.2). With more
# workers than cores, readers spun through whole scheduler slices where the writer they
# waited for could have run: a registration under load took 48 ms on one CPU. The next turn.
var BOTE_RW_SPINS = 64;

fn _bote_reg_wait(spins) {
    if (spins % BOTE_RW_SPINS == BOTE_RW_SPINS - 1) { sys_sched_yield(); }
    return spins + 1;
}

fn bote_reg_read() {
    if (_threads_active == 0) { return 0; }
    while (1 == 1) {
        if ((atomic_fetch_add(&_bote_reg_lock, 1) & BOTE_RW_WRITER) == 0) { return 0; }
        atomic_fetch_add(&_bote_reg_lock, 0 - 1);
        var sp = 0;
        while ((atomic_load(&_bote_reg_lock) & BOTE_RW_WRITER) != 0) { sp = _bote_reg_wait(sp); }
    }
    return 0;
}

fn bote_reg_read_end() {
    if (_threads_active == 0) { return 0; }
    atomic_fetch_add(&_bote_reg_lock, 0 - 1);
    return 0;
}

fn bote_reg_write() {
    if (_threads_active == 0) { return 0; }
    var held = 0;
    var sp = 0;
    while (held == 0) {
        var s = atomic_load(&_bote_reg_lock);
        if ((s & BOTE_RW_WRITER) == 0) { held = atomic_cas(&_bote_reg_lock, s, s + BOTE_RW_WRITER); }
        if (held == 0) { sp = _bote_reg_wait(sp); }
    }
    # The readers inside finish; none comes in past the writer bit.
    while ((atomic_load(&_bote_reg_lock) & (BOTE_RW_WRITER - 1)) != 0) { sp = _bote_reg_wait(sp); }
    atomic_fence();
    return 0;
}

fn bote_reg_write_end() {
    if (_threads_active == 0) { return 0; }
    atomic_fetch_add(&_bote_reg_lock, 0 - BOTE_RW_WRITER);
    return 0;
}

# The arena itself (3.7.0). lib/alloc.cyr's growable arena, when the chunk after the one
# in use is too small for a request, links a new chunk in front of it and keeps both. A
# client whose every message was a little larger than the last therefore added a chunk a
# message, for good: 300 refused resources/read calls, the URI growing from 12 KB to
# 42 KB, kept 105 MB. Filed in cyrius's repository as
# 2026-11-02-bote-growable-arena-keeps-a-chunk-per-larger-request.md. This one takes
# the first chunk ahead that is large enough, and only when there is none adds one, at
# the end of the chain, of the chunk size doubled until the request fits. A chunk is
# added only when a message needs more room than every chunk ahead of it has, so what a
# client can make it keep is bounded by the largest message it sends.
#
# State (40 B): +0 the first chunk, +8 the chunk in use, +16 its next free byte, +24 its
# end, +32 the chunk size. A chunk: +0 the next, +8 its capacity, its bytes from +16.
var BOTE_REQ_CHUNK = 65536;
var BOTE_REQ_ALLOC_MAX = 1099511627776;   # 1 TiB: past this the doubling would overflow

fn _bote_ar_use(st, ch) {
    store64(st + 8, ch);
    store64(st + 16, ch + 16);
    store64(st + 24, ch + 16 + load64(ch + 8));
    return 0;
}

fn _bote_ar_take(st, ch, size) {
    _bote_ar_use(st, ch);
    store64(st + 16, ch + 16 + size);
    return ch + 16;
}

fn _bote_ar_alloc(st, size) {
    if (size <= 0 || size > BOTE_REQ_ALLOC_MAX) { return 0; }
    size = (size + 7) & (0 - 8);
    var p = load64(st + 16);
    if (p + size <= load64(st + 24)) {
        store64(st + 16, p + size);
        return p;
    }
    var prev = load64(st + 8);
    var c = load64(prev);
    while (c != 0) {
        if (load64(c + 8) >= size) { return _bote_ar_take(st, c, size); }
        prev = c;
        c = load64(c);
    }
    var cap = load64(st + 32);
    while (cap < size) { cap = cap * 2; }
    var ch = alloc(cap + 16);
    if (ch == 0) { return 0; }
    store64(ch, 0);
    store64(ch + 8, cap);
    store64(prev, ch);
    return _bote_ar_take(st, ch, size);
}

fn _bote_ar_realloc(st, old, old_size, new_size) {
    var p = _bote_ar_alloc(st, new_size);
    if (p == 0 || old == 0) { return p; }
    var n = old_size;
    if (new_size < n) { n = new_size; }
    memcpy(p, old, n);
    return p;
}

fn _bote_ar_free(st, ptr) { return 0; }

fn _bote_ar_reset(st) { return _bote_ar_use(st, load64(st)); }

# A request arena of its own, as an Allocator, or 0 when the heap is out.
fn bote_req_arena_new() {
    var st = alloc(40);
    var ch = alloc(BOTE_REQ_CHUNK + 16);
    if (st == 0 || ch == 0) { return 0; }
    store64(ch, 0);
    store64(ch + 8, BOTE_REQ_CHUNK);
    store64(st, ch);
    store64(st + 32, BOTE_REQ_CHUNK);
    _bote_ar_use(st, ch);
    return allocator_new(&_bote_ar_alloc, &_bote_ar_realloc, &_bote_ar_free, &_bote_ar_reset, st);
}

# Where the calling thread's request arena is now, into `m` (16 B: the chunk in use and its
# next free byte), for bote_req_release (3.7.2). What a function allocates on the arena
# after the mark and has copied off before it releases it goes then, and not at the next
# message: fs_read's 64 KB buffer stayed for the rest of its message, 6.5 MB for a batch of
# a hundred, and 128 KB a call where nothing rewinds. Nothing allocated after the mark may
# be used after the release.
fn bote_req_mark(m) { return bote_arena_mark(bote_req_alloc(), m); }
fn bote_req_release(m) { return bote_arena_release(bote_req_alloc(), m); }

# The same for any arena `a` (3.7.5): a bote_req_arena_new's, a thread's own or a listen
# carrier's. On an allocator that is no bote arena the mark is empty and the release does
# nothing, so a function handed any allocator may mark and release it.
fn bote_arena_mark(a, m) {
    store64(m, 0);
    store64(m + 8, 0);
    if (a == 0 || load64(a) != &_bote_ar_alloc) { return m; }
    var st = load64(a + 32);
    store64(m, load64(st + 8));
    store64(m + 8, load64(st + 16));
    return m;
}

fn bote_arena_release(a, m) {
    if (load64(m) == 0 || a == 0 || load64(a) != &_bote_ar_alloc) { return 0; }
    var st = load64(a + 32);
    _bote_ar_use(st, load64(m));
    store64(st + 16, load64(m + 8));
    return 0;
}

# 1 when `a` is a bote arena, which a mark and a release work on.
fn _bote_ar_is(a) {
    if (a != 0 && load64(a) == &_bote_ar_alloc) { return 1; }
    return 0;
}

# Every byte the arena `a` (a bote_req_arena_new) holds, across its chunks.
fn bote_req_arena_bytes(a) {
    var c = load64(load64(a + 32));
    var n = 0;
    while (c != 0) {
        n = n + load64(c + 8);
        c = load64(c);
    }
    return n;
}

# 1 when `s` is an RFC 6749 §3.3 scope-token. A scope goes out inside a quoted header
# parameter, and this is what keeps one from ending it.
fn bote_scope_token_ok(s) {
    if (s == 0 || load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 33 || c > 126 || c == 34 || c == 92) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when every entry of the vec `scopes` is a scope-token; 0 for none is 1.
fn bote_scope_list_ok(scopes) {
    if (scopes == 0) { return 1; }
    var i = 0;
    while (i < vec_len(scopes)) {
        if (bote_scope_token_ok(vec_get(scopes, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The token an accepted request presented, on the arena, and its copy on the heap once
# a handler has been handed one. A refused call must keep nothing, so that copy waits.

# Start a message: whatever the previous one left on the arena is gone.
fn bote_req_begin() {
    var al = bote_req_alloc();
    reset_via(al);
    var s = bote_req_state();
    store64(s + 8, 0);
    store64(s + 16, 0);
    store64(s + BOTE_REQ_STATE_STREAM, 0);
    store64(s + BOTE_REQ_STATE_CANCEL, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 8, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 16, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 24, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 32, 0);
    store64(s + BOTE_REQ_STATE_PROGRESS, 0);
    store64(s + BOTE_REQ_STATE_PROGRESS + 8, 0);
    store64(s + BOTE_REQ_STATE_PROGRESS + 16, 0);
    store64(s + BOTE_REQ_STATE_PROGRESS + 24, 0);
    store64(s + BOTE_REQ_STATE_PROGRESS + 32, 0);
    store64(s + BOTE_REQ_STATE_OWNER, 0);
    store64(s + BOTE_REQ_STATE_INPUT, 0);
    store64(s + BOTE_REQ_STATE_INPUT + 8, 0);
    store64(s + BOTE_REQ_STATE_INPUT + 16, 0);
    store64(s + BOTE_REQ_STATE_INPUT + 24, 0);
    store64(s + BOTE_REQ_STATE_TAKEN, 0);
    store64(s + BOTE_REQ_STATE_POOL, 0);
    store64(s + BOTE_REQ_STATE_POOL_OUT, 0);
    return al;
}

# ---- multi round-trip requests (3.8.2) -----------------------------------------------
#
# MCP 2026-07-28 lets a tools/call, prompts/get or resources/read be answered with an
# InputRequiredResult: input the server needs from the client (an elicitation, a sampling
# or the roots), and state to carry to the client's retry. The client sends the same
# request again, under a new id, with `inputResponses` and the state. A handler keeps the
# 2.0 ABI and asks the request state, as it asks bote_cancelled, through the functions
# below; it answers with a result built by bote_input_required_new_a (src/dispatch.cyr).

# The dispatcher's, for each request: what its client declared, whether it may be asked
# for input, the state it brought back, opened, and the answers it brought, judged.
fn bote_req_set_input(caps, ok, state, answers) {
    var s = bote_req_state();
    store64(s + BOTE_REQ_STATE_INPUT, caps);
    store64(s + BOTE_REQ_STATE_INPUT + 8, ok);
    store64(s + BOTE_REQ_STATE_INPUT + 16, state);
    store64(s + BOTE_REQ_STATE_INPUT + 24, answers);
    return 0;
}

# 1 when the request being served may be answered with an InputRequiredResult: a 2026-07-28
# tools/call, prompts/get or resources/read. An older revision has no way to ask, so a
# handler there answers as it can without the input.
fn bote_input_possible() { return load64(bote_req_state() + BOTE_REQ_STATE_INPUT + 8); }

# bote_client_has, bote_caps_have, bote_input_response_a and bote_input_accepted_a read
# JSON, and are at the end of src/jsonx.cyr: fuzz/req_arena.fcyr includes this module
# without it, and the agnos gate fails a unit with an undefined function even unreached.

# The client's answers on a retry, `inputResponses`, as raw JSON, or 0: the whole object,
# as the dispatcher judged it before the handler ran (on the request arena, until the next
# message), or (bote_input_response_a, at the end of src/jsonx.cyr) the one named `key`
# (the key of the input request it answers), on `a`. The
# dispatcher keeps them, so a handler reads them however its message came: at the first
# build they were read again from the params the codec noted, which a consumer calling
# dispatcher_dispatch itself never notes.
fn bote_input_responses_a(a) {
    if (bote_input_possible() == 0) { return 0; }
    return load64(bote_req_state() + BOTE_REQ_STATE_INPUT + 24);
}

# The state this server put in its last InputRequiredResult for this request, as it was
# given to bote_input_state, once the dispatcher's sealer has opened it: 0 when the client
# brought none. A state that does not open is refused before the handler runs.
fn bote_request_state() { return load64(bote_req_state() + BOTE_REQ_STATE_INPUT + 16); }

# ---- progress (3.7.6) --------------------------------------------------------------
#
# A request that carries `_meta.progressToken` asks to hear how it is going, on its own
# stream: the POST's SSE response on Streamable HTTP, and the connection itself on stdio
# (MCP 2026-07-28 and 2025-11-25, progress). A handler reports with bote_progress
# (src/codec.cyr); the transport sends it through the writer it sets here after
# bote_req_begin, and the codec names the request.

# The connection's writer for this message: fn(ctx, a, json), 0 when it sent the
# notification `json`, below 0 when it would not take it, 1 when it has no stream for it.
fn bote_req_set_progress(fp, ctx) {
    var s = bote_req_state();
    store64(s + BOTE_REQ_STATE_PROGRESS, fp);
    store64(s + BOTE_REQ_STATE_PROGRESS + 8, ctx);
    # Once a message: bote_req_begin clears it, and the other setter may have set it.
    if (fp != 0 && load64(s + BOTE_REQ_STATE_OWNER) == 0) { store64(s + BOTE_REQ_STATE_OWNER, sys_gettid()); }
    return 0;
}

# The request now being served, by its raw params (the codec's), with none of its progress
# sent yet.
fn bote_req_set_request_params(params) {
    var s = bote_req_state();
    store64(s + BOTE_REQ_STATE_PROGRESS + 16, params);
    store64(s + BOTE_REQ_STATE_PROGRESS + 24, 0);
    store64(s + BOTE_REQ_STATE_PROGRESS + 32, 0);
    return 0;
}

# How many progress notifications have gone for the request being served.
fn bote_req_progress_sent() { return load64(bote_req_state() + BOTE_REQ_STATE_PROGRESS + 32); }

# The claims the dispatcher judged a `subscriptions/listen` with, for the transport that
# opens its stream next (3.7.5): what it keeps of the listen is judged by the same.
fn bote_req_set_listen_claims(claims) {
    store64(bote_req_state() + BOTE_REQ_STATE_CANCEL + 32, claims);
    return claims;
}

fn bote_req_listen_claims() { return load64(bote_req_state() + BOTE_REQ_STATE_CANCEL + 32); }

# ---- cancellation (3.7.5) ----------------------------------------------------------
#
# A client cancels a request in flight: on Streamable HTTP by closing its response
# stream, on stdio with `notifications/cancelled` naming it (MCP 2026-07-28, cancellation;
# 2025-11-25's stdio is the same). A handler runs to its end on the thread that called it,
# so cancelling one is cooperative: a handler that runs long asks bote_cancelled() as it
# goes, and stops when it says 1. The transport answers the question for the message it is
# serving, through the check it sets with bote_req_set_cancel after bote_req_begin; the
# codec names the request. Once a check has said 1 nothing more goes out for the request,
# its response included, and a tools/call is audited as cancelled. A request whose handler
# never asks runs to its end and is answered, which the spec allows: a cancellation that
# arrives after the work is done may be ignored.

# The connection's check for this message: fn(ctx, a, id), 1 when the request whose raw id
# is `id` has been cancelled. `a` is the request arena, rewound past what the check
# allocated once it returns.
fn bote_req_set_cancel(fp, ctx) {
    var s = bote_req_state();
    store64(s + BOTE_REQ_STATE_CANCEL, fp);
    store64(s + BOTE_REQ_STATE_CANCEL + 8, ctx);
    # Once a message: bote_req_begin clears it, and the other setter may have set it.
    if (fp != 0 && load64(s + BOTE_REQ_STATE_OWNER) == 0) { store64(s + BOTE_REQ_STATE_OWNER, sys_gettid()); }
    return 0;
}

# 1 when the calling thread is the one that set this message's check or writer (3.7.7). On
# a one-loop server every thread reaches the process's one request state, and a handler's
# helper thread that asked through it marked, allocated on and released the handler's
# arena beside the handler (the 3.7.6 review: blocks overwritten in every run). It is asked
# first, before the arena. On agnos a thread runs inline on its starter, which is then the
# same thread.
fn bote_req_owner_here() {
    return sys_gettid() == load64(bote_req_state() + BOTE_REQ_STATE_OWNER);
}

# The request now being served, by its raw id (the codec's), and not cancelled yet.
fn bote_req_set_request_id(id) {
    var s = bote_req_state();
    store64(s + BOTE_REQ_STATE_CANCEL + 16, id);
    store64(s + BOTE_REQ_STATE_CANCEL + 24, 0);
    return 0;
}

# 1 when this message's connection can say whether its request is cancelled.
fn bote_req_cancel_live() { return load64(bote_req_state() + BOTE_REQ_STATE_CANCEL) != 0; }

# 1 once bote_cancelled has said 1 for the request being served.
fn bote_req_was_cancelled() { return load64(bote_req_state() + BOTE_REQ_STATE_CANCEL + 24); }

# 1 when the client has cancelled the request the calling thread is serving: what a
# handler asks while it works. Each call asks the connection once, a poll or a look at what
# has arrived, and a 1 stays 1. 0 off a handler's own thread, with no request being
# served, and wherever the transport cannot say.
fn bote_cancelled() {
    var s = bote_req_state();
    if (load64(s + BOTE_REQ_STATE_CANCEL + 24) == 1) { return 1; }
    var fp = load64(s + BOTE_REQ_STATE_CANCEL);
    if (fp == 0 || load64(s + BOTE_REQ_STATE_CANCEL + 16) == 0) { return 0; }
    if (sys_gettid() != load64(s + BOTE_REQ_STATE_OWNER)) { return 0; }
    var m[16];
    bote_req_mark(&m);
    var r = fncall3(fp, load64(s + BOTE_REQ_STATE_CANCEL + 8), bote_req_alloc(), load64(s + BOTE_REQ_STATE_CANCEL + 16));
    bote_req_release(&m);
    if (r != 1) { return 0; }
    store64(s + BOTE_REQ_STATE_CANCEL + 24, 1);
    return 1;
}

# What can hold a stream open for the message being dispatched (3.7.2): 0, 1 or a
# BoteStream, as above. The transport sets it around the dispatch, and only then is
# `subscriptions/listen` served: a dispatcher one embedder serves on HTTP and on stdio
# answers it on stdio as a method it does not have, unless stdio carries streams too.
fn bote_req_set_stream(on) {
    store64(bote_req_state() + BOTE_REQ_STATE_STREAM, on);
    return on;
}

fn bote_req_stream() { return load64(bote_req_state() + BOTE_REQ_STATE_STREAM); }

# A BoteStream (3.7.3), 24 B: how a connection that is itself the stream, stdio's, a Unix
# socket's or a WebSocket's, takes a listen over. +0 open, fn(ctx, a, req, resp): what to
# send in the place of `resp`, the dispatcher's acceptance, or 0 for nothing, when it has
# written the stream's first messages itself; +8 cancel, fn(ctx, a, request_id), the raw
# `requestId` of a `notifications/cancelled`, or 0; +16 ctx. The codec calls them
# (src/codec.cyr), so the core knows the shape and not what is behind it.
fn bote_stream_new(open_fp, cancel_fp, ctx) {
    var st = alloc(24);
    store64(st, open_fp);
    store64(st + 8, cancel_fp);
    store64(st + 16, ctx);
    return st;
}

fn bote_stream_open_a(st, a, req, resp) { return fncall4(load64(st), load64(st + 16), a, req, resp); }
fn bote_stream_cancel_a(st, a, id) { return fncall3(load64(st + 8), load64(st + 16), a, id); }

# The token noted for this message, or 0.
fn bote_req_token() { return load64(bote_req_state() + 8); }

# `token` is on the arena and is this message's claims.
fn bote_req_note_token(token) {
    var s = bote_req_state();
    store64(s + 8, token);
    store64(s + 16, 0);
    return token;
}

# bote_req_note_token, with the heap copy an earlier message of the same connection
# already made of it, or 0. A connection that presents its token once, for every message
# after, then keeps one copy, not one per message.
fn bote_req_note_token_kept(token, kept) {
    var s = bote_req_state();
    store64(s + 8, token);
    store64(s + 16, kept);
    return token;
}

# The heap copy of this message's token a handler has been handed, or 0.
fn bote_req_kept() { return load64(bote_req_state() + 16); }

# `claims` as a handler may have them, and a handler may keep them. Once for a message, so
# a batch of calls makes one copy.
fn bote_req_claims_kept(claims) {
    var s = bote_req_state();
    if (claims == 0 || claims != load64(s + 8)) { return claims; }
    if (load64(s + 16) == 0) {
        var n = strlen(claims) + 1;
        var k = alloc(n);
        memcpy(k, claims, n);
        store64(s + 16, k);
    }
    return load64(s + 16);
}

fn resp_success_a(a, id, result) {
    var r = alloc_via(a, 32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, result);
    store64(r + 24, 0);
    return r;
}

fn resp_error_a(a, id, code, message) {
    var e = alloc_via(a, 24);
    store64(e, code);
    store64(e + 8, message);
    store64(e + 16, 0);
    var r = alloc_via(a, 32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, e);
    return r;
}

fn resp_error_data_a(a, id, code, message, data) {
    var e = alloc_via(a, 24);
    store64(e, code);
    store64(e + 8, message);
    store64(e + 16, data);
    var r = alloc_via(a, 32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, e);
    return r;
}

fn resp_error(id, code, message) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, rpc_err_new(code, message, 0));
    return r;
}

# resp_error with a `data` member: a raw JSON literal, or 0 to omit it.
fn resp_error_data(id, code, message, data) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, rpc_err_new(code, message, data));
    return r;
}

fn resp_jsonrpc(r) { return load64(r); }
fn resp_id(r) { return load64(r + 8); }
fn resp_result(r) { return load64(r + 16); }
fn resp_error_obj(r) { return load64(r + 24); }

# --- jsonx.cyr ---

# bote::jsonx — nested-aware JSON value extractor
#
# Why: bayan's `json_parse` (lib/bayan.cyr, formerly lib/json.cyr) is
# flat-only — it truncates on nested objects/arrays.
# For dispatch we need to pull "name", "arguments", "version" out of a
# tools/call params object whose "arguments" is itself an object.
#
# This module exposes:
#   jsonx_get_raw(obj_cstr, key) → cstr (raw JSON value) or 0
#   jsonx_get_str(obj_cstr, key) → cstr (the string's raw JSON text, no quotes;
#                                  escapes are not decoded) or 0
#   jsonx_valid(buf, len)        → 1 if buf is one RFC 8259 JSON text, else 0
#   bote_json_escape(sb, cstr)   → appends cstr as a JSON string body (3.4.6)
#
# Limitations: no escape decoding inside strings (only \" is honored for
# detecting closing quote). No whitespace tolerance inside structured values.

# Maximum nesting depth before _jx_skip_struct bails. Audit 1.9.4
# defensive cap — caps adversarial input from walking a hand-crafted
# 100k-deep-but-valid-JSON tree. 64 is well above any legitimate
# protocol message; MCP tool args rarely exceed depth 5.
var JSONX_MAX_DEPTH = 64;

# Skip whitespace; return new index.
fn _jx_skip_ws(buf, len, i) {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return i; }
    }
    return i;
}

# Skip a JSON string starting at buf[i] (load8(buf+i) == '"').
# Returns index AFTER the closing quote.
fn _jx_skip_string(buf, len, i) {
    i = i + 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 92) { i = i + 2; }
        elif (c == 34) { return i + 1; }
        else { i = i + 1; }
    }
    return i;
}

# Skip a JSON value at buf[i]. Returns index AFTER the value.
# Handles: string, number, true/false/null, object, array (recursively).
fn _jx_skip_value(buf, len, i) {
    i = _jx_skip_ws(buf, len, i);
    if (i >= len) { return i; }
    var c = load8(buf + i);
    if (c == 34) { return _jx_skip_string(buf, len, i); }
    if (c == 123) { return _jx_skip_struct(buf, len, i, 123, 125); }
    if (c == 91)  { return _jx_skip_struct(buf, len, i, 91, 93); }
    # Bare token: number, true, false, null — read until terminator.
    while (i < len) {
        var cc = load8(buf + i);
        if (cc == 44 || cc == 125 || cc == 93 || cc == 32 || cc == 9 || cc == 10 || cc == 13) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

# Skip a balanced object/array. open=123 close=125 OR open=91 close=93.
# Bounded by JSONX_MAX_DEPTH (default 64) — pathologically nested input
# bails to end-of-buffer (caller sees end-of-input) rather than walking
# an attacker-crafted deep structure. The 64 KB inbound HTTP buffer
# already caps the absolute worst case, but the explicit guard keeps
# us safe if anyone ever raises that buffer size.
fn _jx_skip_struct(buf, len, i, open, close) {
    var depth = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) { i = _jx_skip_string(buf, len, i); }
        elif (c == open) {
            depth = depth + 1;
            if (depth > JSONX_MAX_DEPTH) { return len; }
            i = i + 1;
        }
        elif (c == close) {
            depth = depth - 1;
            i = i + 1;
            if (depth == 0) { return i; }
        }
        else { i = i + 1; }
    }
    return i;
}

# The code unit of a low surrogate `\uDC00`-`\uDFFF` at src + i, or -1.
fn _jx_low_surrogate(src, i, n) {
    if (i + 5 >= n) { return 0 - 1; }
    if (load8(src + i) != 92 || load8(src + i + 1) != 117) { return 0 - 1; }
    var h1 = _jx_hexval(load8(src + i + 2));
    var h2 = _jx_hexval(load8(src + i + 3));
    var h3 = _jx_hexval(load8(src + i + 4));
    var h4 = _jx_hexval(load8(src + i + 5));
    if ((h1 < 0) || (h2 < 0) || (h3 < 0) || (h4 < 0)) { return 0 - 1; }
    var cu = ((h1 * 4096) + (h2 * 256)) + ((h3 * 16) + h4);
    if (cu < 56320 || cu > 57343) { return 0 - 1; }
    return cu;
}

fn _jx_hexval(c) {
    if ((c >= 48) && (c <= 57))  { return c - 48; }        # 0-9
    if ((c >= 97) && (c <= 102)) { return (c - 97) + 10; }  # a-f
    if ((c >= 65) && (c <= 70))  { return (c - 65) + 10; }  # A-F
    return 0 - 1;
}
# Decode the JSON string body at src (n bytes, its escapes unread) into out,
# which has room for n + 1, and may be src itself. Returns the decoded length; a
# `\u0000` leaves a NUL inside it. An escape it cannot read is kept as its
# character. A lone surrogate becomes U+FFFD.
fn _jx_unescape_into(src, n, out) {
    var i = 0;
    var o = 0;
    var w[8];
    while (i < n) {
        var c = load8(src + i);
        if ((c == 92) && ((i + 1) < n)) {
            i = _jx_unescape_one(src, n, i, out + o, &w);
            o = o + load64(&w);
        } else {
            store8(out + o, c); o = o + 1; i = i + 1;
        }
    }
    store8(out + o, 0);
    return o;
}

# The escape at src[i] (a backslash with a byte after it, in a body of n bytes): what it
# decodes to, 1 to 4 bytes, written at out, their count at wp, and the index past it. It
# reads all it needs before it writes, so out may be at or behind src + i. The one
# decoder: _jx_unescape_into and _jx_dec_eq both step through it.
fn _jx_unescape_one(src, n, i, out, wp) {
    store64(wp, 1);
    var d = load8(src + i + 1);
    if (d == 110)      { store8(out, 10); return i + 2; }   # \n
    elif (d == 116)    { store8(out, 9);  return i + 2; }   # \t
    elif (d == 114)    { store8(out, 13); return i + 2; }   # \r
    elif (d == 34)     { store8(out, 34); return i + 2; }   # \"
    elif (d == 92)     { store8(out, 92); return i + 2; }   # \\
    elif (d == 47)     { store8(out, 47); return i + 2; }   # \/
    elif (d == 98)     { store8(out, 8);  return i + 2; }   # \b
    elif (d == 102)    { store8(out, 12); return i + 2; }   # \f
    if ((d != 117) || ((i + 5) >= n)) { store8(out, d); return i + 2; }   # unknown -> keep char
    var h1 = _jx_hexval(load8(src + i + 2));
    var h2 = _jx_hexval(load8(src + i + 3));
    var h3 = _jx_hexval(load8(src + i + 4));
    var h4 = _jx_hexval(load8(src + i + 5));
    if ((h1 < 0) || (h2 < 0) || (h3 < 0) || (h4 < 0)) {
        store8(out, d); return i + 2;    # malformed -> keep 'u'
    }
    var cp = ((h1 * 4096) + (h2 * 256)) + ((h3 * 16) + h4);
    var low = _jx_low_surrogate(src, i + 6, n);
    if (cp >= 55296 && cp <= 56319 && low >= 0) {
        # A surrogate pair is one code point, four UTF-8 bytes.
        cp = 65536 + ((cp - 55296) * 1024) + (low - 56320);
        store8(out, 240 + (cp / 262144));
        store8(out + 1, 128 + ((cp / 4096) % 64));
        store8(out + 2, 128 + ((cp / 64) % 64));
        store8(out + 3, 128 + (cp % 64));
        store64(wp, 4);
        return i + 12;
    }
    if (cp >= 55296 && cp <= 57343) {
        # A lone surrogate is not text: U+FFFD.
        store8(out, 239);
        store8(out + 1, 191);
        store8(out + 2, 189);
        store64(wp, 3);
    } elif (cp < 128) {
        store8(out, cp);
    } elif (cp < 2048) {
        store8(out, 192 + (cp / 64));
        store8(out + 1, 128 + (cp - ((cp / 64) * 64)));
        store64(wp, 2);
    } else {
        var hi = cp / 4096;
        var mid = (cp / 64) - (hi * 64);
        var lo = cp - ((cp / 64) * 64);
        store8(out, 224 + hi);
        store8(out + 1, 128 + mid);
        store8(out + 2, 128 + lo);
        store64(wp, 3);
    }
    return i + 6;
}

# 1 when the JSON string body at p (n bytes, its escapes unread) decodes to the wl bytes at
# want. It decodes as it compares and allocates nothing (3.8.2).
fn _jx_dec_eq(p, n, want, wl) {
    var i = 0;
    var o = 0;
    var u[8];
    var w[8];
    while (i < n) {
        var c = load8(p + i);
        if ((c == 92) && ((i + 1) < n)) {
            i = _jx_unescape_one(p, n, i, &u, &w);
            var k = load64(&w);
            if (o + k > wl) { return 0; }
            if (memeq(&u, want + o, k) == 0) { return 0; }
            o = o + k;
        } else {
            if (o >= wl || load8(want + o) != c) { return 0; }
            o = o + 1;
            i = i + 1;
        }
    }
    if (o == wl) { return 1; }
    return 0;
}

# 1 when the n bytes at p hold a backslash.
fn _jx_has_escape(p, n) {
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 92) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One pass over the object at buf for `n` keys: `keys` holds a (cstr, length)
# pair per key, and pos[i] gets the offset of the first occurrence's value, or
# -1. This is the one key scanner: _jx_find_value_pos is its one-key form, so
# the codec, the dispatcher and the validator cannot read a message differently.
# A key is matched as what it decodes to: `"c\u006et"` is the key `cnt`, here for
# the validator and for a handler alike, whatever its length. It allocates nothing: a key
# of 256 bytes or more is decoded as it is compared (3.8.2). At 3.8.1 that key was decoded
# on the request arena, the calling thread's, and a helper thread's scan on a one-loop
# server gave back the bytes its handler was using.
fn _jx_scan(buf, len, keys, n, pos) {
    var k = 0;
    while (k < n) { store64(pos + k * 8, 0 - 1); k = k + 1; }
    var i = _jx_skip_ws(buf, len, 0);
    if (i >= len || load8(buf + i) != 123) { return 0; }
    i = i + 1;
    var left = n;
    var dec[256];
    while (i < len) {
        i = _jx_skip_ws(buf, len, i);
        if (i >= len) { return 0; }
        if (load8(buf + i) != 34) { return 0; }
        var ks = i + 1;
        var ke = _jx_skip_string(buf, len, i);
        var kl = ke - ks - 1;
        var kp = buf + ks;
        # 0 compares the bytes, 1 the decoded ones, 2 decodes as it compares.
        var how = 0;
        if (kl > 0 && _jx_has_escape(kp, kl) == 1) {
            how = 2;
            if (kl < 256) {
                kl = _jx_unescape_into(kp, kl, &dec);
                kp = &dec;
                how = 1;
            }
        }
        i = _jx_skip_ws(buf, len, ke);
        if (i >= len || load8(buf + i) != 58) { return 0; }
        i = _jx_skip_ws(buf, len, i + 1);
        k = 0;
        while (k < n) {
            if (load64(pos + k * 8) < 0) {
                var wl = load64(keys + k * 16 + 8);
                var hit = 0;
                if (how == 2) { hit = _jx_dec_eq(kp, kl, load64(keys + k * 16), wl); }
                elif (kl == wl) { hit = memeq(kp, load64(keys + k * 16), kl); }
                if (hit == 1) {
                    store64(pos + k * 8, i);
                    left = left - 1;
                    if (left == 0) { return 0; }
                    k = n;
                }
            }
            k = k + 1;
        }
        var ve = _jx_skip_value(buf, len, i);
        i = _jx_skip_ws(buf, len, ve);
        if (i < len && load8(buf + i) == 44) { i = i + 1; }
    }
    return 0;
}

# Every member of the object `obj`, for code that cannot name the keys it wants: a
# schema's `properties`, read at registration. A vec on the heap of key, raw value,
# key, raw value, in order. Each key is what it decodes to, as _jx_scan matches
# one, so a name read here is one a message can reach. Empty for anything else.
# A member whose key decodes to hold a NUL is left out (3.8.1): no cstr can name it, so
# nothing the scanner finds is it. Through 3.7.7 the key was cut at the NUL, so a nested
# property named "a\u0000b" judged a message's "a", and in 3.8.0 it was kept as written,
# so it judged a message's "a\\u0000b".
fn _jx_members(obj) { return _jx_members_x(default_alloc(), obj, 0); }

# _jx_members on `a`.
fn _jx_members_a(a, obj) { return _jx_members_x(a, obj, 0); }

# Each member as three: its key as _jx_members has it, or 0 when it decodes to hold a
# NUL, its key as written (between the quotes, escapes and all), and its raw value. For
# code that writes an object again: the key as written means what the original did, and
# is valid in JSON. No member is left out.
fn _jx_members_raw_a(a, obj) { return _jx_members_x(a, obj, 1); }

fn _jx_members_x(a, obj, raw) {
    var out = vec_new_a(a);
    if (obj == 0) { return out; }
    var len = strlen(obj);
    var i = _jx_skip_ws(obj, len, 0);
    if (i >= len || load8(obj + i) != 123) { return out; }
    i = i + 1;
    while (i < len) {
        i = _jx_skip_ws(obj, len, i);
        if (i >= len || load8(obj + i) != 34) { return out; }
        var ke = _jx_skip_string(obj, len, i);
        var kl = ke - i - 2;
        var as = alloc_via(a, kl + 1);
        memcpy(as, obj + i + 1, kl);
        store8(as + kl, 0);
        var key = as;
        if (kl > 0 && _jx_has_escape(as, kl) == 1) {
            var dk = alloc_via(a, kl + 1);
            key = 0;
            if (_jx_unescape_into(as, kl, dk) == strlen(dk)) { key = dk; }
        }
        i = _jx_skip_ws(obj, len, ke);
        if (i >= len || load8(obj + i) != 58) { return out; }
        i = _jx_skip_ws(obj, len, i + 1);
        var ve = _jx_skip_value(obj, len, i);
        if (raw == 1 || key != 0) {
            var val = alloc_via(a, ve - i + 1);
            memcpy(val, obj + i, ve - i);
            store8(val + ve - i, 0);
            vec_push_a(a, out, key);
            if (raw == 1) { vec_push_a(a, out, as); }
            vec_push_a(a, out, val);
        }
        i = _jx_skip_ws(obj, len, ve);
        if (i < len && load8(obj + i) == 44) { i = i + 1; }
    }
    return out;
}

# 1 when an object anywhere in the JSON value `v` names a key twice, keys compared as
# they decode (3.8.1), or names one a client may read another way: bytes that are not
# UTF-8, or a surrogate escape that is not one of a pair (3.8.2), or, with `nul` 1, when
# a key or (3.8.2) any string decodes to hold a NUL: a schema's `required` name or `enum`
# value bote cannot hold. bote reads the first of a repeated key and a client may read
# the last, so what bote judged and what a client reads would differ; a client decoding
# UTF-8 reads `a<0xFF>` as `a\ufffd`, which bote's bytes do not match. What it reads is
# given back to `a` once it is done. It walks `v` where it lies and keeps only the keys
# (3.8.2): at 3.8.1 each level copied its whole subtree, 4 MB of arena for 60 KB nested
# 62 deep, and compared every pair of keys in an object.
fn _jx_repeats_a(a, v, nul) {
    if (v == 0) { return 0; }
    return _jx_repeats_n_a(a, v, strlen(v), nul);
}

# _jx_repeats_a for the `n` bytes at `v`.
fn _jx_repeats_n_a(a, v, n, nul) {
    var mk[16];
    bote_arena_mark(a, &mk);
    var r = 0;
    var i = _jx_skip_ws(v, n, 0);
    if (i < n && _jx_rep_value(a, v, n, i, nul) < 0) { r = 1; }
    bote_arena_release(a, &mk);
    return r;
}

# _jx_repeats_a for the value at v[i], in the n bytes at v: the index past it, or -1 for a
# key named twice (or the rest _jx_repeats_a refuses). Each byte is read once (3.8.6): a
# nested value was walked again by the level above it, so 60 KB nested 62 deep was read 63
# times, and one escaped key in a request now sends a message here.
fn _jx_rep_value(a, v, n, i, nul) {
    var c = load8(v + i);
    if (c == 34) {
        var se = _jx_skip_string(v, n, i);
        if (nul == 0) { return se; }
        var sl = se - i - 2;
        if (sl <= 0 || _jx_has_escape(v + i + 1, sl) == 0) { return se; }
        var ds = alloc_via(a, sl + 1);
        if (_jx_has_nul(ds, _jx_unescape_into(v + i + 1, sl, ds)) == 1) { return 0 - 1; }
        return se;
    }
    if (c == 91) {
        i = _jx_skip_ws(v, n, i + 1);
        while (i < n && load8(v + i) != 93) {
            # Only an object or an array can hold a key, and a string a NUL.
            var ec = load8(v + i);
            var e = 0;
            if (ec == 123 || ec == 91 || (nul == 1 && ec == 34)) {
                e = _jx_rep_value(a, v, n, i, nul);
                if (e < 0) { return 0 - 1; }
            } else {
                e = _jx_skip_value(v, n, i);
            }
            if (e <= i) { return n; }
            i = _jx_skip_ws(v, n, e);
            if (i < n && load8(v + i) == 44) { i = _jx_skip_ws(v, n, i + 1); }
        }
        if (i < n) { i = i + 1; }
        return i;
    }
    if (c != 123) { return _jx_skip_value(v, n, i); }
    # What an object's walk takes of the arena, its keys and their decodings, is given back
    # when it ends (3.8.7, from the 3.8.6 review): kept to the end of the whole walk, a vec
    # for every object, empty ones too, made one escaped key in 54 KB of `[{},{},...]` grow
    # the arena by 2.68 MB, for the life of the thread.
    var om[16];
    bote_arena_mark(a, &om);
    var r = _jx_rep_object(a, v, n, i, nul);
    bote_arena_release(a, &om);
    return r;
}

# _jx_rep_value for the object at v[i].
fn _jx_rep_object(a, v, n, i, nul) {
    # Each key as it decodes, a pointer and a length: into `v` where it has no escape.
    var ks = vec_new_a(a);
    i = _jx_skip_ws(v, n, i + 1);
    while (i < n && load8(v + i) == 34) {
        var ke = _jx_skip_string(v, n, i);
        var kp = v + i + 1;
        var kl = ke - i - 2;
        if (_jx_key_text_ok(kp, kl) == 0) { return 0 - 1; }
        if (kl > 0 && _jx_has_escape(kp, kl) == 1) {
            var dk = alloc_via(a, kl + 1);
            kl = _jx_unescape_into(kp, kl, dk);
            kp = dk;
            if (nul == 1 && _jx_has_nul(kp, kl) == 1) { return 0 - 1; }
        }
        vec_push_a(a, ks, kp);
        vec_push_a(a, ks, kl);
        i = _jx_skip_ws(v, n, ke);
        if (i >= n || load8(v + i) != 58) {
            if (_jx_rep_keys(a, ks) == 1) { return 0 - 1; }
            return n;
        }
        i = _jx_skip_ws(v, n, i + 1);
        var vc = load8(v + i);
        var ve = 0;
        if (vc == 123 || vc == 91 || (nul == 1 && vc == 34)) {
            ve = _jx_rep_value(a, v, n, i, nul);
            if (ve < 0) { return 0 - 1; }
        } else {
            ve = _jx_skip_value(v, n, i);
        }
        i = _jx_skip_ws(v, n, ve);
        if (i < n && load8(v + i) == 44) { i = _jx_skip_ws(v, n, i + 1); }
    }
    if (_jx_rep_keys(a, ks) == 1) { return 0 - 1; }
    if (i < n) { i = i + 1; }
    return i;
}

# A seed for every table bote hashes a client's keys or values into (3.8.7): made the first
# time one is, from the clock, and published by compare-and-swap, so every thread hashes
# with the same one. With a basis a client knows it can choose keys that land in one bucket,
# since the index is the hash's low bits and a match is found by trying, and a lookup that
# should be one look walks every key before it: 10,000 such keys in one object are 50
# million compares. Through 3.8.6 _jx_rep_keys used FNV's own basis.
var _jx_seed = 0;
fn _jx_hash_seed() {
    var s = atomic_load(&_jx_seed);
    if (s != 0) { return s; }
    var fresh = _jx_mix(clock_now_ns() ^ (&s)) | 1;
    if (atomic_cas(&_jx_seed, 0, fresh) == 1) { return fresh; }
    return atomic_load(&_jx_seed);
}

# A 64-bit finalizer (MurmurHash3's fmix64), the shifts logical: every bit of `x` moves the
# low bits a table index is taken from.
fn _jx_mix(x) {
    x = x ^ ((x >> 33) & 2147483647);
    x = x * (0 - 49064778989728563);
    x = x ^ ((x >> 33) & 2147483647);
    x = x * (0 - 4265267296055464877);
    x = x ^ ((x >> 33) & 2147483647);
    return x;
}

# FNV-1a over the n bytes at p from `h`, finalized: a seeded hash of them.
fn _jx_hash_bytes(h, p, n) {
    var b = 0;
    while (b < n) {
        h = (h ^ load8(p + b)) * 1099511628211;
        b = b + 1;
    }
    return _jx_mix(h);
}

# 1 when two of the keys in `ks` (pointer, length, pointer, length, ...) are the same.
# A table on `a` past eight of them, so a large object costs one look per key, the keys
# hashed with the process's seed (3.8.7).
fn _jx_rep_keys(a, ks) {
    var cnt = vec_len(ks) / 2;
    if (cnt < 2) { return 0; }
    var j = 0;
    if (cnt <= 8) {
        while (j < cnt) {
            var o = 0;
            while (o < j) {
                var ol = vec_get(ks, o * 2 + 1);
                if (ol == vec_get(ks, j * 2 + 1) && memeq(vec_get(ks, o * 2), vec_get(ks, j * 2), ol) == 1) { return 1; }
                o = o + 1;
            }
            j = j + 1;
        }
        return 0;
    }
    var size = 16;
    while (size < cnt * 2) { size = size * 2; }
    var t = alloc_via(a, size * 8);
    memset(t, 0, size * 8);
    var seed = _jx_hash_seed();
    while (j < cnt) {
        var kp = vec_get(ks, j * 2);
        var kl = vec_get(ks, j * 2 + 1);
        var h = _jx_hash_bytes(seed, kp, kl) & (size - 1);
        while (load64(t + h * 8) != 0) {
            var e = load64(t + h * 8) - 1;
            if (vec_get(ks, e * 2 + 1) == kl && memeq(vec_get(ks, e * 2), kp, kl) == 1) { return 1; }
            h = (h + 1) & (size - 1);
        }
        store64(t + h * 8, j + 1);
        j = j + 1;
    }
    return 0;
}

# 1 when the n bytes at p hold a NUL.
fn _jx_has_nul(p, n) {
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when the key body at p (n bytes, escapes unread) is text a client reads as bote does:
# its bytes UTF-8 (RFC 8259 8.1), and each surrogate escape one of a pair, as
# _jx_unescape_one pairs them. A client decodes a byte that is no UTF-8 to U+FFFD, and
# keeps a lone surrogate, where bote keeps the byte and writes U+FFFD.
fn _jx_key_text_ok(p, n) {
    var j = 0;
    while (j < n) {
        var c = load8(p + j);
        if (c == 92 && j + 1 < n) {
            var cu = 0 - 1;
            if (load8(p + j + 1) == 117 && j + 5 < n) {
                var h1 = _jx_hexval(load8(p + j + 2));
                var h2 = _jx_hexval(load8(p + j + 3));
                var h3 = _jx_hexval(load8(p + j + 4));
                var h4 = _jx_hexval(load8(p + j + 5));
                if (h1 >= 0 && h2 >= 0 && h3 >= 0 && h4 >= 0) {
                    cu = ((h1 * 4096) + (h2 * 256)) + ((h3 * 16) + h4);
                }
            }
            if (cu >= 55296 && cu <= 56319) {
                if (_jx_low_surrogate(p, j + 6, n) < 0) { return 0; }
                j = j + 12;
            } elif (cu >= 56320 && cu <= 57343) {
                return 0;
            } elif (cu >= 0) {
                j = j + 6;
            } else {
                j = j + 2;
            }
        } elif (c < 128) {
            j = j + 1;
        } else {
            var l = _jx_utf8_len(p + j);
            if (l == 0 || j + l > n) { return 0; }
            j = j + l;
        }
    }
    return 1;
}

# Past the array element at buf[i]: the next element, its closing `]`, or len when
# the array stops making sense. A walk starts one past the `[`, at _jx_skip_ws.
fn _jx_array_next(buf, len, i) {
    var e = _jx_skip_value(buf, len, i);
    if (e <= i) { return len; }
    i = _jx_skip_ws(buf, len, e);
    if (i < len && load8(buf + i) == 44) { i = _jx_skip_ws(buf, len, i + 1); }
    return i;
}

# Find a key inside a flat JSON object (one level). Returns index of the
# value's first byte (after `:` and whitespace), or 0 - 1 if not found.
fn _jx_find_value_pos(buf, len, key) {
    var k[16];
    store64(&k, key);
    store64(&k + 8, strlen(key));
    var p[8];
    _jx_scan(buf, len, &k, 1, &p);
    return load64(&p);
}

# Get raw JSON value bytes for key. Returns cstr (alloc'd, null-terminated)
# containing the verbatim source bytes, or 0 if key not found / input malformed.
fn jsonx_get_raw(obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    var pos = _jx_find_value_pos(obj_cstr, len, key);
    if (pos == 0 - 1) { return 0; }
    var end = _jx_skip_value(obj_cstr, len, pos);
    var n = end - pos;
    var out = alloc(n + 1);
    memcpy(out, obj_cstr + pos, n);
    store8(out + n, 0);
    return out;
}

# Get a string value for key (no quotes). Returns 0 if not found or value
# is not a JSON string. No escape decoding (\\ \" \n \t are passed through
# verbatim — adequate for tool names and version strings).
fn jsonx_get_str(obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    var pos = _jx_find_value_pos(obj_cstr, len, key);
    if (pos == 0 - 1) { return 0; }
    if (load8(obj_cstr + pos) != 34) { return 0; }
    var end = _jx_skip_string(obj_cstr, len, pos);
    # Truncated input (no closing quote): _jx_skip_string returns end == len,
    # so end - pos - 2 can go negative. Clamp to 0 (returns empty string).
    var inner_len = end - pos - 2;
    if (inner_len < 0) { inner_len = 0; }
    var out = alloc(inner_len + 1);
    memcpy(out, obj_cstr + pos + 1, inner_len);
    store8(out + inner_len, 0);
    return out;
}

# The value at pos as jsonx_get_raw returns it: its raw JSON bytes, owned by `a`.
fn _jx_raw_at_a(a, buf, len, pos) {
    if (pos < 0) { return 0; }
    var end = _jx_skip_value(buf, len, pos);
    var n = end - pos;
    var out = alloc_via(a, n + 1);
    memcpy(out, buf + pos, n);
    store8(out + n, 0);
    return out;
}

# The value at pos as jsonx_get_str returns it: 0 unless it is a string.
fn _jx_str_at_a(a, buf, len, pos) {
    if (pos < 0) { return 0; }
    if (load8(buf + pos) != 34) { return 0; }
    var end = _jx_skip_string(buf, len, pos);
    var inner_len = end - pos - 2;
    if (inner_len < 0) { inner_len = 0; }
    var out = alloc_via(a, inner_len + 1);
    memcpy(out, buf + pos + 1, inner_len);
    store8(out + inner_len, 0);
    return out;
}

# _jx_str_at_a with its escapes decoded: what the string means, for the fields
# bote itself compares. `"tools\/list"` is tools/list, and a client that writes
# it that way must not get -32601. A decoded NUL would end the cstr early and
# make it mean something else, so that string stays as it was sent, and matches
# nothing.
fn _jx_str_dec_at_a(a, buf, len, pos) {
    var s = _jx_str_at_a(a, buf, len, pos);
    if (s == 0) { return 0; }
    var n = strlen(s);
    if (_jx_has_escape(s, n) == 0) { return s; }
    var out = alloc_via(a, n + 1);
    var dn = _jx_unescape_into(s, n, out);
    if (strlen(out) != dn) { return s; }
    return out;
}

fn jsonx_get_str_dec_a(a, obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    return _jx_str_dec_at_a(a, obj_cstr, len, _jx_find_value_pos(obj_cstr, len, key));
}

fn jsonx_get_raw_a(a, obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    return _jx_raw_at_a(a, obj_cstr, len, _jx_find_value_pos(obj_cstr, len, key));
}

fn jsonx_get_str_a(a, obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    return _jx_str_at_a(a, obj_cstr, len, _jx_find_value_pos(obj_cstr, len, key));
}

# Returns 1 if obj_cstr contains key, 0 otherwise.
fn jsonx_has(obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    if (_jx_find_value_pos(obj_cstr, strlen(obj_cstr), key) == 0 - 1) { return 0; }
    return 1;
}

# Returns 1 if obj_cstr (after leading ws) starts with `{`.
fn jsonx_is_object(obj_cstr) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    var i = _jx_skip_ws(obj_cstr, len, 0);
    if (i >= len) { return 0; }
    if (load8(obj_cstr + i) != 123) { return 0; }
    return 1;
}

# ================================================================
# Syntax validation (3.4.5)
# ================================================================
#
# The extractors above trust their input: they find a key by scanning and
# never check that the text around it is JSON. JSON-RPC 2.0 §5.1 needs the
# distinction, though. Invalid JSON is a parse error (-32700), and a valid
# JSON text that is not a request is an invalid request (-32600). Through
# 3.4.4 the codec could not tell them apart. `not json` answered -32600,
# and a truncated object that happened to contain a "method" was
# dispatched.
#
# jsonx_valid checks RFC 8259 syntax in one pass and allocates nothing.
# It rejects:
#   - unescaped control bytes inside strings, and malformed escapes;
#   - leading zeros, a bare `-`, a `.` without digits, an `e` without digits;
#   - trailing commas;
#   - anything after the value but whitespace.
# It does not check UTF-8. Bytes >= 0x80 pass through as they always have.
#
# Nesting is capped at JSONX_MAX_DEPTH. That is the same cap _jx_skip_struct
# bails at, so every text this accepts can also be walked by the
# extractors. Recursion depth is bounded by the same cap.

fn _jx_is_digit(c) {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn _jx_is_hex(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    return 0;
}

# Index after the string at buf[i] (a `"`), or -1.
fn _jx_valid_string(buf, len, i) {
    i = i + 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) { return i + 1; }
        if (c < 32) { return 0 - 1; }
        if (c == 92) {
            if (i + 1 >= len) { return 0 - 1; }
            var e = load8(buf + i + 1);
            if (e == 117) {
                if (i + 6 > len) { return 0 - 1; }
                var h = 2;
                while (h < 6) {
                    if (_jx_is_hex(load8(buf + i + h)) == 0) { return 0 - 1; }
                    h = h + 1;
                }
                i = i + 6;
            } elif (e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116) {
                i = i + 2;
            } else {
                return 0 - 1;
            }
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

# _jx_valid_string for a key the validator checks (3.8.6): the index after it when its body is
# plain ASCII with no escape, minus that index when it is valid but is not, or -1. The test is
# made in the same pass as the syntax's.
fn _jx_valid_key_string(buf, len, i) {
    i = i + 1;
    var plain = 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) {
            if (plain == 1) { return i + 1; }
            return 0 - (i + 1);
        }
        if (c < 32) { return 0 - 1; }
        if (c >= 128) {
            plain = 0;
            i = i + 1;
        } elif (c == 92) {
            plain = 0;
            if (i + 1 >= len) { return 0 - 1; }
            var e = load8(buf + i + 1);
            if (e == 117) {
                if (i + 6 > len) { return 0 - 1; }
                var h = 2;
                while (h < 6) {
                    if (_jx_is_hex(load8(buf + i + h)) == 0) { return 0 - 1; }
                    h = h + 1;
                }
                i = i + 6;
            } elif (e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116) {
                i = i + 2;
            } else {
                return 0 - 1;
            }
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

# Index after the number at buf[i], or -1. RFC 8259 §6:
# -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
fn _jx_valid_number(buf, len, i) {
    if (i < len && load8(buf + i) == 45) { i = i + 1; }
    if (i >= len) { return 0 - 1; }
    var c = load8(buf + i);
    if (c == 48) {
        i = i + 1;
    } elif (c >= 49 && c <= 57) {
        while (i < len && _jx_is_digit(load8(buf + i)) == 1) { i = i + 1; }
    } else {
        return 0 - 1;
    }
    if (i < len && load8(buf + i) == 46) {
        i = i + 1;
        if (i >= len || _jx_is_digit(load8(buf + i)) == 0) { return 0 - 1; }
        while (i < len && _jx_is_digit(load8(buf + i)) == 1) { i = i + 1; }
    }
    if (i < len && (load8(buf + i) == 101 || load8(buf + i) == 69)) {
        i = i + 1;
        if (i < len && (load8(buf + i) == 43 || load8(buf + i) == 45)) { i = i + 1; }
        if (i >= len || _jx_is_digit(load8(buf + i)) == 0) { return 0 - 1; }
        while (i < len && _jx_is_digit(load8(buf + i)) == 1) { i = i + 1; }
    }
    return i;
}

# Index after the literal `lit` (n bytes) at buf[i], or -1.
fn _jx_valid_literal(buf, len, i, lit, n) {
    if (i + n > len) { return 0 - 1; }
    if (memeq(buf + i, lit, n) == 0) { return 0 - 1; }
    return i + n;
}

# One key of an object the validator walks with a key check (3.8.6): `kl` bytes at buf[p],
# its body between the quotes, plain ASCII with no escape, so its own decoding, and text.
# `ks` holds the start and length of each key kept so far, `nk` of them; the count kept is
# returned. *kc becomes 1 when the key is one kept, and 2 past BOTE_KEYS_INLINE keys, when
# only the exact walker (_jx_repeats_n_a) can say, as for a key holding an escape or a byte
# past ASCII, which must be read as it decodes (_jx_valid_key_string finds those).
# BOTE_KEYS_INLINE is a constant (3.8.7, from the 3.8.6 review): `ks` in _jx_valid_object is
# 256 bytes, sixteen keys, and a global raised past that wrote off its end.
enum BoteJsonxLimit {
    BOTE_KEYS_INLINE = 16;
}

fn _jx_valid_key(buf, p, kl, ks, nk, kc) {
    var o = 0;
    while (o < nk) {
        if (load64(ks + o * 16 + 8) == kl && memeq(buf + load64(ks + o * 16), buf + p, kl) == 1) {
            store64(kc, 1);
            return nk;
        }
        o = o + 1;
    }
    if (nk >= BOTE_KEYS_INLINE) { store64(kc, 2); return nk; }
    store64(ks + nk * 16, p);
    store64(ks + nk * 16 + 8, kl);
    return nk + 1;
}

# Index after the object at buf[i] (a `{`), or -1. `depth` counts this one. With `kc`, its
# keys are checked as _jx_valid_key says, until *kc holds a verdict.
fn _jx_valid_object(buf, len, i, depth, kc) {
    i = _jx_skip_ws(buf, len, i + 1);
    if (i < len && load8(buf + i) == 125) { return i + 1; }
    var ks[256];  # BOTE_KEYS_INLINE keys, 16 bytes each
    var nk = 0;
    while (i < len) {
        if (load8(buf + i) != 34) { return 0 - 1; }
        if (kc != 0 && load64(kc) == 0) {
            var k0 = i + 1;
            i = _jx_valid_key_string(buf, len, i);
            if (i < 0) {
                # A key with an escape or a byte past ASCII: valid, and the exact walker's.
                if (i == 0 - 1) { return 0 - 1; }
                i = 0 - i;
                store64(kc, 2);
            } else {
                nk = _jx_valid_key(buf, k0, i - 1 - k0, &ks, nk, kc);
            }
        } else {
            i = _jx_valid_string(buf, len, i);
            if (i < 0) { return 0 - 1; }
        }
        i = _jx_skip_ws(buf, len, i);
        if (i >= len || load8(buf + i) != 58) { return 0 - 1; }
        i = _jx_valid_value(buf, len, i + 1, depth, kc);
        if (i < 0) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i);
        if (i >= len) { return 0 - 1; }
        var c = load8(buf + i);
        if (c == 125) { return i + 1; }
        if (c != 44) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i + 1);
    }
    return 0 - 1;
}

# Index after the array at buf[i] (a `[`), or -1. `depth` counts this one.
fn _jx_valid_array(buf, len, i, depth, kc) {
    i = _jx_skip_ws(buf, len, i + 1);
    if (i < len && load8(buf + i) == 93) { return i + 1; }
    while (i < len) {
        i = _jx_valid_value(buf, len, i, depth, kc);
        if (i < 0) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i);
        if (i >= len) { return 0 - 1; }
        var c = load8(buf + i);
        if (c == 93) { return i + 1; }
        if (c != 44) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i + 1);
    }
    return 0 - 1;
}

# Index after the value at buf[i] (leading whitespace skipped), or -1.
# `depth` is the number of containers already open around it.
fn _jx_valid_value(buf, len, i, depth, kc) {
    i = _jx_skip_ws(buf, len, i);
    if (i >= len) { return 0 - 1; }
    var c = load8(buf + i);
    if (c == 34) { return _jx_valid_string(buf, len, i); }
    if (c == 123 || c == 91) {
        if (depth >= JSONX_MAX_DEPTH) { return 0 - 1; }
        if (c == 123) { return _jx_valid_object(buf, len, i, depth + 1, kc); }
        return _jx_valid_array(buf, len, i, depth + 1, kc);
    }
    if (c == 116) { return _jx_valid_literal(buf, len, i, "true", 4); }
    if (c == 102) { return _jx_valid_literal(buf, len, i, "false", 5); }
    if (c == 110) { return _jx_valid_literal(buf, len, i, "null", 4); }
    return _jx_valid_number(buf, len, i);
}

# 1 when buf[0..len) is exactly one JSON text, surrounding whitespace
# allowed; 0 otherwise, or when buf is 0.
fn jsonx_valid(buf, len) {
    if (buf == 0) { return 0; }
    var end = _jx_valid_value(buf, len, 0, 0, 0);
    if (end < 0) { return 0; }
    if (_jx_skip_ws(buf, len, end) != len) { return 0; }
    return 1;
}

# jsonx_valid and _jx_repeats_n_a(a, buf, len, 0) in one walk (3.8.6), for a request: 0 when
# buf[0..len) is no JSON text, 2 when it is one that names a key twice in any object or a
# key that is no text, else 1. The keys of plain ASCII are compared as the syntax is read,
# allocating nothing; the exact walker reads the message only when one is not, or an object
# holds more than BOTE_KEYS_INLINE of them, and gives back what it reads.
fn _jx_valid_keys_a(a, buf, len) {
    if (buf == 0) { return 0; }
    var kc = 0;
    var end = _jx_valid_value(buf, len, 0, 0, &kc);
    if (end < 0) { return 0; }
    if (_jx_skip_ws(buf, len, end) != len) { return 0; }
    if (kc == 0) { return 1; }
    if (kc == 1 || _jx_repeats_n_a(a, buf, len, 0) == 1) { return 2; }
    return 1;
}

# ================================================================
# String escaping (3.4.6)
# ================================================================
#
# Through 3.4.5 the escaper lived in dispatch.cyr as the private
# `_json_emit_escaped`, and it escaped only `"`, `\`, LF, CR and TAB. It
# copied every other byte below 0x20 through raw, which RFC 8259 §7
# forbids. Every serializer in bote uses it, so a tool result holding an ESC
# or a BEL went out as JSON no client can parse. The 2026-10-15 consumer
# audit measured this on the 3.4.5 binary, with `fs_read` of an
# ANSI-coloured log.
#
# The escape table is lib/str.cyr's `str_builder_add_json_str`: `"` and `\`
# get a backslash, control bytes become `\b \f \n \r \t` or `\u00XX`, and
# bytes from 0x20 up pass through, so UTF-8 is untouched. bote does not call
# that function because it takes a Str and writes the surrounding quotes,
# while every bote call site holds a cstr and writes its own quotes. A Str
# per escaped string would be an allocation for nothing. Runs of plain bytes
# go in with one copy each.

# Append bytes [p, p + n) to sb in one copy. str_builder has no public
# length-taking append, so this passes str_builder_add a Str view built on
# the stack: the {data, len} pair lib/str.cyr reads with str_data / str_len.
fn _jx_add_run(sb, p, n) {
    if (n <= 0) { return 0; }
    var view[16];
    store64(&view, p);
    store64(&view + 8, n);
    var vp = &view;
    str_builder_add(sb, vp);
    return 0;
}

# Append the escape for control, quote or backslash byte c.
fn _jx_add_escape(sb, c) {
    str_builder_putc(sb, 92);
    if (c == 34 || c == 92) { str_builder_putc(sb, c); return 0; }
    if (c == 8) { str_builder_putc(sb, 98); return 0; }
    if (c == 9) { str_builder_putc(sb, 116); return 0; }
    if (c == 10) { str_builder_putc(sb, 110); return 0; }
    if (c == 12) { str_builder_putc(sb, 102); return 0; }
    if (c == 13) { str_builder_putc(sb, 114); return 0; }
    str_builder_putc(sb, 117);
    str_builder_putc(sb, 48);
    str_builder_putc(sb, 48);
    var hi = (c >> 4) & 15;
    var lo = c & 15;
    if (hi < 10) { str_builder_putc(sb, 48 + hi); } else { str_builder_putc(sb, 87 + hi); }
    if (lo < 10) { str_builder_putc(sb, 48 + lo); } else { str_builder_putc(sb, 87 + lo); }
    return 0;
}

# Append `cstr` to sb as the contents of a JSON string, without the
# surrounding quotes. The output is always a valid JSON string body. A NUL
# ends a cstr, so text after an embedded NUL is not emitted. Returns 0, and
# 0 for a null cstr, which appends nothing.
# The length of the UTF-8 sequence at p, or 0 when it is not one (RFC 3629):
# overlong forms, surrogates and anything past U+10FFFF are not. A NUL fails the
# continuation test, so it never reads past the end of a cstr.
fn _jx_utf8_len(p) {
    var c = load8(p);
    var n = 0;
    var lo = 128;
    var hi = 191;
    if (c >= 194 && c <= 223) { n = 2; }
    elif (c >= 224 && c <= 239) {
        n = 3;
        if (c == 224) { lo = 160; }
        if (c == 237) { hi = 159; }
    } elif (c >= 240 && c <= 244) {
        n = 4;
        if (c == 240) { lo = 144; }
        if (c == 244) { hi = 143; }
    } else {
        return 0;
    }
    var b = load8(p + 1);
    if (b < lo || b > hi) { return 0; }
    var k = 2;
    while (k < n) {
        b = load8(p + k);
        if (b < 128 || b > 191) { return 0; }
        k = k + 1;
    }
    return n;
}

fn bote_json_escape(sb, cstr) {
    if (cstr == 0) { return 0; }
    var start = 0;
    var i = 0;
    while (1 == 1) {
        var c = load8(cstr + i);
        if (c == 0) {
            _jx_add_run(sb, cstr + start, i - start);
            return 0;
        }
        if (c == 34 || c == 92 || c < 32) {
            _jx_add_run(sb, cstr + start, i - start);
            _jx_add_escape(sb, c);
            start = i + 1;
            i = i + 1;
        } elif (c < 128) {
            i = i + 1;
        } else {
            # RFC 8259 §8.1: JSON text is UTF-8. A file, a page or a client
            # may hand bote anything, and a strict parser refuses the whole
            # message over one bad byte.
            var u = _jx_utf8_len(cstr + i);
            if (u == 0) {
                _jx_add_run(sb, cstr + start, i - start);
                str_builder_add_cstr(sb, "\\ufffd");
                start = i + 1;
                i = i + 1;
            } else {
                i = i + u;
            }
        }
    }
    return 0;
}

# The pre-3.4.6 private name. Every bote module calls it, and so does hoosh
# (six call sites in its own src/), so it stays as an alias.
fn _json_emit_escaped(sb, cstr) {
    return bote_json_escape(sb, cstr);
}

# ================================================================
# Titles and icons (3.8.1)
# ================================================================
#
# What a client shows for a tool, a prompt, a resource, a template or the server: a
# `title` for people, where `name` is for programs, and `icons` (MCP 2025-11-25 and
# 2026-07-28 alike). An Icon (32 bytes):
#   +0  src        cstr: an http:// or https:// URL, or a data: URI of Base64 image data
#   +8  mime_type  cstr or 0, type/subtype
#   +16 sizes      vec of cstr or 0, each WxH ("48x48") or "any"
#   +24 theme      cstr or 0, "light" or "dark"
# Each is checked where it is registered or set, and refused unless every field is what
# the spec says: the official client refuses a whole list over one theme it does not know.
# Here, beside the escaper the fragment is built with, because every registry uses them:
# the tool registry, the prompt registry and the resource registry, each its own module.

fn bote_icon_new(src) {
    var i = alloc(32);
    store64(i, src);
    store64(i + 8, 0);
    store64(i + 16, 0);
    store64(i + 24, 0);
    return i;
}

fn bote_icon_with_mime_type(i, mime_type) { store64(i + 8, mime_type); return i; }
fn bote_icon_with_sizes(i, sizes) { store64(i + 16, sizes); return i; }
fn bote_icon_with_theme(i, theme) { store64(i + 24, theme); return i; }

fn bote_icon_src(i) { return load64(i); }
fn bote_icon_mime_type(i) { return load64(i + 8); }
fn bote_icon_sizes(i) { return load64(i + 16); }
fn bote_icon_theme(i) { return load64(i + 24); }

fn _bote_lc(c) {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# 1 when cstr `s` starts with `lit` (lower case), whatever the case of `s`.
fn _bote_starts_ci(s, lit) {
    var i = 0;
    while (load8(lit + i) != 0) {
        if (_bote_lc(load8(s + i)) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _bote_alnum(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    return 0;
}

# 1 when byte `c` (not NUL) is one of the cstr `set`.
fn _bote_in(set, c) {
    if (strchr(set, c) >= 0) { return 1; }
    return 0;
}

fn _bote_hex(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    return 0;
}

# 1 when the bytes of `s` from `i` are all a URI may hold (RFC 3986: unreserved,
# reserved, and a percent sign before two hex digits), and there is at least one.
fn _bote_uri_rest_ok(s, i) {
    var n = strlen(s);
    if (i >= n) { return 0; }
    while (i < n) {
        var c = load8(s + i);
        if (c == 37) {
            if (i + 2 >= n || _bote_hex(load8(s + i + 1)) == 0 || _bote_hex(load8(s + i + 2)) == 0) { return 0; }
            i = i + 3;
        } else {
            if (_bote_alnum(c) == 0 && _bote_in("-._~:/?#[]@!$&'()*+,;=", c) == 0) { return 0; }
            i = i + 1;
        }
    }
    return 1;
}

# 1 when `url` is an absolute http:// or https:// URL with a host: what an icon's `src`
# may be beside a data: URI, and what `websiteUrl` must be. The authority is a host and
# an optional port, and nothing else (3.8.2): a domain of letters, digits, `-` and `_` in
# labels, a dotted-quad IPv4 address, or an IPv6 literal in brackets, then up to 65535.
# No userinfo, which would put a credential in every list. At 3.8.1 only the first byte
# after `//` was looked at, so `http://:80/x`, `http://@/` and `https://user:pass@h/`
# passed, which a client's URL parser refuses or which carries a password.
fn bote_web_url_ok(url) {
    if (url == 0) { return 0; }
    var at = 0;
    if (_bote_starts_ci(url, "https://") == 1) { at = 8; }
    elif (_bote_starts_ci(url, "http://") == 1) { at = 7; }
    else { return 0; }
    var n = strlen(url);
    var e = at;
    while (e < n && _bote_in("/?#", load8(url + e)) == 0) { e = e + 1; }
    if (_bote_authority_ok(url + at, e - at) == 0) { return 0; }
    if (e == n) { return 1; }
    return _bote_uri_rest_ok(url, e);
}

# 1 when the n bytes at p are host [":" port], as bote_web_url_ok takes them.
fn _bote_authority_ok(p, n) {
    if (n == 0) { return 0; }
    var hn = n;
    if (load8(p) == 91) {
        var close = 1;
        while (close < n && load8(p + close) != 93) { close = close + 1; }
        if (close >= n || _bote_ipv6_ok(p + 1, close - 1) == 0) { return 0; }
        hn = close + 1;
        if (hn < n && load8(p + hn) != 58) { return 0; }
    } else {
        hn = 0;
        while (hn < n && load8(p + hn) != 58) { hn = hn + 1; }
        if (_bote_host_name_ok(p, hn) == 0) { return 0; }
    }
    if (hn == n) { return 1; }
    # The port: digits, perhaps none, at most 65535.
    var v = 0;
    var i = hn + 1;
    while (i < n) {
        var c = load8(p + i);
        if (c < 48 || c > 57) { return 0; }
        v = v * 10 + (c - 48);
        if (v > 65535) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when the n bytes at p are a domain or a dotted-quad IPv4 address. Labels are letters,
# digits, `-` and `_`, none empty but a last one after a trailing dot. A host whose last
# label is a number is an IPv4 address to a URL parser, and must be one here.
fn _bote_host_name_ok(p, n) {
    if (n == 0) { return 0; }
    var end = n;
    if (n > 1 && load8(p + n - 1) == 46) { end = n - 1; }
    var ls = 0;
    var i = 0;
    while (i <= end) {
        if (i == end || load8(p + i) == 46) {
            if (i == ls) { return 0; }
            ls = i + 1;
        } else {
            var c = load8(p + i);
            if (_bote_alnum(c) == 0 && c != 45 && c != 95) { return 0; }
        }
        i = i + 1;
    }
    # The last label: all digits, or 0x and hex, is a number.
    var last = end;
    while (last > 0 && load8(p + last - 1) != 46) { last = last - 1; }
    var num = 1;
    var j = last;
    if (end - last >= 2 && load8(p + last) == 48 && (load8(p + last + 1) == 120 || load8(p + last + 1) == 88)) {
        j = last + 2;
        while (j < end) { if (_bote_hex(load8(p + j)) == 0) { num = 0; } j = j + 1; }
    } else {
        while (j < end) { if (load8(p + j) < 48 || load8(p + j) > 57) { num = 0; } j = j + 1; }
    }
    if (num == 1) { return _bote_ipv4_ok(p, n); }
    return 1;
}

# 1 when the n bytes at p are four decimal parts, 0 to 255, with no leading zero.
fn _bote_ipv4_ok(p, n) {
    var parts = 0;
    var i = 0;
    while (parts < 4) {
        var v = 0;
        var d = 0;
        while (i < n && load8(p + i) >= 48 && load8(p + i) <= 57) {
            if (d > 0 && v == 0) { return 0; }
            v = v * 10 + (load8(p + i) - 48);
            d = d + 1;
            i = i + 1;
            if (v > 255) { return 0; }
        }
        if (d == 0) { return 0; }
        parts = parts + 1;
        if (parts < 4) {
            if (i >= n || load8(p + i) != 46) { return 0; }
            i = i + 1;
        }
    }
    if (i != n) { return 0; }
    return 1;
}

# 1 when the n bytes at p are an IPv6 address (RFC 4291 2.2): eight groups of one to four
# hex digits, or fewer around one `::`, the last two perhaps a dotted quad. No zone.
fn _bote_ipv6_ok(p, n) {
    if (n < 2) { return 0; }
    var groups = 0;
    var compress = 0;
    var i = 0;
    if (load8(p) == 58) {
        if (load8(p + 1) != 58) { return 0; }
        compress = 1;
        i = 2;
        if (i == n) { return 1; }
    }
    while (i < n) {
        # A dotted quad, as the last 32 bits.
        var k = i;
        while (k < n && load8(p + k) != 58 && load8(p + k) != 46) { k = k + 1; }
        if (k < n && load8(p + k) == 46) {
            if (_bote_ipv4_ok(p + i, n - i) == 0) { return 0; }
            groups = groups + 2;
            i = n;
        } else {
            var h = 0;
            while (i < n && _bote_hex(load8(p + i)) == 1) { h = h + 1; i = i + 1; }
            if (h == 0 || h > 4) { return 0; }
            groups = groups + 1;
            if (i < n) {
                if (load8(p + i) != 58) { return 0; }
                i = i + 1;
                if (i < n && load8(p + i) == 58) {
                    if (compress == 1) { return 0; }
                    compress = 1;
                    i = i + 1;
                } elif (i == n) {
                    return 0;
                }
            }
        }
    }
    if (compress == 1) {
        if (groups > 7) { return 0; }
        return 1;
    }
    if (groups != 8) { return 0; }
    return 1;
}

# 1 when `uri` is data: with a media type, `;base64`, and Base64 after the comma, as the
# spec has an icon's: "a data: URI with Base64-encoded image data".
fn _bote_data_uri_ok(uri) {
    if (_bote_starts_ci(uri, "data:") == 0) { return 0; }
    var n = strlen(uri);
    var comma = 5;
    while (comma < n && load8(uri + comma) != 44) { comma = comma + 1; }
    if (comma >= n || comma < 12) { return 0; }
    if (_bote_starts_ci(uri + comma - 7, ";base64") == 0) { return 0; }
    var i = 5;
    while (i < comma - 7) {
        var c = load8(uri + i);
        if (_bote_alnum(c) == 0 && _bote_in("-._~!$&'()*+;=/", c) == 0) { return 0; }
        i = i + 1;
    }
    i = comma + 1;
    if (i >= n) { return 0; }
    while (i < n) {
        var b = load8(uri + i);
        if (_bote_alnum(b) == 0 && b != 43 && b != 47 && b != 61) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when `m` is type/subtype, each of RFC 6838's restricted-name characters, then any
# parameters (3.8.2), RFC 9110 8.3.1: `; name=value`, the value a token or a quoted
# string. At 3.8.1 a parameter was refused, which the spec's `mimeType?: string` allows.
fn _bote_mime_ok(m) {
    var n = strlen(m);
    var slash = 0 - 1;
    var i = 0;
    while (i < n && load8(m + i) != 59 && load8(m + i) != 32 && load8(m + i) != 9) {
        var c = load8(m + i);
        if (c == 47) {
            if (slash >= 0 || i == 0) { return 0; }
            slash = i;
        } elif (_bote_alnum(c) == 0 && _bote_in("!#$&-^_.+", c) == 0) {
            return 0;
        }
        i = i + 1;
    }
    if (slash < 0 || slash == i - 1) { return 0; }
    while (i < n) {
        while (i < n && (load8(m + i) == 32 || load8(m + i) == 9)) { i = i + 1; }
        if (i >= n || load8(m + i) != 59) { return 0; }
        i = i + 1;
        while (i < n && (load8(m + i) == 32 || load8(m + i) == 9)) { i = i + 1; }
        var t = i;
        while (i < n && _bote_tchar(load8(m + i)) == 1) { i = i + 1; }
        if (i == t || i >= n || load8(m + i) != 61) { return 0; }
        i = i + 1;
        if (i < n && load8(m + i) == 34) {
            i = i + 1;
            var closed = 0;
            while (i < n && closed == 0) {
                var q = load8(m + i);
                if (q == 34) { closed = 1; }
                elif (q == 92) {
                    i = i + 1;
                    if (i >= n || load8(m + i) < 32 || load8(m + i) == 127) { return 0; }
                } elif ((q < 32 && q != 9) || q == 127) { return 0; }
                i = i + 1;
            }
            if (closed == 0) { return 0; }
        } else {
            var v = i;
            while (i < n && _bote_tchar(load8(m + i)) == 1) { i = i + 1; }
            if (i == v) { return 0; }
        }
    }
    return 1;
}

# 1 when `c` is an RFC 9110 tchar.
fn _bote_tchar(c) {
    if (_bote_alnum(c) == 1) { return 1; }
    return _bote_in("!#$%&'*+-.^_`|~", c);
}

# 1 when `s` is "any" or WxH, each side 1 to 5 digits.
fn _bote_size_ok(s) {
    if (streq(s, "any") == 1) { return 1; }
    var i = 0;
    var w = 0;
    while (load8(s + i) >= 48 && load8(s + i) <= 57) { i = i + 1; w = w + 1; }
    if (w == 0 || w > 5 || load8(s + i) != 120) { return 0; }
    i = i + 1;
    var h = 0;
    while (load8(s + i) >= 48 && load8(s + i) <= 57) { i = i + 1; h = h + 1; }
    if (h == 0 || h > 5 || load8(s + i) != 0) { return 0; }
    return 1;
}

# Why the vec of Icons `icons` cannot be sent, or 0 when it can (an absent list can).
# Public, so a consumer can check a list before it sets one.
fn bote_icons_check(icons) {
    if (icons == 0) { return 0; }
    var i = 0;
    while (i < vec_len(icons)) {
        var ic = vec_get(icons, i);
        if (ic == 0) { return "an icon is missing"; }
        var src = bote_icon_src(ic);
        if (src == 0 || (bote_web_url_ok(src) == 0 && _bote_data_uri_ok(src) == 0)) {
            return "an icon's src must be an http:// or https:// URL, or a data: URI of Base64 data";
        }
        var m = bote_icon_mime_type(ic);
        if (m != 0 && _bote_mime_ok(m) == 0) { return "an icon's mimeType must be type/subtype"; }
        var sz = bote_icon_sizes(ic);
        if (sz != 0) {
            var k = 0;
            while (k < vec_len(sz)) {
                var one = vec_get(sz, k);
                if (one == 0 || _bote_size_ok(one) == 0) { return "an icon's size must be WxH or \"any\""; }
                k = k + 1;
            }
        }
        var th = bote_icon_theme(ic);
        if (th != 0 && streq(th, "light") == 0 && streq(th, "dark") == 0) {
            return "an icon's theme must be \"light\" or \"dark\"";
        }
        i = i + 1;
    }
    return 0;
}

# Why `title` and `icons` cannot be sent beside a name, or 0 when they can.
fn bote_display_check(title, icons) {
    return bote_icons_check(icons);
}

# What a list says beside a name, `,"title":"…","icons":[…]`, or 0 for neither: built
# once, from what passed bote_display_check, so a list appends bytes already escaped.
fn _bote_display_json(title, icons) {
    if (title == 0 && icons == 0) { return 0; }
    var sb = str_builder_new();
    if (title != 0) {
        str_builder_add_cstr(sb, ",\"title\":\"");
        bote_json_escape(sb, title);
        str_builder_add_cstr(sb, "\"");
    }
    if (icons != 0) {
        str_builder_add_cstr(sb, ",\"icons\":[");
        var i = 0;
        while (i < vec_len(icons)) {
            var ic = vec_get(icons, i);
            if (i > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"src\":\"");
            bote_json_escape(sb, bote_icon_src(ic));
            str_builder_add_cstr(sb, "\"");
            if (bote_icon_mime_type(ic) != 0) {
                str_builder_add_cstr(sb, ",\"mimeType\":\"");
                bote_json_escape(sb, bote_icon_mime_type(ic));
                str_builder_add_cstr(sb, "\"");
            }
            var sz = bote_icon_sizes(ic);
            if (sz != 0) {
                str_builder_add_cstr(sb, ",\"sizes\":[");
                var k = 0;
                while (k < vec_len(sz)) {
                    if (k > 0) { str_builder_add_cstr(sb, ","); }
                    str_builder_add_cstr(sb, "\"");
                    bote_json_escape(sb, vec_get(sz, k));
                    str_builder_add_cstr(sb, "\"");
                    k = k + 1;
                }
                str_builder_add_cstr(sb, "]");
            }
            if (bote_icon_theme(ic) != 0) {
                str_builder_add_cstr(sb, ",\"theme\":\"");
                bote_json_escape(sb, bote_icon_theme(ic));
                str_builder_add_cstr(sb, "\"");
            }
            str_builder_add_cstr(sb, "}");
            i = i + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    return str_data(str_builder_build(sb));
}

# ---- multi round-trip requests: what a handler reads (3.8.2) --------------------------
#
# The rest is in src/protocol.cyr, beside the request state these read.

# 1 when the request's client declared capability `cap`: "elicitation", "elicitation.form",
# "elicitation.url", "sampling", "sampling.tools" or "roots" (any name a client may declare,
# a dot before a sub-capability). A bare `elicitation: {}` declares form mode, as the spec
# has it. 0 on an older revision, where nothing is declared per request.
fn bote_client_has(cap) {
    var caps = load64(bote_req_state() + BOTE_REQ_STATE_INPUT);
    if (caps == 0 || cap == 0) { return 0; }
    return bote_caps_have(caps, cap);
}

# The same for any `clientCapabilities` object `caps`. It allocates nothing, so a handler's
# own thread may ask: on a server with one loop, that thread shares the request state,
# and a mark and release of the request arena there would give back what its handler holds.
fn bote_caps_have(caps, cap) {
    if (caps == 0 || cap == 0) { return 0; }
    var n = strlen(cap);
    var dot = 0;
    while (dot < n && load8(cap + dot) != 46) { dot = dot + 1; }
    var cl = strlen(caps);
    var k[16];
    var p[8];
    store64(&k, cap);
    store64(&k + 8, dot);
    _jx_scan(caps, cl, &k, 1, &p);
    var tp = load64(&p);
    if (tp < 0 || load8(caps + tp) != 123) { return 0; }
    if (dot == n) { return 1; }
    store64(&k, cap + dot + 1);
    store64(&k + 8, n - dot - 1);
    _jx_scan(caps + tp, cl - tp, &k, 1, &p);
    var sp = load64(&p);
    if (sp >= 0 && load8(caps + tp + sp) == 123) { return 1; }
    # `elicitation: {}`, with no mode named, is form mode.
    if (dot == 11 && memeq(cap, "elicitation", 11) == 1 && streq(cap + 12, "form") == 1) {
        var i = _jx_skip_ws(caps, cl, tp + 1);
        if (i < cl && load8(caps + i) == 125) { return 1; }
    }
    return 0;
}

fn bote_input_response_a(a, key) {
    var all = bote_input_responses_a(a);
    if (all == 0) { return 0; }
    return jsonx_get_raw_a(a, all, key);
}

# What an elicitation the client accepted gave, its `content` object, as raw JSON on `a`;
# 0 when there is no answer under `key`, or it declined or cancelled.
fn bote_input_accepted_a(a, key) {
    var r = bote_input_response_a(a, key);
    if (r == 0) { return 0; }
    var act = jsonx_get_str_dec_a(a, r, "action");
    if (act == 0 || streq(act, "accept") == 0) { return 0; }
    var c = jsonx_get_raw_a(a, r, "content");
    if (c == 0) { return "{}"; }
    return c;
}

# --- regex.cyr ---

# bote::regex — the ECMA-262 regular expressions JSON Schema's `pattern` names (3.8.11),
# matched in time linear in the string.
#
# A pattern is read as the official client reads it: Ajv compiles `new RegExp(pattern, "u")`,
# so it matches code points, not UTF-16 units, and the `u` flag's stricter syntax holds: an
# escape of a letter that means nothing, a lone `{`, `}` or `]`, a quantifier on an assertion
# or on nothing is no pattern. `pattern` is not anchored: it asks whether the expression
# matches anywhere in the string.
#
# bote_rx_compile parses a pattern to a tree and compiles the tree to a program for a
# Thompson machine (bote_rx_test_a): every way the pattern can match is followed at once, one
# code point at a time, so a string costs its length times the program's length at most,
# and no pattern, `(a*)*b` among them, backtracks exponentially as a backtracking engine
# does. Each step is charged to the judgement's budget.
#
# Not taken (bote_rx_why says why; such a `pattern` judges nothing, and registration warns):
# backreferences, lookahead and lookbehind, `\p{...}` and `\P{...}`, inline modifiers, a
# named group whose name is not ASCII, and a program past BOTE_RX_MAX_INSNS steps.
#
# lib/regex.cyr is not used: it matches bytes, not code points, so `^.{3}$` refuses "été";
# its compile and match state are globals, which worker threads would share; and every match
# allocates on the heap, which a request must not keep.

enum BoteRxOp {
    BOTE_RX_CHAR = 1;
    BOTE_RX_ANY = 2;
    BOTE_RX_CLASS = 3;
    BOTE_RX_SPLIT = 4;
    BOTE_RX_JMP = 5;
    BOTE_RX_BOL = 6;
    BOTE_RX_EOL = 7;
    BOTE_RX_WORDB = 8;
    BOTE_RX_NWORDB = 9;
    BOTE_RX_MATCH = 10;
}

enum BoteRxNode {
    BOTE_RXN_CHAR = 1;
    BOTE_RXN_ANY = 2;
    BOTE_RXN_CLASS = 3;
    BOTE_RXN_CAT = 4;
    BOTE_RXN_ALT = 5;
    BOTE_RXN_REP = 6;
    BOTE_RXN_ASSERT = 7;
    BOTE_RXN_EMPTY = 8;
}

# The most steps a program may have, the deepest groups may nest, and the largest bound a
# quantifier may name: `a{5000}` is 5,000 steps, past the first.
var BOTE_RX_MAX_INSNS = 4096;
var BOTE_RX_MAX_DEPTH = 64;
var BOTE_RX_MAX_COUNT = 10000;
# (3.8.13) The longest program whose steps seen are an array cleared at each match; a longer
# one's are a sparse set.
var BOTE_RX_SPARSE_FROM = 64;

# ================================================================
# Regex (48 bytes):
#   +0  insns     the program, 24 bytes a step: +0 the op, +8 and +16 its operands
#                 (CHAR: the code point; CLASS: its ranges and 1 when negated; SPLIT: both
#                 targets; JMP: the target)
#   +8  count     how many steps
#   +16 why       0 when it compiled, else why bote's engine does not take the pattern
#   +24 anchored  1 when every match starts at the string's start (a leading `^`)
#   +32 names     (3.8.13) 1 when two groups share a name, in two alternatives
#   +40 refused   (3.8.14) 1 when `why` says JavaScript refuses the pattern with the u flag,
#                 0 when bote's engine only declines one JavaScript takes
#
# A class's ranges are one array: +0 how many, then each range's first and last code point.
# ================================================================

fn bote_rx_why(rx) { return load64(rx + 16); }
fn bote_rx_refused(rx) { return load64(rx + 40); }
fn bote_rx_count(rx) { return load64(rx + 8); }

# ---- Parsing --------------------------------------------------------------------------
#
# The parser's state (112 bytes): +0 the pattern's code points, +8 how many, +16 where it
# reads, +24 why it stopped, +32 how deep its groups are, +40 the named groups so far, each
# name in the order it was given, +48 how many of each name's groups can take part in a match
# with a group from here (a map), +56 1 once a name has been given twice at all, +64 the
# allocator everything here comes from (the compile's arena), +72 the allocator a class's
# ranges, which the program keeps, come from; (3.8.14, from the 3.8.13 review) +80 why bote's
# engine declines the pattern, which JavaScript takes, or 0, +88 how many capturing groups,
# +96 each backreference, two words (its number, or 0 and its name), or 0 for none yet, +104
# 1 when +24 is a decline that stopped the parse (groups nested past bote's bound). A node (32
# bytes): +0 its kind, +8 and +16 its operands, +24 its child or its children's vec.
#
# (3.8.14, from the 3.8.13 review) A construct the engine declines is read through, every
# part of it, so what JavaScript refuses after it, or in it, is found: through 3.8.13 the
# parse stopped at a lookahead, and `(?=a)*`, which the u flag refuses, was declined as a
# lookahead, and registration took it.
#
# (3.8.13, from the 3.8.12 review) A pattern is compiled on the heap forms' scratch and only
# its program kept: `^p0.{0,2000}$` kept 382 KB of the heap for good, the code
# generation's vec at each size it grew to beside the program's copy, and registration
# compiled each pattern twice.
#
# (3.8.12, from the 3.8.11 review) What matches only the empty string is one EMPTY node: a
# concatenation leaves it out, a quantifier on it or with a bound of 0 is it, and so is an
# alternation of nothing else. So every other node compiles to one step at least, and a
# quantifier's copies are bounded by the program's: `((a{0}){10000}){10000}` compiled each
# of its 10^8 empty copies, and a third level would not end.

fn _brx_node(ps, kind, a, b, c) {
    var n = alloc_via(load64(ps + 64), 32);
    store64(n, kind);
    store64(n + 8, a);
    store64(n + 16, b);
    store64(n + 24, c);
    return n;
}

fn _brx_fail(ps, why) {
    if (load64(ps + 24) == 0) { store64(ps + 24, why); }
    return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0);
}

# A construct JavaScript takes and bote's engine does not (3.8.14): noted, and the parse goes
# on, so what follows is read as the u flag reads it.
fn _brx_decline(ps, why) {
    if (load64(ps + 80) == 0) { store64(ps + 80, why); }
    return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0);
}

# A decline the parse cannot go past: groups nested deeper than its stack is bounded for.
fn _brx_stop_decline(ps, why) {
    if (load64(ps + 24) == 0) { store8(ps + 104, 1); }
    _brx_decline(ps, why);
    return _brx_fail(ps, why);
}

# A backreference by number (`num`), or by name (`num` 0, `name`), checked once the pattern is
# read: the u flag refuses one that names no group.
fn _brx_backref(ps, num, name) {
    var a = load64(ps + 64);
    if (load64(ps + 96) == 0) { store64(ps + 96, vec_new_a(a)); }
    vec_push_a(a, load64(ps + 96), num);
    vec_push_a(a, load64(ps + 96), name);
    return 0;
}

fn _brx_peek_at(ps, k) {
    var p = load64(ps + 16) + k;
    if (p >= load64(ps + 8)) { return 0 - 1; }
    return load64(load64(ps) + p * 8);
}
fn _brx_peek(ps) { return _brx_peek_at(ps, 0); }
fn _brx_take(ps) {
    var c = _brx_peek(ps);
    if (c >= 0) { store64(ps + 16, load64(ps + 16) + 1); }
    return c;
}

# The code points of the UTF-8 cstr `src` (text: _sch_str_dec_a decoded it), their number
# at *out_n.
fn _brx_cps(a, src, out_n) {
    var n = strlen(src);
    var cps = alloc_via(a, n * 8 + 8);
    var i = 0;
    var k = 0;
    while (i < n) {
        var b = load8(src + i);
        var cp = b;
        var len = 1;
        if (b >= 240) { cp = b & 7; len = 4; }
        elif (b >= 224) { cp = b & 15; len = 3; }
        elif (b >= 192) { cp = b & 31; len = 2; }
        var j = 1;
        while (j < len && i + j < n) { cp = cp * 64 + (load8(src + i + j) & 63); j = j + 1; }
        store64(cps + k * 8, cp);
        k = k + 1;
        i = i + len;
    }
    store64(out_n, k);
    return cps;
}

fn _brx_hex(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 65 && c <= 70) { return c - 55; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0 - 1;
}

fn _brx_disj(ps) {
    var a = load64(ps + 64);
    var decls = load64(ps + 40);
    var dstart = vec_len(decls);
    var astart = dstart;
    var first = _brx_alt(ps);
    var v = 0;
    var full = 0;
    if (load64(first) != BOTE_RXN_EMPTY) { full = 1; }
    if (_brx_peek(ps) == 124) {
        v = vec_new_a(a);
        vec_push_a(a, v, first);
        while (_brx_peek(ps) == 124 && load64(ps + 24) == 0) {
            _brx_take(ps);
            # The alternative just read: its names cannot take part with the next's.
            _brx_names_seen(ps, astart, vec_len(decls), 0 - 1);
            astart = vec_len(decls);
            var nx = _brx_alt(ps);
            if (load64(nx) != BOTE_RXN_EMPTY) { full = 1; }
            vec_push_a(a, v, nx);
        }
    }
    # Past the disjunction, every name in it can take part with what follows.
    _brx_names_seen(ps, dstart, astart, 1);
    if (v == 0 || full == 0) { return first; }
    return _brx_node(ps, BOTE_RXN_ALT, 0, 0, v);
}

fn _brx_alt(ps) {
    var a = load64(ps + 64);
    var v = vec_new_a(a);
    while (load64(ps + 24) == 0) {
        var c = _brx_peek(ps);
        if (c < 0 || c == 124 || c == 41) { break; }
        var t = _brx_term(ps);
        if (load64(t) != BOTE_RXN_EMPTY) { vec_push_a(a, v, t); }
    }
    if (vec_len(v) == 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
    if (vec_len(v) == 1) { return vec_get(v, 0); }
    return _brx_node(ps, BOTE_RXN_CAT, 0, 0, v);
}

fn _brx_quant_next(ps) {
    var c = _brx_peek(ps);
    if (c == 42 || c == 43 || c == 63 || c == 123) { return 1; }
    return 0;
}

fn _brx_term(ps) {
    var c = _brx_peek(ps);
    var c1 = _brx_peek_at(ps, 1);
    var asrt = 0;
    var adv = 1;
    if (c == 94) { asrt = BOTE_RX_BOL; }
    elif (c == 36) { asrt = BOTE_RX_EOL; }
    elif (c == 92 && c1 == 98) { asrt = BOTE_RX_WORDB; adv = 2; }
    elif (c == 92 && c1 == 66) { asrt = BOTE_RX_NWORDB; adv = 2; }
    if (asrt != 0) {
        store64(ps + 16, load64(ps + 16) + adv);
        if (_brx_quant_next(ps) == 1) { return _brx_fail(ps, "a quantifier on an assertion"); }
        return _brx_node(ps, BOTE_RXN_ASSERT, asrt, 0, 0);
    }
    if (c == 40 && c1 == 63) {
        var c2 = _brx_peek_at(ps, 2);
        var look = 0;
        if (c2 == 61 || c2 == 33) { look = 3; }
        elif (c2 == 60 && (_brx_peek_at(ps, 3) == 61 || _brx_peek_at(ps, 3) == 33)) { look = 4; }
        if (look != 0) {
            # (3.8.14) Read through: its alternatives, its close, and a quantifier after it,
            # which the u flag refuses on any assertion.
            if (look == 3) { _brx_decline(ps, "a lookahead"); }
            else { _brx_decline(ps, "a lookbehind"); }
            if (load64(ps + 32) >= BOTE_RX_MAX_DEPTH) { return _brx_stop_decline(ps, "groups nested past bote's bound"); }
            store64(ps + 16, load64(ps + 16) + look);
            store64(ps + 32, load64(ps + 32) + 1);
            _brx_disj(ps);
            store64(ps + 32, load64(ps + 32) - 1);
            if (load64(ps + 24) != 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
            if (_brx_take(ps) != 41) { return _brx_fail(ps, "an unterminated group"); }
            if (_brx_quant_next(ps) == 1) { return _brx_fail(ps, "a quantifier on an assertion"); }
            return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0);
        }
    }
    var atom = _brx_atom(ps);
    if (load64(ps + 24) != 0) { return atom; }
    return _brx_quant(ps, atom);
}

# The decimal digits at [s1, e1) of the pattern against those at [s2, e2), by value: below 0,
# 0 or above 0.
fn _brx_digits_cmp(ps, s1, e1, s2, e2) {
    var cps = load64(ps);
    while (s1 < e1 - 1 && load64(cps + s1 * 8) == 48) { s1 = s1 + 1; }
    while (s2 < e2 - 1 && load64(cps + s2 * 8) == 48) { s2 = s2 + 1; }
    if (e1 - s1 != e2 - s2) { return (e1 - s1) - (e2 - s2); }
    while (s1 < e1) {
        var d = load64(cps + s1 * 8) - load64(cps + s2 * 8);
        if (d != 0) { return d; }
        s1 = s1 + 1;
        s2 = s2 + 1;
    }
    return 0;
}

# Digits at the parser as a number, held at BOTE_RX_MAX_COUNT + 1; -1 for none.
fn _brx_number(ps) {
    var c = _brx_peek(ps);
    if (c < 48 || c > 57) { return 0 - 1; }
    var v = 0;
    while (c >= 48 && c <= 57) {
        if (v <= BOTE_RX_MAX_COUNT) { v = v * 10 + (c - 48); }
        _brx_take(ps);
        c = _brx_peek(ps);
    }
    if (v > BOTE_RX_MAX_COUNT) { v = BOTE_RX_MAX_COUNT + 1; }
    return v;
}

fn _brx_quant(ps, atom) {
    var c = _brx_peek(ps);
    var mn = 0;
    var mx = 0 - 1;
    if (c == 42) { _brx_take(ps); }
    elif (c == 43) { _brx_take(ps); mn = 1; }
    elif (c == 63) { _brx_take(ps); mx = 1; }
    elif (c == 123) {
        _brx_take(ps);
        var ns = load64(ps + 16);
        mn = _brx_number(ps);
        if (mn < 0) { return _brx_fail(ps, "a { that begins no quantifier"); }
        var ne = load64(ps + 16);
        var xs = ns;
        var xe = ne;
        mx = mn;
        if (_brx_peek(ps) == 44) {
            _brx_take(ps);
            if (_brx_peek(ps) == 125) { mx = 0 - 1; }
            else {
                xs = load64(ps + 16);
                mx = _brx_number(ps);
                if (mx < 0) { return _brx_fail(ps, "a { that begins no quantifier"); }
                xe = load64(ps + 16);
            }
        }
        if (_brx_peek(ps) != 125) { return _brx_fail(ps, "a { that begins no quantifier"); }
        _brx_take(ps);
        # (3.8.14) Past bote's bound each number is held at it, so two such are compared as
        # written: `a{20000,10001}` the u flag refuses.
        if (mx >= 0 && (mx < mn || (mn > BOTE_RX_MAX_COUNT && _brx_digits_cmp(ps, xs, xe, ns, ne) < 0))) { return _brx_fail(ps, "a quantifier whose bounds are out of order"); }
    } else { return atom; }
    # A lazy quantifier matches the same strings.
    if (_brx_peek(ps) == 63) { _brx_take(ps); }
    if (_brx_quant_next(ps) == 1) { return _brx_fail(ps, "a quantifier on a quantifier"); }
    if (mn > BOTE_RX_MAX_COUNT || mx > BOTE_RX_MAX_COUNT) { return _brx_decline(ps, "a quantifier past bote's bound"); }
    if (load64(atom) == BOTE_RXN_EMPTY || mx == 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
    return _brx_node(ps, BOTE_RXN_REP, mn, mx, atom);
}

fn _brx_atom(ps) {
    var c = _brx_take(ps);
    if (c == 46) { return _brx_node(ps, BOTE_RXN_ANY, 0, 0, 0); }
    if (c == 40) { return _brx_group(ps); }
    if (c == 91) { return _brx_class(ps); }
    if (c == 92) { return _brx_escape(ps); }
    if (c == 42 || c == 43 || c == 63) { return _brx_fail(ps, "a quantifier on nothing"); }
    if (c == 123 || c == 125 || c == 93) { return _brx_fail(ps, "a lone {, } or ], which the u flag refuses"); }
    return _brx_node(ps, BOTE_RXN_CHAR, c, 0, 0);
}

fn _brx_name_start(c) {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36) { return 1; }
    return 0;
}

fn _brx_group(ps) {
    if (load64(ps + 32) >= BOTE_RX_MAX_DEPTH) { return _brx_stop_decline(ps, "groups nested past bote's bound"); }
    if (_brx_peek(ps) == 63) {
        _brx_take(ps);
        var g = _brx_take(ps);
        if (g == 60) {
            # A named group, matched as any group is.
            var gnm = _brx_group_name(ps);
            if (load64(ps + 24) != 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
            store64(ps + 88, load64(ps + 88) + 1);
            if (_brx_name_clash(ps, gnm) == 1) {
                return _brx_fail(ps, "two groups named alike that can both match, which the u flag refuses");
            }
        } elif (g != 58) {
            # (3.8.14) An inline modifier, `(?ims-ims:...)` (ES2025), JavaScript takes, and
            # bote's engine does not; any other `(?` the u flag refuses.
            store64(ps + 16, load64(ps + 16) - 1);
            if (_brx_modifiers(ps) == 0) { return _brx_fail(ps, "a group the u flag refuses"); }
            _brx_decline(ps, "an inline modifier");
        }
    } else { store64(ps + 88, load64(ps + 88) + 1); }
    store64(ps + 32, load64(ps + 32) + 1);
    var inner = _brx_disj(ps);
    store64(ps + 32, load64(ps + 32) - 1);
    if (load64(ps + 24) != 0) { return inner; }
    if (_brx_take(ps) != 41) { return _brx_fail(ps, "an unterminated group"); }
    return inner;
}

# (3.8.14) A group's name after `(?<` or `\\k<`, through its `>`, as it decodes: a cstr of its
# UTF-8 on the compile's arena, its `\\u` escapes read (a surrogate pair as one), or 0 with the
# parser stopped (a syntax error) when the u flag refuses it: an empty name, an unterminated
# one, an ASCII character no identifier holds, a first character that is a digit, an escape
# that is no `\\u` escape, or a lone surrogate. Whether a character past ASCII is one an
# identifier may hold bote does not read, and the name is declined.
fn _brx_group_name(ps) {
    var a = load64(ps + 64);
    # (3.8.15, from the 3.8.14 review) Room for the name alone, as far as its `>` (or the
    # pattern's end): sized by what was left of the pattern, each name kept that much of the
    # arena, 3.6 GB for 80 KB of `\k<a>`.
    var span = 0;
    while (_brx_peek_at(ps, span) >= 0 && _brx_peek_at(ps, span) != 62) { span = span + 1; }
    var room = span * 4 + 8;
    var nm = alloc_via(a, room);
    var o = 0;
    var nc = _brx_take(ps);
    if (nc == 62) { _brx_fail(ps, "an empty group name, which the u flag refuses"); return 0; }
    var plain = 1;
    var first = 1;
    while (nc != 62) {
        if (nc < 0) { _brx_fail(ps, "an unterminated group name"); return 0; }
        var cp = nc;
        if (nc == 92) {
            if (_brx_take(ps) != 117) { _brx_fail(ps, "an escape in a group name the u flag refuses"); return 0; }
            cp = _brx_name_escape(ps);
            if (cp < 0) { return 0; }
            if (cp >= 55296 && cp <= 56319 && _brx_peek(ps) == 92 && _brx_peek_at(ps, 1) == 117) {
                var mark = load64(ps + 16);
                _brx_take(ps);
                _brx_take(ps);
                var lo = _brx_name_escape(ps);
                if (lo >= 56320 && lo <= 57343) { cp = 65536 + (cp - 55296) * 1024 + (lo - 56320); }
                else {
                    if (load64(ps + 24) != 0) { return 0; }
                    store64(ps + 16, mark);
                }
            }
        }
        if (cp >= 55296 && cp <= 57343) { _brx_fail(ps, "a group name the u flag refuses"); return 0; }
        if (cp >= 128) { plain = 0; }
        elif (_brx_name_start(cp) == 0 && (first == 1 || cp < 48 || cp > 57)) {
            _brx_fail(ps, "a group name the u flag refuses");
            return 0;
        }
        o = _brx_put_utf8(nm, o, cp);
        first = 0;
        nc = _brx_take(ps);
    }
    store8(nm + o, 0);
    if (plain == 0) {
        store64(ps + 112, 1);
        _brx_decline(ps, "a group name bote's engine does not take");
    }
    return nm;
}

# The code point of a `\\u` escape in a group name, after its `u`: four hex digits or `{hex}`,
# or -1 with the parser stopped.
fn _brx_name_escape(ps) {
    if (_brx_peek(ps) == 123) {
        _brx_take(ps);
        var v = 0;
        var nd = 0;
        while (_brx_hex(_brx_peek(ps)) >= 0) {
            v = v * 16 + _brx_hex(_brx_take(ps));
            nd = nd + 1;
            if (v > 1114111) { _brx_fail(ps, "an escape in a group name the u flag refuses"); return 0 - 1; }
        }
        if (nd == 0 || _brx_take(ps) != 125) { _brx_fail(ps, "an escape in a group name the u flag refuses"); return 0 - 1; }
        return v;
    }
    var u = _brx_hex4(ps, 0);
    if (u < 0) { _brx_fail(ps, "an escape in a group name the u flag refuses"); return 0 - 1; }
    store64(ps + 16, load64(ps + 16) + 4);
    return u;
}

# The code point `cp` as UTF-8 at buf[o], and where it ends.
fn _brx_put_utf8(buf, o, cp) {
    if (cp < 128) { store8(buf + o, cp); return o + 1; }
    if (cp < 2048) { store8(buf + o, 192 | (cp >> 6)); store8(buf + o + 1, 128 | (cp & 63)); return o + 2; }
    if (cp < 65536) { store8(buf + o, 224 | (cp >> 12)); store8(buf + o + 1, 128 | ((cp >> 6) & 63)); store8(buf + o + 2, 128 | (cp & 63)); return o + 3; }
    store8(buf + o, 240 | (cp >> 18));
    store8(buf + o + 1, 128 | ((cp >> 12) & 63));
    store8(buf + o + 2, 128 | ((cp >> 6) & 63));
    store8(buf + o + 3, 128 | (cp & 63));
    return o + 4;
}

# (3.8.14) `(?` then flags and a `:` as an inline modifier is written (ES2025): `i`, `m` or
# `s`, each once, perhaps a `-` and more, never none on both sides. 1 when it is one, read
# through the `:`; 0 when it is not, the parser where it stopped.
fn _brx_modifiers(ps) {
    var seen = 0;
    var on = 0;
    var off = 0;
    var neg = 0;
    var c = _brx_take(ps);
    while (c != 58) {
        if (c == 45 && neg == 0) { neg = 1; }
        else {
            var b = 0;
            if (c == 105) { b = 1; }
            elif (c == 109) { b = 2; }
            elif (c == 115) { b = 4; }
            if (b == 0 || (seen & b) != 0) { return 0; }
            seen = seen | b;
            if (neg == 0) { on = on + 1; } else { off = off + 1; }
        }
        c = _brx_take(ps);
    }
    if (on == 0 && off == 0) { return 0; }
    return 1;
}

# (3.8.12, from the 3.8.11 review) 1 when the name `nm` (3.8.14: decoded, _brx_group_name) was given to
# a group before that can take part in the same match as this one, which ECMA-262 refuses
# (MightBothParticipate): two groups may share a name only from two alternatives of one
# disjunction. (3.8.13, from the 3.8.12 review) Each name keeps a count of its groups that
# can take part with a group from where the parser reads: a disjunction's alternative takes
# its names out when the next begins and gives every one back when the disjunction ends
# (_brx_names_seen), so a name costs one look, where through 3.8.12 each was compared with
# every name before it, 13 s for 32,000 groups. The name is recorded.
fn _brx_name_clash(ps, nm) {
    var a = load64(ps + 64);
    var vis = load64(ps + 48);
    var clash = 0;
    if (map_has(vis, nm) == 1) {
        store64(ps + 56, 1);
        if (map_get(vis, nm) > 0) { clash = 1; }
    }
    map_set_a(a, vis, nm, map_get(vis, nm) + 1);
    vec_push_a(a, load64(ps + 40), nm);
    return clash;
}

# Add `d` to the count of each name given in [from, to) of the parser's named groups.
fn _brx_names_seen(ps, from, to, d) {
    var a = load64(ps + 64);
    var decls = load64(ps + 40);
    var vis = load64(ps + 48);
    var i = from;
    while (i < to) {
        var nm = vec_get(decls, i);
        map_set_a(a, vis, nm, map_get(vis, nm) + d);
        i = i + 1;
    }
    return 0;
}

# A character escape after its backslash, `c` the character after it: the code point it
# means, or -1 with the parser stopped. `cls` is 1 inside a class, where `\-` and `\b` mean
# something too.
fn _brx_char_escape(ps, c, cls) {
    if (c == 102) { return 12; }
    if (c == 110) { return 10; }
    if (c == 114) { return 13; }
    if (c == 116) { return 9; }
    if (c == 118) { return 11; }
    if (c == 99) {
        var l = _brx_peek(ps);
        if ((l >= 65 && l <= 90) || (l >= 97 && l <= 122)) { _brx_take(ps); return l % 32; }
        _brx_fail(ps, "a \\c not followed by a letter");
        return 0 - 1;
    }
    if (c == 120) {
        var h1 = _brx_hex(_brx_peek(ps));
        var h2 = _brx_hex(_brx_peek_at(ps, 1));
        if (h1 < 0 || h2 < 0) { _brx_fail(ps, "a \\x not followed by two hex digits"); return 0 - 1; }
        _brx_take(ps);
        _brx_take(ps);
        return h1 * 16 + h2;
    }
    if (c == 117) {
        if (_brx_peek(ps) == 123) {
            _brx_take(ps);
            var v = 0;
            var nd = 0;
            while (_brx_hex(_brx_peek(ps)) >= 0) {
                v = v * 16 + _brx_hex(_brx_take(ps));
                nd = nd + 1;
                if (v > 1114111) { _brx_fail(ps, "a \\u{...} past U+10FFFF"); return 0 - 1; }
            }
            if (nd == 0 || _brx_take(ps) != 125) { _brx_fail(ps, "a \\u{ not closed by hex digits and }"); return 0 - 1; }
            return v;
        }
        var u = _brx_hex4(ps, 0);
        if (u < 0) { _brx_fail(ps, "a \\u not followed by four hex digits"); return 0 - 1; }
        store64(ps + 16, load64(ps + 16) + 4);
        # A surrogate pair written as two escapes is one code point under the u flag.
        if (u >= 55296 && u <= 56319 && _brx_peek(ps) == 92 && _brx_peek_at(ps, 1) == 117) {
            var lo = _brx_hex4(ps, 2);
            if (lo >= 56320 && lo <= 57343) {
                store64(ps + 16, load64(ps + 16) + 6);
                return 65536 + (u - 55296) * 1024 + (lo - 56320);
            }
        }
        return u;
    }
    # The syntax characters and `/`, each itself.
    if (c == 94 || c == 36 || c == 92 || c == 46 || c == 42 || c == 43 || c == 63 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 124 || c == 47) { return c; }
    if (cls == 1 && c == 45) { return 45; }
    if (cls == 1 && c == 98) { return 8; }
    _brx_fail(ps, "an escape the u flag refuses");
    return 0 - 1;
}

# (3.8.14) What follows `\\p` or `\\P`, as the u flag requires it written: `{`, a name of
# letters and `_`, perhaps `=` and a value of letters, digits and `_`, and `}`. 1 when it is,
# read through the `}`; 0 with the parser stopped. Whether the name is one ECMA-262 knows
# bote does not read, and the escape is declined.
fn _brx_property(ps) {
    if (_brx_take(ps) != 123) { _brx_fail(ps, "a \\p not followed by {, which the u flag refuses"); return 0; }
    var c = _brx_take(ps);
    var n = 0;
    while ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) { n = n + 1; c = _brx_take(ps); }
    if (n == 0) { _brx_fail(ps, "a Unicode property escape the u flag refuses"); return 0; }
    if (c == 61) {
        var m = 0;
        c = _brx_take(ps);
        while ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95) { m = m + 1; c = _brx_take(ps); }
        if (m == 0) { _brx_fail(ps, "a Unicode property escape the u flag refuses"); return 0; }
    }
    if (c != 125) { _brx_fail(ps, "a Unicode property escape the u flag refuses"); return 0; }
    return 1;
}

# Four hex digits `k` past the parser's place, or -1.
fn _brx_hex4(ps, k) {
    var v = 0;
    var i = 0;
    while (i < 4) {
        var h = _brx_hex(_brx_peek_at(ps, k + i));
        if (h < 0) { return 0 - 1; }
        v = v * 16 + h;
        i = i + 1;
    }
    return v;
}

fn _brx_escape(ps) {
    var c = _brx_take(ps);
    if (c < 0) { return _brx_fail(ps, "a pattern that ends in a backslash"); }
    if (c == 100 || c == 68 || c == 115 || c == 83 || c == 119 || c == 87) {
        var r = vec_new_a(load64(ps + 64));
        _brx_builtin(ps, r, c);
        return _brx_node(ps, BOTE_RXN_CLASS, _brx_flat(ps, r), 0, 0);
    }
    if (c == 112 || c == 80) {
        if (_brx_property(ps) == 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
        return _brx_decline(ps, "a Unicode property escape");
    }
    if (c == 107) {
        # (3.8.14) `\\k<name>`, which the u flag requires to name a group of the pattern.
        if (_brx_take(ps) != 60) { return _brx_fail(ps, "a \\k not followed by a group name, which the u flag refuses"); }
        var knm = _brx_group_name(ps);
        if (load64(ps + 24) != 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
        _brx_backref(ps, 0, knm);
        return _brx_decline(ps, "a named backreference");
    }
    if (c >= 49 && c <= 57) {
        # (3.8.14) A decimal escape, every digit of it, which the u flag requires to name a
        # capturing group of the pattern.
        var bn = c - 48;
        while (_brx_peek(ps) >= 48 && _brx_peek(ps) <= 57) {
            if (bn <= BOTE_RX_MAX_COUNT) { bn = bn * 10 + (_brx_peek(ps) - 48); }
            _brx_take(ps);
        }
        _brx_backref(ps, bn, 0);
        return _brx_decline(ps, "a backreference");
    }
    if (c == 48) {
        var d = _brx_peek(ps);
        if (d >= 48 && d <= 57) { return _brx_fail(ps, "a \\0 followed by a digit, which the u flag refuses"); }
        return _brx_node(ps, BOTE_RXN_CHAR, 0, 0, 0);
    }
    var cp = _brx_char_escape(ps, c, 0);
    if (cp < 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
    return _brx_node(ps, BOTE_RXN_CHAR, cp, 0, 0);
}

# The ranges of `\d`, `\w` or `\s` (the letter `e`, its capital the complement) pushed onto
# `r`, two words each, in order. `\s` is ECMA-262's white space and line terminators.
fn _brx_builtin(ps, r, e) {
    var a = load64(ps + 64);
    var b = vec_new_a(a);
    if (e == 100 || e == 68) { vec_push_a(a, b, 48); vec_push_a(a, b, 57); }
    elif (e == 119 || e == 87) {
        vec_push_a(a, b, 48); vec_push_a(a, b, 57);
        vec_push_a(a, b, 65); vec_push_a(a, b, 90);
        vec_push_a(a, b, 95); vec_push_a(a, b, 95);
        vec_push_a(a, b, 97); vec_push_a(a, b, 122);
    } else {
        vec_push_a(a, b, 9); vec_push_a(a, b, 13);
        vec_push_a(a, b, 32); vec_push_a(a, b, 32);
        vec_push_a(a, b, 160); vec_push_a(a, b, 160);
        vec_push_a(a, b, 5760); vec_push_a(a, b, 5760);
        vec_push_a(a, b, 8192); vec_push_a(a, b, 8202);
        vec_push_a(a, b, 8232); vec_push_a(a, b, 8233);
        vec_push_a(a, b, 8239); vec_push_a(a, b, 8239);
        vec_push_a(a, b, 8287); vec_push_a(a, b, 8287);
        vec_push_a(a, b, 12288); vec_push_a(a, b, 12288);
        vec_push_a(a, b, 65279); vec_push_a(a, b, 65279);
    }
    var i = 0;
    if (e == 68 || e == 87 || e == 83) {
        # The complement over every code point.
        var at = 0;
        while (i < vec_len(b)) {
            if (vec_get(b, i) > at) { vec_push_a(a, r, at); vec_push_a(a, r, vec_get(b, i) - 1); }
            at = vec_get(b, i + 1) + 1;
            i = i + 2;
        }
        if (at <= 1114111) { vec_push_a(a, r, at); vec_push_a(a, r, 1114111); }
        return 0;
    }
    while (i < vec_len(b)) { vec_push_a(a, r, vec_get(b, i)); i = i + 1; }
    return 0;
}

# A vec of ranges as one array: its count, then each range's two ends, in order and apart.
# (3.8.12, from the 3.8.11 review) Sorted and merged, so a code point is looked for by
# halving (_brx_in): a class of 4,000 members read each of them for each code point it was
# asked of, and none of it was charged.
fn _brx_flat(ps, r) {
    var k = vec_len(r) / 2;
    var p = alloc_via(load64(ps + 64), k * 16 + 16);
    var tmp = alloc_via(load64(ps + 64), k * 16 + 16);
    var i = 0;
    while (i < k * 2) { store64(p + i * 8, vec_get(r, i)); i = i + 1; }
    var srt = _brx_sort_ranges(p, tmp, k);
    # The ranges the program keeps, on the allocator that keeps it.
    var a = alloc_via(load64(ps + 72), 8 + k * 16);
    var n = 0;
    i = 0;
    while (i < k) {
        var lo = load64(srt + i * 16);
        var hi = load64(srt + i * 16 + 8);
        if (n > 0 && lo <= load64(a + n * 16) + 1) {
            if (hi > load64(a + n * 16)) { store64(a + n * 16, hi); }
        } else {
            store64(a + 8 + n * 16, lo);
            store64(a + 16 + n * 16, hi);
            n = n + 1;
        }
        i = i + 1;
    }
    store64(a, n);
    return a;
}

# Sort the `k` ranges at `p` (two words each) by their first code point, a merge sort with
# `tmp` as room: where they are sorted, `p` or `tmp`.
fn _brx_sort_ranges(p, tmp, k) {
    var src = p;
    var dst = tmp;
    var w = 1;
    while (w < k) {
        var i = 0;
        while (i < k) {
            var mid = i + w;
            if (mid > k) { mid = k; }
            var hi = i + w * 2;
            if (hi > k) { hi = k; }
            var x = i;
            var y = mid;
            var o = i;
            while (o < hi) {
                var from = y;
                if (y >= hi || (x < mid && load64(src + x * 16) <= load64(src + y * 16))) { from = x; x = x + 1; }
                else { y = y + 1; }
                store64(dst + o * 16, load64(src + from * 16));
                store64(dst + o * 16 + 8, load64(src + from * 16 + 8));
                o = o + 1;
            }
            i = hi;
        }
        var t = src;
        src = dst;
        dst = t;
        w = w * 2;
    }
    return src;
}

# One member of a class after the parser's place: its code point, -2 when it was a class
# escape whose ranges went onto `r`, or -1 with the parser stopped.
fn _brx_class_atom(ps, r) {
    var c = _brx_take(ps);
    if (c != 92) { return c; }
    var e = _brx_take(ps);
    if (e < 0) { _brx_fail(ps, "an unterminated character class"); return 0 - 1; }
    if (e == 100 || e == 68 || e == 115 || e == 83 || e == 119 || e == 87) { _brx_builtin(ps, r, e); return 0 - 2; }
    if (e == 112 || e == 80) {
        if (_brx_property(ps) == 0) { return 0 - 1; }
        _brx_decline(ps, "a Unicode property escape");
        return 0 - 2;
    }
    if (e == 48) {
        var d = _brx_peek(ps);
        if (d >= 48 && d <= 57) { _brx_fail(ps, "a \\0 followed by a digit, which the u flag refuses"); return 0 - 1; }
        return 0;
    }
    if (e >= 49 && e <= 57) { _brx_fail(ps, "a decimal escape in a class, which the u flag refuses"); return 0 - 1; }
    return _brx_char_escape(ps, e, 1);
}

fn _brx_class(ps) {
    var neg = 0;
    if (_brx_peek(ps) == 94) { _brx_take(ps); neg = 1; }
    var a = load64(ps + 64);
    var r = vec_new_a(a);
    var go = 1;
    while (go == 1) {
        var c = _brx_peek(ps);
        if (c < 0) { return _brx_fail(ps, "an unterminated character class"); }
        if (c == 93) { _brx_take(ps); go = 0; }
        else {
            var lo = _brx_class_atom(ps, r);
            if (load64(ps + 24) != 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
            if (_brx_peek(ps) == 45 && _brx_peek_at(ps, 1) != 93 && _brx_peek_at(ps, 1) >= 0) {
                _brx_take(ps);
                var hi = _brx_class_atom(ps, r);
                if (load64(ps + 24) != 0) { return _brx_node(ps, BOTE_RXN_EMPTY, 0, 0, 0); }
                if (lo == 0 - 2 || hi == 0 - 2) { return _brx_fail(ps, "a range with a class escape at an end, which the u flag refuses"); }
                if (hi < lo) { return _brx_fail(ps, "a range out of order"); }
                vec_push_a(a, r, lo);
                vec_push_a(a, r, hi);
            } elif (lo >= 0) {
                vec_push_a(a, r, lo);
                vec_push_a(a, r, lo);
            }
        }
    }
    return _brx_node(ps, BOTE_RXN_CLASS, _brx_flat(ps, r), neg, 0);
}

# ---- Compiling ------------------------------------------------------------------------
#
# The compiler's state (24 bytes): +0 the program so far, a vec of three words a step, +8
# why it stopped, +16 the allocator it grows on (the compile's arena).

fn _brx_emit(cg, op, a, b) {
    var v = load64(cg);
    var at = vec_len(v) / 3;
    if (at >= BOTE_RX_MAX_INSNS) {
        if (load64(cg + 8) == 0) { store64(cg + 8, "a program past bote's bound of 4,096 steps"); }
        return at;
    }
    var ca = load64(cg + 16);
    vec_push_a(ca, v, op);
    vec_push_a(ca, v, a);
    vec_push_a(ca, v, b);
    return at;
}

fn _brx_here(cg) { return vec_len(load64(cg)) / 3; }

fn _brx_patch(cg, at, k, val) {
    if (at * 3 + k < vec_len(load64(cg))) { vec_set(load64(cg), at * 3 + k, val); }
    return 0;
}

fn _brx_gen(cg, nd) {
    if (load64(cg + 8) != 0) { return 0; }
    var kind = load64(nd);
    if (kind == BOTE_RXN_CHAR) { _brx_emit(cg, BOTE_RX_CHAR, load64(nd + 8), 0); return 0; }
    if (kind == BOTE_RXN_ANY) { _brx_emit(cg, BOTE_RX_ANY, 0, 0); return 0; }
    if (kind == BOTE_RXN_CLASS) { _brx_emit(cg, BOTE_RX_CLASS, load64(nd + 8), load64(nd + 16)); return 0; }
    if (kind == BOTE_RXN_ASSERT) { _brx_emit(cg, load64(nd + 8), 0, 0); return 0; }
    if (kind == BOTE_RXN_CAT) {
        var v = load64(nd + 24);
        var i = 0;
        while (i < vec_len(v)) { _brx_gen(cg, vec_get(v, i)); i = i + 1; }
        return 0;
    }
    if (kind == BOTE_RXN_ALT) {
        # SPLIT to each branch but the last, each ending in a JMP past the rest.
        var al = load64(nd + 24);
        var jumps = vec_new_a(load64(cg + 16));
        var k = 0;
        while (k < vec_len(al) - 1) {
            var sp = _brx_emit(cg, BOTE_RX_SPLIT, 0, 0);
            _brx_patch(cg, sp, 1, _brx_here(cg));
            _brx_gen(cg, vec_get(al, k));
            vec_push_a(load64(cg + 16), jumps, _brx_emit(cg, BOTE_RX_JMP, 0, 0));
            _brx_patch(cg, sp, 2, _brx_here(cg));
            k = k + 1;
        }
        _brx_gen(cg, vec_get(al, vec_len(al) - 1));
        var j = 0;
        while (j < vec_len(jumps)) { _brx_patch(cg, vec_get(jumps, j), 1, _brx_here(cg)); j = j + 1; }
        return 0;
    }
    if (kind == BOTE_RXN_REP) {
        var mn = load64(nd + 8);
        var mx = load64(nd + 16);
        var x = load64(nd + 24);
        var r = 0;
        while (r < mn && load64(cg + 8) == 0) { _brx_gen(cg, x); r = r + 1; }
        if (mx < 0) {
            var top = _brx_emit(cg, BOTE_RX_SPLIT, 0, 0);
            _brx_patch(cg, top, 1, _brx_here(cg));
            _brx_gen(cg, x);
            _brx_emit(cg, BOTE_RX_JMP, top, 0);
            _brx_patch(cg, top, 2, _brx_here(cg));
            return 0;
        }
        var opts = vec_new_a(load64(cg + 16));
        while (r < mx && load64(cg + 8) == 0) {
            var os = _brx_emit(cg, BOTE_RX_SPLIT, 0, 0);
            _brx_patch(cg, os, 1, _brx_here(cg));
            vec_push_a(load64(cg + 16), opts, os);
            _brx_gen(cg, x);
            r = r + 1;
        }
        var oi = 0;
        while (oi < vec_len(opts)) { _brx_patch(cg, vec_get(opts, oi), 2, _brx_here(cg)); oi = oi + 1; }
        return 0;
    }
    return 0;
}

# (3.8.14) Each backreference names a group of the pattern, as the u flag requires: a number
# no larger than its capturing groups, and a name one of them is given (unless a name is one
# bote does not read, when it cannot be sure).
fn _brx_check_backrefs(ps) {
    var br = load64(ps + 96);
    if (br == 0) { return 0; }
    var i = 0;
    while (i < vec_len(br)) {
        var num = vec_get(br, i);
        var name = vec_get(br, i + 1);
        if (num > 0 && num > load64(ps + 88)) { _brx_fail(ps, "a backreference to no group, which the u flag refuses"); return 0; }
        if (num == 0 && _brx_name_given(ps, name) == 0) { _brx_fail(ps, "a named backreference to no group, which the u flag refuses"); return 0; }
        i = i + 2;
    }
    return 0;
}

# 1 when a group was given the name `name`: one look in the parser's map of named groups
# (3.8.15, from the 3.8.14 review; each name was compared with every one, 1.6 s for 8,000
# groups and as many backreferences).
fn _brx_name_given(ps, name) {
    if (name == 0) { return 0; }
    return map_has(load64(ps + 48), name);
}

# 1 when the tree's every match starts with `^`.
fn _brx_anchored(nd) {
    var kind = load64(nd);
    if (kind == BOTE_RXN_ASSERT && load64(nd + 8) == BOTE_RX_BOL) { return 1; }
    if (kind == BOTE_RXN_CAT) { return _brx_anchored(vec_get(load64(nd + 24), 0)); }
    return 0;
}

# Compile the pattern `src`, the UTF-8 text of a JSON Schema `pattern`. Always a Regex: one
# bote_rx_why gives 0 for can be matched. The work is done on the heap forms' scratch (in
# src/schema.cyr, under its own lock, so a compile on any thread is safe) and given back; the
# Regex, its program and its classes' ranges are on the heap.
fn bote_rx_compile(src) {
    var rx = alloc(48);
    memset(rx, 0, 48);
    if (src == 0) { store64(rx + 16, "no pattern"); return rx; }
    var mk[16];
    var a = _sch_scratch_take(&mk);
    var why = _brx_compile_on(a, default_alloc(), src, rx, 0);
    _sch_scratch_give(&mk);
    if (why != 0) { store64(rx + 16, why); }
    return rx;
}

# Why the pattern `src` is no pattern bote's engine takes, or 0: a compile that keeps nothing,
# for a check that needs only that (registration's WARN). Whether two groups share a name
# goes to *names_out, when it is not 0.
fn bote_rx_why_of(src, names_out) {
    if (names_out != 0) { store64(names_out, 0); }
    if (src == 0) { return "no pattern"; }
    var mk[16];
    var a = _sch_scratch_take(&mk);
    var why = _brx_compile_on(a, a, src, 0, names_out);
    _sch_scratch_give(&mk);
    return why;
}

# (3.8.14) Why JavaScript's RegExp refuses the pattern `src` with the u flag, as the official
# client compiles a `pattern` (Ajv: `new RegExp(p, "u")`), or 0 when it takes it, whether or
# not bote's engine does. A compile that keeps nothing.
fn bote_rx_refused_of(src) {
    if (src == 0) { return 0; }
    var refused[8];
    store64(&refused, 0);
    var mk[16];
    var a = _sch_scratch_take(&mk);
    var why = _brx_compile_r(a, a, src, 0, 0, &refused);
    _sch_scratch_give(&mk);
    if (why != 0 && load64(&refused) == 1) { return why; }
    return 0;
}

# (3.8.15, from the 3.8.14 review) 1 when the pattern `src` names a capture group past ASCII,
# whether JavaScript takes the name (an identifier's character, as `é`) or refuses it (`€`, an
# emoji, a joiner first): which is which bote does not read, as it holds no Unicode identifier
# tables, and registration refuses both. Kept nothing.
fn bote_rx_wide_name_of(src) {
    if (src == 0) { return 0; }
    var wide[8];
    store64(&wide, 0);
    var mk[16];
    var a = _sch_scratch_take(&mk);
    _brx_compile_w(a, a, src, 0, 0, 0, &wide);
    _sch_scratch_give(&mk);
    return load64(&wide);
}

# (3.8.13) 1 when two groups of the pattern share a name, in two alternatives: ECMA-262 takes
# it since 2025, and JavaScript engines before that (Node before 23) refuse the pattern.
fn bote_rx_names_twice(rx) { return load64(rx + 32); }

# Compile `src` on `a`, its classes' ranges on `keep`, into `rx` (or nowhere, for 0): why it
# is no pattern bote's engine takes, or 0; whether a name is given twice to *names_out.
fn _brx_compile_on(a, keep, src, rx, names_out) { return _brx_compile_r(a, keep, src, rx, names_out, 0); }

# _brx_compile_on, with 1 written to *refused (when it is not 0) for a pattern JavaScript
# refuses with the u flag (3.8.14).
fn _brx_compile_r(a, keep, src, rx, names_out, refused) { return _brx_compile_w(a, keep, src, rx, names_out, refused, 0); }

# _brx_compile_r, with 1 written to *wide (when it is not 0) for a pattern naming a group past
# ASCII (3.8.15). The parser's state 120 B: +112 such a name met.
fn _brx_compile_w(a, keep, src, rx, names_out, refused, wide) {
    var ps = alloc_via(a, 120);
    memset(ps, 0, 120);
    var nn[8];
    store64(ps, _brx_cps(a, src, &nn));
    store64(ps + 8, load64(&nn));
    store64(ps + 40, vec_new_a(a));
    store64(ps + 48, map_new_a(a));
    store64(ps + 64, a);
    store64(ps + 72, keep);
    var root = _brx_disj(ps);
    if (load64(ps + 24) == 0 && load64(ps + 16) < load64(ps + 8)) { _brx_fail(ps, "an unmatched )"); }
    if (load64(ps + 24) == 0) { _brx_check_backrefs(ps); }
    if (wide != 0) { store64(wide, load64(ps + 112)); }
    if (load64(ps + 24) != 0) {
        if (load8(ps + 104) == 0) {
            if (rx != 0) { store64(rx + 40, 1); }
            if (refused != 0) { store64(refused, 1); }
        }
        return load64(ps + 24);
    }
    if (load64(ps + 80) != 0) { return load64(ps + 80); }
    if (names_out != 0) { store64(names_out, load64(ps + 56)); }
    var cg = alloc_via(a, 24);
    store64(cg, vec_new_a(a));
    store64(cg + 8, 0);
    store64(cg + 16, a);
    _brx_gen(cg, root);
    _brx_emit(cg, BOTE_RX_MATCH, 0, 0);
    if (load64(cg + 8) != 0) { return load64(cg + 8); }
    if (rx == 0) { return 0; }
    var v = load64(cg);
    var n = vec_len(v) / 3;
    var ins = alloc(n * 24);
    var i = 0;
    while (i < n * 3) { store64(ins + i * 8, vec_get(v, i)); i = i + 1; }
    store64(rx, ins);
    store64(rx + 8, n);
    store64(rx + 24, _brx_anchored(root));
    store64(rx + 32, load64(ps + 56));
    return 0;
}

# ---- Matching -------------------------------------------------------------------------

# The code point at buf[i] in the body of a JSON string ending at `e`, into *out, and where
# the next starts. Escapes are decoded, a surrogate pair written as two `\u` escapes is one
# code point and a lone surrogate is itself, as JavaScript's string holds it; bytes that
# are no UTF-8 are U+FFFD, one for each maximal part, as a client's decoder reads them
# (_sv_strlen counts the same way).
fn _brx_cp(buf, i, e, out) {
    var b = load8(buf + i);
    if (b == 92 && i + 1 < e) {
        var c = load8(buf + i + 1);
        if (c == 117) {
            var cu = _brx_hex4b(buf, i + 2, e);
            if (cu >= 55296 && cu <= 56319 && i + 11 < e && load8(buf + i + 6) == 92 && load8(buf + i + 7) == 117) {
                var lw = _brx_hex4b(buf, i + 8, e);
                if (lw >= 56320 && lw <= 57343) {
                    store64(out, 65536 + (cu - 55296) * 1024 + (lw - 56320));
                    return i + 12;
                }
            }
            store64(out, cu);
            return i + 6;
        }
        var d = c;
        if (c == 110) { d = 10; }
        elif (c == 116) { d = 9; }
        elif (c == 114) { d = 13; }
        elif (c == 98) { d = 8; }
        elif (c == 102) { d = 12; }
        store64(out, d);
        return i + 2;
    }
    if (b < 128) { store64(out, b); return i + 1; }
    var need = 0;
    var cp = 0;
    var lo = 128;
    var hi = 191;
    if (b >= 194 && b <= 223) { need = 1; cp = b & 31; }
    elif (b >= 224 && b <= 239) {
        need = 2;
        cp = b & 15;
        if (b == 224) { lo = 160; }
        if (b == 237) { hi = 159; }
    } elif (b >= 240 && b <= 244) {
        need = 3;
        cp = b & 7;
        if (b == 240) { lo = 144; }
        if (b == 244) { hi = 143; }
    } else {
        store64(out, 65533);
        return i + 1;
    }
    var j = i + 1;
    while (need > 0) {
        if (j >= e) { store64(out, 65533); return j; }
        var cb = load8(buf + j);
        if (cb < lo || cb > hi) { store64(out, 65533); return j; }
        cp = cp * 64 + (cb & 63);
        lo = 128;
        hi = 191;
        need = need - 1;
        j = j + 1;
    }
    store64(out, cp);
    return j;
}

fn _brx_hex4b(buf, i, e) {
    if (i + 4 > e) { return 0 - 1; }
    var v = 0;
    var k = 0;
    while (k < 4) {
        var h = _brx_hex(load8(buf + i + k));
        if (h < 0) { return 0 - 1; }
        v = v * 16 + h;
        k = k + 1;
    }
    return v;
}

fn _brx_word(c) {
    if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) { return 1; }
    return 0;
}

# 1 when the code point `c` is in the class's sorted ranges: the last range starting at or
# below it, found by halving, ends at or past it.
fn _brx_in(ranges, c) {
    var lo = 0;
    var hi = load64(ranges);
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        if (load64(ranges + 8 + mid * 16) <= c) { lo = mid + 1; }
        else { hi = mid; }
    }
    if (lo > 0 && c <= load64(ranges + lo * 16)) { return 1; }
    return 0;
}

# Add the thread at `pc` to `list` (holding `lc`), following every jump, split and assertion
# true between the code points `prev` and `cur` (-1 at either end), each step once a turn
# (`mark` holding the turn `gen` it was last seen): the list holds only steps that read a
# code point, or the match. The stack `st` has room for twice the program. Each step seen
# is counted at *cnt. The list's new count.
fn _brx_add(ins, list, lc, mark, gen, st, pc, prev, cur, cnt) {
    store64(st, pc);
    var sp = 1;
    var seen = 0;
    while (sp > 0) {
        sp = sp - 1;
        var p = load64(st + sp * 8);
        if (load64(mark + p * 8) != gen) {
            store64(mark + p * 8, gen);
            seen = seen + 1;
            var ip = ins + p * 24;
            var op = load64(ip);
            if (op == BOTE_RX_JMP) { store64(st + sp * 8, load64(ip + 8)); sp = sp + 1; }
            elif (op == BOTE_RX_SPLIT) {
                store64(st + sp * 8, load64(ip + 16));
                store64(st + sp * 8 + 8, load64(ip + 8));
                sp = sp + 2;
            } elif (op == BOTE_RX_BOL) {
                if (prev < 0) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } elif (op == BOTE_RX_EOL) {
                if (cur < 0) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } elif (op == BOTE_RX_WORDB) {
                if (_brx_word(prev) != _brx_word(cur)) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } elif (op == BOTE_RX_NWORDB) {
                if (_brx_word(prev) == _brx_word(cur)) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } else {
                store64(list + lc * 8, p);
                lc = lc + 1;
            }
        }
    }
    store64(cnt, load64(cnt) + seen);
    return lc;
}

# _brx_add for a program past BOTE_RX_SPARSE_FROM steps (3.8.13, from the 3.8.12 review): the
# steps seen a sparse set, which needs no clearing, `vs` (24 bytes): +0 where each step is in
# +8, +8 the steps in the order seen, +16 how many, a step in it when the place it names holds
# it. Through 3.8.12 every program's array was cleared at each match. Apart from _brx_add, as
# one function choosing at each step cost a short pattern a fifth more (`regex_slug`), and
# written out whole, as a call for each step would cost it too.
fn _brx_add_s(ins, list, lc, vs, st, pc, prev, cur, cnt) {
    store64(st, pc);
    var sp = 1;
    var seen = 0;
    var sps = load64(vs);
    var dns = load64(vs + 8);
    var dc = load64(vs + 16);
    while (sp > 0) {
        sp = sp - 1;
        var p = load64(st + sp * 8);
        var si = load64(sps + p * 8);
        if (si < 0 || si >= dc || load64(dns + si * 8) != p) {
            store64(sps + p * 8, dc);
            store64(dns + dc * 8, p);
            dc = dc + 1;
            seen = seen + 1;
            var ip = ins + p * 24;
            var op = load64(ip);
            if (op == BOTE_RX_JMP) { store64(st + sp * 8, load64(ip + 8)); sp = sp + 1; }
            elif (op == BOTE_RX_SPLIT) {
                store64(st + sp * 8, load64(ip + 16));
                store64(st + sp * 8 + 8, load64(ip + 8));
                sp = sp + 2;
            } elif (op == BOTE_RX_BOL) {
                if (prev < 0) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } elif (op == BOTE_RX_EOL) {
                if (cur < 0) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } elif (op == BOTE_RX_WORDB) {
                if (_brx_word(prev) != _brx_word(cur)) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } elif (op == BOTE_RX_NWORDB) {
                if (_brx_word(prev) == _brx_word(cur)) { store64(st + sp * 8, p + 1); sp = sp + 1; }
            } else {
                store64(list + lc * 8, p);
                lc = lc + 1;
            }
        }
    }
    store64(vs + 16, dc);
    store64(cnt, load64(cnt) + seen);
    return lc;
}

# 1 when `rx` matches somewhere in the JSON string body [s, e) of `buf`, 0 when it does not,
# and -1 when the budget block `bud` (or 0 for none) was spent first: each step a thread
# takes or a jump it follows costs one. What it needs, arrays as long as the program, it takes
# from `a` and gives back; from the heap forms' scratch, under its lock, when `a` is no bote
# arena, which cannot give them back.
fn bote_rx_test_a(a, rx, buf, s, e, bud) {
    # (3.8.13, from the 3.8.12 review) A budget spent is -1 before anything is made ready:
    # each of 64 patterns made its arrays ready for each key past the budget, 7.3 s for 209 KB.
    if (bud != 0 && load64(bud) < 0) { return 0 - 1; }
    var n = load64(rx + 8);
    if (n > BOTE_RX_SPARSE_FROM) { return _brx_test_s(a, rx, buf, s, e, bud); }
    var ins = load64(rx);
    var anch = load64(rx + 24);
    # (3.8.12, from the 3.8.11 review) On the heap a release does nothing: a dispatcher's plain
    # form kept 128 KB for each string `^.{0,2000}$` was asked of. (3.8.13) The scratch, not the
    # calling thread's request arena, which on a thread no one armed is the process's own.
    var sm[16];
    var held = 0;
    if (_bote_ar_is(a) == 0) {
        a = _sch_scratch_take(&sm);
        held = 1;
    }
    var mk[16];
    bote_arena_mark(a, &mk);
    var cl = alloc_via(a, n * 8 + 8);
    var nl = alloc_via(a, n * 8 + 8);
    var st = alloc_via(a, n * 16 + 16);
    # (3.8.13, from the 3.8.12 review) A short program's steps seen are an array cleared at each
    # match, at most BOTE_RX_SPARSE_FROM words; a long one's a sparse set, cleared by nothing
    # (_brx_test_s), whose extra reads would cost a short one a fifth more (`regex_slug`).
    # Through 3.8.12 every program cleared its array and was charged an eighth of a step a word,
    # so 300 strings `"ab"` against `^.{0,2000}$` (4,003 steps) were refused as too much to judge.
    var mark = alloc_via(a, n * 8 + 8);
    var z = 0;
    while (z < n) { store64(mark + z * 8, 0); z = z + 1; }
    var gen = 1;
    var cnt[8];
    store64(&cnt, 0);
    var cv[8];
    var c = 0 - 1;
    var npos = s;
    if (s < e) { npos = _brx_cp(buf, s, e, &cv); c = load64(&cv); }
    var prev = 0 - 1;
    var cc = _brx_add(ins, cl, 0, mark, gen, st, 0, prev, c, &cnt);
    var res = 0 - 2;
    # (3.8.12, from the 3.8.11 review) The first turn's steps, charged before anything is
    # decided by them: through 3.8.11 a string decided at once was charged nothing.
    if (bud != 0) {
        store64(bud, load64(bud) - load64(&cnt));
        store64(&cnt, 0);
        if (load64(bud) < 0) { res = 0 - 1; }
    }
    while (res == 0 - 2) {
        var i = 0;
        while (i < cc && res == 0 - 2) {
            if (load64(ins + load64(cl + i * 8) * 24) == BOTE_RX_MATCH) { res = 1; }
            i = i + 1;
        }
        if (res == 0 - 2 && (c < 0 || (anch == 1 && cc == 0))) { res = 0; }
        if (res == 0 - 2) {
            var nc = 0 - 1;
            var nnpos = npos;
            if (npos < e) { nnpos = _brx_cp(buf, npos, e, &cv); nc = load64(&cv); }
            gen = gen + 1;
            var ncount = 0;
            i = 0;
            while (i < cc) {
                var p = load64(cl + i * 8);
                var ip = ins + p * 24;
                var op = load64(ip);
                var ok = 0;
                if (op == BOTE_RX_CHAR) { if (load64(ip + 8) == c) { ok = 1; } }
                elif (op == BOTE_RX_ANY) { if (c != 10 && c != 13 && c != 8232 && c != 8233) { ok = 1; } }
                elif (op == BOTE_RX_CLASS) { if (_brx_in(load64(ip + 8), c) != load64(ip + 16)) { ok = 1; } }
                if (ok == 1) { ncount = _brx_add(ins, nl, ncount, mark, gen, st, p + 1, c, nc, &cnt); }
                i = i + 1;
            }
            if (anch == 0) { ncount = _brx_add(ins, nl, ncount, mark, gen, st, 0, c, nc, &cnt); }
            if (bud != 0) {
                store64(bud, load64(bud) - load64(&cnt) - cc);
                store64(&cnt, 0);
                if (load64(bud) < 0) { res = 0 - 1; }
            }
            var t = cl;
            cl = nl;
            nl = t;
            cc = ncount;
            prev = c;
            c = nc;
            npos = nnpos;
        }
    }
    bote_arena_release(a, &mk);
    if (held == 1) { _sch_scratch_give(&sm); }
    return res;
}

# bote_rx_test_a for a program past BOTE_RX_SPARSE_FROM steps (3.8.13, from the 3.8.12 review):
# the steps seen a sparse set, cleared by nothing. A matcher of its own, so a short program's
# loop holds no choice between the two.
fn _brx_test_s(a, rx, buf, s, e, bud) {
    var n = load64(rx + 8);
    var ins = load64(rx);
    var anch = load64(rx + 24);
    var sm[16];
    var held = 0;
    if (_bote_ar_is(a) == 0) {
        a = _sch_scratch_take(&sm);
        held = 1;
    }
    var mk[16];
    bote_arena_mark(a, &mk);
    var cl = alloc_via(a, n * 8 + 8);
    var nl = alloc_via(a, n * 8 + 8);
    var st = alloc_via(a, n * 16 + 16);
    var vs[24];
    store64(&vs, alloc_via(a, n * 8 + 8));
    store64(&vs + 8, alloc_via(a, n * 8 + 8));
    store64(&vs + 16, 0);
    var cnt[8];
    store64(&cnt, 0);
    var cv[8];
    var c = 0 - 1;
    var npos = s;
    if (s < e) { npos = _brx_cp(buf, s, e, &cv); c = load64(&cv); }
    var prev = 0 - 1;
    var cc = _brx_add_s(ins, cl, 0, &vs, st, 0, prev, c, &cnt);
    var res = 0 - 2;
    # (3.8.12, from the 3.8.11 review) The first turn's steps, charged before anything is
    # decided by them: through 3.8.11 a string decided at once was charged nothing.
    if (bud != 0) {
        store64(bud, load64(bud) - load64(&cnt));
        store64(&cnt, 0);
        if (load64(bud) < 0) { res = 0 - 1; }
    }
    while (res == 0 - 2) {
        var i = 0;
        while (i < cc && res == 0 - 2) {
            if (load64(ins + load64(cl + i * 8) * 24) == BOTE_RX_MATCH) { res = 1; }
            i = i + 1;
        }
        if (res == 0 - 2 && (c < 0 || (anch == 1 && cc == 0))) { res = 0; }
        if (res == 0 - 2) {
            var nc = 0 - 1;
            var nnpos = npos;
            if (npos < e) { nnpos = _brx_cp(buf, npos, e, &cv); nc = load64(&cv); }
            store64(&vs + 16, 0);
            var ncount = 0;
            i = 0;
            while (i < cc) {
                var p = load64(cl + i * 8);
                var ip = ins + p * 24;
                var op = load64(ip);
                var ok = 0;
                if (op == BOTE_RX_CHAR) { if (load64(ip + 8) == c) { ok = 1; } }
                elif (op == BOTE_RX_ANY) { if (c != 10 && c != 13 && c != 8232 && c != 8233) { ok = 1; } }
                elif (op == BOTE_RX_CLASS) { if (_brx_in(load64(ip + 8), c) != load64(ip + 16)) { ok = 1; } }
                if (ok == 1) { ncount = _brx_add_s(ins, nl, ncount, &vs, st, p + 1, c, nc, &cnt); }
                i = i + 1;
            }
            if (anch == 0) { ncount = _brx_add_s(ins, nl, ncount, &vs, st, 0, c, nc, &cnt); }
            if (bud != 0) {
                store64(bud, load64(bud) - load64(&cnt) - cc);
                store64(&cnt, 0);
                if (load64(bud) < 0) { res = 0 - 1; }
            }
            var t = cl;
            cl = nl;
            nl = t;
            cc = ncount;
            prev = c;
            c = nc;
            npos = nnpos;
        }
    }
    bote_arena_release(a, &mk);
    if (held == 1) { _sch_scratch_give(&sm); }
    return res;
}

# --- format.cyr ---

# bote::format — JSON Schema's `format`, as the official MCP client judges it (3.8.13).
#
# The client validates with Ajv and ajv-formats 3.0.1 in its full mode (`addFormats(ajv)`), so
# a format ajv-formats knows is enforced and one it does not is ignored. Each is judged here
# as ajv-formats defines it, and held to the client's own validator by scripts/format-diff.sh:
#
# - by the client's own regular expression, compiled once by src/regex.cyr: uri,
#   uri-reference, uri-template, email, hostname (its length as a check of its own, the
#   expression's lookahead), ipv4, ipv6, uuid, json-pointer, json-pointer-uri-fragment,
#   relative-json-pointer. Each was written for JavaScript's RegExp with the `i` flag and
#   without `u`; its letters are folded here (`a-z` written `a-zA-Z`), and with ASCII
#   classes, or `[^...]` ones naming no letter, code points and UTF-16 units give one verdict;
# - by hand, where the definition is code, a lookahead or a multiline expression: date, time,
#   date-time, iso-time, iso-date-time, duration, url, byte;
# - numbers: int32 and int64 exactly, where the client holds a double (`int32` takes
#   5.0000000000000001, whose double is 5; bote refuses it, the stricter side), and float and
#   double take every number;
# - password and binary take every string.
#
# Not judged: `regex`, which the client checks with JavaScript's own syntax without the `u`
# flag (Annex B), not the one src/regex.cyr reads; registration warns of it. Nor the format
# keywords ajv-formats adds, formatMinimum and its kin, which compare through JavaScript's Date.
#
# A string format judges strings and a number format numbers, whatever `type` says, as Ajv
# applies a format to the values of its own type.

enum BoteFormat {
    BOTE_FMT_DATE = 1;
    BOTE_FMT_TIME = 2;
    BOTE_FMT_DATE_TIME = 3;
    BOTE_FMT_ISO_TIME = 4;
    BOTE_FMT_ISO_DATE_TIME = 5;
    BOTE_FMT_DURATION = 6;
    BOTE_FMT_URI = 7;
    BOTE_FMT_URI_REFERENCE = 8;
    BOTE_FMT_URI_TEMPLATE = 9;
    BOTE_FMT_URL = 10;
    BOTE_FMT_EMAIL = 11;
    BOTE_FMT_HOSTNAME = 12;
    BOTE_FMT_IPV4 = 13;
    BOTE_FMT_IPV6 = 14;
    BOTE_FMT_REGEX = 15;
    BOTE_FMT_UUID = 16;
    BOTE_FMT_JSON_POINTER = 17;
    BOTE_FMT_JSON_POINTER_URI_FRAGMENT = 18;
    BOTE_FMT_RELATIVE_JSON_POINTER = 19;
    BOTE_FMT_BYTE = 20;
    BOTE_FMT_INT32 = 21;
    BOTE_FMT_INT64 = 22;
    BOTE_FMT_FLOAT = 23;
    BOTE_FMT_DOUBLE = 24;
    BOTE_FMT_PASSWORD = 25;
    BOTE_FMT_BINARY = 26;
}

var BOTE_FMT_COUNT = 26;

# The client's expressions, from ajv-formats 3.0.1 as the client bundles it, their letters
# folded for the `i` flag. Generated from that source; see the module's head.
var _BOTE_FMT_RX_URI = "^(?:[a-zA-Z][a-zA-Z0-9+\\-.]*:)(?:\\/?\\/(?:(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:]|%[0-9a-fA-F]{2})*@)?(?:\\[(?:(?:(?:(?:[0-9a-fA-F]{1,4}:){6}|::(?:[0-9a-fA-F]{1,4}:){5}|(?:[0-9a-fA-F]{1,4})?::(?:[0-9a-fA-F]{1,4}:){4}|(?:(?:[0-9a-fA-F]{1,4}:){0,1}[0-9a-fA-F]{1,4})?::(?:[0-9a-fA-F]{1,4}:){3}|(?:(?:[0-9a-fA-F]{1,4}:){0,2}[0-9a-fA-F]{1,4})?::(?:[0-9a-fA-F]{1,4}:){2}|(?:(?:[0-9a-fA-F]{1,4}:){0,3}[0-9a-fA-F]{1,4})?::[0-9a-fA-F]{1,4}:|(?:(?:[0-9a-fA-F]{1,4}:){0,4}[0-9a-fA-F]{1,4})?::)(?:[0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}|(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?))|(?:(?:[0-9a-fA-F]{1,4}:){0,5}[0-9a-fA-F]{1,4})?::[0-9a-fA-F]{1,4}|(?:(?:[0-9a-fA-F]{1,4}:){0,6}[0-9a-fA-F]{1,4})?::)|[Vv][0-9a-fA-F]+\\.[a-zA-Z0-9\\-._~!$&'()*+,;=:]+)\\]|(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)|(?:[a-zA-Z0-9\\-._~!$&'()*+,;=]|%[0-9a-fA-F]{2})*)(?::\\d*)?(?:\\/(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:@]|%[0-9a-fA-F]{2})*)*|\\/(?:(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:@]|%[0-9a-fA-F]{2})+(?:\\/(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:@]|%[0-9a-fA-F]{2})*)*)?|(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:@]|%[0-9a-fA-F]{2})+(?:\\/(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:@]|%[0-9a-fA-F]{2})*)*)(?:\\?(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:@/?]|%[0-9a-fA-F]{2})*)?(?:#(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:@/?]|%[0-9a-fA-F]{2})*)?$";
var _BOTE_FMT_RX_URI_REFERENCE = "^(?:[a-zA-Z][a-zA-Z0-9+\\-.]*:)?(?:\\/?\\/(?:(?:[a-zA-Z0-9\\-._~!$&'()*+,;=:]|%[0-9a-fA-F]{2})*@)?(?:\\[(?:(?:(?:(?:[0-9a-fA-F]{1,4}:){6}|::(?:[0-9a-fA-F]{1,4}:){5}|(?:[0-9a-fA-F]{1,4})?::(?:[0-9a-fA-F]{1,4}:){4}|(?:(?:[0-9a-fA-F]{1,4}:){0,1}[0-9a-fA-F]{1,4})?::(?:[0-9a-fA-F]{1,4}:){3}|(?:(?:[0-9a-fA-F]{1,4}:){0,2}[0-9a-fA-F]{1,4})?::(?:[0-9a-fA-F]{1,4}:){2}|(?:(?:[0-9a-fA-F]{1,4}:){0,3}[0-9a-fA-F]{1,4})?::[0-9a-fA-F]{1,4}:|(?:(?:[0-9a-fA-F]{1,4}:){0,4}[0-9a-fA-F]{1,4})?::)(?:[0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}|(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?))|(?:(?:[0-9a-fA-F]{1,4}:){0,5}[0-9a-fA-F]{1,4})?::[0-9a-fA-F]{1,4}|(?:(?:[0-9a-fA-F]{1,4}:){0,6}[0-9a-fA-F]{1,4})?::)|[Vv][0-9a-fA-F]+\\.[a-zA-Z0-9\\-._~!$&'()*+,;=:]+)\\]|(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)|(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=]|%[0-9a-fA-F]{2})*)(?::\\d*)?(?:\\/(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=:@]|%[0-9a-fA-F]{2})*)*|\\/(?:(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=:@]|%[0-9a-fA-F]{2})+(?:\\/(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=:@]|%[0-9a-fA-F]{2})*)*)?|(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=:@]|%[0-9a-fA-F]{2})+(?:\\/(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=:@]|%[0-9a-fA-F]{2})*)*)?(?:\\?(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=:@/?]|%[0-9a-fA-F]{2})*)?(?:#(?:[a-zA-Z0-9\\-._~!$&'\"()*+,;=:@/?]|%[0-9a-fA-F]{2})*)?$";
var _BOTE_FMT_RX_URI_TEMPLATE = "^(?:(?:[^\\x00-\\x20\"'<>%\\\\^`{|}]|%[0-9a-fA-F]{2})|\\{[+#./;?&=,!@|]?(?:[a-zA-Z0-9_]|%[0-9a-fA-F]{2})+(?::[1-9][0-9]{0,3}|\\*)?(?:,(?:[a-zA-Z0-9_]|%[0-9a-fA-F]{2})+(?::[1-9][0-9]{0,3}|\\*)?)*\\})*$";
var _BOTE_FMT_RX_EMAIL = "^[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$";
var _BOTE_FMT_RX_HOSTNAME = "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[-0-9a-zA-Z]{0,61}[0-9a-zA-Z])?)*\\.?$";
var _BOTE_FMT_RX_IPV4 = "^(?:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$";
var _BOTE_FMT_RX_IPV6 = "^((([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{1,4}|:))|(([0-9a-fA-F]{1,4}:){6}(:[0-9a-fA-F]{1,4}|((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3})|:))|(([0-9a-fA-F]{1,4}:){5}(((:[0-9a-fA-F]{1,4}){1,2})|:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3})|:))|(([0-9a-fA-F]{1,4}:){4}(((:[0-9a-fA-F]{1,4}){1,3})|((:[0-9a-fA-F]{1,4})?:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9a-fA-F]{1,4}:){3}(((:[0-9a-fA-F]{1,4}){1,4})|((:[0-9a-fA-F]{1,4}){0,2}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9a-fA-F]{1,4}:){2}(((:[0-9a-fA-F]{1,4}){1,5})|((:[0-9a-fA-F]{1,4}){0,3}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9a-fA-F]{1,4}:){1}(((:[0-9a-fA-F]{1,4}){1,6})|((:[0-9a-fA-F]{1,4}){0,4}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(:(((:[0-9a-fA-F]{1,4}){1,7})|((:[0-9a-fA-F]{1,4}){0,5}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:)))$";
var _BOTE_FMT_RX_UUID = "^(?:[uU][rR][nN]:[uU][uU][iI][dD]:)?[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$";
var _BOTE_FMT_RX_JSON_POINTER = "^(?:\\/(?:[^~/]|~0|~1)*)*$";
var _BOTE_FMT_RX_JSON_POINTER_URI_FRAGMENT = "^#(?:\\/(?:[a-zA-Z0-9_\\-.!$&'()*+,;:=@]|%[0-9a-fA-F]{2}|~0|~1)*)*$";
var _BOTE_FMT_RX_RELATIVE_JSON_POINTER = "^(?:0|[1-9][0-9]*)(?:#|(?:\\/(?:[^~/]|~0|~1)*)*)$";

# Each format's name, as the client knows it.
fn bote_format_name(id) {
    if (id == BOTE_FMT_DATE) { return "date"; }
    if (id == BOTE_FMT_TIME) { return "time"; }
    if (id == BOTE_FMT_DATE_TIME) { return "date-time"; }
    if (id == BOTE_FMT_ISO_TIME) { return "iso-time"; }
    if (id == BOTE_FMT_ISO_DATE_TIME) { return "iso-date-time"; }
    if (id == BOTE_FMT_DURATION) { return "duration"; }
    if (id == BOTE_FMT_URI) { return "uri"; }
    if (id == BOTE_FMT_URI_REFERENCE) { return "uri-reference"; }
    if (id == BOTE_FMT_URI_TEMPLATE) { return "uri-template"; }
    if (id == BOTE_FMT_URL) { return "url"; }
    if (id == BOTE_FMT_EMAIL) { return "email"; }
    if (id == BOTE_FMT_HOSTNAME) { return "hostname"; }
    if (id == BOTE_FMT_IPV4) { return "ipv4"; }
    if (id == BOTE_FMT_IPV6) { return "ipv6"; }
    if (id == BOTE_FMT_REGEX) { return "regex"; }
    if (id == BOTE_FMT_UUID) { return "uuid"; }
    if (id == BOTE_FMT_JSON_POINTER) { return "json-pointer"; }
    if (id == BOTE_FMT_JSON_POINTER_URI_FRAGMENT) { return "json-pointer-uri-fragment"; }
    if (id == BOTE_FMT_RELATIVE_JSON_POINTER) { return "relative-json-pointer"; }
    if (id == BOTE_FMT_BYTE) { return "byte"; }
    if (id == BOTE_FMT_INT32) { return "int32"; }
    if (id == BOTE_FMT_INT64) { return "int64"; }
    if (id == BOTE_FMT_FLOAT) { return "float"; }
    if (id == BOTE_FMT_DOUBLE) { return "double"; }
    if (id == BOTE_FMT_PASSWORD) { return "password"; }
    if (id == BOTE_FMT_BINARY) { return "binary"; }
    return 0;
}

# The format a name names, or 0 for one the client does not know.
fn bote_format_id(name) {
    if (name == 0) { return 0; }
    var id = 1;
    while (id <= BOTE_FMT_COUNT) {
        if (streq(bote_format_name(id), name) == 1) { return id; }
        id = id + 1;
    }
    return 0;
}

# What a format judges: 1 strings, 2 numbers, 0 nothing here (`regex`, and an unknown one).
fn bote_format_kind(id) {
    if (id <= 0 || id > BOTE_FMT_COUNT || id == BOTE_FMT_REGEX) { return 0; }
    if (id >= BOTE_FMT_INT32 && id <= BOTE_FMT_DOUBLE) { return 2; }
    return 1;
}

# 1 when the client's ajv-formats gives the format an order, which formatMinimum and its kin
# compare by: the dates and times. Beside a format it knows that has none, those keywords
# make the client refuse the schema.
fn bote_format_ordered(id) {
    if (id >= BOTE_FMT_DATE && id <= BOTE_FMT_ISO_DATE_TIME) { return 1; }
    return 0;
}

# A violation's text, for each format a value can fail.
fn _bfm_msg(id) {
    if (id == BOTE_FMT_DATE) { return "does not match the format date"; }
    if (id == BOTE_FMT_TIME) { return "does not match the format time"; }
    if (id == BOTE_FMT_DATE_TIME) { return "does not match the format date-time"; }
    if (id == BOTE_FMT_ISO_TIME) { return "does not match the format iso-time"; }
    if (id == BOTE_FMT_ISO_DATE_TIME) { return "does not match the format iso-date-time"; }
    if (id == BOTE_FMT_DURATION) { return "does not match the format duration"; }
    if (id == BOTE_FMT_URI) { return "does not match the format uri"; }
    if (id == BOTE_FMT_URI_REFERENCE) { return "does not match the format uri-reference"; }
    if (id == BOTE_FMT_URI_TEMPLATE) { return "does not match the format uri-template"; }
    if (id == BOTE_FMT_URL) { return "does not match the format url"; }
    if (id == BOTE_FMT_EMAIL) { return "does not match the format email"; }
    if (id == BOTE_FMT_HOSTNAME) { return "does not match the format hostname"; }
    if (id == BOTE_FMT_IPV4) { return "does not match the format ipv4"; }
    if (id == BOTE_FMT_IPV6) { return "does not match the format ipv6"; }
    if (id == BOTE_FMT_UUID) { return "does not match the format uuid"; }
    if (id == BOTE_FMT_JSON_POINTER) { return "does not match the format json-pointer"; }
    if (id == BOTE_FMT_JSON_POINTER_URI_FRAGMENT) { return "does not match the format json-pointer-uri-fragment"; }
    if (id == BOTE_FMT_RELATIVE_JSON_POINTER) { return "does not match the format relative-json-pointer"; }
    if (id == BOTE_FMT_BYTE) { return "does not match the format byte"; }
    if (id == BOTE_FMT_INT32) { return "does not match the format int32"; }
    if (id == BOTE_FMT_INT64) { return "does not match the format int64"; }
    return "does not match the format";
}

fn _bfm_rx_src(id) {
    if (id == BOTE_FMT_URI) { return _BOTE_FMT_RX_URI; }
    if (id == BOTE_FMT_URI_REFERENCE) { return _BOTE_FMT_RX_URI_REFERENCE; }
    if (id == BOTE_FMT_URI_TEMPLATE) { return _BOTE_FMT_RX_URI_TEMPLATE; }
    if (id == BOTE_FMT_EMAIL) { return _BOTE_FMT_RX_EMAIL; }
    if (id == BOTE_FMT_HOSTNAME) { return _BOTE_FMT_RX_HOSTNAME; }
    if (id == BOTE_FMT_IPV4) { return _BOTE_FMT_RX_IPV4; }
    if (id == BOTE_FMT_IPV6) { return _BOTE_FMT_RX_IPV6; }
    if (id == BOTE_FMT_UUID) { return _BOTE_FMT_RX_UUID; }
    if (id == BOTE_FMT_JSON_POINTER) { return _BOTE_FMT_RX_JSON_POINTER; }
    if (id == BOTE_FMT_JSON_POINTER_URI_FRAGMENT) { return _BOTE_FMT_RX_JSON_POINTER_URI_FRAGMENT; }
    if (id == BOTE_FMT_RELATIVE_JSON_POINTER) { return _BOTE_FMT_RX_RELATIVE_JSON_POINTER; }
    return 0;
}

# Each expression compiled, a word for each format, published by compare-and-swap: a schema
# compiled on two threads at once compiles one twice and keeps the first.
var _bfm_rx_tab[216];

fn _bfm_rx(id) {
    var slot = &_bfm_rx_tab + id * 8;
    var rx = load64(slot);
    if (rx != 0) { return rx; }
    var src = _bfm_rx_src(id);
    if (src == 0) { return 0; }
    rx = bote_rx_compile(src);
    if (atomic_cas(slot, 0, rx) == 0) { rx = load64(slot); }
    return rx;
}

# Ready the format `id` for judging: its expression compiled, at registration, so no
# request compiles it.
fn bote_format_ready(id) {
    _bfm_rx(id);
    return id;
}

# ---- By hand ------------------------------------------------------------------------

fn _bfm_digit(c) {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

# Two digits at cps[i] as their number, or -1.
fn _bfm_num2(cps, i) {
    var a = load64(cps + i * 8);
    var b = load64(cps + i * 8 + 8);
    if (_bfm_digit(a) == 0 || _bfm_digit(b) == 0) { return 0 - 1; }
    return (a - 48) * 10 + (b - 48);
}

fn _bfm_at(cps, i) { return load64(cps + i * 8); }

# 1 for a code point JavaScript's `\s` takes: white space and the line terminators.
fn _bfm_space(c) {
    if ((c >= 9 && c <= 13) || c == 32 || c == 160 || c == 5760 || (c >= 8192 && c <= 8202)) { return 1; }
    if (c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288 || c == 65279) { return 1; }
    return 0;
}

# date: `^(\d\d\d\d)-(\d\d)-(\d\d)$`, a month from 1 to 12 and a day it has, February's 29th
# in a leap year (ajv-formats' date).
fn _bfm_date(cps, s, e) {
    if (e - s != 10) { return 0; }
    var k = 0;
    while (k < 10) {
        var c = _bfm_at(cps, s + k);
        if (k == 4 || k == 7) { if (c != 45) { return 0; } }
        elif (_bfm_digit(c) == 0) { return 0; }
        k = k + 1;
    }
    var y = _bfm_num2(cps, s) * 100 + _bfm_num2(cps, s + 2);
    var m = _bfm_num2(cps, s + 5);
    var d = _bfm_num2(cps, s + 8);
    if (m < 1 || m > 12 || d < 1) { return 0; }
    var dim = 31;
    if (m == 4 || m == 6 || m == 9 || m == 11) { dim = 30; }
    if (m == 2) {
        dim = 28;
        if (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) { dim = 29; }
    }
    if (d > dim) { return 0; }
    return 1;
}

# 1 when the fraction digits cps[fs..fs+fl) round a second of 32 to 63 up to the next whole
# one as a double: from 1 - 2^-48, a tie rounding to the even, which is the next. The client
# reads a second as a double (`+"59.9999999999999999"` is 60).
var _BOTE_FMT_ROUNDS_UP = "999999999999996447286321199499070644378662109375";

fn _bfm_rounds_up(cps, fs, fl) {
    var k = 0;
    while (k < fl || k < 48) {
        var d = 48;
        if (k < fl) { d = _bfm_at(cps, fs + k); }
        var t = 48;
        if (k < 48) { t = load8(_BOTE_FMT_ROUNDS_UP + k); }
        if (d > t) { return 1; }
        if (d < t) { return 0; }
        k = k + 1;
    }
    return 1;
}

# time, and iso-time with `strict` 0 (ajv-formats' getTime): `^(\d\d):(\d\d):(\d\d(?:\.\d+)?)
# (z|([+-])(\d\d)(?::?(\d\d))?)?$` in any case, an offset to 23:59, and a time to 23:59:59,
# or a leap second, 23:59:60 in UTC, read as the client reads it.
fn _bfm_time(cps, s, e, strict) {
    if (e - s < 8) { return 0; }
    var hr = _bfm_num2(cps, s);
    var mn = _bfm_num2(cps, s + 3);
    var ss = _bfm_num2(cps, s + 6);
    if (hr < 0 || mn < 0 || ss < 0 || _bfm_at(cps, s + 2) != 58 || _bfm_at(cps, s + 5) != 58) { return 0; }
    var i = s + 8;
    var fs = 0;
    var fl = 0;
    if (i < e && _bfm_at(cps, i) == 46) {
        var j = i + 1;
        while (j < e && _bfm_digit(_bfm_at(cps, j)) == 1) { j = j + 1; }
        if (j == i + 1) { return 0; }
        fs = i + 1;
        fl = j - i - 1;
        i = j;
    }
    var tz = 0;
    var sign = 1;
    var tzh = 0;
    var tzm = 0;
    if (i < e) {
        var c = _bfm_at(cps, i);
        if (c == 122 || c == 90) { tz = 1; i = i + 1; }
        elif (c == 43 || c == 45) {
            if (c == 45) { sign = 0 - 1; }
            if (i + 3 > e) { return 0; }
            tzh = _bfm_num2(cps, i + 1);
            if (tzh < 0) { return 0; }
            tz = 1;
            i = i + 3;
            if (i < e) {
                if (_bfm_at(cps, i) == 58) { i = i + 1; }
                if (i + 2 > e) { return 0; }
                tzm = _bfm_num2(cps, i);
                if (tzm < 0) { return 0; }
                i = i + 2;
            }
        } else { return 0; }
    }
    if (i != e) { return 0; }
    if (tzh > 23 || tzm > 59 || (strict == 1 && tz == 0)) { return 0; }
    var lt60 = 0;
    if (ss < 59 || (ss == 59 && _bfm_rounds_up(cps, fs, fl) == 0)) { lt60 = 1; }
    if (hr <= 23 && mn <= 59 && lt60 == 1) { return 1; }
    var umin = mn - tzm * sign;
    var uhr = hr - tzh * sign;
    if (umin < 0) { uhr = uhr - 1; }
    var lt61 = 0;
    if (ss < 60 || (ss == 60 && _bfm_rounds_up(cps, fs, fl) == 0)) { lt61 = 1; }
    if ((uhr == 23 || uhr == 0 - 1) && (umin == 59 || umin == 0 - 1) && lt61 == 1) { return 1; }
    return 0;
}

# date-time, and iso-date-time with `strict` 0: split at `t`, `T` or a space JavaScript's
# `\s` takes, into a date and a time, exactly two parts.
fn _bfm_date_time(cps, n, strict) {
    var sep = 0 - 1;
    var i = 0;
    while (i < n) {
        var c = _bfm_at(cps, i);
        if (c == 116 || c == 84 || _bfm_space(c) == 1) {
            if (sep >= 0) { return 0; }
            sep = i;
        }
        i = i + 1;
    }
    if (sep < 0) { return 0; }
    if (_bfm_date(cps, 0, sep) == 0) { return 0; }
    return _bfm_time(cps, sep + 1, n, strict);
}

# A run of digits from cps[i], to where it ends.
fn _bfm_digits(cps, i, n) {
    while (i < n && _bfm_digit(_bfm_at(cps, i)) == 1) { i = i + 1; }
    return i;
}

# duration: `^P(?!$)((\d+Y)?(\d+M)?(\d+D)?(T(?=\d)(\d+H)?(\d+M)?(\d+S)?)?|(\d+W)?)$`, its
# letters capitals only: years, months and days in that order, each perhaps, then perhaps a
# `T` and hours, minutes and seconds, at least one; or a number of weeks alone.
fn _bfm_duration(cps, n) {
    if (n < 2 || _bfm_at(cps, 0) != 80) { return 0; }
    var w = _bfm_digits(cps, 1, n);
    if (w > 1 && w == n - 1 && _bfm_at(cps, w) == 87) { return 1; }
    var i = 1;
    var stage = 0;
    while (i < n && _bfm_at(cps, i) != 84) {
        var j = _bfm_digits(cps, i, n);
        if (j == i || j >= n) { return 0; }
        var l = _bfm_at(cps, j);
        if (l == 89 && stage < 1) { stage = 1; }
        elif (l == 77 && stage < 2) { stage = 2; }
        elif (l == 68 && stage < 3) { stage = 3; }
        else { return 0; }
        i = j + 1;
    }
    if (i < n) {
        i = i + 1;
        if (i >= n || _bfm_digit(_bfm_at(cps, i)) == 0) { return 0; }
        var ts = 0;
        while (i < n) {
            var tj = _bfm_digits(cps, i, n);
            if (tj == i || tj >= n) { return 0; }
            var tl = _bfm_at(cps, tj);
            if (tl == 72 && ts < 1) { ts = 1; }
            elif (tl == 77 && ts < 2) { ts = 2; }
            elif (tl == 83 && ts < 3) { ts = 3; }
            else { return 0; }
            i = tj + 1;
        }
    }
    return 1;
}

# One line of byte's expression: `(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?`.
fn _bfm_b64(c) {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 43 || c == 47) { return 1; }
    return 0;
}

fn _bfm_b64_line(cps, s, e) {
    var len = e - s;
    var pad = 0;
    if (len >= 1 && _bfm_at(cps, e - 1) == 61) {
        pad = 1;
        if (len >= 2 && _bfm_at(cps, e - 2) == 61) { pad = 2; }
    }
    var body = len - pad;
    var k = s;
    while (k < s + body) {
        if (_bfm_b64(_bfm_at(cps, k)) == 0) { return 0; }
        k = k + 1;
    }
    if (pad == 0 && body % 4 == 0) { return 1; }
    if (pad == 1 && body % 4 == 3) { return 1; }
    if (pad == 2 && body % 4 == 2) { return 1; }
    return 0;
}

# byte: that expression with the `m` flag, which ajv-formats gives it, so it matches when any
# line does, an empty one too: "" and "!!!\n" pass, "!!!" does not.
fn _bfm_byte(cps, n) {
    var ls = 0;
    var i = 0;
    while (i <= n) {
        var c = 0 - 1;
        if (i < n) { c = _bfm_at(cps, i); }
        if (i == n || c == 10 || c == 13 || c == 8232 || c == 8233) {
            if (_bfm_b64_line(cps, ls, i) == 1) { return 1; }
            ls = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# url's letters under its `iu` flags: an ASCII letter in either case, and the two code points
# that fold to one (U+017F to s, U+212A to k).
fn _bfm_lower(c) {
    if (c >= 65 && c <= 90) { return c + 32; }
    if (c == 383) { return 115; }
    if (c == 8490) { return 107; }
    return c;
}

# A code point of url's `[a-z0-9\u{00a1}-\u{ffff}]` (`digits` 1) or `[a-z\u{00a1}-\u{ffff}]`.
fn _bfm_url_ch(c, digits) {
    var l = _bfm_lower(c);
    if (l >= 97 && l <= 122) { return 1; }
    if (digits == 1 && c >= 48 && c <= 57) { return 1; }
    if (c >= 161 && c <= 65535) { return 1; }
    return 0;
}

# An octet's digits cps[s..e) by url's three alternations: `which` 1 the first,
# `[1-9]\d?|1\d\d|2[01]\d|22[0-3]`; 2 the middle, `1?\d{1,2}|2[0-4]\d|25[0-5]`; 3 the last,
# `[1-9]\d?|1\d\d|2[0-4]\d|25[0-4]`.
fn _bfm_url_octet(cps, s, e, which) {
    var len = e - s;
    if (len < 1 || len > 3) { return 0; }
    var k = s;
    while (k < e) { if (_bfm_digit(_bfm_at(cps, k)) == 0) { return 0; } k = k + 1; }
    var a = _bfm_at(cps, s) - 48;
    if (which == 2) {
        if (len <= 2) { return 1; }
        var v2 = a * 100 + (_bfm_at(cps, s + 1) - 48) * 10 + (_bfm_at(cps, s + 2) - 48);
        if (a == 1 || (v2 >= 200 && v2 <= 255)) { return 1; }
        return 0;
    }
    if (a == 0) { return 0; }
    if (len <= 2) { return 1; }
    var v = a * 100 + (_bfm_at(cps, s + 1) - 48) * 10 + (_bfm_at(cps, s + 2) - 48);
    if (which == 1) { if (v <= 223) { return 1; } return 0; }
    if (v <= 254) { return 1; }
    return 0;
}

# 1 when the n code points at cps[s] are the digits `lit`.
fn _bfm_is(cps, s, e, lit) {
    var n = strlen(lit);
    if (e - s != n) { return 0; }
    var k = 0;
    while (k < n) { if (_bfm_at(cps, s + k) != load8(lit + k)) { return 0; } k = k + 1; }
    return 1;
}

# url's host cps[s..e): a dotted quad its four octet rules take and its lookaheads do not
# refuse (10.*, 127.*, 169.254.*, 192.168.*, 172.16 to 172.31.*), or a domain: labels of
# url's letters, digits and code points from U+00A1 to U+FFFF, single hyphens between their
# runs, and a last label of at least two letters or such code points.
fn _bfm_url_host(cps, s, e) {
    # Dots and digits alone: the dotted quad, or nothing (a domain's last label has no digit).
    var dots = 0;
    var quad = 1;
    var k = s;
    while (k < e) {
        var c = _bfm_at(cps, k);
        if (c == 46) { dots = dots + 1; }
        elif (_bfm_digit(c) == 0) { quad = 0; }
        k = k + 1;
    }
    if (quad == 1) {
        if (dots != 3) { return 0; }
        var p[32];
        var pe[32];
        var o = 0;
        var at = s;
        k = s;
        while (k <= e) {
            if (k == e || _bfm_at(cps, k) == 46) {
                store64(&p + o * 8, at);
                store64(&pe + o * 8, k);
                o = o + 1;
                at = k + 1;
            }
            k = k + 1;
        }
        if (_bfm_url_octet(cps, load64(&p), load64(&pe), 1) == 0) { return 0; }
        if (_bfm_url_octet(cps, load64(&p + 8), load64(&pe + 8), 2) == 0) { return 0; }
        if (_bfm_url_octet(cps, load64(&p + 16), load64(&pe + 16), 2) == 0) { return 0; }
        if (_bfm_url_octet(cps, load64(&p + 24), load64(&pe + 24), 3) == 0) { return 0; }
        var a1 = load64(&p);
        var b1 = load64(&pe);
        if (_bfm_is(cps, a1, b1, "10") == 1 || _bfm_is(cps, a1, b1, "127") == 1) { return 0; }
        var a2 = load64(&p + 8);
        var b2 = load64(&pe + 8);
        if (_bfm_is(cps, a1, b1, "169") == 1 && _bfm_is(cps, a2, b2, "254") == 1) { return 0; }
        if (_bfm_is(cps, a1, b1, "192") == 1 && _bfm_is(cps, a2, b2, "168") == 1) { return 0; }
        if (_bfm_is(cps, a1, b1, "172") == 1 && b2 - a2 == 2) {
            var o2 = (_bfm_at(cps, a2) - 48) * 10 + (_bfm_at(cps, a2 + 1) - 48);
            if (o2 >= 16 && o2 <= 31) { return 0; }
        }
        return 1;
    }
    # A domain.
    if (dots < 1) { return 0; }
    var ls = s;
    var labels = 0;
    k = s;
    while (k <= e) {
        if (k == e || _bfm_at(cps, k) == 46) {
            if (k == ls) { return 0; }
            labels = labels + 1;
            if (k == e) {
                # The last: two at least, no digit, no hyphen.
                if (k - ls < 2) { return 0; }
                var t = ls;
                while (t < k) { if (_bfm_url_ch(_bfm_at(cps, t), 0) == 0) { return 0; } t = t + 1; }
            } else {
                if (_bfm_at(cps, ls) == 45 || _bfm_at(cps, k - 1) == 45) { return 0; }
                var u = ls;
                while (u < k) {
                    var lc = _bfm_at(cps, u);
                    if (lc == 45) { if (_bfm_at(cps, u + 1) == 45) { return 0; } }
                    elif (_bfm_url_ch(lc, 1) == 0) { return 0; }
                    u = u + 1;
                }
            }
            ls = k + 1;
        }
        k = k + 1;
    }
    if (labels < 2) { return 0; }
    return 1;
}

# url (ajv-formats' expression under `iu`): `http`, `https` or `ftp` and `://`, perhaps a
# userinfo of anything but white space ending at an `@`, a host, perhaps a port of two to five
# digits, and perhaps a path of anything but white space from a `/`. The userinfo may hold an
# `@`, so each one is tried as its end, the host after it running to a `:` or a `/`. Each
# start costs at most the code points to the next `@`, so the whole is linear.
fn _bfm_url(cps, n) {
    var k = 0;
    if (n >= 7 && _bfm_lower(_bfm_at(cps, 0)) == 102 && _bfm_lower(_bfm_at(cps, 1)) == 116 && _bfm_lower(_bfm_at(cps, 2)) == 112) { k = 3; }
    elif (n >= 7 && _bfm_lower(_bfm_at(cps, 0)) == 104 && _bfm_lower(_bfm_at(cps, 1)) == 116 && _bfm_lower(_bfm_at(cps, 2)) == 116 && _bfm_lower(_bfm_at(cps, 3)) == 112) {
        k = 4;
        if (_bfm_lower(_bfm_at(cps, 4)) == 115) { k = 5; }
    } else { return 0; }
    if (k + 3 > n || _bfm_at(cps, k) != 58 || _bfm_at(cps, k + 1) != 47 || _bfm_at(cps, k + 2) != 47) { return 0; }
    k = k + 3;
    # Each start the host may have: with no userinfo, and after each `@` that ends one, a
    # userinfo of one character at least and no white space. The host's own classes take
    # code points from U+00A1, U+3000 and U+FEFF among them, so white space is refused only in
    # the userinfo and the path.
    # (3.8.14, from the 3.8.13 review) The last white space in the string, found once: a path
    # holds none, and each try looked through the rest of the string for one before it looked
    # for the `/` that starts a path, so 16,000 `x@a.bc/` took 14.7 s for 112 KB.
    var lsp = 0 - 1;
    var li = n - 1;
    while (li >= k && lsp < 0) { if (_bfm_space(_bfm_at(cps, li)) == 1) { lsp = li; } li = li - 1; }
    var h = k;
    var q = k;
    var go = 1;
    while (go == 1) {
        var he = h;
        var at = 0;
        while (he < n && _bfm_at(cps, he) != 58 && _bfm_at(cps, he) != 47) {
            if (_bfm_at(cps, he) == 64) { at = 1; }
            he = he + 1;
            if (at == 1) { he = n; }
        }
        if (at == 0 && he > h && _bfm_url_host(cps, h, he) == 1) {
            var r = he;
            var ok = 1;
            if (r < n && _bfm_at(cps, r) == 58) {
                var pd = _bfm_digits(cps, r + 1, n);
                if (pd - r - 1 < 2 || pd - r - 1 > 5) { ok = 0; }
                r = pd;
            }
            if (ok == 1 && r < n) {
                # A path: `/`, then anything but white space.
                if (_bfm_at(cps, r) != 47 || lsp > r) { ok = 0; }
            }
            if (ok == 1) { return 1; }
        }
        # The next `@` past the userinfo's first character, with no white space before it.
        if (q == k) {
            if (k >= n || _bfm_space(_bfm_at(cps, k)) == 1) { go = 0; }
            q = k + 1;
        }
        while (go == 1 && q < n && _bfm_at(cps, q) != 64) {
            if (_bfm_space(_bfm_at(cps, q)) == 1) { go = 0; }
            q = q + 1;
        }
        if (go == 1) {
            if (q >= n) { go = 0; }
            else {
                h = q + 1;
                q = q + 1;
            }
        }
    }
    return 0;
}

# The code points of the JSON string body [s, e) of `buf` (src/regex.cyr's reading), on `a`,
# their number at *out_n.
fn _bfm_cps_a(a, buf, s, e, out_n) {
    var cps = alloc_via(a, (e - s) * 8 + 8);
    var cv[8];
    var n = 0;
    var i = s;
    while (i < e) {
        i = _brx_cp(buf, i, e, &cv);
        store64(cps + n * 8, load64(&cv));
        n = n + 1;
    }
    store64(out_n, n);
    return cps;
}

# 1 when the JSON string body [s, e) of `buf` matches the string format `id`, 0 when it
# does not, -1 when the budget block `bud` (0 for none) was spent first. What it reads it
# charges: an expression's steps, or (by hand) a step for each byte, and the code points it
# decodes are on `a`, given back; on the heap forms' scratch, under its lock, when `a` is no
# bote arena, as src/regex.cyr's are.
fn bote_format_test_a(a, id, buf, s, e, bud) {
    if (id == BOTE_FMT_PASSWORD || id == BOTE_FMT_BINARY) { return 1; }
    if (bote_format_kind(id) != 1) { return 1; }
    var rx = _bfm_rx(id);
    if (_bote_ar_is(a) == 0) {
        var sm[16];
        var sa = _sch_scratch_take(&sm);
        var r0 = _bfm_test_on(sa, id, rx, buf, s, e, bud);
        _sch_scratch_give(&sm);
        return r0;
    }
    return _bfm_test_on(a, id, rx, buf, s, e, bud);
}

# (3.8.14, from the 3.8.13 review) A format's expression is bote's own and its size fixed, so
# each of its steps is charged a quarter (BOTE_FMT_STEP_SHARE): a uri's authority runs about
# 41 steps a byte, past the 32 a byte the budget allows a value, and a valid uri with a host
# of 20,000 characters was refused for work. A `pattern`'s steps, the schema's own, are each
# charged one.
var BOTE_FMT_STEP_SHARE = 4;

fn _bfm_rx_test(a, rx, buf, s, e, bud) {
    if (bud == 0) { return bote_rx_test_a(a, rx, buf, s, e, 0); }
    var have = load64(bud);
    if (have < 0) { return 0 - 1; }
    var lb[8];
    store64(&lb, have * BOTE_FMT_STEP_SHARE);
    var r = bote_rx_test_a(a, rx, buf, s, e, &lb);
    var spent = have * BOTE_FMT_STEP_SHARE - load64(&lb);
    # Spent here, the local budget went below 0, so more than all of `have` is charged back.
    store64(bud, have - (spent + BOTE_FMT_STEP_SHARE - 1) / BOTE_FMT_STEP_SHARE);
    return r;
}

fn _bfm_test_on(a, id, rx, buf, s, e, bud) {
    if (rx != 0 && id != BOTE_FMT_HOSTNAME) { return _bfm_rx_test(a, rx, buf, s, e, bud); }
    if (bud != 0) {
        store64(bud, load64(bud) - (e - s));
        if (load64(bud) < 0) { return 0 - 1; }
    }
    var mk[16];
    bote_arena_mark(a, &mk);
    var nn[8];
    var cps = _bfm_cps_a(a, buf, s, e, &nn);
    var n = load64(&nn);
    var r = 0;
    if (id == BOTE_FMT_DATE) { r = _bfm_date(cps, 0, n); }
    elif (id == BOTE_FMT_TIME) { r = _bfm_time(cps, 0, n, 1); }
    elif (id == BOTE_FMT_ISO_TIME) { r = _bfm_time(cps, 0, n, 0); }
    elif (id == BOTE_FMT_DATE_TIME) { r = _bfm_date_time(cps, n, 1); }
    elif (id == BOTE_FMT_ISO_DATE_TIME) { r = _bfm_date_time(cps, n, 0); }
    elif (id == BOTE_FMT_DURATION) { r = _bfm_duration(cps, n); }
    elif (id == BOTE_FMT_URL) { r = _bfm_url(cps, n); }
    elif (id == BOTE_FMT_BYTE) { r = _bfm_byte(cps, n); }
    elif (id == BOTE_FMT_HOSTNAME) {
        # The expression's lookahead, `(?=.{1,253}\.?$)`: 1 to 253 characters, or 254 ending
        # in a dot (any other character is no hostname's).
        if (n >= 1 && (n <= 253 || (n == 254 && _bfm_at(cps, 253) == 46))) { r = 1; }
    }
    bote_arena_release(a, &mk);
    if (id == BOTE_FMT_HOSTNAME && r == 1) { return _bfm_rx_test(a, rx, buf, s, e, bud); }
    return r;
}

# 1 when the JSON number at `v` meets the number format `id`: int32 an integer from -2^31 to
# 2^31 - 1, int64 an integer a double holds as one (to 1.7976931348623157e308 either way),
# float and double any number. Exact, where the client reads a double: a value whose double
# is an integer and itself is not (5.0000000000000001, 1e-400) the client takes and bote does
# not. An integer past a double's largest (1.8e308, which the client reads as infinite) int64
# refuses.
fn bote_format_number(id, v) {
    if (id != BOTE_FMT_INT32 && id != BOTE_FMT_INT64) { return 1; }
    var o[64];
    if (_sch_num_norm(v, &o) == 0) { return 0; }
    if (load64(&o) != 0 && load64(&o + 8) < load64(&o + 56) - load64(&o + 48)) { return 0; }
    if (id == BOTE_FMT_INT32) {
        if (_sch_num_cmp(v, "2147483647") > 0 || _sch_num_cmp(v, "-2147483648") < 0) { return 0; }
        return 1;
    }
    if (_sch_num_cmp(v, "1.7976931348623157e308") > 0 || _sch_num_cmp(v, "-1.7976931348623157e308") < 0) { return 0; }
    return 1;
}

# --- registry.cyr ---

# bote::registry — Tool registration, discovery, and parameter validation
# Mirrors rust-old/src/registry.rs
#
# Registration checks a tool definition and compiles its input schema
# (3.4.8), so every registered tool is validated by src/schema.cyr's
# compiled_validate: types, enums, bounds, nested objects and required
# fields. registry_validate_params keeps a required-fields-only fallback for
# a definition that somehow carries no compiled schema.

include "lib/hashmap.cyr"

# ================================================================
# ToolAnnotations — tri-state hint flags (MCP 2025-11-25)
# ================================================================
#
# Each hint is i64: 0 = unset, 1 = true, 2 = false.
# Serialization: skip when unset; emit "true" or "false" otherwise.
#
# Layout (32 bytes):
#   +0  read_only_hint
#   +8  destructive_hint
#   +16 idempotent_hint
#   +24 open_world_hint

enum AnnHint {
    HINT_UNSET = 0;
    HINT_TRUE = 1;
    HINT_FALSE = 2;
}

fn ann_new() {
    var a = alloc(32);
    store64(a, HINT_UNSET);
    store64(a + 8, HINT_UNSET);
    store64(a + 16, HINT_UNSET);
    store64(a + 24, HINT_UNSET);
    return a;
}

fn ann_read_only_hint(a) { return load64(a); }
fn ann_destructive_hint(a) { return load64(a + 8); }
fn ann_idempotent_hint(a) { return load64(a + 16); }
fn ann_open_world_hint(a) { return load64(a + 24); }

fn ann_set_read_only(a, v) { store64(a, v); return a; }
fn ann_set_destructive(a, v) { store64(a + 8, v); return a; }
fn ann_set_idempotent(a, v) { store64(a + 16, v); return a; }
fn ann_set_open_world(a, v) { store64(a + 24, v); return a; }

# Preset: read-only tool (no side effects).
fn ann_read_only() {
    var a = ann_new();
    store64(a, HINT_TRUE);
    store64(a + 8, HINT_FALSE);
    store64(a + 16, HINT_TRUE);
    store64(a + 24, HINT_FALSE);
    return a;
}

# Preset: destructive tool.
fn ann_destructive() {
    var a = ann_new();
    store64(a, HINT_FALSE);
    store64(a + 8, HINT_TRUE);
    store64(a + 16, HINT_FALSE);
    store64(a + 24, HINT_TRUE);
    return a;
}

# ================================================================
# ToolSchema — JSON Schema subset
# ================================================================
#
# Layout (32 bytes):
#   +0  schema_type cstr ("object", "string", ...)
#   +8  properties  vec of {key_cstr, value_cstr_raw_json} pairs (16 bytes each) or 0
#   +16 required    vec of cstr or 0
#   +24 json        cstr or 0: the whole schema as written, from tool_schema_from_json (3.8.3)

fn schema_new(schema_type, properties_vec, required_vec) {
    var s = alloc(32);
    store64(s, schema_type);
    store64(s + 8, properties_vec);
    store64(s + 16, required_vec);
    store64(s + 24, 0);
    return s;
}

fn schema_type(s) { return load64(s); }
fn schema_properties(s) { return load64(s + 8); }
fn schema_required(s) { return load64(s + 16); }
fn tool_schema_json(s) { return load64(s + 24); }

# An inputSchema as its own JSON (3.8.3), as an outputSchema is: every keyword at its root
# kept, `$schema`, `$defs`, `allOf`, `additionalProperties` and the rest, and listed as
# written. Its type, properties and required are read from it here, keys and names as they
# decode, so everything that reads a ToolSchema reads this one; registration checks the
# JSON itself (registry_check_tool_def), and judges arguments by what bote enforces of it.
fn tool_schema_from_json(json) {
    var s = schema_new(0, 0, 0);
    store64(s + 24, json);
    if (json == 0 || jsonx_valid(json, strlen(json)) == 0 || jsonx_is_object(json) == 0) { return s; }
    var h = default_alloc();
    store64(s, jsonx_get_str_dec_a(h, json, "type"));
    var members = _jx_members(jsonx_get_raw(json, "properties"));
    var props = vec_new();
    var mi = 0;
    while (mi < vec_len(members)) {
        vec_push(props, schema_prop_new(vec_get(members, mi), vec_get(members, mi + 1)));
        mi = mi + 2;
    }
    store64(s + 8, props);
    var rq = jsonx_get_raw(json, "required");
    if (rq != 0 && _vp_first_nonws(rq) == 91) {
        var req = vec_new();
        var el = _sch_split_array(rq);
        var ri = 0;
        while (ri < vec_len(el)) {
            var ev = vec_get(el, ri);
            if (_sch_is_string(ev) == 1) {
                var nm = _sch_str_dec_a(h, ev);
                if (nm != 0) { vec_push(req, nm); }
            }
            ri = ri + 1;
        }
        store64(s + 16, req);
    }
    return s;
}

# Property pair (16 bytes): key_cstr, value_cstr (raw JSON literal)
fn schema_prop_new(key, value) {
    var p = alloc(16);
    store64(p, key);
    store64(p + 8, value);
    return p;
}
fn schema_prop_key(p) { return load64(p); }
fn schema_prop_value(p) { return load64(p + 8); }

# ================================================================
# ToolDef
# ================================================================
#
# Layout (80 bytes):
#   +0  name         cstr
#   +8  description  cstr
#   +16 input_schema ptr to ToolSchema
#   +24 version      cstr or 0
#   +32 deprecated   cstr or 0 (deprecation message)
#   +40 annotations  ptr to ToolAnnotations or 0
#   +48 compiled     ptr to CompiledSchema or 0 (set by tool_def_with_compiled)
#   +56 profiles     vec of cstr tags or 0 (set by tool_def_with_profiles)
#   +64 param_headers vec of ParamHeader or 0 (read from the schema at registration)
#   +72 required_scopes vec of cstr or 0 (all of them, for a token to call this tool)
#   +80 output_schema cstr or 0: the tool's outputSchema, its JSON as written (3.8.0)
#   +88 output_prop  PropertyDef or 0 (compiled from it at registration)
#   +96 output_legacy cstr or 0: what 2025-11-25 is shown when the root is not an object
#   +104 title       cstr or 0, for people, where `name` is for programs (3.8.1)
#   +112 icons       vec of Icon or 0 (3.8.1)
#   +120 display     cstr or 0: the title and icons as tools/list sends them, built at registration
#   +128 input_json  cstr or 0: the inputSchema as tools/list sends it, on one line, made at
#                    registration (3.8.3)
#   +136 own_compiled 1 when registration compiled +48, and compiles it again each time (3.8.4);
#                    0 when the consumer attached it with tool_def_with_compiled
#   +144 output_json the outputSchema as tools/list sends it, on one line, registration's own
#                    copy (3.8.5): +80 is the consumer's, which tool_def_with_output_schema sets
#
# Profiles are opaque consumer-defined tags (e.g. "security", "web", "full")
# used to expose curated tool subsets via a `profile` filter on tools/list.
# bote does no interpretation — membership is exact-match; an untagged tool
# (profiles == 0) is in no profile. See _build_tools_list_result_a in dispatch.

fn tool_def_new(name, description, input_schema) {
    var d = alloc(152);
    store64(d, name);
    store64(d + 8, description);
    store64(d + 16, input_schema);
    store64(d + 24, 0);
    store64(d + 32, 0);
    store64(d + 40, 0);
    store64(d + 48, 0);
    store64(d + 56, 0);
    store64(d + 64, 0);
    store64(d + 72, 0);
    store64(d + 80, 0);
    store64(d + 88, 0);
    store64(d + 96, 0);
    store64(d + 104, 0);
    store64(d + 112, 0);
    store64(d + 120, 0);
    store64(d + 128, 0);
    store64(d + 136, 0);
    store64(d + 144, 0);
    return d;
}

# A title for people (3.8.1), which a client shows before `annotations.title` and the
# name, and icons. Both are checked at registration, and sent as they were then.
fn tool_def_with_title(d, title) { store64(d + 104, title); return d; }
fn tool_def_with_icons(d, icons) { store64(d + 112, icons); return d; }

# `schema` is a whole JSON Schema, as the tools spec's outputSchema: a JSON object,
# whose root may be any type on MCP 2026-07-28. It is listed as written, and the
# structuredContent of every result that is not an error must match it (3.8.0).
fn tool_def_with_output_schema(d, schema) { store64(d + 80, schema); return d; }

fn tool_def_with_version(d, version) { store64(d + 24, version); return d; }
fn tool_def_with_deprecated(d, msg) { store64(d + 32, msg); return d; }
fn tool_def_with_annotations(d, ann) { store64(d + 40, ann); return d; }
# A compiled input schema of the consumer's own, which registration keeps (3.8.4: one
# registration made, by contrast, is made again by the next, from the schema as it is then).
fn tool_def_with_compiled(d, c) { store64(d + 48, c); store64(d + 136, 0); return d; }
fn tool_def_with_profiles(d, profiles) { store64(d + 56, profiles); return d; }
fn tool_def_with_required_scopes(d, scopes) { store64(d + 72, scopes); return d; }

fn tool_def_name(d) { return load64(d); }
fn tool_def_description(d) { return load64(d + 8); }
fn tool_def_input_schema(d) { return load64(d + 16); }
fn tool_def_version(d) { return load64(d + 24); }
fn tool_def_deprecated(d) { return load64(d + 32); }
fn tool_def_annotations(d) { return load64(d + 40); }
fn tool_def_compiled(d) { return load64(d + 48); }
fn tool_def_profiles(d) { return load64(d + 56); }
fn tool_def_param_headers(d) { return load64(d + 64); }
fn tool_def_required_scopes(d) { return load64(d + 72); }
fn tool_def_output_schema(d) { return load64(d + 80); }
fn tool_def_output_prop(d) { return load64(d + 88); }
fn tool_def_output_legacy(d) { return load64(d + 96); }
fn tool_def_title(d) { return load64(d + 104); }
fn tool_def_icons(d) { return load64(d + 112); }
fn tool_def_display(d) { return load64(d + 120); }
fn tool_def_input_json(d) { return load64(d + 128); }
fn tool_def_output_json(d) { return load64(d + 144); }

# Exact-match membership: 1 if `profile` (non-null) is one of the tool's
# profile tags, else 0. A null profile or an untagged tool returns 0.
fn tool_def_has_profile(d, profile) {
    if (profile == 0) { return 0; }
    var profs = tool_def_profiles(d);
    if (profs == 0) { return 0; }
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(profs, i), profile) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# ToolRegistry
# ================================================================
#
# Layout (24 bytes):
#   +0  entries  hashmap: name_cstr -> ToolDef ptr
#   +8  versions hashmap: name_cstr -> vec of ToolDef ptrs
#   +16 names    vec of name_cstr (insertion order, for list())

fn tool_registry_new() {
    var r = alloc(24);
    store64(r, map_new());
    store64(r + 8, map_new());
    store64(r + 16, vec_new());
    return r;
}

fn registry_entries(r) { return load64(r); }
fn registry_versions_map(r) { return load64(r + 8); }
fn registry_names(r) { return load64(r + 16); }

# 1 when `name` follows the MCP tools spec's naming guidance (2025-11-25,
# "Tool Names"): 1-128 characters, each an ASCII letter, a digit, `_`, `-`
# or `.`.
fn _reg_name_ok(name) {
    if (name == 0) { return 0; }
    var n = 0;
    while (load8(name + n) != 0) {
        var c = load8(name + n);
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 95 || c == 45 || c == 46) { ok = 1; }
        if (ok == 0) { return 0; }
        n = n + 1;
        if (n > 128) { return 0; }
    }
    if (n == 0) { return 0; }
    return 1;
}

# 1 when `raw` is a JSON Schema in its own right: valid JSON that is an
# object, `true` or `false` (2020-12).
fn _reg_subschema_ok(raw) {
    if (raw == 0) { return 0; }
    if (jsonx_valid(raw, strlen(raw)) == 0) { return 0; }
    if (jsonx_is_object(raw) == 1) { return 1; }
    if (streq(raw, "true") == 1 || streq(raw, "false") == 1) { return 1; }
    return 0;
}

# ================================================================
# x-mcp-header
# ================================================================
#
# A tool can have an argument mirrored into an `Mcp-Param-{Name}` header. A client
# drops a tool whose annotation breaks the rules, so bote refuses to register one,
# and HTTP checks the headers against what is read here.
#
# ParamHeader (16 bytes):
#   +0 field  cstr, the whole header name
#   +8 path   vec of cstr, the `properties` keys that lead to the value

var REG_MCP_HEADER = "x-mcp-header";

fn param_header_field(p) { return load64(p); }
fn param_header_path(p) { return load64(p + 8); }

# The words of the space-separated `s`, as a vec of cstrs.
fn _reg_words(s) {
    var out = vec_new();
    var start = 0;
    var k = 0;
    while (load8(s + k) != 0) {
        if (load8(s + k) == 32) {
            var w = alloc(k - start + 1);
            memcpy(w, s + start, k - start);
            store8(w + k - start, 0);
            vec_push(out, w);
            start = k + 1;
        }
        k = k + 1;
    }
    return out;
}

# The keywords that hold a subschema but do not extend a chain of `properties`
# keys. Reading only these, and not every value, keeps a `default` or an `enum` that
# happens to hold the word from counting as an annotation.
var _reg_below_kws = 0;

fn _reg_below() {
    if (_reg_below_kws == 0) {
        _reg_below_kws = _reg_words("items prefixItems contains additionalProperties unevaluatedProperties unevaluatedItems propertyNames not if then else oneOf anyOf allOf patternProperties dependentSchemas $defs definitions ");
    }
    return _reg_below_kws;
}

# 1 when `c` is an RFC 9110 tchar.
fn _reg_tchar(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39) { return 1; }
    if (c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95) { return 1; }
    if (c == 96 || c == 124 || c == 126) { return 1; }
    return 0;
}

fn _reg_token_ok(s) {
    if (load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        if (_reg_tchar(load8(s + i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _reg_lower(c) {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# 1 when two cstrs differ at most in the case of their ASCII letters.
fn _reg_ieq(x, y) {
    var i = 0;
    while (_reg_lower(load8(x + i)) == _reg_lower(load8(y + i))) {
        if (load8(x + i) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The schema `raw` has an annotation: why it is not allowed, or 0, having added it
# to `out`. `reach` says the keys that led here were all `properties` keys.
fn _reg_header_take(raw, path, reach, out) {
    if (reach == 0 || vec_len(path) == 0) {
        return "x-mcp-header must sit on a property reached through `properties` keys alone";
    }
    var name = jsonx_get_str_dec_a(default_alloc(), raw, REG_MCP_HEADER);
    if (name == 0 || _reg_token_ok(name) == 0) {
        return "x-mcp-header must be a non-empty HTTP token";
    }
    # (3.8.3) The type as it decodes, as parse_property reads it since 3.8.1.
    var ty = jsonx_get_str_dec_a(default_alloc(), raw, "type");
    if (ty == 0 || (streq(ty, "string") == 0 && streq(ty, "integer") == 0 && streq(ty, "boolean") == 0)) {
        return "x-mcp-header needs a property of type string, integer or boolean";
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Mcp-Param-");
    str_builder_add_cstr(sb, name);
    var field = str_data(str_builder_build(sb));
    var i = 0;
    while (i < vec_len(out)) {
        if (_reg_ieq(field, param_header_field(vec_get(out, i))) == 1) {
            return "x-mcp-header values must be unique, ignoring case";
        }
        i = i + 1;
    }
    var p = alloc(16);
    store64(p, field);
    store64(p + 8, path);
    vec_push(out, p);
    return 0;
}

fn _reg_path_with(path, key) {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(path)) {
        vec_push(out, vec_get(path, i));
        i = i + 1;
    }
    vec_push(out, key);
    return out;
}

# 1 when `kw` holds an object of subschemas by name.
fn _reg_by_name(kw) {
    if (streq(kw, "patternProperties") == 1 || streq(kw, "dependentSchemas") == 1) { return 1; }
    if (streq(kw, "$defs") == 1 || streq(kw, "definitions") == 1) { return 1; }
    return 0;
}

# Walk what the keyword `kw` of _reg_below holds: one subschema, an array of them,
# or an object of them by name.
fn _reg_scan_below(kw, v, out) {
    var subs = vec_new();
    if (_sch_is_array(v) == 1) {
        subs = _sch_split_array(v);
    } elif (_reg_by_name(kw) == 1) {
        var m = _jx_members(v);
        var k = 1;
        while (k < vec_len(m)) {
            vec_push(subs, vec_get(m, k));
            k = k + 2;
        }
    } else {
        vec_push(subs, v);
    }
    var i = 0;
    while (i < vec_len(subs)) {
        var why = _reg_scan_headers(vec_get(subs, i), vec_new(), 0, out);
        if (why != 0) { return why; }
        i = i + 1;
    }
    return 0;
}

# Walk the schema `raw`. Returns why an annotation in it is not allowed, or 0.
fn _reg_scan_headers(raw, path, reach, out) {
    if (jsonx_is_object(raw) == 0) { return 0; }
    var why = 0;
    if (jsonx_has(raw, REG_MCP_HEADER) == 1) {
        why = _reg_header_take(raw, path, reach, out);
        if (why != 0) { return why; }
    }
    var m = _jx_members(jsonx_get_raw(raw, "properties"));
    var i = 0;
    while (i < vec_len(m)) {
        why = _reg_scan_headers(vec_get(m, i + 1), _reg_path_with(path, vec_get(m, i)), reach, out);
        if (why != 0) { return why; }
        i = i + 2;
    }
    var kws = _reg_below();
    i = 0;
    while (i < vec_len(kws)) {
        var v = jsonx_get_raw(raw, vec_get(kws, i));
        if (v != 0) {
            why = _reg_scan_below(vec_get(kws, i), v, out);
            if (why != 0) { return why; }
        }
        i = i + 1;
    }
    return 0;
}

# Every ParamHeader of `tool_def` into `out`. Returns why one is not allowed, or 0.
# The property schemas must already have passed registry_check_tool_def's checks.
fn _reg_scan_tool(tool_def, out) {
    # (3.8.3) An inputSchema given as JSON from its root, so an annotation under `$defs`,
    # `allOf` or any keyword of _reg_below there is found, and refused.
    var js = tool_schema_json(tool_def_input_schema(tool_def));
    if (js != 0) { return _reg_scan_headers(js, vec_new(), 1, out); }
    var props = schema_properties(tool_def_input_schema(tool_def));
    if (props == 0) { return 0; }
    var i = 0;
    while (i < vec_len(props)) {
        var pair = vec_get(props, i);
        var path = _reg_path_with(vec_new(), schema_prop_key(pair));
        var why = _reg_scan_headers(schema_prop_value(pair), path, 1, out);
        if (why != 0) { return why; }
        i = i + 1;
    }
    return 0;
}

# Why `tool_def` cannot be registered, as a message, or 0 when it can (3.4.8).
#
# - The name follows the MCP tools spec's guidance. Every consumer's names
#   already do, and a `Str` passed where bote takes a cstr fails it: phylax
#   passed one for every name and its tools/list crashed.
# - inputSchema exists and is an object schema. The spec says it "MUST be a
#   valid JSON Schema object (not null)". t-ron passed `str_from("object")`
#   as the type, and tools/list emitted the Str header as garbage bytes.
# - Each property schema is valid JSON (an object or a boolean), and each
#   property and each required entry has a name.
# - Each `x-mcp-header` keeps the rules of MCP 2026-07-28.
# - (3.8.0) An outputSchema is valid JSON and an object.
# - (3.8.1) Each icon is what the spec says (bote_icons_check). (3.8.2) A title may be
#   empty, as the spec's `title?: string` allows; 3.8.1 refused one.
# - Each required scope is a scope-token.
# - (3.8.3) An inputSchema given as JSON is what _reg_check_input_json allows.
#
# Public, so a consumer can check a definition before it registers one.
fn registry_check_tool_def(tool_def) {
    if (tool_def == 0) { return "no tool definition"; }
    if (_reg_name_ok(tool_def_name(tool_def)) == 0) {
        return "the tool name must be 1-128 characters from A-Z a-z 0-9 _ - .";
    }
    var schema = tool_def_input_schema(tool_def);
    if (schema == 0) { return "inputSchema is missing"; }
    var jwhy = _reg_check_input_json(tool_schema_json(schema));
    if (jwhy != 0) { return jwhy; }
    var st = schema_type(schema);
    if (st == 0 || streq(st, "object") == 0) { return "inputSchema type must be \"object\""; }
    var props = schema_properties(schema);
    if (props != 0) {
        var np = vec_len(props);
        var i = 0;
        while (i < np) {
            var pair = vec_get(props, i);
            var key = schema_prop_key(pair);
            if (key == 0 || strlen(key) == 0) { return "an inputSchema property has no name"; }
            # (3.8.4) A name a client reads as bote does: bytes that are no UTF-8 are listed as
            # U+FFFD, so an argument a client named so never met the property.
            if (_reg_utf8_ok(key) == 0) { return "an inputSchema property's name is not UTF-8"; }
            if (_reg_subschema_ok(schema_prop_value(pair)) == 0) {
                return "an inputSchema property's schema is not a valid JSON Schema (an object or a boolean)";
            }
            # (3.8.2) As an outputSchema's: a `required` name or an `enum` value holding a
            # NUL could not be judged, and a key named twice would be read two ways.
            if (_jx_repeats_a(default_alloc(), schema_prop_value(pair), 1) == 1) {
                return "an inputSchema property's schema names a key twice in one object, or holds a NUL or a key that is not text";
            }
            i = i + 1;
        }
    }
    var req = schema_required(schema);
    if (req != 0) {
        var nr = vec_len(req);
        var j = 0;
        while (j < nr) {
            var rq = vec_get(req, j);
            if (rq == 0 || strlen(rq) == 0) { return "an inputSchema required entry is empty"; }
            if (_reg_utf8_ok(rq) == 0) { return "an inputSchema required name is not UTF-8"; }
            j = j + 1;
        }
    }
    # (3.8.14) An inputSchema given as JSON, for what the client's validator compiles of it.
    var cwhy = _reg_check_input_compiled(tool_schema_json(schema));
    if (cwhy != 0) { return cwhy; }
    # (3.8.10) A ToolSchema's references, resolved in the inputSchema tools/list sends,
    # written out only where a property may hold one.
    if (tool_schema_json(schema) == 0 && _reg_props_may_ref(props) == 1) {
        var isb = str_builder_new();
        _emit_schema(isb, schema);
        var irw = _sch_refs_why(str_data(str_builder_build(isb)));
        if (irw != 0) { return _dsp_named_msg("the inputSchema ", irw, 0); }
    }
    # (3.8.13) And its formats, as the client's Ajv compiles them; (3.8.14) and every keyword's
    # kind, `$id`s, anchors and dynamic references, which through 3.8.13 were checked only
    # beside a format.
    if (tool_schema_json(schema) == 0 && props != 0 && vec_len(props) > 0) {
        var fsb = str_builder_new();
        _emit_schema(fsb, schema);
        var ifw = _sch_compiled_why(str_data(str_builder_build(fsb)));
        if (ifw != 0) { return _dsp_named_msg("the inputSchema ", ifw, 0); }
    }
    var os = tool_def_output_schema(tool_def);
    if (os != 0) {
        if (jsonx_valid(os, strlen(os)) == 0) { return "the outputSchema is not valid JSON"; }
        if (jsonx_is_object(os) == 0) { return "the outputSchema must be a JSON Schema object"; }
        # (3.8.1) A key named twice in one object, or one that decodes to hold a NUL, is
        # read one way here and another by a client, or cannot be judged at all.
        if (_jx_repeats_a(default_alloc(), os, 1) == 1) {
            return "the outputSchema names a key twice in one object, or holds a NUL or a key that is not text";
        }
        if (_reg_dialect_known(os) == 0) {
            return "the outputSchema's $schema names a dialect bote does not support (2020-12, 2019-09, draft-07, draft-06)";
        }
        # (3.8.10) Its references, each resolved within it.
        var orw = _sch_refs_why(os);
        if (orw != 0) { return _dsp_named_msg("the outputSchema ", orw, 0); }
        var ofw = _sch_compiled_why(os);
        if (ofw != 0) { return _dsp_named_msg("the outputSchema ", ofw, 0); }
        # (3.8.14) And the form 2025-11-25 lists it in, where its root is no object.
        if (_reg_output_root_object(os) == 0) {
            var olw = _sch_legacy_why(os);
            if (olw != 0) { return _dsp_named_msg("the outputSchema ", olw, 0); }
        }
    }
    var dwhy = bote_display_check(tool_def_title(tool_def), tool_def_icons(tool_def));
    if (dwhy != 0) { return dwhy; }
    var scopes = tool_def_required_scopes(tool_def);
    if (scopes != 0) {
        var k = 0;
        while (k < vec_len(scopes)) {
            if (bote_scope_token_ok(vec_get(scopes, k)) == 0) { return "a required scope must be a non-empty token with no space, quote or backslash"; }
            k = k + 1;
        }
    }
    return _reg_scan_tool(tool_def, vec_new());
}

# 1 when the cstr `s` is UTF-8 (3.8.4).
# 1 when a ToolSchema property's schema may hold a `$ref`, an anchor or an `$id`, written
# plainly or with an escape (3.8.10).
fn _reg_props_may_ref(props) {
    if (props == 0) { return 0; }
    var i = 0;
    while (i < vec_len(props)) {
        var v = schema_prop_value(vec_get(props, i));
        if (v != 0 && (strchr(v, 36) >= 0 || strstr(v, "\\u") >= 0)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _reg_utf8_ok(s) {
    var i = 0;
    while (load8(s + i) != 0) {
        if (load8(s + i) < 128) { i = i + 1; }
        else {
            var l = _jx_utf8_len(s + i);
            if (l == 0) { return 0; }
            i = i + l;
        }
    }
    return 1;
}

# Why an inputSchema given as JSON (tool_schema_from_json) cannot be registered, or 0
# (3.8.3). What a client's parser requires of it, as the official SDK reads one: an object
# whose `properties`, if any, is an object, and whose `required`, if any, is an array of
# strings, or the client drops the whole list. And what bote requires of an outputSchema:
# no key twice in one object, none and no string holding a NUL, and a dialect bote knows.
# The rest is checked on what was read from it, as for any ToolSchema: its `type`, as it
# decodes, must be "object".
# (3.8.14) Why an inputSchema given as JSON cannot be registered for what the official client's
# validator compiles of it, or 0: its references, each resolved within it (3.8.10), and every
# compiled schema's keywords (_sch_compiled_why). Asked after the checks of its own fields, so
# each of those says what it says.
fn _reg_check_input_compiled(js) {
    if (js == 0) { return 0; }
    var rw = _sch_refs_why(js);
    if (rw != 0) { return _dsp_named_msg("the inputSchema ", rw, 0); }
    var fw = _sch_compiled_why(js);
    if (fw != 0) { return _dsp_named_msg("the inputSchema ", fw, 0); }
    return 0;
}

fn _reg_check_input_json(js) {
    if (js == 0) { return 0; }
    if (jsonx_valid(js, strlen(js)) == 0) { return "the inputSchema is not valid JSON"; }
    if (jsonx_is_object(js) == 0) { return "the inputSchema must be a JSON Schema object"; }
    if (_jx_repeats_a(default_alloc(), js, 1) == 1) {
        return "the inputSchema names a key twice in one object, or holds a NUL or a key that is not text";
    }
    if (_reg_dialect_known(js) == 0) {
        return "the inputSchema's $schema names a dialect bote does not support (2020-12, 2019-09, draft-07, draft-06)";
    }
    var pr = jsonx_get_raw(js, "properties");
    if (pr != 0 && _vp_first_nonws(pr) != 123) { return "the inputSchema's properties must be an object"; }
    var rq = jsonx_get_raw(js, "required");
    if (rq != 0) {
        if (_vp_first_nonws(rq) != 91) { return "the inputSchema's required must be an array of strings"; }
        var el = _sch_split_array(rq);
        var i = 0;
        while (i < vec_len(el)) {
            if (_sch_is_string(vec_get(el, i)) == 0) { return "the inputSchema's required must be an array of strings"; }
            # (3.8.4) Each name text a client reads as bote does: one that is not, a lone
            # surrogate or bytes that are no UTF-8, was read as no name and left out.
            if (_sch_str_dec_a(default_alloc(), vec_get(el, i)) == 0) { return "an inputSchema required name is no text a client reads as bote does"; }
            i = i + 1;
        }
    }
    return 0;
}

# One ERROR line for a refused registration. The name is logged only when
# it passed the name check; otherwise it may be the bytes of a Str header.
fn _reg_log_refused(tool_def, why) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_ERROR, "tool registration refused");
    if (tool_def != 0 && _reg_name_ok(tool_def_name(tool_def)) == 1) {
        bote_log_str(&ln, "tool", tool_def_name(tool_def));
    }
    bote_log_str(&ln, "reason", why);
    bote_log_emit(&ln);
    return 0;
}

# Register `tool_def`. Returns 0, or a BoteError when registry_check_tool_def
# refuses it, in which case nothing is registered and an ERROR line says why.
# The input schema is compiled here unless tool_def_with_compiled already
# attached one (3.4.8). Through 3.4.7 nothing compiled it, so every tool was
# checked only for its required fields.
# One WARN for a keyword on a property that tools/list advertises and validation
# does not enforce, so that a schema's author is told, and the tool still works:
# extra keywords are the client's to read. See the validator's subset in
# schema.cyr. A non-string `enum` and a type array are the same gap.
# Of a `multipleOf` (_sch_multiple_of) that is an integer: 2 when it is past a double's
# range, 1 when it is past 2^53, which a double does not hold exactly, else 0.
fn _reg_multiple_size(mm) {
    var d = load64(mm + 8);
    var p = load64(mm + 16);
    if (p < 0) { return 0; }
    var nd = 0;
    var t = d;
    while (t > 0) { nd = nd + 1; t = t / 10; }
    var digits = nd + p;
    if (digits > 309) { return 2; }
    if (digits == 309) {
        # Its first 17 digits against where a double turns infinite, 2^1024 - 2^970, just past
        # 1.7976931348623158e308: (3.8.13, from the 3.8.12 review) through 3.8.12 the largest
        # double's 1.7976931348623157e308, so 1.7976931348623158e308, which a double reads as that
        # largest, was warned of as infinite.
        var lead = d;
        var k = nd;
        while (k < 17) { lead = lead * 10; k = k + 1; }
        if (lead > 17976931348623158) { return 2; }
        return 1;
    }
    if (digits > 16) { return 1; }
    if (digits == 16) {
        var v = d;
        var q = 0;
        while (q < p) { v = v * 10; q = q + 1; }
        if (v > 9007199254740992) { return 1; }
    }
    return 0;
}

fn _reg_warn_kw(tool, key, kw) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "schema keyword not enforced");
    bote_log_str(&ln, "tool", tool);
    bote_log_str(&ln, "property", key);
    bote_log_str(&ln, "keyword", kw);
    bote_log_emit(&ln);
    return 0;
}

# The keywords bote lists and does not enforce, each a WARN (3.8.1 adds those through
# 3.8.0 passed over in silence: additionalProperties among them, which a schema for a tool
# with no parameters is told to say). (3.8.2) `format`, which the official client
# enforces, and draft-07's `additionalItems` and `dependencies`; an array `items` is a
# WARN of its own (_reg_warn_schema).
# (3.8.5) minLength, maxLength, minItems, maxItems, minProperties, maxProperties,
# exclusiveMinimum, exclusiveMaximum and additionalProperties are judged, and no longer here.
# (3.8.7) const and uniqueItems too. (3.8.8) prefixItems, contains, propertyNames,
# dependentRequired and dependentSchemas. (3.8.9) allOf, anyOf, oneOf, not, if, then, else.
# (3.8.10) $ref, within its document. (3.8.11) pattern and multipleOf. (3.8.12) patternProperties.
# (3.8.14) $dynamicRef and $recursiveRef, where they name the root. (3.8.15) unevaluatedProperties and
# unevaluatedItems.
var BOTE_UNENFORCED = "additionalItems dependencies formatMinimum formatMaximum formatExclusiveMinimum formatExclusiveMaximum ";

# Every WARN the schema `v`, at `key` of tool `tool`, earns: each keyword in `kws` it
# holds, a type bote does not know, alone or in a type array, and a keyword it judges with a
# value it cannot judge by.
fn _reg_warn_schema(tool, key, v, kws) { return _reg_warn_schema_d(tool, key, v, kws, _sch_dialect(v)); }

# _reg_warn_schema for a schema of dialect `d`, a root's (_sch_dialect) for its properties too.
fn _reg_warn_schema_d(tool, key, v, kws, d) {
    # (3.8.9, from the 3.8.8 review) A keyword its dialect does not have judges nothing, here
    # or to a client, which picks its validator by `$schema`.
    var late = 0;
    if (d != 2020) { late = _reg_words("prefixItems "); }
    if (d == 7) { late = _reg_words("prefixItems minContains maxContains dependentRequired dependentSchemas $dynamicRef $recursiveRef unevaluatedProperties unevaluatedItems "); }
    if (d == 2019) { late = _reg_words("prefixItems "); }
    if (d == 6) { late = _reg_words("prefixItems minContains maxContains dependentRequired dependentSchemas $dynamicRef $recursiveRef unevaluatedProperties unevaluatedItems "); }
    if (late != 0) {
        var li = 0;
        while (li < vec_len(late)) {
            if (jsonx_has(v, vec_get(late, li)) == 1) { _reg_warn_kw(tool, key, _dsp_named_msg(vec_get(late, li), ", which this schema's dialect does not have", 0)); }
            li = li + 1;
        }
    }
    # (3.8.10, from the 3.8.9 review) draft-06 has no `if`, `then` or `else`, and the official
    # client's engine for it, draft-07's, judges them, as bote does since.
    if (d == 6) {
        var ite = _reg_words("if then else ");
        var ii = 0;
        while (ii < vec_len(ite)) {
            if (jsonx_has(v, vec_get(ite, ii)) == 1) { _reg_warn_kw(tool, key, _dsp_named_msg(vec_get(ite, ii), ", which draft-06 does not have and bote judges, as the official client does", 0)); }
            ii = ii + 1;
        }
    }
    # (3.8.14) The official client's engines for 2019-09 and 2020-12 judge both dynamic
    # references, where JSON Schema gives each dialect one.
    if (d == 2020 && jsonx_has(v, "$recursiveRef") == 1) { _reg_warn_kw(tool, key, "$recursiveRef, which 2020-12 does not have and bote judges, as the official client does"); }
    if (d == 2019 && jsonx_has(v, "$dynamicRef") == 1) { _reg_warn_kw(tool, key, "$dynamicRef, which 2019-09 does not have and bote judges, as the official client does"); }
    var k = 0;
    while (k < vec_len(kws)) {
        if (jsonx_has(v, vec_get(kws, k)) == 1) { _reg_warn_kw(tool, key, vec_get(kws, k)); }
        k = k + 1;
    }
    # (3.8.10) draft-07 and draft-06 ignore every keyword beside a `$ref`, and the official
    # client's engine for them judges each, as bote does: clients read such a schema two ways.
    if ((d == 6 || d == 7) && jsonx_has(v, "$ref") == 1 && _reg_ref_siblings(v) == 1) {
        _reg_warn_kw(tool, key, "keywords beside $ref, which this schema's dialect ignores and bote judges");
    }
    # (3.8.11) A `pattern` bote's engine does not take, and a `multipleOf` it does not judge, or
    # judges as a client holding doubles may not.
    var pr = jsonx_get_raw(v, "pattern");
    if (pr != 0) {
        var pt = 0;
        if (_sch_is_string(pr) == 1) { pt = _sch_str_dec_a(default_alloc(), pr); }
        if (pt == 0) { _reg_warn_kw(tool, key, "pattern that is no string, or no text"); }
        else {
            # (3.8.13, from the 3.8.12 review) A compile that keeps nothing: this one kept its
            # program on the heap beside the schema's own, 382 KB for `^.{0,2000}$`.
            var pnt[8];
            var pw = bote_rx_why_of(pt, &pnt);
            if (pw != 0) { _reg_warn_kw(tool, key, _dsp_named_msg("pattern bote's engine does not take, for ", pw, 0)); }
            elif (load64(&pnt) == 1) { _reg_warn_kw(tool, key, "pattern naming two groups alike, which Node before 23 refuses whole"); }
        }
    }
    var mr = jsonx_get_raw(v, "multipleOf");
    if (mr != 0) {
        var mm = _sch_multiple_of(mr);
        if (_sch_is_number_text(mr) == 0) { _reg_warn_kw(tool, key, "multipleOf that is no number"); }
        elif (mm == 0) { _reg_warn_kw(tool, key, "multipleOf of more than 17 significant digits, which bote does not judge"); }
        elif (load64(mm) == 2) { _reg_warn_kw(tool, key, "multipleOf 0, which no number meets"); }
        else {
            if (_sch_first_nonws(mr) == 45) { _reg_warn_kw(tool, key, "multipleOf below 0, judged by its size, as the official client judges it"); }
            if (load64(mm + 16) < 0) { _reg_warn_kw(tool, key, "multipleOf that is no integer, which bote judges exactly and a client holding numbers as doubles may not"); }
            # (3.8.12, from the 3.8.11 review) An integer a double holds inexactly, or not at all.
            var mw = _reg_multiple_size(mm);
            if (mw == 2) { _reg_warn_kw(tool, key, "multipleOf past a double's range, which a client holding doubles reads as infinite"); }
            elif (mw == 1) { _reg_warn_kw(tool, key, "multipleOf past 2^53, judged exactly here and perhaps not by a client holding doubles"); }
        }
    }
    # (3.8.13) A `format` bote does not judge: `regex`, which the client checks with
    # JavaScript's own syntax, and one the client's ajv-formats does not know, which neither
    # judges.
    var fr = jsonx_get_raw(v, "format");
    if (fr != 0 && _sch_is_string(fr) == 1) {
        var fname = _sch_str_dec_a(default_alloc(), fr);
        var fid = bote_format_id(fname);
        if (fid == BOTE_FMT_REGEX) { _reg_warn_kw(tool, key, "format regex, which the official client judges by JavaScript's syntax and bote does not"); }
        elif (fid == 0) { _reg_warn_kw(tool, key, "a format the official client does not know, which neither judges"); }
    }
    var ty = jsonx_get_str_dec_a(default_alloc(), v, "type");
    if (ty != 0 && _reg_type_known(ty) == 0) { _reg_warn_kw(tool, key, "an unknown type"); }
    # (3.8.7) A type array is judged, its names each a type; one it does not know, or none,
    # judges nothing for that name.
    var tr = jsonx_get_raw(v, "type");
    if (tr != 0 && ty == 0) {
        if (_sch_first_nonws(tr) != 91) {
            _reg_warn_kw(tool, key, "type that is no string or array");
        } else {
            var tel = _sch_split_array(tr);
            if (vec_len(tel) == 0) { _reg_warn_kw(tool, key, "an empty type array"); }
            var tj = 0;
            var tbad = 0;
            while (tj < vec_len(tel)) {
                var tv = vec_get(tel, tj);
                # (3.8.8, from the 3.8.7 review) A name that is no text decodes to 0: it named no
                # type, and was handed to streq, which crashed registration.
                var tdn = 0;
                if (_sch_is_string(tv) == 1) { tdn = _sch_str_dec_a(default_alloc(), tv); }
                if (tdn == 0 || _reg_type_known(tdn) == 0) { tbad = 1; }
                tj = tj + 1;
            }
            if (tbad == 1) { _reg_warn_kw(tool, key, "a type array naming an unknown type"); }
        }
    }
    var en = jsonx_get_raw(v, "enum");
    if (en != 0 && _sch_first_nonws(en) != 91) { _reg_warn_kw(tool, key, "enum that is no array"); }
    # (3.8.8) The array and object keywords judged since, each with a value it can judge by.
    var pre = jsonx_get_raw(v, "prefixItems");
    if (pre != 0 && _sch_first_nonws(pre) != 91) { _reg_warn_kw(tool, key, "prefixItems that is no array"); }
    var sk = _reg_words("contains propertyNames ");
    var ski = 0;
    while (ski < vec_len(sk)) {
        var sr = jsonx_get_raw(v, vec_get(sk, ski));
        if (sr != 0 && _sch_is_schema_text(sr) == 0) { _reg_warn_kw(tool, key, _dsp_named_msg(vec_get(sk, ski), " that is no schema", 0)); }
        ski = ski + 1;
    }
    var drq = jsonx_get_raw(v, "dependentRequired");
    if (drq != 0) {
        var drok = 0;
        if (_sch_first_nonws(drq) == 123) {
            drok = 1;
            var drm = _jx_members(drq);
            var dri = 0;
            while (dri < vec_len(drm)) {
                var drv = vec_get(drm, dri + 1);
                if (_sch_first_nonws(drv) != 91) { drok = 0; }
                else {
                    var drl = _sch_split_array(drv);
                    var drj = 0;
                    while (drj < vec_len(drl)) { if (_sch_is_string(vec_get(drl, drj)) == 0) { drok = 0; } drj = drj + 1; }
                }
                dri = dri + 2;
            }
        }
        if (drok == 0) { _reg_warn_kw(tool, key, "dependentRequired that is no object of arrays of names"); }
    }
    var dsc = jsonx_get_raw(v, "dependentSchemas");
    if (dsc != 0) {
        var dsok = 0;
        if (_sch_first_nonws(dsc) == 123) {
            dsok = 1;
            var dsm = _jx_members(dsc);
            var dsi = 0;
            while (dsi < vec_len(dsm)) { if (_sch_is_schema_text(vec_get(dsm, dsi + 1)) == 0) { dsok = 0; } dsi = dsi + 2; }
        }
        if (dsok == 0) { _reg_warn_kw(tool, key, "dependentSchemas that is no object of schemas"); }
    }
    # (3.8.9) Composition, each keyword a value it can judge by.
    var ck = _reg_words("allOf anyOf oneOf ");
    var cki = 0;
    while (cki < vec_len(ck)) {
        var cr = jsonx_get_raw(v, vec_get(ck, cki));
        # (3.8.10) An empty one is judged, as the client judges it, and is still no schema's
        # meaning of it: `anyOf` and `oneOf` of none refuse every value.
        if (cr != 0 && (_sch_schemas(v, vec_get(ck, cki)) == 0 || vec_len(_sch_split_array(cr)) == 0)) {
            _reg_warn_kw(tool, key, _dsp_named_msg(vec_get(ck, cki), " that is no non-empty array of schemas", 0));
        }
        cki = cki + 1;
    }
    var nk = _reg_words("not if then else ");
    var nki = 0;
    while (nki < vec_len(nk)) {
        var nr = jsonx_get_raw(v, vec_get(nk, nki));
        if (nr != 0 && _sch_is_schema_text(nr) == 0) { _reg_warn_kw(tool, key, _dsp_named_msg(vec_get(nk, nki), " that is no schema", 0)); }
        nki = nki + 1;
    }
    if (jsonx_has(v, "if") == 0 && (jsonx_has(v, "then") == 1 || jsonx_has(v, "else") == 1)) {
        _reg_warn_kw(tool, key, "then or else without if");
    }
    var uq = jsonx_get_raw(v, "uniqueItems");
    if (uq != 0 && streq(uq, "true") == 0 && streq(uq, "false") == 0) {
        _reg_warn_kw(tool, key, "uniqueItems that is no boolean");
    }
    var it = jsonx_get_raw_a(default_alloc(), v, "items");
    if (it != 0 && load8(it) == 91) { _reg_warn_kw(tool, key, "items as an array"); }
    # (3.8.5) Which members additionalProperties covers turns on patternProperties, which
    # (3.8.12) is judged since, each pattern by src/regex.cyr: one it does not take judges nothing,
    # and `additionalProperties` beside it nothing either, as which members that pattern covers
    # is unknown.
    var ppv = jsonx_get_raw(v, "patternProperties");
    if (ppv != 0) {
        if (_sch_first_nonws(ppv) != 123) { _reg_warn_kw(tool, key, "patternProperties that is no object"); }
        else {
            var ppm = _jx_members(ppv);
            var ppi = 0;
            var ppd = 0;
            while (ppi < vec_len(ppm)) {
                var ppnt[8];
                var ppw = bote_rx_why_of(vec_get(ppm, ppi), &ppnt);
                if (ppw == 0 && load64(&ppnt) == 1) { _reg_warn_kw(tool, key, "patternProperties pattern naming two groups alike, which Node before 23 refuses whole"); }
                if (ppw != 0) {
                    ppd = 1;
                    _reg_warn_kw(tool, key, _dsp_named_msg("a patternProperties pattern bote's engine does not take, for ", ppw, 0));
                }
                ppi = ppi + 2;
            }
            if (ppd == 1 && jsonx_has(v, "additionalProperties") == 1) {
                _reg_warn_kw(tool, key, "additionalProperties beside a pattern bote's engine does not take, which judges nothing");
            }
            # (3.8.15) Which members such a pattern evaluates is not known either.
            if (ppd == 1 && jsonx_has(v, "unevaluatedProperties") == 1) {
                _reg_warn_kw(tool, key, "unevaluatedProperties beside a pattern bote's engine does not take, which judges nothing");
            }
        }
    }
    # (3.8.6, from the 3.8.5 review) A keyword bote judges, with a value it cannot judge by,
    # judges nothing, where a client's validator refuses the schema: said, as 3.8.4 said of
    # each before bote judged them.
    var counts = _reg_words("minLength maxLength minItems maxItems minProperties maxProperties minContains maxContains ");
    var ci = 0;
    while (ci < vec_len(counts)) {
        var ck = vec_get(counts, ci);
        if (jsonx_has(v, ck) == 1 && _sch_count_plain(v, ck) == 0) {
            _reg_warn_kw(tool, key, _dsp_named_msg(ck, " that is no non-negative integer, judged as the official client compares it", 0));
        }
        ci = ci + 1;
    }
    var bounds = _reg_words("minimum maximum exclusiveMinimum exclusiveMaximum ");
    var bi = 0;
    while (bi < vec_len(bounds)) {
        var bk = vec_get(bounds, bi);
        if (jsonx_has(v, bk) == 1 && _sch_is_number_text(jsonx_get_raw(v, bk)) == 0) {
            _reg_warn_kw(tool, key, _dsp_named_msg(bk, " that is no number", 0));
        }
        bi = bi + 1;
    }
    var ap = jsonx_get_raw(v, "additionalProperties");
    if (ap != 0) {
        var apc = _sch_first_nonws(ap);
        if (apc != 123 && streq(ap, "true") == 0 && streq(ap, "false") == 0) {
            _reg_warn_kw(tool, key, "additionalProperties that is no boolean or object");
        }
    }
    return 0;
}

# 1 when the schema `v` holds a keyword beside its `$ref` that judges a value: one that is no
# annotation, identifier or store of definitions.
fn _reg_ref_siblings(v) {
    var quiet = _reg_words("$ref $schema $id $comment title description default examples definitions $defs ");
    var mem = _jx_members(v);
    var i = 0;
    while (i < vec_len(mem)) {
        var hit = 0;
        var q = 0;
        while (q < vec_len(quiet)) { if (streq(vec_get(mem, i), vec_get(quiet, q)) == 1) { hit = 1; } q = q + 1; }
        if (hit == 0) { return 1; }
        i = i + 2;
    }
    return 0;
}

fn _reg_type_known(ty) {
    if (ty == 0) { return 0; }
    var known = "string number integer boolean array object null ";
    var ws = _reg_words(known);
    var i = 0;
    while (i < vec_len(ws)) {
        if (streq(ty, vec_get(ws, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _reg_warn_unenforced(tool_def) {
    var kws = _reg_words(BOTE_UNENFORCED);
    # (3.8.3) An inputSchema given as JSON can hold any keyword at its root.
    var js = tool_schema_json(tool_def_input_schema(tool_def));
    if (js != 0) { _reg_warn_schema_d(tool_def_name(tool_def), "inputSchema", js, kws, _sch_dialect(js)); }
    var props = schema_properties(tool_def_input_schema(tool_def));
    if (props == 0) { return 0; }
    var i = 0;
    while (i < vec_len(props)) {
        var pair = vec_get(props, i);
        # A JSON inputSchema's properties are of its root's dialect (3.8.9).
        var pd = _sch_dialect(schema_prop_value(pair));
        if (js != 0) { pd = _sch_dialect(js); }
        _reg_warn_schema_d(tool_def_name(tool_def), schema_prop_key(pair), schema_prop_value(pair), kws, pd);
        i = i + 1;
    }
    return 0;
}

# The same warnings for an outputSchema: its root, and each of the root's properties.
fn _reg_warn_output(tool_def) {
    var kws = _reg_words(BOTE_UNENFORCED);
    var os = tool_def_output_schema(tool_def);
    var od = _sch_dialect(os);
    _reg_warn_schema_d(tool_def_name(tool_def), "outputSchema", os, kws, od);
    var members = _jx_members(jsonx_get_raw(os, "properties"));
    var mi = 0;
    while (mi < vec_len(members)) {
        _reg_warn_schema_d(tool_def_name(tool_def), _dsp_named_msg("outputSchema.", vec_get(members, mi), 0), vec_get(members, mi + 1), kws, od);
        mi = mi + 2;
    }
    return 0;
}

# 1 when an outputSchema's `$schema`, if it has one, names a dialect bote knows: 2020-12,
# which it judges by, and 2019-09, draft-07 and draft-06, whose keywords bote reads as
# 2020-12's, with a WARN for each it does not judge, draft-07's array `items`,
# `additionalItems` and `dependencies` among them (3.8.2). The official SDK knows these four. "Clients and servers MUST handle
# unsupported dialects gracefully by returning an appropriate error" (the spec's JSON
# Schema usage), so registration refuses another (3.8.1).
fn _reg_dialect_known(os) {
    var d = jsonx_get_raw(os, "$schema");
    if (d == 0) { return 1; }
    var u = jsonx_get_str_dec_a(default_alloc(), os, "$schema");
    if (u == 0) { return 0; }
    var n = strlen(u);
    if (n > 0 && load8(u + n - 1) == 35) { u = _slice_cstr(default_alloc(), u, 0, n - 1); }
    var ok = "https://json-schema.org/draft/2020-12/schema http://json-schema.org/draft/2020-12/schema https://json-schema.org/draft/2019-09/schema http://json-schema.org/draft/2019-09/schema https://json-schema.org/draft-07/schema http://json-schema.org/draft-07/schema https://json-schema.org/draft-06/schema http://json-schema.org/draft-06/schema ";
    var ws = _reg_words(ok);
    var i = 0;
    while (i < vec_len(ws)) {
        if (streq(u, vec_get(ws, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 2025-11-25 allows an outputSchema only with an object at its root, and its
# structuredContent only as an object. What the official SDK shows that revision
# for any other root, and what bote does too: the schema as the one property,
# `result`, of an object, and a result's structuredContent wrapped the same way
# (the dispatcher's _dsp_tool_result_out_a). A root is an object when its `type`
# is "object", as the SDK reads it.
fn _reg_output_root_object(os) {
    var t = jsonx_get_str_dec_a(default_alloc(), os, "type");
    if (t != 0 && streq(t, "object") == 1) { return 1; }
    return 0;
}

# 1 when `$id` in the schema object `v` starts a new base URI, against which the
# references inside it resolve: wrapping it moves none of them. A `$id` that is
# only a fragment ("#item", draft-07's anchor) starts none.
fn _reg_new_base(v) {
    var id = jsonx_get_raw(v, "$id");
    if (id == 0) { return 0; }
    if (load8(id) != 34) { return 1; }
    var s = _jx_str_dec_at_a(default_alloc(), id, strlen(id), 0);
    if (s != 0 && load8(s) == 35) { return 0; }
    return 1;
}

# 1 when `k` is one of the keywords in `ws`, a vec from _reg_words.
fn _reg_kw_in(k, ws) {
    var i = 0;
    while (i < vec_len(ws)) {
        if (streq(k, vec_get(ws, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

var BOTE_RESULT_REF = "{\"$ref\":\"#/properties/result\"}";

# `v`, a part of an outputSchema, into `sb` with every reference to the document
# moved under properties/result. `mode` is 0 where `v` is in a keyword's place, 1
# where it is a map from names to schemas (properties, $defs), and 2 at the root, whose
# `$schema` the wrapper carries too: (3.8.14) the SDK keeps it inside as well, and through
# 3.8.13 bote left it out there. A value that is data (const, enum,
# default, examples) is copied as it is, and so is a subschema that starts a new
# base. The rules are the official SDK's (wrapOutputSchemaForLegacy). `kw` holds
# the two keyword lists, data at +0 and name maps at +8, and at +16 whether a
# `$recursiveRef` is converted.
fn _reg_rw_refs(sb, v, mode, kw) {
    var c = _vp_first_nonws(v);
    if (c == 91) {
        var el = _sch_split_array(v);
        str_builder_add_cstr(sb, "[");
        var j = 0;
        while (j < vec_len(el)) {
            if (j > 0) { str_builder_add_cstr(sb, ","); }
            _reg_rw_refs(sb, vec_get(el, j), 0, kw);
            j = j + 1;
        }
        str_builder_add_cstr(sb, "]");
        return 0;
    }
    if (c != 123 || (mode != 1 && _reg_new_base(v) == 1)) {
        str_builder_add_cstr(sb, v);
        return 0;
    }
    # Each key judged as it decodes and written as it was (3.8.0), so it means what it did.
    var m = _jx_members_raw_a(default_alloc(), v);
    # (3.8.1) A 2019-09 `$recursiveRef: "#"` means the document's root, which wrapping moves:
    # where `kw`'s +16 says so, it becomes a `$ref` to #/properties/result, or an `allOf`
    # entry beside a `$ref` the object already has, as the official SDK does it.
    var has_ref = 0;
    var has_all = 0;
    var conv = 0;
    var p = 0;
    while (p < vec_len(m)) {
        var pk = vec_get(m, p);
        if (pk != 0) {
            if (streq(pk, "$ref") == 1) { has_ref = 1; }
            elif (streq(pk, "allOf") == 1) { has_all = 1; }
            elif (mode != 1 && load64(kw + 16) == 1 && streq(pk, "$recursiveRef") == 1 && _reg_is_hash(vec_get(m, p + 2)) == 1) { conv = 1; }
        }
        p = p + 3;
    }
    str_builder_add_cstr(sb, "{");
    var sep = 0;
    var i = 0;
    while (i < vec_len(m)) {
        var k = vec_get(m, i);
        var kr = vec_get(m, i + 1);
        var val = vec_get(m, i + 2);
        i = i + 3;
        # A key that decodes to hold a NUL names no keyword.
        if (k == 0) { k = ""; }
        if (conv == 1 && streq(k, "$recursiveRef") == 1 && _reg_is_hash(val) == 1) { continue; }
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        sep = 1;
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, kr);
        str_builder_add_cstr(sb, "\":");
        if (mode == 1) {
            _reg_rw_refs(sb, val, 0, kw);
        } elif ((streq(k, "$ref") == 1 || streq(k, "$dynamicRef") == 1) && load8(val) == 34) {
            var r = _jx_str_dec_at_a(default_alloc(), val, strlen(val), 0);
            if (r != 0 && load8(r) == 35 && (load8(r + 1) == 0 || load8(r + 1) == 47)) {
                str_builder_add_cstr(sb, "\"#/properties/result");
                bote_json_escape(sb, r + 1);
                str_builder_add_cstr(sb, "\"");
            } else {
                str_builder_add_cstr(sb, val);
            }
        } elif (conv == 1 && has_ref == 1 && streq(k, "allOf") == 1) {
            if (_vp_first_nonws(val) == 91) {
                _reg_rw_refs(sb, val, 0, kw);
                # The array just written, with the root's reference as its last entry.
                var bl = load64(sb + 8);
                store64(sb + 8, bl - 1);
                if (load8(load64(sb) + bl - 2) != 91) { str_builder_add_cstr(sb, ","); }
                str_builder_add_cstr(sb, BOTE_RESULT_REF);
                str_builder_add_cstr(sb, "]");
            } else {
                str_builder_add_cstr(sb, "[");
                str_builder_add_cstr(sb, BOTE_RESULT_REF);
                str_builder_add_cstr(sb, "]");
            }
        } elif (_reg_kw_in(k, load64(kw)) == 1) {
            str_builder_add_cstr(sb, val);
        } elif (_reg_kw_in(k, load64(kw + 8)) == 1) {
            _reg_rw_refs(sb, val, 1, kw);
        } else {
            _reg_rw_refs(sb, val, 0, kw);
        }
    }
    if (conv == 1 && has_ref == 0) {
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"$ref\":\"#/properties/result\"");
    } elif (conv == 1 && has_all == 0) {
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"allOf\":[");
        str_builder_add_cstr(sb, BOTE_RESULT_REF);
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, "}");
    return 0;
}

# 1 when the raw JSON value `v` is the string "#", however it is spelled.
fn _reg_is_hash(v) {
    if (load8(v) != 34) { return 0; }
    var s = _jx_str_dec_at_a(default_alloc(), v, strlen(v), 0);
    if (s != 0 && streq(s, "#") == 1) { return 1; }
    return 0;
}

# 1 when the schema `os` declares JSON Schema 2019-09 and its root sets no
# `$recursiveAnchor: true`: the SDK's test for converting `$recursiveRef`.
fn _reg_converts_recursive(os) {
    var u = jsonx_get_str_dec_a(default_alloc(), os, "$schema");
    if (u == 0) { return 0; }
    var n = strlen(u);
    if (n > 0 && load8(u + n - 1) == 35) { u = _slice_cstr(default_alloc(), u, 0, n - 1); }
    if (streq(u, "https://json-schema.org/draft/2019-09/schema") == 0 && streq(u, "http://json-schema.org/draft/2019-09/schema") == 0) { return 0; }
    var ra = jsonx_get_raw(os, "$recursiveAnchor");
    if (ra != 0 && streq(ra, "true") == 1) { return 0; }
    return 1;
}

# What 2025-11-25 is shown for an outputSchema whose root is not an object.
fn _reg_output_legacy(os) {
    var kw[24];
    store64(&kw, _reg_words("const enum default examples "));
    store64(&kw + 8, _reg_words("properties patternProperties $defs definitions dependentSchemas dependencies "));
    store64(&kw + 16, _reg_converts_recursive(os));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    var sch = jsonx_get_raw(os, "$schema");
    if (sch != 0) {
        str_builder_add_cstr(sb, "\"$schema\":");
        str_builder_add_cstr(sb, sch);
        str_builder_add_cstr(sb, ",");
    }
    str_builder_add_cstr(sb, "\"type\":\"object\",\"properties\":{\"result\":");
    _reg_rw_refs(sb, os, 2, &kw);
    str_builder_add_cstr(sb, "},\"required\":[\"result\"]}");
    return str_data(str_builder_build(sb));
}

# An outputSchema as registration keeps it (3.8.0): on one line, as everything bote
# sends must be, compiled, and with its 2025-11-25 form when its root is no object.
# Outside JSON's strings, which cannot hold either, a CR or LF is only spacing.
fn _reg_prepare_output(tool_def, st) {
    var os = tool_def_output_schema(tool_def);
    if (os == 0) { return 0; }
    os = _reg_own_line(os);
    store64(st + 8, os);
    store64(st + 16, parse_property(os));
    if (_reg_output_root_object(os) == 0) { store64(st + 24, _reg_output_legacy(os)); }
    _reg_warn_output(tool_def);
    return 0;
}

# The inputSchema as tools/list sends it, on one line (3.8.3): its JSON as written, or the
# ToolSchema's fields written out. A property's schema is kept as the consumer wrote it,
# and one pretty-printed put a raw line feed in the list, which ends the message on stdio
# and the Unix transport; through 3.8.2 the list was built from the fields every time.
fn _reg_input_json(schema) {
    var js = tool_schema_json(schema);
    if (js == 0) {
        var sb = str_builder_new();
        _emit_schema(sb, schema);
        js = str_data(str_builder_build(sb));
    }
    return _reg_own_line(js);
}

# `s` on one line, as registration's own copy (3.8.4): _dsp_one_line gives back what it is
# handed when it holds no CR or LF, and through 3.8.3 the list then wrote the consumer's
# buffer, which a byte written into it after registration changed, a raw LF among them.
fn _reg_own_line(s) {
    var o = _dsp_one_line(default_alloc(), s);
    if (o == s) { o = _slice_cstr(default_alloc(), s, 0, strlen(s)); }
    return o;
}

# What registration does before it touches the registry: refuses a malformed definition
# (a BoteError), compiles its schema and reads its headers. 0 when it may be added.
# What it makes for the definition goes in `st` (72 bytes), and _registry_add_u stores it
# under the registries' lock (3.8.2), so a list beside the registration of a definition
# already listed reads it once: +0 the headers, +8 the outputSchema on one line, +16 its
# compiled form, +24 its legacy form, +32 the display fragment, +40 1 when there is an
# outputSchema, +48 the inputSchema as it is listed (3.8.3), +56 the compiled input schema and
# +64 1 when registration compiled it (3.8.4). At 3.8.1 each was stored here, with nothing held,
# between a list's sizing pass and its writing pass.
fn _registry_prepare(tool_def, st) {
    var why = registry_check_tool_def(tool_def);
    if (why != 0) {
        _reg_log_refused(tool_def, why);
        var tn = "";
        if (tool_def != 0 && _reg_name_ok(tool_def_name(tool_def)) == 1) { tn = tool_def_name(tool_def); }
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, tn, why);
    }
    memset(st, 0, 72);
    # (3.8.4) Compiled each registration unless the consumer attached its own: through 3.8.3 a
    # definition registered again kept its first compile, and was listed with its new schema
    # and judged by the old. Staged with the rest, under the lock.
    store64(st + 56, tool_def_compiled(tool_def));
    if (tool_def_compiled(tool_def) == 0 || load64(tool_def + 136) == 1) {
        store64(st + 56, compiled_compile(tool_def_input_schema(tool_def)));
        store64(st + 64, 1);
    }
    var headers = vec_new();
    _reg_scan_tool(tool_def, headers);
    if (vec_len(headers) > 0) { store64(st, headers); }
    _reg_warn_unenforced(tool_def);
    if (tool_def_output_schema(tool_def) != 0) { store64(st + 40, 1); }
    _reg_prepare_output(tool_def, st);
    store64(st + 32, _bote_display_json(tool_def_title(tool_def), tool_def_icons(tool_def)));
    store64(st + 48, _reg_input_json(tool_def_input_schema(tool_def)));
    return 0;
}

# Store in `tool_def` what _registry_prepare made in `st`. The compiled outputSchema and its
# 2025-11-25 form are stored whether there is one or not (3.8.3): a definition registered
# again with its outputSchema taken away kept both through 3.8.2, and a call was refused by
# the schema tools/list no longer showed.
fn _registry_stage(tool_def, st) {
    # The headers whether there are any or not (3.8.4): one taken away kept being required.
    store64(tool_def + 64, load64(st));
    store64(tool_def + 48, load64(st + 56));
    store64(tool_def + 136, load64(st + 64));
    # (3.8.5) The listed form in a slot of registration's own: through 3.8.4 it went in +80,
    # which tool_def_with_output_schema sets, so a setter called after registration sent its
    # bytes unchecked, a raw LF or no JSON at all, until the next registration.
    store64(tool_def + 144, load64(st + 8));
    store64(tool_def + 88, load64(st + 16));
    store64(tool_def + 96, load64(st + 24));
    store64(tool_def + 120, load64(st + 32));
    store64(tool_def + 128, load64(st + 48));
    return 0;
}

# Add a definition _registry_prepare made `st` for, with the registries' lock held to
# write (3.7.1).
fn _registry_add_u(r, tool_def, st) {
    _registry_stage(tool_def, st);
    var name = tool_def_name(tool_def);
    var entries = registry_entries(r);
    var names = registry_names(r);
    if (map_has(entries, name) == 0) {
        vec_push(names, name);
    }
    map_set(entries, name, tool_def);

    var ver = tool_def_version(tool_def);
    if (ver != 0) {
        var vmap = registry_versions_map(r);
        var bucket = map_get(vmap, name);
        if (bucket == 0) {
            bucket = vec_new();
            map_set(vmap, name, bucket);
        }
        vec_push(bucket, tool_def);
    }
    return 0;
}

fn registry_register(r, tool_def) {
    var st[72];
    var err = _registry_prepare(tool_def, &st);
    if (err != 0) { return err; }
    bote_reg_write();
    _registry_add_u(r, tool_def, &st);
    bote_reg_write_end();
    return 0;
}

fn _registry_get_u(r, name) { return map_get(registry_entries(r), name); }

fn registry_get(r, name) {
    bote_reg_read();
    var t = _registry_get_u(r, name);
    bote_reg_read_end();
    return t;
}

fn registry_contains(r, name) {
    bote_reg_read();
    var h = map_has(registry_entries(r), name);
    bote_reg_read_end();
    return h;
}

fn registry_len(r) {
    bote_reg_read();
    var n = map_count(registry_entries(r));
    bote_reg_read_end();
    return n;
}

fn registry_is_empty(r) {
    if (registry_len(r) == 0) { return 1; }
    return 0;
}

# Return a vec of ToolDef pointers in insertion order.
fn registry_list(r) {
    var out = vec_new();
    bote_reg_read();
    var names = registry_names(r);
    var entries = registry_entries(r);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        var name = vec_get(names, i);
        if (map_has(entries, name) == 1) {
            vec_push(out, map_get(entries, name));
        }
        i = i + 1;
    }
    bote_reg_read_end();
    return out;
}

fn registry_get_versioned(r, name, version) {
    bote_reg_read();
    var t = _registry_get_versioned_u(r, name, version);
    bote_reg_read_end();
    return t;
}

fn _registry_get_versioned_u(r, name, version) {
    var bucket = map_get(registry_versions_map(r), name);
    if (bucket == 0) { return 0; }
    var n = vec_len(bucket);
    var i = 0;
    while (i < n) {
        var t = vec_get(bucket, i);
        var v = tool_def_version(t);
        if (v != 0 && streq(v, version) == 1) { return t; }
        i = i + 1;
    }
    return 0;
}

# The vec of a tool's versions: the registry's own, which a registration that runs beside
# a read may grow (3.7.1).
fn registry_list_versions(r, name) {
    bote_reg_read();
    var bucket = map_get(registry_versions_map(r), name);
    bote_reg_read_end();
    if (bucket == 0) { return vec_new(); }
    return bucket;
}

# Remove a tool. Returns the removed ToolDef ptr or 0 if absent.
fn registry_deregister(r, name) {
    bote_reg_write();
    var t = _registry_deregister_u(r, name);
    bote_reg_write_end();
    return t;
}

fn _registry_deregister_u(r, name) {
    var entries = registry_entries(r);
    var existing = map_get(entries, name);
    if (existing == 0) { return 0; }
    map_delete(entries, name);
    map_delete(registry_versions_map(r), name);
    # Compact the names vec.
    var names = registry_names(r);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(names, i), name) == 1) {
            vec_remove(names, i);
            i = n;
        }
        i = i + 1;
    }
    return existing;
}

# Mark a tool deprecated with a message. No-op if tool absent. A write (3.7.2): a list
# built beside it sized the reply without the message and then wrote it in.
fn registry_deprecate(r, name, message) {
    bote_reg_write();
    var t = _registry_get_u(r, name);
    if (t != 0) { tool_def_with_deprecated(t, message); }
    bote_reg_write_end();
    return 0;
}

# ================================================================
# validate_params
# ================================================================
#
# Returns 0 on success, or a BoteError ptr on failure.
# Caller checks `bote_err_tag(err)` for the specific failure mode.

# Trim leading whitespace; return first non-ws byte (0 if EOS).
fn _vp_first_nonws(s) {
    if (s == 0) { return 0; }
    var i = 0;
    while (1 == 1) {
        var c = load8(s + i);
        if (c == 0) { return 0; }
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return c; }
    }
    return 0;
}

fn registry_validate_params(r, name, params_cstr) {
    # (3.8.8, from the 3.8.7 review) Judged on the heap forms' scratch, and only the answer
    # copied out: on the heap itself every table and copy a walk makes was kept.
    var m[16];
    var a = _sch_scratch_take(&m);
    var e = registry_validate_params_a(a, r, name, params_cstr);
    var out = 0;
    if (e != 0) {
        out = alloc(32);
        store64(out, bote_err_tag(e));
        store64(out + 8, _sch_heap_str(bote_err_tool(e)));
        store64(out + 16, _sch_heap_str(bote_err_reason(e)));
        store64(out + 24, 0);
        if (bote_err_violations(e) != 0) { store64(out + 24, _sch_heap_strs(bote_err_violations(e))); }
    }
    _sch_scratch_give(&m);
    return out;
}

# registry_validate_params with the error and its text on `a`.
fn registry_validate_params_a(a, r, name, params_cstr) {
    return registry_validate_def_a(a, registry_get(r, name), name, params_cstr);
}

# registry_validate_params_a against `t`, the definition the caller found for `name`, or 0
# when it found none (3.7.2): a call judged by what one look at the registry found cannot
# be validated by a definition registered since.
fn registry_validate_def_a(a, t, name, params_cstr) {
    if (t == 0) {
        return bote_err_new_a(a, BOTE_ERR_TOOL_NOT_FOUND, name, 0);
    }

    # 1. params must be a JSON object.
    if (_vp_first_nonws(params_cstr) != 123) {
        return bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, name, "params must be an object");
    }

    # 2. Compiled schema path (preferred — full type/enum/bounds/nested checks).
    var compiled = tool_def_compiled(t);
    if (compiled != 0) {
        var violations = compiled_check_a(a, compiled, params_cstr);
        if (violations != 0) {
            return bote_err_with_violations_a(a, BOTE_ERR_SCHEMA_VIOLATION, name, violations);
        }
        return 0;
    }

    # 3. Fallback: required-field-present check. Unreachable for a definition
    # registry_register accepted (it compiles one); kept for a ToolDef placed
    # in the registry by other means. jsonx_has, not bayan's flat parser, which
    # refuses a whole object over a repeated key: RFC 8259 allows one, and the
    # field is there.
    var schema = tool_def_input_schema(t);
    var required = schema_required(schema);
    if (required == 0) { return 0; }
    var nreq = vec_len(required);
    if (nreq == 0) { return 0; }

    var i = 0;
    while (i < nreq) {
        var req_key = vec_get(required, i);
        if (jsonx_has(params_cstr, req_key) == 0) {
            var sb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, sb, "missing required field: ");
            str_builder_add_cstr_a(a, sb, req_key);
            var msg = str_builder_build_a(a, sb);
            return bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, name, str_data(msg));
        }
        i = i + 1;
    }
    return 0;
}

# --- prompts.cyr ---

# bote::prompts — MCP prompts capability (prompts/list + prompts/get)
#
# Mirrors the tool registry (src/registry.cyr): a PromptRegistry holds
# prompt metadata (for prompts/list) plus a name→handler map (for
# prompts/get generation). The dispatcher owns an optional PromptRegistry;
# the `prompts` capability is advertised at initialize iff one is present
# (see src/dispatch.cyr _build_capabilities). JSON serialization lives in
# dispatch.cyr alongside the other MCP method builders.
#
# Prompt handler ABI (mirrors the 2.0 tool ABI):
#   fn h(arguments_cstr, claims) → result_cstr
# where `arguments_cstr` is the prompts/get `arguments` object (JSON) and
# the returned cstr is the full prompts/get result body, e.g.
#   {"description":"...","messages":[{"role":"user","content":{...}}]}
#
# Requires (entry point includes, before this module): hashmap (pulled by
# src/registry.cyr), vec, str, string. No local includes — matches dispatch.

# ================================================================
# PromptArgument — one declared argument (surfaced in prompts/list)
# ================================================================
#
# Layout (40 bytes):
#   +0  name        cstr
#   +8  description cstr or 0
#   +16 required    i64 (0 = optional, 1 = required)
#   +24 title       cstr or 0 (3.8.1)
#   +32 display     cstr or 0: the title as prompts/list sends it, built at registration

fn prompt_arg_new(name, description, required) {
    var a = alloc(40);
    store64(a, name);
    store64(a + 8, description);
    store64(a + 16, required);
    store64(a + 24, 0);
    store64(a + 32, 0);
    return a;
}

fn prompt_arg_name(a) { return load64(a); }
fn prompt_arg_description(a) { return load64(a + 8); }
fn prompt_arg_required(a) { return load64(a + 16); }
fn prompt_arg_title(a) { return load64(a + 24); }
fn prompt_arg_display(a) { return load64(a + 32); }

# A title for people (3.8.1). Checked at registration, and sent as it was then.
fn prompt_arg_with_title(a, title) { store64(a + 24, title); return a; }

# ================================================================
# PromptDef — prompt metadata
# ================================================================
#
# Layout (56 bytes):
#   +0  name            cstr
#   +8  description     cstr or 0
#   +16 arguments       vec of PromptArgument ptrs or 0
#   +24 required_scopes vec of cstr or 0: all of them, for a token to get this prompt
#   +32 title           cstr or 0 (3.8.1)
#   +40 icons           vec of Icon or 0 (3.8.1, src/jsonx.cyr)
#   +48 display         cstr or 0: the title and icons as prompts/list sends them

fn prompt_def_new(name, description, arguments) {
    var p = alloc(56);
    store64(p, name);
    store64(p + 8, description);
    store64(p + 16, arguments);
    store64(p + 24, 0);
    store64(p + 32, 0);
    store64(p + 40, 0);
    store64(p + 48, 0);
    return p;
}

# A title for people and icons (3.8.1). Both are checked at registration, and sent as
# they were then.
fn prompt_def_with_title(p, title) { store64(p + 32, title); return p; }
fn prompt_def_with_icons(p, icons) { store64(p + 40, icons); return p; }
fn prompt_def_title(p) { return load64(p + 32); }
fn prompt_def_icons(p) { return load64(p + 40); }
fn prompt_def_display(p) { return load64(p + 48); }

# Why the prompt's title and icons cannot be sent, or 0. An argument has a title only,
# which any string may be (3.8.2).
fn prompt_display_check(p) {
    return bote_display_check(prompt_def_title(p), prompt_def_icons(p));
}

# The prompt's and its arguments' title and icons as prompts/list sends them, kept.
fn _prompt_display_build(p) {
    var frags = vec_new();
    vec_push(frags, _bote_display_json(prompt_def_title(p), prompt_def_icons(p)));
    var args = prompt_def_arguments(p);
    if (args != 0) {
        var i = 0;
        while (i < vec_len(args)) {
            vec_push(frags, _bote_display_json(prompt_arg_title(vec_get(args, i)), 0));
            i = i + 1;
        }
    }
    return frags;
}

# The fragments _prompt_display_build made, stored, with the registries' lock held to
# write (3.8.2).
fn _prompt_display_store(p, frags) {
    store64(p + 48, vec_get(frags, 0));
    var args = prompt_def_arguments(p);
    var i = 0;
    while (args != 0 && i < vec_len(args) && i + 1 < vec_len(frags)) {
        store64(vec_get(args, i) + 32, vec_get(frags, i + 1));
        i = i + 1;
    }
    return 0;
}

fn prompt_def_name(p) { return load64(p); }
fn prompt_def_description(p) { return load64(p + 8); }
fn prompt_def_arguments(p) { return load64(p + 16); }
fn prompt_def_required_scopes(p) { return load64(p + 24); }

# What a token must hold to get this prompt, or to complete its arguments: a vec of
# RFC 6749 scope-tokens, all of them. Returns `p`.
fn prompt_def_with_required_scopes(p, scopes) { store64(p + 24, scopes); return p; }

# ================================================================
# PromptRegistry
# ================================================================
#
# Layout (24 bytes):
#   +0  entries  hashmap: name_cstr -> PromptDef ptr
#   +8  names    vec of name_cstr (insertion order, for list())
#   +16 handlers hashmap: name_cstr -> handler fn ptr

fn prompt_registry_new() {
    var r = alloc(24);
    store64(r, map_new());
    store64(r + 8, vec_new());
    store64(r + 16, map_new());
    return r;
}

fn prompt_registry_entries(r) { return load64(r); }
fn prompt_registry_names(r) { return load64(r + 8); }
fn prompt_registry_handlers(r) { return load64(r + 16); }

# Register (or replace) a prompt + its generator handler. Returns 0, or -1 with nothing
# registered when a required scope is no scope-token: it would go out in a 403's header,
# or (3.8.1) a title or an icon is not what the spec says.
fn prompt_registry_register(r, prompt_def, handler_fp) {
    if (bote_scope_list_ok(prompt_def_required_scopes(prompt_def)) == 0) { return 0 - 1; }
    if (prompt_display_check(prompt_def) != 0) { return 0 - 1; }
    var frags = _prompt_display_build(prompt_def);
    var name = prompt_def_name(prompt_def);
    # Under the registries' lock (3.7.1, src/protocol.cyr), as every function below; the
    # fragments too (3.8.2), which a list reads in two passes.
    bote_reg_write();
    _prompt_display_store(prompt_def, frags);
    var entries = prompt_registry_entries(r);
    if (map_has(entries, name) == 0) {
        vec_push(prompt_registry_names(r), name);
    }
    map_set(entries, name, prompt_def);
    map_set(prompt_registry_handlers(r), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn _prompt_registry_get_u(r, name) { return map_get(prompt_registry_entries(r), name); }

fn prompt_registry_get(r, name) {
    bote_reg_read();
    var p = _prompt_registry_get_u(r, name);
    bote_reg_read_end();
    return p;
}

fn prompt_registry_contains(r, name) {
    bote_reg_read();
    var h = map_has(prompt_registry_entries(r), name);
    bote_reg_read_end();
    return h;
}

# The prompt `name`, or 0, and its handler through *fp_out, 0 when it has none, from one
# look at the registry (3.7.2): what prompts/get judges and what serves it are then the
# same registration, whatever replaces it meanwhile.
fn prompt_registry_serving(r, name, fp_out) {
    bote_reg_read();
    var p = _prompt_registry_get_u(r, name);
    var fp = 0;
    if (map_has(prompt_registry_handlers(r), name) == 1) { fp = map_get(prompt_registry_handlers(r), name); }
    bote_reg_read_end();
    store64(fp_out, fp);
    return p;
}

# Handler fn ptr for `name`, or 0 if the prompt is unknown.
fn prompt_registry_handler(r, name) {
    bote_reg_read();
    var fp = 0;
    if (map_has(prompt_registry_handlers(r), name) == 1) { fp = map_get(prompt_registry_handlers(r), name); }
    bote_reg_read_end();
    return fp;
}

fn prompt_registry_len(r) {
    bote_reg_read();
    var n = map_count(prompt_registry_entries(r));
    bote_reg_read_end();
    return n;
}

# Return a vec of PromptDef pointers in insertion order.
fn prompt_registry_list(r) {
    var out = vec_new();
    bote_reg_read();
    var names = prompt_registry_names(r);
    var entries = prompt_registry_entries(r);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        var name = vec_get(names, i);
        if (map_has(entries, name) == 1) {
            vec_push(out, map_get(entries, name));
        }
        i = i + 1;
    }
    bote_reg_read_end();
    return out;
}

# --- resources.cyr ---

# bote::resources — MCP resources capability (resources/list + resources/read)
#
# Mirrors src/prompts.cyr: a ResourceRegistry holds resource metadata (for
# resources/list) plus a uri→handler map (for resources/read). The
# dispatcher owns an optional ResourceRegistry; the `resources` capability
# is advertised at initialize iff one is present (see src/dispatch.cyr
# _build_capabilities). JSON serialization for the listing lives in
# dispatch.cyr; read bodies are produced by the handler.
#
# Resource read-handler ABI (mirrors the 2.0 tool ABI):
#   fn h(uri_cstr, claims) → result_cstr
# where `uri_cstr` is the requested resource URI and the returned cstr is
# the full resources/read result body, e.g.
#   {"contents":[{"uri":"...","mimeType":"...","text":"..."}]}
# (MCP ResourceContents — bare uri/mimeType/text|blob, NOT a content block).
#
# A URI no resource has goes to the first ResourceTemplate it matches, whose
# handler has the same ABI. An exact resource always wins.
#
# subscribe / listChanged are intentionally out until a server→client push
# path exists (they need the notification channel that is not yet wired).
#
# Requires (entry point includes, before this module): hashmap (pulled by
# src/registry.cyr), vec, str, string. No local includes — matches dispatch.

# ================================================================
# ResourceDef — resource metadata (surfaced in resources/list)
# ================================================================
#
# Layout (64 bytes):
#   +0  uri             cstr
#   +8  name            cstr
#   +16 description     cstr or 0
#   +24 mime_type       cstr or 0
#   +32 required_scopes vec of cstr or 0: all of them, for a token to read this resource
#   +40 title           cstr or 0 (3.8.1)
#   +48 icons           vec of Icon or 0 (3.8.1, src/jsonx.cyr)
#   +56 display         cstr or 0: the title and icons as resources/list sends them

fn resource_def_new(uri, name, description, mime_type) {
    var r = alloc(64);
    store64(r, uri);
    store64(r + 8, name);
    store64(r + 16, description);
    store64(r + 24, mime_type);
    store64(r + 32, 0);
    store64(r + 40, 0);
    store64(r + 48, 0);
    store64(r + 56, 0);
    return r;
}

# A title for people and icons (3.8.1). Both are checked at registration, and sent as
# they were then.
fn resource_def_with_title(r, title) { store64(r + 40, title); return r; }
fn resource_def_with_icons(r, icons) { store64(r + 48, icons); return r; }
fn resource_def_title(r) { return load64(r + 40); }
fn resource_def_icons(r) { return load64(r + 48); }
fn resource_def_display(r) { return load64(r + 56); }

fn resource_def_uri(r) { return load64(r); }
fn resource_def_name(r) { return load64(r + 8); }
fn resource_def_description(r) { return load64(r + 16); }
fn resource_def_mime_type(r) { return load64(r + 24); }
fn resource_def_required_scopes(r) { return load64(r + 32); }

# What a token must hold to read this resource: a vec of RFC 6749 scope-tokens, all of
# them. Returns `r`.
fn resource_def_with_required_scopes(r, scopes) { store64(r + 32, scopes); return r; }

# ================================================================
# ResourceTemplate — a family of resources behind one URI template
# ================================================================
#
# Layout (48 bytes):
#   +0  uri_template    cstr, literal text and `{name}` expressions
#   +8  name            cstr
#   +16 description     cstr or 0
#   +24 mime_type       cstr or 0
#   +32 handler         fn ptr, set at registration
#   +40 required_scopes vec of cstr or 0: all of them, to read a URI it serves or complete
#                       its variables
#
# RFC 6570 level 1: a `{name}` stands for one non-empty value holding none of
# `/`, `?` or `#`, which that level percent-encodes. The operators of the higher
# levels are refused, not read as text. Two expressions in one path segment are
# refused too: one value per segment keeps a match linear in the URI, which a client
# writes, where two could make it quadratic. A handler gets the URI as sent, reads
# the value with resource_template_var_a and owns its percent-decoding.

# Layout (72 bytes): +0 uri_template, +8 name, +16 description, +24 mime_type, +32 the
# handler (set at registration), +40 required_scopes, and (3.8.1) +48 title, +56 icons,
# +64 display, as a ResourceDef's.
fn resource_template_new(uri_template, name, description, mime_type) {
    var t = alloc(72);
    store64(t, uri_template);
    store64(t + 8, name);
    store64(t + 16, description);
    store64(t + 24, mime_type);
    store64(t + 32, 0);
    store64(t + 40, 0);
    store64(t + 48, 0);
    store64(t + 56, 0);
    store64(t + 64, 0);
    return t;
}

fn resource_template_with_title(t, title) { store64(t + 48, title); return t; }
fn resource_template_with_icons(t, icons) { store64(t + 56, icons); return t; }
fn resource_template_title(t) { return load64(t + 48); }
fn resource_template_icons(t) { return load64(t + 56); }
fn resource_template_display(t) { return load64(t + 64); }

fn resource_template_uri(t) { return load64(t); }
fn resource_template_name(t) { return load64(t + 8); }
fn resource_template_description(t) { return load64(t + 16); }
fn resource_template_mime_type(t) { return load64(t + 24); }
fn resource_template_handler(t) { return load64(t + 32); }
fn resource_template_required_scopes(t) { return load64(t + 40); }

# What a token must hold to read a URI this template serves, or to complete its
# variables: a vec of RFC 6749 scope-tokens, all of them. Returns `t`.
fn resource_template_with_required_scopes(t, scopes) { store64(t + 40, scopes); return t; }

fn _rt_delim(c) {
    if (c == 47 || c == 63 || c == 35) { return 1; }
    return 0;
}

fn _rt_name_char(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

# 1 when the expression at tpl[i], whose name is n bytes, repeats one ahead of it.
fn _rt_repeated(tpl, i, n) {
    var k = 0;
    while (k < i) {
        if (load8(tpl + k) == 123 && load8(tpl + k + n + 1) == 125 && memeq(tpl + k + 1, tpl + i + 1, n) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

# Why `tpl` cannot be a template, as a message, or 0 when it can. `}` closes what
# `{` opened, a name is letters, digits and `_`, and there is one expression at least,
# at most one in a segment, and one of a name: RFC 6570 gives a repeat the same value,
# and a match would have to compare them.
fn resource_template_check(tpl) {
    if (tpl == 0) { return "a template needs a uriTemplate"; }
    var i = 0;
    var total = 0;
    var seg = 0;
    while (load8(tpl + i) != 0) {
        var c = load8(tpl + i);
        if (c == 125) { return "a template has a `}` with no `{`"; }
        if (_rt_delim(c) == 1) { seg = 0; }
        if (c == 123) {
            seg = seg + 1;
            total = total + 1;
            if (seg > 1) { return "a template segment holds one expression at most"; }
            var n = i + 1;
            while (_rt_name_char(load8(tpl + n)) == 1) { n = n + 1; }
            if (n == i + 1 || load8(tpl + n) != 125) {
                return "a template expression must be `{name}`: bote serves RFC 6570 level 1";
            }
            if (_rt_repeated(tpl, i, n - i - 1) == 1) { return "a template names an expression once"; }
            i = n;
        }
        i = i + 1;
    }
    if (total == 0) { return "a template has no expression: register it as a resource"; }
    return 0;
}

# Match tpl[t...] against uri[u...]. With `want` set, the value of that expression
# goes to out, as an offset into uri and a length. Literal bytes are walked here, and
# only an expression recurses, once for each it holds, which is fixed by the template.
fn _rt_match(tpl, t, uri, u, want, out) {
    while (1 == 1) {
        var c = load8(tpl + t);
        if (c == 123) {
            var close = t + 1;
            while (load8(tpl + close) != 125) { close = close + 1; }
            var end = u;
            while (load8(uri + end) != 0 && _rt_delim(load8(uri + end)) == 0) { end = end + 1; }
            # The longest value that leaves the rest of the template matching.
            while (end > u) {
                if (_rt_match(tpl, close + 1, uri, end, want, out) == 1) {
                    if (want != 0 && strlen(want) == close - t - 1 && memeq(want, tpl + t + 1, close - t - 1) == 1) {
                        store64(out, u);
                        store64(out + 8, end - u);
                    }
                    return 1;
                }
                end = end - 1;
            }
            return 0;
        }
        if (c != load8(uri + u)) { return 0; }
        if (c == 0) { return 1; }
        t = t + 1;
        u = u + 1;
    }
    return 0;
}

# 1 when `uri` is what the valid template `tpl` expands to, for some values.
fn resource_template_matches(tpl, uri) {
    if (tpl == 0 || uri == 0) { return 0; }
    return _rt_match(tpl, 0, uri, 0, 0, 0);
}

# The value `uri` gives the expression `name` of `tpl`, as sent, on `a`. 0 when the
# URI does not match or the template has no such expression.
fn resource_template_var_a(a, tpl, uri, name) {
    if (tpl == 0 || uri == 0 || name == 0) { return 0; }
    var span[16];
    store64(&span, 0 - 1);
    store64(&span + 8, 0);
    if (_rt_match(tpl, 0, uri, 0, name, &span) == 0 || load64(&span) < 0) { return 0; }
    var n = load64(&span + 8);
    var out = alloc_via(a, n + 1);
    memcpy(out, uri + load64(&span), n);
    store8(out + n, 0);
    return out;
}

# ================================================================
# ResourceRegistry
# ================================================================
#
# Layout (32 bytes):
#   +0  entries   hashmap: uri_cstr -> ResourceDef ptr
#   +8  uris      vec of uri_cstr (insertion order, for list())
#   +16 handlers  hashmap: uri_cstr -> handler fn ptr
#   +24 templates vec of ResourceTemplate (insertion order)

fn resource_registry_new() {
    var r = alloc(32);
    store64(r, map_new());
    store64(r + 8, vec_new());
    store64(r + 16, map_new());
    store64(r + 24, vec_new());
    return r;
}

fn resource_registry_entries(r) { return load64(r); }
fn resource_registry_uris(r) { return load64(r + 8); }
fn resource_registry_handlers(r) { return load64(r + 16); }
fn resource_registry_templates(r) { return load64(r + 24); }

# Register (or replace) a resource + its read handler. Returns 0, or -1 with nothing
# registered when a required scope is no scope-token: it would go out in a 403's header,
# or (3.8.1) its title or an icon is not what the spec says.
fn resource_registry_register(r, resource_def, handler_fp) {
    if (bote_scope_list_ok(resource_def_required_scopes(resource_def)) == 0) { return 0 - 1; }
    if (bote_display_check(resource_def_title(resource_def), resource_def_icons(resource_def)) != 0) { return 0 - 1; }
    var disp = _bote_display_json(resource_def_title(resource_def), resource_def_icons(resource_def));
    var uri = resource_def_uri(resource_def);
    # Under the registries' lock (3.7.1, src/protocol.cyr), as every function below; the
    # fragment too (3.8.2), which a list reads in two passes.
    bote_reg_write();
    store64(resource_def + 56, disp);
    var entries = resource_registry_entries(r);
    if (map_has(entries, uri) == 0) {
        vec_push(resource_registry_uris(r), uri);
    }
    map_set(entries, uri, resource_def);
    map_set(resource_registry_handlers(r), uri, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn _resource_registry_get_u(r, uri) { return map_get(resource_registry_entries(r), uri); }

fn resource_registry_get(r, uri) {
    bote_reg_read();
    var d = _resource_registry_get_u(r, uri);
    bote_reg_read_end();
    return d;
}

fn resource_registry_contains(r, uri) {
    bote_reg_read();
    var h = map_has(resource_registry_entries(r), uri);
    bote_reg_read_end();
    return h;
}

# Read-handler fn ptr for `uri`, or 0 if the resource is unknown.
fn resource_registry_handler(r, uri) {
    bote_reg_read();
    var fp = 0;
    if (map_has(resource_registry_handlers(r), uri) == 1) { fp = map_get(resource_registry_handlers(r), uri); }
    bote_reg_read_end();
    return fp;
}

# Register (or replace, by uriTemplate) a template + its read handler. Returns 0, or -1
# with nothing registered when a required scope is no scope-token, or (3.8.1) its title
# or an icon is not what the spec says.
fn resource_registry_register_template(r, template, handler_fp) {
    if (bote_scope_list_ok(resource_template_required_scopes(template)) == 0) { return 0 - 1; }
    if (bote_display_check(resource_template_title(template), resource_template_icons(template)) != 0) { return 0 - 1; }
    var disp = _bote_display_json(resource_template_title(template), resource_template_icons(template));
    bote_reg_write();
    store64(template + 64, disp);
    store64(template + 32, handler_fp);
    var ts = resource_registry_templates(r);
    var i = 0;
    var placed = 0;
    while (i < vec_len(ts) && placed == 0) {
        if (streq(resource_template_uri(vec_get(ts, i)), resource_template_uri(template)) == 1) {
            vec_set(ts, i, template);
            placed = 1;
        }
        i = i + 1;
    }
    if (placed == 0) { vec_push(ts, template); }
    bote_reg_write_end();
    return 0;
}

# The first template `uri` matches, which is the one that serves it, or 0.
fn resource_registry_template_for(r, uri) {
    bote_reg_read();
    var t = _resource_registry_template_for_u(r, uri);
    bote_reg_read_end();
    return t;
}

fn _resource_registry_template_for_u(r, uri) {
    var ts = resource_registry_templates(r);
    var i = 0;
    while (i < vec_len(ts)) {
        var t = vec_get(ts, i);
        if (resource_template_matches(resource_template_uri(t), uri) == 1) { return t; }
        i = i + 1;
    }
    return 0;
}

# The template whose uriTemplate is `tpl` exactly, or 0: what a completion names.
fn resource_registry_template_named(r, tpl) {
    bote_reg_read();
    var ts = resource_registry_templates(r);
    var found = 0;
    var i = 0;
    while (i < vec_len(ts) && found == 0) {
        if (streq(resource_template_uri(vec_get(ts, i)), tpl) == 1) { found = vec_get(ts, i); }
        i = i + 1;
    }
    bote_reg_read_end();
    return found;
}

# What serves `uri`, from one look at the registry (3.7.2): the handler through *fp_out,
# and the scopes it requires, or 0 for none. That is the resource registered at `uri` when
# it has a handler, else the first template `uri` matches; *fp_out is 0 for neither. What
# resources/read judges and what serves it are then the same registration.
fn resource_registry_serving(r, uri, fp_out) {
    bote_reg_read();
    var fp = 0;
    var scopes = 0;
    if (map_has(resource_registry_handlers(r), uri) == 1) { fp = map_get(resource_registry_handlers(r), uri); }
    if (fp != 0) {
        scopes = resource_def_required_scopes(_resource_registry_get_u(r, uri));
    } else {
        var t = _resource_registry_template_for_u(r, uri);
        if (t != 0) {
            fp = resource_template_handler(t);
            scopes = resource_template_required_scopes(t);
        }
    }
    bote_reg_read_end();
    store64(fp_out, fp);
    return scopes;
}

# Read-handler fn ptr of the first template `uri` matches, or 0.
fn resource_registry_template_handler(r, uri) {
    var t = resource_registry_template_for(r, uri);
    if (t == 0) { return 0; }
    return resource_template_handler(t);
}

fn resource_registry_len(r) {
    bote_reg_read();
    var n = map_count(resource_registry_entries(r));
    bote_reg_read_end();
    return n;
}

# Return a vec of ResourceDef pointers in insertion order.
fn resource_registry_list(r) {
    var out = vec_new();
    bote_reg_read();
    var uris = resource_registry_uris(r);
    var entries = resource_registry_entries(r);
    var n = vec_len(uris);
    var i = 0;
    while (i < n) {
        var uri = vec_get(uris, i);
        if (map_has(entries, uri) == 1) {
            vec_push(out, map_get(entries, uri));
        }
        i = i + 1;
    }
    bote_reg_read_end();
    return out;
}

# --- events.cyr ---

# bote::events — event topic constants + EventSink abstraction
# Mirrors rust-old/src/events.rs (trait + topic constants).
#
# Cyrius has no traits, so EventSink is a (publish_fp, ctx) struct.
# Backends (e.g. MajraEvents in src/events_majra.cyr — v1.2) wrap their state
# in `ctx` and provide a publish function pointer with signature:
#
#   fn my_publish(ctx, topic_cstr, payload_json_cstr) → 0

# ================================================================
# Topic constants (cstr literals)
# ================================================================
fn TOPIC_TOOL_COMPLETED()    { return "bote/tool/completed"; }
fn TOPIC_TOOL_FAILED()       { return "bote/tool/failed"; }
fn TOPIC_TOOL_REGISTERED()   { return "bote/tool/registered"; }
fn TOPIC_TOOL_ANNOUNCE()     { return "bote/tool/announce"; }
fn TOPIC_TOOL_DISCOVERED()   { return "bote/tool/discovered"; }
fn TOPIC_TOOL_DEPRECATED()   { return "bote/tool/deprecated"; }
fn TOPIC_TOOL_DEREGISTERED() { return "bote/tool/deregistered"; }
fn TOPIC_PROMPT_REGISTERED()  { return "bote/prompt/registered"; }
fn TOPIC_RESOURCE_REGISTERED() { return "bote/resource/registered"; }
fn TOPIC_SANDBOX_CREATED()   { return "bote/sandbox/created"; }
fn TOPIC_SANDBOX_DESTROYED() { return "bote/sandbox/destroyed"; }
fn TOPIC_SANDBOX_ERROR()     { return "bote/sandbox/error"; }

# ================================================================
# EventSink (32 bytes):
#   +0  publish_fp  function pointer (or 0 for no-op sink)
#   +8  ctx         opaque pointer passed to publish_fp
#   +16 list_only   1 when it ignores tool-call events
#   +24 updated_fp  fn(ctx, uri), told a resource's contents changed (3.7.4), or 0
# ================================================================

fn event_sink_new(publish_fp, ctx) {
    var s = alloc(32);
    store64(s, publish_fp);
    store64(s + 8, ctx);
    store64(s + 16, 0);
    store64(s + 24, 0);
    return s;
}

# A resource update is not an event (3.7.4): it carries a URI and no payload, so nothing
# is built for it and nothing kept, and a sink hears of it only through this. The listen
# sinks (src/listen.cyr) do; majra's and the legacy drain's do not.
fn event_sink_with_updated(s, fp) { store64(s + 24, fp); return s; }

fn event_sink_updated(sink, uri) {
    if (sink == 0) { return 0; }
    var fp = load64(sink + 24);
    if (fp == 0) { return 0; }
    fncall2(fp, load64(sink + 8), uri);
    return 0;
}

# Say this sink ignores tool-call events, so dispatch need not build them.
fn event_sink_set_list_only(s) { store64(s + 16, 1); return s; }

# A no-op sink: publish_fp = 0, ctx = 0. Equivalent to "events disabled".
fn event_sink_noop() {
    return event_sink_new(0, 0);
}

fn event_sink_publish_fp(sink) { return load64(sink); }
fn event_sink_ctx(sink) { return load64(sink + 8); }

# Publish an event. Safe to call with sink==0 or noop sink (both no-op).
# topic and payload are cstrs; payload is a raw JSON literal (e.g. "{...}").
fn event_sink_publish(sink, topic, payload) {
    if (sink == 0) { return 0; }
    var fp = load64(sink);
    if (fp == 0) { return 0; }
    var ctx = load64(sink + 8);
    fncall3(fp, ctx, topic, payload);
    return 0;
}

# --- audit.cyr ---

# bote::audit — tool-call audit logging
# Mirrors rust-old/src/audit.rs (trait + ToolCallEvent).
#
# Cyrius has no traits, so AuditSink is a (log_fp, ctx) struct.
# Backends (e.g. LibroAudit in src/audit_libro.cyr — v1.2) wrap their state
# in `ctx` and provide a log function pointer with signature:
#
#   fn my_log(ctx, event_ptr) → 0

# ================================================================
# ToolCallEvent (40 bytes):
#   +0  tool_name     cstr
#   +8  duration_ms   i64
#   +16 success       0/1
#   +24 error         cstr or 0 (only set when success == 0)
#   +32 caller_id     cstr or 0
# ================================================================

fn tool_call_event_new(tool_name, duration_ms, success, error, caller_id) {
    var e = alloc(40);
    store64(e, tool_name);
    store64(e + 8, duration_ms);
    store64(e + 16, success);
    store64(e + 24, error);
    store64(e + 32, caller_id);
    return e;
}

fn tool_call_event_tool_name(e)   { return load64(e); }
fn tool_call_event_duration_ms(e) { return load64(e + 8); }
fn tool_call_event_success(e)     { return load64(e + 16); }
fn tool_call_event_error(e)       { return load64(e + 24); }
fn tool_call_event_caller_id(e)   { return load64(e + 32); }

# Serialize a ToolCallEvent to a JSON cstr. Skips error/caller_id when 0.
# Mirrors Rust's `#[serde(skip_serializing_if = "Option::is_none")]`.
fn tool_call_event_to_json(e) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tool_name\":\"");
    _json_emit_escaped(sb, tool_call_event_tool_name(e));
    str_builder_add_cstr(sb, "\",\"duration_ms\":");
    str_builder_add_int(sb, tool_call_event_duration_ms(e));
    str_builder_add_cstr(sb, ",\"success\":");
    if (tool_call_event_success(e) == 1) { str_builder_add_cstr(sb, "true"); }
    else { str_builder_add_cstr(sb, "false"); }
    var err = tool_call_event_error(e);
    if (err != 0) {
        str_builder_add_cstr(sb, ",\"error\":\"");
        _json_emit_escaped(sb, err);
        str_builder_add_cstr(sb, "\"");
    }
    var cid = tool_call_event_caller_id(e);
    if (cid != 0) {
        str_builder_add_cstr(sb, ",\"caller_id\":\"");
        _json_emit_escaped(sb, cid);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# ================================================================
# AuditSink (16 bytes):
#   +0  log_fp  function pointer (or 0 for no-op sink)
#   +8  ctx     opaque pointer passed to log_fp
# ================================================================

fn audit_sink_new(log_fp, ctx) {
    var s = alloc(16);
    store64(s, log_fp);
    store64(s + 8, ctx);
    return s;
}

fn audit_sink_noop() { return audit_sink_new(0, 0); }
fn audit_sink_log_fp(sink) { return load64(sink); }
fn audit_sink_ctx(sink) { return load64(sink + 8); }

# Log an event. Safe to call with sink==0 or noop sink (both no-op).
fn audit_sink_log(sink, event) {
    if (sink == 0) { return 0; }
    var fp = load64(sink);
    if (fp == 0) { return 0; }
    var ctx = load64(sink + 8);
    fncall2(fp, ctx, event);
    return 0;
}

# --- audit_libro.cyr ---

# bote::audit::libro — LibroAudit adapter
# Mirrors rust-old/src/audit.rs::libro_impl::LibroAudit.
#
# Wraps a libro audit chain with bote's AuditSink contract:
#   - Severity: SEV_INFO on success, SEV_ERROR on failure
#   - Action:   "tool.completed" on success, "tool.failed" on failure
#   - Source:   "bote" by default (override via libro_audit_with_source)
#   - Agent:    caller_id from the event takes precedence over configured agent_id
#   - Details:  serialized ToolCallEvent JSON
#
# REQUIRED INIT (caller's main, before any chain operations):
#   alloc_init();   # bump allocator
#   fl_init();      # freelist (libro entries live here)
#   ed25519_init(); # sigil signing constants
#
# Wire-up:
#   var chain = chain_new();
#   var la = libro_audit_new(chain);
#   var sink = audit_sink_new(&libro_audit_log, la);
#   dispatcher_set_audit(d, sink);
#
# IMPORTANT: libro's chain_append* takes `Str` (fat strings), not raw cstrs.
# This adapter wraps every cstr boundary value via str_from before calling
# into libro. Callers should pass plain cstrs in ToolCallEvent — the wrap
# happens here.
#
# Known issue (v1.2.1): when libro + majra + the full bote test/demo binary
# are linked together, the libro_audit_log path triggers a heap heisenbug
# (main re-entry / infinite loop). The adapter shape is correct (works in
# isolated probes); live integration in a multi-include binary needs cyrius
# investigation — tracked for v1.3.0.

# LibroAudit (24 bytes):
#   +0  chain     libro chain ptr
#   +8  source    cstr (default "bote")
#   +16 agent_id  cstr or 0 (default 0)

# The lock on libro's chains (3.7.1). libro locks nothing, and on a threaded server this
# sink appends to a chain from one worker while a libro tool (src/libro_tools.cyr) walks it
# from another, so both take this. One for every chain: they are few, and appends are short.
# Taken only once threads are running, and made the first time it is, by compare-and-swap.
var _bote_libro_mtx = 0;

fn _bote_libro_mutex() {
    var m = atomic_load(&_bote_libro_mtx);
    if (m != 0) { return m; }
    atomic_cas(&_bote_libro_mtx, 0, mutex_new());
    return atomic_load(&_bote_libro_mtx);
}

fn bote_libro_lock() {
    if (_threads_active != 0) { mutex_lock(_bote_libro_mutex()); }
    return 0;
}

fn bote_libro_unlock() {
    if (_threads_active != 0) { mutex_unlock(_bote_libro_mutex()); }
    return 0;
}

fn libro_audit_new(chain) {
    var la = alloc(24);
    store64(la, chain);
    store64(la + 8, "bote");
    store64(la + 16, 0);
    return la;
}

fn libro_audit_with_source(la, source)     { store64(la + 8, source);   return la; }
fn libro_audit_with_agent_id(la, agent_id) { store64(la + 16, agent_id); return la; }

fn libro_audit_chain(la)    { return load64(la); }
fn libro_audit_source(la)   { return load64(la + 8); }
fn libro_audit_agent_id(la) { return load64(la + 16); }

# AuditSink-compatible log function.
# ctx is a LibroAudit ptr.
#
# IMPORTANT: libro's chain_append* expects `Str` (fat strings) for source /
# action / details / agent, NOT raw cstrs. Bote stores tool names and
# similar as cstrs, so we wrap them via str_from at the boundary.
fn libro_audit_log(ctx, event) {
    bote_libro_lock();
    _libro_audit_log_held(ctx, event);
    bote_libro_unlock();
    return 0;
}

fn _libro_audit_log_held(ctx, event) {
    if (ctx == 0 || event == 0) { return 0; }
    var chain = libro_audit_chain(ctx);
    if (chain == 0) { return 0; }

    var success = tool_call_event_success(event);
    var severity = SEV_INFO;
    var action_cstr = "tool.completed";
    if (success == 0) { severity = SEV_ERROR; action_cstr = "tool.failed"; }

    var source_str  = str_from(libro_audit_source(ctx));
    var action_str  = str_from(action_cstr);
    var details_str = str_from(tool_call_event_to_json(event));

    # The configured identity only. caller_id is whatever the client put in
    # its params, so it stays in the details as a claim, not as who did this.
    var agent_cstr = libro_audit_agent_id(ctx);

    if (agent_cstr != 0) {
        chain_append_with_agent(chain, severity, source_str, action_str,
          details_str, str_from(agent_cstr));
    } else {
        chain_append(chain, severity, source_str, action_str, details_str);
    }
    return 0;
}

# --- events_majra.cyr ---

# bote::events::majra — MajraEvents adapter
# Mirrors rust-old/src/events.rs::majra_impl::MajraEvents.
#
# Wraps a majra PubSub instance with bote's EventSink contract.
# topic and payload are passed straight through to pubsub_publish.
#
# Wire-up:
#   var ps = pubsub_new();
#   var sink = event_sink_new(&majra_events_publish, ps);
#   dispatcher_set_events(d, sink);
#
# Subscribe to bote topics from your own code:
#   var rx = pubsub_subscribe(ps, "bote/tool/#");

# EventSink-compatible publish function.
# ctx is a majra PubSub ptr.
fn majra_events_publish(ctx, topic, payload) {
    if (ctx == 0) { return 0; }
    pubsub_publish(ctx, topic, payload);
    return 0;
}

# --- dispatch.cyr ---

# bote::dispatch — JSON-RPC tool dispatcher
# Mirrors rust-old/src/dispatch.rs (sync path; streaming/audit/events deferred)
#
# Requires (entry point includes):
#   string, fmt, alloc, vec, str, hashmap, fnptr,
#   src/error.cyr, src/protocol.cyr, src/registry.cyr, src/jsonx.cyr

# ================================================================
# Supported MCP protocol versions
# ================================================================
#
# ⚠ THE ONE LIST. `session.cyr`'s `validate_protocol_version` — which is
# what the HTTP-family transports run the `MCP-Protocol-Version` header
# through — delegates here rather than carrying its own copy. It used to
# carry one, and the two drifted: both listed the same three versions, so
# adding a fourth to either alone produced a server that negotiates a
# version over stdio and 400s the same version over HTTP. Adding a version
# is one line, here.
#
# `2025-06-18` retired JSON-RPC batching from the spec. bote still accepts
# batch arrays on every version — a superset is harmless to a client that
# never sends one — so the revision needs no behavioural branch.

fn _mcp_is_supported(v) {
    if (v == 0) { return 0; }
    if (streq(v, "2024-11-05") == 1) { return 1; }
    if (streq(v, "2025-03-26") == 1) { return 1; }
    if (streq(v, "2025-06-18") == 1) { return 1; }
    if (streq(v, "2025-11-25") == 1) { return 1; }
    return 0;
}

# The newest revision `initialize` negotiates. 2026-07-28 has no `initialize`, so
# it is not on this list: a client offering it there gets legacy semantics.
fn _mcp_latest_version() { return "2025-11-25"; }

# The stateless revision (3.5.0). A request says which revision it is, in its own
# `_meta`, and nothing carries over from the one before it.
fn _mcp_is_modern(v) {
    if (v == 0) { return 0; }
    if (streq(v, "2026-07-28") == 1) { return 1; }
    return 0;
}

# Every revision bote serves, newest first, as a JSON array.
fn _mcp_emit_versions(sb) {
    str_builder_add_cstr(sb, "[\"2026-07-28\",\"2025-11-25\",\"2025-06-18\",\"2025-03-26\",\"2024-11-05\"]");
    return 0;
}

fn _bote_server_version() { return "3.8.15"; }

# ================================================================
# Tool name validation
# ================================================================
#
# Returns 0 if `name` may name a tool, else a BoteError. The spec's rule (3.8.7): 1 to 128
# characters from A-Z a-z 0-9 _ - . (MCP 2025-11-25, "Tool names"), which registration holds
# every definition to (`registry_check_tool_def`). Through 3.8.6 this also required an
# underscore (bote's project_tool convention) and refused - and ., so `dispatcher_register_tool`
# refused names the spec allows, and allowed up to 256 characters, which registration refused.
fn validate_tool_name(name) {
    if (_reg_name_ok(name) == 1) { return 0; }
    var shown = "";
    if (name != 0) { shown = name; }
    return bote_err_new(BOTE_ERR_INVALID_PARAMS, shown, "the tool name must be 1-128 characters from A-Z a-z 0-9 _ - .");
}

# ================================================================
# Dispatcher struct (216 bytes):
#   +0  registry            ptr
#   +8  handlers            hashmap: name_cstr -> fn ptr (sync handler)
#   +16 streaming_handlers  hashmap: name_cstr -> fn ptr (reserved for v1.3)
#   +24 audit_sink          AuditSink ptr or 0 (no-op when 0)
#   +32 event_sink          EventSink ptr or 0 (no-op when 0)
#   +40 prompt_registry     PromptRegistry ptr or 0 (prompts capability off
#                           when 0; created lazily by dispatcher_register_prompt)
#   +48 resource_registry   ResourceRegistry ptr or 0 (resources capability off
#                           when 0; created lazily by dispatcher_register_resource)
#   +56 completion_handler  fn ptr or 0 (completions capability off when 0;
#                           set via dispatcher_set_completion)
#   +64 notifications        0/1 — 1 when the server has a working server→client
#                           notification path (a transport that drains
#                           list_changed to clients). Gates the `listChanged`
#                           sub-capabilities. Set by the transport wiring, NOT
#                           in core: only a transport with a drain path
#                           (streamable) may advertise listChanged; stdio/http/
#                           ws must not promise notifications they can't deliver.
# ================================================================

#   +72 server_name           cstr — the `serverInfo.name` this dispatcher
#                           advertises at initialize, or 0 for bote's own.
#   +80 server_version        cstr — the matching `serverInfo.version`, or 0.
#                           Set together via dispatcher_set_server_info.
#   +88 scope_check           fn ptr (claims, scope, ctx) → 1 when held, or 0.
#   +96 scope_ctx             passed to it. Set via dispatcher_set_scope_check.
#   +104 listen               what carries `subscriptions/listen` streams (3.7.2): a
#                           ListenHub (src/listen.cyr), opaque here, or 0, when the
#                           method is not served. Set by the transport wiring.
#   +112 server_title        cstr or 0 \
#   +120 server_description  cstr or 0  | serverInfo's other fields (3.8.1), set
#   +128 server_website      cstr or 0  | together via dispatcher_set_server_details
#   +136 server_icons        vec of Icon or 0 /
#   +144 instructions        cstr or 0 (3.8.1, dispatcher_set_instructions)
#   +152 instructions_json   `,"instructions":"…"`, escaped when set, or 0
#   +160 server_info_full    serverInfo's JSON, every field, built when any is set, or 0
#   +168 server_info_short   the same with name, version and title only, or 0
#   +176 state_seal          (3.8.2) fn(ctx, a, binding, payload) → the sealed requestState
#   +184 state_open          fn(ctx, a, binding, state) → the payload, or 0 when it fails
#   +192 state_ctx           their context; dispatcher_set_state_sealer sets all three
#   +200 state_principal     (3.8.3) fn(ctx, a, claims) → who the claims name, or 0
#   +208 state_principal_ctx its context; dispatcher_set_state_principal sets both
fn dispatcher_new(reg) {
    var d = alloc(216);
    store64(d, reg);
    store64(d + 8, map_new());
    store64(d + 16, map_new());
    store64(d + 24, 0);
    store64(d + 32, 0);
    store64(d + 40, 0);
    store64(d + 48, 0);
    store64(d + 56, 0);
    store64(d + 64, 0);
    store64(d + 72, 0);
    store64(d + 80, 0);
    store64(d + 88, 0);
    store64(d + 96, 0);
    store64(d + 104, 0);
    var k = 112;
    while (k < 216) { store64(d + k, 0); k = k + 8; }
    return d;
}

# What seals and opens the `requestState` of an InputRequiredResult (3.8.2). The spec makes
# a client's requestState attacker-controlled input, and a server MUST protect its
# integrity where it can matter, so bote seals every state a handler gives it and opens
# every one a client brings back, binding each to the request it was made for and who made
# it (_dsp_state_binding_a). With no sealer, a handler's state is refused and so is a
# client's: none can be trusted. The full bundle has one, HMAC-SHA256 with an expiry
# (src/state_seal.cyr). Set before serving.
fn dispatcher_set_state_sealer(d, seal_fp, open_fp, ctx) {
    store64(d + 176, seal_fp);
    store64(d + 184, open_fp);
    store64(d + 192, ctx);
    return d;
}

# Who a request's claims name, for the binding of its requestState (3.8.3): the spec binds a
# state to the principal. `fp(ctx, a, claims)` gives a cstr naming them, on `a` or for
# good, or 0 when the claims name no one, and is asked only for claims that are not 0. With
# none set, or when it gives 0, a state is bound to the token the request presented, which
# a token refreshed between rounds does not match; and a request whose claims are not that
# token (a validator that returns a record, a transport that passes its own) can be bound to
# no one, so its handler's state is refused, and so is a state it brings. The full bundle's
# jwt_state_principal names a JWT's issuer and subject.
fn dispatcher_set_state_principal(d, fp, ctx) {
    store64(d + 200, fp);
    store64(d + 208, ctx);
    return d;
}

fn dispatcher_registry(d)   { return load64(d); }
fn dispatcher_handlers(d)   { return load64(d + 8); }
fn dispatcher_streaming(d)  { return load64(d + 16); }
fn dispatcher_audit_sink(d) { return load64(d + 24); }
fn dispatcher_event_sink(d) { return load64(d + 32); }
fn dispatcher_prompts(d)    { return load64(d + 40); }
fn dispatcher_resources(d)  { return load64(d + 48); }
fn dispatcher_completion(d) { return load64(d + 56); }
fn dispatcher_notifications(d) { return load64(d + 64); }

fn dispatcher_server_name(d)    { return load64(d + 72); }
fn dispatcher_server_version(d) { return load64(d + 80); }

# Set the `serverInfo` this dispatcher advertises at `initialize`.
#
# **A dispatcher embedded in another product must not introduce itself as
# "bote".** Before 3.3.0 `_build_initialize_result` hardcoded
# `"serverInfo":{"name":"bote"}`, so every consumer's MCP clients saw bote's
# identity and bote's version rather than the host application's — which is
# wrong for every downstream, and for a host whose own oracle emits its own name
# it is a wire divergence with no workaround short of hand-rolling the envelope.
#
# Both arguments are cstrs. Passing 0 for either keeps bote's own value for that
# field, so `dispatcher_set_server_info(d, "agnosai", 0)` renames the server and
# keeps bote's version. Unset (the default) is byte-identical to pre-3.3.0.
fn dispatcher_set_server_info(d, name, version) {
    store64(d + 72, name);
    store64(d + 80, version);
    _dsp_server_info_build(d);
    return d;
}

fn dispatcher_server_title(d)       { return load64(d + 112); }
fn dispatcher_server_description(d) { return load64(d + 120); }
fn dispatcher_server_website(d)     { return load64(d + 128); }
fn dispatcher_server_icons(d)       { return load64(d + 136); }
fn dispatcher_instructions(d)       { return load64(d + 144); }

# The rest of `serverInfo` (3.8.1, the spec's Implementation): a title for people, a
# description, the website's URL and icons, each 0 for none. Returns 0, or a BoteError,
# with nothing set, when the URL is no http:// or https:// URL, or an icon is not what the
# spec says (bote_icons_check). Set before serving: what is sent is
# built here, once.
#
# `initialize` and `server/discover` send every field. Every other 2026-07-28 result
# carries serverInfo in its `_meta` too, and sends the name, the version and the title
# only, so that an icon, which may be a data: URI of some kilobytes, is not in every reply.
fn dispatcher_set_server_details(d, title, description, website_url, icons) {
    var why = bote_display_check(title, icons);
    if (why == 0 && website_url != 0 && bote_web_url_ok(website_url) == 0) {
        why = "the website must be an http:// or https:// URL";
    }
    if (why != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", why); }
    store64(d + 112, title);
    store64(d + 120, description);
    store64(d + 128, website_url);
    store64(d + 136, icons);
    _dsp_server_info_build(d);
    return 0;
}

# What the server tells a client's model about using it (3.8.1), or 0 for nothing: in
# `initialize`'s result on 2025-11-25 and in `server/discover`'s on 2026-07-28. Set
# before serving. Returns `d`.
fn dispatcher_set_instructions(d, text) {
    store64(d + 144, text);
    store64(d + 152, 0);
    if (text != 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, ",\"instructions\":\"");
        bote_json_escape(sb, text);
        str_builder_add_cstr(sb, "\"");
        store64(d + 152, str_data(str_builder_build(sb)));
    }
    return d;
}

# serverInfo's two forms, built from what is set: every field, and name, version and title.
fn _dsp_server_info_build(d) {
    var sname = dispatcher_server_name(d);
    if (sname == 0) { sname = "bote"; }
    var sver = dispatcher_server_version(d);
    if (sver == 0) { sver = _bote_server_version(); }
    var title = dispatcher_server_title(d);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"");
    bote_json_escape(sb, sname);
    str_builder_add_cstr(sb, "\"");
    if (title != 0) {
        str_builder_add_cstr(sb, ",\"title\":\"");
        bote_json_escape(sb, title);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, ",\"version\":\"");
    bote_json_escape(sb, sver);
    str_builder_add_cstr(sb, "\"");
    var head = str_data(str_builder_build(sb));
    store64(d + 168, _dsp_named_msg(head, "}", 0));
    var fb = str_builder_new();
    str_builder_add_cstr(fb, head);
    var desc = dispatcher_server_description(d);
    if (desc != 0) {
        str_builder_add_cstr(fb, ",\"description\":\"");
        bote_json_escape(fb, desc);
        str_builder_add_cstr(fb, "\"");
    }
    var site = dispatcher_server_website(d);
    if (site != 0) {
        str_builder_add_cstr(fb, ",\"websiteUrl\":\"");
        bote_json_escape(fb, site);
        str_builder_add_cstr(fb, "\"");
    }
    var icons = _bote_display_json(0, dispatcher_server_icons(d));
    if (icons != 0) { str_builder_add_cstr(fb, icons); }
    str_builder_add_cstr(fb, "}");
    store64(d + 160, str_data(str_builder_build(fb)));
    return 0;
}

# How many bytes _dsp_emit_server_info writes, at most.
fn _dsp_server_info_room(d, full) {
    var c = load64(d + 168);
    if (full == 1) { c = load64(d + 160); }
    if (c != 0) { return strlen(c); }
    return 64 + 6 * strlen(_bote_server_version());
}

fn _dsp_instructions_room(d) {
    var c = load64(d + 152);
    if (c == 0) { return 0; }
    return strlen(c);
}

# Who can say what a token grants. Claims are opaque to bote, so what reads them is
# supplied: jwt_scope_check for a JWT, and for anything else the validator's author.
# A broader scope that implies a narrower one is this function's to account for.
fn dispatcher_set_scope_check(d, fp, ctx) {
    store64(d + 88, fp);
    store64(d + 96, ctx);
    return d;
}

# What carries this dispatcher's `subscriptions/listen` streams (3.7.2), or 0 for none,
# when the method is not found. A transport that can hold a stream open sets it.
fn dispatcher_set_listen(d, hub) { store64(d + 104, hub); return d; }
fn dispatcher_listen(d) { return load64(d + 104); }

fn dispatcher_set_audit(d, sink) { store64(d + 24, sink); return d; }
fn dispatcher_set_events(d, sink) { store64(d + 32, sink); return d; }
fn dispatcher_set_prompts(d, preg) { store64(d + 40, preg); return d; }
fn dispatcher_set_resources(d, rreg) { store64(d + 48, rreg); return d; }

# Set the completion handler. ABI: fn h(params_cstr, claims) → result_cstr,
# where params is the completion/complete params ({ref, argument, ...}) and
# the result is the full {"completion":{"values":[...]}} body. Setting it
# flips the `completions` capability on at initialize.
fn dispatcher_set_completion(d, handler_fp) { store64(d + 56, handler_fp); return d; }

# Declare that this dispatcher's transport can deliver server→client
# notifications (a list_changed drain path). Flips the `listChanged`
# sub-capabilities on at initialize. Set by the transport wiring only.
fn dispatcher_set_notifications(d, on) { store64(d + 64, on); return d; }

# Register a sync tool handler. **2.0 ABI**: handler signature is
#   fn h(args_cstr, claims) → result_cstr (claims always 0 today)
# The handler maps are under the registries' lock (3.7.1, src/protocol.cyr), as the
# registries are: a threaded server reads them for every call.
fn dispatcher_handle(d, name, handler_fp) {
    bote_reg_write();
    map_set(dispatcher_handlers(d), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

# Register a streaming tool handler (placeholder — dispatch_streaming not yet ported).
fn dispatcher_handle_streaming(d, name, handler_fp) {
    bote_reg_write();
    map_set(dispatcher_streaming(d), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn dispatcher_is_streaming_tool(d, name) {
    bote_reg_read();
    var h = map_has(dispatcher_streaming(d), name);
    bote_reg_read_end();
    return h;
}

# The tool `name`, or 0, from one look at the registries (3.7.2), with what serves it: its
# handler through *fp_out, *has_out 1 when one is set (a handler may be registered as 0),
# and with a `ver`, *ver_out 1 when that version is registered. A call is judged by this
# and served by it, so a tool registered or replaced while the call runs cannot lend it a
# definition its scopes were not checked against. (3.8.4) The tool is a copy, on `a`, made in
# the same look: a definition registered again is staged in place, and a call that read its
# outputSchema's compiled form and its 2025-11-25 form at different moments could lift a value
# by one and judge it by neither.
fn _dsp_tool_serving(a, d, name, ver, ver_out, has_out, fp_out) {
    bote_reg_read();
    var t = _registry_get_u(dispatcher_registry(d), name);
    if (t != 0) {
        # A word at a time: the stdlib's memcpy goes a byte at a time, 240 ns for 144 bytes,
        # which every call paid.
        var snap = alloc_via(a, 152);
        var w = 0;
        while (w < 152) { store64(snap + w, load64(t + w)); w = w + 8; }
        t = snap;
    }
    var has = map_has(dispatcher_handlers(d), name);
    var fp = 0;
    if (has == 1) { fp = map_get(dispatcher_handlers(d), name); }
    var vok = 1;
    if (ver != 0 && _registry_get_versioned_u(dispatcher_registry(d), name, ver) == 0) { vok = 0; }
    bote_reg_read_end();
    store64(ver_out, vok);
    store64(has_out, has);
    store64(fp_out, fp);
    return t;
}

# The handler registered for tool `name`, through *has_out 1 when there is one (a handler
# may be registered as 0), or 0.
fn _dsp_handler(d, name, has_out) {
    bote_reg_read();
    var fp = 0;
    var has = map_has(dispatcher_handlers(d), name);
    if (has == 1) { fp = map_get(dispatcher_handlers(d), name); }
    bote_reg_read_end();
    store64(has_out, has);
    return fp;
}

# Build {"tool_name":"<name>"} for a register/dereg/deprecate event payload.
fn _emit_tool_name_payload(name) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tool_name\":\"");
    _json_emit_escaped(sb, name);
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

# Dynamic registration: validates the tool name, registers in registry,
# inserts handler. Returns 0 on success, BoteError ptr on failure.
# Emits TOPIC_TOOL_REGISTERED on success.
fn dispatcher_register_tool(d, tool_def, handler_fp) {
    if (tool_def == 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "tool definition is null"); }
    var name = tool_def_name(tool_def);
    # Registration's checks hold the name to the spec's rule (3.8.7), and log why it refuses one.
    var st[72];
    var rerr = _registry_prepare(tool_def, &st);
    if (rerr != 0) { return rerr; }
    # The tool and its handler in one write (3.7.1), so a call on another worker never
    # finds the one without the other; the event after, with nothing held.
    bote_reg_write();
    map_set(dispatcher_handlers(d), name, handler_fp);
    _registry_add_u(dispatcher_registry(d), tool_def, &st);
    bote_reg_write_end();
    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_REGISTERED(),
      _emit_tool_name_payload(name));
    return 0;
}

# Returns 0 on success, BoteError ptr on failure (tool not found).
# Emits TOPIC_TOOL_DEREGISTERED on success.
fn dispatcher_deregister_tool(d, name) {
    bote_reg_write();
    var removed = _registry_deregister_u(dispatcher_registry(d), name);
    map_delete(dispatcher_handlers(d), name);
    map_delete(dispatcher_streaming(d), name);
    bote_reg_write_end();
    if (removed == 0) {
        return bote_err_new(BOTE_ERR_TOOL_NOT_FOUND, name, 0);
    }
    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_DEREGISTERED(),
      _emit_tool_name_payload(name));
    return 0;
}

# Why a prompt, resource or template with a required scope that is no RFC 6749
# scope-token is not registered: the scope would go out in a 403's header (3.6.6).
var DSP_SCOPE_NOT_TOKEN = "a required scope must be a non-empty token with no space, quote or backslash";

# The registry at `d + off`, the one `fresh` becomes when there is none yet (3.7.2). Two
# threads registering the first prompt or resource at once each made one, and the first
# stored was lost with what was registered in it. The swap publishes `fresh` after its
# maps, so a reader that sees it sees them; a loser's `fresh` is left unused.
fn _dsp_made(d, off, fresh) {
    if (atomic_cas(d + off, 0, fresh) == 1) { return fresh; }
    return atomic_load(d + off);
}

# Register an MCP prompt + its generator handler. Lazily stands up the
# dispatcher's PromptRegistry on first call — which is also what flips the
# `prompts` capability on at initialize (see _build_capabilities). Prompt
# names are freeform (no project_tool underscore convention). Returns 0, or a
# BoteError with nothing registered.
fn dispatcher_register_prompt(d, prompt_def, handler_fp) {
    if (prompt_def == 0 || prompt_def_name(prompt_def) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "prompt definition has no name");
    }
    if (bote_scope_list_ok(prompt_def_required_scopes(prompt_def)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, prompt_def_name(prompt_def), DSP_SCOPE_NOT_TOKEN);
    }
    var pwhy = prompt_display_check(prompt_def);
    if (pwhy != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, prompt_def_name(prompt_def), pwhy); }
    var preg = dispatcher_prompts(d);
    if (preg == 0) { preg = _dsp_made(d, 40, prompt_registry_new()); }
    prompt_registry_register(preg, prompt_def, handler_fp);
    # Emit a prompt-set-changed event so a client-notification sink can push
    # notifications/prompts/list_changed (no-op when no sink is wired, e.g.
    # the startup registrations before the transport sets its sink).
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "{\"prompt_name\":\"");
    _json_emit_escaped(pb, prompt_def_name(prompt_def));
    str_builder_add_cstr(pb, "\"}");
    event_sink_publish(dispatcher_event_sink(d), TOPIC_PROMPT_REGISTERED(),
      str_data(str_builder_build(pb)));
    return 0;
}

# Register an MCP resource + its read handler. Lazily stands up the
# dispatcher's ResourceRegistry on first call — which is also what flips the
# `resources` capability on at initialize (see _build_capabilities).
# Returns 0, or a BoteError with nothing registered.
fn dispatcher_register_resource(d, resource_def, handler_fp) {
    if (resource_def == 0 || resource_def_uri(resource_def) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "resource definition has no uri");
    }
    if (bote_scope_list_ok(resource_def_required_scopes(resource_def)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_def_uri(resource_def), DSP_SCOPE_NOT_TOKEN);
    }
    var rwhy = bote_display_check(resource_def_title(resource_def), resource_def_icons(resource_def));
    if (rwhy != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_def_uri(resource_def), rwhy); }
    var rreg = dispatcher_resources(d);
    if (rreg == 0) { rreg = _dsp_made(d, 48, resource_registry_new()); }
    resource_registry_register(rreg, resource_def, handler_fp);
    _dsp_resource_changed(d);
    return 0;
}

# A resource or a template registered (3.7.2): `notifications/resources/list_changed`
# for whoever listens for it.
fn _dsp_resource_changed(d) {
    event_sink_publish(dispatcher_event_sink(d), TOPIC_RESOURCE_REGISTERED(), "{}");
    return 0;
}

# Register a resource template + its read handler. Stands up the registry the way
# dispatcher_register_resource does. Returns 0, or a BoteError saying why not, with
# nothing registered.
fn dispatcher_register_resource_template(d, template, handler_fp) {
    if (template == 0 || resource_template_name(template) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "a resource template needs a name");
    }
    var why = resource_template_check(resource_template_uri(template));
    if (why != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), why); }
    if (bote_scope_list_ok(resource_template_required_scopes(template)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), DSP_SCOPE_NOT_TOKEN);
    }
    var twhy = bote_display_check(resource_template_title(template), resource_template_icons(template));
    if (twhy != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), twhy); }
    var rreg = dispatcher_resources(d);
    if (rreg == 0) { rreg = _dsp_made(d, 48, resource_registry_new()); }
    resource_registry_register_template(rreg, template, handler_fp);
    _dsp_resource_changed(d);
    return 0;
}

# ================================================================
# JSON helpers — escape, build literals
# ================================================================

# `_json_emit_escaped`, the escaper every module calls, lives in jsonx.cyr
# since 3.4.6 as `bote_json_escape`, with the old name kept as an alias.

# Append "key":"value" (value JSON-escaped). Caller responsible for commas.
fn _json_emit_str_field(sb, key, value) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":\"");
    _json_emit_escaped(sb, value);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# Append "key":raw  where raw is already JSON-formatted.
fn _json_emit_raw_field(sb, key, raw) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":");
    str_builder_add_cstr(sb, raw);
    return 0;
}

# Build a JSON object representation of a ToolSchema.
fn _emit_schema(sb, schema) {
    str_builder_add_cstr(sb, "{\"type\":\"");
    var t = schema_type(schema);
    if (t != 0) { _json_emit_escaped(sb, t); }
    str_builder_add_cstr(sb, "\"");

    var props = schema_properties(schema);
    if (props != 0 && vec_len(props) > 0) {
        str_builder_add_cstr(sb, ",\"properties\":{");
        var n = vec_len(props);
        var i = 0;
        while (i < n) {
            if (i > 0) { str_builder_add_cstr(sb, ","); }
            var p = vec_get(props, i);
            str_builder_add_cstr(sb, "\"");
            _json_emit_escaped(sb, schema_prop_key(p));
            str_builder_add_cstr(sb, "\":");
            str_builder_add_cstr(sb, schema_prop_value(p));
            i = i + 1;
        }
        str_builder_add_cstr(sb, "}");
    }

    var req = schema_required(schema);
    if (req != 0 && vec_len(req) > 0) {
        str_builder_add_cstr(sb, ",\"required\":[");
        var nr = vec_len(req);
        var ri = 0;
        while (ri < nr) {
            if (ri > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            _json_emit_escaped(sb, vec_get(req, ri));
            str_builder_add_cstr(sb, "\"");
            ri = ri + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, "}");
    return 0;
}

# A tool's inputSchema as registration kept it, on one line (3.8.3). A definition never
# registered, as an announcement may hold, has it made here, on the heap.
fn _emit_input_schema(sb, t) {
    var ij = tool_def_input_json(t);
    if (ij == 0) { ij = _reg_input_json(tool_def_input_schema(t)); }
    str_builder_add_cstr(sb, ij);
    return 0;
}

# Append a single tri-state annotation hint as "key":true/false.
# `first` is 1 when no hint has been emitted yet (suppresses the leading
# comma); returns the updated `first` flag. HINT_UNSET emits nothing.
fn _emit_hint_field(sb, first, key, hint) {
    if (hint == HINT_UNSET) { return first; }
    if (first == 0) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    if (hint == HINT_TRUE) { str_builder_add_cstr(sb, "\":true"); }
    else { str_builder_add_cstr(sb, "\":false"); }
    return 0;
}

# Append ,"annotations":{...} for a ToolDef's ToolAnnotations ptr.
# Emits nothing when `ann` is 0 or every hint is unset (so the leading
# comma is only produced when at least one hint is serialized). MCP
# 2025-11-25 ToolAnnotations: readOnlyHint/destructiveHint/idempotentHint/
# openWorldHint, each an optional boolean (skip when unset).
fn _emit_annotations(sb, ann) {
    if (ann == 0) { return 0; }
    var r = ann_read_only_hint(ann);
    var dd = ann_destructive_hint(ann);
    var idem = ann_idempotent_hint(ann);
    var ow = ann_open_world_hint(ann);
    if (r == HINT_UNSET && dd == HINT_UNSET && idem == HINT_UNSET && ow == HINT_UNSET) {
        return 0;
    }
    str_builder_add_cstr(sb, ",\"annotations\":{");
    var first = 1;
    first = _emit_hint_field(sb, first, "readOnlyHint", r);
    first = _emit_hint_field(sb, first, "destructiveHint", dd);
    first = _emit_hint_field(sb, first, "idempotentHint", idem);
    first = _emit_hint_field(sb, first, "openWorldHint", ow);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ================================================================
# Method handlers
# ================================================================

# Append the MCP `capabilities` object advertised at initialize.
#
# Advertised keys are DERIVED from what bote actually implements, so we
# never advertise a capability we can't honor:
#   - `tools`: always — bote is a tool server (an empty registry is still
#     tool-capable).
#   - `prompts`: advertised iff the dispatcher has a PromptRegistry (i.e. at
#     least one prompt was registered — see dispatcher_register_prompt).
#   - `resources`: advertised iff the dispatcher has a ResourceRegistry (see
#     dispatcher_register_resource). `subscribe`/`listChanged` omitted — no
#     resource-mutation producer feeds them yet.
#   - `completions`: advertised iff a completion handler is set (see
#     dispatcher_set_completion).
#   - `listChanged` (tools + prompts): advertised ONLY when
#     dispatcher_notifications(d) == 1 — i.e. the transport wired a
#     server→client drain path (streamable's per-session buffers). The
#     register/dereg + prompt-register events already fire; the flag confirms
#     they actually reach a client. Kept OUT of core so stdio/http/ws (no
#     drain path) never promise notifications they can't deliver.
#   - logging: NOT YET — it exists only to gate `notifications/message`;
#     advertising it would promise log messages bote can't send.
#
# Version policy: every capability below exists across all supported
# protocol versions (2024-11-05 … 2025-11-25), so none is gated on the
# negotiated version. A version-exclusive capability would branch on the
# negotiated version passed in here.
fn _build_capabilities(sb, d) {
    return _build_capabilities_lc(sb, d, dispatcher_notifications(d));
}

# `lc` is whether listChanged may be promised, which needs a way to deliver it.
fn _build_capabilities_lc(sb, d, lc) { return _build_capabilities_sub(sb, d, lc, 0); }

# _build_capabilities_lc, and `resources.subscribe` when `sub` is 1 (3.7.4): only where a
# listen carries `resourceSubscriptions`. The legacy `initialize` never says it, having no
# `resources/subscribe`.
fn _build_capabilities_sub(sb, d, lc, sub) {
    str_builder_add_cstr(sb, "{\"tools\":{");
    if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
    str_builder_add_cstr(sb, "}");
    if (dispatcher_prompts(d) != 0) {
        str_builder_add_cstr(sb, ",\"prompts\":{");
        if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
        str_builder_add_cstr(sb, "}");
    }
    if (dispatcher_resources(d) != 0) {
        str_builder_add_cstr(sb, ",\"resources\":{");
        if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
        if (sub == 1) {
            if (lc == 1) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"subscribe\":true");
        }
        str_builder_add_cstr(sb, "}");
    }
    if (dispatcher_completion(d) != 0) {
        str_builder_add_cstr(sb, ",\"completions\":{}");
    }
    str_builder_add_cstr(sb, "}");
    return 0;
}

# Build the initialize response result body.
# {"name":...,"version":...}. Escaped since 3.4.6: both come from the embedder
# through dispatcher_set_server_info, and a quote in either broke the reply.
# serverInfo: `full` 1 for every field, as `initialize` and `server/discover` send it,
# and 0 for the name, the version and the title, as every other result's `_meta`.
fn _dsp_emit_server_info(sb, d, full) {
    var c = load64(d + 168);
    if (full == 1) { c = load64(d + 160); }
    if (c != 0) {
        str_builder_add_cstr(sb, c);
        return 0;
    }
    var sname = dispatcher_server_name(d);
    if (sname == 0) { sname = "bote"; }
    var sver = dispatcher_server_version(d);
    if (sver == 0) { sver = _bote_server_version(); }
    str_builder_add_cstr(sb, "{\"name\":\"");
    _json_emit_escaped(sb, sname);
    str_builder_add_cstr(sb, "\",\"version\":\"");
    _json_emit_escaped(sb, sver);
    str_builder_add_cstr(sb, "\"}");
    return 0;
}

fn _build_initialize_result_a(a, d, params_cstr) {
    var requested = jsonx_get_str_a(a, params_cstr, "protocolVersion");
    var negotiated = _mcp_latest_version();
    if (_mcp_is_supported(requested) == 1) { negotiated = requested; }

    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 512 + _dsp_server_info_room(d, 1) + _dsp_instructions_room(d));
    str_builder_add_cstr(sb, "{\"protocolVersion\":\"");
    str_builder_add_cstr(sb, negotiated);
    str_builder_add_cstr(sb, "\",\"capabilities\":");
    _build_capabilities(sb, d);
    str_builder_add_cstr(sb, ",\"serverInfo\":");
    _dsp_emit_server_info(sb, d, 1);
    var ins = load64(d + 152);
    if (ins != 0) { str_builder_add_cstr(sb, ins); }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# Build the prompts/list response result body.
fn _build_prompts_list_result(a, preg) {
    bote_reg_read();
    var names = prompt_registry_names(preg);
    var n = vec_len(names);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = _prompt_registry_get_u(preg, vec_get(names, i));
        room = room + 64 + _dsp_room(prompt_def_name(c)) + _dsp_room(prompt_def_description(c));
        room = room + _dsp_len(prompt_def_display(c));
        var cargs = prompt_def_arguments(c);
        if (cargs != 0) {
            var ci = 0;
            while (ci < vec_len(cargs)) {
                var carg = vec_get(cargs, ci);
                room = room + 64 + _dsp_room(prompt_arg_name(carg)) + _dsp_room(prompt_arg_description(carg));
                room = room + _dsp_len(prompt_arg_display(carg));
                ci = ci + 1;
            }
        }
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"prompts\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var p = _prompt_registry_get_u(preg, vec_get(names, i));
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "name", prompt_def_name(p));
        var pdisp = prompt_def_display(p);
        if (pdisp != 0) { str_builder_add_cstr(sb, pdisp); }
        var pd = prompt_def_description(p);
        if (pd != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", pd);
        }
        var pargs = prompt_def_arguments(p);
        if (pargs != 0 && vec_len(pargs) > 0) {
            str_builder_add_cstr(sb, ",\"arguments\":[");
            var na = vec_len(pargs);
            var ai = 0;
            while (ai < na) {
                if (ai > 0) { str_builder_add_cstr(sb, ","); }
                var parg = vec_get(pargs, ai);
                str_builder_add_cstr(sb, "{");
                _json_emit_str_field(sb, "name", prompt_arg_name(parg));
                var adisp = prompt_arg_display(parg);
                if (adisp != 0) { str_builder_add_cstr(sb, adisp); }
                var ad = prompt_arg_description(parg);
                if (ad != 0) {
                    str_builder_add_cstr(sb, ",");
                    _json_emit_str_field(sb, "description", ad);
                }
                if (prompt_arg_required(parg) == 1) {
                    str_builder_add_cstr(sb, ",\"required\":true");
                }
                str_builder_add_cstr(sb, "}");
                ai = ai + 1;
            }
            str_builder_add_cstr(sb, "]");
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Does tool `t` belong in a `profile`-filtered listing? A null profile means
# no filter was requested, so every tool matches (full listing, unchanged).
fn _tool_matches_profile(t, profile) {
    if (profile == 0) { return 1; }
    return tool_def_has_profile(t, profile);
}

# Build the tools/list response result body.
#
# `profile` (cstr or 0) is an OPTIONAL bote extension: when a client passes
# {"profile":"<tag>"} in tools/list params, only tools tagged with that
# profile are returned (exact-match). When absent (0), the full tool list is
# returned — byte-identical to pre-extension behavior.
# Room for one tool's entry in tools/list. The helpers that write it grow a
# builder on the heap, so this sizes the arena builder up front. A short
# estimate costs one growth on the heap, nothing worse.
fn _dsp_room(cstr) {
    if (cstr == 0) { return 0; }
    return 6 * strlen(cstr);
}

# The room for what is sent as it is kept, already escaped (3.8.1).
fn _dsp_len(cstr) {
    if (cstr == 0) { return 0; }
    return strlen(cstr);
}

fn _dsp_tool_list_room(t) {
    var n = 256 + _dsp_room(tool_def_name(t)) + _dsp_room(tool_def_description(t));
    n = n + _dsp_len(tool_def_display(t));
    n = n + _dsp_room(tool_def_version(t)) + _dsp_room(tool_def_deprecated(t));
    # The inputSchema as registration kept it (3.8.3), and each form of an outputSchema.
    n = n + _dsp_len(tool_def_input_json(t));
    var os = tool_def_output_json(t);
    if (os != 0) { n = n + 32 + strlen(os); }
    var ol = tool_def_output_legacy(t);
    if (ol != 0) { n = n + strlen(ol); }
    return n;
}

# `modern` is 1 for MCP 2026-07-28, which is shown an outputSchema as it was
# written, and 0 for the revisions before it, which are shown its object form.
fn _build_tools_list_result_a(a, reg, profile, modern) {
    bote_reg_read();
    var sb = str_builder_new_a(a);
    var room = 64;
    var rnames = registry_names(reg);
    var ri = 0;
    while (ri < vec_len(rnames)) {
        room = room + _dsp_tool_list_room(_registry_get_u(reg, vec_get(rnames, ri)));
        ri = ri + 1;
    }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"tools\":[");
    var n = vec_len(rnames);
    var i = 0;
    var emitted = 0;
    while (i < n) {
        var t = _registry_get_u(reg, vec_get(rnames, i));
        if (_tool_matches_profile(t, profile) == 0) {
            i = i + 1;
            continue;
        }
        if (emitted > 0) { str_builder_add_cstr(sb, ","); }
        emitted = emitted + 1;
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "name", tool_def_name(t));
        var tdisp = tool_def_display(t);
        if (tdisp != 0) { str_builder_add_cstr(sb, tdisp); }
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "description", tool_def_description(t));
        str_builder_add_cstr(sb, ",\"inputSchema\":");
        _emit_input_schema(sb, t);
        var os = tool_def_output_json(t);
        if (os != 0) {
            if (modern == 0 && tool_def_output_legacy(t) != 0) { os = tool_def_output_legacy(t); }
            str_builder_add_cstr(sb, ",\"outputSchema\":");
            str_builder_add_cstr(sb, os);
        }
        var v = tool_def_version(t);
        if (v != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "version", v);
        }
        var dep = tool_def_deprecated(t);
        if (dep != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "deprecated", dep);
        }
        _emit_annotations(sb, tool_def_annotations(t));
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Extract and validate the tool name from a tools/call request's params.
# Returns cstr (name) or 0; sets *err_out (BoteError ptr) on failure.
fn _extract_tool_name(params_cstr, err_out) {
    var name = jsonx_get_str(params_cstr, "name");
    if (name == 0 || strlen(name) == 0) {
        store64(err_out, bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field"));
        return 0;
    }
    store64(err_out, 0);
    return name;
}

# 1 when `sink` (an AuditSink or EventSink: +0 callback, +8 ctx) is installed
# with a callback, i.e. when audit_sink_log / event_sink_publish would call
# something. Both return early otherwise, so building what they would be
# handed is wasted work (3.4.1).
fn _dsp_sink_live(sink) {
    if (sink == 0) { return 0; }
    if (load64(sink) == 0) { return 0; }
    return 1;
}

# 1 when an event sink wants tool-call events: live, and not one that takes only
# tool-set changes (event_sink_set_list_only).
fn _dsp_sink_wants_calls(sink) {
    if (_dsp_sink_live(sink) == 0) { return 0; }
    if (load64(sink + 16) == 1) { return 0; }
    return 1;
}

# MCP's code for resources/read on a URI nothing serves (resources spec,
# "Error Handling"). It sits in JSON-RPC's server-defined range.
var BOTE_RPC_RESOURCE_NOT_FOUND = 0 - 32002;

# A failed tool call's result: {"content":[{"type":"text","text":"..."}],
# "isError":true}. Kept here rather than in content.cyr so the dispatcher
# needs no module it did not need before; content_text_error_response is
# the public name for it.
# A refused call is a call: the audit trail and the failed-call topic see it as
# they see one that failed in its handler. Copied to the heap, since a sink may
# keep what it is handed.
fn _dsp_record_refusal(d, name, params, plen, caller_pos, msg) {
    var audit_on = _dsp_sink_live(dispatcher_audit_sink(d));
    var events_on = _dsp_sink_wants_calls(dispatcher_event_sink(d));
    if (audit_on == 0 && events_on == 0) { return 0; }
    var h = default_alloc();
    var ev = tool_call_event_new(_slice_cstr(h, name, 0, strlen(name)), 0, 0,
      _slice_cstr(h, msg, 0, strlen(msg)), _jx_str_at_a(h, params, plen, caller_pos));
    if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev); }
    if (events_on == 1) {
        event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(), tool_call_event_to_json(ev));
    }
    return 0;
}

# `s` on one line. stdio and the Unix transport frame a message by its newline,
# and in valid JSON a raw LF or CR can only be whitespace between tokens, so a
# handler that pretty-prints cannot be allowed to split a response.
fn _dsp_one_line(a, s) {
    var n = strlen(s);
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 10 || c == 13) { break; }
        i = i + 1;
    }
    if (i == n) { return s; }
    var out = alloc_via(a, n + 1);
    var o = 0;
    i = 0;
    while (i < n) {
        var ch = load8(s + i);
        if (ch != 10 && ch != 13) { store8(out + o, ch); o = o + 1; }
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

# A prompt, resource or completion handler's result goes into the response as it
# stands, so it has to be JSON, on one line. Only tools/call checked this.
# A prompt's or a resource's result (3.8.2): valid JSON, and an InputRequiredResult judged.
fn _dsp_served_result(a, d, id, method, params, result, modern, claims) {
    if (jsonx_valid(result, strlen(result)) == 1 && _dsp_input_result(a, result) == 1) {
        return _dsp_input_out_a(a, d, id, method, params, _dsp_one_line(a, result), modern, claims);
    }
    return _dsp_checked_result(a, id, result);
}

fn _dsp_checked_result(a, id, result) {
    if (jsonx_valid(result, strlen(result)) == 0) {
        return resp_error_a(a, id, 0 - 32603, "internal error: the handler returned invalid JSON");
    }
    return resp_success_a(a, id, _dsp_one_line(a, result));
}

fn _dsp_tool_error_result(text) { return _dsp_tool_error_result_a(default_alloc(), text); }

fn _dsp_tool_error_result_a(a, text) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(text) * 6 + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}],\"isError\":true}");
    return str_data(str_builder_build_a(a, sb));
}

# A successful tool call's result carrying `text` as one text block (3.4.8), on `a`.
fn _dsp_tool_text_result_a(a, text) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, _dsp_room(text) + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}]}");
    return str_data(str_builder_build_a(a, sb));
}

# 1 when the n bytes at p equal cstr lit.
fn _dsp_bytes_eq(p, n, lit) {
    if (n != strlen(lit)) { return 0; }
    return memeq(p, lit, n);
}

# 1 when the n bytes at p name an MCP content block type (tools spec, "Tool
# Result").
fn _dsp_is_content_type(p, n) {
    if (_dsp_bytes_eq(p, n, "text") == 1 || _dsp_bytes_eq(p, n, "image") == 1) { return 1; }
    if (_dsp_bytes_eq(p, n, "audio") == 1 || _dsp_bytes_eq(p, n, "resource") == 1) { return 1; }
    if (_dsp_bytes_eq(p, n, "resource_link") == 1) { return 1; }
    return 0;
}

# 1 when the `n` bytes at `p`, a string's inside, decode to `lit` (3.8.2), compared as they
# decode, at any length (3.8.3): through 3.8.2 a value of 64 bytes or more was taken for
# none, and `input_required` written in escapes is 84, so such an InputRequiredResult went
# out unjudged and its state unsealed.
fn _dsp_str_dec_is(p, n, lit) {
    if (_jx_has_escape(p, n) == 0) { return _dsp_bytes_eq(p, n, lit); }
    return _jx_dec_eq(p, n, lit, strlen(lit));
}

# 1 when the `n` bytes at `p`, a string's inside, decode to an MCP content type (3.8.1):
# `"t\u0065xt"` is "text", to a client and so here. Through 3.8.0 the bytes were
# compared as written, so such a block went out as a text block holding its JSON; through
# 3.8.2 a value of 64 bytes or more was none, `resource_link` in escapes among them.
fn _dsp_type_is_content(p, n) {
    if (_jx_has_escape(p, n) == 0) { return _dsp_is_content_type(p, n); }
    if (_jx_dec_eq(p, n, "text", 4) == 1 || _jx_dec_eq(p, n, "image", 5) == 1) { return 1; }
    if (_jx_dec_eq(p, n, "audio", 5) == 1 || _jx_dec_eq(p, n, "resource", 8) == 1) { return 1; }
    if (_jx_dec_eq(p, n, "resource_link", 13) == 1) { return 1; }
    return 0;
}

# What a handler's result (valid JSON) is, from one pass over its top-level
# members, with nothing allocated: bit 1 when `content` is an array, bit 2
# when `isError` is true, bit 4 when `type` is an MCP content type. 0 for a
# result that is not an object. (3.8.0) Bit 8 when it has `structuredContent`,
# and bits 16, 32 and 64 when it names `content`, `structuredContent` or
# `isError` more than once. Its keys are read as the one key scanner reads them
# (_jx_scan): what they decode to, for a key under 256 bytes, where through 3.7.7
# `"is\u0045rror":true` was not an error here and was one to a client. `info`, a
# DspResult, gets where the first `content` and `structuredContent` values are.
var DSP_SHAPE_CONTENT = 1;
var DSP_SHAPE_ISERROR = 2;
var DSP_SHAPE_BLOCK = 4;
var DSP_SHAPE_SC = 8;
var DSP_SHAPE_TWICE_CONTENT = 16;
var DSP_SHAPE_TWICE_SC = 32;
var DSP_SHAPE_TWICE_ISERROR = 64;
var DSP_SHAPE_INPUT = 128;

# DspResult (24 bytes), what a tools/call result's handling knows of it: +0 the offset
# of its first `content` value, +8 of its first `structuredContent` value, each -1 for
# none, +16 its shape's bits. Filled by _dsp_coerce_result for the result it returns.
fn _dsp_info_set(info, cp, sp, flags) {
    store64(info, cp);
    store64(info + 8, sp);
    store64(info + 16, flags);
    return 0;
}

fn _dsp_result_shape(buf, info) {
    _dsp_info_set(info, 0 - 1, 0 - 1, 0);
    var len = strlen(buf);
    var i = _jx_skip_ws(buf, len, 0);
    if (i >= len || load8(buf + i) != 123) { return 0; }
    var flags = 0;
    var errs = 0;
    var dec[256];
    i = _jx_skip_ws(buf, len, i + 1);
    while (i < len && load8(buf + i) == 34) {
        var ks = i + 1;
        var ke = _jx_skip_string(buf, len, i);
        var klen = ke - ks - 1;
        var kp = buf + ks;
        if (klen > 0 && klen < 256 && _jx_has_escape(kp, klen) == 1) {
            klen = _jx_unescape_into(kp, klen, &dec);
            kp = &dec;
        }
        i = _jx_skip_ws(buf, len, ke);
        if (i >= len || load8(buf + i) != 58) { break; }
        var vs = _jx_skip_ws(buf, len, i + 1);
        var ve = _jx_skip_value(buf, len, vs);
        if (vs < len) {
            var vc = load8(buf + vs);
            if (_dsp_bytes_eq(kp, klen, "content") == 1) {
                if (load64(info) >= 0) { flags = flags | DSP_SHAPE_TWICE_CONTENT; } else { store64(info, vs); }
                if (vc == 91) { flags = flags | DSP_SHAPE_CONTENT; }
            } elif (_dsp_bytes_eq(kp, klen, "structuredContent") == 1) {
                if (load64(info + 8) >= 0) { flags = flags | DSP_SHAPE_TWICE_SC; } else { store64(info + 8, vs); }
                flags = flags | DSP_SHAPE_SC;
            } elif (_dsp_bytes_eq(kp, klen, "isError") == 1) {
                if (errs != 0) { flags = flags | DSP_SHAPE_TWICE_ISERROR; }
                errs = 1;
                if (vc == 116 && _dsp_bytes_eq(buf + vs, ve - vs, "true") == 1) { flags = flags | DSP_SHAPE_ISERROR; }
            } elif (vc == 34 && _dsp_bytes_eq(kp, klen, "type") == 1 && _dsp_type_is_content(buf + vs + 1, ve - vs - 2) == 1) {
                flags = flags | DSP_SHAPE_BLOCK;
            } elif (vc == 34 && _dsp_bytes_eq(kp, klen, "resultType") == 1 && _dsp_str_dec_is(buf + vs + 1, ve - vs - 2, "input_required") == 1) {
                # (3.8.2) An InputRequiredResult, which is no CallToolResult.
                flags = flags | DSP_SHAPE_INPUT;
            }
        }
        i = _jx_skip_ws(buf, len, ve);
        if (i < len && load8(buf + i) == 44) { i = _jx_skip_ws(buf, len, i + 1); }
    }
    store64(info + 16, flags);
    return flags;
}

# The CallToolResult the client gets for what tool `name`'s handler
# returned, and through *fail_out the failure message for the audit and the
# event (0 when the call succeeded). 3.4.8; through 3.4.7 a handler's return
# went out verbatim.
#   - nothing (0): a failed call, as since 3.4.5;
#   - not valid JSON: a failed call. The bytes are not sent, because they
#     would break the reply;
#   - an object whose `content` is an array: a CallToolResult already, sent
#     as it is. `"isError": true` in it makes the call a failure for the audit;
#   - one content block (an object whose `type` is an MCP content type):
#     lifted into a one-element `content` array;
#   - anything else (a bare record, an array, a number, a string): sent as a
#     text block holding the JSON text, so the model still sees the data.
# A domain object that happens to carry a `type` member ({"type":"person"})
# is not mistaken for a block: only the five content types lift. (3.8.0) For a
# tool `t` with an outputSchema, anything else is its structuredContent, with
# its JSON text in a text block (_dsp_tool_structured_result).
# What it builds is on `a` (3.8.0), and so is a failure's message, which goes
# to the heap as well when `keep` is 1, for a sink, which may keep it. Through 3.7.7
# all of it was on the heap, kept for good for each call.
fn _dsp_coerce_result(a, t, name, result, fail_out, keep, info) {
    store64(fail_out, 0);
    var why = 0;
    if (result == 0) {
        why = "the handler returned no result";
    } elif (jsonx_valid(result, strlen(result)) == 0) {
        why = "the handler returned a result that is not valid JSON";
    }
    # Each result built here starts {"content":[ and its content is at 11.
    if (why != 0) {
        var m = str_data(bote_err_format_a(a, bote_err_new_a(a, BOTE_ERR_EXEC_FAILED, name, why)));
        if (keep == 1) {
            store64(fail_out, _slice_cstr(default_alloc(), m, 0, strlen(m)));
        } else {
            store64(fail_out, m);
        }
        _dsp_info_set(info, 11, 0 - 1, DSP_SHAPE_CONTENT | DSP_SHAPE_ISERROR);
        return _dsp_tool_error_result_a(a, m);
    }
    result = _dsp_one_line(a, result);
    var shape = _dsp_result_shape(result, info);
    # (3.8.2) An InputRequiredResult goes on as it is, for the dispatcher to judge.
    if ((shape & DSP_SHAPE_INPUT) != 0) { return result; }
    if ((shape & DSP_SHAPE_CONTENT) != 0) {
        if ((shape & DSP_SHAPE_ISERROR) != 0) {
            store64(fail_out, "the tool reported an error (isError)");
        }
        return result;
    }
    if ((shape & DSP_SHAPE_BLOCK) != 0) {
        var sb = str_builder_new_a(a);
        _sb_grow_a(a, sb, strlen(result) + 16);
        str_builder_add_cstr(sb, "{\"content\":[");
        str_builder_add_cstr(sb, result);
        str_builder_add_cstr(sb, "]}");
        _dsp_info_set(info, 11, 0 - 1, DSP_SHAPE_CONTENT);
        return str_data(str_builder_build_a(a, sb));
    }
    if (t != 0 && tool_def_output_prop(t) != 0) {
        var st = _dsp_tool_structured_result_a(a, result);
        _dsp_info_set(info, 11, strlen(st) - strlen(result) - 1, DSP_SHAPE_CONTENT | DSP_SHAPE_SC);
        return st;
    }
    _dsp_info_set(info, 11, 0 - 1, DSP_SHAPE_CONTENT);
    return _dsp_tool_text_result_a(a, result);
}

# `v`, a bare value a handler returned, as the structured result of a tool with an
# outputSchema (3.8.0): structuredContent, and its JSON in a text block, which the
# tools spec says a tool returning structured content SHOULD also send.
fn _dsp_tool_structured_result_a(a, v) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 7 * strlen(v) + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    _json_emit_escaped(sb, v);
    str_builder_add_cstr(sb, "\"}],\"structuredContent\":");
    str_builder_add_cstr(sb, v);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# 1 when the content array at buf[cp] holds a text block, or is no array, which
# leaves nothing to add a block to.
fn _dsp_has_text_block(a, buf, n, cp) {
    if (cp < 0 || load8(buf + cp) != 91) { return 1; }
    var i = _jx_skip_ws(buf, n, cp + 1);
    while (i < n && load8(buf + i) != 93) {
        var e = _jx_skip_value(buf, n, i);
        var tp = _jx_find_value_pos(buf + i, e - i, "type");
        var ty = _jx_str_dec_at_a(a, buf + i, e - i, tp);
        if (ty != 0 && streq(ty, "text") == 1) { return 1; }
        i = _jx_array_next(buf, n, i);
    }
    return 0;
}

# `result` rebuilt with its structuredContent, the value at buf[sp], as
# {"result": value} when `wrap` is 1, and with a text block holding that value's
# JSON added to its content when `text` is 1. Its other members are as they were,
# each key written as it was, and a second structuredContent goes with the first.
fn _dsp_result_rebuild_a(a, result, n, sp, wrap, text) {
    var sc = _jx_raw_at_a(a, result, n, sp);
    var m = _jx_members_raw_a(a, result);
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 2 * n + 6 * strlen(sc) + 64);
    str_builder_add_cstr(sb, "{");
    var sep = 0;
    var did_text = 0;
    var i = 0;
    while (i < vec_len(m)) {
        var k = vec_get(m, i);
        var kr = vec_get(m, i + 1);
        var v = vec_get(m, i + 2);
        i = i + 3;
        # A key that decodes to hold a NUL names nothing bote reads.
        if (k == 0) { k = ""; }
        if (streq(k, "structuredContent") == 1) { continue; }
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        sep = 1;
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, kr);
        str_builder_add_cstr(sb, "\":");
        if (text == 1 && did_text == 0 && streq(k, "content") == 1) {
            did_text = 1;
            var vn = strlen(v);
            var close = vn - 1;
            while (close > 0 && load8(v + close) != 93) { close = close - 1; }
            var inner = _jx_skip_ws(v, close, 1);
            store8(v + close, 0);
            str_builder_add_cstr(sb, v);
            if (inner < close) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"type\":\"text\",\"text\":\"");
            bote_json_escape(sb, sc);
            str_builder_add_cstr(sb, "\"}]");
        } else {
            str_builder_add_cstr(sb, v);
        }
    }
    if (sep == 1) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"structuredContent\":");
    if (wrap == 1) { str_builder_add_cstr(sb, "{\"result\":"); }
    str_builder_add_cstr(sb, sc);
    if (wrap == 1) { str_builder_add_cstr(sb, "}"); }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# One WARN for a result refused by its tool's outputSchema: the handler's bug, for
# the operator. The reason is bote's own words; the violations, which may quote the
# result, go to the client and never to the log.
fn _dsp_log_output_refused(name, reason) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "tool result refused");
    bote_log_str(&ln, "tool", name);
    bote_log_str(&ln, "reason", reason);
    bote_log_emit(&ln);
    return 0;
}

# What the client is sent for `result`, the CallToolResult of a call to tool `t`
# (3.8.0). *fail_out is the failure _dsp_coerce_result found, which a result its
# tool's outputSchema refuses replaces: on the heap when `keep` is 1, for a sink.
#   - A tool with an outputSchema: a result that is no error must carry
#     structuredContent, and it must match ("Servers MUST provide structured
#     results that conform to this schema", the tools spec). One that does not is
#     a tool execution error, as an argument failing the inputSchema is, and its
#     bytes are not sent. Nor is one naming content, structuredContent or isError
#     twice: bote judges the first, and a client may read the last.
#   - structuredContent that is no object gets a text block holding its JSON when
#     the result has none, on every revision (SEP-2106 §4.3, as the official SDK).
#   - Before 2026-07-28 structuredContent is an object: anything else, and all
#     structuredContent of a tool whose outputSchema has no object at its root,
#     goes as {"result": value}, which is what that tool's listed schema says.
# `info` is the DspResult _dsp_coerce_result filled for `result`: a result with no
# structuredContent, from a tool with no outputSchema, costs nothing more here.
fn _dsp_tool_result_out_a(a, t, name, result, fail_out, modern, keep, info) {
    var cp = load64(info);
    var sp = load64(info + 8);
    var flags = load64(info + 16);
    if ((flags & DSP_SHAPE_INPUT) != 0) { return result; }
    var prop = 0;
    if (t != 0) { prop = tool_def_output_prop(t); }
    # A result naming one of the three twice is refused from every tool (3.8.1), with an
    # outputSchema or not: bote shapes and audits the first, and a client reads the last.
    var twice = 0;
    if ((flags & DSP_SHAPE_TWICE_CONTENT) != 0) { twice = "content"; }
    elif ((flags & DSP_SHAPE_TWICE_SC) != 0) { twice = "structuredContent"; }
    elif ((flags & DSP_SHAPE_TWICE_ISERROR) != 0) { twice = "isError"; }
    if (prop == 0 && sp < 0 && twice == 0) { return result; }
    var n = strlen(result);
    var why = 0;
    var reason = 0;
    if (twice != 0) {
        reason = "the result names a member twice";
        why = _dsp_named_msg_a(a, "the result names ", twice, " more than once");
    } elif (prop != 0 && (flags & DSP_SHAPE_ISERROR) == 0 && sp < 0) {
        reason = "no structuredContent";
        why = "the tool has an outputSchema and the result has no structuredContent";
    } elif (prop != 0 && (flags & DSP_SHAPE_ISERROR) == 0) {
        var sc = _jx_raw_at_a(a, result, n, sp);
        # A key named twice in any object of it (3.8.1): the schema would judge the first.
        # Or one a client reads another way (3.8.2).
        if (_jx_repeats_a(a, sc, 0) == 1) {
            reason = "structuredContent names a member twice";
            why = "the result's structuredContent names a member twice in one object, or one a client would read another way";
        } else {
            var vs = _sch_check_value_a(a, prop, "structuredContent", sc);
            if (vs != 0) {
                reason = "structuredContent does not match the outputSchema";
                var vb = str_builder_new_a(a);
                str_builder_add_cstr_a(a, vb, "the result's structuredContent does not match the outputSchema: ");
                var vi = 0;
                while (vi < vec_len(vs)) {
                    if (vi > 0) { str_builder_add_cstr_a(a, vb, "; "); }
                    str_builder_add_cstr_a(a, vb, vec_get(vs, vi));
                    vi = vi + 1;
                }
                why = str_data(str_builder_build_a(a, vb));
            }
        }
    }
    if (why != 0) {
        _dsp_log_output_refused(name, reason);
        var msg = str_data(bote_err_format_a(a, bote_err_new_a(a, BOTE_ERR_EXEC_FAILED, name, why)));
        if (keep == 1) {
            store64(fail_out, _slice_cstr(default_alloc(), msg, 0, strlen(msg)));
        } else {
            store64(fail_out, msg);
        }
        return _dsp_tool_error_result_a(a, msg);
    }
    if (sp < 0) { return result; }
    var obj = 0;
    if (load8(result + sp) == 123) { obj = 1; }
    var wrap = 0;
    if (modern == 0 && (obj == 0 || (t != 0 && tool_def_output_legacy(t) != 0))) { wrap = 1; }
    var text = 0;
    if (obj == 0 && _dsp_has_text_block(a, result, n, cp) == 0) { text = 1; }
    if (wrap == 0 && text == 0) { return result; }
    return _dsp_result_rebuild_a(a, result, n, sp, wrap, text);
}

# 1 when a list request's params carry a non-null `cursor`. bote returns
# every item in one page and never issues a cursor, so any cursor a client
# sends is one it was never given. The pagination spec says an invalid
# cursor SHOULD be -32602 (3.4.5). Through 3.4.4 it was ignored and the
# first page went out again, which a client joining pages would take as
# duplicates. A null cursor is read as absent, like a null params.
fn _dsp_cursor_given(params) {
    if (params == 0) { return 0; }
    var c = jsonx_get_raw_a(bote_req_alloc(), params, "cursor");
    if (c == 0) { return 0; }
    if (load8(c) == 110) { return 0; }
    return 1;
}

fn _dsp_cursor_refusal_a(a, id) {
    return resp_error_a(a, id, 0 - 32602, "invalid cursor: this server returns every item in one page and issues no cursors");
}

# prefix + name + suffix as one message cstr; suffix may be 0.
fn _dsp_named_msg(prefix, name, suffix) { return _dsp_named_msg_a(default_alloc(), prefix, name, suffix); }

fn _dsp_named_msg_a(a, prefix, name, suffix) {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, prefix);
    if (name != 0) { str_builder_add_cstr_a(a, sb, name); }
    if (suffix != 0) { str_builder_add_cstr_a(a, sb, suffix); }
    return str_data(str_builder_build_a(a, sb));
}

# The first argument `pdef` declares required that `args_obj` (a JSON
# object) lacks, or 0 when none is missing.
fn _prompt_missing_required(pdef, args_obj) {
    if (pdef == 0) { return 0; }
    var pa = prompt_def_arguments(pdef);
    if (pa == 0) { return 0; }
    var n = vec_len(pa);
    var i = 0;
    while (i < n) {
        var a = vec_get(pa, i);
        if (prompt_arg_required(a) == 1 && jsonx_has(args_obj, prompt_arg_name(a)) == 0) {
            return prompt_arg_name(a);
        }
        i = i + 1;
    }
    return 0;
}

# Build the resources/list response result body.
fn _build_resources_list_result(a, rreg) {
    bote_reg_read();
    var uris = resource_registry_uris(rreg);
    var n = vec_len(uris);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = _resource_registry_get_u(rreg, vec_get(uris, i));
        room = room + 64 + _dsp_room(resource_def_uri(c)) + _dsp_room(resource_def_name(c));
        room = room + _dsp_room(resource_def_description(c)) + _dsp_room(resource_def_mime_type(c));
        room = room + _dsp_len(resource_def_display(c));
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resources\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var r = _resource_registry_get_u(rreg, vec_get(uris, i));
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "uri", resource_def_uri(r));
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "name", resource_def_name(r));
        var rdisp = resource_def_display(r);
        if (rdisp != 0) { str_builder_add_cstr(sb, rdisp); }
        var rd = resource_def_description(r);
        if (rd != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", rd);
        }
        var rm = resource_def_mime_type(r);
        if (rm != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "mimeType", rm);
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Build the resources/templates/list response result body.
fn _build_resource_templates_result(a, rreg) {
    bote_reg_read();
    var ts = resource_registry_templates(rreg);
    var n = vec_len(ts);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = vec_get(ts, i);
        room = room + 64 + _dsp_room(resource_template_uri(c)) + _dsp_room(resource_template_name(c));
        room = room + _dsp_room(resource_template_description(c)) + _dsp_room(resource_template_mime_type(c));
        room = room + _dsp_len(resource_template_display(c));
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resourceTemplates\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var t = vec_get(ts, i);
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "uriTemplate", resource_template_uri(t));
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "name", resource_template_name(t));
        var tdis = resource_template_display(t);
        if (tdis != 0) { str_builder_add_cstr(sb, tdis); }
        var td = resource_template_description(t);
        if (td != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", td);
        }
        var tm = resource_template_mime_type(t);
        if (tm != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "mimeType", tm);
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# ================================================================
# dispatch — main entry
# ================================================================
#
# Returns a JsonRpcResponse ptr, or 0 if the request is a notification.

fn dispatcher_dispatch(d, request, claims) {
    return dispatcher_dispatch_a(default_alloc(), d, request, claims);
}

# ================================================================
# MCP 2026-07-28 (3.5.0)
#
# bote serves this revision and the older ones from one process. Each request
# says which it is: `_meta` naming this revision is served statelessly, and
# anything else as it always was. A dual-era client probes with server/discover
# and falls back to `initialize` on any error it does not recognise, so a legacy
# client never sees this path.
#
# The methods are the same code on both paths. A modern result differs by what
# surrounds it: resultType on all of them, `ttlMs` and `cacheScope` on the list
# results and resources/read, and serverInfo in `_meta`.
#
# ttlMs is 0, which tells a client to re-fetch: a promise that a list stays fresh
# needs a way to say it changed, and that is subscriptions/listen (roadmap 3.7.x).
# For the same reason, this path advertises no listChanged. cacheScope is
# "private" because a tool list may differ per authorization context.
# ================================================================

var DSP_META_VERSION = "io.modelcontextprotocol/protocolVersion";
var DSP_META_CAPABILITIES = "io.modelcontextprotocol/clientCapabilities";

# `full` as _dsp_emit_server_info's: 1 on server/discover, 0 on every other result.
fn _dsp_emit_modern_meta(sb, d, full) {
    str_builder_add_cstr(sb, "\"_meta\":{\"io.modelcontextprotocol/serverInfo\":");
    _dsp_emit_server_info(sb, d, full);
    str_builder_add_cstr(sb, "}");
    return 0;
}

fn _build_discover_result_a(a, d) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 512 + _dsp_server_info_room(d, 1) + _dsp_instructions_room(d));
    str_builder_add_cstr(sb, "{\"resultType\":\"complete\",\"supportedVersions\":");
    _mcp_emit_versions(sb);
    str_builder_add_cstr(sb, ",\"capabilities\":");
    # The changes a listen stream carries, where this message's transport carries one
    # (3.7.2; 3.7.3).
    var lc = _dsp_listen_here(d);
    _build_capabilities_sub(sb, d, lc, lc);
    var ins = load64(d + 152);
    if (ins != 0) { str_builder_add_cstr(sb, ins); }
    str_builder_add_cstr(sb, ",");
    _dsp_emit_modern_meta(sb, d, 1);
    str_builder_add_cstr(sb, ",\"ttlMs\":0,\"cacheScope\":\"private\"}");
    return str_data(str_builder_build_a(a, sb));
}

# -32022, naming what bote does serve, so a client can pick from it.
fn _dsp_unsupported_version(a, id, requested) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128 + strlen(requested) * 6);
    str_builder_add_cstr(sb, "{\"supported\":");
    _mcp_emit_versions(sb);
    str_builder_add_cstr(sb, ",\"requested\":\"");
    _json_emit_escaped(sb, requested);
    str_builder_add_cstr(sb, "\"}");
    return resp_error_data_a(a, id, 0 - 32022, "Unsupported protocol version", str_data(str_builder_build_a(a, sb)));
}

fn _dsp_cacheable(method) {
    if (streq(method, "tools/list") == 1) { return 1; }
    if (streq(method, "prompts/list") == 1) { return 1; }
    if (streq(method, "resources/list") == 1) { return 1; }
    if (streq(method, "resources/templates/list") == 1) { return 1; }
    if (streq(method, "resources/read") == 1) { return 1; }
    return 0;
}

# `result` with this revision's fields added. What a handler already set is left
# alone: a repeated key would make the object ambiguous.
fn _dsp_modern_result(a, d, method, result) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(result) + 256 + _dsp_server_info_room(d, 0));
    str_builder_add_cstr(sb, "{");
    var sep = "";
    if (jsonx_has(result, "resultType") == 0) {
        str_builder_add_cstr(sb, "\"resultType\":\"complete\"");
        sep = ",";
    }
    # (3.8.2) An InputRequiredResult is no answer to keep.
    if (_dsp_cacheable(method) == 1 && jsonx_has(result, "ttlMs") == 0 && _dsp_input_result(a, result) == 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"ttlMs\":0,\"cacheScope\":\"private\"");
        sep = ",";
    }
    if (jsonx_has(result, "_meta") == 0) {
        str_builder_add_cstr(sb, sep);
        _dsp_emit_modern_meta(sb, d, 0);
        sep = ",";
    }
    var n = strlen(result);
    var i = _jx_skip_ws(result, n, 0) + 1;
    i = _jx_skip_ws(result, n, i);
    if (load8(result + i) != 125) { str_builder_add_cstr(sb, sep); }
    str_builder_add_cstr(sb, result + i);
    return str_data(str_builder_build_a(a, sb));
}

fn _dsp_modern_response(a, d, method, resp) {
    if (resp == 0) { return 0; }
    var err = resp_error_obj(resp);
    if (err != 0) {
        # -32002 is the older revisions' resource-not-found. This one uses
        # -32602, and must not emit -32002 at all.
        if (rpc_err_code(err) == BOTE_RPC_RESOURCE_NOT_FOUND) { store64(err, 0 - 32602); }
        return resp;
    }
    var result = resp_result(resp);
    if (jsonx_is_object(result) == 0) {
        return resp_error_a(a, resp_id(resp), 0 - 32603, "internal error: the handler's result is not an object");
    }
    return resp_success_a(a, resp_id(resp), _dsp_modern_result(a, d, method, result));
}

# What a call gets where HTTP's 403 is out of reach: a batch element, a WebSocket frame.
# Outside the JSON-RPC reserved range, as MCP asks of a code it does not define.
var BOTE_RPC_INSUFFICIENT_SCOPE = 0 - 31403;

# `req`, a vec of scopes, when `claims` does not hold them all, or 0. Each caller has
# returned for claims of 0 first: with no token in play there is nothing to compare, as
# on stdio, which takes its credentials from the environment, and with no validator set.
# A scope required with nothing to read it is refused, not waved through.
fn _dsp_scopes_lacking(d, req, claims) {
    if (req == 0 || vec_len(req) == 0) { return 0; }
    var fp = load64(d + 88);
    if (fp == 0) { return req; }
    var i = 0;
    while (i < vec_len(req)) {
        if (fncall3(fp, claims, vec_get(req, i), load64(d + 96)) != 1) { return req; }
        i = i + 1;
    }
    return 0;
}

# The scopes the tool `name` requires, when `claims` does not hold them all, or 0 when
# it may run, or no such tool is registered.
fn dispatcher_scopes_missing(d, name, claims) {
    if (claims == 0) { return 0; }
    return _dsp_def_scopes_missing(d, registry_get(dispatcher_registry(d), name), claims);
}

# The same for the tool definition `t` a call found, or 0 for none.
fn _dsp_def_scopes_missing(d, t, claims) {
    if (claims == 0 || t == 0) { return 0; }
    return _dsp_scopes_lacking(d, tool_def_required_scopes(t), claims);
}

# The same for the prompt `name` (3.6.6).
fn dispatcher_prompt_scopes_missing(d, name, claims) {
    if (claims == 0 || name == 0 || dispatcher_prompts(d) == 0) { return 0; }
    var p = prompt_registry_get(dispatcher_prompts(d), name);
    if (p == 0) { return 0; }
    return _dsp_scopes_lacking(d, prompt_def_required_scopes(p), claims);
}

# The same for reading `uri`, judged by what would serve it, as resources/read finds that:
# the handler of the resource registered at that URI, else the first template it matches
# (3.6.6). A resource registered with no handler is served by the template, and so is
# judged by it (3.7.0): it was judged by the resource, which may require nothing, and
# served by a template that required a scope.
fn dispatcher_resource_scopes_missing(d, uri, claims) {
    if (claims == 0 || uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var fp[8];
    return _dsp_scopes_lacking(d, resource_registry_serving(dispatcher_resources(d), uri, &fp), claims);
}

# The same for a completion/complete's `ref`, on `a` (3.6.6): a completion offers what a
# prompt's arguments or a template's variables may be, which is the prompt's or the
# template's to grant. ref/prompt names a prompt; ref/resource names a template by its
# uriTemplate, or a URI, judged as resources/read would.
fn dispatcher_completion_scopes_missing_a(a, d, params, claims) {
    if (claims == 0 || params == 0) { return 0; }
    var ref = jsonx_get_raw_a(a, params, "ref");
    if (ref == 0) { return 0; }
    var kind = jsonx_get_str_dec_a(a, ref, "type");
    if (kind == 0) { return 0; }
    if (streq(kind, "ref/prompt") == 1) {
        return dispatcher_prompt_scopes_missing(d, jsonx_get_str_dec_a(a, ref, "name"), claims);
    }
    if (streq(kind, "ref/resource") == 0) { return 0; }
    var uri = jsonx_get_str_dec_a(a, ref, "uri");
    if (uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var t = resource_registry_template_named(dispatcher_resources(d), uri);
    if (t != 0) { return _dsp_scopes_lacking(d, resource_template_required_scopes(t), claims); }
    return dispatcher_resource_scopes_missing(d, uri, claims);
}

# Named, because HTTP sends this one -32602 as a 400.
var DSP_CAPS_MISSING = "io.modelcontextprotocol/clientCapabilities is required and must be an object";

# ================================================================
# Multi round-trip requests (3.8.2, MCP 2026-07-28)
# ================================================================

# 1 when `method` may be answered with an InputRequiredResult.
fn _dsp_input_method(method) {
    if (streq(method, "tools/call") == 1) { return 1; }
    if (streq(method, "prompts/get") == 1) { return 1; }
    if (streq(method, "resources/read") == 1) { return 1; }
    return 0;
}

# `v`, a JSON value already checked, on `a` with the spacing between its tokens left out,
# so a client that sends the same value again, compact or pretty, sends the same bytes.
fn _dsp_compact_a(a, v) {
    var n = strlen(v);
    var out = alloc_via(a, n + 1);
    var o = 0;
    var i = 0;
    var instr = 0;
    while (i < n) {
        var c = load8(v + i);
        if (instr == 1) {
            store8(out + o, c);
            o = o + 1;
            if (c == 92 && i + 1 < n) {
                store8(out + o, load8(v + i + 1));
                o = o + 1;
                i = i + 1;
            } elif (c == 34) {
                instr = 0;
            }
        } elif (c != 32 && c != 9 && c != 10 && c != 13) {
            if (c == 34) { instr = 1; }
            store8(out + o, c);
            o = o + 1;
        }
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

fn _dsp_bind_part(sb, p) {
    str_builder_add_int(sb, strlen(p));
    str_builder_add_cstr(sb, ":");
    str_builder_add_cstr(sb, p);
    return 0;
}

# What a requestState is bound to, on `a` (3.8.3): the request it was made for and who made
# it, as the spec asks, each part its length and then its bytes, so no part can borrow from
# the next. The request is its method, its target (the tool's or the prompt's name, the
# resource's URI) and its arguments, compact; a retry sends the request again with the
# answers and the state, which are not bound. Who made it is the principal the dispatcher's
# principal function names (dispatcher_set_state_principal), else the token the request
# presented, else no one when the request has no claims. 0 when it has claims and neither
# names anyone: a state bound to no one would open for anyone who holds it.
# Through 3.8.2 the binding was the method, the target and the token, one to a line, so a
# state opened with other arguments, and with claims that were not the token it opened for
# anyone.
fn _dsp_state_binding_a(a, d, method, params, claims) {
    var key = "name";
    if (streq(method, "resources/read") == 1) { key = "uri"; }
    var target = 0;
    if (params != 0) { target = jsonx_get_str_dec_a(a, params, key); }
    if (target == 0) { target = ""; }
    var kind = "n";
    var who = "";
    var p = 0;
    if (load64(d + 200) != 0 && claims != 0) { p = fncall3(load64(d + 200), load64(d + 208), a, claims); }
    if (p != 0) {
        kind = "p";
        who = p;
    } elif (bote_req_token() != 0) {
        kind = "t";
        who = bote_req_token();
    } elif (claims != 0) {
        return 0;
    }
    var args = "{}";
    if (params != 0 && streq(method, "resources/read") == 0) {
        var ar = jsonx_get_raw_a(a, params, "arguments");
        if (ar != 0) { args = _dsp_compact_a(a, ar); }
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(method) + strlen(target) + strlen(who) + strlen(args) + 96);
    _dsp_bind_part(sb, method);
    _dsp_bind_part(sb, target);
    str_builder_add_cstr(sb, kind);
    _dsp_bind_part(sb, who);
    _dsp_bind_part(sb, args);
    return str_data(str_builder_build_a(a, sb));
}

# Before a 2026-07-28 request is served: what its handler may ask of it, and, on a retry,
# its answers and state judged. A response refusing it, or 0. `inputResponses` is an
# object of the client's results, each an object; `requestState` a string the sealer opens
# for this request and who makes it (_dsp_state_binding_a, with `claims`). The spec makes
# the state attacker-controlled, and a state that does not open is refused here, before any
# handler sees it.
fn _dsp_input_admit_a(a, d, id, method, params, caps, claims) {
    if (_dsp_input_method(method) == 0) {
        bote_req_set_input(caps, 0, 0, 0);
        return 0;
    }
    var payload = 0;
    var answers = 0;
    if (params != 0) {
        var ir = jsonx_get_raw_a(a, params, "inputResponses");
        if (ir != 0) {
            var bad = 0;
            if (jsonx_is_object(ir) == 0) { bad = 1; }
            else {
                # (3.8.4) Each member by its key as written: the walker's pairs leave out one
                # whose key decodes to hold a NUL, which passed unjudged.
                var m = _jx_members_raw_a(a, ir);
                var i = 0;
                while (i < vec_len(m)) {
                    if (vec_get(m, i) == 0 || jsonx_is_object(vec_get(m, i + 2)) == 0) { bad = 1; }
                    i = i + 3;
                }
            }
            if (bad == 1) {
                return resp_error_a(a, id, 0 - 32602, "inputResponses must be an object of the client's results, each an object");
            }
            answers = ir;
        }
        var rs = jsonx_get_raw_a(a, params, "requestState");
        if (rs != 0) {
            var st = jsonx_get_str_dec_a(a, params, "requestState");
            if (st == 0) { return resp_error_a(a, id, 0 - 32602, "requestState must be a string"); }
            var open_fp = load64(d + 184);
            if (open_fp == 0) {
                return resp_error_a(a, id, 0 - 32602, "requestState cannot be verified: this server issues none");
            }
            var obind = _dsp_state_binding_a(a, d, method, params, claims);
            if (obind == 0) {
                _dsp_log_input(method, "requestState bound to no one: the claims name no principal");
                return resp_error_a(a, id, 0 - 32602, "requestState cannot be verified: this request's claims name no one it could be bound to");
            }
            payload = fncall4(open_fp, load64(d + 192), a, obind, st);
            if (payload == 0) {
                _dsp_log_input(method, "requestState did not open");
                return resp_error_a(a, id, 0 - 32602, "requestState did not pass its integrity check, or has expired, or was made for another request");
            }
        }
    }
    bote_req_set_input(caps, 1, payload, answers);
    return 0;
}

fn _dsp_log_input(method, reason) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "input required refused");
    bote_log_str(&ln, "method", method);
    bote_log_str(&ln, "reason", reason);
    bote_log_emit(&ln);
    return 0;
}

# 1 when the handler's result `r` (valid JSON) says it is an InputRequiredResult, in any of
# its `resultType` members (3.8.3): through 3.8.2 a prompt's, a resource's or a
# completion's result was read by its first, and a client reads its last, so
# `"resultType":"complete","resultType":"input_required"` went out unjudged, its state
# unsealed. One that names it twice is then refused by _dsp_input_out_a.
fn _dsp_input_result(a, r) {
    var info[24];
    if ((_dsp_result_shape(r, &info) & DSP_SHAPE_INPUT) != 0) { return 1; }
    return 0;
}

# What the client is sent for `result`, an InputRequiredResult a handler of `method`
# returned (3.8.2): a response, the result with its state sealed, or the error that refuses
# it. An older revision has no InputRequiredResult: a tool answers with a tool error there
# and anything else with -32603. A handler's mistake is -32603 and a WARN; an input request
# the client did not declare it can take is -32021, naming what it lacks, as the spec says a
# server MUST answer when it would need a capability the client did not declare.
fn _dsp_input_out_a(a, d, id, method, params, result, modern, claims) {
    if (modern == 0 || bote_input_possible() == 0) {
        _dsp_log_input(method, "no input can be asked on this revision or method");
        if (streq(method, "tools/call") == 1) {
            return resp_success_a(a, id, _dsp_tool_error_result_a(a, "the tool needs input, which this protocol revision cannot ask the client for"));
        }
        return resp_error_a(a, id, 0 - 32603, "internal error: the handler asked for input, which this request cannot carry");
    }
    if (_jx_repeats_a(a, result, 0) == 1) {
        _dsp_log_input(method, "a key named twice");
        return resp_error_a(a, id, 0 - 32603, "internal error: the InputRequiredResult names a key twice in one object, or one a client would read another way");
    }
    var reqs = jsonx_get_raw_a(a, result, "inputRequests");
    var st = jsonx_get_raw_a(a, result, "requestState");
    # (3.8.3) Every request, each by its key as written: the walker's pairs leave out a
    # member whose key decodes to hold a NUL, and such a request went out unjudged.
    var m = 0;
    if (reqs != 0 && jsonx_is_object(reqs) == 1) { m = _jx_members_raw_a(a, reqs); }
    var nreq = 0;
    if (m != 0) { nreq = vec_len(m) / 3; }
    if ((reqs != 0 && m == 0) || (st != 0 && load8(st) != 34) || (nreq == 0 && st == 0)) {
        _dsp_log_input(method, "no input requests and no state");
        return resp_error_a(a, id, 0 - 32603, "internal error: an InputRequiredResult holds inputRequests, an object of one or more, or requestState, a string, or both");
    }
    # Each request the spec allows, in the shape a client parses, and the capability it
    # needs, gathered.
    var need = 0;
    var i = 0;
    while (i < nreq * 3) {
        if (vec_get(m, i) == 0) {
            _dsp_log_input(method, "an input request keyed with a NUL");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request's key holds a NUL");
        }
        var rq = vec_get(m, i + 2);
        var rm = 0;
        if (jsonx_is_object(rq) == 1) { rm = jsonx_get_str_dec_a(a, rq, "method"); }
        if (rm == 0) {
            _dsp_log_input(method, "an input request with no method");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request is an object naming its method");
        }
        var rp = jsonx_get_raw_a(a, rq, "params");
        # (3.8.3) A client requires params, an object, of an elicitation and a sampling
        # request, and allows them on roots/list.
        var popt = streq(rm, "roots/list");
        if ((rp == 0 && popt == 0) || (rp != 0 && jsonx_is_object(rp) == 0)) {
            _dsp_log_input(method, "an input request without its params");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request's params are an object, and elicitation/create and sampling/createMessage need them");
        }
        if (streq(rm, "elicitation/create") == 1) {
            var mode = jsonx_get_str_dec_a(a, rp, "mode");
            if (jsonx_has(rp, "mode") == 1 && mode == 0) {
                _dsp_log_input(method, "an elicitation of an unknown mode");
                return resp_error_a(a, id, 0 - 32603, "internal error: an elicitation's mode is form or url");
            }
            if (mode == 0 || streq(mode, "form") == 1) {
                if (bote_client_has("elicitation.form") == 0) { need = need | 1; }
            } elif (streq(mode, "url") == 1) {
                if (bote_client_has("elicitation.url") == 0) { need = need | 2; }
            } else {
                _dsp_log_input(method, "an elicitation of an unknown mode");
                return resp_error_a(a, id, 0 - 32603, "internal error: an elicitation's mode is form or url");
            }
        } elif (streq(rm, "sampling/createMessage") == 1) {
            if (bote_client_has("sampling") == 0) { need = need | 4; }
            elif (jsonx_has(rp, "tools") == 1 && bote_client_has("sampling.tools") == 0) { need = need | 8; }
        } elif (popt == 1) {
            if (bote_client_has("roots") == 0) { need = need | 16; }
        } else {
            _dsp_log_input(method, "an input request the spec does not allow");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request is elicitation/create, sampling/createMessage or roots/list");
        }
        i = i + 3;
    }
    if (need != 0) { return _dsp_missing_caps_a(a, id, need); }
    if (st == 0) { return resp_success_a(a, id, result); }
    # The state, sealed, in place of the handler's.
    var seal_fp = load64(d + 176);
    if (seal_fp == 0) {
        _dsp_log_input(method, "requestState with no sealer");
        return resp_error_a(a, id, 0 - 32603, "internal error: requestState needs a sealer (dispatcher_set_state_sealer)");
    }
    var sbind = _dsp_state_binding_a(a, d, method, params, claims);
    if (sbind == 0) {
        _dsp_log_input(method, "requestState bound to no one: the claims name no principal");
        return resp_error_a(a, id, 0 - 32603, "internal error: requestState cannot be bound to who is asking: the claims name no principal (dispatcher_set_state_principal)");
    }
    var payload = jsonx_get_str_dec_a(a, result, "requestState");
    var sealed = fncall4(seal_fp, load64(d + 192), a, sbind, payload);
    if (sealed == 0) {
        _dsp_log_input(method, "the sealer refused the state");
        return resp_error_a(a, id, 0 - 32603, "internal error: requestState could not be sealed");
    }
    var mem = _jx_members_raw_a(a, result);
    var sb = str_builder_new_a(a);
    # Room for the sealed state as it is escaped: a sealer is the dispatcher's to choose, and
    # most write Base64url, which escaping leaves as it is. At 3.8.2 the room was six times
    # the state for every sealer.
    var sroom = strlen(sealed);
    if (_dsp_needs_escape(sealed) == 1) { sroom = 6 * sroom; }
    _sb_grow_a(a, sb, strlen(result) + sroom + 64);
    str_builder_add_cstr(sb, "{");
    var sep = 0;
    var k = 0;
    while (k < vec_len(mem)) {
        var mk = vec_get(mem, k);
        if (mk == 0 || streq(mk, "requestState") == 0) {
            if (sep == 1) { str_builder_add_cstr(sb, ","); }
            sep = 1;
            str_builder_add_cstr(sb, "\"");
            str_builder_add_cstr(sb, vec_get(mem, k + 1));
            str_builder_add_cstr(sb, "\":");
            str_builder_add_cstr(sb, vec_get(mem, k + 2));
        }
        k = k + 3;
    }
    if (sep == 1) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"requestState\":\"");
    bote_json_escape(sb, sealed);
    str_builder_add_cstr(sb, "\"}");
    return resp_success_a(a, id, str_data(str_builder_build_a(a, sb)));
}

# 1 when bote_json_escape may write `s` other than as it is: a quote, a backslash, a control
# byte, or any byte past ASCII, which it writes as U+FFFD where it is no UTF-8.
fn _dsp_needs_escape(s) {
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 32 || c == 34 || c == 92 || c >= 128) { return 1; }
        i = i + 1;
    }
    return 0;
}

# -32021, MissingRequiredClientCapability, with `data.requiredCapabilities` in the
# ClientCapabilities shape: `need`'s bits are elicitation form (1), url (2), sampling (4),
# sampling with tools (8) and roots (16).
fn _dsp_missing_caps_a(a, id, need) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 160);
    str_builder_add_cstr(sb, "{\"requiredCapabilities\":{");
    var sep = 0;
    if ((need & 3) != 0) {
        str_builder_add_cstr(sb, "\"elicitation\":{");
        if ((need & 1) != 0) { str_builder_add_cstr(sb, "\"form\":{}"); }
        if ((need & 3) == 3) { str_builder_add_cstr(sb, ","); }
        if ((need & 2) != 0) { str_builder_add_cstr(sb, "\"url\":{}"); }
        str_builder_add_cstr(sb, "}");
        sep = 1;
    }
    if ((need & 12) != 0) {
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"sampling\":{");
        if ((need & 8) != 0) { str_builder_add_cstr(sb, "\"tools\":{}"); }
        str_builder_add_cstr(sb, "}");
        sep = 1;
    }
    if ((need & 16) != 0) {
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"roots\":{}");
    }
    str_builder_add_cstr(sb, "}}");
    return resp_error_data_a(a, id, 0 - 32021, "the request needs client capabilities it did not declare", str_data(str_builder_build_a(a, sb)));
}

# ---- the handler's side: an InputRequiredResult, built (3.8.2) ----------------------
#
# A handler that needs input answers with one, made here on `a` (the request arena, the
# handler's thread's):
#     var ir = bote_input_required_new_a(bote_req_alloc());
#     bote_input_elicit(ir, "confirm", "Deploy?", "{\"type\":\"object\",...}");
#     bote_input_state(ir, "step=2");
#     return bote_input_required_json(ir);
# Each key names one input request; the client's answer to it comes back under that key
# (bote_input_response_a). The state is the handler's own words, which bote seals before it
# goes and opens when it comes back (bote_request_state). The dispatcher judges the result
# before it goes: only the three methods the spec allows, each the client declared it can
# take (-32021 otherwise), and at least one request or a state.
#
# InputRequired (40 bytes): +0 arena, +8 the builder of inputRequests' members, +16 how
# many, +24 the state or 0, +32 unused. A key used twice is refused as the result goes.
fn bote_input_required_new_a(a) {
    var ir = alloc_via(a, 40);
    store64(ir, a);
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 256);
    store64(ir + 8, sb);
    store64(ir + 16, 0);
    store64(ir + 24, 0);
    store64(ir + 32, 0);
    return ir;
}

fn _bote_ir_open(ir, key, method, room) {
    var a = load64(ir);
    var sb = load64(ir + 8);
    _sb_grow_a(a, sb, 6 * strlen(key) + room + 64);
    if (load64(ir + 16) > 0) { str_builder_add_cstr(sb, ","); }
    store64(ir + 16, load64(ir + 16) + 1);
    str_builder_add_cstr(sb, "\"");
    bote_json_escape(sb, key);
    str_builder_add_cstr(sb, "\":{\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":");
    return sb;
}

# An elicitation in form mode: `message` for the user and `requested_schema`, a JSON Schema
# object of primitive properties, as raw JSON.
fn bote_input_elicit(ir, key, message, requested_schema) {
    var sb = _bote_ir_open(ir, key, "elicitation/create", 6 * strlen(message) + strlen(requested_schema));
    str_builder_add_cstr(sb, "{\"mode\":\"form\",\"message\":\"");
    bote_json_escape(sb, message);
    str_builder_add_cstr(sb, "\",\"requestedSchema\":");
    str_builder_add_cstr(sb, requested_schema);
    str_builder_add_cstr(sb, "}}");
    return ir;
}

# An elicitation in URL mode: the user is sent to `url`, out of band. The spec has a server
# use this, never a form, for anything sensitive: a password, a key, a token.
fn bote_input_elicit_url(ir, key, message, url) {
    var sb = _bote_ir_open(ir, key, "elicitation/create", 6 * strlen(message) + 6 * strlen(url));
    str_builder_add_cstr(sb, "{\"mode\":\"url\",\"message\":\"");
    bote_json_escape(sb, message);
    str_builder_add_cstr(sb, "\",\"url\":\"");
    bote_json_escape(sb, url);
    str_builder_add_cstr(sb, "\"}}");
    return ir;
}

# A sampling request, its CreateMessageRequestParams as raw JSON. Sampling is deprecated in
# 2026-07-28, and still served.
fn bote_input_sample(ir, key, params) {
    var sb = _bote_ir_open(ir, key, "sampling/createMessage", strlen(params));
    str_builder_add_cstr(sb, params);
    str_builder_add_cstr(sb, "}");
    return ir;
}

# The client's roots. Deprecated in 2026-07-28, and still served.
fn bote_input_roots(ir, key) {
    var sb = _bote_ir_open(ir, key, "roots/list", 0);
    str_builder_add_cstr(sb, "{}}");
    return ir;
}

# What the handler wants back on the retry, as it will read it from bote_request_state.
fn bote_input_state(ir, payload) { store64(ir + 24, payload); return ir; }

# The InputRequiredResult, for the handler to return.
fn bote_input_required_json(ir) {
    var a = load64(ir);
    var sb = str_builder_new_a(a);
    var reqs = str_data(str_builder_build_a(a, load64(ir + 8)));
    var st = load64(ir + 24);
    var room = strlen(reqs) + 96;
    if (st != 0) { room = room + 6 * strlen(st); }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resultType\":\"input_required\"");
    if (load64(ir + 16) > 0) {
        str_builder_add_cstr(sb, ",\"inputRequests\":{");
        str_builder_add_cstr(sb, reqs);
        str_builder_add_cstr(sb, "}");
    }
    if (st != 0) {
        str_builder_add_cstr(sb, ",\"requestState\":\"");
        bote_json_escape(sb, st);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# A request that names a key twice in any object, or a key that is no text (bytes that are
# no UTF-8, a surrogate escape that is not one of a pair), is refused before anything reads
# it (3.8.6). bote's one key scanner reads the first of a repeated key, a handler's parser may
# read the last, and a client decoding UTF-8 reads a key that is no text as U+FFFD, which
# another key may spell: either way the arguments the schema judged and the ones a handler
# acts on would differ. RFC 8259 asks for unique names (§4), I-JSON requires them (RFC 7493
# §2.3), and the stdlib's parser refuses a repeat. It is an invalid request, -32600, and not
# a parse error, which is answered with a null id that leaves a client waiting.
var BOTE_REQ_KEYS_MSG = "invalid request: a key named twice, or one that is no text";

# dispatcher_dispatch with bote's own bytes on `a`. `a` must outlive the response
# and nothing else. Stays on the global heap: what a handler is handed (it may
# keep it) and what a sink is handed (ditto). For a request a consumer built: its
# params are checked for a key named twice here, as the codec checks a whole message.
fn dispatcher_dispatch_a(a, d, request, claims) {
    if (req_is_notification(request) == 1) { return 0; }
    var params = req_params(request);
    if (params != 0 && _dsp_keys_twice(a, params) == 1) {
        return resp_error_a(a, req_id(request), 0 - 32600, BOTE_REQ_KEYS_MSG);
    }
    return _dsp_dispatch_admitted_a(a, d, request, claims);
}

# 1 when `params` name a key twice, or one that is no text (_jx_valid_keys_a). (3.8.13, from
# the 3.8.12 review) Handed an allocator that is no bote arena, the heap a plain form passes,
# it walks on the calling thread's request arena, and keeps nothing there either: the syntax
# walk allocates nothing and the exact walker (_jx_repeats_n_a) gives back what it takes.
# Through 3.8.12 the walk's table for 2,000 keys, 98 KB, stayed on the heap for each call. Not
# the heap forms' scratch, whose lock every plain dispatch would take: a dispatch reads and
# writes the calling thread's request state already.
fn _dsp_keys_twice(a, params) {
    var w = a;
    if (_bote_ar_is(a) == 0) { w = bote_req_alloc(); }
    if (_jx_valid_keys_a(w, params, strlen(params)) == 2) { return 1; }
    return 0;
}

# dispatcher_dispatch_a for a request the codec admitted (`_cdc_admit_l_a`), which has
# checked the whole message for a key named twice: the codec and the HTTP-family
# transports, so no message is walked for it twice.
fn _dsp_dispatch_admitted_a(a, d, request, claims) {
    if (req_is_notification(request) == 1) { return 0; }
    bote_req_set_input(0, 0, 0, 0);
    var params = req_params(request);
    var plen = 0;
    if (params != 0) { plen = strlen(params); }
    # One pass for `_meta` and what tools/call reads, so choosing the era costs that
    # method no second walk of its params, and legacy traffic compares no method here.
    var keys[80];
    store64(&keys, "name");            store64(&keys + 8, 4);
    store64(&keys + 16, "version");    store64(&keys + 24, 7);
    store64(&keys + 32, "arguments");  store64(&keys + 40, 9);
    store64(&keys + 48, "caller_id");  store64(&keys + 56, 9);
    store64(&keys + 64, "_meta");      store64(&keys + 72, 5);
    var pos[40];
    _jx_scan(params, plen, &keys, 5, &pos);

    var meta = _jx_raw_at_a(a, params, plen, load64(&pos + 32));
    if (meta == 0 || jsonx_has(meta, DSP_META_VERSION) == 0) {
        return _dsp_serve_a(a, d, request, claims, &pos, plen, 0);
    }
    var method = req_method(request);
    # `initialize` selects legacy semantics, whatever else it carries.
    if (streq(method, "initialize") == 1) {
        return _dsp_serve_a(a, d, request, claims, &pos, plen, 0);
    }

    # A required field missing or of the wrong type is malformed: -32602.
    var id = req_id(request);
    var pv = jsonx_get_str_dec_a(a, meta, DSP_META_VERSION);
    if (pv == 0) {
        return resp_error_a(a, id, 0 - 32602, "io.modelcontextprotocol/protocolVersion must be a string");
    }
    if (_mcp_is_modern(pv) == 0) {
        # An older revision named per request is that revision's behaviour.
        if (_mcp_is_supported(pv) == 1) {
            return _dsp_serve_a(a, d, request, claims, &pos, plen, 0);
        }
        return _dsp_unsupported_version(a, id, pv);
    }
    var caps = jsonx_get_raw_a(a, meta, DSP_META_CAPABILITIES);
    if (caps == 0 || jsonx_is_object(caps) == 0) {
        return resp_error_a(a, id, 0 - 32602, DSP_CAPS_MISSING);
    }
    # A retry of a request that asked for input brings the answers and the state (3.8.2).
    var refused = _dsp_input_admit_a(a, d, id, method, params, caps, claims);
    if (refused != 0) { return refused; }

    if (streq(method, "server/discover") == 1) {
        return resp_success_a(a, id, _build_discover_result_a(a, d));
    }
    if (streq(method, "subscriptions/listen") == 1) { return _dsp_listen_a(a, d, id, req_params(request), claims); }
    # Removed from this revision, with `initialize`.
    if (streq(method, "ping") == 1) {
        return resp_error_a(a, id, 0 - 32601, "method not found: ping");
    }
    return _dsp_modern_response(a, d, method, _dsp_serve_a(a, d, request, claims, &pos, plen, 1));
}

# ================================================================
# subscriptions/listen (3.7.2, MCP 2026-07-28)
# ================================================================
#
# A client opens a stream for the changes it opts in to: `params.notifications` names
# them, each opt-in, and the server MUST NOT send one it was not asked for. The dispatcher
# judges the request and the transport carries the stream (src/listen.cyr): what comes
# back here is the acknowledgement's `notifications`, the honored subset, which the
# transport sends as the stream's first message. The subset narrows what was asked to
# what this server delivers: a list's change when it has that list, and (3.7.4) a resource's
# update for the URIs of `resourceSubscriptions` it has room for, when it has resources.
#
# A URI is honored when it is a non-empty string with no NUL, at most BOTE_LISTEN_URI_MAX
# bytes decoded, and not a repeat, while there is room: BOTE_LISTEN_URIS of them in
# BOTE_LISTEN_URI_ROOM bytes, each with its NUL, which is what a stream keeps of them. The
# acknowledgement lists exactly those, so a client knows which it will hear of. An update
# names the URI that changed (dispatcher_resource_updated), and reaches every subscription
# to that URI or to one it falls under: the same URI, or one it begins with followed by `/`,
# `?` or `#`, or by anything when it ends in `/`. The spec allows the URI sent to be a
# sub-resource of the one subscribed.

var BOTE_LISTEN_TOOLS = 1;
var BOTE_LISTEN_PROMPTS = 2;
var BOTE_LISTEN_RESOURCES = 4;
var BOTE_LISTEN_UPDATES = 8;
var BOTE_LISTEN_URIS = 32;
var BOTE_LISTEN_URI_ROOM = 4096;
var BOTE_LISTEN_URI_MAX = 1024;
var DSP_LISTEN_FILTER = "Invalid params: 'notifications' is required and must be a valid SubscriptionFilter";

# 1 when `raw`, a field of the filter, is absent or a boolean, and *on_out says whether it
# is `true`.
fn _dsp_listen_flag(raw, on_out) {
    store64(on_out, 0);
    if (raw == 0) { return 1; }
    if (streq(raw, "true") == 1) {
        store64(on_out, 1);
        return 1;
    }
    return streq(raw, "false");
}

# 1 when `raw` is absent or an array of strings.
fn _dsp_listen_strings(raw) {
    if (raw == 0) { return 1; }
    var n = strlen(raw);
    if (n == 0 || load8(raw) != 91) { return 0; }
    var i = _jx_skip_ws(raw, n, 1);
    while (i < n && load8(raw + i) != 93) {
        if (load8(raw + i) != 34) { return 0; }
        i = _jx_array_next(raw, n, i);
    }
    return 1;
}

# The honored subset of a listen request's filter, as BOTE_LISTEN_* bits, or -1 when
# `notifications` is missing or not a SubscriptionFilter. With no claims: see
# _dsp_listen_mask_a.
fn dispatcher_listen_mask_a(a, d, params) { return _dsp_listen_mask_a(a, d, params, 0); }

# The same for a listen made with `claims` (3.7.5): a URI they may not read is not honored.
fn _dsp_listen_mask_a(a, d, params, claims) {
    if (params == 0) { return 0 - 1; }
    var f = jsonx_get_raw_a(a, params, "notifications");
    if (f == 0 || jsonx_is_object(f) == 0) { return 0 - 1; }
    var t[8];
    var p[8];
    var r[8];
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "toolsListChanged"), &t) == 0) { return 0 - 1; }
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "promptsListChanged"), &p) == 0) { return 0 - 1; }
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "resourcesListChanged"), &r) == 0) { return 0 - 1; }
    if (_dsp_listen_strings(jsonx_get_raw_a(a, f, "resourceSubscriptions")) == 0) { return 0 - 1; }
    var mask = 0;
    if (load64(&t) == 1) { mask = mask | BOTE_LISTEN_TOOLS; }
    if (load64(&p) == 1 && dispatcher_prompts(d) != 0) { mask = mask | BOTE_LISTEN_PROMPTS; }
    if (load64(&r) == 1 && dispatcher_resources(d) != 0) { mask = mask | BOTE_LISTEN_RESOURCES; }
    if (dispatcher_resources(d) != 0 && _dsp_listen_uris_a(a, d, jsonx_get_raw_a(a, f, "resourceSubscriptions"), claims) != 0) {
        mask = mask | BOTE_LISTEN_UPDATES;
    }
    return mask;
}

# The string at `pos` of `raw`, decoded on `a`, when it can be a subscription's URI: not
# empty, no NUL. 0 otherwise.
fn _dsp_listen_uri_a(a, raw, n, pos) {
    var s = _jx_str_at_a(a, raw, n, pos);
    if (s == 0) { return 0; }
    var sl = strlen(s);
    var out = alloc_via(a, sl + 1);
    var dn = _jx_unescape_into(s, sl, out);
    if (dn == 0 || strlen(out) != dn) { return 0; }
    return out;
}

# The scopes what would serve `uri` requires, judged as resources/read is (3.7.6): the
# registration's own list, so another registration is another list, or 0 for none.
fn _dsp_uri_scopes(d, uri) {
    if (d == 0 || uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var fp[8];
    var sc = resource_registry_serving(dispatcher_resources(d), uri, &fp);
    if (sc == 0 || vec_len(sc) == 0) { return 0; }
    return sc;
}

# 1 when what would serve `uri` requires a scope (3.7.5).
fn _dsp_uri_scoped(d, uri) { return _dsp_uri_scopes(d, uri) != 0; }

# The URIs of `raw`, a `resourceSubscriptions` already found to be a list of strings, that
# a stream honors, decoded, on `a`, in the order sent (above). 0 when none is. One the
# `claims` may not read, judged by what would serve it as resources/read judges it, is not
# honored (3.7.5): through 3.7.4 a token without a resource's scope heard of every change
# to it, and learned the URIs behind a scoped template.
fn _dsp_listen_uris_a(a, d, raw, claims) {
    if (raw == 0) { return 0; }
    var n = strlen(raw);
    var out = vec_new_a(a);
    var used = 0;
    var i = _jx_skip_ws(raw, n, 1);
    while (i < n && load8(raw + i) != 93 && vec_len(out) < BOTE_LISTEN_URIS) {
        var u = _dsp_listen_uri_a(a, raw, n, i);
        if (u != 0 && dispatcher_resource_scopes_missing(d, u, claims) != 0) { u = 0; }
        if (u != 0) {
            var ul = strlen(u);
            if (ul <= BOTE_LISTEN_URI_MAX && used + ul + 1 <= BOTE_LISTEN_URI_ROOM && _dsp_listen_seen(out, u) == 0) {
                vec_push_a(a, out, u);
                used = used + ul + 1;
            }
        }
        i = _jx_array_next(raw, n, i);
    }
    if (vec_len(out) == 0) { return 0; }
    return out;
}

fn _dsp_listen_seen(v, u) {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), u) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The acknowledgement's params for the bits `mask`: {"notifications":{...}}.
fn bote_listen_ack_params_a(a, mask) { return bote_listen_ack_uris_a(a, mask, 0); }

# The same, with the honored URIs `uris` (a vec of decoded strings, or 0) as its
# `resourceSubscriptions` when `mask` has BOTE_LISTEN_UPDATES (3.7.4).
fn bote_listen_ack_uris_a(a, mask, uris) {
    var sb = str_builder_new_a(a);
    var room = 160;
    var k = 0;
    while (uris != 0 && k < vec_len(uris)) {
        room = room + strlen(vec_get(uris, k)) * 6 + 3;
        k = k + 1;
    }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"notifications\":{");
    var sep = "";
    if ((mask & BOTE_LISTEN_TOOLS) != 0) {
        str_builder_add_cstr(sb, "\"toolsListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_PROMPTS) != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"promptsListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_RESOURCES) != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"resourcesListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_UPDATES) != 0 && uris != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"resourceSubscriptions\":[");
        k = 0;
        while (k < vec_len(uris)) {
            if (k > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            bote_json_escape(sb, vec_get(uris, k));
            str_builder_add_cstr(sb, "\"");
            k = k + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build_a(a, sb));
}

# Say the resource at `uri` has changed (3.7.4): every listen subscribed to it, or to a
# resource it falls under, is sent `notifications/resources/updated` naming it. Any thread
# may call it; nothing keeps `uri`. 0, or -1 for no URI.
fn dispatcher_resource_updated(d, uri) {
    if (uri == 0 || load8(uri) == 0) { return 0 - 1; }
    return event_sink_updated(dispatcher_event_sink(d), uri);
}

# 1 when this message came on a transport that can carry a listen stream for `d`
# (bote_req_stream): an HTTP transport, when `d` has a hub (3.7.2), or a connection that
# is itself the stream (3.7.3).
fn _dsp_listen_here(d) {
    var st = bote_req_stream();
    if (st == 0) { return 0; }
    if (st == 1) { return dispatcher_listen(d) != 0; }
    return 1;
}

# A subscriptions/listen request: -32601 where this message's transport carries no stream
# (_dsp_listen_here), -32602 for a filter that is not one, else a response whose result is
# the acknowledgement's params, for the transport to open the stream with. It is no answer
# to send as it is.
fn _dsp_listen_a(a, d, id, params, claims) {
    if (_dsp_listen_here(d) == 0) { return resp_error_a(a, id, 0 - 32601, "method not found: subscriptions/listen"); }
    # MCP's ids are never null (3.7.4), and a subscription's id is how it is cancelled.
    if (streq(id, "null") == 1) { return resp_error_a(a, id, 0 - 32600, "invalid request: a subscriptions/listen id must not be null"); }
    var mask = _dsp_listen_mask_a(a, d, params, claims);
    if (mask < 0) { return resp_error_a(a, id, 0 - 32602, DSP_LISTEN_FILTER); }
    var uris = 0;
    if ((mask & BOTE_LISTEN_UPDATES) != 0) {
        uris = _dsp_listen_uris_a(a, d, jsonx_get_raw_a(a, jsonx_get_raw_a(a, params, "notifications"), "resourceSubscriptions"), claims);
    }
    bote_req_set_listen_claims(claims);
    return resp_success_a(a, id, bote_listen_ack_uris_a(a, mask, uris));
}

# The methods themselves, for both eras: what differs between them is around this,
# and what `modern` (1 for 2026-07-28) says inside it: the shapes of an outputSchema
# and a structuredContent (3.8.0). `pos` is the router's pass over the params: name,
# version, arguments, caller_id.
fn _dsp_serve_a(a, d, request, claims, pos, plen, modern) {
    var id = req_id(request);
    var method = req_method(request);
    var params = req_params(request);
    var reg = dispatcher_registry(d);

    if (streq(method, "tools/call") == 1) {
        var name = _jx_str_dec_at_a(a, params, plen, load64(pos));
        if (name == 0 || strlen(name) == 0) {
            var ne = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(ne)), str_data(bote_err_format_a(a, ne)));
        }

        # The tool, its handler and the version asked for, from one look (3.7.2): the
        # whole call is judged by and served by what this found.
        var ver = _jx_str_dec_at_a(a, params, plen, load64(pos + 8));
        var ver_ok[8];
        var has_fp[8];
        var fp_slot[8];
        var t = _dsp_tool_serving(a, d, name, ver, &ver_ok, &has_fp, &fp_slot);

        # Ahead of everything else about the call: a token that may not run this tool
        # learns nothing about its arguments. HTTP answers this with a 403 before it
        # gets here, and this is what a batch and a WebSocket reach.
        if (_dsp_def_scopes_missing(d, t, claims) != 0) {
            var smsg = _dsp_named_msg_a(a, "insufficient scope for tool: ", name, 0);
            _dsp_record_refusal(d, name, params, plen, load64(pos + 24), smsg);
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, smsg);
        }

        # Optional: version negotiation
        if (load64(&ver_ok) == 0) {
            var sb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, sb, "version '");
            str_builder_add_cstr_a(a, sb, ver);
            str_builder_add_cstr_a(a, sb, "' not found");
            var verr = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, name, str_data(str_builder_build_a(a, sb)));
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(verr)), str_data(bote_err_format_a(a, verr)));
        }

        # Extract arguments (default to "{}" if absent), caller_id (optional).
        # On the arena for now: every refusal below leaves nothing behind.
        var args = _jx_raw_at_a(a, params, plen, load64(pos + 16));
        if (args == 0) { args = "{}"; }
        var caller_id = 0;

        # A non-object `arguments` breaks CallToolRequest's own schema: the
        # request is malformed, which is a protocol error.
        if (jsonx_is_object(args) == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "'arguments' must be an object for tool '", name, "'"));
        }

        # Validate. An unknown tool is a protocol error (-32602). Arguments
        # that fail the tool's inputSchema are a tool execution error: a
        # result with isError, so the model sees what it got wrong and can
        # retry (MCP 2025-11-25, SEP-1303). They were a -32602 protocol
        # error through 3.4.4.
        var verr2 = registry_validate_def_a(a, t, name, args);
        if (verr2 != 0) {
            var vmsg = str_data(bote_err_format_a(a, verr2));
            _dsp_record_refusal(d, name, params, plen, load64(pos + 24), vmsg);
            if (bote_err_tag(verr2) == BOTE_ERR_TOOL_NOT_FOUND) {
                return resp_error_a(a, id, bote_err_rpc_code(BOTE_ERR_TOOL_NOT_FOUND), vmsg);
            }
            return resp_success_a(a, id, _dsp_tool_error_result_a(a, vmsg));
        }

        # Deprecation event (best-effort; never blocks dispatch)
        if (t != 0) {
            var dep = tool_def_deprecated(t);
            if (dep != 0) {
                var ds = str_builder_new_a(a);
                _sb_grow_a(a, ds, (strlen(name) + strlen(dep)) * 6 + 64);
                str_builder_add_cstr_a(a, ds, "{\"tool_name\":\"");
                _json_emit_escaped(ds, name);
                str_builder_add_cstr_a(a, ds, "\",\"message\":\"");
                _json_emit_escaped(ds, dep);
                str_builder_add_cstr_a(a, ds, "\"}");
                event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_DEPRECATED(),
                  str_data(str_builder_build_a(a, ds)));
            }
        }

        # Dispatch with timing + audit + event hooks.
        #
        # 3.4.1: the duration and the tool-call event exist only for an audit
        # or event sink. With neither installed nobody reads them, so skip the
        # two clock reads and the event build. Each clock read is a
        # clock_gettime syscall, measured at 1.35 µs on the reference host —
        # together over half of an unobserved tools/call.
        var audit_on = _dsp_sink_live(dispatcher_audit_sink(d));
        var events_on = _dsp_sink_wants_calls(dispatcher_event_sink(d));
        var t_start = 0;
        if (audit_on == 1 || events_on == 1) {
            t_start = clock_now_ns();
            # A sink may keep what it is handed.
            name = _jx_str_dec_at_a(default_alloc(), params, plen, load64(pos));
            caller_id = _jx_str_at_a(default_alloc(), params, plen, load64(pos + 24));
        }
        var fp = load64(&fp_slot);
        if (load64(&has_fp) == 0) {
            var nf = bote_err_new_a(a, BOTE_ERR_TOOL_NOT_FOUND, name, 0);
            var msg_nh = str_data(bote_err_format_a(a, nf));
            if (audit_on == 1 || events_on == 1) {
                var dur_nh = (clock_now_ns() - t_start) / 1000000;
                var ev_nh = tool_call_event_new(name, dur_nh, 0, msg_nh, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_nh); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(),
                      tool_call_event_to_json(ev_nh));
                }
            }
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(nf)), msg_nh);
        }
        # A handler may keep `args` (2.0 ABI), so it reaches the heap here,
        # past every refusal, and not before.
        args = _slice_cstr(default_alloc(), args, 0, strlen(args));
        # 2.0 ABI: fncall2 with claims (always 0 in 2.0; populated in 2.x)
        # Whatever the handler returned, the client gets a CallToolResult
        # (_dsp_coerce_result, 3.4.8). A failed call — no result, invalid
        # JSON, or a result carrying isError — is audited and published as
        # a failure.
        var fail_slot[8];
        var keep = 0;
        if (audit_on == 1 || events_on == 1) { keep = 1; }
        var rinfo[24];
        var result = _dsp_coerce_result(a, t, name, fncall2(fp, args, bote_req_claims_kept(claims)), &fail_slot, keep, &rinfo);
        # Judged by the tool's outputSchema, and shaped for this revision (3.8.0).
        result = _dsp_tool_result_out_a(a, t, name, result, &fail_slot, modern, keep, &rinfo);
        var no_result = load64(&fail_slot);
        var input = load64(&rinfo + 16) & DSP_SHAPE_INPUT;
        # A round that asks for input did not complete (3.8.2), as a cancelled call did not.
        if (input != 0) { no_result = "input required"; }
        # A call its handler found cancelled did not complete, whatever it returned (3.7.5).
        # Only the sinks read it.
        if ((audit_on == 1 || events_on == 1) && bote_req_was_cancelled() == 1) { no_result = "cancelled"; }
        if (audit_on == 1 || events_on == 1) {
            var dur_ms = (clock_now_ns() - t_start) / 1000000;
            if (no_result == 0) {
                var ev_ok = tool_call_event_new(name, dur_ms, 1, 0, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_ok); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_COMPLETED(),
                      tool_call_event_to_json(ev_ok));
                }
            } else {
                var ev_nr = tool_call_event_new(name, dur_ms, 0, no_result, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_nr); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(),
                      tool_call_event_to_json(ev_nr));
                }
            }
        }
        if (input != 0) { return _dsp_input_out_a(a, d, id, method, params, result, modern, claims); }
        return resp_success_a(a, id, result);
    }

    if (streq(method, "initialize") == 1) {
        return resp_success_a(a, id, _build_initialize_result_a(a, d, params));
    }

    # ping — the MCP keepalive. The receiver MUST answer promptly with an
    # empty result; a client that gets an error back reads the server as
    # unhealthy and may tear the session down.
    #
    # Deliberately ahead of every capability gate and taking no params: a
    # ping has to work on a bare dispatcher with no registries wired, which
    # is the state a client probes during startup. Emits no audit or event
    # record — it is liveness, not activity, and a keepalive every few
    # seconds would swamp the chain.
    #
    # bote answers pings; it does not originate them. Server→client pings
    # need the push path that real-time streaming brings (roadmap 3.7.x).
    if (streq(method, "ping") == 1) {
        return resp_success_a(a, id, "{}");
    }

    if (streq(method, "tools/list") == 1) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        var lprofile = 0;
        if (params != 0) { lprofile = jsonx_get_str_a(a, params, "profile"); }
        return resp_success_a(a, id, _build_tools_list_result_a(a, reg, lprofile, modern));
    }

    # prompts/* only when the prompts capability is enabled (a PromptRegistry
    # is present). Otherwise fall through to method-not-found (-32601), which
    # matches the un-advertised capability.
    if (streq(method, "prompts/list") == 1 && dispatcher_prompts(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_prompts_list_result(a, dispatcher_prompts(d)));
    }

    if (streq(method, "prompts/get") == 1 && dispatcher_prompts(d) != 0) {
        var pname = jsonx_get_str_dec_a(a, params, "name");
        if (pname == 0 || strlen(pname) == 0) {
            var pe = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(pe)), str_data(bote_err_format_a(a, pe)));
        }
        # The prompt and its handler from one look (3.7.2), as for a tool.
        var ph_slot[8];
        var pdef = prompt_registry_serving(dispatcher_prompts(d), pname, &ph_slot);
        var phandler = load64(&ph_slot);
        if (phandler == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "prompt not found: ", pname, 0));
        }
        # As for a tool: a token that may not get this prompt learns nothing past its name.
        if (claims != 0 && pdef != 0 && _dsp_scopes_lacking(d, prompt_def_required_scopes(pdef), claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, _dsp_named_msg_a(a, "insufficient scope for prompt: ", pname, 0));
        }
        var pargs = jsonx_get_raw_a(a, params, "arguments");
        if (pargs == 0) { pargs = "{}"; }
        # The MCP prompts spec: invalid prompt name and missing required
        # arguments are both -32602 (3.4.5 added the second; the handler
        # used to be called without them).
        if (jsonx_is_object(pargs) == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "'arguments' must be an object for prompt '", pname, "'"));
        }
        var pmissing = _prompt_missing_required(pdef, pargs);
        if (pmissing != 0) {
            var pmb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, pmb, "missing required argument '");
            str_builder_add_cstr_a(a, pmb, pmissing);
            str_builder_add_cstr_a(a, pmb, "' for prompt '");
            str_builder_add_cstr_a(a, pmb, pname);
            str_builder_add_cstr_a(a, pmb, "'");
            return resp_error_a(a, id, 0 - 32602, str_data(str_builder_build_a(a, pmb)));
        }
        # Past every refusal: a handler may keep what it is handed.
        pargs = _slice_cstr(default_alloc(), pargs, 0, strlen(pargs));
        var presult = fncall2(phandler, pargs, bote_req_claims_kept(claims));
        if (presult == 0) { presult = "{\"messages\":[]}"; }
        return _dsp_served_result(a, d, id, method, params, presult, modern, claims);
    }

    # resources/* only when the resources capability is enabled (a
    # ResourceRegistry is present). Otherwise fall through to -32601.
    if (streq(method, "resources/list") == 1 && dispatcher_resources(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_resources_list_result(a, dispatcher_resources(d)));
    }

    if (streq(method, "resources/read") == 1 && dispatcher_resources(d) != 0) {
        var ruri = jsonx_get_str_dec_a(a, params, "uri");
        if (ruri == 0 || strlen(ruri) == 0) {
            var re = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'uri' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(re)), str_data(bote_err_format_a(a, re)));
        }
        # What serves the URI and the scopes it requires, from one look (3.7.2).
        var rh_slot[8];
        var rscopes = resource_registry_serving(dispatcher_resources(d), ruri, &rh_slot);
        var rhandler = load64(&rh_slot);
        if (rhandler == 0) {
            # -32002 with the URI in `data`, as the MCP resources spec has
            # it. It was -32602 through 3.4.4.
            var rdb = str_builder_new_a(a);
            _sb_grow_a(a, rdb, strlen(ruri) * 6 + 16);
            str_builder_add_cstr_a(a, rdb, "{\"uri\":\"");
            _json_emit_escaped(rdb, ruri);
            str_builder_add_cstr_a(a, rdb, "\"}");
            return resp_error_data_a(a, id, BOTE_RPC_RESOURCE_NOT_FOUND,
              _dsp_named_msg_a(a, "resource not found: ", ruri, 0), str_data(str_builder_build_a(a, rdb)));
        }
        if (claims != 0 && _dsp_scopes_lacking(d, rscopes, claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, _dsp_named_msg_a(a, "insufficient scope for resource: ", ruri, 0));
        }
        # Past every refusal: a handler may keep what it is handed.
        ruri = _slice_cstr(default_alloc(), ruri, 0, strlen(ruri));
        var rresult = fncall2(rhandler, ruri, bote_req_claims_kept(claims));
        if (rresult != 0 && jsonx_valid(rresult, strlen(rresult)) == 1 && _dsp_input_result(a, rresult) == 1) {
            return _dsp_input_out_a(a, d, id, method, params, _dsp_one_line(a, rresult), modern, claims);
        }
        if (rresult == 0) { rresult = "{\"contents\":[]}"; }
        return _dsp_checked_result(a, id, rresult);
    }

    # resources/templates/list. An empty list when none is registered: this used to
    # be -32601, which some clients send whenever `resources` is advertised and read
    # as a server failure. Gated like the other resources/* methods, and refuses a
    # pagination `cursor` like the other list methods.
    if (streq(method, "resources/templates/list") == 1 && dispatcher_resources(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_resource_templates_result(a, dispatcher_resources(d)));
    }

    # completion/complete only when a completion handler is set. The handler
    # receives the raw params ({ref, argument, ...}) and returns the full
    # {"completion":{"values":[...]}} body. Otherwise fall through to -32601.
    if (streq(method, "completion/complete") == 1 && dispatcher_completion(d) != 0) {
        if (jsonx_is_object(params) == 0) {
            return resp_error_a(a, id, 0 - 32602, "completion/complete params must be an object");
        }
        if (dispatcher_completion_scopes_missing_a(a, d, params, claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, "insufficient scope for completion: the prompt or resource it names");
        }
        var cparams = _slice_cstr(default_alloc(), params, 0, strlen(params));
        var cresult = fncall2(dispatcher_completion(d), cparams, bote_req_claims_kept(claims));
        if (cresult == 0) { cresult = "{\"completion\":{\"values\":[]}}"; }
        if (cresult != 0 && jsonx_valid(cresult, strlen(cresult)) == 1 && _dsp_input_result(a, cresult) == 1) {
            # (3.8.2) Only tools/call, prompts/get and resources/read may ask for input.
            _dsp_log_input(method, "completion/complete asked for input");
            return resp_error_a(a, id, 0 - 32603, "internal error: completion/complete may not ask for input");
        }
        return _dsp_checked_result(a, id, cresult);
    }

    # The router answers it for a request that named this revision.
    if (streq(method, "server/discover") == 1) {
        return resp_error_a(a, id, 0 - 32602, "server/discover needs _meta naming 2026-07-28 and clientCapabilities");
    }

    # Unknown method — JSON-RPC §5.1
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128);
    str_builder_add_cstr_a(a, sb, "method not found: ");
    str_builder_add_cstr_a(a, sb, method);
    return resp_error_a(a, id, 0 - 32601, str_data(str_builder_build_a(a, sb)));
}

# --- codec.cyr ---

# bote::codec — JSON-RPC parse, serialize, batch dispatch
# Mirrors rust-old/src/transport/codec.rs

# Hard cap on JSON-RPC batch length. Defends against the 1.9.4 audit's
# "no batch-size cap" amplification DoS — a 1 MiB body of `[{},{},...]`
# would otherwise spin allocating per-element responses until OOM.
# 100 is generous; real clients batch single-digit calls.
var CODEC_MAX_BATCH = 100;

# ================================================================
# Helpers
# ================================================================

# Slice n bytes from src starting at off into a new null-terminated cstr.
fn _slice_cstr(a, src, off, n) {
    var out = alloc_via(a, n + 1);
    memcpy(out, src + off, n);
    store8(out + n, 0);
    return out;
}

# Skip whitespace; return new index.
fn _cdc_skip_ws(buf, len, i) {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return i; }
    }
    return i;
}

# The two line-framed transports refuse a line that does not fit their buffer:
# they answer this once, then skip to its newline. Its tail must not run as a
# message of its own.
fn codec_line_too_long() {
    return _cdc_parse_error_a(bote_req_begin(), "line too long");
}

# The offset just past the first newline in the n bytes at buf, or -1.
fn codec_line_end(buf, n) {
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) { return i + 1; }
        i = i + 1;
    }
    return 0 - 1;
}

# Parse a JSON-RPC request object (cstr) into a JsonRpcRequest ptr.
# Returns 0 on failure. One pass over the message; `a` owns every field.
fn codec_parse_request_a(a, line) {
    if (line == 0) { return 0; }
    var len = strlen(line);
    var keys[64];
    store64(&keys, "jsonrpc");      store64(&keys + 8, 7);
    store64(&keys + 16, "method");  store64(&keys + 24, 6);
    store64(&keys + 32, "id");      store64(&keys + 40, 2);
    store64(&keys + 48, "params");  store64(&keys + 56, 6);
    var pos[32];
    _jx_scan(line, len, &keys, 4, &pos);

    var jsonrpc = _jx_str_at_a(a, line, len, load64(&pos));
    if (jsonrpc == 0) { return 0; }
    var method = _jx_str_dec_at_a(a, line, len, load64(&pos + 8));
    if (method == 0) { return 0; }

    # id is a raw JSON literal (may be number, string-with-quotes, null);
    # 0 means absent → notification.
    var id_raw = _jx_raw_at_a(a, line, len, load64(&pos + 16));
    var params = _jx_raw_at_a(a, line, len, load64(&pos + 24));
    if (params == 0) { params = "null"; }

    var r = alloc_via(a, 32);
    store64(r, jsonrpc);
    store64(r + 8, id_raw);
    store64(r + 16, method);
    store64(r + 24, params);
    return r;
}

fn codec_parse_request(line) {
    return codec_parse_request_a(default_alloc(), line);
}

# Copy cstr `src` (n bytes) to p; return the address after it.
fn _cdc_put(p, src, n) {
    memcpy(p, src, n);
    return p + n;
}

# Serialize a JsonRpcResponse to a cstr. A success is sized first and written
# once: no builder, no growth, no second copy. `a` owns the bytes.
fn codec_serialize_response_a(a, resp) {
    if (resp == 0) { return ""; }
    var id = resp_id(resp);
    if (id == 0) { id = "null"; }
    var err = resp_error_obj(resp);
    if (err != 0) {
        # Sized here: a client wrote the id and often the message, and a plain add
        # past the room it has grows on the heap. An escaped byte is at most six.
        var msg = rpc_err_message(err);
        var data = rpc_err_data(err);
        var room = 256 + strlen(id);
        if (msg != 0) { room = room + strlen(msg) * 6; }
        if (data != 0) { room = room + strlen(data); }
        var eb = str_builder_new_a(a);
        _sb_grow_a(a, eb, room);
        str_builder_add_cstr(eb, "{\"jsonrpc\":\"");
        str_builder_add_cstr(eb, resp_jsonrpc(resp));
        str_builder_add_cstr(eb, "\",\"id\":");
        str_builder_add_cstr(eb, id);
        str_builder_add_cstr(eb, ",\"error\":{\"code\":");
        str_builder_add_int(eb, rpc_err_code(err));
        str_builder_add_cstr(eb, ",\"message\":\"");
        _json_emit_escaped(eb, msg);
        str_builder_add_cstr(eb, "\"");
        if (data != 0) {
            str_builder_add_cstr(eb, ",\"data\":");
            str_builder_add_cstr(eb, data);
        }
        str_builder_add_cstr(eb, "}}");
        return str_data(str_builder_build_a(a, eb));
    }
    var result = resp_result(resp);
    if (result == 0) { result = "null"; }
    var ver = resp_jsonrpc(resp);
    var vl = strlen(ver);
    var il = strlen(id);
    var rl = strlen(result);
    var out = alloc_via(a, 12 + vl + 7 + il + 10 + rl + 2);
    var p = _cdc_put(out, "{\"jsonrpc\":\"", 12);
    p = _cdc_put(p, ver, vl);
    p = _cdc_put(p, "\",\"id\":", 7);
    p = _cdc_put(p, id, il);
    p = _cdc_put(p, ",\"result\":", 10);
    p = _cdc_put(p, result, rl);
    store8(p, 125);
    store8(p + 1, 0);
    return out;
}

fn codec_serialize_response(resp) {
    return codec_serialize_response_a(default_alloc(), resp);
}

# Build a JSON-RPC parse-error response and return its serialized form.
fn _cdc_error_text_a(a, code, prefix, reason) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128);
    str_builder_add_cstr(sb, prefix);
    str_builder_add_cstr(sb, reason);
    return codec_serialize_response_a(a, resp_error_a(a, "null", code, str_data(str_builder_build_a(a, sb))));
}

fn _cdc_parse_error_a(a, reason) { return _cdc_error_text_a(a, 0 - 32700, "parse error: ", reason); }
fn _cdc_invalid_request_a(a, reason) { return _cdc_error_text_a(a, 0 - 32600, "invalid request: ", reason); }
fn _cdc_parse_error(reason) { return _cdc_parse_error_a(default_alloc(), reason); }
fn _cdc_invalid_request(reason) { return _cdc_invalid_request_a(default_alloc(), reason); }

# One DEBUG line for a dispatched request (3.4.0): method, id, the tool for
# a tools/call, how it ended, and how long dispatch took. Method, id and tool
# name are client-supplied and go through bote_log_str's escaping; params
# and results are never logged.
fn _cdc_log_request(req, resp, t0) { return _cdc_log_request_a(default_alloc(), req, resp, t0); }

fn _cdc_log_request_a(a, req, resp, t0) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_DEBUG, "request");
    var method = req_method(req);
    bote_log_str(&ln, "method", method);
    var id = req_id(req);
    if (id != 0) { bote_log_str(&ln, "id", id); }
    if (method != 0) {
        if (streq(method, "tools/call") == 1) {
            bote_log_str(&ln, "tool", jsonx_get_str_a(a, req_params(req), "name"));
        }
    }
    if (bote_req_was_cancelled() == 1) {
        bote_log_str(&ln, "status", "cancelled");
    } elif (resp == 0) {
        bote_log_str(&ln, "status", "notification");
    } elif (resp_error_obj(resp) != 0) {
        bote_log_str(&ln, "status", "error");
        bote_log_int(&ln, "code", rpc_err_code(resp_error_obj(resp)));
    } elif (_cdc_is_tool_error(a, resp_result(resp)) == 1) {
        # A failed tool call is a result, not an error, since 3.4.5 covers
        # input validation too: without this it would log as "ok".
        bote_log_str(&ln, "status", "tool_error");
    } else {
        bote_log_str(&ln, "status", "ok");
    }
    bote_log_int(&ln, "us", (clock_now_ns() - t0) / 1000);
    bote_log_emit(&ln);
    return 0;
}

# 1 when `result` (a raw JSON literal) is a tool result carrying
# "isError":true.
fn _cdc_is_tool_error(a, result) {
    if (result == 0) { return 0; }
    var flag = jsonx_get_raw_a(a, result, "isError");
    if (flag == 0) { return 0; }
    return streq(flag, "true");
}

# 1 when `raw`, a value jsonx_get_raw took from a validated message, may be
# a request id: a string, a number or null (JSON-RPC 2.0 §4). An object, an
# array or a boolean may not.
fn _cdc_id_ok(raw) {
    var c = load8(raw);
    if (c == 34 || c == 45 || c == 110) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

# 1 when `raw` may be a request's params. JSON-RPC 2.0 §4.2 allows only a
# structured value (an object or an array). An explicit null is taken as
# absent, as codec_parse_request already does for a missing member: some
# clients send it, and it carries nothing a method could misread.
fn _cdc_params_ok(raw) {
    var c = load8(raw);
    if (c == 123 || c == 91 || c == 110) { return 1; }
    return 0;
}

# Parse one request object (`line`, already known to be valid JSON) into a
# request the dispatcher may be handed. Returns the request, or 0 with
# *err_out set to the serialized -32600 response. bridge.cyr's
# single-message path calls this too, so the two cannot drift apart.
#
# The id is echoed in the error when it could be read; a missing or
# unusable id is answered with null (JSON-RPC 2.0 §5).
fn _cdc_admit(line, err_out) { return _cdc_admit_a(default_alloc(), line, err_out); }

# 1 when the object `line` names the key `name` (`wl` bytes) more than once among its own
# members, keys compared as they decode. It allocates nothing.
fn _cdc_names_twice(line, name, wl) {
    var n = strlen(line);
    var i = _cdc_skip_ws(line, n, 0);
    if (i >= n || load8(line + i) != 123) { return 0; }
    i = _cdc_skip_ws(line, n, i + 1);
    var seen = 0;
    while (i < n && load8(line + i) == 34) {
        var ke = _jx_skip_string(line, n, i);
        if (_jx_dec_eq(line + i + 1, ke - i - 2, name, wl) == 1) { seen = seen + 1; }
        i = _cdc_skip_ws(line, n, ke);
        if (i >= n || load8(line + i) != 58) { return 0; }
        i = _cdc_skip_ws(line, n, _jx_skip_value(line, n, _cdc_skip_ws(line, n, i + 1)));
        if (i < n && load8(line + i) == 44) { i = _cdc_skip_ws(line, n, i + 1); }
    }
    if (seen > 1) { return 1; }
    return 0;
}

# `keys` is what _jx_valid_keys_a said of `line` (1 none named twice, 2 one is), or 0 for a
# caller that did not ask, and the check is made here (3.8.6).
fn _cdc_admit_l_a(a, line, err_out, log, keys) {
    store64(err_out, 0);
    var req = codec_parse_request_a(a, line);
    if (req == 0) {
        if (log == 1) { bote_log_debug("request rejected: malformed JSON-RPC object"); }
        # JSON-RPC §5: the id is null only when it cannot be read.
        var eid = jsonx_get_raw_a(a, line, "id");
        # Nor when `id` is named twice (3.8.7, from the 3.8.6 review): this answer went out
        # with the first of them.
        if (eid == 0 || _cdc_id_ok(eid) == 0 || _cdc_names_twice(line, "id", 2) == 1) { eid = "null"; }
        store64(err_out, codec_serialize_response_a(a, resp_error_a(a, eid, 0 - 32600, "invalid request: malformed object")));
        return 0;
    }
    # A key named twice in any object of the message, or one that is no text (3.8.6), before
    # anything reads a field: the envelope, params, arguments and all below them. The reading
    # is given back once done. The id is echoed unless it is the key named twice.
    if (keys == 2 || (keys == 0 && _jx_repeats_a(a, line, 0) == 1)) {
        if (log == 1) { bote_log_debug("request rejected: a key named twice, or one that is no text"); }
        var rid = req_id(req);
        if (rid == 0 || _cdc_id_ok(rid) == 0 || _cdc_names_twice(line, "id", 2) == 1) { rid = "null"; }
        store64(err_out, codec_serialize_response_a(a, resp_error_a(a, rid, 0 - 32600, BOTE_REQ_KEYS_MSG)));
        return 0;
    }
    var id = req_id(req);
    if (id != 0 && _cdc_id_ok(id) == 0) {
        store64(err_out, _cdc_invalid_request_a(a, "id must be a string, a number or null"));
        return 0;
    }
    if (id == 0) { id = "null"; }
    if (streq(req_jsonrpc(req), "2.0") == 0) {
        var sb = str_builder_new_a(a);
        _sb_grow_a(a, sb, 128);
        str_builder_add_cstr(sb, "unsupported jsonrpc version '");
        str_builder_add_cstr(sb, req_jsonrpc(req));
        str_builder_add_cstr(sb, "'");
        store64(err_out, codec_serialize_response_a(a, resp_error_a(a, id, 0 - 32600, str_data(str_builder_build_a(a, sb)))));
        return 0;
    }
    if (_cdc_params_ok(req_params(req)) == 0) {
        store64(err_out, codec_serialize_response_a(a, resp_error_a(a, id, 0 - 32600,
              "invalid request: params must be an object or an array")));
        return 0;
    }
    return req;
}

fn _cdc_admit_a(a, line, err_out) { return _cdc_admit_l_a(a, line, err_out, 1, 0); }
fn _cdc_admit_k_a(a, line, err_out, keys) { return _cdc_admit_l_a(a, line, err_out, 1, keys); }

# 1 when `resp`, the answer the codec gave the last message it processed on this thread,
# answers input it took no request with an id from (3.8.9: a notification is not one): no JSON, no request object, a notification it refused, a
# JSON-RPC response a client sent, a batch of nothing it took. An HTTP transport answers it
# with 400 (3.8.7): MCP's Streamable HTTP requires an HTTP error status for input the server
# does not accept. (3.8.8, from the 3.8.7 review) The codec says so as it goes (the state's
# +160); at 3.8.7 an answer was matched by its prefix, an error with a null id, which also
# matched the errors of a request whose id is null, and missed a batch and a response.
fn codec_unanswerable(resp) {
    if (resp == 0) { return 0; }
    if (load64(bote_req_state() + BOTE_REQ_STATE_TAKEN) == 1) { return 0; }
    return 1;
}

# Process a single request body. Returns serialized response cstr or 0 (notif).
fn _cdc_process_single_a(a, line, dispatcher, claims) { return _cdc_process_single_k_a(a, line, dispatcher, claims, 0); }

# _cdc_process_single_a with what _jx_valid_keys_a said of `line` (`keys`, as admission takes it).
fn _cdc_process_single_k_a(a, line, dispatcher, claims, keys) {
    # The clock is read only when DEBUG is on; at the default level the
    # per-request cost of logging is one level compare.
    var dbg = bote_log_enabled(SK_DEBUG);
    var t0 = 0;
    if (dbg == 1) { t0 = clock_now_ns(); }
    var err_slot[8];
    var req = _cdc_admit_k_a(a, line, &err_slot, keys);
    if (req == 0) { return load64(&err_slot); }
    # The request, named for its cancellation check (3.7.5): the state once, for every
    # message, since on a worker it is a thread-local lookup. (3.8.8) And taken.
    var rs = bote_req_state();
    # (3.8.9, from the 3.8.8 review) A request with an id, which its answer answers: a batch
    # of a notification and a response the codec refused was taken through the notification,
    # and went with 200.
    if (req_id(req) != 0) { store64(rs + BOTE_REQ_STATE_TAKEN, 1); }
    store64(rs + BOTE_REQ_STATE_CANCEL + 16, req_id(req));
    # And for its progress (3.7.6): where its token is, none sent yet.
    store64(rs + BOTE_REQ_STATE_PROGRESS + 16, req_params(req));
    store64(rs + BOTE_REQ_STATE_PROGRESS + 32, 0);
    var resp = _dsp_dispatch_admitted_a(a, dispatcher, req, claims);
    if (dbg == 1) { _cdc_log_request_a(a, req, resp, t0); }
    store64(rs + BOTE_REQ_STATE_CANCEL + 16, 0);
    store64(rs + BOTE_REQ_STATE_PROGRESS + 16, 0);
    # A request its handler found cancelled gets nothing more, its response included
    # (MCP 2026-07-28: the server MUST NOT send any further messages for it).
    # The flag stays, for a transport that must close rather than answer (3.7.7): the next
    # message's begin clears it, and a batch clears it between its requests. It is not
    # cleared here before the dispatch: a cancellation from another connection may have
    # landed already (src/session.cyr, session_inflight_cancel).
    if (load64(rs + BOTE_REQ_STATE_CANCEL + 24) == 1) { return 0; }
    # A connection that is itself the stream takes a listen over, and hears its cancel
    # (3.7.3, a BoteStream in src/protocol.cyr). From the state already in hand.
    var st = load64(rs + BOTE_REQ_STATE_STREAM);
    if (st > 1) {
        if (resp == 0) {
            if (streq(req_method(req), "notifications/cancelled") == 1) {
                var cid = 0;
                if (req_params(req) != 0) { cid = jsonx_get_raw_a(a, req_params(req), "requestId"); }
                bote_stream_cancel_a(st, a, cid);
            }
            return 0;
        }
        if (resp_error_obj(resp) == 0 && streq(req_method(req), "subscriptions/listen") == 1) {
            return bote_stream_open_a(st, a, req, resp);
        }
    }
    if (resp == 0) { return 0; }
    return codec_serialize_response_a(a, resp);
}

# ---- cancellation on a line transport (3.7.5) ---------------------------------------

# A request id as a value, on `a`, from its `n` raw bytes: "s" and the decoded string, or
# "n" and the raw number, so `"a/b"` and `"a\/b"` are one id and `7` and `"7"` are two.
# JSON-RPC compares ids by value. A string whose value holds a NUL is "r" and its spelling:
# a C string cannot hold the value, and its spelling must not pass for another's value
# (`"\u0000a"` was `"\\u0000a"` through 3.7.4). Numbers are compared as spelled.
fn bote_id_key_a(a, raw, n) {
    var k = alloc_via(a, n + 2);
    if (n > 0 && load8(raw) == 34) {
        var cp = alloc_via(a, n + 1);
        memcpy(cp, raw, n);
        store8(cp + n, 0);
        var s = _jx_str_at_a(a, cp, n, 0);
        if (s == 0) { s = ""; }
        var sl = strlen(s);
        var dec = s;
        if (_jx_has_escape(s, sl) == 1) {
            dec = alloc_via(a, sl + 1);
            var dn = _jx_unescape_into(s, sl, dec);
            if (strlen(dec) != dn) {
                store8(k, 114);
                memcpy(k + 1, raw, n);
                store8(k + 1 + n, 0);
                return k;
            }
        }
        store8(k, 115);
        memcpy(k + 1, dec, strlen(dec) + 1);
        return k;
    }
    store8(k, 110);
    memcpy(k + 1, raw, n);
    store8(k + 1 + n, 0);
    return k;
}

# 1 when the `n` bytes at `p` hold `needle`.
fn _cdc_holds(p, n, needle) {
    var k = strlen(needle);
    var c0 = load8(needle);
    var i = 0;
    while (i + k <= n) {
        if (load8(p + i) == c0 && memeq(p + i, needle, k) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when the `n` bytes at `p`, one line, are a `notifications/cancelled` whose `requestId`
# is the id whose key is `want`. A line is copied and read only when it spells the method
# plainly or holds an escape, which may spell it another way: the codec reads
# `notifications\/cancelled` as the same method.
# The raw `requestId` of the `n` bytes at `p` when they are one `notifications/cancelled`
# the codec would admit, on `a`, or 0 (3.7.7, for any transport: a line, a WebSocket frame,
# a POST's body). `params` is left at *params_out for the reason.
fn codec_cancelled_id_a(a, p, n, params_out) {
    store64(params_out, 0);
    if (n <= 0) { return 0; }
    if (_cdc_holds(p, n, "notifications/cancelled") == 0 && _cdc_holds(p, n, "\\") == 0) { return 0; }
    var line = alloc_via(a, n + 1);
    memcpy(line, p, n);
    store8(line + n, 0);
    var kv = _jx_valid_keys_a(a, line, n);
    if (kv == 0) { return 0; }
    # As the codec admits it (3.7.6): the scanner honored a `"jsonrpc":"1.0"` cancellation
    # the codec refuses (the 3.7.5 review).
    # Without the line the codec logs when it serves it, in its turn (3.7.7).
    var err[8];
    var req = _cdc_admit_l_a(a, line, &err, 0, kv);
    if (req == 0 || req_id(req) != 0 || req_method(req) == 0) { return 0; }
    if (streq(req_method(req), "notifications/cancelled") == 0 || req_params(req) == 0) { return 0; }
    store64(params_out, req_params(req));
    return jsonx_get_raw_a(a, req_params(req), "requestId");
}

fn _cdc_line_cancels_a(a, p, n, want) {
    var params[8];
    var rid = codec_cancelled_id_a(a, p, n, &params);
    if (rid == 0) { return 0; }
    if (streq(bote_id_key_a(a, rid, strlen(rid)), want) == 0) { return 0; }
    var req_params_raw = load64(&params);
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_TRACE, "request cancelled by the client");
    var why = jsonx_get_str_dec_a(a, req_params_raw, "reason");
    if (why != 0) { bote_log_str(&ln, "reason", why); }
    bote_log_emit(&ln);
    return 1;
}

# 1 when the `n` bytes at `p`, one message, cancel the request whose raw id is `id`: a
# WebSocket frame (3.7.7). What it reads goes once it is read.
fn codec_message_cancels_a(a, p, n, id) {
    if (id == 0) { return 0; }
    var m[16];
    bote_arena_mark(a, &m);
    var hit = _cdc_line_cancels_a(a, p, n, bote_id_key_a(a, id, strlen(id)));
    bote_arena_release(a, &m);
    return hit;
}

# For a transport whose messages are lines (stdio, a Unix socket): 1 when a complete line
# of the `n` bytes at `p` cancels the request whose raw id is `id`. *done is set to the
# bytes the complete lines take, which a later look need not read again. The lines stay
# where they are, for the transport to serve in their turn: a cancellation it then reads
# names a request already answered, or one already cancelled, and is ignored.
fn codec_lines_cancel_a(a, p, n, id, done) {
    store64(done, 0);
    if (id == 0) { return 0; }
    var want = bote_id_key_a(a, id, strlen(id));
    var i = 0;
    var start = 0;
    var hit = 0;
    var m[16];
    while (i < n) {
        if (load8(p + i) == 10) {
            # Each line's reading goes once it is read: a buffer of them costs one at a time.
            bote_arena_mark(a, &m);
            if (hit == 0 && _cdc_line_cancels_a(a, p + start, i - start, want) == 1) { hit = 1; }
            bote_arena_release(a, &m);
            start = i + 1;
        }
        i = i + 1;
    }
    store64(done, start);
    return hit;
}

# ---- progress (3.7.6) ----------------------------------------------------------------

# 1 when `raw` may be a progressToken: a string or a number (MCP's ProgressToken).
fn _cdc_token_ok(raw) {
    if (raw == 0 || load8(raw) == 0) { return 0; }
    var c = load8(raw);
    if (c == 34 || c == 45 || (c >= 48 && c <= 57)) { return 1; }
    return 0;
}

# Report the progress of the request the calling thread is serving: `progress` so far, out
# of `total` (or -1 for none known), with `message` (or 0). It goes as
# `notifications/progress` on the request's own stream, stamped with the progressToken the
# request carried. 1 when it went; 0 when there is nothing to send it to, the request
# carrying no token, a transport or a client with no stream for it, or a request already cancelled
# (nothing more goes out for one); -1 when it was refused, a `progress` no greater than the
# last one sent (MCP: it MUST increase), or the connection would not take it. Nothing is
# kept: the notification is built on the request arena and gone once sent.
fn bote_progress(progress, total, message) {
    var s = bote_req_state();
    var fp = load64(s + BOTE_REQ_STATE_PROGRESS);
    var params = load64(s + BOTE_REQ_STATE_PROGRESS + 16);
    if (fp == 0 || params == 0) { return 0; }
    if (load64(s + BOTE_REQ_STATE_CANCEL + 24) == 1) { return 0; }
    # Off the serving thread, nothing, before the arena is touched (3.7.7).
    if (sys_gettid() != load64(s + BOTE_REQ_STATE_OWNER)) { return 0; }
    var a = bote_req_alloc();
    var m[16];
    bote_req_mark(&m);
    var meta = jsonx_get_raw_a(a, params, "_meta");
    var tok = 0;
    if (meta != 0) { tok = jsonx_get_raw_a(a, meta, "progressToken"); }
    if (_cdc_token_ok(tok) == 0) {
        bote_req_release(&m);
        return 0;
    }
    if (load64(s + BOTE_REQ_STATE_PROGRESS + 32) > 0 && progress <= load64(s + BOTE_REQ_STATE_PROGRESS + 24)) {
        bote_req_release(&m);
        return 0 - 1;
    }
    var sb = str_builder_new_a(a);
    var room = strlen(tok) + 192;
    if (message != 0) { room = room + strlen(message) * 6; }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\",\"params\":{\"progressToken\":");
    str_builder_add_cstr(sb, tok);
    str_builder_add_cstr(sb, ",\"progress\":");
    str_builder_add_int_a(a, sb, progress);
    if (total >= 0) {
        str_builder_add_cstr(sb, ",\"total\":");
        str_builder_add_int_a(a, sb, total);
    }
    if (message != 0) {
        str_builder_add_cstr(sb, ",\"message\":\"");
        bote_json_escape(sb, message);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}}");
    var r = fncall3(fp, load64(s + BOTE_REQ_STATE_PROGRESS + 8), a, str_data(str_builder_build_a(a, sb)));
    bote_req_release(&m);
    if (r < 0) { return 0 - 1; }
    if (r == 1) { return 0; }
    store64(s + BOTE_REQ_STATE_PROGRESS + 24, progress);
    store64(s + BOTE_REQ_STATE_PROGRESS + 32, load64(s + BOTE_REQ_STATE_PROGRESS + 32) + 1);
    return 1;
}

# Walk a top-level JSON array (cstr starting with `[`); for each element,
# extract its raw bytes and append to the returned vec of cstrs.
# Caller verifies non-empty.
fn _cdc_split_array(a, buf) {
    var out = vec_new_a(a);
    var len = strlen(buf);
    var i = _cdc_skip_ws(buf, len, 0);
    if (i >= len) { return out; }
    if (load8(buf + i) != 91) { return out; }
    i = i + 1;
    while (i < len) {
        i = _cdc_skip_ws(buf, len, i);
        if (i >= len) { return out; }
        if (load8(buf + i) == 93) { return out; }
        var start = i;
        var end = _jx_skip_value(buf, len, i);
        vec_push_a(a, out, _slice_cstr(a, buf, start, end - start));
        i = _cdc_skip_ws(buf, len, end);
        if (i < len) { if (load8(buf + i) == 44) { i = i + 1; } }
    }
    return out;
}

# Process a raw JSON-RPC message. Returns serialized response cstr or 0.
#
# The whole message is syntax-checked first (jsonx_valid), so that invalid
# JSON is a parse error (-32700) and every later step reads valid JSON.
# Only then does the shape decide: an object is one request, an array is a
# batch, and any other JSON value is an invalid request (-32600).
fn codec_process_message(input, dispatcher, claims) {
    return codec_process_message_a(default_alloc(), input, dispatcher, claims);
}

# codec_process_message with every byte bote owns on `a`, the response included:
# the caller keeps `a` until it has sent the response.
fn codec_process_message_a(a, input, dispatcher, claims) {
    # (3.8.9, from the 3.8.8 review) What this message takes, from nothing: through 3.8.8 only
    # bote_req_begin cleared it, which the heap form never calls, so after one request taken
    # every later message's answer read as taken.
    store64(bote_req_state() + BOTE_REQ_STATE_TAKEN, 0);
    if (input == 0) { return _cdc_parse_error_a(a, "empty input"); }
    var len = strlen(input);
    var i = _cdc_skip_ws(input, len, 0);
    if (i >= len) { return _cdc_parse_error_a(a, "empty input"); }
    # The syntax and the keys in one walk (3.8.6).
    var kv = _jx_valid_keys_a(a, input, len);
    if (kv == 0) { return _cdc_parse_error_a(a, "invalid JSON"); }
    var first = load8(input + i);

    if (first == 91) {
        # A batch with none named twice has none in any element; one with one is looked at
        # element by element, which only such a batch pays for.
        var ek = 0;
        if (kv == 1) { ek = 1; }
        # Array (batch)
        var elems = _cdc_split_array(a, input);
        var n = vec_len(elems);
        if (n == 0) { return _cdc_invalid_request_a(a, "empty batch"); }
        # DoS guard: cap batch size. A pathological client sending a
        # 1 MiB body of `[{},{},...]` (~300k elements) would otherwise
        # process each, build a per-element response, and accumulate
        # bump-allocated buffers until OOM. 100 is generous for any
        # legitimate batch use case (real clients batch <10 calls).
        if (n > CODEC_MAX_BATCH) {
            return _cdc_invalid_request_a(a, "batch too large");
        }
        # A batch carries no stream: 2026-07-28 has no batches, and an answer in an array
        # cannot be one.
        bote_req_set_stream(0);
        var responses = vec_new_a(a);
        # (3.8.10, from the 3.8.9 review) Its requests' judgements share one budget base, so
        # a batch of a hundred calls may do the work of one and its own bytes, not of a
        # hundred: each had its own, and 69 KB of calls took 521 ms.
        _sch_pool_open();
        var ei = 0;
        while (ei < n) {
            var elem = vec_get(elems, ei);
            # Each element must be an object
            if (jsonx_is_object(elem) == 0) {
                vec_push_a(a, responses, _cdc_invalid_request_a(a, "batch element is not an object"));
            } else {
                var single = _cdc_process_single_k_a(a, elem, dispatcher, claims, ek);
                if (single != 0) { vec_push_a(a, responses, single); }
                # One request's cancellation is not the next one's (3.7.7).
                bote_req_set_request_id(0);
            }
            ei = ei + 1;
        }
        _sch_pool_close();
        var nr = vec_len(responses);
        if (nr == 0) { return 0; }
        var sb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, sb, "[");
        var ri = 0;
        while (ri < nr) {
            if (ri > 0) { str_builder_add_cstr_a(a, sb, ","); }
            str_builder_add_cstr_a(a, sb, vec_get(responses, ri));
            ri = ri + 1;
        }
        str_builder_add_cstr_a(a, sb, "]");
        return str_data(str_builder_build_a(a, sb));
    }

    if (first == 123) {
        return _cdc_process_single_k_a(a, input, dispatcher, claims, kv);
    }

    return _cdc_invalid_request_a(a, "expected object or array");
}

# --- schema.cyr ---

# bote::schema — JSON Schema compilation and validation
# Mirrors rust-old/src/schema.rs
#
# Cyrius limitations vs Rust:
#   - No floats. A number is read exactly for its type (integral or not,
#     exponents included) and truncated toward zero for its bounds; see
#     _sch_num_parse.
#   - apply_defaults is not yet implemented (would need JSON object mutation).

# ================================================================
# SchemaTypeTag
# ================================================================

enum SchemaTypeTag {
    SCH_STRING = 0;
    SCH_NUMBER = 1;
    SCH_INTEGER = 2;
    SCH_BOOLEAN = 3;
    SCH_ARRAY = 4;
    SCH_OBJECT = 5;
    SCH_ANY = 6;
    SCH_NEVER = 7;
    SCH_NULL = 8;
}

# (3.8.15, from the 3.8.14 review) The word lists and kinds maps registration reads, each made
# once for the process and published by compare-and-swap, where through 3.8.14 every
# registration made them again on the heap and kept them (18 KB a call): slots 0 to 7 the word
# lists (_sch_words_c), 8 to 10 the kinds maps of 2020-12, 2019-09 and the draft-07 engine.
var _sch_wc[96];

fn _sch_words_c(i, list) {
    var slot = &_sch_wc + i * 8;
    var w = load64(slot);
    if (w != 0) { return w; }
    w = _reg_words(list);
    if (atomic_cas(slot, 0, w) == 0) { w = load64(slot); }
    return w;
}

# ================================================================
# PropertyDef (336 bytes):
#   +0  type_tag         i64
#   +8  description      cstr or 0
#   +16 enum_values      vec of cstrs (string only) or 0
#   +24 default          cstr (raw JSON literal) or 0
#   +32 has_min          0/1
#   +40 minimum          i64
#   +48 has_max          0/1
#   +56 maximum          i64
#   +64 items            PropertyDef ptr (array element type) or 0
#   +72 nested_compiled  CompiledSchema ptr (object nested schema) or 0
#   +80 minimum_raw      the minimum as written (a JSON number), or 0 (3.8.2)
#   +88 maximum_raw      the maximum as written, or 0
#   +96 min_length       a string's fewest characters, or -1 (3.8.5)
#   +104 max_length      its most, or -1
#   +112 min_items       an array's fewest items, or -1
#   +120 max_items       its most, or -1
#   +128 exclusive_min_raw  the exclusiveMinimum as written, or 0
#   +136 exclusive_max_raw  the exclusiveMaximum as written, or 0
#   +144 type_mask      (3.8.7) for a `type` that is an array of names, a bit for each
#                       (1 << its SchemaTypeTag), the tag SCH_ANY; 0 for one name or none
#   +152 const_raw      the `const` value as written, or 0
#   +160 enum_raw       vec of each `enum` value as written, or 0; +16 holds its strings,
#                       decoded at registration
#   +168 unique_items   1 for `uniqueItems: true`, else 0
#   +176 prefix_items   (3.8.8) vec of a PropertyDef for each `prefixItems` schema, or 0
#   +184 contains       the `contains` schema's PropertyDef, or 0
#   +192 min_contains   how few items must meet it, or -1 (one)
#   +200 max_contains   how many may, or -1
#   +208 all_of         (3.8.9) vec of a PropertyDef for each `allOf` schema, or 0
#   +216 any_of         ... each `anyOf` schema, or 0
#   +224 one_of         ... each `oneOf` schema, or 0
#   +232 not            the `not` schema's PropertyDef, or 0
#   +240 if             the `if` schema's PropertyDef, or 0
#   +248 then           the `then` schema's, judged when the value meets `if`, or 0
#   +256 else           the `else` schema's, judged when it does not, or 0
#   +264 composes       1 when any of +208 to +240, or +272 or +304, is set
#   +272 ref            (3.8.10) the PropertyDef its `$ref` names, resolved in its document
#                       at registration, or 0; judged as an `allOf` of one is
#   +280 pattern        (3.8.11) the `pattern` compiled (src/regex.cyr), or 0 for none or
#                       one bote's engine does not take
#   +288 multiple_of    (3.8.11) the `multipleOf` as bote judges it (_sch_multiple_of), or 0
#   +296 format         (3.8.13) the `format` as src/format.cyr names it, or 0 for none, one
#                       the official client does not know, or `regex`, which bote does not judge
#   +304 dyn_ref        (3.8.14) the document root's PropertyDef, which a `$dynamicRef` or a
#                       `$recursiveRef` names in 2019-09 and 2020-12, or 0; judged as a `$ref`
#                       is. Registration takes one only where the official client's Ajv and
#                       JSON Schema both resolve it to the root (_sch_dyn_why)
#   +312 uneval_props   (3.8.15) the `unevaluatedProperties` schema's PropertyDef, or 0: it
#                       judges each member of an object no keyword beside it evaluated
#                       (_sv_uneval_props)
#   +320 uneval_items   the `unevaluatedItems` schema's PropertyDef, or 0
#   +328 items_local    how many of an array's first items this schema's own keywords
#                       evaluate: `prefixItems` (or draft-07's and 2019-09's array `items`)
#                       its length, `items` (and `additionalItems`) all of them, as
#                       BOTE_SCH_ALL_ITEMS; 0 for none
#
# (3.8.5) Each keyword applies to a value of its kind whatever the schema's `type`, as in
# JSON Schema: `{"maxLength":3}` judges a string and passes a number. The type is a check of
# its own. (3.8.7) `const` and `enum` judge every value, by JSON Schema's equality.
# ================================================================

fn prop_new(tag) {
    var p = alloc(336);
    store64(p, tag);
    var k = 8;
    while (k < 96) { store64(p + k, 0); k = k + 8; }
    while (k < 128) { store64(p + k, 0 - 1); k = k + 8; }
    while (k < 192) { store64(p + k, 0); k = k + 8; }
    store64(p + 192, 0 - 1);
    store64(p + 200, 0 - 1);
    k = 208;
    while (k < 336) { store64(p + k, 0); k = k + 8; }
    return p;
}

fn prop_tag(p) { return load64(p); }
fn prop_description(p) { return load64(p + 8); }
fn prop_enum_values(p) { return load64(p + 16); }
fn prop_default(p) { return load64(p + 24); }
fn prop_has_min(p) { return load64(p + 32); }
fn prop_min(p) { return load64(p + 40); }
fn prop_has_max(p) { return load64(p + 48); }
fn prop_max(p) { return load64(p + 56); }
fn prop_items(p) { return load64(p + 64); }
fn prop_nested(p) { return load64(p + 72); }
fn prop_min_raw(p) { return load64(p + 80); }
fn prop_max_raw(p) { return load64(p + 88); }
fn prop_min_length(p) { return load64(p + 96); }
fn prop_max_length(p) { return load64(p + 104); }
fn prop_min_items(p) { return load64(p + 112); }
fn prop_max_items(p) { return load64(p + 120); }
fn prop_exclusive_min_raw(p) { return load64(p + 128); }
fn prop_exclusive_max_raw(p) { return load64(p + 136); }
fn prop_type_mask(p) { return load64(p + 144); }
fn prop_const_raw(p) { return load64(p + 152); }
fn prop_enum_raw(p) { return load64(p + 160); }
fn prop_unique_items(p) { return load64(p + 168); }
fn prop_prefix_items(p) { return load64(p + 176); }
fn prop_contains(p) { return load64(p + 184); }
fn prop_min_contains(p) { return load64(p + 192); }
fn prop_max_contains(p) { return load64(p + 200); }
fn prop_all_of(p) { return load64(p + 208); }
fn prop_any_of(p) { return load64(p + 216); }
fn prop_one_of(p) { return load64(p + 224); }
fn prop_not(p) { return load64(p + 232); }
fn prop_if(p) { return load64(p + 240); }
fn prop_then(p) { return load64(p + 248); }
fn prop_else(p) { return load64(p + 256); }
fn prop_composes(p) { return load64(p + 264); }
fn prop_ref(p) { return load64(p + 272); }
fn prop_pattern(p) { return load64(p + 280); }
fn prop_multiple_of(p) { return load64(p + 288); }
fn prop_format(p) { return load64(p + 296); }
fn prop_dyn_ref(p) { return load64(p + 304); }
fn prop_uneval_props(p) { return load64(p + 312); }
fn prop_uneval_items(p) { return load64(p + 320); }
fn prop_items_local(p) { return load64(p + 328); }

# (3.8.15) Every item of an array, as a count of the ones evaluated.
var BOTE_SCH_ALL_ITEMS = 4611686018427387904;

# ================================================================
# CompiledSchema (144 bytes):
#   +0  properties  hashmap: name_cstr -> PropertyDef ptr
#   +8  required    vec of name_cstrs
#   +16 names       vec of name_cstrs (insertion order)
#   +24 watch       hashmap: name_cstr -> a Watch (24 B: +0 its slot, from 1, +8 its
#                   PropertyDef or 0, +16 (3.8.14) 1 when the name is one of JavaScript's
#                   Object.prototype), for every property and every required name (3.8.5)
#   +32 slots       how many names `watch` holds
#   +40 additional  PropertyDef a member no property names must meet, or 0 for any;
#                   `additionalProperties: false` is one of SCH_NEVER (3.8.5)
#   +48 min_props   the fewest members, or -1
#   +56 max_props   the most, or -1
#   +64 watched     vec of name, Watch, the name's length, in slot order: a schema of
#                   BOTE_SV_LINEAR names or fewer is matched against these as each key is
#                   written, with no copy and no hash
#   +72 required_w  vec of each required name and its Watch (0 for a name holding a NUL),
#                   two words each; a name in `required` that is not the one here, pushed
#                   after compiled_set_required, is looked for in the object instead
#   +80 property_names  (3.8.8) the `propertyNames` schema's PropertyDef, or 0
#   +88 dep_required    vec of three for each `dependentRequired` member: its name, its Watch,
#                       and a vec of each name it requires and that name's Watch; or 0
#   +96 dep_schemas     vec of three for each `dependentSchemas` member: its name, its Watch
#                       and its schema's PropertyDef; or 0
#   +104 composition    (3.8.9) a PropertyDef holding an inputSchema root's composition
#                       (compiled_compile), judged after its members, or 0
#   +112 patterns       (3.8.12) vec of each `patternProperties` pattern bote's engine
#                       takes, compiled, and its schema's PropertyDef, two words each, or 0
#   +120 declined       1 when one of its patterns is one the engine does not take: which
#                       members it covers is unknown, so `additionalProperties` judges nothing
#   +128 proto          (3.8.14) vec of the Watch of each property whose name is one of
#                       JavaScript's Object.prototype (`toString`, `constructor`), or 0
#   +136 all_props      (3.8.15) 1 when an `additionalProperties` schema is present, any, so
#                       every member is evaluated (_sv_evaluated)
#   +144 dunder         (3.8.15, from the 3.8.14 review) the PropertyDef of a property named
#                       `__proto__`, which judges a member of that name in arguments, as JSON
#                       Schema has it, and none in a result, as the client's Ajv reads it; or 0
#
# An object is judged in one walk of its members (_sv_object): each is looked up in `watch`
# once, for its property and its slot, and a required name is met when its slot was seen.
# ================================================================

fn compiled_new() {
    var c = alloc(152);
    store64(c, map_new());
    store64(c + 8, vec_new());
    store64(c + 16, vec_new());
    store64(c + 24, map_new());
    store64(c + 32, 0);
    store64(c + 40, 0);
    store64(c + 48, 0 - 1);
    store64(c + 56, 0 - 1);
    store64(c + 64, vec_new());
    store64(c + 72, vec_new());
    store64(c + 80, 0);
    store64(c + 88, 0);
    store64(c + 96, 0);
    store64(c + 104, 0);
    store64(c + 112, 0);
    store64(c + 120, 0);
    store64(c + 128, 0);
    store64(c + 136, 0);
    store64(c + 144, 0);
    return c;
}

fn compiled_properties(c) { return load64(c); }
fn compiled_required(c) { return load64(c + 8); }
fn compiled_names(c) { return load64(c + 16); }
fn compiled_additional(c) { return load64(c + 40); }
fn compiled_min_properties(c) { return load64(c + 48); }
fn compiled_max_properties(c) { return load64(c + 56); }

fn compiled_get_property(c, name) {
    return map_get(compiled_properties(c), name);
}

# The Watch for `name` in `c`, made with the next slot when there is none.
fn _sch_watch(c, name) {
    var m = load64(c + 24);
    var w = map_get(m, name);
    if (w != 0) { return w; }
    w = alloc(24);
    store64(c + 32, load64(c + 32) + 1);
    store64(w, load64(c + 32));
    store64(w + 8, 0);
    store64(w + 16, _sch_js_proto_name(name));
    map_set(m, name, w);
    vec_push(load64(c + 64), name);
    vec_push(load64(c + 64), w);
    vec_push(load64(c + 64), strlen(name));
    return w;
}

# (3.8.13, from the 3.8.12 review) A property named `__proto__` is none, as Ajv reads one
# (allSchemaProperties): it judges no member of a result, and a member of that name is
# additional. (3.8.15, from the 3.8.14 review) In arguments it judges that member, as JSON
# Schema has it (CompiledSchema +144).
fn compiled_add_property(c, name, prop) {
    if (name != 0 && streq(name, "__proto__") == 1) {
        store64(c + 144, prop);
        return 0;
    }
    map_set(compiled_properties(c), name, prop);
    vec_push(compiled_names(c), name);
    if (name != 0) {
        var w = _sch_watch(c, name);
        store64(w + 8, prop);
        if (load64(w + 16) == 1) {
            if (load64(c + 128) == 0) { store64(c + 128, vec_new()); }
            vec_push(load64(c + 128), w);
        }
    }
    return 0;
}

# 1 when `name` is one of JavaScript's Object.prototype, which every object has to a client
# (3.8.14, from the 3.8.13 review). The official client's Ajv asks `data[name] !== undefined`
# of an object, which finds them: to it every object has a `toString`.
fn _sch_js_proto_name(name) {
    if (name == 0) { return 0; }
    var c = load8(name);
    if (c != 95 && c != 99 && c != 104 && c != 105 && c != 112 && c != 116 && c != 118) { return 0; }
    var ws = BOTE_SCH_JS_PROTO;
    var n = strlen(name);
    var i = 0;
    while (load8(ws + i) != 0) {
        var j = i;
        while (load8(ws + j) != 32 && load8(ws + j) != 0) { j = j + 1; }
        if (j - i == n && memeq(ws + i, name, n) == 1) { return 1; }
        i = j;
        if (load8(ws + i) == 32) { i = i + 1; }
    }
    return 0;
}

# A name that holds a NUL is 0 (_sch_str_dec_a), and never met.
fn compiled_set_required(c, required_vec) {
    store64(c + 8, required_vec);
    var rw = vec_new();
    if (required_vec != 0) {
        var i = 0;
        while (i < vec_len(required_vec)) {
            var w = 0;
            if (vec_get(required_vec, i) != 0) { w = _sch_watch(c, vec_get(required_vec, i)); }
            vec_push(rw, vec_get(required_vec, i));
            vec_push(rw, w);
            i = i + 1;
        }
    }
    store64(c + 72, rw);
    return 0;
}

# ================================================================
# Helpers — JSON value type detection on raw cstr
# ================================================================

# Returns the first non-whitespace byte of `s`, or 0 if EOS.
fn _sch_first_nonws(s) {
    if (s == 0) { return 0; }
    var i = 0;
    while (1 == 1) {
        var c = load8(s + i);
        if (c == 0) { return 0; }
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return c; }
    }
    return 0;
}

# Type-detection predicates on raw JSON value cstrs.
fn _sch_is_string(v) { if (_sch_first_nonws(v) == 34) { return 1; } return 0; }
fn _sch_is_array(v)  { if (_sch_first_nonws(v) == 91) { return 1; } return 0; }
fn _sch_is_object(v) { if (_sch_first_nonws(v) == 123) { return 1; } return 0; }
fn _sch_is_boolean(v) {
    var c = _sch_first_nonws(v);
    if (c == 116 || c == 102) { return 1; }
    return 0;
}
fn _sch_is_null(v) { if (_sch_first_nonws(v) == 110) { return 1; } return 0; }

# Magnitude a parsed number saturates at: 2^62.
var SCH_NUM_SAT = 4611686018427387904;

fn _sch_is_digit(c) {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

# Parse the JSON number at the start of v (RFC 8259 §6; leading whitespace
# allowed, parsing stops where the number ends). Writes the value truncated
# toward zero to *val_out, its magnitude saturating at SCH_NUM_SAT. Returns 2
# when the value is integral, 1 when it has a non-zero fractional part, and 0
# when v does not begin with a JSON number.
#
# Integral is JSON Schema 2020-12's rule, the dialect MCP 2025-11-25 defaults
# to: a number with a zero fractional part is an integer, so `5.0` and `1e2`
# are integers. Through 3.4.7 the validator rejected any `.` for `integer`,
# and it read numbers up to the first non-digit, so `5e2` counted as 5. That
# only became reachable in production once schemas were compiled at
# registration (3.4.8).
#
# A bound is compared exactly, from the number as written (_sch_num_cmp, 3.8.2); the
# truncated value is what a handler reading a number gets, and what a bound built without
# its text is compared with.
fn _sch_num_parse(v, val_out) {
    store64(val_out, 0);
    if (v == 0) { return 0; }
    var i = 0;
    while (load8(v + i) == 32 || load8(v + i) == 9 || load8(v + i) == 10 || load8(v + i) == 13) { i = i + 1; }
    var neg = 0;
    if (load8(v + i) == 45) { neg = 1; i = i + 1; }
    if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
    var istart = i;
    if (load8(v + i) == 48) { i = i + 1; }
    else { while (_sch_is_digit(load8(v + i)) == 1) { i = i + 1; } }
    var ilen = i - istart;
    var fstart = i;
    var flen = 0;
    if (load8(v + i) == 46) {
        i = i + 1;
        if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
        fstart = i;
        while (_sch_is_digit(load8(v + i)) == 1) { i = i + 1; }
        flen = i - fstart;
    }
    var e = 0;
    if (load8(v + i) == 101 || load8(v + i) == 69) {
        i = i + 1;
        var eneg = 0;
        if (load8(v + i) == 43) { i = i + 1; }
        elif (load8(v + i) == 45) { eneg = 1; i = i + 1; }
        if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
        while (_sch_is_digit(load8(v + i)) == 1) {
            if (e < 100000) { e = e * 10 + (load8(v + i) - 48); }
            i = i + 1;
        }
        if (eneg == 1) { e = 0 - e; }
    }
    # The digits, integer part then fraction, scaled by 10^(e - flen). The
    # first `keep` of them are the integer part of the value.
    var dlen = ilen + flen;
    var scale = e - flen;
    var keep = dlen;
    if (scale < 0) {
        keep = dlen + scale;
        if (keep < 0) { keep = 0; }
    }
    var integral = 2;
    var n = 0;
    var k = 0;
    while (k < dlen) {
        var ch = 0;
        if (k < ilen) { ch = load8(v + istart + k); }
        else { ch = load8(v + fstart + k - ilen); }
        if (k < keep) {
            if (n < SCH_NUM_SAT / 10) { n = n * 10 + (ch - 48); }
            else { n = SCH_NUM_SAT; }
        } elif (ch != 48) {
            integral = 1;
        }
        k = k + 1;
    }
    var m = 0;
    while (m < scale && n != 0) {
        if (n < SCH_NUM_SAT / 10) { n = n * 10; }
        else { n = SCH_NUM_SAT; m = scale; }
        m = m + 1;
    }
    if (n > SCH_NUM_SAT) { n = SCH_NUM_SAT; }
    if (neg == 1) { n = 0 - n; }
    store64(val_out, n);
    return integral;
}

# The JSON number at the start of v as a sign and a significand times a power of ten, for
# _sch_num_cmp: o+0 the sign (1, -1, or 0 for zero), o+8 the exponent E such that the
# value is 0.d1d2... x 10^E, o+16 and o+24 where the integer digits start and how many,
# o+32 and o+40 the fraction's, o+48 the index of the first significant digit among
# those, o+56 one past the last. 0 when v does not begin with a number, else 1. The
# grammar is _sch_num_parse's; an exponent is read while it is under 10^15, so to 16 digits,
# and one longer is held there.
# (3.8.12, from the 3.8.11 review) It stopped at 100000, so one of seven digits or more was
# read as its first six: 1e1000000 equalled 1e100000.
fn _sch_num_norm(v, o) {
    if (v == 0) { return 0; }
    var i = 0;
    while (load8(v + i) == 32 || load8(v + i) == 9 || load8(v + i) == 10 || load8(v + i) == 13) { i = i + 1; }
    var sign = 1;
    if (load8(v + i) == 45) { sign = 0 - 1; i = i + 1; }
    if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
    var istart = i;
    if (load8(v + i) == 48) { i = i + 1; }
    else { while (_sch_is_digit(load8(v + i)) == 1) { i = i + 1; } }
    var ilen = i - istart;
    var fstart = i;
    var flen = 0;
    if (load8(v + i) == 46) {
        i = i + 1;
        if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
        fstart = i;
        while (_sch_is_digit(load8(v + i)) == 1) { i = i + 1; }
        flen = i - fstart;
    }
    var e = 0;
    if (load8(v + i) == 101 || load8(v + i) == 69) {
        i = i + 1;
        var eneg = 0;
        if (load8(v + i) == 43) { i = i + 1; }
        elif (load8(v + i) == 45) { eneg = 1; i = i + 1; }
        if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
        while (_sch_is_digit(load8(v + i)) == 1) {
            if (e < 1000000000000000) { e = e * 10 + (load8(v + i) - 48); }
            i = i + 1;
        }
        if (eneg == 1) { e = 0 - e; }
    }
    store64(o + 16, istart);
    store64(o + 24, ilen);
    store64(o + 32, fstart);
    store64(o + 40, flen);
    var first = 0 - 1;
    var last = 0;
    var k = 0;
    while (k < ilen + flen) {
        if (_sch_num_digit(v, o, k) != 48) {
            if (first < 0) { first = k; }
            last = k + 1;
        }
        k = k + 1;
    }
    if (first < 0) {
        store64(o, 0);
        return 1;
    }
    store64(o, sign);
    store64(o + 8, ilen - first + e);
    store64(o + 48, first);
    store64(o + 56, last);
    return 1;
}

# The k-th digit of the number _sch_num_norm read into `o`, integer digits then fraction.
fn _sch_num_digit(v, o, k) {
    if (k < load64(o + 24)) { return load8(v + load64(o + 16) + k); }
    return load8(v + load64(o + 32) + k - load64(o + 24));
}

# The JSON numbers at the start of `a` and `b` compared exactly, as decimals: -1, 0 or 1,
# or 2 when either is no number (3.8.2). Through 3.8.1 a bound was compared as its value
# truncated toward zero and held at SCH_NUM_SAT, so `minimum` 4.5 took 4.1, and a result's
# 6e18 met `maximum` 5e18, each held at 2^62.
fn _sch_num_cmp(a, b) {
    var x[64];
    var y[64];
    if (_sch_num_norm(a, &x) == 0 || _sch_num_norm(b, &y) == 0) { return 2; }
    var sx = load64(&x);
    var sy = load64(&y);
    if (sx != sy) {
        if (sx < sy) { return 0 - 1; }
        return 1;
    }
    if (sx == 0) { return 0; }
    # The same sign: the larger magnitude is the larger when positive.
    var m = 0;
    var ex = load64(&x + 8);
    var ey = load64(&y + 8);
    if (ex != ey) {
        m = 0 - 1;
        if (ex > ey) { m = 1; }
    } else {
        var lx = load64(&x + 56) - load64(&x + 48);
        var ly = load64(&y + 56) - load64(&y + 48);
        var k = 0;
        while (m == 0 && (k < lx || k < ly)) {
            var dx = 48;
            var dy = 48;
            if (k < lx) { dx = _sch_num_digit(a, &x, load64(&x + 48) + k); }
            if (k < ly) { dy = _sch_num_digit(b, &y, load64(&y + 48) + k); }
            if (dx < dy) { m = 0 - 1; }
            elif (dx > dy) { m = 1; }
            k = k + 1;
        }
    }
    return m * sx;
}

# A bound's text, kept where comparing its value would not be exact: a fraction, or past
# what _sch_num_parse holds. An integer inside that range compares exactly as a value,
# whatever the value it is compared with, since a value held at SCH_NUM_SAT is still on
# the right side of it, and costs no decimal compare. 0 for those.
# `multipleOf` as bote judges it (3.8.11), from its raw JSON: 0 for none, a value that is no
# number, or one of more than 17 significant digits, each of which judges nothing (and
# registration warns); else 24 bytes: +0 1, or 2 for zero, which no number meets, as the
# official client has it; +8 its significant digits as an integer, +16 the power of ten
# they are times. A negative one is judged by its size, as the client judges it.
fn _sch_multiple_of(raw) {
    if (raw == 0 || _sch_is_number_text(raw) == 0) { return 0; }
    var o[64];
    if (_sch_num_norm(raw, &o) == 0) { return 0; }
    var m = alloc(24);
    memset(m, 0, 24);
    if (load64(&o) == 0) { store64(m, 2); return m; }
    var first = load64(&o + 48);
    var last = load64(&o + 56);
    var nd = last - first;
    if (nd > 17) { return 0; }
    var d = 0;
    var k = first;
    while (k < last) { d = d * 10 + (_sch_num_digit(raw, &o, k) - 48); k = k + 1; }
    store64(m, 1);
    store64(m + 8, d);
    store64(m + 16, load64(&o + 8) - nd);
    return m;
}

# 1 when the JSON number at `v` is a multiple of `m` (_sch_multiple_of), exactly: a value
# D x 10^p, D its significant digits, is one of M x 10^q when D x 10^(p - q) is divisible
# by M. With p < q it is not, as D ends in no zero; a power of ten past 64 divides as 64
# does, M (under 10^17) holding fewer twos and fives than that. The official client divides
# as doubles, and finds 19.99 no multiple of 0.01; registration warns of a fractional one.
fn _sch_is_multiple(v, m) {
    if (load64(m) == 2) { return 0; }
    var o[64];
    if (_sch_num_norm(v, &o) == 0) { return 0; }
    if (load64(&o) == 0) { return 1; }
    var first = load64(&o + 48);
    var last = load64(&o + 56);
    var e = load64(&o + 8) - (last - first) - load64(m + 16);
    if (e < 0) { return 0; }
    var dm = load64(m + 8);
    var r = 0;
    var k = first;
    while (k < last) {
        r = (r * 10 + (_sch_num_digit(v, &o, k) - 48)) % dm;
        k = k + 1;
    }
    if (e > 64) { e = 64; }
    while (e > 0 && r != 0) { r = (r * 10) % dm; e = e - 1; }
    if (r == 0) { return 1; }
    return 0;
}

fn _sch_bound_text(b) {
    var t[8];
    if (_sch_num_parse(b, &t) == 2 && load64(&t) < SCH_NUM_SAT && load64(&t) > 0 - SCH_NUM_SAT) { return 0; }
    return b;
}

# A value against a bound: _sch_num_cmp of what each is written as, where the bound's text
# was kept and both are numbers, else 2, for the caller to compare the values
# _sch_num_parse made of them.
fn _sch_bound_cmp(vraw, braw) {
    if (braw == 0) { return 2; }
    return _sch_num_cmp(vraw, braw);
}

# Strip surrounding quotes from a JSON-string cstr ("hello" → hello).
# Caller guarantees v is a string literal. Returns a cstr owned by `a`.
fn _sch_unquote(v) { return _sch_unquote_a(default_alloc(), v); }

fn _sch_unquote_a(a, v) {
    var len = strlen(v);
    if (len < 2) { return ""; }
    var inner = len - 2;
    var out = alloc_via(a, inner + 1);
    memcpy(out, v + 1, inner);
    store8(out + inner, 0);
    return out;
}

# The value of the JSON number v, truncated toward zero (0 when v is not a
# number). It reads fractions and exponents through _sch_num_parse, so a
# bound or an argument written `5e2` is 500, not 5 (3.4.8).
# The string `v` (a JSON string's raw bytes) as it decodes (3.8.1), on `a`, or 0 when it
# decodes to hold a NUL, which no cstr can say. `required` names and string `enum` values
# are compared with what they mean, on both sides: through 3.8.0 a schema's
# `"required":["\u00e9"]` was never met. (3.8.2) At 3.8.1 a string holding a NUL was kept
# as written, and `"x\u0000y"` written is what `"x\\u0000y"` decodes to, so an enum
# holding the one took the other. Now such a value matches nothing, such a `required`
# name is never met, and registration refuses a schema that holds one.
# (3.8.3) And one that is no text a client reads as bote does, bytes that are no UTF-8 or a
# lone surrogate, decodes to 0 too, as such a key has been refused since 3.8.2: bote writes
# U+FFFD for either, a client keeps the surrogate, and `"\ud800"` met an enum of U+FFFD.
fn _sch_str_dec_a(a, v) {
    var n = strlen(v);
    var at = _jx_skip_ws(v, n, 0);
    var s = _jx_str_at_a(a, v, n, at);
    if (s == 0) { return 0; }
    var sl = strlen(s);
    if (_jx_key_text_ok(s, sl) == 0) { return 0; }
    if (_jx_has_escape(s, sl) == 0) { return s; }
    var out = alloc_via(a, sl + 1);
    if (_jx_unescape_into(s, sl, out) != strlen(out)) { return 0; }
    return out;
}

fn _sch_parse_int(v) {
    var t[8];
    _sch_num_parse(v, &t);
    return load64(&t);
}

# Walk a top-level JSON array (cstr starting with `[`); push each raw element
# bytes into a returned vec of cstrs.
fn _sch_split_array(buf) { return _sch_split_array_a(default_alloc(), buf); }

fn _sch_split_array_a(a, buf) {
    var out = vec_new_a(a);
    if (buf == 0) { return out; }
    var len = strlen(buf);
    var i = _cdc_skip_ws(buf, len, 0);
    if (i >= len) { return out; }
    if (load8(buf + i) != 91) { return out; }
    i = i + 1;
    while (i < len) {
        i = _cdc_skip_ws(buf, len, i);
        if (i >= len) { return out; }
        if (load8(buf + i) == 93) { return out; }
        var start = i;
        var end = _jx_skip_value(buf, len, i);
        var elen = end - start;
        var elem = alloc_via(a, elen + 1);
        memcpy(elem, buf + start, elen);
        store8(elem + elen, 0);
        vec_push_a(a, out, elem);
        i = _cdc_skip_ws(buf, len, end);
        if (i < len) { if (load8(buf + i) == 44) { i = i + 1; } }
    }
    return out;
}

# ================================================================
# parse_property — JSON Schema property → PropertyDef
# ================================================================

# (3.8.9, from the 3.8.8 review) The JSON Schema dialect a schema's `$schema` names: 2020
# (2020-12, and the default with none, as MCP has it), 2019 (2019-09), 7 (draft-07) or 6
# (draft-06), the four registration takes. A keyword its dialect does not have is no keyword
# to a client, which picks its validator by `$schema`, so bote judges it by nothing either:
# `prefixItems` is 2020-12's, `minContains`, `maxContains` and the `dependent*` keywords
# 2019-09's on, `if` / `then` / `else` draft-07's on. Through 3.8.8 each was judged whatever
# the dialect, so a draft-07 result a client takes could be refused, and one it refuses passed.
fn _sch_dialect(raw_json) {
    var u = jsonx_get_str_dec_a(default_alloc(), raw_json, "$schema");
    if (u == 0) { return 2020; }
    if (strstr(u, "draft/2019-09/schema") >= 0) { return 2019; }
    if (strstr(u, "draft-07/schema") >= 0) { return 7; }
    if (strstr(u, "draft-06/schema") >= 0) { return 6; }
    return 2020;
}
fn _sch_from_2019(d) { if (d == 2019 || d == 2020) { return 1; } return 0; }

# A compile's context (3.8.10; 80 bytes since 3.8.15), which carries what a subschema needs of its
# document: its dialect, and where its references point.
#   +0  d        the dialect (_sch_dialect), the root's and so every subschema's (3.8.9)
#   +8  root     the document's text, which a `$ref` is resolved in, or 0 until
#                _sch_cx_root writes out +32's
#   +16 memo     a map from each reference's target, as a canonical JSON Pointer
#                (_sch_ref_ptr), to its PropertyDef, made with the first reference, or 0: a
#                schema that refers to itself compiles to a cycle of PropertyDefs, once
#   +24 anchors  a map from each anchor's name to its pointer, read when one is first
#                named (_sch_cx_anchors), or 0
#   +32 tschema  a ToolSchema whose listed form is the document, or 0
#   +40 rootp    the root's own PropertyDef, when the root compiles to one, which `#` names
#   +48 why      what is wrong with the document's anchors, or 0 (registration's)
#   +56 pending  a vec of each PropertyDef a reference named and its schema's raw JSON, two
#                words each, compiled once the schema that named it is (_sch_cx_drain), or 0:
#                compiled where it is named, a chain of references recursed once a link,
#                and 5,000 of them overflowed a worker's stack
#   +64 nested   (3.8.11) 1 when a schema below the root names a resource of its own (`$id`)
#   +72 uneval   (3.8.15) 1 when the document can hold an unevaluated keyword: it names one,
#                holds a `\u` escape, or is not known (a ToolSchema's properties, each
#                compiled apart). Only then does each schema read them and its own count of
#                items, which no other keyword reads (8 to 11% of a compile, measured).
fn _sch_cx_new(root, d) {
    var cx = alloc(80);
    memset(cx, 0, 80);
    store64(cx, d);
    store64(cx + 8, root);
    if (root == 0 || strstr(root, "unevaluated") >= 0 || strstr(root, "\\u") >= 0) { store64(cx + 72, 1); }
    return cx;
}

# Compile every schema a reference named, and each one those name, in turn: each compile is
# as deep as its own schema, whatever the chain of references.
fn _sch_cx_drain(cx) {
    var pend = load64(cx + 56);
    if (pend == 0) { return 0; }
    while (vec_len(pend) > 0) {
        var raw = vec_pop(pend);
        var t = vec_pop(pend);
        _sch_fill(t, raw, cx);
    }
    return 0;
}

# The PropertyDef of the whole schema `raw_json`, a document of its own.
fn parse_property(raw_json) {
    var cx = _sch_cx_new(raw_json, _sch_dialect(raw_json));
    var p = prop_new(SCH_ANY);
    store64(cx + 40, p);
    _sch_fill(p, raw_json, cx);
    _sch_cx_drain(cx);
    return p;
}

# The PropertyDef of a subschema of the document `cx` compiles.
fn _sch_parse_c(raw_json, cx) { return _sch_fill(prop_new(SCH_ANY), raw_json, cx); }

# Compile the schema `raw_json` into the PropertyDef `p`, made by prop_new and filled here,
# so a reference to a schema being compiled can be handed it first (3.8.10).
fn _sch_fill(p, raw_json, cx) {
    var d = load64(cx);
    # The schema `false` allows nothing (2020-12). Read as "no type", it allowed
    # anything.
    if (raw_json != 0 && streq(raw_json, "false") == 1) { store64(p, SCH_NEVER); return p; }
    # (3.8.1) The type as it decodes, as a client reads it: `"obj\u0065ct"` is an object.
    # Through 3.8.0 it was read as written, judged nothing, and so did "null".
    var type_str = jsonx_get_str_dec_a(default_alloc(), raw_json, "type");
    var tag = _sch_type_tag(type_str);
    # (3.8.7) A type array: any of the types it names. One name is that type.
    var tmask = 0;
    var type_raw = jsonx_get_raw(raw_json, "type");
    if (type_str == 0 && type_raw != 0 && _vp_first_nonws(type_raw) == 91) {
        var tel = _sch_split_array(type_raw);
        var ti = 0;
        var tn = 0;
        while (ti < vec_len(tel)) {
            var tv = vec_get(tel, ti);
            if (_sch_is_string(tv) == 1) {
                var tt = _sch_type_tag(_sch_str_dec_a(default_alloc(), tv));
                if (tt != SCH_ANY && (tmask & (1 << tt)) == 0) { tmask = tmask | (1 << tt); tn = tn + 1; tag = tt; }
            }
            ti = ti + 1;
        }
        if (tn != 1) { tag = SCH_ANY; }
        if (tn == 1) { tmask = 0; }
    }
    store64(p, tag);
    store64(p + 144, tmask);
    store64(p + 8, jsonx_get_str(raw_json, "description"));
    _sch_fill_eq(p, raw_json);
    var uq = jsonx_get_raw(raw_json, "uniqueItems");
    if (uq != 0 && streq(uq, "true") == 1) { store64(p + 168, 1); }

    if (tag == SCH_STRING) {
        var def_s = jsonx_get_str(raw_json, "default");
        if (def_s != 0) { store64(p + 24, def_s); }
    } elif (tag != SCH_ANY) {
        var def_v = jsonx_get_raw(raw_json, "default");
        if (def_v != 0) { store64(p + 24, def_v); }
    }
    # (3.8.5) Every keyword bote judges, whatever the type, each for the values of its kind.
    # A bound that is no number was read as 0 through 3.8.4, on a number or an integer.
    var min_s = jsonx_get_raw(raw_json, "minimum");
    if (min_s != 0 && _sch_is_number_text(min_s) == 1) { store64(p + 32, 1); store64(p + 40, _sch_parse_int(min_s)); store64(p + 80, _sch_bound_text(min_s)); }
    var max_s = jsonx_get_raw(raw_json, "maximum");
    if (max_s != 0 && _sch_is_number_text(max_s) == 1) { store64(p + 48, 1); store64(p + 56, _sch_parse_int(max_s)); store64(p + 88, _sch_bound_text(max_s)); }
    var xmin = jsonx_get_raw(raw_json, "exclusiveMinimum");
    if (xmin != 0 && _sch_is_number_text(xmin) == 1) { store64(p + 128, xmin); }
    var xmax = jsonx_get_raw(raw_json, "exclusiveMaximum");
    if (xmax != 0 && _sch_is_number_text(xmax) == 1) { store64(p + 136, xmax); }
    store64(p + 96, _sch_count_kw(raw_json, "minLength", 0));
    store64(p + 104, _sch_count_kw(raw_json, "maxLength", 1));
    # (3.8.11) `pattern`, compiled once; one bote's engine does not take judges nothing, and
    # registration warns of it. `multipleOf`, read into the integer and power of ten it is.
    var pat = _sch_kw_str(raw_json, "pattern");
    if (pat != 0) {
        var rx = bote_rx_compile(pat);
        if (bote_rx_why(rx) == 0) { store64(p + 280, rx); }
    }
    store64(p + 288, _sch_multiple_of(jsonx_get_raw(raw_json, "multipleOf")));
    # (3.8.13) `format`, as the official client's ajv-formats judges it; its expression, if it
    # has one, compiled now, so no request compiles it.
    var fmt = _sch_kw_str(raw_json, "format");
    if (fmt != 0) {
        var fid = bote_format_id(fmt);
        if (bote_format_kind(fid) != 0) { store64(p + 296, bote_format_ready(fid)); }
    }
    store64(p + 112, _sch_count_kw(raw_json, "minItems", 0));
    store64(p + 120, _sch_count_kw(raw_json, "maxItems", 1));
    var items_raw = jsonx_get_raw(raw_json, "items");
    if (items_raw != 0 && _vp_first_nonws(items_raw) != 91) { store64(p + 64, _sch_parse_c(items_raw, cx)); }
    # (3.8.8) `prefixItems`, a schema for each item from the first, `items` then judging the
    # rest; `contains`, with how few and how many items must meet it.
    var pre_raw = jsonx_get_raw(raw_json, "prefixItems");
    if (d == 2020 && pre_raw != 0 && _vp_first_nonws(pre_raw) == 91) {
        var pel = _sch_split_array(pre_raw);
        var pv = vec_new();
        var pi = 0;
        while (pi < vec_len(pel)) { vec_push(pv, _sch_parse_c(vec_get(pel, pi), cx)); pi = pi + 1; }
        store64(p + 176, pv);
    }
    var cn_raw = jsonx_get_raw(raw_json, "contains");
    if (cn_raw != 0 && _sch_is_schema_text(cn_raw) == 1) { store64(p + 184, _sch_parse_c(cn_raw, cx)); }
    if (_sch_from_2019(d) == 1) {
        # (3.8.14) A minContains of 0 asks for no match; -1 is the one asked for when there is
        # none. (3.8.15, from the 3.8.14 review) One below 0 asks, as the client's Ajv reads it,
        # for one match: contains.ts sets `valid` only where an item matches, and passes on the
        # length alone (`len >= min`) only for a `contains` that is always valid.
        var mc = _sch_count_kw(raw_json, "minContains", 0);
        var mcr = jsonx_get_raw(raw_json, "minContains");
        if (mc < 0 && _sch_is_number_text_or_0(mcr) == 1) {
            mc = 0;
            if (_sch_num_cmp(mcr, "0") < 0 && _sch_can_fail(d, cn_raw) == 1) { mc = 1; }
        }
        store64(p + 192, mc);
        store64(p + 200, _sch_count_kw(raw_json, "maxContains", 1));
    }
    _sch_compile_comp_c(p, raw_json, cx);
    if (tag == SCH_OBJECT || _sch_has_object_kw(raw_json) == 1) {
        store64(p + 72, _compile_object_body_c(raw_json, cx));
    }
    return p;
}

# (3.8.7) `enum` and `const` into `p`, for any type: each value as written, and the enum's
# strings decoded, which a string is compared with as it decodes. Through 3.8.6 enum was judged
# only where the type was string, and const not at all. (3.8.11) For an inputSchema's root too.
fn _sch_fill_eq(p, raw_json) {
    var enum_raw = jsonx_get_raw(raw_json, "enum");
    if (enum_raw != 0 && _vp_first_nonws(enum_raw) == 91) {
        var vals = vec_new();
        var elems = _sch_split_array(enum_raw);
        var ne = vec_len(elems);
        var ei = 0;
        while (ei < ne) {
            var ev = vec_get(elems, ei);
            var dv = 0;
            if (_sch_is_string(ev) == 1) { dv = _sch_str_dec_a(default_alloc(), ev); }
            if (dv != 0) { vec_push(vals, dv); }
            ei = ei + 1;
        }
        store64(p + 16, vals);
        store64(p + 160, elems);
    }
    store64(p + 152, jsonx_get_raw(raw_json, "const"));
    return 0;
}

# (3.8.9) The composition keywords of `raw_json` into the PropertyDef `p`: `allOf`, `anyOf`
# and `oneOf` each a non-empty array of schemas, `not` and `if` a schema, `then` and `else`
# a schema beside `if`. One malformed judges nothing, and registration warns of it.
fn _sch_compile_comp(p, raw_json) {
    var cx = _sch_cx_new(raw_json, _sch_dialect(raw_json));
    _sch_compile_comp_c(p, raw_json, cx);
    _sch_cx_drain(cx);
    return p;
}

fn _sch_compile_comp_c(p, raw_json, cx) {
    var d = load64(cx);
    # (3.8.10) `$ref`, in every dialect beside the keywords next to it: draft-07 says those
    # are ignored, and the official client's draft-07 engine judges them, as bote does.
    _sch_ref_into(p, raw_json, cx);
    _sch_dyn_into(p, raw_json, cx);
    if (load64(cx + 72) == 1) { _sch_uneval_into(p, raw_json, cx); }
    store64(p + 208, _sch_schemas_c(raw_json, "allOf", cx));
    store64(p + 216, _sch_schemas_c(raw_json, "anyOf", cx));
    store64(p + 224, _sch_schemas_c(raw_json, "oneOf", cx));
    var nt = jsonx_get_raw(raw_json, "not");
    if (nt != 0 && _sch_is_schema_text(nt) == 1) { store64(p + 232, _sch_parse_c(nt, cx)); }
    var ifr = jsonx_get_raw(raw_json, "if");
    # (3.8.10, from the 3.8.9 review) In draft-06 too: it has no `if`, and the official
    # client judges a draft-06 schema with its draft-07 engine, which does; through 3.8.9 a
    # result it refused passed here.
    # (3.8.12, from the 3.8.11 review) Only beside a `then` or an `else` that can fail, as
    # Ajv compiles it and as registration reaches it (_sch_kids): an `if` that leads back to
    # its own schema beside none is no loop the client sees.
    if (ifr != 0 && _sch_is_schema_text(ifr) == 1 && (_sch_can_fail(d, jsonx_get_raw(raw_json, "then")) == 1 || _sch_can_fail(d, jsonx_get_raw(raw_json, "else")) == 1)) {
        store64(p + 240, _sch_parse_c(ifr, cx));
        var th = jsonx_get_raw(raw_json, "then");
        if (th != 0 && _sch_is_schema_text(th) == 1) { store64(p + 248, _sch_parse_c(th, cx)); }
        var el = jsonx_get_raw(raw_json, "else");
        if (el != 0 && _sch_is_schema_text(el) == 1) { store64(p + 256, _sch_parse_c(el, cx)); }
    }
    var any = 0;
    var k = 208;
    while (k <= 240) { if (load64(p + k) != 0) { any = 1; } k = k + 8; }
    if (load64(p + 312) != 0 || load64(p + 320) != 0) { any = 1; }
    if (load64(p + 272) != 0 || load64(p + 304) != 0) { any = 1; }
    store64(p + 264, any);
    if (load64(cx + 72) == 1) { store64(p + 328, _sch_items_local(d, raw_json)); }
    return p;
}

# The keyword `kw` of `raw_json` as a vec of a PropertyDef for each schema, when it is an
# array of schemas (3.8.10: an empty one too), else 0.
fn _sch_schemas(raw_json, kw) {
    var cx = _sch_cx_new(raw_json, _sch_dialect(raw_json));
    var out = _sch_schemas_c(raw_json, kw, cx);
    _sch_cx_drain(cx);
    return out;
}

fn _sch_schemas_c(raw_json, kw, cx) {
    var r = jsonx_get_raw(raw_json, kw);
    if (r == 0 || _vp_first_nonws(r) != 91) { return 0; }
    var el = _sch_split_array(r);
    # (3.8.10, from the 3.8.9 review) An empty array is judged, as the official client judges
    # it: no schema in `anyOf` or `oneOf` meets anything, and `allOf` of none is met. Through
    # 3.8.9 it judged nothing, and a result the client refuses passed.
    if (vec_len(el) == 0) { return vec_new(); }
    var i = 0;
    while (i < vec_len(el)) { if (_sch_is_schema_text(vec_get(el, i)) == 0) { return 0; } i = i + 1; }
    var out = vec_new();
    i = 0;
    while (i < vec_len(el)) { vec_push(out, _sch_parse_c(vec_get(el, i), cx)); i = i + 1; }
    return out;
}

# 1 when the raw JSON value `v` may be a schema: an object, true or false.
fn _sch_is_schema_text(v) {
    var c = _vp_first_nonws(v);
    if (c == 123) { return 1; }
    if (streq(v, "true") == 1 || streq(v, "false") == 1) { return 1; }
    return 0;
}

# The SchemaTypeTag a `type` name decodes to, or SCH_ANY for none or one bote does not know.
fn _sch_type_tag(ts) {
    if (ts == 0) { return SCH_ANY; }
    if (streq(ts, "string") == 1) { return SCH_STRING; }
    if (streq(ts, "number") == 1) { return SCH_NUMBER; }
    if (streq(ts, "integer") == 1) { return SCH_INTEGER; }
    if (streq(ts, "boolean") == 1) { return SCH_BOOLEAN; }
    if (streq(ts, "array") == 1) { return SCH_ARRAY; }
    if (streq(ts, "object") == 1) { return SCH_OBJECT; }
    if (streq(ts, "null") == 1) { return SCH_NULL; }
    return SCH_ANY;
}

# _sch_is_number_text, with 0 for no value.
fn _sch_is_number_text_or_0(v) {
    if (v == 0) { return 0; }
    return _sch_is_number_text(v);
}

# 1 when the raw JSON value `v` is a number.
fn _sch_is_number_text(v) {
    var t[8];
    if (_sch_num_parse(v, &t) == 0) { return 0; }
    return 1;
}

# The keyword `kw` of `raw_json` as a bound on a count, -1 for none: a non-negative integer as
# it is; (3.8.14) any other number as the official client compares a value's count with it,
# by JavaScript's `<` (a minimum, `is_max` 0) or `>` (a maximum): a minimum of 0 or below is
# none, and a fraction above 0 the integer after it; a maximum below 0 fails every count (-2),
# and a fraction the integer before it. Through 3.8.13 each judged nothing, where the client
# refused every string for `maxLength: -1` and every one-character one for `minLength: 1.5`.
fn _sch_count_kw(raw_json, kw, is_max) {
    var r = jsonx_get_raw(raw_json, kw);
    if (r == 0) { return 0 - 1; }
    var t[8];
    var k = _sch_num_parse(r, &t);
    if (k == 0) { return 0 - 1; }
    var v = load64(&t);
    if (k == 2 && v >= 0) { return v; }
    if (is_max == 1) {
        if (_sch_num_cmp(r, "0") < 0) { return 0 - 2; }
        return v;
    }
    if (_sch_num_cmp(r, "0") <= 0) { return 0 - 1; }
    if (v < SCH_NUM_SAT) { v = v + 1; }
    return v;
}

# 1 when the keyword `kw` of `raw_json` is a non-negative integer, as JSON Schema requires a
# count to be.
fn _sch_count_plain(raw_json, kw) {
    var r = jsonx_get_raw(raw_json, kw);
    if (r == 0) { return 0; }
    var t[8];
    if (_sch_num_parse(r, &t) == 2 && load64(&t) >= 0) { return 1; }
    return 0;
}

# 1 when `raw_json` holds a keyword that judges an object.
fn _sch_has_object_kw(raw_json) {
    if (jsonx_has(raw_json, "properties") == 1 || jsonx_has(raw_json, "required") == 1) { return 1; }
    if (jsonx_has(raw_json, "additionalProperties") == 1) { return 1; }
    if (jsonx_has(raw_json, "minProperties") == 1 || jsonx_has(raw_json, "maxProperties") == 1) { return 1; }
    if (jsonx_has(raw_json, "propertyNames") == 1 || jsonx_has(raw_json, "dependentRequired") == 1) { return 1; }
    if (jsonx_has(raw_json, "dependentSchemas") == 1 || jsonx_has(raw_json, "patternProperties") == 1) { return 1; }
    return 0;
}

# Compile an object schema's body into a fresh CompiledSchema: its `properties`,
# `required`, and (3.8.5) `additionalProperties`, `minProperties` and `maxProperties`.
# (3.8.12) And `patternProperties`, each pattern compiled by src/regex.cyr; `additionalProperties`
# then covers the members neither names. Beside a pattern the engine does not take it judges
# nothing, as which members that pattern covers is unknown, and registration warns.
fn _compile_object_body(raw_json) {
    var cx = _sch_cx_new(raw_json, _sch_dialect(raw_json));
    var c = _compile_object_body_c(raw_json, cx);
    _sch_cx_drain(cx);
    return c;
}

# _compile_object_body for a subschema of the document `cx` compiles.
fn _compile_object_body_c(raw_json, cx) {
    var d = load64(cx);
    var c = compiled_new();
    var members = _jx_members(jsonx_get_raw(raw_json, "properties"));
    var mi = 0;
    while (mi < vec_len(members)) {
        compiled_add_property(c, vec_get(members, mi), _sch_parse_c(vec_get(members, mi + 1), cx));
        mi = mi + 2;
    }
    var req_raw = jsonx_get_raw(raw_json, "required");
    if (req_raw != 0) {
        var req_vec = vec_new();
        var elems = _sch_split_array(req_raw);
        var ne = vec_len(elems);
        var ei = 0;
        while (ei < ne) {
            var ev = vec_get(elems, ei);
            if (_sch_is_string(ev) == 1) {
                vec_push(req_vec, _sch_str_dec_a(default_alloc(), ev));
            }
            ei = ei + 1;
        }
        compiled_set_required(c, req_vec);
    }
    var pp = jsonx_get_raw(raw_json, "patternProperties");
    var declined = 0;
    if (pp != 0 && _vp_first_nonws(pp) == 123) {
        var pmem = _jx_members(pp);
        var pv = vec_new();
        var pmi = 0;
        while (pmi < vec_len(pmem)) {
            # (3.8.13, from the 3.8.12 review) Ajv leaves out a pattern named `__proto__`.
            if (streq(vec_get(pmem, pmi), "__proto__") == 1) { pmi = pmi + 2; continue; }
            var prx = bote_rx_compile(vec_get(pmem, pmi));
            if (bote_rx_why(prx) == 0) {
                vec_push(pv, prx);
                vec_push(pv, _sch_parse_c(vec_get(pmem, pmi + 1), cx));
            } else { declined = 1; }
            pmi = pmi + 2;
        }
        if (vec_len(pv) > 0) { store64(c + 112, pv); }
        store64(c + 120, declined);
    }
    var ap = jsonx_get_raw(raw_json, "additionalProperties");
    # (3.8.15) Any `additionalProperties` that is a schema evaluates every member it does not
    # leave to `properties` or a pattern, so with them every member: `true` and `{}` too.
    if (ap != 0 && _sch_is_schema_text(ap) == 1) { store64(c + 136, 1); }
    if (ap != 0 && declined == 0) {
        if (streq(ap, "false") == 1) { store64(c + 40, prop_new(SCH_NEVER)); }
        elif (_vp_first_nonws(ap) == 123) { store64(c + 40, _sch_parse_c(ap, cx)); }
    }
    store64(c + 48, _sch_count_kw(raw_json, "minProperties", 0));
    store64(c + 56, _sch_count_kw(raw_json, "maxProperties", 1));
    # (3.8.8) `propertyNames`, `dependentRequired` and `dependentSchemas`. Each name they key
    # on, or require, is watched, so its presence is its slot's bit.
    var pn = jsonx_get_raw(raw_json, "propertyNames");
    if (pn != 0 && _sch_is_schema_text(pn) == 1) { store64(c + 80, _sch_parse_c(pn, cx)); }
    var dr = jsonx_get_raw(raw_json, "dependentRequired");
    if (_sch_from_2019(d) == 1 && dr != 0 && _vp_first_nonws(dr) == 123) {
        var drm = _jx_members(dr);
        var drv = vec_new();
        var di = 0;
        while (di < vec_len(drm)) {
            var dv = vec_get(drm, di + 1);
            if (_vp_first_nonws(dv) == 91) {
                var names = vec_new();
                var del = _sch_split_array(dv);
                var dj = 0;
                while (dj < vec_len(del)) {
                    var de = vec_get(del, dj);
                    if (_sch_is_string(de) == 1) {
                        # (3.8.9, from the 3.8.8 review) A name that is no text is kept, as one
                        # no member meets, as a `required` one is: dropped, its requirement
                        # was never asked, where a client asks it and refuses.
                        var dn = _sch_str_dec_a(default_alloc(), de);
                        vec_push(names, dn);
                        if (dn != 0) { vec_push(names, _sch_watch(c, dn)); } else { vec_push(names, 0); }
                    }
                    dj = dj + 1;
                }
                vec_push(drv, vec_get(drm, di));
                vec_push(drv, _sch_watch(c, vec_get(drm, di)));
                vec_push(drv, names);
            }
            di = di + 2;
        }
        store64(c + 88, drv);
    }
    var ds = jsonx_get_raw(raw_json, "dependentSchemas");
    if (_sch_from_2019(d) == 1 && ds != 0 && _vp_first_nonws(ds) == 123) {
        var dsm = _jx_members(ds);
        var dsv = vec_new();
        var si = 0;
        while (si < vec_len(dsm)) {
            if (_sch_is_schema_text(vec_get(dsm, si + 1)) == 1) {
                vec_push(dsv, vec_get(dsm, si));
                vec_push(dsv, _sch_watch(c, vec_get(dsm, si)));
                vec_push(dsv, _sch_parse_c(vec_get(dsm, si + 1), cx));
            }
            si = si + 2;
        }
        store64(c + 96, dsv);
    }
    return c;
}

# ================================================================
# References (3.8.10) — `$ref` within its document
# ================================================================
#
# A `$ref` names a schema in the document it is in: `#`, a JSON Pointer (`#/$defs/node`), an
# anchor (`#node`, an `$anchor`, a `$dynamicAnchor` or draft-07's `$id: "#node"`), or the same
# behind the root's `$id`. Each is resolved at registration, as the official client's Ajv
# resolves it, and one that resolves to nothing, or outside the document, is refused there
# (_sch_refs_why). A reference is handed its target's PropertyDef at once, compiled once the
# schema naming it is (_sch_cx_drain), so a recursive schema compiles to a cycle, once.

# The document `cx` resolves in: its text, or its ToolSchema's as tools/list sends it.
fn _sch_cx_root(cx) {
    if (load64(cx + 8) == 0 && load64(cx + 32) != 0) {
        var sb = str_builder_new();
        _emit_schema(sb, load64(cx + 32));
        store64(cx + 8, str_data(str_builder_build(sb)));
    }
    return load64(cx + 8);
}

# The value of keyword `kw` of the schema `raw_json` when it is a string, as it decodes, or 0
# for none, another kind of value, or a string that is no text or holds a NUL.
fn _sch_kw_str(raw_json, kw) {
    var r = jsonx_get_raw(raw_json, kw);
    if (r == 0 || _sch_is_string(r) == 0) { return 0; }
    return _sch_str_dec_a(default_alloc(), r);
}

# The schema's `$ref` into the PropertyDef `p`, when it resolves.
fn _sch_ref_into(p, raw_json, cx) {
    if (raw_json == 0 || _vp_first_nonws(raw_json) != 123) { return 0; }
    var r = _sch_kw_str(raw_json, "$ref");
    if (r == 0) { return 0; }
    var t = _sch_ref_target(cx, r);
    if (t != 0) { store64(p + 272, t); }
    return 0;
}

# (3.8.15) The schema's `unevaluatedProperties` and `unevaluatedItems` into `p`, in 2019-09 and
# 2020-12, the dialects that have them (the official client's draft-07 engine has neither).
fn _sch_uneval_into(p, raw_json, cx) {
    if (_sch_from_2019(load64(cx)) == 0) { return 0; }
    if (raw_json == 0 || _vp_first_nonws(raw_json) != 123) { return 0; }
    var up = jsonx_get_raw(raw_json, "unevaluatedProperties");
    if (up != 0 && _sch_is_schema_text(up) == 1) { store64(p + 312, _sch_parse_c(up, cx)); }
    var ui = jsonx_get_raw(raw_json, "unevaluatedItems");
    if (ui != 0 && _sch_is_schema_text(ui) == 1) { store64(p + 320, _sch_parse_c(ui, cx)); }
    return 0;
}

# How many of an array's first items the schema `raw`'s own keywords evaluate, as the official
# client's Ajv counts them (its `it.items`): `prefixItems`, or an array `items` in draft-07 and
# 2019-09, its length; an `items` schema, and `additionalItems` beside an array `items`, all of
# them (BOTE_SCH_ALL_ITEMS). `contains` beside `unevaluatedItems` registration refuses
# (_sch_uneval_items_why), so it is not counted here.
fn _sch_items_local(d, raw) {
    if (raw == 0 || _vp_first_nonws(raw) != 123) { return 0; }
    var it = jsonx_get_raw(raw, "items");
    if (d == 2020) {
        if (it != 0 && _sch_is_schema_text(it) == 1) { return BOTE_SCH_ALL_ITEMS; }
        var pi = jsonx_get_raw(raw, "prefixItems");
        if (pi != 0 && _vp_first_nonws(pi) == 91) { return vec_len(_sch_split_array(pi)); }
        return 0;
    }
    if (it == 0) { return 0; }
    if (_vp_first_nonws(it) == 91) {
        var ai = jsonx_get_raw(raw, "additionalItems");
        if (ai != 0 && _sch_is_schema_text(ai) == 1) { return BOTE_SCH_ALL_ITEMS; }
        return vec_len(_sch_split_array(it));
    }
    if (_sch_is_schema_text(it) == 1) { return BOTE_SCH_ALL_ITEMS; }
    return 0;
}

# (3.8.14) The schema's `$dynamicRef` or `$recursiveRef` into `p`, as the document's root. The
# official client's engines for 2019-09 and 2020-12 judge both, its draft-07 engine neither;
# JSON Schema gives 2019-09 the one and 2020-12 the other. Ajv resolves neither as `$ref`
# does: it calls the schema that an anchor of its name was first met on in this judgement
# (`$dynamicAnchor`, or `$recursiveAnchor: true` for `$recursiveRef: "#"`), and with none met,
# the schema it is compiling as a function of its own (dynamicRef.ts). JSON Schema resolves
# it as `$ref` first and goes by the anchors met only when the schema it names holds one
# (the outermost). They agree only where the root holds the anchor, which both then find
# first, and that is all registration takes (_sch_dyn_why), so the root is what it names.
fn _sch_dyn_into(p, raw_json, cx) {
    if (_sch_from_2019(load64(cx)) == 0) { return 0; }
    if (raw_json == 0 || _vp_first_nonws(raw_json) != 123) { return 0; }
    if (_sch_dyn_str(raw_json) == 0) { return 0; }
    var t = _sch_ref_target(cx, "#");
    if (t != 0) { store64(p + 304, t); }
    return 0;
}

# The fragment the schema `raw`'s `$dynamicRef`, or else its `$recursiveRef`, names, as it
# decodes (`#` and what follows), or 0 when it has neither as a string starting `#`.
fn _sch_dyn_str(raw) {
    var r = 0;
    if (jsonx_has(raw, "$dynamicRef") == 1) { r = _sch_kw_str(raw, "$dynamicRef"); }
    if (r != 0 && load8(r) == 35) { return r; }
    r = 0;
    if (jsonx_has(raw, "$recursiveRef") == 1) { r = _sch_kw_str(raw, "$recursiveRef"); }
    if (r != 0 && load8(r) == 35) { return r; }
    return 0;
}

# The PropertyDef the reference `ref` names in `cx`'s document, compiled the first time it is
# named, or 0 when it names no schema there.
fn _sch_ref_target(cx, ref) {
    var ptr = _sch_ref_ptr(cx, ref);
    if (ptr == 0) { return 0; }
    if (load8(ptr) == 0 && load64(cx + 40) != 0) { return load64(cx + 40); }
    var memo = load64(cx + 16);
    if (memo == 0) { memo = map_new(); store64(cx + 16, memo); }
    if (map_has(memo, ptr) == 1) { return map_get(memo, ptr); }
    var raw = _sch_ptr_raw(cx, ptr);
    if (raw == 0 || _sch_is_schema_text(raw) == 0) { return 0; }
    var t = prop_new(SCH_ANY);
    map_set(memo, ptr, t);
    var pend = load64(cx + 56);
    if (pend == 0) { pend = vec_new(); store64(cx + 56, pend); }
    vec_push(pend, t);
    vec_push(pend, raw);
    return t;
}

# The root's `$id` without its fragment (Ajv's normalizeId takes off `#` and `#/`), which a
# reference into the document resolves against, or 0.
fn _sch_base(root) {
    var id = _sch_kw_str(root, "$id");
    if (id == 0) { return 0; }
    # (3.8.13, from the 3.8.12 review) An empty `$id` is none: the client resolves a relative
    # reference against it otherwise than bote did (`A/..` taken here, refused there).
    if (load8(id) == 0) { return 0; }
    var h = strchr(id, 35);
    if (h == 0) { return 0; }
    if (h > 0) { store8(id + h, 0); }
    return id;
}

# Where a URI's scheme ends (its `:`), or -1 when it has none (RFC 3986 §3.1).
fn _sch_uri_scheme(u) {
    var c = load8(u);
    if ((c < 65 || c > 90) && (c < 97 || c > 122)) { return 0 - 1; }
    var i = 1;
    c = load8(u + i);
    while ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46) { i = i + 1; c = load8(u + i); }
    if (c == 58) { return i; }
    return 0 - 1;
}

# Where the path of the URI `u` begins: past its scheme and its authority (`//...`), if any.
fn _sch_uri_path_at(u) {
    var i = _sch_uri_scheme(u) + 1;
    if (load8(u + i) == 47 && load8(u + i + 1) == 47) {
        i = i + 2;
        while (load8(u + i) != 0 && load8(u + i) != 47 && load8(u + i) != 63) { i = i + 1; }
    }
    return i;
}

# The path `p` with its `.` and `..` segments taken out (RFC 3986 §5.2.4), a new cstr; a
# query after it is kept as it is. (3.8.12, from the 3.8.11 review) A last `..` leaves the
# path ending in `/`, as a last `.` does, and the query's slashes are no segments: "a/b/.."
# read as "a", and "/a?b/../../y" as "/y", so bote found in the document a resource the
# client's resolver does not.
fn _sch_uri_dots(p) {
    var qa = strchr(p, 63);
    if (qa >= 0) {
        return _cat_a(default_alloc(), _sch_uri_dots(_slice_cstr(default_alloc(), p, 0, qa)), p + qa);
    }
    var segs = vec_new();
    var n = strlen(p);
    var i = 0;
    if (load8(p) == 47) { i = 1; }
    var lead = i;
    while (i <= n) {
        var j = i;
        while (j < n && load8(p + j) != 47) { j = j + 1; }
        var seg = _slice_cstr(default_alloc(), p, i, j - i);
        if (streq(seg, "..") == 1) {
            if (vec_len(segs) > 0) { vec_pop(segs); }
            if (j == n) { vec_push(segs, ""); }
        }
        elif (streq(seg, ".") == 0) { vec_push(segs, seg); }
        elif (j == n) { vec_push(segs, ""); }
        i = j + 1;
    }
    var sb = str_builder_new();
    if (lead == 1) { str_builder_add_cstr(sb, "/"); }
    var k = 0;
    while (k < vec_len(segs)) {
        if (k > 0) { str_builder_add_cstr(sb, "/"); }
        str_builder_add_cstr(sb, vec_get(segs, k));
        k = k + 1;
    }
    return str_data(str_builder_build(sb));
}

# The reference `r` (its fragment taken off) resolved against the base `b` (RFC 3986 §5.2.2,
# as Ajv's uriResolver resolves it), a new cstr.
fn _sch_uri_resolve(b, r) {
    if (_sch_uri_scheme(r) >= 0) {
        var ra = _sch_uri_path_at(r);
        return _cat_a(default_alloc(), _slice_cstr(default_alloc(), r, 0, ra), _sch_uri_dots(r + ra));
    }
    if (load8(r) == 0) { return b; }
    var bs = _sch_uri_scheme(b) + 1;
    if (load8(r) == 47 && load8(r + 1) == 47) { return _cat_a(default_alloc(), _slice_cstr(default_alloc(), b, 0, bs), r); }
    var bp = _sch_uri_path_at(b);
    var auth = _slice_cstr(default_alloc(), b, 0, bp);
    if (load8(r) == 47) { return _cat_a(default_alloc(), auth, _sch_uri_dots(r)); }
    var path = b + bp;
    var q = strchr(path, 63);
    var bpath = path;
    if (q >= 0) { bpath = _slice_cstr(default_alloc(), path, 0, q); }
    if (load8(r) == 63) { return _cat_a(default_alloc(), auth, _cat_a(default_alloc(), bpath, r)); }
    # Merged: the base's path up to its last `/`, then the reference.
    var last = 0 - 1;
    var k = 0;
    while (load8(bpath + k) != 0) { if (load8(bpath + k) == 47) { last = k; } k = k + 1; }
    var dir = "/";
    if (last >= 0) { dir = _slice_cstr(default_alloc(), bpath, 0, last + 1); }
    elif (bp == bs) { dir = ""; }
    return _cat_a(default_alloc(), auth, _sch_uri_dots(_cat_a(default_alloc(), dir, r)));
}

# 1 when the URIs `x` and `y` name one resource: the same, but for the case of the scheme
# and the host, which a URI does not distinguish (RFC 3986 §6.2.2.1) and Ajv folds.
# (3.8.12, from the 3.8.11 review) A userinfo's case counts, as it does for the client's
# resolver: bote folded the whole authority.
fn _sch_uri_same(x, y) {
    var px = _sch_uri_path_at(x);
    var py = _sch_uri_path_at(y);
    if (px != py || streq(x + px, y + py) == 0) { return 0; }
    # The userinfo, compared exactly: from past `//` to the authority's last `@`.
    var ua = 0;
    var ue = 0;
    var bs = _sch_uri_scheme(x) + 1;
    if (load8(x + bs) == 47 && load8(x + bs + 1) == 47) {
        ua = bs + 2;
        ue = ua;
        var k = ua;
        while (k < px) { if (load8(x + k) == 64) { ue = k; } k = k + 1; }
    }
    var i = 0;
    while (i < px) {
        var a = load8(x + i);
        var c = load8(y + i);
        if (i < ua || i >= ue) {
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (c >= 65 && c <= 90) { c = c + 32; }
        }
        if (a != c) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The canonical JSON Pointer of the schema the reference `ref` names in `cx`'s document,
# whether or not anything is there: "" for the root, else each part "/" and its name with `~`
# written `~0` and `/` written `~1`, so two spellings of one place are one key. 0 for a
# reference outside the document, or one that cannot be read. (3.8.11, from the 3.8.10
# review) A reference that is not a fragment is resolved against the root's `$id` as a URI
# is, relative ones and other spellings of the scheme and host included, as Ajv resolves
# it; and "" names the root.
fn _sch_ref_ptr(cx, ref) {
    var frag = 0;
    if (load8(ref) == 35) { frag = ref + 1; }
    elif (load8(ref) == 0) { frag = ref; }
    else {
        var base = _sch_base(_sch_cx_root(cx));
        if (base == 0) { return 0; }
        var h = strchr(ref, 35);
        var rp = ref;
        frag = "";
        if (h >= 0) { rp = _slice_cstr(default_alloc(), ref, 0, h); frag = ref + h + 1; }
        if (_sch_uri_same(_sch_uri_resolve(base, rp), base) == 0) { return 0; }
    }
    # Ajv reads `#` and `#/` as the root (normalizeId).
    if (load8(frag) == 0 || streq(frag, "/") == 1) { return ""; }
    if (load8(frag) == 47) { return _sch_ptr_canon(frag); }
    var name = _sch_pct_dec(frag, strlen(frag));
    if (name == 0) { return 0; }
    var an = _sch_cx_anchors(cx);
    if (map_has(an, name) == 0) { return 0; }
    return map_get(an, name);
}

# `n` bytes at `s` with each `%XX` decoded, a new cstr, or 0 for a `%` not followed by two
# hex digits or a NUL decoded (decodeURIComponent throws on the first).
fn _sch_pct_dec(s, n) {
    var o = alloc(n + 1);
    var i = 0;
    var j = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 37) {
            if (i + 2 >= n) { return 0; }
            var h = _sch_hexval(load8(s + i + 1));
            var l = _sch_hexval(load8(s + i + 2));
            if (h < 0 || l < 0) { return 0; }
            c = h * 16 + l;
            if (c == 0) { return 0; }
            i = i + 3;
        } else { i = i + 1; }
        store8(o + j, c);
        j = j + 1;
    }
    store8(o + j, 0);
    return o;
}

fn _sch_hexval(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 65 && c <= 70) { return c - 55; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0 - 1;
}

# A fragment that is a JSON Pointer (it starts with `/`), canonical. Each part between
# slashes is percent-decoded and then read as a pointer's name, `~1` a slash and `~0` a
# tilde, as Ajv reads it: it splits before it decodes, so `%2F` is a slash in a name.
fn _sch_ptr_canon(frag) {
    var sb = str_builder_new();
    var i = 0;
    var n = strlen(frag);
    while (i < n) {
        # frag[i] is a slash.
        var j = i + 1;
        while (j < n && load8(frag + j) != 47) { j = j + 1; }
        var part = _sch_pct_dec(frag + i + 1, j - i - 1);
        if (part == 0) { return 0; }
        var name = _sch_ptr_unescape(part);
        str_builder_add_cstr(sb, "/");
        _sch_ptr_escape(sb, name);
        i = j;
    }
    return str_data(str_builder_build(sb));
}

# A pointer's part as the name it means: every `~1` a slash, then every `~0` a tilde, as
# Ajv's unescapeJsonPointer replaces them.
fn _sch_ptr_unescape(part) {
    var n = strlen(part);
    var a = alloc(n + 1);
    var i = 0;
    var j = 0;
    while (i < n) {
        if (load8(part + i) == 126 && i + 1 < n && load8(part + i + 1) == 49) { store8(a + j, 47); i = i + 2; }
        else { store8(a + j, load8(part + i)); i = i + 1; }
        j = j + 1;
    }
    store8(a + j, 0);
    n = j;
    var b = alloc(n + 1);
    i = 0;
    j = 0;
    while (i < n) {
        if (load8(a + i) == 126 && i + 1 < n && load8(a + i + 1) == 48) { store8(b + j, 126); i = i + 2; }
        else { store8(b + j, load8(a + i)); i = i + 1; }
        j = j + 1;
    }
    store8(b + j, 0);
    return b;
}

# The name `name` as a canonical pointer's part.
fn _sch_ptr_escape(sb, name) {
    var i = 0;
    while (load8(name + i) != 0) {
        var c = load8(name + i);
        if (c == 126) { str_builder_add_cstr(sb, "~0"); }
        elif (c == 47) { str_builder_add_cstr(sb, "~1"); }
        else { str_builder_add_byte(sb, c); }
        i = i + 1;
    }
    return 0;
}

# The pointer `ptr`/`name` (name a key, or an index's digits), canonical.
fn _sch_ptr_join(ptr, name) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ptr);
    str_builder_add_cstr(sb, "/");
    _sch_ptr_escape(sb, name);
    return str_data(str_builder_build(sb));
}

# An array index a pointer's part names: digits, with no leading zero but for "0". -1 else.
fn _sch_ptr_index(name) {
    var n = strlen(name);
    if (n == 0 || n > 9) { return 0 - 1; }
    if (n > 1 && load8(name) == 48) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(name + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + c - 48;
        i = i + 1;
    }
    return v;
}

# The raw JSON at the canonical pointer `ptr` in `cx`'s document, or 0 when nothing is there.
fn _sch_ptr_raw(cx, ptr) {
    var cur = _sch_cx_root(cx);
    if (cur == 0) { return 0; }
    var n = strlen(ptr);
    var i = 0;
    while (i < n) {
        var j = i + 1;
        while (j < n && load8(ptr + j) != 47) { j = j + 1; }
        var name = _sch_ptr_unescape(_slice_cstr(default_alloc(), ptr, i + 1, j - i - 1));
        var c = _vp_first_nonws(cur);
        if (c == 123) {
            cur = jsonx_get_raw(cur, name);
        } elif (c == 91) {
            var ix = _sch_ptr_index(name);
            if (ix < 0) { return 0; }
            var el = _sch_split_array(cur);
            if (ix >= vec_len(el)) { return 0; }
            cur = vec_get(el, ix);
        } else { return 0; }
        if (cur == 0) { return 0; }
        i = j;
    }
    return cur;
}

# How json-schema-traverse 1.0.0 walks a schema, as Ajv walks one for its anchors and `$id`s
# (getSchemaRefs, `allKeys`): an array only under these keywords, each object of these
# keywords' objects, and any other key's object unless the key is one of the last list.
var BOTE_SCH_TR_ARRAY = "items allOf anyOf oneOf ";
var BOTE_SCH_TR_MAP = "$defs definitions properties patternProperties dependencies ";
var BOTE_SCH_TR_SKIP = "default enum const required maximum minimum exclusiveMaximum exclusiveMinimum multipleOf maxLength minLength pattern format maxItems minItems uniqueItems maxProperties minProperties ";

fn _sch_in_words(ws, k) {
    var i = 0;
    while (i < vec_len(ws)) { if (streq(vec_get(ws, i), k) == 1) { return 1; } i = i + 1; }
    return 0;
}

# Every object below the root of the document `root` that Ajv's walk reaches, its pointer and
# its raw JSON, two words each (3.8.11, from the 3.8.10 review): the root itself is left out,
# as Ajv registers nothing on it, and so are `prefixItems`' schemas, an array the walk does
# not know, while an object under an unknown keyword is reached. Through 3.8.10 an anchor on
# the root or under `prefixItems` resolved here, and the client refused the schema.
fn _sch_ajv_nodes(root) {
    var out = vec_new();
    if (root == 0) { return out; }
    var tarr = _sch_words_c(4, BOTE_SCH_TR_ARRAY);
    var tmap = _sch_words_c(5, BOTE_SCH_TR_MAP);
    var tskip = _sch_words_c(6, BOTE_SCH_TR_SKIP);
    var todo = vec_new();
    vec_push(todo, "");
    vec_push(todo, root);
    while (vec_len(todo) > 0) {
        var raw = vec_pop(todo);
        var ptr = vec_pop(todo);
        if (load8(ptr) != 0) { vec_push(out, ptr); vec_push(out, raw); }
        var mem = _jx_members(raw);
        var mi = 0;
        while (mi < vec_len(mem)) {
            var k = vec_get(mem, mi);
            var v = vec_get(mem, mi + 1);
            var c = _vp_first_nonws(v);
            if (c == 91) {
                if (_sch_in_words(tarr, k) == 1) {
                    var el = _sch_split_array(v);
                    var ei = 0;
                    while (ei < vec_len(el)) {
                        if (_vp_first_nonws(vec_get(el, ei)) == 123) {
                            vec_push(todo, _sch_ptr_join(_sch_ptr_join(ptr, k), _sch_itoa(ei)));
                            vec_push(todo, vec_get(el, ei));
                        }
                        ei = ei + 1;
                    }
                }
            } elif (_sch_in_words(tmap, k) == 1) {
                if (c == 123) {
                    var sub = _jx_members(v);
                    var si = 0;
                    while (si < vec_len(sub)) {
                        if (_vp_first_nonws(vec_get(sub, si + 1)) == 123) {
                            vec_push(todo, _sch_ptr_join(_sch_ptr_join(ptr, k), vec_get(sub, si)));
                            vec_push(todo, vec_get(sub, si + 1));
                        }
                        si = si + 2;
                    }
                }
            } elif (c == 123 && _sch_in_words(tskip, k) == 0) {
                vec_push(todo, _sch_ptr_join(ptr, k));
                vec_push(todo, v);
            }
            mi = mi + 2;
        }
    }
    return out;
}

# 1 when `name` is an anchor's name as Ajv takes one: a letter or `_`, then letters, digits,
# `-`, `.` and `_`.
fn _sch_anchor_ok(name) {
    var c = load8(name);
    if (_sch_anchor_start(c) == 0) { return 0; }
    var i = 1;
    while (load8(name + i) != 0) {
        c = load8(name + i);
        if (_sch_anchor_start(c) == 0 && (c < 48 || c > 57) && c != 45 && c != 46) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _sch_anchor_start(c) {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) { return 1; }
    return 0;
}

# The decimal digits of `v`, at least 0, a new cstr.
fn _sch_itoa(v) {
    var o = alloc(24);
    var nd = _sv_digits(v);
    store8(o + nd, 0);
    var i = nd - 1;
    while (i >= 0) { store8(o + i, 48 + v % 10); v = v / 10; i = i - 1; }
    return o;
}

# (3.8.11, from the 3.8.10 review) A name Ajv is handed twice, even for one schema (an
# `$anchor` and a `$dynamicAnchor`, or an `$id` fragment and an `$anchor`), is refused there:
# "resolves to more than one schema".
fn _sch_anchor_add(cx, an, name, checked, ptr) {
    if (name == 0 || load8(name) == 0) { return 0; }
    if (checked == 1 && _sch_anchor_ok(name) == 0) {
        if (load64(cx + 48) == 0) { store64(cx + 48, "names an anchor that is not a valid anchor name"); }
        return 0;
    }
    if (map_has(an, name) == 1) {
        if (load64(cx + 48) == 0) { store64(cx + 48, "names one anchor twice, which the official client refuses"); }
        return 0;
    }
    map_set(an, name, ptr);
    return 0;
}

# The anchor the keyword `kw` of the schema `raw` names, if it is a string, as Ajv reads one:
# a value of another kind is ignored, and a string that is no text is no name.
fn _sch_anchor_kw(cx, an, raw, kw, ptr) {
    var r = jsonx_get_raw(raw, kw);
    if (r == 0 || _sch_is_string(r) == 0) { return 0; }
    var name = _sch_str_dec_a(default_alloc(), r);
    if (name == 0) { name = "-"; }
    return _sch_anchor_add(cx, an, name, 1, ptr);
}

# The anchors of `cx`'s document, a map from each name to its schema's pointer, read the
# first time one is named, from what Ajv's walk reaches (_sch_ajv_nodes): `$anchor` and
# `$dynamicAnchor` in any dialect, as Ajv reads both, and an `$id` that is a fragment,
# draft-07's way. A name that is not one, or one named twice, is noted in the context for
# registration to refuse, and an `$id` naming a resource of its own (+64).
fn _sch_cx_anchors(cx) {
    if (load64(cx + 24) != 0) { return load64(cx + 24); }
    var an = map_new();
    store64(cx + 24, an);
    var rid = _sch_kw_str(_sch_cx_root(cx), "$id");
    if (rid != 0 && _sch_id_ok(rid) == 0) { store64(cx + 48, _sch_id_why); }
    var pos = _sch_ajv_nodes(_sch_cx_root(cx));
    # (3.8.14, found by dynref-diff) Each `$id` that names a resource, once: two alike, or one
    # alike the root's, and the client's Ajv refuses the schema ("resolves to more than one
    # schema", "already exists"). (3.8.15, from the 3.8.14 review) As Ajv's getSchemaRefs
    # reads them: each `$id` resolved against its parent's base (the nearest schema above it
    # with one, the root's own), its trailing `#` or `#/` taken off (normalizeId), and each
    # `$anchor` and `$dynamicAnchor` as `#` and its name against its schema's base, all in one
    # set; through 3.8.14 only against the root's base, so a nested base, a trailing `#`, `$id:
    # "#"` twice and an `$id` naming an anchor's URI were taken.
    var root = _sch_cx_root(cx);
    var ids = map_new();
    var bases = map_new();
    var rnorm = _sch_id_norm(_sch_kw_str(root, "$id"));
    map_set(bases, "", rnorm);
    var i = 0;
    while (i < vec_len(pos)) {
        var ptr = vec_get(pos, i);
        var raw = vec_get(pos, i + 1);
        var id = _sch_kw_str(raw, "$id");
        if (id != 0 && _sch_id_ok(id) == 0 && load64(cx + 48) == 0) { store64(cx + 48, _sch_id_why); }
        if (id != 0 && load8(id) == 35) {
            if (load8(id + 1) != 0 && streq(id, "#/") == 0) { _sch_anchor_add(cx, an, id + 1, 0, ptr); }
        } elif (id != 0) {
            store64(cx + 64, 1);
        }
        var ib = map_get(bases, _sch_ptr_parent_in(bases, ptr));
        if (id != 0 && load64(cx + 48) == 0) {
            var rid = _sch_id_norm(_sch_id_against(ib, id));
            if (map_has(ids, rid) == 1 || (load8(rnorm) != 0 && streq(rid, rnorm) == 1)) { store64(cx + 48, "names one $id twice, which the official client refuses"); }
            map_set(ids, rid, 1);
            ib = rid;
        }
        map_set(bases, ptr, ib);
        if (load64(cx + 48) == 0) {
            var ak = _sch_kw_str(raw, "$anchor");
            var dk = _sch_kw_str(raw, "$dynamicAnchor");
            var ax = 0;
            while (ax < 2) {
                var nm = ak;
                if (ax == 1) { nm = dk; }
                if (nm != 0) {
                    var aref = _sch_id_against(ib, _cat_a(default_alloc(), "#", nm));
                    if (map_has(ids, aref) == 1) { store64(cx + 48, "names one anchor twice, which the official client refuses"); }
                    map_set(ids, aref, 1);
                }
                ax = ax + 1;
            }
        }
        _sch_anchor_kw(cx, an, raw, "$anchor", ptr);
        _sch_anchor_kw(cx, an, raw, "$dynamicAnchor", ptr);
        i = i + 2;
    }
    # (3.8.14, found by dynref-diff) The root's own anchors, which Ajv does not register on a
    # root: a name it gives twice, or one an anchor below gives too, is two anchors of one
    # name in one resource to JSON Schema, and to the client once the root is no root, as in
    # the form 2025-11-25 lists a schema in.
    var ra = _sch_kw_str(root, "$anchor");
    var rd = _sch_kw_str(root, "$dynamicAnchor");
    var rf = _sch_kw_str(root, "$id");
    if (rf != 0 && (load8(rf) != 35 || load8(rf + 1) == 0 || load8(rf + 1) == 47)) { rf = 0; }
    if (rf != 0) { rf = rf + 1; }
    if (load64(cx + 48) == 0) {
        var twice = 0;
        if (ra != 0 && rd != 0 && streq(ra, rd) == 1) { twice = 1; }
        if (ra != 0 && rf != 0 && streq(ra, rf) == 1) { twice = 1; }
        if (rd != 0 && rf != 0 && streq(rd, rf) == 1) { twice = 1; }
        if ((ra != 0 && map_has(an, ra) == 1) || (rd != 0 && map_has(an, rd) == 1) || (rf != 0 && map_has(an, rf) == 1)) { twice = 1; }
        if (twice == 1) { store64(cx + 48, "names one anchor twice, which the official client refuses"); }
    }
    return an;
}

# An `$id` as Ajv's normalizeId keeps it: a trailing `#` or `#/` taken off; "" for none.
fn _sch_id_norm(id) {
    if (id == 0) { return ""; }
    var n = strlen(id);
    if (n >= 1 && load8(id + n - 1) == 35) { return _slice_cstr(default_alloc(), id, 0, n - 1); }
    if (n >= 2 && load8(id + n - 2) == 35 && load8(id + n - 1) == 47) { return _slice_cstr(default_alloc(), id, 0, n - 2); }
    return id;
}

# The `$id` or anchor reference `r` against the base `b` as Ajv's getSchemaRefs takes it: `r`
# itself where `b` is empty, else resolved as fast-uri resolves it, its fragment kept.
fn _sch_id_against(b, r) {
    if (b == 0 || load8(b) == 0) { return r; }
    var h = strchr(r, 35);
    if (h < 0) { return _sch_uri_resolve(b, r); }
    var body = _slice_cstr(default_alloc(), r, 0, h);
    return _cat_a(default_alloc(), _sch_uri_resolve(b, body), r + h);
}

# The longest pointer above `ptr` (at a `/`) that the map `m` holds, "" at the least.
fn _sch_ptr_parent_in(m, ptr) {
    var k = strlen(ptr);
    while (k > 0) {
        k = k - 1;
        if (load8(ptr + k) == 47) {
            var pp = _slice_cstr(default_alloc(), ptr, 0, k);
            if (map_has(m, pp) == 1) { return pp; }
        }
    }
    return "";
}

# (3.8.12) An `$id` the official client's resolver, fast-uri under Ajv, cannot read: it throws
# when it resolves one, or a URN it reads two ways, and Ajv compiles nothing of the schema.
# Measured against the client's own Ajv (scripts/ref-diff.sh), refused here if it is any of
# these, a few the client takes among them: a control, a space, DEL or one of `"<>\^`{|}`;
# a `%` before no two hex digits; a colon before the first `/`, `?` or `#` that ends no
# scheme; an authority whose host is no domain, dotted quad or IPv6 literal (as a website
# URL's, _bote_authority_ok), whose port is no number to 65535, or whose userinfo holds what
# none may; a path holding an empty segment (`//`); and a `urn:` whose name is no `nid:nss` as fast-uri's URN_REG reads one, that
# holds a `%`, or a `.` or `..` segment.
var _sch_id_why = "names in $id a URI the official client's resolver does not take";

fn _sch_id_ok(u) {
    var n = strlen(u);
    var i = 0;
    while (i < n) {
        var b = load8(u + i);
        if (b <= 32 || b == 127 || b == 34 || b == 60 || b == 62 || b == 92 || b == 94 || b == 96 || b == 123 || b == 124 || b == 125) { return 0; }
        if (b == 37 && (i + 2 >= n || _sch_hexval(load8(u + i + 1)) < 0 || _sch_hexval(load8(u + i + 2)) < 0)) { return 0; }
        i = i + 1;
    }
    var sc = _sch_uri_scheme(u);
    var k = 0;
    while (k < n && load8(u + k) != 47 && load8(u + k) != 63 && load8(u + k) != 35) {
        if (load8(u + k) == 58 && sc < 0) { return 0; }
        k = k + 1;
    }
    if (sc == 3 && (load8(u) | 32) == 117 && (load8(u + 1) | 32) == 114 && (load8(u + 2) | 32) == 110) { return _sch_urn_ok(u + 4); }
    var at = sc + 1;
    if (load8(u + at) == 47 && load8(u + at + 1) == 47) {
        var ae = at + 2;
        while (ae < n && load8(u + ae) != 47 && load8(u + ae) != 63 && load8(u + ae) != 35) { ae = ae + 1; }
        var hs = at + 2;
        var j = hs;
        var last = 0 - 1;
        while (j < ae) { if (load8(u + j) == 64) { last = j; } j = j + 1; }
        if (last >= 0) {
            j = hs;
            while (j < last) {
                var c = load8(u + j);
                if (c >= 128 || c == 91 || c == 93 || c == 64) { return 0; }
                j = j + 1;
            }
            hs = last + 1;
        }
        # An empty authority, as in `file:///a`, the client takes.
        if (ae > hs && _bote_authority_ok(u + hs, ae - hs) == 0) { return 0; }
        if (ae == hs && last >= 0) { return 0; }
        at = ae;
    }
    # An empty segment in the path: one starting `//` with a dot segment after it, the client
    # reads as an authority once the dots are taken out.
    var pe = at;
    while (pe < n && load8(u + pe) != 63 && load8(u + pe) != 35) { pe = pe + 1; }
    var q = at;
    while (q + 1 < pe) {
        if (load8(u + q) == 47 && load8(u + q + 1) == 47) { return 0; }
        q = q + 1;
    }
    # (3.8.13, from the 3.8.12 review) A `.` or `..` segment, written so or as `%2e`: fast-uri
    # takes them out of a `ws:` or `wss:` URI, and of one with no authority, otherwise than
    # it does of the references beside them, and the client resolves none of those references.
    var ss = at;
    q = at;
    while (q <= pe) {
        if (q == pe || load8(u + q) == 47) {
            if (_sch_dot_segment(u + ss, q - ss) == 1) { return 0; }
            ss = q + 1;
        }
        q = q + 1;
    }
    return 1;
}

# 1 when the `n` bytes at `p` are `.` or `..`, each dot perhaps written `%2e` in either case.
fn _sch_dot_segment(p, n) {
    var dots = 0;
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 46) { i = i + 1; }
        elif (i + 2 < n && load8(p + i) == 37 && load8(p + i + 1) == 50 && (load8(p + i + 2) | 32) == 101) { i = i + 3; }
        else { return 0; }
        dots = dots + 1;
    }
    if (dots == 1 || dots == 2) { return 1; }
    return 0;
}

# 1 when `s`, what follows `urn:`, is a URN the client's resolver reads one way: a name of
# 1 to 32 letters, digits and `-` (not first), a colon, and at least one of `\w`, the marks
# `!$'()*+,-./:;=@`; then perhaps a query and a fragment; no `%`, and no `.` or `..` segment.
fn _sch_urn_ok(s) {
    var n = strlen(s);
    var e = 0;
    while (e < n && load8(s + e) != 63 && load8(s + e) != 35) { e = e + 1; }
    var i = 0;
    while (i < e && load8(s + i) != 58) {
        var c = load8(s + i) | 32;
        if ((c < 97 || c > 122) && (load8(s + i) < 48 || load8(s + i) > 57) && (load8(s + i) != 45 || i == 0)) { return 0; }
        i = i + 1;
    }
    if (i == 0 || i > 32 || i >= e) { return 0; }
    var ns = i + 1;
    if (ns >= e) { return 0; }
    var j = ns;
    while (j < e) {
        var b = load8(s + j);
        var ok = 0;
        if ((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95) { ok = 1; }
        if (b == 33 || b == 36 || b == 39 || b == 40 || b == 41 || b == 42 || b == 43 || b == 44 || b == 45 || b == 46 || b == 47 || b == 58 || b == 59 || b == 61 || b == 64) { ok = 1; }
        if (ok == 0) { return 0; }
        j = j + 1;
    }
    # A `.` or `..` segment, between slashes or at either end of one.
    var ss = ns;
    j = ns;
    while (j <= e) {
        if (j == e || load8(s + j) == 47) {
            var sl = j - ss;
            if ((sl == 1 && load8(s + ss) == 46) || (sl == 2 && load8(s + ss) == 46 && load8(s + ss + 1) == 46)) { return 0; }
            ss = j + 1;
        }
        j = j + 1;
    }
    if (strchr(s, 37) >= 0) { return 0; }
    return 1;
}

# 1 when the root of `cx`'s document names the anchor `name`, which Ajv does not register.
fn _sch_root_anchor(cx, name) {
    var root = _sch_cx_root(cx);
    var a1 = _sch_kw_str(root, "$anchor");
    var a2 = _sch_kw_str(root, "$dynamicAnchor");
    var id = _sch_kw_str(root, "$id");
    if (a1 != 0 && streq(a1, name) == 1) { return 1; }
    if (a2 != 0 && streq(a2, name) == 1) { return 1; }
    if (id != 0 && load8(id) == 35 && streq(id + 1, name) == 1) { return 1; }
    return 0;
}

# Each `$ref` the document's dialect's engine reaches from the root, two words each: its
# string (0 for one that is no string) and the pointer of the schema holding it (3.8.11,
# from the 3.8.10 review). Ajv compiles a subschema only under a keyword its engine has
# (_sch_kids), and a `$ref` it never compiles, in a definition nothing names or under a
# keyword its dialect lacks, is never resolved, so registration judges only these.
fn _sch_reach(cx) { return _sch_reach_d(cx, 0); }

# _sch_reach, and (3.8.14) into `dref`, when it is a vec, each `$dynamicRef` and `$recursiveRef`
# the engine reaches in 2019-09 and 2020-12, three words each: the keyword, its string as it
# decodes (0 for one that is no string, or no text) and the pointer of the schema holding it.
fn _sch_reach_d(cx, dref) {
    var out = vec_new();
    var seen = map_new();
    var todo = vec_new();
    var d19 = _sch_from_2019(load64(cx));
    map_set(seen, "", 1);
    vec_push(todo, "");
    while (vec_len(todo) > 0) {
        var ptr = vec_pop(todo);
        var raw = _sch_ptr_raw(cx, ptr);
        if (raw != 0 && _vp_first_nonws(raw) == 123) {
            if (jsonx_has(raw, "$ref") == 1) {
                vec_push(out, _sch_kw_str(raw, "$ref"));
                vec_push(out, ptr);
            }
            if (dref != 0 && d19 == 1) {
                if (jsonx_has(raw, "$dynamicRef") == 1) {
                    vec_push(dref, "$dynamicRef");
                    vec_push(dref, _sch_kw_str(raw, "$dynamicRef"));
                    vec_push(dref, ptr);
                }
                if (jsonx_has(raw, "$recursiveRef") == 1) {
                    vec_push(dref, "$recursiveRef");
                    vec_push(dref, _sch_kw_str(raw, "$recursiveRef"));
                    vec_push(dref, ptr);
                }
            }
            var kids = _sch_kids(cx, ptr, raw, 0);
            var k = 0;
            while (k < vec_len(kids)) {
                var kp = vec_get(kids, k);
                if (map_has(seen, kp) == 0) { map_set(seen, kp, 1); vec_push(todo, kp); }
                k = k + 1;
            }
        }
    }
    return out;
}

# Push onto `out` the pointer of each schema under the keyword `kw` of `raw` (at `ptr`): its
# one schema (`how` 0), each of its array's (1), or each of its object's members' (2).
fn _sch_kids_kw(out, ptr, raw, kw, how) {
    var v = jsonx_get_raw(raw, kw);
    if (v == 0) { return 0; }
    var c = _vp_first_nonws(v);
    if (how == 0) {
        if (c == 123) { vec_push(out, _sch_ptr_join(ptr, kw)); }
        return 0;
    }
    if (how == 1) {
        if (c != 91) { return 0; }
        var el = _sch_split_array(v);
        var ei = 0;
        while (ei < vec_len(el)) {
            if (_vp_first_nonws(vec_get(el, ei)) == 123) { vec_push(out, _sch_ptr_join(_sch_ptr_join(ptr, kw), _sch_itoa(ei))); }
            ei = ei + 1;
        }
        return 0;
    }
    if (c != 123) { return 0; }
    var mem = _jx_members(v);
    var mi = 0;
    while (mi < vec_len(mem)) {
        if (_vp_first_nonws(vec_get(mem, mi + 1)) == 123) { vec_push(out, _sch_ptr_join(_sch_ptr_join(ptr, kw), vec_get(mem, mi))); }
        mi = mi + 2;
    }
    return 0;
}

# The keywords Ajv 8 compiles code for (RULES.all) in each dialect bote reads: a schema
# naming none of them, or `{}`, or `true`, never fails (alwaysValidSchema). (3.8.13, from the
# 3.8.12 review) With the four the client's addFormats adds, formatMinimum and its kin.
var BOTE_SCH_RULES_07 = "$comment $ref additionalItems additionalProperties allOf anyOf const contains dependencies else enum exclusiveMaximum exclusiveMinimum format formatExclusiveMaximum formatExclusiveMinimum formatMaximum formatMinimum id if items maxItems maxLength maxProperties maximum minItems minLength minProperties minimum multipleOf not nullable oneOf pattern patternProperties properties propertyNames required then type uniqueItems ";
var BOTE_SCH_RULES_2019 = "$dynamicAnchor $dynamicRef $recursiveAnchor $recursiveRef dependentRequired dependentSchemas maxContains minContains unevaluatedItems unevaluatedProperties ";

# 1 when the schema `raw` (or 0, none) can fail a value in the dialect `d`, as Ajv reads it.
fn _sch_can_fail(d, raw) {
    if (raw == 0) { return 0; }
    var c = _vp_first_nonws(raw);
    if (c == 116) { return 0; }
    if (c != 123) { return 1; }
    var mem = _jx_members(raw);
    var r07 = _sch_words_c(0, BOTE_SCH_RULES_07);
    var r19 = _sch_words_c(1, BOTE_SCH_RULES_2019);
    var i = 0;
    while (i < vec_len(mem)) {
        var k = vec_get(mem, i);
        if (_sch_in_words(r07, k) == 1) {
            if (d != 2020 || streq(k, "additionalItems") == 0) { return 1; }
        }
        if (_sch_from_2019(d) == 1 && (_sch_in_words(r19, k) == 1 || (d == 2020 && streq(k, "prefixItems") == 1))) { return 1; }
        i = i + 2;
    }
    return 0;
}

# Why the document `doc` cannot be registered for what its compiled schemas hold (3.8.13), or
# 0: of the schemas the dialect's engine compiles from the root (_sch_kids, as _sch_reach walks
# them), one whose `format` is no string; whose formatMinimum, formatMaximum,
# formatExclusiveMinimum or formatExclusiveMaximum is no string, has no `format` beside it, or
# sits beside a format the client knows that has no order (anything but the dates and times,
# `password` and `binary`); (from the 3.8.12 review) whose `$id` is neither a string nor
# false, null or 0, which the client calls `.replace` on; or, in 2019-09 and 2020-12, whose
# `$dynamicAnchor` is no string or `$recursiveAnchor` no boolean; (3.8.14) and in those two,
# whose `$dynamicRef` or `$recursiveRef` is no string, or no fragment (dynamicRef.ts: "only
# supports hash fragment reference"). The client's validator refuses each such schema whole.
var BOTE_SCH_FORMAT_LIMITS = "formatMinimum formatMaximum formatExclusiveMinimum formatExclusiveMaximum ";

fn _sch_compiled_why(doc) {
    if (doc == 0) { return 0; }
    var cx = _sch_cx_new(doc, _sch_dialect(doc));
    _sch_cx_anchors(cx);
    var lims = _sch_words_c(2, BOTE_SCH_FORMAT_LIMITS);
    var km = _sch_kinds_map_c(load64(cx));
    var proto = _sch_words_c(3, BOTE_SCH_JS_PROTO);
    var seen = map_new();
    var todo = vec_new();
    map_set(seen, "", 1);
    vec_push(todo, "");
    while (vec_len(todo) > 0) {
        var ptr = vec_pop(todo);
        var raw = _sch_ptr_raw(cx, ptr);
        if (raw != 0 && _vp_first_nonws(raw) == 123) {
            var w = _sch_format_node_why(raw, lims, proto);
            if (w == 0) { w = _sch_id_node_why(raw, load64(cx)); }
            if (w == 0) { w = _sch_kinds_node_why(raw, km); }
            if (w == 0) { w = _sch_type_node_why(raw); }
            if (w == 0) { w = _sch_names_node_why(raw); }
            if (w == 0) { w = _sch_pattern_node_why(raw); }
            if (w == 0) { w = _sch_client_node_why(load64(cx), ptr, raw); }
            if (w != 0) { return w; }
            var kids = _sch_kids(cx, ptr, raw, 0);
            var k = 0;
            while (k < vec_len(kids)) {
                var kp = vec_get(kids, k);
                if (map_has(seen, kp) == 0) { map_set(seen, kp, 1); vec_push(todo, kp); }
                k = k + 1;
            }
        }
    }
    # (3.8.15) What the client's Ajv judges otherwise for where its code runs, and, in the
    # engines that count what is evaluated, the model of that count (_sch_aev). Only a document
    # that names what either reads is walked again.
    var d = load64(cx);
    var model = 0;
    if (_sch_from_2019(d) == 1 && (strstr(doc, "unevaluated") >= 0 || strstr(doc, "patternProperties") >= 0 || strstr(doc, "\\u") >= 0)) { model = 1; }
    if (model == 0 && strstr(doc, "contains") < 0 && strstr(doc, "\"not\"") < 0 && strstr(doc, "\\u") < 0) { return 0; }
    return _sch_tuple_quiet_why(_sch_aev_ctx(cx), model);
}

# (3.8.14, from the 3.8.13 review) The keywords Ajv 8 checks the kind of when it compiles a
# schema (each definition's schemaType), in the engine for each dialect, by the JSON kinds it
# allows: s a string, n a number, b a boolean, o an object, a an array. A value of another
# kind and the official client's validator refuses the schema whole ("minLength value must be
# number"); through 3.8.13 bote took it, warned, and judged nothing by the keyword.
var BOTE_SCH_KINDS_ALL = "$ref:s additionalProperties:bo allOf:a anyOf:a oneOf:a not:ob if:ob then:ob else:ob contains:ob propertyNames:ob dependencies:o properties:o patternProperties:o enum:a required:a format:s formatMinimum:s formatMaximum:s formatExclusiveMinimum:s formatExclusiveMaximum:s maximum:n minimum:n exclusiveMaximum:n exclusiveMinimum:n multipleOf:n maxLength:n minLength:n maxItems:n minItems:n maxProperties:n minProperties:n nullable:b pattern:s uniqueItems:b type:sa ";
var BOTE_SCH_KINDS_07 = "additionalItems:bo items:oba ";
var BOTE_SCH_KINDS_2019 = "$dynamicAnchor:s $dynamicRef:s $recursiveAnchor:b $recursiveRef:s additionalItems:bo items:oba dependentRequired:o dependentSchemas:o maxContains:n minContains:n unevaluatedItems:bo unevaluatedProperties:bo ";
var BOTE_SCH_KINDS_2020 = "$dynamicAnchor:s $dynamicRef:s $recursiveAnchor:b $recursiveRef:s items:ob prefixItems:a dependentRequired:o dependentSchemas:o maxContains:n minContains:n unevaluatedItems:bo unevaluatedProperties:bo ";

# The names of JavaScript's Object.prototype, which every object a client reads has (3.8.14).
var BOTE_SCH_JS_PROTO = "__proto__ constructor hasOwnProperty isPrototypeOf propertyIsEnumerable toLocaleString toString valueOf __defineGetter__ __defineSetter__ __lookupGetter__ __lookupSetter__ ";

# A map from each keyword the engine for dialect `d` checks the kind of to the kinds it allows.
# _sch_kinds_map, made once for each engine (the cache above).
fn _sch_kinds_map_c(d) {
    var i = 10;
    if (d == 2020) { i = 8; }
    if (d == 2019) { i = 9; }
    var slot = &_sch_wc + i * 8;
    var m = load64(slot);
    if (m != 0) { return m; }
    m = _sch_kinds_map(d);
    if (atomic_cas(slot, 0, m) == 0) { m = load64(slot); }
    return m;
}

fn _sch_kinds_map(d) {
    var m = map_new();
    _sch_kinds_add(m, BOTE_SCH_KINDS_ALL);
    if (d == 2019) { _sch_kinds_add(m, BOTE_SCH_KINDS_2019); }
    elif (d == 2020) { _sch_kinds_add(m, BOTE_SCH_KINDS_2020); }
    else { _sch_kinds_add(m, BOTE_SCH_KINDS_07); }
    return m;
}

fn _sch_kinds_add(m, list) {
    var ws = _reg_words(list);
    var i = 0;
    while (i < vec_len(ws)) {
        var w = vec_get(ws, i);
        var c = strchr(w, 58);
        map_set(m, _slice_cstr(default_alloc(), w, 0, c), w + c + 1);
        i = i + 1;
    }
    return 0;
}

# The JSON kind of the raw value `v` as a letter of the table above, or z for null.
fn _sch_kind_letter(v) {
    var c = _vp_first_nonws(v);
    if (c == 34) { return 115; }
    if (c == 123) { return 111; }
    if (c == 91) { return 97; }
    if (c == 116 || c == 102) { return 98; }
    if (c == 110) { return 122; }
    return 110;
}

# Why a member of the schema `raw` is of a kind the official client's validator refuses
# (`km`, _sch_kinds_map), or 0.
fn _sch_kinds_node_why(raw, km) {
    var mem = _jx_members(raw);
    var i = 0;
    while (i < vec_len(mem)) {
        var k = vec_get(mem, i);
        if (k != 0 && map_has(km, k) == 1) {
            var kinds = map_get(km, k);
            if (strchr(kinds, _sch_kind_letter(vec_get(mem, i + 1))) < 0) {
                var h = default_alloc();
                return _cat_a(h, _cat_a(h, _cat_a(h, "names ", k), " with a value of a kind the official client refuses (it takes "), _cat_a(h, _sch_kinds_words(kinds), ")"));
            }
        }
        i = i + 2;
    }
    return 0;
}

# The kinds `kinds` (letters of the table above) in words: "a number", "a boolean or an object".
fn _sch_kinds_words(kinds) {
    var h = default_alloc();
    var out = "";
    var n = strlen(kinds);
    var i = 0;
    while (i < n) {
        var c = load8(kinds + i);
        var w = "a string";
        if (c == 110) { w = "a number"; }
        elif (c == 98) { w = "a boolean"; }
        elif (c == 111) { w = "an object"; }
        elif (c == 97) { w = "an array"; }
        if (i == 0) { out = w; }
        elif (i == n - 1) { out = _cat_a(h, _cat_a(h, out, " or "), w); }
        else { out = _cat_a(h, _cat_a(h, out, ", "), w); }
        i = i + 1;
    }
    return out;
}

# 1 when `t`, as it decodes, is one of JSON Schema's seven type names.
fn _sch_json_type_ok(t) {
    if (t == 0) { return 0; }
    if (streq(t, "string") == 1 || streq(t, "number") == 1 || streq(t, "integer") == 1 || streq(t, "boolean") == 1) { return 1; }
    if (streq(t, "null") == 1 || streq(t, "object") == 1 || streq(t, "array") == 1) { return 1; }
    return 0;
}

# Why the schema `raw`'s `type` and `nullable` are ones the official client's validator
# refuses, or 0 (3.8.14, from the 3.8.13 review; Ajv's getSchemaTypes): a name that is none of
# the seven, a name that is no string in an array, `nullable` with no type (an empty string
# or an empty array names none), and `type: "null"` beside `nullable: false`. Through 3.8.13
# an unknown name was warned of and judged nothing.
fn _sch_type_node_why(raw) {
    var tr = jsonx_get_raw(raw, "type");
    var nt = 0;
    var hasnull = 0;
    if (tr != 0) {
        var c = _vp_first_nonws(tr);
        if (c == 34) {
            var t = _sch_str_dec_a(default_alloc(), tr);
            if (t == 0) { return "names a type that is no text a client reads as bote does"; }
            if (load8(t) != 0) {
                if (_sch_json_type_ok(t) == 0) { return _dsp_named_msg("names a type the official client refuses, as no JSON type: ", t, 0); }
                nt = 1;
                if (streq(t, "null") == 1) { hasnull = 1; }
            }
        } elif (c == 91) {
            var el = _sch_split_array(tr);
            var i = 0;
            while (i < vec_len(el)) {
                var e = vec_get(el, i);
                var et = 0;
                if (_sch_is_string(e) == 1) { et = _sch_str_dec_a(default_alloc(), e); }
                if (et == 0 || _sch_json_type_ok(et) == 0) { return "names in a type array something the official client refuses, as no JSON type"; }
                if (streq(et, "null") == 1) { hasnull = 1; }
                nt = nt + 1;
                i = i + 1;
            }
        }
    }
    var nr = jsonx_get_raw(raw, "nullable");
    if (nr != 0) {
        if (hasnull == 1 && _vp_first_nonws(nr) == 102) { return "names type null beside nullable: false, which the official client refuses"; }
        if (hasnull == 0 && nt == 0) { return "names nullable with no type, which the official client refuses"; }
    }
    return 0;
}

# Why the schema `raw`'s `id`, `required` or `dependentRequired` is one the official client's
# validator refuses or reads otherwise than bote, or 0 (3.8.14, from the 3.8.13 review): `id`,
# which Ajv refuses in every dialect ("NOT SUPPORTED: keyword id, use $id"); a `required`
# entry that is no string, which the client reads as the property its text names (`5` as
# "5") and bote as none; and a `dependentRequired` value that is no array (the client cannot
# compile it) or holds an entry that is no string.
fn _sch_names_node_why(raw) {
    if (jsonx_has(raw, "id") == 1) { return "names the keyword id, which the official client refuses (write $id)"; }
    var rq = jsonx_get_raw(raw, "required");
    if (rq != 0 && _vp_first_nonws(rq) == 91 && _sch_all_strings(rq) == 0) { return "names in required something that is no string, which the official client reads otherwise"; }
    var dr = jsonx_get_raw(raw, "dependentRequired");
    if (dr != 0 && _vp_first_nonws(dr) == 123) {
        var mem = _jx_members(dr);
        var i = 0;
        while (i < vec_len(mem)) {
            var v = vec_get(mem, i + 1);
            if (_vp_first_nonws(v) != 91) { return "names in dependentRequired a value that is no array, which the official client refuses"; }
            if (_sch_all_strings(v) == 0) { return "names in dependentRequired something that is no string, which the official client reads otherwise"; }
            i = i + 2;
        }
    }
    return 0;
}

# (3.8.15, from the 3.8.14 review) Why the schema `raw`, at `ptr`, is one the official client
# cannot use, or 0: an `enum` of no values ("enum must have non-empty array"); at the root an
# `$async` JavaScript reads as true, for which Ajv compiles a validator that returns a promise,
# which the client reads as valid whatever the value, and whose rejection ends a Node process
# that does not handle it; below the root one beside a keyword Ajv compiles code for, which it
# refuses ("async schema in sync schema").
fn _sch_client_node_why(d, ptr, raw) {
    var ev = jsonx_get_raw(raw, "enum");
    if (ev != 0 && _vp_first_nonws(ev) == 91 && vec_len(_sch_split_array(ev)) == 0) { return "names an enum of no values, which the official client refuses"; }
    var av = jsonx_get_raw(raw, "$async");
    if (av != 0 && _sch_js_falsy(av) == 0) {
        if (load8(ptr) == 0) { return "names $async at its root, for which the official client's validator answers with a promise it reads as valid"; }
        if (_sch_can_fail(d, raw) == 1) { return "names $async below its root, which the official client cannot compile"; }
    }
    return 0;
}

# (3.8.15) A model of how the official client's Ajv counts what a schema evaluated, its
# compile-time `it.props` and `it.items` (util.ts mergeEvaluated), so that registration can refuse
# what it counts otherwise than JSON Schema, and where its code throws. Only its engines for
# 2019-09 and 2020-12 count (their `unevaluated` option). A count is nothing (U), known when Ajv
# compiles (S: names, or every one; for items a number, or T: every one), or a variable of the
# generated code (N, set wherever the schema can pass; M, which can be left unset). Keywords are
# read in Ajv's order: the dynamic references, `$ref`, `not`, `anyOf`, `oneOf`, `allOf`, `if`,
# `then`, `else`; then the array's (`prefixItems`, `items`, `contains`, `unevaluatedItems`; in
# 2019-09 `additionalItems` first) and the object's (`additionalProperties`, `dependencies`,
# `properties`, `patternProperties`, `dependentSchemas`, `unevaluatedProperties`). What Ajv gets
# wrong, each found by uneval-diff and checked against the client's own code:
# - a branch's count merged where it passes, under anyOf, oneOf, then, else and the
#   dependencies, is declared inside that branch: a count known before it is forgotten where it
#   fails (`$ref` beside `oneOf`), and a count that is a variable already is kept where it fails
#   (`patternProperties`, a composition or a reference inside an anyOf branch);
# - an `if` is merged whether it passes or not;
# - `patternProperties` writes into a count that can be unset, and throws;
# - a `$ref` to a schema it is compiled within (a recursive reference) reads that schema's count
#   at run time, and writes into it;
# - `unevaluatedItems` compares a count that is a variable as a number, so "every item" reads
#   as 1 and an unset one refuses nothing; `contains` counts every item or none.
var BOTE_SCH_AEV_DEPTH = 256;
var BOTE_SCH_AEV_BYTES = 104;

# A state: +0 the properties' kind (0 U, 1 S, 2 N, 3 M), +8 every property (S), +16 the names
# (S), +24 why a property is counted that JSON Schema does not count (a reason, below), +32
# names an `if` counts (JSON Schema, only where it passes), +40 why one is forgotten, +48 the
# names forgotten, +56 a variable that is another schema's count (a recursive reference), +64
# the items' kind (0 U, 1 S, 2 N, 3 M, 4 T), +72 why they are counted otherwise, +80 a variable
# that may hold "every item", +88 and +96 a variable for the properties or the items declared
# only where a branch passes (`var` inside the `if` that tests it), which the code for the same
# schema run for an earlier item or member leaves set.
fn _sch_aev_new() {
    var s = alloc(BOTE_SCH_AEV_BYTES);
    var i = 0;
    while (i < BOTE_SCH_AEV_BYTES) { store64(s + i, 0); i = i + 8; }
    return s;
}

# The state of a schema nested deeper than the model follows, or met again while it is read.
fn _sch_aev_top() {
    var s = _sch_aev_new();
    store64(s, 3);
    store64(s + 24, 6);
    store64(s + 64, 3);
    store64(s + 72, 6);
    return s;
}

fn _sch_aev_has(v, s) {
    if (v == 0) { return 0; }
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), s) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The names of `a` and of `b`, a new vec (0 for none): a state's vecs are never written in
# place, as a schema's state is shared by each that names it.
fn _sch_aev_cat(a, b) {
    if ((a == 0 || vec_len(a) == 0) && (b == 0 || vec_len(b) == 0)) { return 0; }
    var out = vec_new();
    var i = 0;
    if (a != 0) {
        while (i < vec_len(a)) {
            if (_sch_aev_has(out, vec_get(a, i)) == 0) { vec_push(out, vec_get(a, i)); }
            i = i + 1;
        }
    }
    var j = 0;
    if (b != 0) {
        while (j < vec_len(b)) {
            if (_sch_aev_has(out, vec_get(b, j)) == 0) { vec_push(out, vec_get(b, j)); }
            j = j + 1;
        }
    }
    return out;
}

# The names of `a` not in `b`.
fn _sch_aev_minus(a, b) {
    if (a == 0 || vec_len(a) == 0) { return 0; }
    if (b == 0 || vec_len(b) == 0) { return a; }
    var out = vec_new();
    var i = 0;
    while (i < vec_len(a)) {
        if (_sch_aev_has(b, vec_get(a, i)) == 0) { vec_push(out, vec_get(a, i)); }
        i = i + 1;
    }
    if (vec_len(out) == 0) { return 0; }
    return out;
}

# Set the reason at `s + off` unless one is set.
fn _sch_aev_why1(s, off, r) {
    if (r != 0 && load64(s + off) == 0) { store64(s + off, r); }
    return 0;
}

# Every property evaluated (Ajv's `it.props = true`, or a variable set to true): whatever it
# counted otherwise no longer matters.
fn _sch_aev_all(s) {
    store64(s, 1);
    store64(s + 8, 1);
    store64(s + 16, 0);
    store64(s + 24, 0);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);
    store64(s + 88, 0);
    return 0;
}

# Every item evaluated (`it.items = true`).
fn _sch_aev_items_all(s) {
    store64(s + 64, 4);
    store64(s + 72, 0);
    store64(s + 80, 0);
    store64(s + 96, 0);
    return 0;
}

# Carry into `st` what `b` counts otherwise than JSON Schema.
fn _sch_aev_carry(st, b) {
    if (load64(st + 8) == 0) {
        _sch_aev_why1(st, 24, load64(b + 24));
        store64(st + 32, _sch_aev_cat(load64(st + 32), load64(b + 32)));
        _sch_aev_why1(st, 40, load64(b + 40));
        store64(st + 48, _sch_aev_cat(load64(st + 48), load64(b + 48)));
    }
    if (load64(st + 64) != 4) { _sch_aev_why1(st, 72, load64(b + 72)); }
    return 0;
}

# Merge `b` into `st` whether the schema it is passes or not (allOf, an `if`, a `$ref`).
fn _sch_aev_uncond(st, b) {
    _sch_aev_carry(st, b);
    var bk = load64(b);
    if (load64(st + 8) == 0 && bk != 0) {
        var sk = load64(st);
        if (sk == 0) {
            store64(st, bk);
            store64(st + 16, load64(b + 16));
            store64(st + 56, load64(b + 56));
            store64(st + 88, load64(b + 88));
            if (load64(b + 8) == 1) {
                _sch_aev_all(st);
                _sch_aev_why1(st, 24, load64(b + 24));
            }
        } else {
            if (bk == 1) {
                if (load64(b + 8) == 1) {
                    # Into a variable (mergeToName: `props = true`), which stays one, holding every
                    # property: a branch it is merged into passes it on, as any variable.
                    var was = sk;
                    _sch_aev_all(st);
                    _sch_aev_why1(st, 24, load64(b + 24));
                    if (was == 2 || was == 3) {
                        store64(st, 2);
                        store64(st + 8, 0);
                    }
                } else {
                    var bn = load64(b + 16);
                    store64(st + 48, _sch_aev_minus(load64(st + 48), bn));
                    if (sk != 1) {
                        if (load64(st + 56) == 1) { _sch_aev_why1(st, 24, 4); }
                        store64(st, 2);
                    }
                    store64(st + 16, _sch_aev_cat(load64(st + 16), bn));
                }
            } else {
                if (sk == 1) {
                    # mergeToName: the names known go into b's variable, which this is now.
                    if (load64(b + 56) == 1) { _sch_aev_why1(st, 24, 4); }
                    store64(st, 2);
                    store64(st + 56, load64(b + 56));
                    store64(st + 88, load64(b + 88));
                    store64(st + 16, _sch_aev_cat(load64(st + 16), load64(b + 16)));
                } else {
                    if (load64(st + 56) == 1) { _sch_aev_why1(st, 24, 4); }
                    if (sk == 3 && bk == 3) { store64(st, 3); } else { store64(st, 2); }
                }
            }
        }
    }
    var bi = load64(b + 64);
    var si = load64(st + 64);
    if (si != 4 && bi != 0) {
        if (si == 0) {
            store64(st + 64, bi);
            store64(st + 80, load64(b + 80));
            store64(st + 96, load64(b + 96));
        } else {
            if (si == 1) {
                if (bi == 4) {
                    _sch_aev_items_all(st);
                    _sch_aev_why1(st, 72, load64(b + 72));
                }
                if (bi == 2 || bi == 3) {
                    store64(st + 64, 2);
                    store64(st + 80, load64(b + 80));
                    store64(st + 96, load64(b + 96));
                }
            } else {
                if (bi == 4 || load64(b + 80) == 1) { store64(st + 80, 1); }
                if (bi == 3 && si == 3) { store64(st + 64, 3); } else { store64(st + 64, 2); }
            }
        }
    }
    return 0;
}

# Merge `b` into `st` where the schema it is passes: under anyOf and oneOf (`leak` 1, where a
# branch's code runs whether an earlier one passed or not), or a `then`, an `else` and a
# dependency (0, whose code runs only where it is taken, and whose failure fails the schema).
fn _sch_aev_cond(st, b, leak) {
    _sch_aev_carry(st, b);
    var bk = load64(b);
    if (load64(st + 8) == 0 && bk != 0) {
        var sk = load64(st);
        if (sk == 0 || sk == 1) {
            if (sk == 1) {
                if (load64(st + 16) == 0) { _sch_aev_why1(st, 40, 3); }
                else { store64(st + 48, _sch_aev_cat(load64(st + 48), load64(st + 16))); }
            }
            if (bk == 1) {
                store64(st, 3);
                store64(st + 88, 1);
            } else {
                if (leak == 1) {
                    _sch_aev_why1(st, 24, 2);
                    store64(st, bk);
                    store64(st + 88, load64(b + 88));
                } else {
                    store64(st, 3);
                    store64(st + 88, 1);
                }
                store64(st + 56, load64(b + 56));
            }
            store64(st + 16, 0);
        } else {
            if (load64(st + 56) == 1) { _sch_aev_why1(st, 24, 4); }
        }
    }
    var bi = load64(b + 64);
    var si = load64(st + 64);
    if (si != 4 && bi != 0) {
        if (si == 0 || si == 1) {
            # A count known before it is forgotten where the branch fails.
            if (si == 1) { _sch_aev_why1(st, 72, 2); }
            if (bi == 1 || bi == 4) {
                if (leak == 1) { store64(st + 64, 2); } else { store64(st + 64, 3); }
                if (bi == 4) { store64(st + 80, 1); } else { store64(st + 80, 0); }
                store64(st + 96, 1);
            } else {
                if (leak == 1) {
                    _sch_aev_why1(st, 72, 2);
                    store64(st + 64, bi);
                    store64(st + 96, load64(b + 96));
                } else {
                    store64(st + 64, 3);
                    store64(st + 96, 1);
                }
                store64(st + 80, load64(b + 80));
            }
        } else {
            if (bi == 4 || load64(b + 80) == 1) { store64(st + 80, 1); }
        }
    }
    return 0;
}

# The state of a `$ref` to `rt`'s schema, which Ajv compiles as a function of its own: a count
# it knows when it compiles (the function compiled, its count no variable) it merges as it is;
# else (`inprog` 1, a schema whose compile the reference is within, or a count that is a
# variable) it reads the count at run time (`validate.evaluated`, ref.ts addEvaluatedFrom) into
# a variable declared only where the call passes, unset where it fails, unset too where the
# schema counted nothing, and for a count known when compiled one object for every call.
fn _sch_aev_called(rt, inprog) {
    var s = _sch_aev_new();
    store64(s + 24, load64(rt + 24));
    store64(s + 32, load64(rt + 32));
    store64(s + 40, load64(rt + 40));
    store64(s + 48, load64(rt + 48));
    store64(s + 72, load64(rt + 72));
    var k = load64(rt);
    if (inprog == 0 && (k == 0 || k == 1)) {
        store64(s, k);
        store64(s + 8, load64(rt + 8));
        store64(s + 16, load64(rt + 16));
    } else {
        store64(s, 3);
        if (inprog == 1 && k == 1 && load64(rt + 8) == 0) { store64(s + 56, 1); }
    }
    var ik = load64(rt + 64);
    if (inprog == 0 && (ik == 0 || ik == 1 || ik == 4)) { store64(s + 64, ik); }
    else {
        if (ik == 1) { store64(s + 64, 2); }
        else {
            if (ik == 4 || load64(rt + 80) == 1) {
                store64(s + 64, 2);
                store64(s + 80, 1);
                if (inprog == 1) { _sch_aev_why1(s, 72, 4); }
            } else {
                if (ik == 0 || ik == 3) {
                    store64(s + 64, 3);
                    if (inprog == 1) { _sch_aev_why1(s, 72, 4); }
                } else { store64(s + 64, 2); }
            }
        }
    }
    return s;
}

# A model's context: +0 the compile context, +8 each schema's state by its pointer (1 while it
# is read), +16 whether Ajv inlines each `$ref` target, +24 each schema's strongly connected
# component (made the first time a reference asks), +32 why the document is refused, +40 the
# depth, +48 the dialect, +56 each schema whose unevaluatedProperties (1) or unevaluatedItems (2)
# reads a variable declared where a branch passes, judged right only where it is not run for
# each item or member of a value (_sch_tuple_quiet_why), +64 each schema's state judged with its
# errors cut short.
fn _sch_aev_ctx(cx) {
    var m = alloc(72);
    store64(m, cx);
    store64(m + 8, map_new());
    store64(m + 16, map_new());
    store64(m + 24, 0);
    store64(m + 32, 0);
    store64(m + 40, 0);
    store64(m + 48, load64(cx));
    store64(m + 56, map_new());
    store64(m + 64, map_new());
    return m;
}

# 1 when the JSON value `raw` holds, as a key anywhere in it, one of the five Ajv will not
# inline a schema with (resolve.ts hasRef: `$ref`, `$recursiveRef`, `$recursiveAnchor`,
# `$dynamicRef`, `$dynamicAnchor`). Past `depth` 128 it answers 1.
fn _sch_ajv_has_ref(raw, depth) {
    if (raw == 0) { return 0; }
    if (depth > 128) { return 1; }
    var c = _vp_first_nonws(raw);
    if (c == 91) {
        var el = _sch_split_array(raw);
        var ei = 0;
        while (ei < vec_len(el)) {
            if (_sch_ajv_has_ref(vec_get(el, ei), depth + 1) == 1) { return 1; }
            ei = ei + 1;
        }
        return 0;
    }
    if (c != 123) { return 0; }
    var mem = _jx_members(raw);
    var mi = 0;
    while (mi < vec_len(mem)) {
        var k = vec_get(mem, mi);
        if (k != 0) {
            if (streq(k, "$ref") == 1 || streq(k, "$recursiveRef") == 1 || streq(k, "$recursiveAnchor") == 1 || streq(k, "$dynamicRef") == 1 || streq(k, "$dynamicAnchor") == 1) { return 1; }
        }
        if (_sch_ajv_has_ref(vec_get(mem, mi + 1), depth + 1) == 1) { return 1; }
        mi = mi + 2;
    }
    return 0;
}

# 1 when Ajv compiles the schema at `t` into the function that names it (inlineRef), 0 when it
# compiles it as a function of its own.
fn _sch_aev_inline(m, t) {
    var memo = load64(m + 16);
    if (map_has(memo, t) == 1) { return map_get(memo, t) - 1; }
    var r = 1;
    if (_sch_ajv_has_ref(_sch_ptr_raw(load64(m), t), 0) == 1) { r = 0; }
    map_set(memo, t, r + 1);
    return r;
}

# Each schema's strongly connected component, by its pointer, plus one, over every schema the
# engine compiles (_sch_kids): Tarjan's, with a stack of its own.
fn _sch_aev_scc(m) {
    var cx = load64(m);
    var idx = map_new();
    var low = map_new();
    var on = map_new();
    var comp = map_new();
    var stk = vec_new();
    var calls = vec_new();
    var n = 1;
    var c = 1;
    var f0 = alloc(24);
    store64(f0, "");
    store64(f0 + 8, _sch_kids(cx, "", _sch_ptr_raw(cx, ""), 0));
    store64(f0 + 16, 0);
    map_set(idx, "", n);
    map_set(low, "", n);
    n = n + 1;
    vec_push(stk, "");
    map_set(on, "", 1);
    vec_push(calls, f0);
    while (vec_len(calls) > 0) {
        var f = vec_get(calls, vec_len(calls) - 1);
        var node = load64(f);
        var kids = load64(f + 8);
        var i = load64(f + 16);
        if (i < vec_len(kids)) {
            store64(f + 16, i + 1);
            var w = vec_get(kids, i);
            if (map_has(idx, w) == 0) {
                map_set(idx, w, n);
                map_set(low, w, n);
                n = n + 1;
                vec_push(stk, w);
                map_set(on, w, 1);
                var wr = _sch_ptr_raw(cx, w);
                var nf = alloc(24);
                store64(nf, w);
                if (wr != 0 && _vp_first_nonws(wr) == 123) { store64(nf + 8, _sch_kids(cx, w, wr, 0)); } else { store64(nf + 8, vec_new()); }
                store64(nf + 16, 0);
                vec_push(calls, nf);
            } else {
                if (map_has(on, w) == 1 && map_get(on, w) == 1) {
                    if (map_get(idx, w) < map_get(low, node)) { map_set(low, node, map_get(idx, w)); }
                }
            }
        } else {
            vec_pop(calls);
            if (map_get(low, node) == map_get(idx, node)) {
                var more = 1;
                while (more == 1 && vec_len(stk) > 0) {
                    var x = vec_pop(stk);
                    map_set(on, x, 2);
                    map_set(comp, x, c);
                    if (streq(x, node) == 1) { more = 0; }
                }
                c = c + 1;
            }
            if (vec_len(calls) > 0) {
                var pf = vec_get(calls, vec_len(calls) - 1);
                var pn = load64(pf);
                if (map_get(low, node) < map_get(low, pn)) { map_set(low, pn, map_get(low, node)); }
            }
        }
    }
    return comp;
}

# 1 when the schema at `t` can be in the middle of its compile where the schema at `x` names
# it: only where `t` leads back to `x`, so that the two share a component.
fn _sch_aev_reaches(m, t, x) {
    if (streq(t, x) == 1) { return 1; }
    if (load64(m + 24) == 0) { store64(m + 24, _sch_aev_scc(m)); }
    var comp = load64(m + 24);
    if (map_has(comp, t) == 0 || map_has(comp, x) == 0) { return 1; }
    if (map_get(comp, t) == map_get(comp, x)) { return 1; }
    return 0;
}

# The names of the JSON object `obj`'s members as Ajv reads a schema map (allSchemaProperties:
# every key but `__proto__`), each a NUL-free decoded key, and into `count_out` how many keys
# Ajv reads, a key holding a NUL among them.
fn _sch_aev_keys(obj, count_out) {
    var out = vec_new();
    var cnt = 0;
    var mem = _jx_members(obj);
    var i = 0;
    while (i < vec_len(mem)) {
        var k = vec_get(mem, i);
        if (k == 0) { cnt = cnt + 1; }
        else {
            if (streq(k, "__proto__") == 0) {
                cnt = cnt + 1;
                if (_sch_aev_has(out, k) == 0) { vec_push(out, k); }
            }
        }
        i = i + 2;
    }
    if (count_out != 0) { store64(count_out, cnt); }
    return out;
}

# Into the map `set`, the names JSON Schema evaluates of the schema at `ptr` wherever it passes
# (its `properties`, and those of what `allOf` and `$ref` judge in place); 1 for every one (an
# `additionalProperties`, or below it an `unevaluatedProperties`; `self` 1 leaves out the
# schema's own).
fn _sch_aev_j(m, ptr, set, depth, self) {
    if (depth > BOTE_SCH_AEV_DEPTH) { return 0; }
    var cx = load64(m);
    var raw = _sch_ptr_raw(cx, ptr);
    if (raw == 0 || _vp_first_nonws(raw) != 123) { return 0; }
    if (jsonx_has(raw, "additionalProperties") == 1) { return 1; }
    if (self == 0 && jsonx_has(raw, "unevaluatedProperties") == 1) { return 1; }
    var pr = jsonx_get_raw(raw, "properties");
    if (pr != 0 && _vp_first_nonws(pr) == 123) {
        var pn = _sch_aev_keys(pr, 0);
        var i = 0;
        while (i < vec_len(pn)) {
            map_set(set, vec_get(pn, i), 1);
            i = i + 1;
        }
    }
    var ak = vec_new();
    _sch_kids_kw(ak, ptr, raw, "allOf", 1);
    var rs = _sch_kw_str(raw, "$ref");
    if (rs != 0) {
        var t = _sch_ref_ptr(cx, rs);
        if (t != 0) { vec_push(ak, t); }
    }
    var k = 0;
    while (k < vec_len(ak)) {
        if (_sch_aev_j(m, vec_get(ak, k), set, depth + 1, 0) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

# What the reason `r` refuses, for properties.
fn _sch_aev_msg_p(r) {
    if (r == 1) { return "holds unevaluatedProperties with properties an if evaluates, which the official client counts where the if fails too (JSON Schema, only where it passes)"; }
    if (r == 2) { return "holds unevaluatedProperties with properties evaluated under anyOf or oneOf by patternProperties, a composition or a reference, which the official client counts from a branch the value fails too"; }
    if (r == 3) { return "holds unevaluatedProperties with properties evaluated before an anyOf, oneOf, then, else, dependencies or dependentSchemas, which the official client forgets where that branch fails or is not taken"; }
    if (r == 4) { return "holds unevaluatedProperties beside a $ref to a schema it is compiled within (a recursive reference), which the official client counts otherwise than JSON Schema"; }
    if (r == 5) { return "holds unevaluatedProperties beside a $dynamicRef or $recursiveRef, which the official client counts otherwise than JSON Schema"; }
    if (r == 7) { return "holds unevaluatedProperties with properties evaluated under dependencies, which the official client counts and bote does not judge"; }
    return "holds unevaluatedProperties beside schemas nested in place more than 256 deep, which bote does not follow";
}

# What the reason `r` refuses, for items.
fn _sch_aev_msg_i(r) {
    if (r == 1) { return "holds unevaluatedItems beside a contains, which the official client counts as evaluating every item or none (JSON Schema, the items it matches)"; }
    if (r == 2) { return "holds unevaluatedItems with items evaluated under anyOf, oneOf, if, then, else, dependencies or dependentSchemas, which the official client counts otherwise than JSON Schema"; }
    if (r == 3) { return "holds unevaluatedItems beside a $dynamicRef or $recursiveRef, which the official client counts otherwise than JSON Schema"; }
    if (r == 4) { return "holds unevaluatedItems beside a $ref to a schema it is compiled within (a recursive reference), which the official client counts otherwise than JSON Schema"; }
    if (r == 7) { return "holds unevaluatedItems with items evaluated under dependencies, which the official client counts and bote does not judge"; }
    return "holds unevaluatedItems beside schemas nested in place more than 256 deep, which bote does not follow";
}

# Why the `unevaluatedProperties` of the schema at `ptr`, read with the state `st`, is judged
# otherwise by the client, or 0.
fn _sch_aev_props_why(m, ptr, st) {
    var r = load64(st + 24);
    if (r != 0) { return _sch_aev_msg_p(r); }
    if (load64(st + 8) == 1) { return 0; }
    var ex = load64(st + 32);
    if (ex != 0 && vec_len(ex) > 0) {
        var j = map_new();
        if (_sch_aev_j(m, ptr, j, 0, 1) == 0) {
            var i = 0;
            while (i < vec_len(ex)) {
                if (map_has(j, vec_get(ex, i)) == 0) { return _sch_aev_msg_p(1); }
                i = i + 1;
            }
        }
    }
    if (load64(st + 40) != 0) { return _sch_aev_msg_p(load64(st + 40)); }
    var lo = load64(st + 48);
    if (lo != 0 && vec_len(lo) > 0) { return _sch_aev_msg_p(3); }
    return 0;
}

# Why an `unevaluatedItems` read with the state `st` is judged otherwise by the client, or 0.
fn _sch_aev_items_why(st) {
    var si = load64(st + 64);
    var r = load64(st + 72);
    if (r == 0 && si == 4) { return 0; }
    if (r == 0 && si == 3) { r = 2; }
    if (r == 0 && si == 2 && load64(st + 80) == 1) { r = 2; }
    if (r == 0) { return 0; }
    return _sch_aev_msg_i(r);
}

# Mark the schema at `ptr` as one whose unevaluatedProperties (`how` 1) or unevaluatedItems (2)
# reads a variable declared where a branch passes.
fn _sch_aev_mark(m, ptr, how) {
    var mk = load64(m + 56);
    var was = 0;
    if (map_has(mk, ptr) == 1) { was = map_get(mk, ptr); }
    map_set(mk, ptr, was | how);
    return 0;
}

# Merge into `st` each schema of the `kw` (anyOf or oneOf) of the schema `raw` at `ptr`. A branch
# that counts no items and can pass leaves the count of items unset where it is the one that
# passes, which unevaluatedItems reads as nothing to refuse (JSON Schema: none evaluated).
fn _sch_aev_union(m, st, ptr, raw, kw, q) {
    var arr = jsonx_get_raw(raw, kw);
    if (arr == 0 || _vp_first_nonws(arr) != 91) { return 0; }
    var si = load64(st + 64);
    var kids = vec_new();
    _sch_kids_kw(kids, ptr, raw, kw, 1);
    var bare = 0;
    var el = _sch_split_array(arr);
    var ei = 0;
    while (ei < vec_len(el)) {
        if (_vp_first_nonws(vec_get(el, ei)) == 116) { bare = 1; }
        ei = ei + 1;
    }
    var i = 0;
    while (i < vec_len(kids)) {
        var rb = _sch_aev(m, vec_get(kids, i), q);
        if (load64(m + 32) != 0) { return 0; }
        if (load64(rb + 64) == 0) { bare = 1; }
        _sch_aev_cond(st, rb, 1);
        i = i + 1;
    }
    if ((si == 0 || si == 1) && load64(st + 64) == 2 && bare == 1) { store64(st + 64, 3); }
    return 0;
}

# Merge into `st` each schema of `kids`, where it passes (`leak` as _sch_aev_cond), each judged
# as `q` says.
fn _sch_aev_conds(m, st, kids, leak, q) {
    var i = 0;
    while (i < vec_len(kids)) {
        var rb = _sch_aev(m, vec_get(kids, i), q);
        if (load64(m + 32) != 0) { return 0; }
        _sch_aev_cond(st, rb, leak);
        i = i + 1;
    }
    return 0;
}

# The state of the schema at `ptr` once Ajv has compiled it (memoized), judged with every error
# (`q` 0) or with its errors cut short (1, under `not` or `if`), refusing into `m + 32`.
fn _sch_aev(m, ptr, q) {
    var memo = load64(m + 8);
    if (q == 1) { memo = load64(m + 64); }
    if (map_has(memo, ptr) == 1) {
        var got = map_get(memo, ptr);
        if (got == 1) { return _sch_aev_top(); }
        return got;
    }
    if (load64(m + 40) >= BOTE_SCH_AEV_DEPTH) { return _sch_aev_top(); }
    map_set(memo, ptr, 1);
    store64(m + 40, load64(m + 40) + 1);
    var st = _sch_aev_node(m, ptr, q);
    store64(m + 40, load64(m + 40) - 1);
    map_set(memo, ptr, st);
    return st;
}

fn _sch_aev_node(m, ptr, q) {
    var cx = load64(m);
    var d = load64(m + 48);
    var st = _sch_aev_new();
    var raw = _sch_ptr_raw(cx, ptr);
    if (raw == 0 || _vp_first_nonws(raw) != 123) { return st; }
    if (jsonx_has(raw, "$dynamicRef") == 1 || jsonx_has(raw, "$recursiveRef") == 1) {
        var dn = _sch_aev_new();
        store64(dn, 3);
        store64(dn + 24, 5);
        store64(dn + 64, 3);
        store64(dn + 72, 3);
        _sch_aev_uncond(st, dn);
    }
    var rs = _sch_kw_str(raw, "$ref");
    if (rs != 0) {
        var t = _sch_ref_ptr(cx, rs);
        if (t != 0) {
            if (_sch_aev_inline(m, t) == 1) {
                var ri0 = _sch_aev(m, t, q);
                if (load64(m + 32) != 0) { return st; }
                _sch_aev_uncond(st, ri0);
            } else {
                # A function of its own, compiled with every error.
                var rt = _sch_aev(m, t, 0);
                if (load64(m + 32) != 0) { return st; }
                _sch_aev_uncond(st, _sch_aev_called(rt, _sch_aev_reaches(m, t, ptr)));
            }
        }
    }
    var nk = vec_new();
    _sch_kids_kw(nk, ptr, raw, "not", 0);
    if (vec_len(nk) > 0) {
        _sch_aev(m, vec_get(nk, 0), 1);
        if (load64(m + 32) != 0) { return st; }
    }
    _sch_aev_union(m, st, ptr, raw, "anyOf", q);
    if (load64(m + 32) != 0) { return st; }
    _sch_aev_union(m, st, ptr, raw, "oneOf", q);
    if (load64(m + 32) != 0) { return st; }
    var ak = vec_new();
    _sch_kids_kw(ak, ptr, raw, "allOf", 1);
    var ai = 0;
    while (ai < vec_len(ak)) {
        var ra = _sch_aev(m, vec_get(ak, ai), q);
        if (load64(m + 32) != 0) { return st; }
        _sch_aev_uncond(st, ra);
        ai = ai + 1;
    }
