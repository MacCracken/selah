# The five doctests of core.rs.
fn _t_doctests(): i64 {
    test_group("doctests core");
    var a: *SlAnnotation = SlAnnotation_new(SL_KIND_RECTANGLE, _t_rect(10.0, 20.0, 100.0, 50.0), SL_COLOR_RED);
    assert(a.text == 0, "Annotation::new: no text");
    SlAnnotation_free(a);
    assert(_t_cstr_is(selah_image_format_extension(SL_FMT_PNG), "png"), "ImageFormat: extension");
    assert(_t_parse_format("jpg") == SL_FMT_JPEG, "ImageFormat: parse");
    assert(_t_from_path("shot.JPEG") == SL_FMT_JPEG, "from_path: JPEG");
    assert(_t_from_path("notes.txt") == -1, "from_path: txt");
    var x = _t_xml("<script>alert('xss')</script>");
    assert(_t_str_is(x, "&lt;script&gt;alert(&#x27;xss&#x27;)&lt;/script&gt;"), "xml_escape");
    assert(_t_str_is(_t_dop("photo.png", "annotated"), "photo_annotated.png"), "derive_output_path");
    return 0;
}

# Cyrius-only: a v4 id carries version 4 and the RFC 4122 variant, and two differ.
fn _t_uuid_v4(): i64 {
    test_group("uuid v4");
    var a: u8[16];
    var b: u8[16];
    assert(_sl_uuid_v4(&a) == 1, "entropy");
    assert(_sl_uuid_v4(&b) == 1, "entropy");
    assert((load8(&a + 6) >> 4) == 4, "version 4");
    assert((load8(&a + 8) & 0xC0) == 0x80, "variant");
    assert(memeq(&a, &b, 16) == 0, "differ");
    var sb = str_builder_new();
    _sl_uuid_fmt(sb, &a, 1);
    var s = str_builder_build(sb);
    var back: u8[16];
    assert(_sl_uuid_parse(str_data(s), str_len(s), &back) == 1 && memeq(&a, &back, 16) == 1, "round trip");
    return 0;
}

# Cyrius-only: the current time round-trips through the RFC 3339 writer and reader.
fn _t_rfc3339_now(): i64 {
    test_group("rfc3339 now");
    var ns = clock_epoch_ns();
    var secs = ns / 1000000000;
    var nanos = ns % 1000000000;
    var sb = str_builder_new();
    _sl_rfc3339_fmt(sb, secs, nanos);
    var s = str_builder_build(sb);
    var s2 = 0;
    var n2 = 0;
    assert(_sl_rfc3339_parse(str_data(s), str_len(s), &s2, &n2) == 1, "parses");
    assert(s2 == secs && n2 == nanos, "same instant");
    return 0;
}

# Runs the suite; the exit code is the failure count, clamped.
fn main(): i64 {
    alloc_init();
    _t_color_default_is_red();
    _t_color_display();
    _t_color_to_css();
    _t_image_format_extension();
    _t_image_format_mime();
    _t_image_format_default_is_png();
    _t_image_format_display();
    _t_core_rect_contains_point();
    _t_core_rect_area();
    _t_core_rect_center();
    _t_core_rect_intersects();
    _t_core_rect_default_is_zero();
    _t_capture_source_display();
    _t_annotation_kind_display();
    _t_redaction_target_display();
    _t_annotation_new();
    _t_annotation_with_text();
    _t_image_format_from_str();
    _t_xml_escape();
    _t_derive_output_path();
    _t_image_format_from_str_invalid();
    _t_xml_escape_all_special_chars();
    _t_xml_escape_strips_xml_illegal_chars();
    _t_xml_escape_multibyte_preserved();
    _t_image_format_from_path();
    _t_annotation_kind_from_str_roundtrip();
    _t_redaction_target_key();
    _t_xml_escape_empty();
    _t_xml_escape_no_special();
    _t_derive_output_path_dotfile();
    _t_derive_output_path_multiple_dots();
    _t_capture_source_display_all_variants();
    _t_annotation_with_text_has_correct_fields();
    _t_annotation_new_generates_unique_ids();
    _t_color_new_and_constants();
    _t_color_to_css_semi_transparent();
    _t_redaction_target_display_all_variants();
    _t_annotation_kind_display_all();
    _t_image_format_bmp_and_webp_mime();
    _t_doctests();
    _t_uuid_v4();
    _t_rfc3339_now();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
