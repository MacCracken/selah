fn _t_annotation_new(): i64 {
    test_group("test_annotation_new");
    var a: *SlAnnotation = SlAnnotation_new(SL_KIND_ARROW, _t_rect(0.0, 0.0, 50.0, 50.0), SL_COLOR_RED);
    assert(a != 0, "allocated");
    assert(a.kind == SL_KIND_ARROW, "kind");
    assert(a.text == 0, "no text");
    SlAnnotation_free(a);
    return 0;
}

fn _t_annotation_with_text(): i64 {
    test_group("test_annotation_with_text");
    var pos = _t_rect(0.0, 0.0, 200.0, 30.0);
    var a: *SlAnnotation = SlAnnotation_with_text(SL_KIND_TEXT, pos, SL_COLOR_BLACK, str_from("Hello"));
    assert(a.kind == SL_KIND_TEXT, "kind");
    assert(_t_str_is(a.text, "Hello"), "text");
    SlAnnotation_free(a);
    return 0;
}

fn _t_image_format_from_str(): i64 {
    test_group("test_image_format_from_str");
    assert(_t_parse_format("png") == SL_FMT_PNG, "png");
    assert(_t_parse_format("jpg") == SL_FMT_JPEG, "jpg");
    assert(_t_parse_format("jpeg") == SL_FMT_JPEG, "jpeg");
    assert(_t_parse_format("bmp") == SL_FMT_BMP, "bmp");
    assert(_t_parse_format("webp") == SL_FMT_WEBP, "webp");
    assert(_t_parse_format("PNG") == SL_FMT_PNG, "PNG");
    assert(_t_parse_format("tiff") == -1, "tiff refused");
    return 0;
}

fn _t_xml_escape(): i64 {
    test_group("test_xml_escape");
    assert(_t_str_is(_t_xml("hello"), "hello"), "plain");
    assert(_t_str_is(_t_xml("<script>"), "&lt;script&gt;"), "tags");
    assert(_t_str_is(_t_xml("a&b"), "a&amp;b"), "amp");
    assert(_t_str_is(_t_xml("x\"y'z"), "x&quot;y&#x27;z"), "quotes");
    return 0;
}

fn _t_derive_output_path(): i64 {
    test_group("test_derive_output_path");
    assert(_t_str_is(_t_dop("photo.png", "annotated"), "photo_annotated.png"), "annotated");
    assert(_t_str_is(_t_dop("photo.png", "redacted"), "photo_redacted.png"), "redacted");
    assert(_t_str_is(_t_dop("noext", "out"), "noext_out"), "noext");
    assert(_t_str_is(_t_dop("/tmp/img.jpg", "annotated"), "img_annotated.jpg"), "absolute");
    return 0;
}

fn _t_image_format_from_str_invalid(): i64 {
    test_group("test_image_format_from_str_invalid");
    var d = 0;
    var t, v = selah_image_format_parse("tiff", 4, &d);
    var msg = selah_error_display(v, d);
    assert(_t_str_has(msg, "tiff"), "names it");
    assert(_t_str_has(msg, "png"), "lists png");
    return 0;
}

fn _t_xml_escape_all_special_chars(): i64 {
    test_group("test_xml_escape_all_special_chars");
    var out = _t_xml("<a href=\"x\">&'test'</a>");
    assert(_t_str_is(out, "&lt;a href=&quot;x&quot;&gt;&amp;&#x27;test&#x27;&lt;/a&gt;"), "all five");
    return 0;
}

fn _t_xml_escape_strips_xml_illegal_chars(): i64 {
    test_group("test_xml_escape_strips_xml_illegal_chars");
    assert(_t_str_is(selah_xml_escape("a\x00b\x1bc", 5), "abc"), "controls dropped");
    assert(_t_str_is(_t_xml("tab\tnl\ncr\r"), "tab\tnl\ncr\r"), "tab, LF, CR kept");
    assert(_t_str_is(_t_xml("x\xef\xbf\xbey\xef\xbf\xbfz"), "xyz"), "U+FFFE, U+FFFF dropped");
    assert(_t_str_is(_t_xml("\xef\xbf\xbd\xef\xbc\x81"), "\xef\xbf\xbd\xef\xbc\x81"), "U+FFFD, U+FF01 kept");
    return 0;
}

fn _t_xml_escape_multibyte_preserved(): i64 {
    test_group("test_xml_escape_multibyte_preserved");
    var out = _t_xml("h\xc3\xa9llo <w\xc3\xb6rld> \xe6\x97\xa5\xe6\x9c\xac");
    assert(_t_str_is(out, "h\xc3\xa9llo &lt;w\xc3\xb6rld&gt; \xe6\x97\xa5\xe6\x9c\xac"), "multibyte");
    return 0;
}

fn _t_image_format_from_path(): i64 {
    test_group("test_image_format_from_path");
    assert(_t_from_path("a/b.JPG") == SL_FMT_JPEG, "JPG");
    assert(_t_from_path("x.webp") == SL_FMT_WEBP, "webp");
    assert(_t_from_path("noext") == -1, "noext");
    assert(_t_from_path("x.tiff") == -1, "tiff");
    return 0;
}

fn _t_annotation_kind_from_str_roundtrip(): i64 {
    test_group("test_annotation_kind_from_str_roundtrip");
    var k = SL_KIND_ARROW;
    while (k <= SL_KIND_FREEFORM) {
        var name = selah_annotation_kind_name(k);
        assert(_t_parse_kind(name) == k, name);
        k = k + 1;
    }
    assert(_t_parse_kind("Rectangle") == SL_KIND_RECTANGLE, "Rectangle");
    assert(_t_parse_kind("FreeForm") == SL_KIND_FREEFORM, "FreeForm");
    assert(_t_parse_kind("blob") == -1, "blob refused");
    return 0;
}

