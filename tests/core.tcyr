fn _t_capture_source_display_all_variants(): i64 {
    test_group("test_capture_source_display_all_variants");
    var z = SlRect_default();
    assert(_t_str_is(_t_source_text(SL_SOURCE_FULL_SCREEN, z, 0), "full screen"), "full screen");
    assert(_t_str_is(_t_source_text(SL_SOURCE_WINDOW, z, str_from("firefox")), "window firefox"), "window");
    var s = _t_source_text(SL_SOURCE_REGION, _t_rect(0.0, 0.0, 1920.0, 1080.0), 0);
    assert(_t_str_has(s, "1920") && _t_str_has(s, "1080"), "region");
    return 0;
}

fn _t_annotation_with_text_has_correct_fields(): i64 {
    test_group("test_annotation_with_text_has_correct_fields");
    var pos = _t_rect(10.0, 20.0, 200.0, 30.0);
    var text = str_from("Hello <World>");
    var a: *SlAnnotation = SlAnnotation_with_text(SL_KIND_TEXT, pos, SL_COLOR_BLUE, text);
    assert(a.kind == SL_KIND_TEXT, "kind");
    assert(_t_color_eq(a.color, SL_COLOR_BLUE), "colour");
    assert(_t_str_is(a.text, "Hello <World>"), "text");
    assert(a.position.x() == 10.0, "x");
    SlAnnotation_free(a);
    return 0;
}

fn _t_annotation_new_generates_unique_ids(): i64 {
    test_group("test_annotation_new_generates_unique_ids");
    var a: *SlAnnotation = SlAnnotation_new(SL_KIND_ARROW, SlRect_default(), SL_COLOR_RED);
    var b: *SlAnnotation = SlAnnotation_new(SL_KIND_ARROW, SlRect_default(), SL_COLOR_RED);
    assert(memeq(_sl_addr(a), _sl_addr(b), 16) == 0, "ids differ");
    SlAnnotation_free(a);
    SlAnnotation_free(b);
    return 0;
}

fn _t_color_new_and_constants(): i64 {
    test_group("test_color_new_and_constants");
    var c = SlColor_new(1, 2, 3, 4);
    assert(c.r == 1 && c.g == 2 && c.b == 3 && c.a == 4, "channels");
    assert(_t_color_eq(SL_COLOR_WHITE, SlColor_new(255, 255, 255, 255)), "white");
    assert(_t_color_eq(SL_COLOR_BLACK, SlColor_new(0, 0, 0, 255)), "black");
    return 0;
}

fn _t_color_to_css_semi_transparent(): i64 {
    test_group("test_color_to_css_semi_transparent");
    var css = SlColor_new(0, 128, 255, 128).to_css();
    assert(_t_str_has(css, "rgba(0,128,255,") && memeq(str_data(css), "rgba(0,128,255,", 15) == 1, "prefix");
    assert(_t_str_has(css, "0.50"), "alpha");
    return 0;
}

