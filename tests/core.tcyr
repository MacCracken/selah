fn _t_image_format_bmp_and_webp_mime(): i64 {
    test_group("test_image_format_bmp_and_webp_mime");
    assert(_t_cstr_is(selah_image_format_mime_type(SL_FMT_BMP), "image/bmp"), "bmp");
    assert(_t_cstr_is(selah_image_format_mime_type(SL_FMT_WEBP), "image/webp"), "webp");
