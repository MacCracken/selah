fn _t_image_format_default_is_png(): i64 {
    test_group("test_image_format_default_is_png");
    assert(selah_image_format_default() == SL_FMT_PNG, "png");
    return 0;
}

fn _t_image_format_display(): i64 {
    test_group("test_image_format_display");
    var sb = str_builder_new();
    selah_image_format_fmt(sb, SL_FMT_PNG);
    assert(_t_str_is(str_builder_build(sb), "png"), "png");
    var sb2 = str_builder_new();
    selah_image_format_fmt(sb2, SL_FMT_WEBP);
    assert(_t_str_is(str_builder_build(sb2), "webp"), "webp");
    return 0;
}

# core.rs repeats five of geometry.rs's rect tests; they run here too, as the ledger counts them.
fn _t_core_rect_contains_point(): i64 {
    test_group("core::test_rect_contains_point");
    var r = _t_rect(10.0, 10.0, 100.0, 50.0);
    assert(r.contains_point(_t_vec2(50.0, 30.0)), "inside");
    assert(r.contains_point(_t_vec2(10.0, 10.0)), "on edge");
    assert(r.contains_point(_t_vec2(110.0, 60.0)), "on far edge");
    assert(r.contains_point(_t_vec2(5.0, 30.0)) == false, "outside left");
    assert(r.contains_point(_t_vec2(50.0, 65.0)) == false, "outside bottom");
    return 0;
}

fn _t_core_rect_area(): i64 {
    test_group("core::test_rect_area");
    assert(_t_rect(0.0, 0.0, 100.0, 50.0).area() == 5000.0, "area");
    return 0;
}

fn _t_core_rect_center(): i64 {
    test_group("core::test_rect_center");
    var c = _t_rect(0.0, 0.0, 100.0, 50.0).center();
    var cx: f64 = f32_to(c.x);
    var cy: f64 = f32_to(c.y);
    assert(cx == 50.0 && cy == 25.0, "center");
    return 0;
}

fn _t_core_rect_intersects(): i64 {
    test_group("core::test_rect_intersects");
    var a = _t_rect(0.0, 0.0, 100.0, 100.0);
    var b = _t_rect(50.0, 50.0, 100.0, 100.0);
    var c = _t_rect(200.0, 200.0, 50.0, 50.0);
    assert(a.intersects(&b), "overlap");
    assert(a.intersects(&c) == false, "apart");
    return 0;
}

fn _t_core_rect_default_is_zero(): i64 {
    test_group("core::test_rect_default_is_zero");
    var r = SlRect_default();
    assert(r.x() == 0.0 && r.area() == 0.0, "zero");
    return 0;
}

fn _t_capture_source_display(): i64 {
    test_group("test_capture_source_display");
    var z = SlRect_default();
    assert(_t_str_is(_t_source_text(SL_SOURCE_FULL_SCREEN, z, 0), "full screen"), "full screen");
    var r = _t_rect(10.0, 20.0, 800.0, 600.0);
    assert(_t_str_is(_t_source_text(SL_SOURCE_REGION, r, 0), "region (800x600 at 10,20)"), "region");
    assert(_t_str_is(_t_source_text(SL_SOURCE_WINDOW, z, str_from("abc")), "window abc"), "window");
    return 0;
}

