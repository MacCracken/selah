    assert(_t_cstr_is(selah_image_format_extension(SL_FMT_JPEG), "jpg"), "jpg");
    assert(_t_cstr_is(selah_image_format_extension(SL_FMT_BMP), "bmp"), "bmp");
    assert(_t_cstr_is(selah_image_format_extension(SL_FMT_WEBP), "webp"), "webp");
    return 0;
}

fn _t_image_format_mime(): i64 {
    test_group("test_image_format_mime");
    assert(_t_cstr_is(selah_image_format_mime_type(SL_FMT_PNG), "image/png"), "png");
    assert(_t_cstr_is(selah_image_format_mime_type(SL_FMT_JPEG), "image/jpeg"), "jpeg");
