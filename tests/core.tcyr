# core.tcyr — rust-old/src/core.rs's tests and doctests, ported (port plan M1), and Cyrius-only tests for uuid.cyr
# and rfc3339.cyr. Golden parity: tests/golden/core.tsv, uuid.tsv, rfc3339.tsv.

include "tests/selah_src.cyr"
include "tests/support.cyr"

# 1 when two colours are equal.
fn _t_color_eq(a: SlColor, b: SlColor): i64 {
    return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a;
}

# A colour's Display.
fn _t_color_text(c: SlColor): i64 {
    var sb = str_builder_new();
    c.fmt(sb);
    return str_builder_build(sb);
}

# A kind's Display.
fn _t_kind_text(k): i64 {
    var sb = str_builder_new();
    selah_annotation_kind_fmt(sb, k);
    return str_builder_build(sb);
}

# A target's Display.
fn _t_target_text(kind, custom): i64 {
    var t = SlRedactionTarget_new(kind, custom);
    var sb = str_builder_new();
    t.fmt(sb);
    return str_builder_build(sb);
}

# A capture source's Display.
fn _t_source_text(kind, region: SlRect, window): i64 {
    var s: SlCaptureSource;
    s.kind = kind;
    s.region = region;
    s.window = window;
    var sb = str_builder_new();
    s.fmt(sb);
    return str_builder_build(sb);
}

# The format parsed from a cstring, or -1.
fn _t_parse_format(s): i64 {
    var t, f = selah_image_format_parse(s, strlen(s));
    if (is_err_result(t) == 1) { return -1; }
    return f;
}

# The kind parsed from a cstring, or -1.
fn _t_parse_kind(s): i64 {
    var t, k = selah_annotation_kind_parse(s, strlen(s));
    if (is_err_result(t) == 1) { return -1; }
    return k;
}

# The format from a path, or -1 for None.
fn _t_from_path(s): i64 {
    var t, f = selah_image_format_from_path(s, strlen(s));
    if (is_none(t) == 1) { return -1; }
    return f;
}

# xml_escape of a cstring.
fn _t_xml(s): i64 {
    return selah_xml_escape(s, strlen(s));
}

# derive_output_path of two cstrings.
fn _t_dop(i, s): i64 {
    return selah_derive_output_path(i, strlen(i), s, strlen(s));
}

fn _t_color_default_is_red(): i64 {
    test_group("test_color_default_is_red");
    assert(_t_color_eq(SlColor_default(), SL_COLOR_RED), "red");
    return 0;
}

