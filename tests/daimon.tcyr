# daimon.tcyr — rust-old/src/daimon.rs's tests, ported (port plan M5). Registration and OCR are retargeted to the
# live services' routes (D2, ADR 0002 #4–#7), so their tests assert the new requests; heartbeat is dropped, and its two
# tests become a check that sandhi sends a percent-encoded path as it is. Cyrius-only: the OCR downscale under hoosh's
# 1 MiB cap (L8), the area average, a fenced answer, and OCR without a model.

include "tests/selah_src.cyr"
include "tests/support.cyr"
include "tests/mock_http.cyr"

fn _t_daimon_config_default(): i64 {
    test_group("test_daimon_config_default");
    var c: *SlDaimonConfig = SlDaimonConfig_default();
    assert(_t_cstr_is(c.endpoint, "http://localhost:8090") == 1 && c.api_key == 0, "localhost:8090, no key");
    return 0;
}

fn _t_hoosh_config_default(): i64 {
    test_group("test_hoosh_config_default");
    var c: *SlHooshConfig = SlHooshConfig_default();
    assert(_t_cstr_is(c.endpoint, "http://localhost:8088") == 1 && c.model == 0, "localhost:8088, no model");
    return 0;
}

fn _t_daimon_client_endpoint(): i64 {
    test_group("test_daimon_client_endpoint");
    assert(_t_cstr_is(SlDaimonClient_endpoint(SlDaimonClient_new()), "http://localhost:8090") == 1, "default");
    return 0;
}

fn _t_daimon_client_custom_config(): i64 {
    test_group("test_daimon_client_custom_config");
    var c = SlDaimonClient_with_config(SlDaimonConfig_new("http://custom:9090", "key123"));
    assert(_t_cstr_is(SlDaimonClient_endpoint(c), "http://custom:9090") == 1, "custom");
    return 0;
}

fn _t_hoosh_client_endpoint(): i64 {
    test_group("test_hoosh_client_endpoint");
    assert(_t_cstr_is(SlHooshClient_endpoint(SlHooshClient_new()), "http://localhost:8088") == 1, "default");
    return 0;
}

fn _t_daimon_config_serde_roundtrip(): i64 {
    test_group("test_daimon_config_serde_roundtrip");
    var c = SlDaimonConfig_new("http://localhost:8090", "secret");
    var sb = str_builder_new();
    SlDaimonConfig_to_json(c, sb);
    var js = str_builder_build(sb);
    assert(_t_str_is(js, "{\"endpoint\":\"http://localhost:8090\",\"api_key\":\"secret\"}") == 1, "serde's JSON");
    var t, v = SlDaimonConfig_from_json(str_data(js), str_len(js));
    var p: *SlDaimonConfig = _sl_as_dconf(v);
    assert(is_ok(t) == 1 && _t_cstr_is(p.endpoint, "http://localhost:8090") == 1, "endpoint");
    assert(_t_cstr_is(p.api_key, "secret") == 1, "api key");
    var only = "{\"endpoint\":\"http://x\"}";
    var t2, v2 = SlDaimonConfig_from_json(only, strlen(only));
    var q: *SlDaimonConfig = _sl_as_dconf(v2);
    assert(is_ok(t2) == 1 && q.api_key == 0, "a missing Option is None");
    return 0;
}

fn _t_hoosh_config_serde_roundtrip(): i64 {
    test_group("test_hoosh_config_serde_roundtrip");
    var c: *SlHooshConfig = SlHooshConfig_default();
    var sb = str_builder_new();
    SlHooshConfig_to_json(c, sb);
    var js = str_builder_build(sb);
    assert(_t_str_is(js, "{\"endpoint\":\"http://localhost:8088\"}") == 1, "Rust's JSON when no model is set");
    var t, v = SlHooshConfig_from_json(str_data(js), str_len(js));
    var p: *SlHooshConfig = _sl_as_hconf(v);
    assert(is_ok(t) == 1 && _t_cstr_is(p.endpoint, "http://localhost:8088") == 1, "endpoint");
    return 0;
}

