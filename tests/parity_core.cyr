# parity_core.cyr — the golden-corpus replay machinery (port plan §2 step 6).
#
# Format and comparison rules: scripts/oracle/README.md. tests/parity.tcyr drives it.
#
# Every row of every module ends as one of:
# - ok: the verdict and every output matched within the row's class;
# - FAILED: an output differs beyond its class; the first _pc_print_limit per module are printed with the note;
# - measured: the module is not gated yet (a baseline is being taken); the difference is recorded and
#   printed, but does not fail;
# - accepted: the row carries an `adr=0002#N` tag and the port answered as that ADR row says;
# - pending: the row's function has no dispatcher entry yet;
# - upstream: the row is on the known-defect list (tests/parity.tcyr `_par_known`) under a filed upstream issue,
#   and it still shows that defect. Always printed, never a failure (ADR 0003). A listed row that passes is FAILED,
#   so the list shrinks when the fix lands.

var _PC_ROOT = "tests/golden/";

# Row outcomes.
enum PcOutcome { PC_OK = 0; PC_FAILED = 1; PC_MEASURED = 2; PC_ACCEPTED = 3; PC_PENDING = 4; PC_UPSTREAM = 5; }

# Per-module counters, by outcome.
var _pc_count: i64[6];
var _pc_failed_printed = 0;
# How many FAILED / measured rows a module prints. A baseline run prints them all.
var _pc_print_limit = 10;

# The B-class histogram of per-byte absolute differences: 0, 1, 2, 3..8, > 8.
var _pc_hist: i64[5];
var _pc_hist_max = 0;

# Print a NUL-terminated string.
fn _pc_s(s): i64 {
    print(s, strlen(s));
    return 0;
}

# Print n bytes at p.
fn _pc_b(p, n): i64 {
    print(p, n);
    return 0;
}

# Print a decimal integer.
fn _pc_i(n): i64 {
    print_num(n);
    return 0;
}

# tests/golden/ + rel[0..n), as a fresh NUL-terminated path.
fn _pc_path(rel, n): i64 {
    var rl = strlen(_PC_ROOT);
    var p = alloc(rl + n + 1);
    if (p == 0) { return 0; }
    memcpy(p, _PC_ROOT, rl);
    memcpy(p + rl, rel, n);
    store8(p + rl + n, 0);
    return p;
}

# Read tests/golden/<rel[0..n)> whole. Returns the buffer and stores the length, or returns 0 (with a negative
# length) when the file can't be read. An empty file is a valid buffer of length 0.
fn _pc_read(rel, n, len_out): i64 {
    var p = _pc_path(rel, n);
    if (p == 0) { store64(len_out, 0 - 12); return 0; }
    var buf = file_read_whole_max(p, 268435456, len_out);
    if (load64(len_out) < 0) { return 0; }
    return buf;
}

# The parsed decimal at s[0..n); -1 when it is not one.
fn _pc_int(s, n): i64 {
    if (n <= 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

# Index of the first byte equal to ch in s[from..n), or n.
fn _pc_find(s, from, n, ch): i64 {
    var i = from;
    while (i < n) {
        if (load8(s + i) == ch) { return i; }
        i = i + 1;
    }
    return n;
}

# 1 when the needle (NUL-terminated) occurs in s[0..n).
fn _pc_contains(s, n, needle): i64 {
    var m = strlen(needle);
    if (m == 0) { return 1; }
    var i = 0;
    while (i + m <= n) {
        if (memeq(s + i, needle, m) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# A row's fields, as (pointer, length) pairs: fn, class, inputs, outputs, note.
var _pc_f: i64[10];

# Split one line at tabs into _pc_f. Returns the field count.
fn _pc_split(line, n): i64 {
    var k = 0;
    var start = 0;
    while (k < 5) {
        var e = _pc_find(line, start, n, 9);
        _pc_f[k * 2] = line + start;
        _pc_f[k * 2 + 1] = e - start;
        k = k + 1;
        if (e >= n) { break; }
        start = e + 1;
    }
    return k;
}

# The i-th space-separated token of field f (0-based): stores its pointer and length, returns 1, or 0 when there
# is no such token.
fn _pc_tok(f, i, p_out, n_out): i64 {
    var s = _pc_f[f * 2];
    var n = _pc_f[f * 2 + 1];
    var start = 0;
    var k = 0;
    while (start <= n) {
        var e = _pc_find(s, start, n, 32);
        if (k == i) {
            store64(p_out, s + start);
            store64(n_out, e - start);
            return 1;
        }
        k = k + 1;
        start = e + 1;
    }
    return 0;
}

# Count a row's outcome; print FAILED / measured rows (the first ten per module) and every upstream row.
fn _pc_record(outcome, why): i64 {
    _pc_count[outcome] = _pc_count[outcome] + 1;
    if (outcome == PC_UPSTREAM) {
        _pc_s("  upstream ");
        _pc_b(_pc_f[4], _pc_f[5]);
        _pc_s(": ");
        _pc_s(why);
        _pc_s("\n");
        return 0;
    }
    if (outcome == PC_FAILED || outcome == PC_MEASURED) {
        if (_pc_failed_printed < _pc_print_limit) {
            if (outcome == PC_FAILED) { _pc_s("  FAILED   "); } else { _pc_s("  measured "); }
            _pc_b(_pc_f[4], _pc_f[5]);
            _pc_s(": ");
            _pc_s(why);
            _pc_s("\n           note: ");
            _pc_b(_pc_f[8], _pc_f[9]);
            _pc_s("\n");
        }
        _pc_failed_printed = _pc_failed_printed + 1;
    }
    return 0;
}

# Reset the per-module counters.
fn _pc_reset(): i64 {
    var i = 0;
    while (i < 6) {
        _pc_count[i] = 0;
        if (i < 5) { _pc_hist[i] = 0; }
        i = i + 1;
    }
    _pc_hist_max = 0;
    _pc_failed_printed = 0;
    return 0;
}

# Add per-byte differences of a[0..n) and b[0..n) to the histogram. Returns the largest.
fn _pc_hist_add(a, b, n): i64 {
    var mx = 0;
    var i = 0;
    while (i < n) {
        var d = load8(a + i) - load8(b + i);
        if (d < 0) { d = -d; }
        if (d == 0) { _pc_hist[0] = _pc_hist[0] + 1; }
        elif (d == 1) { _pc_hist[1] = _pc_hist[1] + 1; }
        elif (d == 2) { _pc_hist[2] = _pc_hist[2] + 1; }
        elif (d <= 8) { _pc_hist[3] = _pc_hist[3] + 1; }
        else { _pc_hist[4] = _pc_hist[4] + 1; }
        if (d > mx) { mx = d; }
        i = i + 1;
    }
    if (mx > _pc_hist_max) { _pc_hist_max = mx; }
    return mx;
}

# Print the module summary line (and the B histogram when it has data). Returns 1 when the module failed.
fn _pc_summary(module): i64 {
    _pc_s("[");
    _pc_s(module);
    _pc_s("] ok ");
    _pc_i(_pc_count[PC_OK]);
    _pc_s(", FAILED ");
    _pc_i(_pc_count[PC_FAILED]);
    _pc_s(", measured ");
    _pc_i(_pc_count[PC_MEASURED]);
    _pc_s(", accepted ");
    _pc_i(_pc_count[PC_ACCEPTED]);
    _pc_s(", upstream ");
    _pc_i(_pc_count[PC_UPSTREAM]);
    _pc_s(", pending ");
    _pc_i(_pc_count[PC_PENDING]);
    _pc_s("\n");
    var total = _pc_hist[0] + _pc_hist[1] + _pc_hist[2] + _pc_hist[3] + _pc_hist[4];
    if (total > 0) {
        _pc_s("  class B bytes: |d|=0 ");
        _pc_i(_pc_hist[0]);
        _pc_s(", 1 ");
        _pc_i(_pc_hist[1]);
        _pc_s(", 2 ");
        _pc_i(_pc_hist[2]);
        _pc_s(", 3-8 ");
        _pc_i(_pc_hist[3]);
        _pc_s(", >8 ");
        _pc_i(_pc_hist[4]);
        _pc_s("; max ");
        _pc_i(_pc_hist_max);
        _pc_s("\n");
    }
    if (_pc_count[PC_FAILED] > 0) { return 1; }
    return 0;
}

# ── tokens (format 1) ──────────────────────────────────────────────────────────────────

# The value of one hex digit, or -1.
fn _pc_hexd(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}

# The hex number at p[0..n).
fn _pc_hex(p, n): i64 {
    var v = 0;
    var i = 0;
    while (i < n) {
        v = (v << 4) | _pc_hexd(load8(p + i));
        i = i + 1;
    }
    return v;
}

# The signed decimal at p[0..n).
fn _pc_dec(p, n): i64 {
    if (n > 0 && load8(p) == 45) { return -_pc_int(p + 1, n - 1); }
    return _pc_int(p, n);
}

# Decode an `s:` payload (p[0..n), without the prefix) into a fresh buffer; stores its length.
fn _pc_unesc(p, n, len_out): i64 {
    var out = alloc(n + 1);
    var o = 0;
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 92 && i + 1 < n) {
            var e = load8(p + i + 1);
            if (e == 92) { store8(out + o, 92); i = i + 2; }
            elif (e == 116) { store8(out + o, 9); i = i + 2; }
            elif (e == 110) { store8(out + o, 10); i = i + 2; }
            elif (e == 114) { store8(out + o, 13); i = i + 2; }
            elif (e == 115) { store8(out + o, 32); i = i + 2; }
            elif (e == 120 && i + 3 < n) { store8(out + o, _pc_hex(p + i + 2, 2)); i = i + 4; }
            else { store8(out + o, c); i = i + 1; }
        } else {
            store8(out + o, c);
            i = i + 1;
        }
        o = o + 1;
    }
    store8(out + o, 0);
    store64(len_out, o);
    return out;
}

# Decode the i-th token of field f as an `s:` string (fresh buffer, length through len_out); 0 when it is not one.
fn _pc_tok_s(f, i, len_out): i64 {
    var p = 0;
    var n = 0;
    if (_pc_tok(f, i, &p, &n) == 0 || n < 2 || memeq(p, "s:", 2) != 1) { return 0; }
    return _pc_unesc(p + 2, n - 2, len_out);
}

# The payload value of the i-th token of field f as a number: `g:`/`f:`/`h:` hex, `i:` decimal, `b:` 0/1.
fn _pc_tok_num(f, i): i64 {
    var p = 0;
    var n = 0;
    if (_pc_tok(f, i, &p, &n) == 0 || n < 2) { return 0; }
    var k = load8(p);
    if (k == 105) { return _pc_dec(p + 2, n - 2); }
    if (k == 98) { return load8(p + 2) - 48; }
    return _pc_hex(p + 2, n - 2);
}

# Token writers (the oracle's spelling).
fn _pc_put_g(sb, bits): i64 {
    str_builder_add_cstr(sb, "g:");
    var i = 7;
    while (i >= 0) {
        str_builder_putc(sb, load8("0123456789abcdef" + ((bits >> (i * 4)) & 15)));
        i = i - 1;
    }
    return 0;
}
fn _pc_put_f(sb, bits): i64 {
    str_builder_add_cstr(sb, "f:");
    var i = 15;
    while (i >= 0) {
        str_builder_putc(sb, load8("0123456789abcdef" + ((bits >> (i * 4)) & 15)));
        i = i - 1;
    }
    return 0;
}
fn _pc_put_i(sb, v): i64 {
    str_builder_add_cstr(sb, "i:");
    str_builder_add_int(sb, v);
    return 0;
}
fn _pc_put_b(sb, v): i64 {
    str_builder_add_cstr(sb, "b:");
    str_builder_putc(sb, 48 + (v & 1));
    return 0;
}
fn _pc_put_h(sb, p, n): i64 {
    str_builder_add_cstr(sb, "h:");
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        str_builder_putc(sb, load8("0123456789abcdef" + (c >> 4)));
        str_builder_putc(sb, load8("0123456789abcdef" + (c & 15)));
        i = i + 1;
    }
    return 0;
}
fn _pc_put_s(sb, p, n): i64 {
    str_builder_add_cstr(sb, "s:");
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 92) { str_builder_add_cstr(sb, "\\\\"); }
        elif (c == 9) { str_builder_add_cstr(sb, "\\t"); }
        elif (c == 10) { str_builder_add_cstr(sb, "\\n"); }
        elif (c == 13) { str_builder_add_cstr(sb, "\\r"); }
        elif (c == 32) { str_builder_add_cstr(sb, "\\s"); }
        elif (c < 32 || c == 127) {
            str_builder_add_cstr(sb, "\\x");
            str_builder_putc(sb, load8("0123456789ABCDEF" + (c >> 4)));
            str_builder_putc(sb, load8("0123456789ABCDEF" + (c & 15)));
        } else {
            str_builder_putc(sb, c);
        }
        i = i + 1;
    }
    return 0;
}
fn _pc_put_sstr(sb, s): i64 {
    if (s == 0) { return _pc_put_s(sb, "", 0); }
    return _pc_put_s(sb, str_data(s), str_len(s));
}
fn _pc_put_raw(sb, cstr): i64 {
    str_builder_add_cstr(sb, cstr);
    return 0;
}
fn _pc_sp(sb): i64 {
    str_builder_putc(sb, 32);
    return 0;
}

# 1 when the g:/f: token a is a NaN.
fn _pc_tok_nan(p, n): i64 {
    if (n == 10 && load8(p) == 103) {
        var b = _pc_hex(p + 2, 8);
        return (b & 0x7FFFFFFF) > 0x7F800000;
    }
    if (n == 18 && load8(p) == 102) {
        var b2 = _pc_hex(p + 2, 16);
        return (b2 & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000;
    }
    return 0;
}

# Compare the port's rendered outputs (a Str) with the row's outputs field, token by token: equal text, or two NaN
# float tokens. An expected `E:serde` compares the verdict only (ADR 0002 #14). Records the outcome.
fn _pc_check(actual): i64 {
    var ep = _pc_f[6];
    var en = _pc_f[7];
    var ap = str_data(actual);
    var an = str_len(actual);
    if (en >= 7 && memeq(ep, "E:serde", 7) == 1) {
        if (an >= 7 && memeq(ap, "E:serde", 7) == 1) { return _pc_record(PC_OK, "both refuse"); }
        return _pc_record(PC_FAILED, _pc_diff_msg(ap, an));
    }
    var i = 0;
    var j = 0;
    loop {
        var ie = _pc_find(ep, i, en, 32);
        var je = _pc_find(ap, j, an, 32);
        var same = 0;
        if (ie - i == je - j && memeq(ep + i, ap + j, ie - i) == 1) { same = 1; }
        elif (_pc_tok_nan(ep + i, ie - i) == 1 && _pc_tok_nan(ap + j, je - j) == 1) { same = 1; }
        if (same == 0) { return _pc_record(PC_FAILED, _pc_diff_msg(ap, an)); }
        if (ie >= en || je >= an) {
            if (ie >= en && je >= an) { return _pc_record(PC_OK, "equal"); }
            return _pc_record(PC_FAILED, _pc_diff_msg(ap, an));
        }
        i = ie + 1;
        j = je + 1;
    }
    return 0;
}

# "port gave: <first 160 bytes>".
fn _pc_diff_msg(ap, an): i64 {
    var n = an;
    if (n > 160) { n = 160; }
    var m = alloc(n + 16);
    memcpy(m, "port gave: ", 11);
    memcpy(m + 11, ap, n);
    store8(m + 11 + n, 0);
    return m;
}

# 1 when the row's fn is the NUL-terminated name.
fn _pc_fn_is(name): i64 {
    var n = strlen(name);
    return _pc_f[1] == n && memeq(_pc_f[0], name, n) == 1;
}
