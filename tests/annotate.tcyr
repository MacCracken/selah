# annotate.tcyr — rust-old/src/annotate.rs's canvas, SVG, layer and rendering tests and the AnnotationCanvas::new
# doctest, ported (port plan M4); the codec half is in codec.tcyr. Golden parity: tests/golden/annotate.tsv.

include "tests/selah_src.cyr"
include "tests/support.cyr"

# A w × h image filled with one colour, as PNG bytes (Rust's solid_png), its length at len_out.
fn _t_png(w, h, r, g, b, a, len_out): i64 {
    var img: *SlImage = SlImage_new(w, h);
    var px = r | (g << 8) | (b << 16) | (a << 24);
    var i = 0;
    while (i < w * h) {
        store32(img.pixels + i * 4, px);
        i = i + 1;
    }
    var out = _sl_png_encode(img.pixels, w, h, len_out);
    SlImage_free(img);
    return out;
}

# annotate_image to PNG, decoded back (Rust's render helper); 0 when it fails.
fn _t_render(src, n, anns): *SlImage {
    var on = 0;
    var t, v = SlAnnotationCanvas_render_to_image(src, n, anns, SL_FMT_PNG, &on);
    if (is_err_result(t) == 1) { return 0; }
    var dt, dv = _sl_decode_image(v, on);
    selah_bytes_free(v);
    if (is_err_result(dt) == 1) { return 0; }
    return _sl_as_image(dv);
}

# 1 when pixel (x, y) is exactly (r, g, b, a).
fn _t_px(img: *SlImage, x, y, r, g, b, a): i64 {
    var p = img.pixels + (y * img.width + x) * 4;
    return load8(p) == r && load8(p + 1) == g && load8(p + 2) == b && load8(p + 3) == a;
}

# A vec holding one new annotation.
fn _t_one(kind, x, y, w, h, c: SlColor): i64 {
    var v = vec_new();
    vec_push(v, SlAnnotation_new(kind, _t_rect(x, y, w, h), c));
    return v;
}

# Renders one annotation on a solid white w × h image.
fn _t_render_one(w, h, kind, x, y, rw, rh, c: SlColor): *SlImage {
    var n = 0;
    var src = _t_png(w, h, 255, 255, 255, 255, &n);
    return _t_render(src, n, _t_one(kind, x, y, rw, rh, c));
}

# 10^k as an f64 (Cyrius has no exponent literals), by repeated products: exact to 10^22, within an ulp or so past.
fn _t_e(k): f64 {
    var v: f64 = 1.0;
    var i = 0;
    while (i < k) {
        v = v * 10.0;
        i = i + 1;
    }
    return v;
}

fn _t_canvas(): *SlAnnotationCanvas {
    return SlAnnotationCanvas_new(1920, 1080);
}

fn _t_add(c: *SlAnnotationCanvas, kind, x, y, w, h, col: SlColor): i64 {
    return SlAnnotationCanvas_add_annotation(c, SlAnnotation_new(kind, _t_rect(x, y, w, h), col));
}

fn _t_add_text(c: *SlAnnotationCanvas, kind, x, y, w, h, col: SlColor, text): i64 {
    return SlAnnotationCanvas_add_annotation(c, SlAnnotation_with_text(kind, _t_rect(x, y, w, h), col, str_from(text)));
}

# A unique temp path under /tmp, NUL-terminated.
fn _t_tmp(tag): i64 {
    var id: u8[16];
    _sl_uuid_v4(&id);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/selah_test_");
    str_builder_add_cstr(sb, tag);
    str_builder_add_cstr(sb, "_");
    _sl_uuid_fmt(sb, &id, 0);
    str_builder_add_cstr(sb, ".json");
    return str_data(str_builder_build(sb));
}

fn _t_new_canvas_empty(): i64 {
    test_group("test_new_canvas_empty");
    var c: *SlAnnotationCanvas = _t_canvas();
    assert(SlAnnotationCanvas_count(c) == 0, "empty");
    assert(c.width == 1920 && c.height == 1080, "size");
    return 0;
}

fn _t_add_annotation(): i64 {
    test_group("test_add_annotation");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add(c, SL_KIND_RECTANGLE, 10.0, 10.0, 100.0, 50.0, SL_COLOR_RED);
    assert(SlAnnotationCanvas_count(c) == 1, "one");
    return 0;
}

fn _t_remove_annotation(): i64 {
    test_group("test_remove_annotation");
    var c: *SlAnnotationCanvas = _t_canvas();
    var id = _t_add(c, SL_KIND_ARROW, 0.0, 0.0, 50.0, 50.0, SL_COLOR_BLUE);
    var copy: u8[16];
    memcpy(&copy, id, 16);
    assert(SlAnnotationCanvas_count(c) == 1, "one");
    assert(SlAnnotationCanvas_remove_annotation(c, &copy) == 1, "removed");
    assert(SlAnnotationCanvas_count(c) == 0, "none");
    return 0;
}

fn _t_remove_nonexistent(): i64 {
    test_group("test_remove_nonexistent");
    var c: *SlAnnotationCanvas = _t_canvas();
    var id: u8[16];
    _sl_uuid_v4(&id);
    assert(SlAnnotationCanvas_remove_annotation(c, &id) == 0, "nothing removed");
    return 0;
}

fn _t_clear(): i64 {
    test_group("test_clear");
    var c: *SlAnnotationCanvas = _t_canvas();
    var i = 0;
    while (i < 5) {
        _t_add(c, SL_KIND_CIRCLE, 0.0, 0.0, 30.0, 30.0, SL_COLOR_GREEN);
        i = i + 1;
    }
    assert(SlAnnotationCanvas_count(c) == 5, "five");
    SlAnnotationCanvas_clear(c);
    assert(SlAnnotationCanvas_count(c) == 0, "cleared");
    return 0;
}

fn _t_get_annotations(): i64 {
    test_group("test_get_annotations");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add(c, SL_KIND_TEXT, 0.0, 0.0, 200.0, 30.0, SL_COLOR_BLACK);
    var v = SlAnnotationCanvas_get_annotations(c);
    var a: *SlAnnotation = _sl_as_annotation(vec_get(v, 0));
    assert(vec_len(v) == 1 && a.kind == SL_KIND_TEXT, "one text");
    return 0;
}

fn _t_apply_redaction(): i64 {
    test_group("test_apply_redaction");
    var c: *SlAnnotationCanvas = _t_canvas();
    var id = SlAnnotationCanvas_apply_redaction(c, _t_rect(100.0, 200.0, 300.0, 50.0));
    var v = SlAnnotationCanvas_get_annotations(c);
    var a: *SlAnnotation = _sl_as_annotation(vec_get(v, 0));
    assert(vec_len(v) == 1 && memeq(a, id, 16) == 1, "its id");
    assert(a.kind == SL_KIND_REDACTION, "redaction");
    assert(a.color.r == 0 && a.color.g == 0 && a.color.b == 0 && a.color.a == 255, "black");
    return 0;
}

fn _t_svg_output_contains_svg_tag(): i64 {
    test_group("test_svg_output_contains_svg_tag");
    var svg = SlAnnotationCanvas_to_svg(_t_canvas());
    assert(str_len(svg) >= 4 && memeq(str_data(svg), "<svg", 4) == 1, "starts");
    assert(memeq(str_data(svg) + str_len(svg) - 6, "</svg>", 6) == 1, "ends");
    assert(_t_str_has(svg, "width=\"1920\"") == 1 && _t_str_has(svg, "height=\"1080\"") == 1, "size");
    return 0;
}

fn _t_svg_rectangle(): i64 {
    test_group("test_svg_rectangle");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add(c, SL_KIND_RECTANGLE, 10.0, 20.0, 100.0, 50.0, SL_COLOR_RED);
    var svg = SlAnnotationCanvas_to_svg(c);
    assert(_t_str_has(svg, "<rect") == 1 && _t_str_has(svg, "x=\"10\"") == 1, "rect");
    assert(_t_str_has(svg, "stroke=\"rgba(255,0,0,1.00)\"") == 1, "stroke");
    return 0;
}

fn _t_svg_redaction(): i64 {
    test_group("test_svg_redaction");
    var c: *SlAnnotationCanvas = _t_canvas();
    SlAnnotationCanvas_apply_redaction(c, _t_rect(0.0, 0.0, 200.0, 30.0));
    assert(_t_str_has(SlAnnotationCanvas_to_svg(c), "fill=\"black\"") == 1, "black");
    return 0;
}

fn _t_svg_text(): i64 {
    test_group("test_svg_text");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add_text(c, SL_KIND_TEXT, 50.0, 50.0, 200.0, 30.0, SL_COLOR_WHITE, "Hello World");
    var svg = SlAnnotationCanvas_to_svg(c);
    assert(_t_str_has(svg, "<text") == 1 && _t_str_has(svg, "Hello World") == 1, "text");
    return 0;
}

fn _t_save_and_load_annotations(): i64 {
    test_group("test_save_and_load_annotations");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add(c, SL_KIND_RECTANGLE, 10.0, 20.0, 100.0, 50.0, SL_COLOR_RED);
    _t_add_text(c, SL_KIND_TEXT, 50.0, 50.0, 200.0, 30.0, SL_COLOR_WHITE, "Test");
    var path = _t_tmp("layer");
    var st, sv = SlAnnotationCanvas_save_to_file(c, path);
    assert(is_ok(st) == 1, "saved");
    var lt, lv = SlAnnotationCanvas_load_from_file(path);
    assert(is_ok(lt) == 1, "loaded");
    var l: *SlAnnotationCanvas = _sl_as_canvas(lv);
    assert(l.width == 1920 && l.height == 1080 && SlAnnotationCanvas_count(l) == 2, "size and count");
    var a0: *SlAnnotation = _sl_as_annotation(vec_get(l.annotations, 0));
    var a1: *SlAnnotation = _sl_as_annotation(vec_get(l.annotations, 1));
    assert(a0.kind == SL_KIND_RECTANGLE && a1.kind == SL_KIND_TEXT, "kinds");
    assert(_t_str_is(a1.text, "Test") == 1, "text");
    xunlink(path);
    return 0;
}

fn _t_save_format_version(): i64 {
    test_group("test_save_format_version");
    var path = _t_tmp("layer_ver");
    var st, sv = SlAnnotationCanvas_save_to_file(_t_canvas(), path);
    assert(is_ok(st) == 1, "saved");
    var n = 0;
    var buf = file_read_whole_max(path, 1048576, &n);
    var v = _sl_json_parse(buf, n);
    assert(bayan_json_v_int(_sl_json_member(v, "version")) == 1, "version");
    assert(bayan_json_v_int(_sl_json_member(v, "width")) == 1920, "width");
    assert(bayan_json_v_int(_sl_json_member(v, "height")) == 1080, "height");
    assert(_sl_json_as_str(_sl_json_member(v, "created")) != 0, "created is a string");
    assert(bayan_json_v_is_arr(_sl_json_member(v, "annotations")) == true, "annotations is an array");
    xunlink(path);
    return 0;
}

fn _t_svg_text_xss_safe(): i64 {
    test_group("test_svg_text_xss_safe");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add_text(c, SL_KIND_TEXT, 0.0, 0.0, 200.0, 30.0, SL_COLOR_RED, "<script>alert('xss')</script>");
    var svg = SlAnnotationCanvas_to_svg(c);
    assert(_t_str_has(svg, "<script>") == 0 && _t_str_has(svg, "&lt;script&gt;") == 1, "escaped");
    return 0;
}

fn _t_svg_all_annotation_kinds(): i64 {
    test_group("test_svg_all_annotation_kinds");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add(c, SL_KIND_ARROW, 0.0, 0.0, 100.0, 100.0, SL_COLOR_RED);
    _t_add(c, SL_KIND_CIRCLE, 50.0, 50.0, 80.0, 80.0, SL_COLOR_GREEN);
    _t_add(c, SL_KIND_HIGHLIGHT, 10.0, 10.0, 200.0, 30.0, SL_COLOR_YELLOW);
    _t_add(c, SL_KIND_FREEFORM, 0.0, 0.0, 50.0, 50.0, SL_COLOR_BLUE);
    var svg = SlAnnotationCanvas_to_svg(c);
    assert(_t_str_has(svg, "<line") == 1 && _t_str_has(svg, "<ellipse") == 1, "line and ellipse");
    assert(_t_str_has(svg, "opacity=\"0.3\"") == 1 && _t_str_has(svg, "stroke-dasharray") == 1, "highlight, freeform");
    return 0;
}

fn _t_render_to_image_small_png(): i64 {
    test_group("test_render_to_image_small_png");
    var img: *SlImage = _t_render_one(4, 4, SL_KIND_REDACTION, 0.0, 0.0, 2.0, 2.0, SL_COLOR_BLACK);
    assert(img != 0, "rendered");
    var n = 0;
    var src = _t_png(4, 4, 255, 0, 0, 255, &n);
    var out: *SlImage = _t_render(src, n, _t_one(SL_KIND_REDACTION, 0.0, 0.0, 2.0, 2.0, SL_COLOR_BLACK));
    assert(out.width == 4 && out.height == 4, "4x4");
    assert(_t_px(out, 0, 0, 0, 0, 0, 255) == 1, "top-left black");
    assert(_t_px(out, 3, 3, 255, 0, 0, 255) == 1, "bottom-right red");
    return 0;
}

fn _t_render_to_image_with_multiple_annotations(): i64 {
    test_group("test_render_to_image_with_multiple_annotations");
    var n = 0;
    var src = _t_png(10, 10, 255, 255, 255, 255, &n);
    var anns = _t_one(SL_KIND_RECTANGLE, 1.0, 1.0, 8.0, 8.0, SL_COLOR_RED);
    vec_push(anns, SlAnnotation_new(SL_KIND_HIGHLIGHT, _t_rect(3.0, 3.0, 4.0, 4.0), SL_COLOR_YELLOW));
    var out: *SlImage = _t_render(src, n, anns);
    assert(out != 0 && out.width == 10 && out.height == 10, "10x10");
    return 0;
}

fn _t_svg_text_with_no_text(): i64 {
    test_group("test_svg_text_with_no_text");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add(c, SL_KIND_TEXT, 0.0, 0.0, 100.0, 20.0, SL_COLOR_BLACK);
    assert(_t_str_has(SlAnnotationCanvas_to_svg(c), "<text") == 1, "text element");
    return 0;
}

fn _t_redaction_negative_size_is_normalized(): i64 {
    test_group("test_redaction_negative_size_is_normalized");
    var img: *SlImage = _t_render_one(6, 6, SL_KIND_REDACTION, 4.0, 4.0, -4.0, -4.0, SL_COLOR_BLACK);
    var ok = 1;
    var y = 0;
    while (y < 4) {
        var x = 0;
        while (x < 4) {
            if (_t_px(img, x, y, 0, 0, 0, 255) == 0) { ok = 0; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert(ok == 1, "no pixel leaked");
    assert(_t_px(img, 5, 5, 255, 255, 255, 255) == 1, "outside untouched");
    return 0;
}

fn _t_redaction_fractional_edges_round_outward(): i64 {
    test_group("test_redaction_fractional_edges_round_outward");
    var img: *SlImage = _t_render_one(6, 6, SL_KIND_REDACTION, 0.5, 0.5, 1.0, 1.0, SL_COLOR_BLACK);
    assert(_t_px(img, 0, 0, 0, 0, 0, 255) == 1 && _t_px(img, 1, 0, 0, 0, 0, 255) == 1, "row 0");
    assert(_t_px(img, 0, 1, 0, 0, 0, 255) == 1 && _t_px(img, 1, 1, 0, 0, 0, 255) == 1, "row 1");
    assert(_t_px(img, 2, 2, 255, 255, 255, 255) == 1, "outside untouched");
    return 0;
}

fn _t_redaction_infinite_extent_clamps_to_edges(): i64 {
    test_group("test_redaction_infinite_extent_clamps_to_edges");
    var inf: f64 = 1.0 / 0.0;
    var img: *SlImage = _t_render_one(4, 4, SL_KIND_REDACTION, 2.0, 0.0, inf, 4.0, SL_COLOR_BLACK);
    assert(_t_px(img, 3, 3, 0, 0, 0, 255) == 1, "clamped to the edge");
    assert(_t_px(img, 1, 1, 255, 255, 255, 255) == 1, "left untouched");
    return 0;
}

fn _t_redaction_nan_region_rejected(): i64 {
    test_group("test_redaction_nan_region_rejected");
    var n = 0;
    var src = _t_png(4, 4, 255, 255, 255, 255, &n);
    var nan: f64 = 0.0 / 0.0;
    var on = 0;
    var d = 0;
    var t, v = SlAnnotationCanvas_render_to_image(src, n, _t_one(SL_KIND_REDACTION, nan, 0.0, 2.0, 2.0,
        SL_COLOR_BLACK), SL_FMT_PNG, &on, &d);
    assert(is_err_result(t) == 1 && _t_str_has(selah_error_display(v, d), "NaN") == 1, "refused");
    return 0;
}

fn _t_huge_coordinates_terminate_without_panic(): i64 {
    test_group("test_huge_coordinates_terminate_without_panic");
    var n = 0;
    var src = _t_png(16, 16, 255, 255, 255, 255, &n);
    var nan: f64 = 0.0 / 0.0;
    var inf: f64 = 1.0 / 0.0;
    var fmax: f64 = 340282346638528859811704183484516925440.0;
    var e9: f64 = _t_e(9);
    var e30: f64 = _t_e(30);
    var e38: f64 = _t_e(38);
    var anns = _t_one(SL_KIND_ARROW, -e30, -e30, 2.0 * e30, 2.0 * e30, SL_COLOR_RED);
    vec_push(anns, SlAnnotation_new(SL_KIND_ARROW, _t_rect(fmax, 0.0, -fmax, 0.0), SL_COLOR_RED));
    vec_push(anns, SlAnnotation_new(SL_KIND_CIRCLE, _t_rect(-e9, -e9, 2.0 * e9, 2.0 * e9), SL_COLOR_GREEN));
    vec_push(anns, SlAnnotation_new(SL_KIND_CIRCLE, _t_rect(e9, e9, 10.0, 10.0), SL_COLOR_GREEN));
    vec_push(anns, SlAnnotation_new(SL_KIND_RECTANGLE, _t_rect(nan, 0.0, e38, inf), SL_COLOR_BLUE));
    vec_push(anns, SlAnnotation_new(SL_KIND_HIGHLIGHT, _t_rect(-e38, -e38, inf, inf), SL_COLOR_YELLOW));
    var t0 = clock_now_ns();
    var img: *SlImage = _t_render(src, n, anns);
    var dt = clock_now_ns() - t0;
    assert(img != 0 && dt < 5000000000, "terminates within 5 s");
    var p = img.pixels + (8 * 16 + 8) * 4;
    assert(load8(p) == 255 && _t_px(img, 8, 8, 255, 255, 255, 255) == 0, "the diagonal arrow is visible");
    return 0;
}

fn _t_arrow_from_offscreen_draws_visible_part(): i64 {
    test_group("test_arrow_from_offscreen_draws_visible_part");
    var img: *SlImage = _t_render_one(10, 10, SL_KIND_ARROW, -100.0, 5.0, 200.0, 0.0, SL_COLOR_RED);
    var ok = 1;
    var x = 0;
    while (x < 10) {
        if (_t_px(img, x, 5, 255, 0, 0, 255) == 0) { ok = 0; }
        x = x + 1;
    }
    assert(ok == 1, "row 5 drawn");
    assert(_t_px(img, 5, 0, 255, 255, 255, 255) == 1, "row 0 untouched");
    return 0;
}

fn _t_arrow_negative_direction_draws(): i64 {
    test_group("test_arrow_negative_direction_draws");
    var img: *SlImage = _t_render_one(10, 10, SL_KIND_ARROW, 9.0, 9.0, -9.0, -9.0, SL_COLOR_BLUE);
    assert(_t_px(img, 0, 0, 0, 0, 255, 255) == 1 && _t_px(img, 5, 5, 0, 0, 255, 255) == 1, "drawn");
    return 0;
}

fn _t_highlight_blends_over_background(): i64 {
    test_group("test_highlight_blends_over_background");
    var img: *SlImage = _t_render_one(4, 4, SL_KIND_HIGHLIGHT, 0.0, 0.0, 4.0, 4.0, SlColor_new(255, 255, 0, 255));
    var p = img.pixels + (1 * 4 + 1) * 4;
    assert(load8(p) == 255 && load8(p + 1) == 255 && load8(p + 3) == 255, "r, g, a");
    assert(load8(p + 2) >= 170 && load8(p + 2) <= 185, "blue at about 70 %");
    return 0;
}

fn _t_circle_outline_drawn(): i64 {
    test_group("test_circle_outline_drawn");
    var img: *SlImage = _t_render_one(20, 20, SL_KIND_CIRCLE, 2.0, 2.0, 16.0, 16.0, SL_COLOR_GREEN);
    assert(_t_px(img, 10, 2, 0, 255, 0, 255) == 1, "top of the circle");
    assert(_t_px(img, 10, 10, 255, 255, 255, 255) == 1, "centre untouched");
    return 0;
}

fn _t_rectangle_negative_size_outline(): i64 {
    test_group("test_rectangle_negative_size_outline");
    var img: *SlImage = _t_render_one(10, 10, SL_KIND_RECTANGLE, 9.0, 9.0, -8.0, -8.0, SL_COLOR_RED);
    assert(_t_px(img, 1, 1, 255, 0, 0, 255) == 1, "outline");
    assert(_t_px(img, 5, 5, 255, 255, 255, 255) == 1, "inside untouched");
    return 0;
}

# Rust renders WebP too; the port refuses it (ADR 0002 #1).
fn _t_render_to_jpeg_and_webp(): i64 {
    test_group("test_render_to_jpeg_and_webp");
    var n = 0;
    var src = _t_png(8, 8, 10, 20, 30, 255, &n);
    var anns = _t_one(SL_KIND_REDACTION, 0.0, 0.0, 4.0, 4.0, SL_COLOR_BLACK);
    var jn = 0;
    var t, jpg = SlAnnotationCanvas_render_to_image(src, n, anns, SL_FMT_JPEG, &jn);
    assert(is_ok(t) == 1 && load8(jpg) == 255 && load8(jpg + 1) == 216, "JPEG SOI");
    var dt, dv = _sl_decode_image(jpg, jn);
    var img: *SlImage = _sl_as_image(dv);
    assert(is_ok(dt) == 1 && img.width == 8, "decodes, 8 wide");
    var wn = 0;
    var wt, wv = SlAnnotationCanvas_render_to_image(src, n, anns, SL_FMT_WEBP, &wn);
    assert(is_err_result(wt) == 1 && wv == SL_ERR_UNSUPPORTED_FORMAT, "WebP refused (ADR 0002 #1)");
    return 0;
}

fn _t_huge_circle_partially_on_canvas_no_overflow(): i64 {
    test_group("test_huge_circle_partially_on_canvas_no_overflow");
    var e20: f64 = _t_e(20);
    var img: *SlImage = _t_render_one(16, 16, SL_KIND_CIRCLE, -e20, 0.0, 2.0 * e20, 100.0, SL_COLOR_GREEN);
    assert(img != 0 && img.width == 16 && img.height == 16, "16x16");
    return 0;
}

fn _t_stamp_saturates_at_extremes(): i64 {
    test_group("test_stamp_saturates_at_extremes");
    var img: *SlImage = SlImage_new(4, 4);
    var px = 1 | (2 << 8) | (3 << 16) | (4 << 24);
    _sl_stamp(img, 9223372036854775806, 0, 3, px);
    _sl_stamp(img, -9223372036854775807 - 1, -9223372036854775807 - 1, 3, px);
    var zero = 1;
    var i = 0;
    while (i < 64) {
        if (load8(img.pixels + i) != 0) { zero = 0; }
        i = i + 1;
    }
    assert(zero == 1, "nothing drawn");
    _sl_stamp(img, -1, -1, 3, 9 | (9 << 8) | (9 << 16) | (9 << 24));
    assert(_t_px(img, 1, 1, 9, 9, 9, 9) == 1, "clipped stamp");
    return 0;
}

# Rust compares clip_line's Option of two points; here the four f64s.
fn _t_clip(x0: f64, y0: f64, x1: f64, y1: f64, out): i64 {
    return _sl_clip_line(x0, y0, x1, y1, 0.0, 0.0, 10.0, 10.0, out);
}

fn _t_seg_is(seg, a: f64, b: f64, c: f64, d: f64): i64 {
    var s0: f64 = load64(seg);
    var s1: f64 = load64(seg + 8);
    var s2: f64 = load64(seg + 16);
    var s3: f64 = load64(seg + 24);
    return s0 == a && s1 == b && s2 == c && s3 == d;
}

fn _t_clip_line(): i64 {
    test_group("test_clip_line");
    var seg: i64[4];
    assert(_t_clip(1.0, 1.0, 5.0, 5.0, &seg) == 1 && _t_seg_is(&seg, 1.0, 1.0, 5.0, 5.0) == 1, "inside");
    assert(_t_clip(-10.0, 5.0, 20.0, 5.0, &seg) == 1 && _t_seg_is(&seg, 0.0, 5.0, 10.0, 5.0) == 1, "crossing");
    assert(_t_clip(20.0, 0.0, 30.0, 10.0, &seg) == 0, "outside");
    assert(_t_clip(-5.0, -1.0, 15.0, -1.0, &seg) == 0, "parallel outside");
    var nan: f64 = 0.0 / 0.0;
    var inf: f64 = 1.0 / 0.0;
    assert(_t_clip(nan, 0.0, 1.0, 1.0, &seg) == 0, "NaN");
    assert(_t_clip(0.0, 0.0, inf, 1.0, &seg) == 0, "infinite");
    return 0;
}

fn _t_svg_arrow_has_matching_marker(): i64 {
    test_group("test_svg_arrow_has_matching_marker");
    var c: *SlAnnotationCanvas = _t_canvas();
    var id = _t_add(c, SL_KIND_ARROW, 0.0, 0.0, 10.0, 10.0, SL_COLOR_RED);
    var mb = str_builder_new();
    str_builder_add_cstr(mb, "id=\"arrow-");
    _sl_uuid_fmt(mb, id, 0);
    str_builder_add_cstr(mb, "\"");
    var rb = str_builder_new();
    str_builder_add_cstr(rb, "url(#arrow-");
    _sl_uuid_fmt(rb, id, 0);
    str_builder_add_cstr(rb, ")");
    var svg = SlAnnotationCanvas_to_svg(c);
    var marker = str_builder_build(mb);
    var refr = str_builder_build(rb);
    assert(_t_str_has(svg, str_data(marker)) == 1 && _t_str_has(svg, str_data(refr)) == 1, "marker and reference");
    assert(_t_str_has(svg, "<marker") == 1, "marker element");
    return 0;
}

fn _t_svg_negative_rect_normalized(): i64 {
    test_group("test_svg_negative_rect_normalized");
    var c: *SlAnnotationCanvas = _t_canvas();
    SlAnnotationCanvas_apply_redaction(c, _t_rect(100.0, 100.0, -50.0, -30.0));
    var svg = SlAnnotationCanvas_to_svg(c);
    assert(_t_str_has(svg, "x=\"50\" y=\"70\" width=\"50\" height=\"30\"") == 1, "normalized");
    assert(_t_str_has(svg, "width=\"-") == 0, "no negative width");
    return 0;
}

fn _t_svg_non_finite_written_as_zero(): i64 {
    test_group("test_svg_non_finite_written_as_zero");
    var c: *SlAnnotationCanvas = _t_canvas();
    var nan: f64 = 0.0 / 0.0;
    var inf: f64 = 1.0 / 0.0;
    _t_add(c, SL_KIND_RECTANGLE, nan, 1.0, inf, 2.0, SL_COLOR_RED);
    var svg = SlAnnotationCanvas_to_svg(c);
    assert(_t_str_has(svg, "NaN") == 0 && _t_str_has(svg, "inf") == 0, "no NaN or inf");
    return 0;
}

fn _t_svg_text_strips_control_chars(): i64 {
    test_group("test_svg_text_strips_control_chars");
    var c: *SlAnnotationCanvas = _t_canvas();
    var s = str_from_buf("a\x00b", 3);
    SlAnnotationCanvas_add_annotation(c, SlAnnotation_with_text(SL_KIND_TEXT, _t_rect(0.0, 0.0, 10.0, 10.0),
        SL_COLOR_BLACK, s));
    assert(_t_str_has(SlAnnotationCanvas_to_svg(c), ">ab</text>") == 1, "stripped");
    return 0;
}

fn _t_load_rejects_future_layer_version(): i64 {
    test_group("test_load_rejects_future_layer_version");
    var path = _t_tmp("layer_future");
    var json = "{\"version\":2,\"width\":1,\"height\":1,\"created\":\"2026-11-14T00:00:00Z\",\"annotations\":[]}";
    file_write_all(path, json, strlen(json));
    var d = 0;
    var t, v = SlAnnotationCanvas_load_from_file(path, &d);
    assert(is_err_result(t) == 1, "refused");
    assert(_t_str_has(selah_error_display(v, d), "unsupported annotation layer version") == 1, "message");
    xunlink(path);
    return 0;
}

fn _t_load_rejects_invalid_rect(): i64 {
    test_group("test_load_rejects_invalid_rect");
    var path = _t_tmp("layer_badrect");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"version\":1,\"width\":1,\"height\":1,\"created\":\"2026-01-01T00:00:00Z\",");
    str_builder_add_cstr(sb, "\"annotations\":[{\"id\":\"00000000-0000-0000-0000-000000000000\",");
    str_builder_add_cstr(sb, "\"kind\":\"Redaction\",");
    str_builder_add_cstr(sb, "\"position\":{\"x\":1e39,\"y\":0,\"width\":1,\"height\":1},");
    str_builder_add_cstr(sb, "\"color\":{\"r\":0,\"g\":0,\"b\":0,\"a\":255},\"text\":null}]}");
    var json = str_builder_build(sb);
    file_write_all(path, str_data(json), str_len(json));
    var t, v = SlAnnotationCanvas_load_from_file(path);
    assert(is_err_result(t) == 1, "refused");
    xunlink(path);
    return 0;
}

# The AnnotationCanvas::new doctest.
fn _t_doctest_canvas_new(): i64 {
    test_group("doctest AnnotationCanvas::new");
    var c = SlAnnotationCanvas_new(1920, 1080);
    _t_add(c, SL_KIND_RECTANGLE, 10.0, 10.0, 100.0, 50.0, SL_COLOR_RED);
    assert(SlAnnotationCanvas_count(c) == 1, "count");
    SlAnnotationCanvas_free(c);
    return 0;
}

# Cyrius-only: a saved layer is the pretty-printed serde text, 0600, and the file is replaced atomically.
fn _t_layer_file_is_private_and_pretty(): i64 {
    test_group("layer file: private, pretty, replaced");
    var c: *SlAnnotationCanvas = _t_canvas();
    _t_add(c, SL_KIND_ARROW, 1.0, 2.0, 3.0, 4.0, SL_COLOR_RED);
    var path = _t_tmp("layer_private");
    SlAnnotationCanvas_save_to_file(c, path);
    var st[256];
    xstat(path, &st);
    assert((load32(&st + STAT_MODE) & 511) == 384, "mode 0600");
    var n = 0;
    var buf = file_read_whole_max(path, 1048576, &n);
    assert(n > 2 && memeq(buf, "{\n  \"version\": 1,\n  \"width\": 1920,", 34) == 1, "pretty");
    SlAnnotationCanvas_clear(c);
    var t, v = SlAnnotationCanvas_save_to_file(c, path);
    var lt, lv = SlAnnotationCanvas_load_from_file(path);
    var l: *SlAnnotationCanvas = _sl_as_canvas(lv);
    assert(is_ok(t) == 1 && is_ok(lt) == 1 && SlAnnotationCanvas_count(l) == 0, "replaced");
    xunlink(path);
    return 0;
}

# Cyrius-only: a canvas whose layer file could not be read back is refused at save (ADR 0002 #19), and no file is
# left behind.
fn _t_save_refuses_unreadable_layer(): i64 {
    test_group("save refuses a non-finite region (ADR 0002 #19)");
    var c: *SlAnnotationCanvas = _t_canvas();
    var inf: f64 = 1.0 / 0.0;
    _t_add(c, SL_KIND_RECTANGLE, 0.0, 0.0, inf, 4.0, SL_COLOR_RED);
    var path = _t_tmp("layer_inf");
    var d = 0;
    var t, v = SlAnnotationCanvas_save_to_file(c, path, &d);
    assert(is_err_result(t) == 1 && v == SL_ERR_ANNOTATION, "refused");
    assert(_t_str_has(selah_error_display(v, d), "non-finite") == 1, "message");
    var st[256];
    assert(xstat(path, &st) != 0, "no file written");
    return 0;
}

# Runs the suite; the exit code is the failure count, clamped.
fn main(): i64 {
    alloc_init();
    _t_new_canvas_empty();
    _t_add_annotation();
    _t_remove_annotation();
    _t_remove_nonexistent();
    _t_clear();
    _t_get_annotations();
    _t_apply_redaction();
    _t_svg_output_contains_svg_tag();
    _t_svg_rectangle();
    _t_svg_redaction();
    _t_svg_text();
    _t_save_and_load_annotations();
    _t_save_format_version();
    _t_svg_text_xss_safe();
    _t_svg_all_annotation_kinds();
    _t_render_to_image_small_png();
    _t_render_to_image_with_multiple_annotations();
    _t_svg_text_with_no_text();
    _t_redaction_negative_size_is_normalized();
    _t_redaction_fractional_edges_round_outward();
    _t_redaction_infinite_extent_clamps_to_edges();
    _t_redaction_nan_region_rejected();
    _t_huge_coordinates_terminate_without_panic();
    _t_arrow_from_offscreen_draws_visible_part();
    _t_arrow_negative_direction_draws();
    _t_highlight_blends_over_background();
    _t_circle_outline_drawn();
    _t_rectangle_negative_size_outline();
    _t_render_to_jpeg_and_webp();
    _t_huge_circle_partially_on_canvas_no_overflow();
    _t_stamp_saturates_at_extremes();
    _t_clip_line();
    _t_svg_arrow_has_matching_marker();
    _t_svg_negative_rect_normalized();
    _t_svg_non_finite_written_as_zero();
    _t_svg_text_strips_control_chars();
    _t_load_rejects_future_layer_version();
    _t_load_rejects_invalid_rect();
    _t_doctest_canvas_new();
    _t_layer_file_is_private_and_pretty();
    _t_save_refuses_unreadable_layer();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
