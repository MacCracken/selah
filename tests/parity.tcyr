fn _par_wire_ocr_row(): i64 {
    var mn = 0;
    var model = _pc_tok_s(2, 0, &mn);
    var n = 0;
    var img = _par_in_h(1, &n);
    var segs = vec_new();
    vec_push(segs, "v1");
    vec_push(segs, "chat");
    vec_push(segs, "completions");
    var t, u = _sl_endpoint_url("http://127.0.0.1:1", segs);
    var line = str_builder_new();
    str_builder_add_cstr(line, "POST ");
    str_builder_add(line, _par_url_path(u));
    var a = _sl_scratch_new();
    var req = _sl_ocr_request(a, model, _sl_guess_mime(img, n), img, n);
    var out = str_builder_new();
    _pc_put_sstr(out, str_builder_build(line));
    _pc_sp(out);
    _pc_put_sstr(out, req);
    _sl_scratch_free(a);
    return _pc_check_out(str_builder_build(out));
}

# Class R for history: history files the port writes, which `oracle --reverse` lists with Rust and compares with
# the ids the port lists, newest first (build/reverse/history-N.jsonl and .ids).
var _par_hist_rev = 0;

fn _par_rev_entry(s, id, secs, nanos, path, source, fmt): i64 {
    var idb: u8[16];
    var i = 0;
    while (i < 16) {
        store8(&idb + i, 0);
        i = i + 1;
    }
    store8(&idb + 15, id);
    store8(&idb + 6, 64);
    store8(&idb + 8, 128);
    var e = SlHistoryEntry_new(&idb, path, strlen(path), secs, nanos, source, strlen(source), id * 100, id * 50, fmt,
        strlen(fmt));
    SlHistoryStore_record(s, e);
    SlHistoryEntry_free(e);
    return 0;
}

fn _par_rev_ids(s, path): i64 {
    var t, v = SlHistoryStore_list(s, -1);
    var sb = str_builder_new();
    var i = 0;
    while (i < vec_len(v)) {
        _sl_uuid_fmt(sb, vec_get(v, i), 1);
        str_builder_putc(sb, 10);
        i = i + 1;
    }
    selah_history_entries_free(v);
    var ids = str_builder_build(sb);
    file_write_all(path, str_data(ids), str_len(ids));
    return vec_len(v);
}

fn _par_reverse_history(): i64 {
    sys_mkdir("build", 493);
    sys_mkdir("build/reverse", 493);
    var k = 0;
    while (k < 3) {
        var pb = str_builder_new();
        str_builder_add_cstr(pb, "build/reverse/history-");
        str_builder_add_int(pb, k);
        var stem = str_builder_build(pb);
        var jb = str_builder_new();
        str_builder_add(jb, stem);
        str_builder_add_cstr(jb, ".jsonl");
        var jp = str_data(str_builder_build(jb));
        xunlink(jp);
        var lb = str_builder_new();
        str_builder_add_cstr(lb, jp);
        str_builder_add_cstr(lb, ".lock");
        xunlink(str_data(str_builder_build(lb)));
        if (k == 1) { file_write_all(jp, "{\"id\":\"0000", 11); }
        var s = SlHistoryStore_open(jp);
        _par_rev_entry(s, 1, 1763164800, 0, "/tmp/a.png", "full screen", "png");
        _par_rev_entry(s, 2, 1763164801, 500000000, "/tmp/\"q\"\\é😀\n.png", "region (5x5 at 1,2)", "jpg");
        _par_rev_entry(s, 3, 1763164801, 500000000, "", "", "bmp");
        _par_rev_entry(s, 4, -1, 999999999, "/x", "window 7", "png");
        _par_rev_entry(s, 5, 253402300799, 123456789, "/y", "s\x01\x7f", "png");
        if (k == 2) {
            var gone: u8[16];
            var i = 0;
            while (i < 16) {
                store8(&gone + i, 0);
                i = i + 1;
            }
            store8(&gone + 15, 3);
            store8(&gone + 6, 64);
            store8(&gone + 8, 128);
            SlHistoryStore_delete(s, &gone);
        }
        var ib = str_builder_new();
        str_builder_add(ib, stem);
        str_builder_add_cstr(ib, ".ids");
        _par_rev_ids(s, str_data(str_builder_build(ib)));
        SlHistoryStore_free(s);
        _par_hist_rev = _par_hist_rev + 1;
        k = k + 1;
    }
    _pc_s("  history: ");
    _pc_i(_par_hist_rev);
    _pc_s(" files written for `oracle --reverse` (build/reverse/history-*.jsonl)\n");
    return 0;
}

# The system module's row dispatcher.
fn _par_system_row(): i64 {
    if (_pc_fn_is("history_line") == 1) { return _par_history_line_row(); }
    if (_pc_fn_is("history_id") == 1) { return _par_history_id_row(); }
    if (_pc_fn_is("history_json") == 1) { return _par_history_json_row(); }
    if (_pc_fn_is("history_list") == 1) { return _par_history_list_row(); }
    if (_pc_fn_is("history_get") == 1) { return _par_history_get_row(); }
    if (_pc_fn_is("history_delete") == 1) { return _par_history_delete_row(); }
    if (_pc_fn_is("region") == 1) { return _par_region_row(); }
    if (_pc_fn_is("monitor_req") == 1) { return _par_monitor_req_row(); }
    if (_pc_fn_is("capture_http") == 1) { return _par_capture_http_row(); }
    if (_pc_fn_is("monitors_http") == 1) { return _par_monitors_http_row(); }
    if (_pc_fn_is("ocr_answer") == 1) { return _par_ocr_answer_row(); }
    if (_pc_fn_is("agent_path") == 1) { return _par_agent_path_row(); }
    if (_pc_fn_is("session") == 1) { return _par_session_row(); }
    if (_pc_fn_is("mime") == 1) { return _par_mime_row(); }
    if (_pc_fn_is("exit_status") == 1) { return _par_exit_status_row(); }
    if (_pc_fn_is("rect_debug") == 1) { return _par_rect_debug_row(); }
    if (_pc_fn_is("daimon_config") == 1) { return _par_daimon_config_row(); }
    if (_pc_fn_is("daimon_config_json") == 1) { return _par_daimon_config_json_row(); }
    if (_pc_fn_is("hoosh_config") == 1) { return _par_hoosh_config_row(); }
    if (_pc_fn_is("wire_register") == 1) { return _par_wire_register_row(); }
    if (_pc_fn_is("wire_ocr") == 1) { return _par_wire_ocr_row(); }
    return _pc_record(PC_PENDING, "no dispatcher");
}

# ---------------------------------------------------------------- driver

# Replay one module's .tsv. Returns 1 when the module failed.
fn _par_module(name, n): i64 {
    _pc_reset();
    var file = alloc(n + 5);
    memcpy(file, name, n);
    memcpy(file + n, ".tsv", 4);
    store8(file + n + 4, 0);
    var len = 0;
    var tsv = _pc_read(file, n + 4, &len);
    if (tsv == 0) {
        _pc_s("[");
        _pc_s(file);
        _pc_s("] FAILED: the golden file is missing\n");
        return 1;
    }
    var which = 0;
    if (n == 6 && memeq(name, "decode", 6) == 1) { which = 1; _pc_print_limit = 1000; }
    elif (n == 5 && memeq(name, "error", 5) == 1) { which = 2; }
    elif (n == 4 && memeq(name, "fmtf", 4) == 1) { which = 3; }
    elif (n == 8 && memeq(name, "geometry", 8) == 1) { which = 4; }
    elif (n == 4 && memeq(name, "core", 4) == 1) { which = 5; }
    elif (n == 4 && memeq(name, "uuid", 4) == 1) { which = 6; }
    elif (n == 7 && memeq(name, "rfc3339", 7) == 1) { which = 7; }
    elif (n == 2 && memeq(name, "ai", 2) == 1) { which = 8; }
    elif (n == 5 && memeq(name, "codec", 5) == 1) { which = 9; }
    elif (n == 8 && memeq(name, "annotate", 8) == 1) { which = 10; }
    elif (n == 6 && memeq(name, "system", 6) == 1) { which = 11; }
    if (which != 1) { _pc_print_limit = 10; }
    var pos = 0;
    while (pos < len) {
        var e = _pc_find(tsv, pos, len, 10);
        var ln = e - pos;
        if (ln > 0 && load8(tsv + pos) != 35) {
            _pc_split(tsv + pos, ln);
            if (which == 1 && _pc_fn_is("decode") == 1) { _par_decode_row(); }
            elif (which == 2) { _par_error_row(); }
            elif (which == 3) { _par_fmtf_row(); }
            elif (which == 4) { _par_geometry_row(); }
            elif (which == 5) { _par_core_row(); }
            elif (which == 6) { _par_uuid_row(); }
            elif (which == 7) { _par_rfc3339_row(); }
            elif (which == 8) { _par_ai_row(); }
            elif (which == 9 && _pc_fn_is("convert_format") == 1) { _par_convert_row(); }
            elif (which == 9 && _pc_fn_is("encode") == 1) { _par_encode_row(); }
            elif (which == 10 && _pc_fn_is("render") == 1) { _par_render_row(); }
            elif (which == 10 && _pc_fn_is("to_svg") == 1) { _par_svg_row(); }
            elif (which == 10 && _pc_fn_is("layer_json") == 1) { _par_layer_json_row(); }
            elif (which == 10 && _pc_fn_is("layer_load") == 1) { _par_layer_load_row(); }
            elif (which == 10 && _pc_fn_is("decode_image_data") == 1) { _par_decode_data_row(); }
            elif (which == 10 && _pc_fn_is("redact_image") == 1) { _par_redact_row(); }
            elif (which == 11) { _par_system_row(); }
            else { _pc_record(PC_PENDING, "no dispatcher"); }
        }
        pos = e + 1;
    }
    if (which == 9 && _par_rj_n > 0) {
        _pc_s("  encode JPEG: coefficients off the exact mathematics ");
        _pc_i(_par_jm_off);
        _pc_s(" of ");
        _pc_i(_par_jm_total);
        _pc_s(" (bound: none over 1, at most 1 % per image)\n");
        _pc_s("  encode JPEG, measured: mean error vs input over ");
        _pc_i(_par_rj_n);
        _pc_s(" images, port (chitra decodes) ");
        _par_milli(_par_rj_port / _par_rj_n);
        _pc_s(", Rust (image decodes) ");
        _par_milli(_par_rj_rust / _par_rj_n);
        _pc_s("; worst image ");
        if (_par_rev_worst < 0) {
            _pc_s("-");
            _par_milli(-_par_rev_worst);
        } else {
            _pc_s("+");
            _par_milli(_par_rev_worst);
        }
        _pc_s("; reverse files in build/reverse/\n");
    }
    if (which == 11) { _par_reverse_history(); }
    var modname = alloc(n + 1);
    memcpy(modname, name, n);
    store8(modname + n, 0);
    return _pc_summary(modname);
}

# Replay every module in tests/golden/modules.txt; the exit code is the number that failed.
fn main(): i64 {
    alloc_init();
    var len = 0;
    var list = _pc_read("modules.txt", 11, &len);
    if (list == 0) {
        _pc_s("parity: tests/golden/modules.txt is missing (run scripts/oracle)\n");
        return 1;
    }
    var failed = 0;
    var pos = 0;
    while (pos < len) {
        var e = _pc_find(list, pos, len, 10);
        if (e > pos) { failed = failed + _par_module(list + pos, e - pos); }
        pos = e + 1;
    }
    _pc_s("parity: ");
    _pc_i(failed);
    _pc_s(" module(s) failed\n");
    return failed;
}

var exit_code = main();
sys_exit_group(exit_code);
