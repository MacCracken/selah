# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §2 step 6. Format and comparison rules: scripts/oracle/README.md; the machinery and the row
# outcomes are in tests/parity_core.cyr. The module list is tests/golden/modules.txt, which the generator writes.
#
# The exit code is the number of modules with a FAILED row, so the 8-bit exit status cannot wrap.

include "tests/parity_core.cyr"
include "src/error.cyr"
include "src/version_str.cyr"
include "src/log.cyr"
include "src/scratch.cyr"
include "src/fmtf.cyr"
include "src/json.cyr"
include "src/uuid.cyr"
include "src/rfc3339.cyr"
include "src/geometry.cyr"
include "src/debug_data.cyr"
include "src/core.cyr"
include "src/ai_data.cyr"
include "src/ai.cyr"
include "src/png_enc.cyr"
include "src/bmp_enc.cyr"
include "src/jpeg_enc.cyr"
include "src/codec.cyr"
include "src/fsutil.cyr"
include "src/raster.cyr"
include "src/annotate.cyr"
include "src/selah.cyr"
include "src/history.cyr"
include "src/http.cyr"
include "src/spawn.cyr"
include "src/capture.cyr"
include "src/daimon.cyr"

# ---------------------------------------------------------------- decode, convert_format, encode
#
# M3 gates these under ADR 0003 (port plan §4; the bounds are docs/development/port-parity.md §5):
# - class A rows must match exactly (PNG and BMP pixels, every verdict and its error variant);
# - class B rows (a JPEG decoded by both) must pass two gates: accuracy against the fixture's source pixels (port
#   mean <= Rust's + 0.050 and max <= Rust's + 2) and conformance with Rust (per channel |d| <= K_jpeg);
# - an `adr=0002#N` row passes when the port refuses with UnsupportedFormat, as ADR 0002 row N says;
# - a row on the known-defect list (`_par_known`) reports `upstream` while it shows its defect, and FAILS once it
#   passes, so the list is cut when the upstream fix lands.

# The bounds of port-parity.md §5.
var _PAR_K_JPEG = 2;
var _PAR_ACC_MEAN = 50;   # thousandths
var _PAR_ACC_MAX = 2;

# The known-defect list: a decode fixture (exact file name) and the filed upstream issue it waits on (ADR 0003, port
# plan §6). A listed row reports `upstream` while it shows the defect and FAILS once it passes.
var _PAR_F1 = "chitra 2026-11-14-box-chroma-upsampling-loses-accuracy (L12)";
var _PAR_F3 = "chitra 2026-11-14-bmp-sub-8-bit-replication-is-not-the-nearest-value (L13)";
var _PAR_CAP = "chitra 2026-11-14-fixed-16-mp-cap-refuses-screenshots (L17)";

# 1 when file[0..n) is exactly the NUL-terminated name.
fn _par_is(file, n, name): i64 {
    var l = strlen(name);
    return n == l && memeq(file, name, l) == 1;
}

fn _par_known(file, n): i64 {
    if (_par_is(file, n, "jpeg-enc-420-64x64.jpg") == 1) { return _PAR_F1; }
    if (_par_is(file, n, "jpeg-enc-420-33x17.jpg") == 1) { return _PAR_F1; }
    if (_par_is(file, n, "jpeg-enc-422-64x64.jpg") == 1) { return _PAR_F1; }
    if (_par_is(file, n, "jpeg-enc-440-64x64.jpg") == 1) { return _PAR_F1; }
    if (_par_is(file, n, "jpeg-enc-restart-64x64.jpg") == 1) { return _PAR_F1; }
    if (_par_is(file, n, "bmp-16-555-33x17.bmp") == 1) { return _PAR_F3; }
    if (_par_is(file, n, "bmp-16-565-33x17.bmp") == 1) { return _PAR_F3; }
    if (_par_is(file, n, "png-gray1-4100x4100.png") == 1) { return _PAR_CAP; }
    return 0;
}

# The outcome note of a row the port refuses as ADR 0002 says.
var _PAR_ADR_OK = "UnsupportedFormat, as ADR 0002 says";

# The N of the row's `adr=0002#N` tag, or 0.
fn _par_adr(): i64 {
    var s = _pc_f[8];
    var n = _pc_f[9];
    var i = 0;
    while (i + 9 <= n) {
        if (memeq(s + i, "adr=0002#", 9) == 1) {
            var j = i + 9;
            var v = 0;
            while (j < n && load8(s + j) >= 48 && load8(s + j) <= 57) {
                v = v * 10 + load8(s + j) - 48;
                j = j + 1;
            }
            return v;
        }
        i = i + 1;
    }
    return 0;
}

# 1 when the output token at (op, on) is `E:` followed by the name of error `code`.
fn _par_err_is(op, on, code): i64 {
    var name = selah_error_name(code);
    var l = strlen(name);
    return on == l + 2 && memeq(op + 2, name, l) == 1;
}

# A why-message buffer: prefix + decimal + text + decimal + text.
var _par_why: u8[256];
fn _par_why5(a, n1, b, n2, c): i64 {
    var p = &_par_why;
    var k = 0;
    var parts: i64[3];
    parts[0] = a;
    parts[1] = b;
    parts[2] = c;
    var nums: i64[2];
    nums[0] = n1;
    nums[1] = n2;
    var i = 0;
    while (i < 3) {
        var s = parts[i];
        var l = strlen(s);
        if (k + l > 200) { l = 200 - k; }
        memcpy(p + k, s, l);
        k = k + l;
        if (i < 2) {
            var nb: u8[32];
            var nl = fmt_int_buf(nums[i], &nb);
            memcpy(p + k, &nb, nl);
            k = k + nl;
        }
        i = i + 1;
    }
    store8(p + k, 0);
    return p;
}

# The mean (in thousandths) and the largest absolute error of the RGB channels of px[0..n) against src[0..n).
fn _par_err_vs(px, src, n): (i64, i64) {
    var sum = 0;
    var mx = 0;
    var cnt = 0;
    var i = 0;
    while (i < n) {
        if ((i & 3) != 3) {
            var d = load8(px + i) - load8(src + i);
            if (d < 0) { d = -d; }
            sum = sum + d;
            if (d > mx) { mx = d; }
            cnt = cnt + 1;
        }
        i = i + 1;
    }
    if (cnt == 0) { return (0, 0); }
    return (sum * 1000 / cnt, mx);
}

# Prints a mean in thousandths as d.ddd.
fn _par_milli(m): i64 {
    _pc_i(m / 1000);
    _pc_s(".");
    if (m % 1000 < 100) { _pc_s("0"); }
    if (m % 1000 < 10) { _pc_s("0"); }
    _pc_i(m % 1000);
    return 0;
}

# The source pixels of a lossy fixture (tests/golden/fixtures/<file>.source.rgba), or 0 when it has none or their
# size is not n.
fn _par_source(fp, fn_len, n): i64 {
    var path = alloc(fn_len + 16);
    memcpy(path, fp, fn_len);
    memcpy(path + fn_len, ".source.rgba", 12);
    var slen = 0;
    var src = _pc_read(path, fn_len + 12, &slen);
    if (src == 0 || slen != n) { return 0; }
    return src;
}

# One line of the accuracy record: the port's and Rust's error against a fixture's source (px 0: the port refused).
fn _par_accuracy_line(fp, fn_len, pm, px_max, rm, r_max, port_ok): i64 {
    _pc_s("  accuracy ");
    _pc_b(fp + 9, fn_len - 9);
    _pc_s(" vs source:");
    if (port_ok == 1) {
        _pc_s(" port mean ");
        _par_milli(pm);
        _pc_s(" max ");
        _pc_i(px_max);
    } else {
        _pc_s(" port refuses");
    }
    _pc_s(" | rust mean ");
    _par_milli(rm);
    _pc_s(" max ");
    _pc_i(r_max);
    _pc_s("\n");
    return 0;
}

# Records the outcome of a row whose comparison passed (pass = 1) or not, under the known-defect list.
fn _par_gate(pass, known, why): i64 {
    if (pass == 1) {
        if (known != 0) {
            return _pc_record(PC_FAILED, "on the known-defect list but passes: remove it from _par_known");
        }
        return _pc_record(PC_OK, why);
    }
    if (known != 0) { return _pc_record(PC_UPSTREAM, known); }
    return _pc_record(PC_FAILED, why);
}

# The value of a hex token's payload (at most 16 digits), or -1.
fn _par_hex(p, n): i64 {
    var v = 0;
    var i = 0;
    while (i < n) {
        var d = _pc_hexd(load8(p + i));
        if (d < 0) { return -1; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

# One decode row.
fn _par_decode_row(): i64 {
    var tp = 0;
    var tn = 0;
    _pc_tok(2, 0, &tp, &tn);
    if (tn < 11 || memeq(tp, "p:fixtures/", 11) != 1) { return _pc_record(PC_FAILED, "malformed input token"); }
    var len = 0;
    var src = _pc_read(tp + 2, tn - 2, &len);
    if (src == 0 && len < 0) { return _pc_record(PC_FAILED, "fixture unreadable"); }
    var adr = _par_adr();
    var known = _par_known(tp + 11, tn - 11);

    var d = 0;
    var t, v = _sl_decode_image(src, len, &d);
    var port_ok = is_ok(t);

    var op = 0;
    var on = 0;
    _pc_tok(3, 0, &op, &on);
    if (on >= 2 && memeq(op, "E:", 2) == 1) {
        if (port_ok == 1) {
            var img0: *SlImage = _sl_as_image(v);
            var w0 = img0.width;
            var h0 = img0.height;
            SlImage_free(img0);
            return _par_gate(0, known, _par_why5("oracle refuses, port decodes ", w0, "x", h0, ""));
        }
        if (_par_err_is(op, on, v) == 1) { return _par_gate(1, known, "both refuse"); }
        return _par_gate(0, known, "both refuse, with different variants");
    }

    var wp = 0;
    var wn = 0;
    var hp = 0;
    var hn = 0;
    var bp = 0;
    var bn = 0;
    _pc_tok(3, 0, &wp, &wn);
    _pc_tok(3, 1, &hp, &hn);
    _pc_tok(3, 2, &bp, &bn);
    var ow = _pc_int(wp + 2, wn - 2);
    var oh = _pc_int(hp + 2, hn - 2);
    var blen = 0;
    var blob = 0;
    if (memeq(bp, "p:", 2) == 1) {
        blob = _pc_read(bp + 2, bn - 2, &blen);
        if (blob == 0 || blen != ow * oh * 4) {
            return _pc_record(PC_FAILED, "oracle RGBA blob unreadable or the wrong size");
        }
    }
    var srcpx = 0;
    if (blob != 0) { srcpx = _par_source(tp + 2, tn - 2, blen); }

    if (port_ok == 0) {
        if (srcpx != 0) {
            var rm0, rx0 = _par_err_vs(blob, srcpx, blen);
            _par_accuracy_line(tp + 2, tn - 2, 0, 0, rm0, rx0, 0);
        }
        if (adr != 0) {
            if (v == SL_ERR_UNSUPPORTED_FORMAT) { return _pc_record(PC_ACCEPTED, _PAR_ADR_OK); }
            return _pc_record(PC_FAILED, "an ADR 0002 row refused with the wrong variant");
        }
        return _par_gate(0, known, "oracle decodes, port refuses");
    }
    var img: *SlImage = _sl_as_image(v);
    if (adr != 0) {
        SlImage_free(img);
        return _pc_record(PC_FAILED, _par_why5("ADR 0002 #", adr, " says refuse, port decodes", 0, ""));
    }
    if (img.width != ow || img.height != oh) {
        var pw = img.width;
        var ph = img.height;
        SlImage_free(img);
        return _par_gate(0, known, _par_why5("dimensions differ: port ", pw, "x", ph, ""));
    }
    var n = ow * oh * 4;
    var px = img.pixels;

    if (blob == 0) {
        # c:<crc32> in place of the blob.
        crc32_init_table();
        var want = _par_hex(bp + 2, bn - 2);
        var got = crc32(px, n);
        SlImage_free(img);
        return _par_gate(got == want, known, "pixels' CRC-32 differs");
    }

    var cls = load8(_pc_f[2]);
    var mx = 0;
    var diff = 0;
    if (memeq(px, blob, n) != 1) {
        var i = 0;
        while (i < n) {
            var dd = load8(px + i) - load8(blob + i);
            if (dd < 0) { dd = -dd; }
            if (dd != 0) { diff = diff + 1; }
            if (dd > mx) { mx = dd; }
            i = i + 1;
        }
    }
    if (cls == 66) { _pc_hist_add(px, blob, n); }
    if (cls != 66) {
        SlImage_free(img);
        return _par_gate(mx == 0, known, _par_why5("pixels differ: ", diff, " bytes, max |d| ", mx, ""));
    }
    # Class B: accuracy against the source, and conformance with Rust.
    var pass = 1;
    var why = "within K_jpeg";
    if (mx > _PAR_K_JPEG) {
        pass = 0;
        why = _par_why5("conformance: max |d| ", mx, " over K_jpeg ", _PAR_K_JPEG, "");
    }
    if (srcpx != 0) {
        var pm, pmx = _par_err_vs(px, srcpx, n);
        var rm, rmx = _par_err_vs(blob, srcpx, n);
        _par_accuracy_line(tp + 2, tn - 2, pm, pmx, rm, rmx, 1);
        if (pm > rm + _PAR_ACC_MEAN || pmx > rmx + _PAR_ACC_MAX) {
            pass = 0;
            why = _par_why5("accuracy: port mean x1000 ", pm, " vs Rust's ", rm, " (bound +0.050, max +2)");
        }
    }
    SlImage_free(img);
    return _par_gate(pass, known, why);
}

# The ImageFormat of an `e:ImageFormat.<T>` token, or -1.
fn _par_fmt_tok(p, n): i64 {
    if (n == 17 && memeq(p, "e:ImageFormat.Png", 17) == 1) { return SL_FMT_PNG; }
    if (n == 18 && memeq(p, "e:ImageFormat.Jpeg", 18) == 1) { return SL_FMT_JPEG; }
    if (n == 17 && memeq(p, "e:ImageFormat.Bmp", 17) == 1) { return SL_FMT_BMP; }
    if (n == 18 && memeq(p, "e:ImageFormat.WebP", 18) == 1) { return SL_FMT_WEBP; }
    return -1;
}

# One convert_format row: the verdict and the converted image's dimensions (class A).
fn _par_convert_row(): i64 {
    var tp = 0;
    var tn = 0;
    var fp = 0;
    var fnn = 0;
    _pc_tok(2, 0, &tp, &tn);
    _pc_tok(2, 1, &fp, &fnn);
    var fmt = _par_fmt_tok(fp, fnn);
    if (tn < 11 || fmt < 0) { return _pc_record(PC_FAILED, "malformed input tokens"); }
    var len = 0;
    var src = _pc_read(tp + 2, tn - 2, &len);
    if (src == 0 && len < 0) { return _pc_record(PC_FAILED, "fixture unreadable"); }
    var adr = _par_adr();
    var on = 0;
    var t, v = selah_convert_format(src, len, fmt, &on);

    var op = 0;
    var oln = 0;
    _pc_tok(3, 0, &op, &oln);
    if (oln >= 2 && memeq(op, "E:", 2) == 1) {
        if (is_ok(t) == 1) {
            selah_bytes_free(v);
            return _pc_record(PC_FAILED, "oracle refuses, port converts");
        }
        if (_par_err_is(op, oln, v) == 1) { return _pc_record(PC_OK, "both refuse"); }
        return _pc_record(PC_FAILED, "both refuse, with different variants");
    }
    if (is_err_result(t) == 1) {
        if (adr != 0 && v == SL_ERR_UNSUPPORTED_FORMAT) { return _pc_record(PC_ACCEPTED, _PAR_ADR_OK); }
        return _pc_record(PC_FAILED, "oracle converts, port refuses");
    }
    if (adr != 0) {
        selah_bytes_free(v);
        return _pc_record(PC_FAILED, _par_why5("ADR 0002 #", adr, " says refuse, port converts", 0, ""));
    }
    var hp = 0;
    var hn = 0;
    _pc_tok(3, 1, &hp, &hn);
    var ow = _pc_int(op + 2, oln - 2);
    var oh = _pc_int(hp + 2, hn - 2);
    var dt, dv = _sl_decode_image(v, on);
    selah_bytes_free(v);
    if (is_err_result(dt) == 1) { return _pc_record(PC_FAILED, "the port cannot decode its own output"); }
    var img: *SlImage = _sl_as_image(dv);
    var ok = img.width == ow && img.height == oh;
    SlImage_free(img);
    if (ok) { return _pc_record(PC_OK, "dimensions"); }
    return _pc_record(PC_FAILED, "dimensions differ");
}

# ---- class R for JPEG: the encoder against the exact mathematics (port plan §4; port-parity.md §5)
#
# For given quantisation tables the right coefficients are defined: JFIF's YCbCr (Y = 0.299 R + 0.587 G + 0.114 B,
# Cb = (B - Y) / 1.772, Cr = (R - Y) / 1.402), level-shifted, T.81's DCT, divided by Q and rounded to nearest (ties
# away from zero), with the last column and row replicated past the edge. Evaluated here in f64, directly from the
# definition (no factorisation), and compared with what the encoder writes (_sl_jpeg_coeffs, the encoder's own path).
# Bound: every coefficient within 1, and at most 1 % of them off by one (set 2026-11-14).

var _par_jm_total = 0;
var _par_jm_off = 0;

# Returns (coefficients off by one or more, the largest difference); adds to the module totals.
fn _par_jpeg_math(rgba, w, h, quality): (i64, i64) {
    var bw = (w + 7) / 8;
    var bh = (h + 7) / 8;
    var nco = bw * bh * 192;
    var mine = alloc(nco * 8);
    _sl_jpeg_coeffs(rgba, w, h, quality, mine);
    var ql: i64[64];
    var qc: i64[64];
    var dl: i64[64];
    var dc: i64[64];
    _sl_jpeg_tables(quality, &ql, &qc, &dl, &dc);
    # cosm[u * 8 + x] = C(u) / 2 * cos((2x + 1) u pi / 16), C(0) = 1 / sqrt 2.
    var cosm: i64[64];
    var pi: f64 = 3.141592653589793;
    var u = 0;
    while (u < 8) {
        var x = 0;
        while (x < 8) {
            var arg: f64 = f64_from((2 * x + 1) * u);
            arg = arg * pi / 16.0;
            var cv: f64 = f64_cos(arg);
            var cu: f64 = 0.5;
            if (u == 0) { cu = 0.35355339059327373; }
            var val: f64 = cv * cu;
            store64(&cosm + (u * 8 + x) * 8, val);
            x = x + 1;
        }
        u = u + 1;
    }
    var smp: i64[192];
    var tmp: i64[64];
    var off = 0;
    var mx = 0;
    var k = 0;
    var by = 0;
    while (by < h) {
        var bx = 0;
        while (bx < w) {
            var yy = 0;
            while (yy < 8) {
                var sy = by + yy;
                if (sy >= h) { sy = h - 1; }
                var xx = 0;
                while (xx < 8) {
                    var sx = bx + xx;
                    if (sx >= w) { sx = w - 1; }
                    var px = rgba + (sy * w + sx) * 4;
                    var r: f64 = f64_from(load8(px));
                    var g: f64 = f64_from(load8(px + 1));
                    var b: f64 = f64_from(load8(px + 2));
                    var yv: f64 = 0.299 * r + 0.587 * g + 0.114 * b;
                    var cbv: f64 = (b - yv) / 1.772;
                    var crv: f64 = (r - yv) / 1.402;
                    var yl: f64 = yv - 128.0;
                    var o = yy * 8 + xx;
                    store64(&smp + o * 8, yl);
                    store64(&smp + (64 + o) * 8, cbv);
                    store64(&smp + (128 + o) * 8, crv);
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            var comp = 0;
            while (comp < 3) {
                var base = &smp + comp * 512;
                # Rows: tmp[y * 8 + u] = sum_x cosm[u][x] s[y][x].
                var y2 = 0;
                while (y2 < 8) {
                    var uu = 0;
                    while (uu < 8) {
                        var acc: f64 = 0.0;
                        var x2 = 0;
                        while (x2 < 8) {
                            var cw: f64 = load64(&cosm + (uu * 8 + x2) * 8);
                            var sv: f64 = load64(base + (y2 * 8 + x2) * 8);
                            acc = acc + cw * sv;
                            x2 = x2 + 1;
                        }
                        store64(&tmp + (y2 * 8 + uu) * 8, acc);
                        uu = uu + 1;
                    }
                    y2 = y2 + 1;
                }
                # Columns: F[v * 8 + u] = sum_y cosm[v][y] tmp[y][u]; then quantise and compare.
                var v = 0;
                while (v < 8) {
                    var u2 = 0;
                    while (u2 < 8) {
                        var acc2: f64 = 0.0;
                        var y3 = 0;
                        while (y3 < 8) {
                            var cw2: f64 = load64(&cosm + (v * 8 + y3) * 8);
                            var tv: f64 = load64(&tmp + (y3 * 8 + u2) * 8);
                            acc2 = acc2 + cw2 * tv;
                            y3 = y3 + 1;
                        }
                        var idx = v * 8 + u2;
                        var qv = ql[idx];
                        if (comp > 0) { qv = qc[idx]; }
                        var qf: f64 = f64_from(qv);
                        var ratio: f64 = acc2 / qf;
                        var exact = 0;
                        if (ratio >= 0.0) {
                            var fl: f64 = f64_floor(ratio + 0.5);
                            exact = f64_to(fl);
                        } else {
                            var neg: f64 = 0.5 - ratio;
                            var fl2: f64 = f64_floor(neg);
                            exact = -f64_to(fl2);
                        }
                        var got = load64(mine + (k + comp * 64 + idx) * 8);
                        var dd = got - exact;
                        if (dd < 0) { dd = -dd; }
                        if (dd != 0) { off = off + 1; }
                        if (dd > mx) { mx = dd; }
                        u2 = u2 + 1;
                    }
                    v = v + 1;
                }
                comp = comp + 1;
            }
            k = k + 192;
            bx = bx + 8;
        }
        by = by + 8;
    }
    _par_jm_total = _par_jm_total + nco;
    _par_jm_off = _par_jm_off + off;
    return (off, mx);
}

# The port's JPEG against Rust's, decoded pixels against the input (measured, not gated: per image, two correct
# encoders differ by rounding noise; port-parity.md §5): sums of the means, x1000.
var _par_rj_port = 0;
var _par_rj_rust = 0;
var _par_rj_n = 0;

# The reverse oracle's directory (scripts/oracle --reverse): each encoded file beside its pixels and dimensions.
var _par_rev_ready = 0;
var _par_rev_worst = -1000000;

# Writes build/reverse/<file>.<ext> with the encoded bytes, and <file>.rgba / <file>.dims once per file.
fn _par_reverse_write(fp, fn_len, ext, bytes, blen, rgba, n, w, h): i64 {
    if (_par_rev_ready == 0) {
        sys_mkdir("build", 493);
        sys_mkdir("build/reverse", 493);
        _par_rev_ready = 1;
    }
    var base = alloc(fn_len + 32);
    memcpy(base, "build/reverse/", 14);
    memcpy(base + 14, fp, fn_len);
    var e = 14 + fn_len;
    var el = strlen(ext);
    memcpy(base + e, ext, el);
    store8(base + e + el, 0);
    file_write_all(base, bytes, blen);
    memcpy(base + e, ".rgba", 5);
    store8(base + e + 5, 0);
    file_write_all(base, rgba, n);
    var dims: u8[48];
    var dp = &dims;
    var k = fmt_int_buf(w, dp);
    store8(dp + k, 32);
    k = k + 1;
    k = k + fmt_int_buf(h, dp + k);
    store8(dp + k, 10);
    k = k + 1;
    memcpy(base + e, ".dims", 5);
    store8(base + e + 5, 0);
    file_write_all(base, dp, k);
    return 0;
}

# One encode row (class R): the oracle's decoded pixels of a fixture through the port's encoder and back.
fn _par_encode_row(): i64 {
    var bp = 0;
    var bn = 0;
    var wp = 0;
    var wn = 0;
    var hp = 0;
    var hn = 0;
    var fp = 0;
    var fnn = 0;
    _pc_tok(2, 0, &bp, &bn);
    _pc_tok(2, 1, &wp, &wn);
    _pc_tok(2, 2, &hp, &hn);
    _pc_tok(2, 3, &fp, &fnn);
    var fmt = _par_fmt_tok(fp, fnn);
    var w = _pc_int(wp + 2, wn - 2);
    var h = _pc_int(hp + 2, hn - 2);
    if (bn < 9 || fmt < 0 || w <= 0 || h <= 0) { return _pc_record(PC_FAILED, "malformed input tokens"); }
    var n = 0;
    var rgba = _pc_read(bp + 2, bn - 2, &n);
    if (rgba == 0 || n != w * h * 4) { return _pc_record(PC_FAILED, "input pixels unreadable or the wrong size"); }
    var img: *SlImage = _sl_as_image(alloc(sizeof(SlImage)));
    img.width = w;
    img.height = h;
    img.pixels = rgba;
    img.owner = 0;
    var adr = _par_adr();
    var on = 0;
    var t, v = _sl_encode_image(img, fmt, &on);
    if (is_err_result(t) == 1) {
        if (adr != 0 && v == SL_ERR_UNSUPPORTED_FORMAT) { return _pc_record(PC_ACCEPTED, _PAR_ADR_OK); }
        return _pc_record(PC_FAILED, "the port's encoder fails");
    }
    if (adr != 0) {
        selah_bytes_free(v);
        return _pc_record(PC_FAILED, "ADR 0002 says refuse, port encodes");
    }
    # build/reverse/<file without "decode/" and ".rgba">
    var stem = bp + 9;
    var stem_n = bn - 9 - 5;
    var ext = ".png";
    if (fmt == SL_FMT_BMP) { ext = ".bmp"; }
    if (fmt == SL_FMT_JPEG) { ext = ".jpg"; }
    _par_reverse_write(stem, stem_n, ext, v, on, rgba, n, w, h);
    var dt, dv = _sl_decode_image(v, on);
    selah_bytes_free(v);
    if (is_err_result(dt) == 1) { return _pc_record(PC_FAILED, "the port cannot decode its own output"); }
    var back: *SlImage = _sl_as_image(dv);
    if (back.width != w || back.height != h) {
        SlImage_free(back);
        return _pc_record(PC_FAILED, "round trip changes the dimensions");
    }
    if (fmt != SL_FMT_JPEG) {
        var same = memeq(back.pixels, rgba, n);
        SlImage_free(back);
        if (same == 1) { return _pc_record(PC_OK, "lossless"); }
        return _pc_record(PC_FAILED, "lossless round trip changes pixels");
    }
    var pm, pmx = _par_err_vs(back.pixels, rgba, n);
    SlImage_free(back);
    var mp = 0;
    var mn = 0;
    _pc_tok(3, 0, &mp, &mn);
    var rm = _pc_int(mp + 2, mn - 2);
    _par_rj_port = _par_rj_port + pm;
    _par_rj_rust = _par_rj_rust + rm;
    _par_rj_n = _par_rj_n + 1;
    if (pm - rm > _par_rev_worst) { _par_rev_worst = pm - rm; }
    var off, dmx = _par_jpeg_math(rgba, w, h, SL_JPEG_QUALITY);
    var total = ((w + 7) / 8) * ((h + 7) / 8) * 192;
    if (dmx <= 1 && off * 100 <= total) { return _pc_record(PC_OK, "the coefficients agree with the mathematics"); }
    var why = _par_why5("coefficients vs the mathematics: ", off, " off, largest difference ", dmx, "");
    return _pc_record(PC_FAILED, why);
}

# ---------------------------------------------------------------- annotate (M4)
#
# render, to_svg, layer_json, layer_load, decode_image_data and redact_image: all class A. A render row's pixels are
# compared by the CRC-32 of the RGBA; the port draws onto its own decode of the source (each source decoded once and
# copied per row), which is render_to_image without the lossless encode the codec rows already gate.

# The number of tokens in field f.
fn _par_ntok(f): i64 {
    var p = 0;
    var n = 0;
    var k = 0;
    while (_pc_tok(f, k, &p, &n) == 1) { k = k + 1; }
    return k;
}

# Appends "c:<crc32 of p[0..n)>", lowercase hex, 8 digits.
fn _par_put_crc(sb, p, n): i64 {
    crc32_init_table();
    var c = crc32(p, n);
    str_builder_add_cstr(sb, "c:");
    var k = 28;
    while (k >= 0) {
        str_builder_putc(sb, load8("0123456789abcdef" + ((c >> k) & 15)));
        k = k - 4;
    }
    return 0;
}

# An annotation from the render group at input token i: e:kind, four g (Rect::new's arguments), four i (colour).
fn _par_group_ann(i): i64 {
    var kind = _par_enum(i, "e:AnnotationKind.", &_par_kind_name, SL_KIND_FREEFORM);
    return SlAnnotation_new(kind, _par_rect(i + 1), _par_color(i + 5));
}

# An annotation from the full group at input token i: h:id, then a render group, then s:text or N.
fn _par_full_ann(i): i64 {
    var a: *SlAnnotation = _sl_as_annotation(_par_group_ann(i + 1));
    var idl = 0;
    var idb = _par_tok_h(2, i, &idl);
    memcpy(a, idb, 16);
    var tl = 0;
    var tx = _pc_tok_s(2, i + 10, &tl);
    if (tx != 0) { a.text = str_from_buf(tx, tl); }
    return a;
}

# The decoded sources of render rows, cached by fixture: (name pointer, name length, SlImage or 0, error code).
var _par_src_name = 0;
var _par_src_len = 0;
var _par_src_img = 0;
var _par_src_err = 0;

fn _par_render_row(): i64 {
    var nt = _par_ntok(2);
    var groups = (nt - 2) / 9;
    var tp = 0;
    var tn = 0;
    _pc_tok(2, 0, &tp, &tn);
    var anns = vec_new();
    var g = 0;
    while (g < groups) {
        vec_push(anns, _par_group_ann(1 + g * 9));
        g = g + 1;
    }
    var sb = str_builder_new();
    var ct, cv = _sl_render_check(anns);
    if (is_err_result(ct) == 1) {
        str_builder_add_cstr(sb, "E:");
        str_builder_add_cstr(sb, selah_error_name(cv));
    } else {
        if (_par_src_name == 0 || _par_src_len != tn || memeq(_par_src_name, tp, tn) != 1) {
            if (_par_src_img != 0) { SlImage_free(_par_src_img); }
            _par_src_img = 0;
            _par_src_err = 0;
            _par_src_name = tp;
            _par_src_len = tn;
            var len = 0;
            var src = _pc_read(tp + 2, tn - 2, &len);
            var dt, dv = _sl_decode_image(src, len);
            if (is_err_result(dt) == 1) { _par_src_err = dv; } else { _par_src_img = dv; }
        }
        if (_par_src_img == 0) {
            str_builder_add_cstr(sb, "E:");
            str_builder_add_cstr(sb, selah_error_name(_par_src_err));
        } else {
            var base: *SlImage = _sl_as_image(_par_src_img);
            var img: *SlImage = SlImage_new(base.width, base.height);
            var bytes = base.width * base.height * 4;
            memcpy(img.pixels, base.pixels, bytes);
            _sl_draw_all(img, anns);
            _pc_put_i(sb, img.width);
            _pc_sp(sb);
            _pc_put_i(sb, img.height);
            _pc_sp(sb);
            _par_put_crc(sb, img.pixels, bytes);
            SlImage_free(img);
        }
    }
    g = 0;
    while (g < groups) {
        SlAnnotation_free(vec_get(anns, g));
        g = g + 1;
    }
    return _pc_check_out(str_builder_build(sb));
}

# A canvas of i:w i:h with the full groups from input token `from`.
fn _par_canvas(from): *SlAnnotationCanvas {
    var c: *SlAnnotationCanvas = SlAnnotationCanvas_new(_pc_tok_num(2, 0), _pc_tok_num(2, 1));
    var nt = _par_ntok(2);
    var i = from;
    while (i + 11 <= nt) {
        SlAnnotationCanvas_add_annotation(c, _par_full_ann(i));
        i = i + 11;
    }
    return c;
}

fn _par_svg_row(): i64 {
    var c: *SlAnnotationCanvas = _par_canvas(2);
    var svg = SlAnnotationCanvas_to_svg(c);
    SlAnnotationCanvas_free(c);
    var sb = str_builder_new();
    _pc_put_s(sb, str_data(svg), str_len(svg));
    return _pc_check_out(str_builder_build(sb));
}

var _par_layer_seq = 0;

fn _par_layer_json_row(): i64 {
    var c: *SlAnnotationCanvas = _par_canvas(4);
    var kt, kv = _sl_layer_check(c.annotations);
    if (is_err_result(kt) == 1) {
        SlAnnotationCanvas_free(c);
        var eb = str_builder_new();
        str_builder_add_cstr(eb, "E:");
        str_builder_add_cstr(eb, selah_error_name(kv));
        return _pc_check_out(str_builder_build(eb));
    }
    var js = str_builder_new();
    _sl_layer_json(js, c.width, c.height, c.annotations, _pc_tok_num(2, 2), _pc_tok_num(2, 3));
    # For the reverse oracle: build/reverse/layer-<n>.layer.json beside layer-<n>.layer.dims (width height count).
    var dims = str_builder_new();
    str_builder_add_int(dims, c.width);
    str_builder_putc(dims, 32);
    str_builder_add_int(dims, c.height);
    str_builder_putc(dims, 32);
    str_builder_add_int(dims, SlAnnotationCanvas_count(c));
    str_builder_putc(dims, 10);
    var ds = str_builder_build(dims);
    SlAnnotationCanvas_free(c);
    var json = str_builder_build(js);
    if (_par_rev_ready == 0) {
        sys_mkdir("build", 493);
        sys_mkdir("build/reverse", 493);
        _par_rev_ready = 1;
    }
    var nb = str_builder_new();
    str_builder_add_cstr(nb, "build/reverse/layer-");
    str_builder_add_int(nb, _par_layer_seq);
    str_builder_add_cstr(nb, ".layer.json");
    var jpath = str_builder_build(nb);
    file_write_all(str_data(jpath), str_data(json), str_len(json));
    memcpy(str_data(jpath) + str_len(jpath) - 4, "dims", 4);
    file_write_all(str_data(jpath), str_data(ds), str_len(ds));
    _par_layer_seq = _par_layer_seq + 1;
    var sb = str_builder_new();
    _pc_put_s(sb, str_data(json), str_len(json));
    return _pc_check_out(str_builder_build(sb));
}

fn _par_layer_load_row(): i64 {
    var jl = 0;
    var jp = _pc_tok_s(2, 0, &jl);
    var sb = str_builder_new();
    var t, v = _sl_canvas_from_layer_json(jp, jl);
    if (is_err_result(t) == 1) {
        str_builder_add_cstr(sb, "E:");
        str_builder_add_cstr(sb, selah_error_name(v));
        return _pc_check_out(str_builder_build(sb));
    }
    var c: *SlAnnotationCanvas = _sl_as_canvas(v);
    _pc_put_i(sb, c.width);
    _pc_sp(sb);
    _pc_put_i(sb, c.height);
    _pc_sp(sb);
    _pc_put_i(sb, SlAnnotationCanvas_count(c));
    var i = 0;
    while (i < SlAnnotationCanvas_count(c)) {
        var ab = str_builder_new();
        SlAnnotation_to_json(_sl_as_annotation(vec_get(c.annotations, i)), ab);
        var aj = str_builder_build(ab);
        _pc_sp(sb);
        _pc_put_s(sb, str_data(aj), str_len(aj));
        i = i + 1;
    }
    SlAnnotationCanvas_free(c);
    return _pc_check_out(str_builder_build(sb));
}

fn _par_decode_data_row(): i64 {
    var bl = 0;
    var bp = _pc_tok_s(2, 0, &bl);
    var sb = str_builder_new();
    var on = 0;
    var t, v = selah_decode_image_data(bp, bl, &on);
    if (is_err_result(t) == 1) {
        str_builder_add_cstr(sb, "E:");
        str_builder_add_cstr(sb, selah_error_name(v));
    } else {
        _pc_put_h(sb, v, on);
        selah_bytes_free(v);
    }
    return _pc_check_out(str_builder_build(sb));
}

fn _par_redact_row(): i64 {
    var tp = 0;
    var tn = 0;
    _pc_tok(2, 0, &tp, &tn);
    var len = 0;
    var src = _pc_read(tp + 2, tn - 2, &len);
    var nt = _par_ntok(2);
    var targets = 0;
    if (_par_tok_is(2, 1, "N") == 0) {
        targets = vec_new();
        var k = 1;
        while (k < nt - 1) {
            var sl = 0;
            var sp = _pc_tok_s(2, k, &sl);
            var tgt: *SlRedactionTarget = _sl_as_target(alloc(sizeof(SlRedactionTarget)));
            SlRedactionTarget_from_json(sp, sl, tgt);
            vec_push(targets, tgt);
            k = k + 1;
        }
    }
    var adr = _par_adr();
    var known = _par_known(tp + 11, tn - 11);
    var on = 0;
    var sugg = 0;
    var t, v = selah_redact_image(src, len, targets, SL_FMT_PNG, &on, &sugg);
    var sb = str_builder_new();
    if (is_err_result(t) == 1) {
        if (adr != 0 && v == SL_ERR_UNSUPPORTED_FORMAT) { return _pc_record(PC_ACCEPTED, _PAR_ADR_OK); }
        str_builder_add_cstr(sb, "E:");
        str_builder_add_cstr(sb, selah_error_name(v));
        return _pc_check_out(str_builder_build(sb));
    }
    var dt, dv = _sl_decode_image(v, on);
    selah_bytes_free(v);
    if (is_err_result(dt) == 1) { return _pc_record(PC_FAILED, "the port cannot decode its own output"); }
    var img: *SlImage = _sl_as_image(dv);
    _pc_put_i(sb, img.width);
    _pc_sp(sb);
    _pc_put_i(sb, img.height);
    _pc_sp(sb);
    _par_put_crc(sb, img.pixels, img.width * img.height * 4);
    _pc_sp(sb);
    _pc_put_i(sb, vec_len(sugg));
    SlImage_free(img);
    var actual = str_builder_build(sb);
    if (known == 0) { return _pc_check_out(actual); }
    var same = str_len(actual) == _pc_f[7] && memeq(str_data(actual), _pc_f[6], _pc_f[7]) == 1;
    return _par_gate(same, known, _pc_diff_msg(str_data(actual), str_len(actual)));
}

# ---------------------------------------------------------------- M1 helpers

# An f32 from its bits.
fn _par_f32(bits, out: *f32): i64 {
    store32(out, bits);
    return 0;
}

# The rect Rect::new builds from the four g tokens starting at token i of the inputs.
fn _par_rect(i): SlRect {
    var x: f32 = f32_from(0.0);
    var y: f32 = f32_from(0.0);
    var w: f32 = f32_from(0.0);
    var h: f32 = f32_from(0.0);
    _par_f32(_pc_tok_num(2, i), &x);
    _par_f32(_pc_tok_num(2, i + 1), &y);
    _par_f32(_pc_tok_num(2, i + 2), &w);
    _par_f32(_pc_tok_num(2, i + 3), &h);
    return SlRect_new(x, y, w, h);
}

# Writes a rect's layout as four g tokens.
fn _par_put_layout(sb, r: SlRect): i64 {
    _pc_put_g(sb, _sl_f32_bits(r.min_x));
    _pc_sp(sb);
    _pc_put_g(sb, _sl_f32_bits(r.min_y));
    _pc_sp(sb);
    _pc_put_g(sb, _sl_f32_bits(r.max_x));
    _pc_sp(sb);
    _pc_put_g(sb, _sl_f32_bits(r.max_y));
    return 0;
}

# Writes an f64 holding an exact f32 as a g token.
fn _par_put_g64(sb, d: f64): i64 {
    var x: f32 = f32_from(d);
    return _pc_put_g(sb, _sl_f32_bits(x));
}

# Writes E:<variant> s:<detail> for a refused Result (detail a Str or 0).
fn _par_put_err(sb, code, detail): i64 {
    str_builder_add_cstr(sb, "E:");
    str_builder_add_cstr(sb, selah_error_name(code));
    _pc_sp(sb);
    return _pc_put_sstr(sb, detail);
}

# 1 when token i of field f is exactly the NUL-terminated text.
fn _par_tok_is(f, i, text): i64 {
    var p = 0;
    var n = 0;
    if (_pc_tok(f, i, &p, &n) == 0) { return 0; }
    return n == strlen(text) && memeq(p, text, n) == 1;
}

# The enum value named by the e: token i of the inputs, through `name_of` (value → serde name) over 0..=last.
fn _par_enum(i, prefix, name_of, last): i64 {
    var p = 0;
    var n = 0;
    _pc_tok(2, i, &p, &n);
    var pl = strlen(prefix);
    var v = 0;
    while (v <= last) {
        var nm = fncall1(name_of, v);
        if (n == pl + strlen(nm) && memeq(p, prefix, pl) == 1 && memeq(p + pl, nm, strlen(nm)) == 1) { return v; }
        v = v + 1;
    }
    return -1;
}

fn _par_kind_name(k): i64 { return _sl_kind_serde_name(k); }
fn _par_format_name(f): i64 { return _sl_format_serde_name(f); }

# ---------------------------------------------------------------- error, fmtf

fn _par_error_row(): i64 {
    if (_pc_fn_is("SelahError::fmt") == 0) { return _pc_record(PC_PENDING, "no dispatcher"); }
    var code = SL_ERR_NONE;
    var k = 1;
    while (k <= SL_ERR_API) {
        var nm = alloc(40);
        memcpy(nm, "E:", 2);
        memcpy(nm + 2, selah_error_name(k), strlen(selah_error_name(k)) + 1);
        if (_par_tok_is(2, 0, nm) == 1) { code = k; }
        k = k + 1;
    }
    var ml = 0;
    var m = _pc_tok_s(2, 1, &ml);
    var out = str_builder_new();
    var sb = str_builder_new();
    selah_error_fmt(sb, code, str_new(m, ml));
    var shown = str_builder_build(sb);
    _pc_put_sstr(out, shown);
    return _pc_check_out(str_builder_build(out));
}

fn _par_fmtf_row(): i64 {
    var sb = str_builder_new();
    var bits = _pc_tok_num(2, 0);
    if (_pc_fn_is("f32::fmt") == 1 || _pc_fn_is("f32::to_json") == 1) {
        var x: f32 = f32_from(0.0);
        _par_f32(bits, &x);
        if (_pc_fn_is("f32::fmt") == 1) { _sl_fmt_f32_display(sb, x); } else { _sl_fmt_f32_json(sb, x); }
    } elif (_pc_fn_is("f64::fmt") == 1 || _pc_fn_is("f64::to_json") == 1) {
        var d: f64 = 0.0;
        store64(&d, bits);
        if (_pc_fn_is("f64::fmt") == 1) { _sl_fmt_f64_display(sb, d); } else { _sl_fmt_f64_json(sb, d); }
    } else {
        return _pc_record(PC_PENDING, "no dispatcher");
    }
    var text = str_builder_build(sb);
    var out = str_builder_new();
    _pc_put_sstr(out, text);
    return _pc_check_out(str_builder_build(out));
}

# ---------------------------------------------------------------- geometry

fn _par_geometry_row(): i64 {
    var out = str_builder_new();
    if (_pc_fn_is("Rect::from_json") == 1) {
        var n = 0;
        var doc = _pc_tok_s(2, 0, &n);
        var r: SlRect = SlRect_default();
        var t, v = SlRect_from_json(doc, n, &r);
        if (is_err_result(t) == 1) { _pc_put_raw(out, "E:serde"); } else { _par_put_layout(out, r); }
        return _pc_check_out(str_builder_build(out));
    }
    var r = _par_rect(0);
    if (_pc_fn_is("Rect::new") == 1) { _par_put_layout(out, r); }
    elif (_pc_fn_is("Rect::x") == 1) { _par_put_g64(out, r.x()); }
    elif (_pc_fn_is("Rect::y") == 1) { _par_put_g64(out, r.y()); }
    elif (_pc_fn_is("Rect::width") == 1) { _par_put_g64(out, r.width()); }
    elif (_pc_fn_is("Rect::height") == 1) { _par_put_g64(out, r.height()); }
    elif (_pc_fn_is("Rect::area") == 1) { _par_put_g64(out, r.area()); }
    elif (_pc_fn_is("Rect::center") == 1) {
        var c = r.center();
        _pc_put_g(out, _sl_f32_bits(c.x));
        _pc_sp(out);
        _pc_put_g(out, _sl_f32_bits(c.y));
    }
    elif (_pc_fn_is("Rect::is_finite") == 1) { _pc_put_b(out, r.is_finite()); }
    elif (_pc_fn_is("Rect::normalized") == 1) { _par_put_layout(out, r.normalized()); }
    elif (_pc_fn_is("Rect::contains_point") == 1) {
        var px: f32 = f32_from(0.0);
        var py: f32 = f32_from(0.0);
        _par_f32(_pc_tok_num(2, 4), &px);
        _par_f32(_pc_tok_num(2, 5), &py);
        _pc_put_b(out, r.contains_point(SlVec2_new(px, py)));
    }
    elif (_pc_fn_is("Rect::intersects") == 1) {
        var o = _par_rect(4);
        _pc_put_b(out, r.intersects(&o));
    }
    elif (_pc_fn_is("Rect::to_json") == 1) {
        var sb = str_builder_new();
        r.to_json(sb);
        _pc_put_sstr(out, str_builder_build(sb));
    }
    else { return _pc_record(PC_PENDING, "no dispatcher"); }
    return _pc_check_out(str_builder_build(out));
}

# ---------------------------------------------------------------- core

# The colour from i tokens i..i+3 of the inputs.
fn _par_color(i): SlColor {
    return SlColor_new(_pc_tok_num(2, i), _pc_tok_num(2, i + 1), _pc_tok_num(2, i + 2), _pc_tok_num(2, i + 3));
}

fn _par_put_color(sb, c: SlColor): i64 {
    _pc_put_i(sb, c.r);
    _pc_sp(sb);
    _pc_put_i(sb, c.g);
    _pc_sp(sb);
    _pc_put_i(sb, c.b);
    _pc_sp(sb);
    _pc_put_i(sb, c.a);
    return 0;
}

# The redaction target from the e: token (and s: label) at the inputs' start.
fn _par_target(): SlRedactionTarget {
    var names: i64[5];
    names[0] = "e:RedactionTarget.Email";
    names[1] = "e:RedactionTarget.Phone";
    names[2] = "e:RedactionTarget.CreditCard";
    names[3] = "e:RedactionTarget.IpAddress";
    names[4] = "e:RedactionTarget.Custom";
    var k = 0;
    while (k < 5) {
        if (_par_tok_is(2, 0, names[k]) == 1) { break; }
        k = k + 1;
    }
    var label = 0;
    if (k == SL_TARGET_CUSTOM) {
        var n = 0;
        var p = _pc_tok_s(2, 1, &n);
        label = str_new(p, n);
    }
    return SlRedactionTarget_new(k, label);
}

fn _par_put_target(sb, t: SlRedactionTarget): i64 {
    if (t.kind == SL_TARGET_EMAIL) { _pc_put_raw(sb, "e:RedactionTarget.Email"); }
    elif (t.kind == SL_TARGET_PHONE) { _pc_put_raw(sb, "e:RedactionTarget.Phone"); }
    elif (t.kind == SL_TARGET_CREDIT_CARD) { _pc_put_raw(sb, "e:RedactionTarget.CreditCard"); }
    elif (t.kind == SL_TARGET_IP_ADDRESS) { _pc_put_raw(sb, "e:RedactionTarget.IpAddress"); }
    else {
        _pc_put_raw(sb, "e:RedactionTarget.Custom ");
        _pc_put_sstr(sb, t.custom);
    }
    return 0;
}

fn _par_put_annotation(sb, a: *SlAnnotation): i64 {
    _pc_put_h(sb, _sl_addr(a), 16);
    _pc_sp(sb);
    _pc_put_raw(sb, "e:AnnotationKind.");
    _pc_put_raw(sb, _sl_kind_serde_name(a.kind));
    _pc_sp(sb);
    _par_put_layout(sb, a.position);
    _pc_sp(sb);
    _par_put_color(sb, a.color);
    _pc_sp(sb);
    if (a.text == 0) { _pc_put_raw(sb, "N"); } else { _pc_put_sstr(sb, a.text); }
    return 0;
}

fn _par_core_row(): i64 {
    var out = str_builder_new();
    var sb = str_builder_new();
    var n = 0;
    if (_pc_fn_is("AnnotationKind::fmt") == 1) {
        selah_annotation_kind_fmt(sb, _par_enum(0, "e:AnnotationKind.", &_par_kind_name, SL_KIND_FREEFORM));
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("AnnotationKind::to_json") == 1) {
        selah_annotation_kind_to_json(sb, _par_enum(0, "e:AnnotationKind.", &_par_kind_name, SL_KIND_FREEFORM));
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("AnnotationKind::from_str") == 1) {
        var s = _pc_tok_s(2, 0, &n);
        var detail = 0;
        var t, k = selah_annotation_kind_parse(s, n, &detail);
        if (is_err_result(t) == 1) { _par_put_err(out, k, detail); }
        else { _pc_put_raw(out, "e:AnnotationKind."); _pc_put_raw(out, _sl_kind_serde_name(k)); }
    } elif (_pc_fn_is("AnnotationKind::from_json") == 1) {
        var s2 = _pc_tok_s(2, 0, &n);
        var t2, k2 = selah_annotation_kind_from_json(s2, n);
        if (is_err_result(t2) == 1) { _pc_put_raw(out, "E:serde"); }
        else { _pc_put_raw(out, "e:AnnotationKind."); _pc_put_raw(out, _sl_kind_serde_name(k2)); }
    } elif (_pc_fn_is("ImageFormat::extension") == 1) {
        var f = _par_enum(0, "e:ImageFormat.", &_par_format_name, SL_FMT_WEBP);
        var e = selah_image_format_extension(f);
        _pc_put_s(out, e, strlen(e));
    } elif (_pc_fn_is("ImageFormat::mime_type") == 1) {
        var f2 = _par_enum(0, "e:ImageFormat.", &_par_format_name, SL_FMT_WEBP);
        var mt = selah_image_format_mime_type(f2);
        _pc_put_s(out, mt, strlen(mt));
    } elif (_pc_fn_is("ImageFormat::fmt") == 1) {
        selah_image_format_fmt(sb, _par_enum(0, "e:ImageFormat.", &_par_format_name, SL_FMT_WEBP));
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("ImageFormat::to_json") == 1) {
        selah_image_format_to_json(sb, _par_enum(0, "e:ImageFormat.", &_par_format_name, SL_FMT_WEBP));
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("ImageFormat::from_str") == 1) {
        var s3 = _pc_tok_s(2, 0, &n);
        var d3 = 0;
        var t3, f3 = selah_image_format_parse(s3, n, &d3);
        if (is_err_result(t3) == 1) { _par_put_err(out, f3, d3); }
        else { _pc_put_raw(out, "e:ImageFormat."); _pc_put_raw(out, _sl_format_serde_name(f3)); }
    } elif (_pc_fn_is("ImageFormat::from_path") == 1) {
        var s4 = _pc_tok_s(2, 0, &n);
        var t4, f4 = selah_image_format_from_path(s4, n);
        if (is_none(t4) == 1) { _pc_put_raw(out, "N"); }
        else { _pc_put_raw(out, "e:ImageFormat."); _pc_put_raw(out, _sl_format_serde_name(f4)); }
    } elif (_pc_fn_is("ImageFormat::from_json") == 1) {
        var s5 = _pc_tok_s(2, 0, &n);
        var t5, f5 = selah_image_format_from_json(s5, n);
        if (is_err_result(t5) == 1) { _pc_put_raw(out, "E:serde"); }
        else { _pc_put_raw(out, "e:ImageFormat."); _pc_put_raw(out, _sl_format_serde_name(f5)); }
    } elif (_pc_fn_is("xml_escape") == 1) {
        var s6 = _pc_tok_s(2, 0, &n);
        _pc_put_sstr(out, selah_xml_escape(s6, n));
    } elif (_pc_fn_is("derive_output_path") == 1) {
        var s7 = _pc_tok_s(2, 0, &n);
        var sn = 0;
        var suf = _pc_tok_s(2, 1, &sn);
        _pc_put_sstr(out, selah_derive_output_path(s7, n, suf, sn));
    } elif (_pc_fn_is("Color::fmt") == 1) {
        var c = _par_color(0);
        c.fmt(sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("Color::to_css") == 1) {
        var c2 = _par_color(0);
        _pc_put_sstr(out, c2.to_css());
    } elif (_pc_fn_is("Color::to_json") == 1) {
        var c3 = _par_color(0);
        c3.to_json(sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("Color::from_json") == 1) {
        var s8 = _pc_tok_s(2, 0, &n);
        var col: SlColor = SlColor_default();
        var t8, v8 = SlColor_from_json(s8, n, &col);
        if (is_err_result(t8) == 1) { _pc_put_raw(out, "E:serde"); } else { _par_put_color(out, col); }
    } elif (_pc_fn_is("RedactionTarget::fmt") == 1) {
        var tg = _par_target();
        tg.fmt(sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("RedactionTarget::key") == 1) {
        var tg2 = _par_target();
        var ky = tg2.key();
        _pc_put_s(out, ky, strlen(ky));
    } elif (_pc_fn_is("RedactionTarget::to_json") == 1) {
        var tg3 = _par_target();
        tg3.to_json(sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("RedactionTarget::from_json") == 1) {
        var s9 = _pc_tok_s(2, 0, &n);
        var tgt: SlRedactionTarget = SlRedactionTarget_new(0, 0);
        var t9, v9 = SlRedactionTarget_from_json(s9, n, &tgt);
        if (is_err_result(t9) == 1) { _pc_put_raw(out, "E:serde"); } else { _par_put_target(out, tgt); }
    } elif (_pc_fn_is("CaptureSource::fmt") == 1) {
        var src: SlCaptureSource;
        src.kind = SL_SOURCE_FULL_SCREEN;
        src.window = 0;
        src.region = SlRect_default();
        if (_par_tok_is(2, 0, "e:CaptureSource.Window") == 1) {
            src.kind = SL_SOURCE_WINDOW;
            var wp = _pc_tok_s(2, 1, &n);
            src.window = str_new(wp, n);
        } elif (_par_tok_is(2, 0, "e:CaptureSource.Region") == 1) {
            src.kind = SL_SOURCE_REGION;
            src.region = _par_rect(1);
        }
        src.fmt(sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("Annotation::to_json") == 1) {
        var a: *SlAnnotation = _sl_as_annotation(alloc(sizeof(SlAnnotation)));
        var hp = 0;
        var hn = 0;
        _pc_tok(2, 0, &hp, &hn);
        var hi = 0;
        while (hi < 16) {
            store8(_sl_addr(a) + hi, _pc_hex(hp + 2 + hi * 2, 2));
            hi = hi + 1;
        }
        a.kind = _par_enum(1, "e:AnnotationKind.", &_par_kind_name, SL_KIND_FREEFORM);
        var lay: SlRect = SlRect_default();
        store32(_sl_addr(&lay), _pc_tok_num(2, 2));
        store32(_sl_addr(&lay) + 4, _pc_tok_num(2, 3));
        store32(_sl_addr(&lay) + 8, _pc_tok_num(2, 4));
        store32(_sl_addr(&lay) + 12, _pc_tok_num(2, 5));
        a.position = lay;
        a.color = _par_color(6);
        a.text = 0;
        if (_par_tok_is(2, 10, "N") == 0) {
            var tp = _pc_tok_s(2, 10, &n);
            a.text = str_new(tp, n);
        }
        SlAnnotation_to_json(a, sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("Annotation::from_json") == 1) {
        var s10 = _pc_tok_s(2, 0, &n);
        var t10, a10 = SlAnnotation_from_json(s10, n);
        if (is_err_result(t10) == 1) { _pc_put_raw(out, "E:serde"); } else { _par_put_annotation(out, a10); }
    } else {
        return _pc_record(PC_PENDING, "no dispatcher");
    }
    return _pc_check_out(str_builder_build(out));
}

# ---------------------------------------------------------------- uuid, rfc3339

fn _par_uuid_row(): i64 {
    var out = str_builder_new();
    var sb = str_builder_new();
    var n = 0;
    if (_pc_fn_is("Uuid::from_json") == 1) {
        var doc = _pc_tok_s(2, 0, &n);
        var s = _sl_json_as_str(_sl_json_parse(doc, n));
        var b: u8[16];
        if (s == 0 || _sl_uuid_parse(str_data(s), str_len(s), &b) == 0) { _pc_put_raw(out, "E:serde"); }
        else { _pc_put_h(out, &b, 16); }
        return _pc_check_out(str_builder_build(out));
    }
    var hp = 0;
    var hn = 0;
    _pc_tok(2, 0, &hp, &hn);
    var id: u8[16];
    var i = 0;
    while (i < 16) {
        store8(&id + i, _pc_hex(hp + 2 + i * 2, 2));
        i = i + 1;
    }
    if (_pc_fn_is("Uuid::fmt") == 1) { _sl_uuid_fmt(sb, &id, 1); }
    elif (_pc_fn_is("Uuid::simple") == 1) { _sl_uuid_fmt(sb, &id, 0); }
    elif (_pc_fn_is("Uuid::to_json") == 1) {
        str_builder_putc(sb, 34);
        _sl_uuid_fmt(sb, &id, 1);
        str_builder_putc(sb, 34);
    } else {
        return _pc_record(PC_PENDING, "no dispatcher");
    }
    _pc_put_sstr(out, str_builder_build(sb));
    return _pc_check_out(str_builder_build(out));
}

fn _par_rfc3339_row(): i64 {
    var out = str_builder_new();
    if (_pc_fn_is("DateTime::to_json") == 1) {
        var sb = str_builder_new();
        str_builder_putc(sb, 34);
        _sl_rfc3339_fmt(sb, _pc_tok_num(2, 0), _pc_tok_num(2, 1));
        str_builder_putc(sb, 34);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("DateTime::from_json") == 1) {
        var n = 0;
        var doc = _pc_tok_s(2, 0, &n);
        var s = _sl_json_as_str(_sl_json_parse(doc, n));
        var secs = 0;
        var nanos = 0;
        if (s == 0 || _sl_rfc3339_parse(str_data(s), str_len(s), &secs, &nanos) == 0) { _pc_put_raw(out, "E:serde"); }
        else {
            _pc_put_i(out, secs);
            _pc_sp(out);
            _pc_put_i(out, nanos);
        }
    } else {
        return _pc_record(PC_PENDING, "no dispatcher");
    }
    return _pc_check_out(str_builder_build(out));
}

# ---------------------------------------------------------------- ai

# Decode an h: token (field f, token i) into a fresh buffer; stores its length.
fn _par_tok_h(f, i, len_out): i64 {
    var p = 0;
    var n = 0;
    _pc_tok(f, i, &p, &n);
    var bytes = (n - 2) / 2;
    var buf = alloc(bytes + 1);
    var k = 0;
    while (k < bytes) {
        store8(buf + k, _pc_hex(p + 2 + k * 2, 2));
        k = k + 1;
    }
    store64(len_out, bytes);
    return buf;
}

fn _par_put_target_kind(sb, kind): i64 {
    var t = SlRedactionTarget_new(kind, 0);
    return _par_put_target(sb, t);
}

# The rect whose layout is the four g tokens from token i of the inputs.
fn _par_layout_at(i): SlRect {
    var r: SlRect = SlRect_default();
    store32(_sl_addr(&r), _pc_tok_num(2, i));
    store32(_sl_addr(&r) + 4, _pc_tok_num(2, i + 1));
    store32(_sl_addr(&r) + 8, _pc_tok_num(2, i + 2));
    store32(_sl_addr(&r) + 12, _pc_tok_num(2, i + 3));
    return r;
}

fn _par_put_ocr(sb, o: *SlOcrResult): i64 {
    _pc_put_sstr(sb, o.text);
    _pc_sp(sb);
    _pc_put_f(sb, o.confidence);
    _pc_sp(sb);
    var nb = vec_len(o.bounding_boxes);
    _pc_put_i(sb, nb);
    var i = 0;
    while (i < nb) {
        _pc_sp(sb);
        var r: *SlRect = _sl_as_rect(vec_get(o.bounding_boxes, i));
        _par_put_layout(sb, *r);
        i = i + 1;
    }
    _pc_sp(sb);
    _pc_put_b(sb, o.is_stub);
    return 0;
}

fn _par_ai_row(): i64 {
    var out = str_builder_new();
    var sb = str_builder_new();
    var n = 0;
    if (_pc_fn_is("extract_text_regions") == 1) {
        var data = _par_tok_h(2, 0, &n);
        var o: *SlOcrResult = selah_extract_text_regions(data, n);
        _pc_put_sstr(out, o.text);
        _pc_sp(out);
        _pc_put_f(out, o.confidence);
        _pc_sp(out);
        _pc_put_b(out, o.is_stub);
    } elif (_pc_fn_is("suggest_redactions") == 1) {
        var text = _pc_tok_s(2, 0, &n);
        var v = selah_suggest_redactions(text, n);
        _pc_put_i(out, vec_len(v));
        var i = 0;
        while (i < vec_len(v)) {
            var g: *SlRedactionSuggestion = _sl_as_suggestion(vec_get(v, i));
            _pc_sp(out);
            _par_put_target_kind(out, g.target.kind);
            _pc_sp(out);
            _pc_put_sstr(out, g.matched_text);
            _pc_sp(out);
            _pc_put_f(out, g.confidence);
            i = i + 1;
        }
    } elif (_pc_fn_is("RedactionSuggestion::to_json") == 1) {
        var text2 = _pc_tok_s(2, 0, &n);
        var v2 = selah_suggest_redactions(text2, n);
        var k = _pc_tok_num(2, 1);
        if (k < vec_len(v2)) { SlRedactionSuggestion_to_json(_sl_as_suggestion(vec_get(v2, k)), sb); }
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("suggest_smart_crop") == 1) {
        var v3 = selah_suggest_smart_crop(_pc_tok_num(2, 0), _pc_tok_num(2, 1));
        _pc_put_i(out, vec_len(v3));
        var j = 0;
        while (j < vec_len(v3)) {
            var c: *SlSmartCropSuggestion = _sl_as_crop(vec_get(v3, j));
            _pc_sp(out);
            _par_put_layout(out, c.region);
            _pc_sp(out);
            _pc_put_sstr(out, c.reason);
            _pc_sp(out);
            _pc_put_f(out, c.confidence);
            j = j + 1;
        }
    } elif (_pc_fn_is("SmartCropSuggestion::to_json") == 1) {
        var c2: *SlSmartCropSuggestion = _sl_as_crop(alloc(sizeof(SlSmartCropSuggestion)));
        c2.region = _par_layout_at(0);
        var rp = _pc_tok_s(2, 4, &n);
        c2.reason = str_new(rp, n);
        c2.confidence = _pc_tok_num(2, 5);
        SlSmartCropSuggestion_to_json(c2, sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("char::is_alphanumeric") == 1) {
        _pc_put_b(out, _sl_is_alnum(_pc_tok_num(2, 0)));
    } elif (_pc_fn_is("OcrResult::to_json") == 1) {
        var o2: *SlOcrResult = _sl_as_ocr(alloc(sizeof(SlOcrResult)));
        var tp = _pc_tok_s(2, 0, &n);
        o2.text = str_new(tp, n);
        o2.confidence = _pc_tok_num(2, 1);
        var nb = _pc_tok_num(2, 2);
        o2.bounding_boxes = vec_new();
        var q = 0;
        while (q < nb) {
            var r: *SlRect = _sl_as_rect(alloc(sizeof(SlRect)));
            *r = _par_layout_at(3 + q * 4);
            vec_push(o2.bounding_boxes, r);
            q = q + 1;
        }
        o2.is_stub = _pc_tok_num(2, 3 + nb * 4);
        SlOcrResult_to_json(o2, sb);
        _pc_put_sstr(out, str_builder_build(sb));
    } elif (_pc_fn_is("OcrResult::from_json") == 1) {
        var doc = _pc_tok_s(2, 0, &n);
        var t, o3 = SlOcrResult_from_json(doc, n);
        if (is_err_result(t) == 1) { _pc_put_raw(out, "E:serde"); } else { _par_put_ocr(out, o3); }
    } else {
        return _pc_record(PC_PENDING, "no dispatcher");
    }
    return _pc_check_out(str_builder_build(out));
}

# ---------------------------------------------------------------- system (M5)

# The bytes of h: input token i, NUL-terminated (fresh buffer); stores the length.
fn _par_in_h(i, len_out): i64 {
    var n = 0;
    var b = _par_tok_h(2, i, &n);
    var c = alloc(n + 1);
    if (n > 0) { memcpy(c, b, n); }
    store8(c + n, 0);
    store64(len_out, n);
    return c;
}

# Writes E:<variant> s:<Rust's Display of the error>; with `prefix` 1, the text is cut just after "invalid response"
# (the rest of that message is serde's, ADR 0002 #14).
fn _par_put_err_text(sb, code, d, prefix): i64 {
    str_builder_add_cstr(sb, "E:");
    str_builder_add_cstr(sb, selah_error_name(code));
    _pc_sp(sb);
    var msg = selah_error_display(code, d);
    var n = str_len(msg);
    if (prefix == 1) {
        var p = str_data(msg);
        var i = 0;
        while (i + 16 <= n) {
            if (memeq(p + i, "invalid response", 16) == 1) {
                n = i + 16;
                break;
            }
            i = i + 1;
        }
    }
    return _pc_put_s(sb, str_data(msg), n);
}

# Writes a history entry's tokens: h:<id> s:<path> i:<secs> i:<nanos> s:<source> i:<w> i:<h> s:<format>.
fn _par_put_entry(sb, e: *SlHistoryEntry): i64 {
    _pc_put_h(sb, e, 16);
    _pc_sp(sb);
    _pc_put_sstr(sb, e.path);
    _pc_sp(sb);
    _pc_put_i(sb, e.secs);
    _pc_sp(sb);
    _pc_put_i(sb, e.nanos);
    _pc_sp(sb);
    _pc_put_sstr(sb, e.source);
    _pc_sp(sb);
    _pc_put_i(sb, e.width);
    _pc_sp(sb);
    _pc_put_i(sb, e.height);
    _pc_sp(sb);
    return _pc_put_sstr(sb, e.format);
}

# A row tagged adr=0002#21 passes as accepted when the port refuses the document (bayan refuses a duplicate key, a lone
# surrogate or invalid UTF-8 in a member serde ignores). Returns 1 when it handled the row.
fn _par_adr21(out): i64 {
    if (_par_adr() != 21) { return 0; }
    var s = str_builder_build(out);
    if (str_len(s) >= 7 && memeq(str_data(s), "E:", 2) == 1) {
        _pc_record(PC_ACCEPTED, "ADR 0002 #21: bayan refuses what serde ignores");
        return 1;
    }
    _pc_record(PC_FAILED, "ADR 0002 #21 row: the port accepted it");
    return 1;
}

fn _par_history_line_row(): i64 {
    var n = 0;
    var line = _par_in_h(0, &n);
    var tp, tn = _sl_trim_ascii(line, n);
    var out = str_builder_new();
    var t, v = SlHistoryEntry_from_json(tp, tn);
    if (is_ok(t) == 1) {
        _par_put_entry(out, v);
    } else {
        str_builder_add_cstr(out, "E:serde");
    }
    if (_par_adr21(out) == 1) { return 0; }
    return _pc_check_out(str_builder_build(out));
}

fn _par_history_id_row(): i64 {
    var n = 0;
    var line = _par_in_h(0, &n);
    var out = str_builder_new();
    var id: u8[16];
    if (_sl_history_id_from_value(_sl_json_parse(line, n), &id) == 1) {
        _pc_put_h(out, &id, 16);
    } else {
        str_builder_add_cstr(out, "E:serde");
    }
    if (_par_adr21(out) == 1) { return 0; }
    return _pc_check_out(str_builder_build(out));
}

fn _par_history_json_row(): i64 {
    var idn = 0;
    var id = _par_tok_h(2, 0, &idn);
    var pl = 0;
    var path = _pc_tok_s(2, 1, &pl);
    var sl = 0;
    var src = _pc_tok_s(2, 4, &sl);
    var fl = 0;
    var fmt = _pc_tok_s(2, 7, &fl);
    var e = SlHistoryEntry_new(id, path, pl, _pc_tok_num(2, 2), _pc_tok_num(2, 3), src, sl, _pc_tok_num(2, 5),
        _pc_tok_num(2, 6), fmt, fl);
    var sb = str_builder_new();
    SlHistoryEntry_to_json(e, sb);
    var line = str_builder_build(sb);
    var out = str_builder_new();
    _pc_put_sstr(out, line);
    SlHistoryEntry_free(e);
    return _pc_check_out(str_builder_build(out));
}

var _par_hist_path = "build/parity_history.jsonl";

# A store over a file holding the h: input 0 (its lock file beside it).
fn _par_hist_store(): *SlHistoryStore {
    sys_mkdir("build", 493);
    var n = 0;
    var content = _par_in_h(0, &n);
    file_write_all(_par_hist_path, content, n);
    return SlHistoryStore_open(_par_hist_path);
}

fn _par_history_list_row(): i64 {
    var s = _par_hist_store();
    var limit = _pc_tok_num(2, 1);
    var since: i64[2];
    var sp = 0;
    if (_par_tok_is(2, 2, "N") == 0) {
        since[0] = _pc_tok_num(2, 2);
        since[1] = _pc_tok_num(2, 3);
        sp = &since;
    }
    var out = str_builder_new();
    var t, v = SlHistoryStore_list(s, limit, sp);
    if (is_err_result(t) == 1) {
        str_builder_add_cstr(out, "E:Io");
    } else {
        _pc_put_i(out, vec_len(v));
        var i = 0;
        while (i < vec_len(v)) {
            _pc_sp(out);
            _pc_put_h(out, vec_get(v, i), 16);
            i = i + 1;
        }
        selah_history_entries_free(v);
    }
    SlHistoryStore_free(s);
    return _pc_check_out(str_builder_build(out));
}

fn _par_history_get_row(): i64 {
    var s = _par_hist_store();
    var idn = 0;
    var id = _par_tok_h(2, 1, &idn);
    var out = str_builder_new();
    var t, v = SlHistoryStore_get(s, id);
    if (is_ok(t) == 1 && v != 0) {
        var e: *SlHistoryEntry = _sl_as_history(v);
        _pc_put_h(out, e, 16);
        _pc_sp(out);
        _pc_put_sstr(out, e.source);
        SlHistoryEntry_free(e);
    } else {
        str_builder_add_cstr(out, "N");
    }
    SlHistoryStore_free(s);
    return _pc_check_out(str_builder_build(out));
}

fn _par_history_delete_row(): i64 {
    var s = _par_hist_store();
    var idn = 0;
    var id = _par_tok_h(2, 1, &idn);
    var out = str_builder_new();
    var t, v = SlHistoryStore_delete(s, id);
    _pc_put_b(out, v);
    _pc_sp(out);
    var n = 0;
    var after = file_read_whole_max(_par_hist_path, 1073741824, &n);
    if (n > 4096) {
        _par_put_crc(out, after, n);
    } else {
        _pc_put_h(out, after, n);
    }
    SlHistoryStore_free(s);
    return _pc_check_out(str_builder_build(out));
}

# The format named by the e:ImageFormat token i.
fn _par_fmt_at(i): i64 {
    return _par_enum(i, "e:ImageFormat.", &_par_format_name, SL_FMT_WEBP);
}

# CaptureClient::capture's request body, or its refusal, without sending: what the client puts on the wire.
fn _par_capture_out(out, spec_rect: SlRect, has_rect, monitor, fmt): i64 {
    var d = 0;
    var spec: i64[4];
    var sp = 0;
    if (has_rect == 1) {
        var rt, rv = _sl_region_spec(spec_rect, &spec, &d);
        if (is_err_result(rt) == 1) { return _par_put_err_text(out, rv, d, 0); }
        sp = &spec;
    }
    if (monitor != 0 && _sl_blank(monitor, strlen(monitor)) == 1) {
        return _par_put_err_text(out, SL_ERR_INVALID_REGION, str_from("monitor id must not be empty"), 0);
    }
    var ft, fv = _sl_capture_format(fmt, &d);
    if (is_err_result(ft) == 1) { return _par_put_err_text(out, fv, d, 0); }
    var bb = str_builder_new();
    _sl_capture_body(bb, sp, monitor, fv, "selah");
    return _pc_put_sstr(out, str_builder_build(bb));
}

# A WebP row (adr=0002#1) passes as accepted when the port refuses it with UnsupportedFormat.
fn _par_adr1(out): i64 {
    if (_par_adr() != 1) { return 0; }
    var s = str_builder_build(out);
    if (str_len(s) >= 19 && memeq(str_data(s), "E:UnsupportedFormat", 19) == 1) {
        _pc_record(PC_ACCEPTED, "ADR 0002 #1: no WebP");
        return 1;
    }
    return 0;
}

fn _par_region_row(): i64 {
    var out = str_builder_new();
    _par_capture_out(out, _par_rect(0), 1, 0, _par_fmt_at(4));
    if (_par_adr1(out) == 1) { return 0; }
    return _pc_check_out(str_builder_build(out));
}

fn _par_monitor_req_row(): i64 {
    var n = 0;
    var id = _pc_tok_s(2, 0, &n);
    var out = str_builder_new();
    _par_capture_out(out, SlRect_default(), 0, id, _par_fmt_at(1));
    return _pc_check_out(str_builder_build(out));
}

fn _par_capture_http_row(): i64 {
    var status = _pc_tok_num(2, 0);
    var n = 0;
    var body = _par_in_h(1, &n);
    var out = str_builder_new();
    var d = 0;
    if (status < 200 || status >= 300) {
        var st, sv = _sl_http_status_err(status, body, n, "daimon capture", &d);
        _par_put_err_text(out, sv, d, 0);
        return _pc_check_out(str_builder_build(out));
    }
    var t, v = _sl_capture_from_body(body, n, &d);
    if (is_err_result(t) == 1) {
        _par_put_err_text(out, v, d, 1);
    } else {
        var r: *SlCaptureResponse = _sl_as_capture_resp(v);
        _par_put_crc(out, str_data(r.image_data), str_len(r.image_data));
        _pc_sp(out);
        _pc_put_i(out, str_len(r.image_data));
        _pc_sp(out);
        _pc_put_i(out, r.width);
        _pc_sp(out);
        _pc_put_i(out, r.height);
        _pc_sp(out);
        _pc_put_sstr(out, r.format);
        SlCaptureResponse_free(r);
    }
    return _pc_check_out(str_builder_build(out));
}

fn _par_monitors_http_row(): i64 {
    var status = _pc_tok_num(2, 0);
    var n = 0;
    var body = _par_in_h(1, &n);
    var out = str_builder_new();
    var d = 0;
    if (status < 200 || status >= 300) {
        var st, sv = _sl_http_status_err(status, body, n, "daimon monitors", &d);
        _par_put_err_text(out, sv, d, 0);
        return _pc_check_out(str_builder_build(out));
    }
    var t, v = _sl_monitors_from_body(body, n, &d);
    if (is_err_result(t) == 1) {
        _par_put_err_text(out, v, d, 1);
        return _pc_check_out(str_builder_build(out));
    }
    _pc_put_i(out, vec_len(v));
    var i = 0;
    while (i < vec_len(v)) {
        var m: *SlMonitor = _sl_as_monitor(vec_get(v, i));
        _pc_sp(out);
        _pc_put_sstr(out, m.id);
        _pc_sp(out);
        _pc_put_sstr(out, m.name);
        _pc_sp(out);
        _pc_put_i(out, m.width);
        _pc_sp(out);
        _pc_put_i(out, m.height);
        _pc_sp(out);
        _pc_put_i(out, m.x);
        _pc_sp(out);
        _pc_put_i(out, m.y);
        _pc_sp(out);
        _pc_put_b(out, m.primary);
        SlMonitor_free(m);
        i = i + 1;
    }
    return _pc_check_out(str_builder_build(out));
}

fn _par_ocr_answer_row(): i64 {
    var n = 0;
    var body = _par_in_h(0, &n);
    var out = str_builder_new();
    var d = 0;
    var t, v = _sl_ocr_from_answer(body, n, 1.0, 1.0, &d);
    if (is_err_result(t) == 1) {
        _par_put_err_text(out, v, d, 1);
    } else {
        var o: *SlOcrResult = _sl_as_ocr(v);
        _pc_put_sstr(out, o.text);
        _pc_sp(out);
        _pc_put_f(out, _sl_f64_bits(o.confidence));
        _pc_sp(out);
        _pc_put_i(out, vec_len(o.bounding_boxes));
        var i = 0;
        while (i < vec_len(o.bounding_boxes)) {
            var r: *SlRect = _sl_as_rect(vec_get(o.bounding_boxes, i));
            _pc_sp(out);
            _pc_put_g(out, _sl_f32_bits(r.min_x));
            _pc_sp(out);
            _pc_put_g(out, _sl_f32_bits(r.min_y));
            _pc_sp(out);
            _pc_put_g(out, _sl_f32_bits(r.max_x));
            _pc_sp(out);
            _pc_put_g(out, _sl_f32_bits(r.max_y));
            i = i + 1;
        }
    }
    if (_par_adr21(out) == 1) { return 0; }
    return _pc_check_out(str_builder_build(out));
}

# The path part (from the first `/` after the authority) of the http URL u (a Str), as a Str.
fn _par_url_path(u): i64 {
    var p = str_data(u);
    var n = str_len(u);
    var i = 7;
    while (i < n && load8(p + i) != 47) { i = i + 1; }
    var hdr: i64[2];
    hdr[0] = p + i;
    hdr[1] = n - i;
    var sb = str_builder_new();
    str_builder_add(sb, &hdr);
    return str_builder_build(sb);
}

fn _par_agent_path_row(): i64 {
    var n = 0;
    var id = _pc_tok_s(2, 0, &n);
    var out = str_builder_new();
    var d = 0;
    var vt, vv = _sl_validate_agent_id(id, n, &d);
    if (is_err_result(vt) == 1) {
        _par_put_err_text(out, vv, d, 0);
        return _pc_check_out(str_builder_build(out));
    }
    var segs = vec_new();
    vec_push(segs, "v1");
    vec_push(segs, "agents");
    vec_push(segs, id);
    vec_push(segs, "heartbeat");
    var t, u = _sl_endpoint_url("http://127.0.0.1:1", segs);
    _pc_put_sstr(out, _par_url_path(u));
    return _pc_check_out(str_builder_build(out));
}

# The s: input token i as a NUL-terminated string, or 0 for `N`.
fn _par_opt_s(i): i64 {
    if (_par_tok_is(2, i, "N") == 1) { return 0; }
    var n = 0;
    return _pc_tok_s(2, i, &n);
}

fn _par_session_row(): i64 {
    var out = str_builder_new();
    if (_sl_session_type_from(_par_opt_s(0), _par_opt_s(1)) == SL_SESSION_WAYLAND) {
        str_builder_add_cstr(out, "e:SessionType.Wayland");
    } else {
        str_builder_add_cstr(out, "e:SessionType.X11");
    }
    return _pc_check_out(str_builder_build(out));
}

fn _par_mime_row(): i64 {
    var n = 0;
    var b = _par_in_h(0, &n);
    var out = str_builder_new();
    var m = _sl_guess_mime(b, n);
    _pc_put_s(out, m, strlen(m));
    return _pc_check_out(str_builder_build(out));
}

fn _par_exit_status_row(): i64 {
    var raw = _pc_tok_num(2, 0);
    var spb: i64[7];
    var sp: *SlSpawn = _sl_as_spawn(&spb);
    sp.code = 0;
    sp.signal = 0;
    sp.core = 0;
    if ((raw & 127) == 0) {
        sp.code = (raw >> 8) & 255;
    } else {
        sp.signal = raw & 127;
        if ((raw & 128) != 0) { sp.core = 1; }
    }
    var sb = str_builder_new();
    _sl_exit_status_fmt(sb, sp);
    var out = str_builder_new();
    _pc_put_sstr(out, str_builder_build(sb));
    return _pc_check_out(str_builder_build(out));
}

fn _par_rect_debug_row(): i64 {
