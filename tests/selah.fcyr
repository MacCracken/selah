# selah fuzz harness

# Fuzz entry: one input of `len` bytes at `data`. Real targets (decode, JSON, PII) arrive with their modules.
fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    return 0;
}

# Runs fuzz_main once on a fixed input, as a smoke check.
fn main() {
    alloc_init();
    fuzz_main("test", 4);
    println("fuzz: ok");
    return 0;
}

var r = main();
sys_exit_group(r);
