# selah.tcyr — the consumer's view: include the bundle (dist/selah.cyr) the way a Cyrius consumer does, and call a
# little of every ported module through it. `cyrius distlib --check` keeps the bundle current with src/.

include "dist/selah.cyr"

# A Str holding exactly the text.
fn _s_is(s, text): i64 {
    var n = strlen(text);
    return s != 0 && str_len(s) == n && memeq(str_data(s), text, n) == 1;
}

# Smoke-tests the bundle: geometry, core, errors, JSON, codecs, annotation, the clients and the history.
fn main(): i64 {
    alloc_init();
    test_group("bundle");
    var r = SlRect_new(f32_from(10.0), f32_from(20.0), f32_from(100.0), f32_from(50.0));
    assert(r.width() == 100.0, "Rect::width");
    assert(r.area() == 5000.0, "Rect::area");
    assert(_s_is(selah_xml_escape("<a&b>", 5), "&lt;a&amp;b&gt;"), "xml_escape");
    var d = 0;
    var t, v = selah_image_format_parse("gif", 3, &d);
    assert(is_err_result(t) == 1 && v == SL_ERR_UNSUPPORTED_FORMAT, "ImageFormat::from_str refuses gif");
    var a: *SlAnnotation = SlAnnotation_with_text(SL_KIND_TEXT, r, SL_COLOR_BLUE, str_from("hi"));
    assert(a != 0, "Annotation::with_text");
    var sb = str_builder_new();
    SlAnnotation_to_json(a, sb);
    var j = str_builder_build(sb);
    var t2, b = SlAnnotation_from_json(str_data(j), str_len(j));
    assert(is_ok(t2), "Annotation JSON round trip");
    var img: *SlImage = SlImage_new(2, 2);
    var pn = 0;
    var pt, png = _sl_encode_image(img, SL_FMT_PNG, &pn);
    var bn = 0;
    var ct, bmp = selah_convert_format(png, pn, SL_FMT_BMP, &bn);
    assert(is_ok(ct) == 1 && load8(bmp) == 66 && load8(bmp + 1) == 77, "convert_format PNG -> BMP");
    var anns = vec_new();
    vec_push(anns, SlAnnotation_new(SL_KIND_REDACTION, r, SL_COLOR_BLACK));
    var an = 0;
    var at, out = selah_annotate_image(png, pn, anns, SL_FMT_PNG, &an);
    assert(is_ok(at) == 1 && an > 0, "annotate_image");
    var c: *SlAnnotationCanvas = SlAnnotationCanvas_new(2, 2);
    SlAnnotationCanvas_apply_redaction(c, r);
    assert(SlAnnotationCanvas_count(c) == 1 && str_len(SlAnnotationCanvas_to_svg(c)) > 0, "canvas and SVG");
    # M5: the system modules, through the bundle.
    var cc: *SlCaptureClient = SlCaptureClient_new("http://localhost:8090/");
    assert(_s_is(str_from(SlCaptureClient_base_url(cc)), "http://localhost:8090"), "CaptureClient::new");
    var dc: *SlDaimonClient = SlDaimonClient_new();
    assert(_s_is(str_from(SlDaimonClient_endpoint(dc)), "http://localhost:8090"), "DaimonClient::new");
    var hs: *SlHistoryStore = SlHistoryStore_open("/tmp/selah_bundle_smoke.jsonl");
    var lt, lv = SlHistoryStore_list(hs, 10);
    assert(is_ok(lt) == 1 && vec_len(lv) == 0, "HistoryStore::list on a missing file");
    # SL_VERSION (src/version_str.cyr, the User-Agent's) must be VERSION's text.
    var vn = 0;
    var vf = file_read_whole_max("VERSION", 64, &vn);
    while (vn > 0 && (load8(vf + vn - 1) == 10 || load8(vf + vn - 1) == 13 || load8(vf + vn - 1) == 32)) {
        vn = vn - 1;
    }
    assert(vf != 0 && vn == strlen(SL_VERSION) && memeq(vf, SL_VERSION, vn) == 1, "SL_VERSION is VERSION");
    return assert_summary();
}

var exit_code = main();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait status is only 8 bits.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
