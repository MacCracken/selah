# selah benchmarks — the Rust criterion suite's benches (rust-old/benches/benchmarks.rs), same names and inputs, so
# docs/benchmarks-rust-v-cyrius.md can set them side by side. Benches join as their modules are ported (M1: rect
# operations, xml_escape; M2: suggest_redactions, extract_text_regions). M3's codec benches have no criterion
# counterpart: their Rust numbers come from `scripts/oracle -- --bench`, on the same image.
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.

include "tests/selah_src.cyr"

# rect_new: Rect::new(10, 20, 100, 50).
fn _b_rect_new(): i64 {
    var x: f32 = f32_from(10.0);
    var y: f32 = f32_from(20.0);
    var w: f32 = f32_from(100.0);
    var h: f32 = f32_from(50.0);
    var n = 1000000;
    var sink = 0;
    var b = bench_new("rect_new");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var r = SlRect_new(x, y, w, h);
        sink = sink + _sl_f32_bits(r.max_x);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# rect_contains_point: Rect::new(10, 10, 100, 50).contains_point((55, 35)).
fn _b_rect_contains_point(): i64 {
    var r = SlRect_new(f32_from(10.0), f32_from(10.0), f32_from(100.0), f32_from(50.0));
    var p = SlVec2_new(f32_from(55.0), f32_from(35.0));
    var n = 1000000;
    var sink = 0;
    var b = bench_new("rect_contains_point");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        if (r.contains_point(p)) { sink = sink + 1; }
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# rect_intersects: Rect::new(0, 0, 100, 100) against Rect::new(50, 50, 100, 100).
fn _b_rect_intersects(): i64 {
    var a = SlRect_new(f32_from(0.0), f32_from(0.0), f32_from(100.0), f32_from(100.0));
    var c = SlRect_new(f32_from(50.0), f32_from(50.0), f32_from(100.0), f32_from(100.0));
    var n = 1000000;
    var sink = 0;
    var b = bench_new("rect_intersects");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        if (a.intersects(&c)) { sink = sink + 1; }
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# xml_escape over text `p[0..len)`, `n` times, into one builder emptied each time (the bump allocator never frees,
# so a fresh String per call, as Rust's xml_escape makes, would grow the heap by the run's whole output).
fn _b_xml(name, p, len, n): i64 {
    var sb = str_builder_new();
    var sink = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        store64(sb + 8, 0);
        _sl_push_xml_escaped(sb, p, len);
        sink = sink + load64(sb + 8);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# suggest_redactions over `p[0..len)`, `n` times, each call's results in an arena reset after it (Rust frees its Vec).
fn _b_redact(name, p, len, n): i64 {
    var al = arena_allocator_growable(65536);
    var sink = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var v = selah_suggest_redactions_a(al, p, len);
        sink = sink + vec_len(v);
        reset_via(al);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# extract_text_regions_64k: 64 KiB alternating 64-byte runs of letters and of control bytes, as Rust's bench builds it.
fn _b_extract(): i64 {
    var data = alloc(65536);
    var k = 0;
    while (k < 65536) {
        if ((k / 64) % 2 == 0) { store8(data + k, 97 + k % 26); } else { store8(data + k, k % 31); }
        k = k + 1;
    }
    var al = arena_allocator_growable(262144);
    var n = 2000;
    var sink = 0;
    var b = bench_new("extract_text_regions_64k");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var o: *SlOcrResult = selah_extract_text_regions_a(al, data, 65536);
        sink = sink + str_len(o.text);
        reset_via(al);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# ---- M4: rendering and SVG (Rust's render_to_image_64x64, render_to_image_512_bmp, to_svg_100: same inputs).

# A solid (128, 128, 128, 255) w × h image encoded as fmt (Rust's make_image), its length at len_out.
fn _b_solid(w, h, fmt, len_out): i64 {
    var img: *SlImage = SlImage_new(w, h);
    var i = 0;
    while (i < w * h) {
        store32(img.pixels + i * 4, 128 | (128 << 8) | (128 << 16) | (255 << 24));
        i = i + 1;
    }
    var t, v = _sl_encode_image(img, fmt, len_out);
    SlImage_free(img);
    return v;
}

fn _b_ann(anns, kind, x: f64, y: f64, w: f64, h: f64, c: SlColor): i64 {
    vec_push(anns, SlAnnotation_new(kind, SlRect_new(f32_from(x), f32_from(y), f32_from(w), f32_from(h)), c));
    return 0;
}

# render_to_image n times, its output in fmt.
fn _b_render(name, src, len, anns, fmt, n): i64 {
    var sink = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var on = 0;
        var t, v = SlAnnotationCanvas_render_to_image(src, len, anns, fmt, &on);
        sink = sink + on;
        selah_bytes_free(v);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

fn _b_m4(): i64 {
    var pn = 0;
    var png = _b_solid(64, 64, SL_FMT_PNG, &pn);
    var a64 = vec_new();
    _b_ann(a64, SL_KIND_REDACTION, 0.0, 0.0, 32.0, 32.0, SL_COLOR_BLACK);
    _b_ann(a64, SL_KIND_RECTANGLE, 10.0, 10.0, 44.0, 44.0, SL_COLOR_RED);
    _b_ann(a64, SL_KIND_HIGHLIGHT, 20.0, 20.0, 30.0, 30.0, SL_COLOR_YELLOW);
    _b_render("render_to_image_64x64", png, pn, a64, SL_FMT_PNG, 1000);
    var bn = 0;
    var bmp = _b_solid(512, 512, SL_FMT_BMP, &bn);
    var a512 = vec_new();
    _b_ann(a512, SL_KIND_REDACTION, 0.0, 0.0, 256.0, 256.0, SL_COLOR_BLACK);
    _b_ann(a512, SL_KIND_HIGHLIGHT, 64.0, 64.0, 384.0, 384.0, SL_COLOR_YELLOW);
    _b_ann(a512, SL_KIND_RECTANGLE, 10.0, 10.0, 490.0, 490.0, SL_COLOR_RED);
    _b_ann(a512, SL_KIND_CIRCLE, 100.0, 100.0, 300.0, 200.0, SL_COLOR_GREEN);
    _b_ann(a512, SL_KIND_ARROW, 0.0, 511.0, 511.0, -511.0, SL_COLOR_BLUE);
    _b_render("render_to_image_512_bmp", bmp, bn, a512, SL_FMT_BMP, 50);
    # to_svg_100: Rectangle, Circle, Arrow, Highlight, Redaction in turn at (10i, 5i), 100 × 50, red.
    var c: *SlAnnotationCanvas = SlAnnotationCanvas_new(1920, 1080);
    var kinds: i64[5];
    kinds[0] = SL_KIND_RECTANGLE;
    kinds[1] = SL_KIND_CIRCLE;
    kinds[2] = SL_KIND_ARROW;
    kinds[3] = SL_KIND_HIGHLIGHT;
    kinds[4] = SL_KIND_REDACTION;
    var k = 0;
    while (k < 100) {
        var f: f64 = f64_from(k);
        var x: f64 = f * 10.0;
        var y: f64 = f * 5.0;
        _b_ann(c.annotations, kinds[k % 5], x, y, 100.0, 50.0, SL_COLOR_RED);
        k = k + 1;
    }
    var sink = 0;
    var n = 2000;
    var b = bench_new("to_svg_100");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var svg = SlAnnotationCanvas_to_svg(c);
        sink = sink + str_len(svg);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# ---- M5: history and the HTTP layer's parsing, on inputs the oracle's --bench builds identically. Entry i: id i (the
# low 8 bytes, big-endian), path /home/u/Pictures/shot-<i>.png, unix second 1763164800 + i, nanosecond (i * 7919) mod
# 10^9, "full screen", 1920 x 1080, png.

fn _b_hentry(i): *SlHistoryEntry {
    var id: u8[16];
    var k = 0;
    while (k < 16) {
        store8(&id + k, 0);
        k = k + 1;
    }
    var j = 0;
    while (j < 8) {
        store8(&id + 15 - j, (i >> (j * 8)) & 255);
        j = j + 1;
    }
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "/home/u/Pictures/shot-");
    str_builder_add_int(pb, i);
    str_builder_add_cstr(pb, ".png");
    var path = str_builder_build(pb);
    return SlHistoryEntry_new(&id, str_data(path), str_len(path), 1763164800 + i, (i * 7919) % 1000000000,
        "full screen", 11, 1920, 1080, "png", 3);
}

# A fresh store at build/bench/<name>.jsonl holding entries 0..n.
fn _b_hstore(name, n): *SlHistoryStore {
    sys_mkdir("build", 493);
    sys_mkdir("build/bench", 493);
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "build/bench/");
    str_builder_add_cstr(pb, name);
    str_builder_add_cstr(pb, ".jsonl");
    var path = str_data(str_builder_build(pb));
    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        var e = _b_hentry(i);
        SlHistoryEntry_to_json(e, sb);
        str_builder_putc(sb, 10);
        SlHistoryEntry_free(e);
        i = i + 1;
    }
    var all = str_builder_build(sb);
    file_write_all(path, str_data(all), str_len(all));
    return SlHistoryStore_open(path);
}

fn _b_m5(): i64 {
    var sink = 0;
    var rs = _b_hstore("history_record", 0);
    var b = bench_new("history_record");
    var n = 2000;
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var e = _b_hentry(i);
        var t, v = SlHistoryStore_record(rs, e);
        SlHistoryEntry_free(e);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);

    var s = _b_hstore("history_1000", 1000);
    var bl = bench_new("history_list_1000");
    var nl = 200;
    bench_batch_start(bl);
    i = 0;
    while (i < nl) {
        var lt, lv = SlHistoryStore_list(s, 10);
        sink = sink + vec_len(lv);
        selah_history_entries_free(lv);
        i = i + 1;
    }
    bench_batch_stop(bl, nl);
    bench_report(bl);

    var last = _b_hentry(999);
    var bg = bench_new("history_get_1000");
    bench_batch_start(bg);
    i = 0;
    while (i < nl) {
        var gt, gv = SlHistoryStore_get(s, last);
        if (gv != 0) {
            sink = sink + 1;
            SlHistoryEntry_free(gv);
        }
        i = i + 1;
    }
    bench_batch_stop(bg, nl);
    bench_report(bg);

    var miss = _b_hentry(5000);
    var bd = bench_new("history_delete_miss_1000");
    bench_batch_start(bd);
    i = 0;
    while (i < nl) {
        var dt, dv = SlHistoryStore_delete(s, miss);
        sink = sink + dv;
        i = i + 1;
    }
    bench_batch_stop(bd, nl);
    bench_report(bd);

    # A capture answer carrying 1 MiB of base64 (the pattern `(i * 7) mod 64` over the alphabet).
    var alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var cb = str_builder_new();
    str_builder_add_cstr(cb, "{\"image_data\":\"");
    var k = 0;
    while (k < 1048576) {
        str_builder_putc(cb, load8(alpha + ((k * 7) % 64)));
        k = k + 1;
    }
    str_builder_add_cstr(cb, "\",\"width\":1920,\"height\":1080,\"format\":\"png\"}");
    var body = str_builder_build(cb);
    var bc = bench_new("capture_parse_1mb");
    var nc = 50;
    bench_batch_start(bc);
    i = 0;
    while (i < nc) {
        var ct, cv = _sl_capture_from_body(str_data(body), str_len(body));
        var r: *SlCaptureResponse = _sl_as_capture_resp(cv);
        sink = sink + r.width;
        SlCaptureResponse_free(r);
        i = i + 1;
    }
    bench_batch_stop(bc, nc);
    bench_report(bc);
    return sink;
}

# ---- M3: codecs, on one 512 x 512 RGBA image the oracle's --bench builds identically:
# (x ^ y, 3x + y, 5y ^ x, 255) mod 256, a pattern with edges and gradients, neither flat nor noise.
fn _b_image(): *SlImage {
    var img: *SlImage = SlImage_new(512, 512);
    var y = 0;
    while (y < 512) {
        var x = 0;
        while (x < 512) {
            var p = img.pixels + (y * 512 + x) * 4;
            store8(p, (x ^ y) & 255);
            store8(p + 1, (x * 3 + y) & 255);
            store8(p + 2, ((y * 5) ^ x) & 255);
            store8(p + 3, 255);
            x = x + 1;
        }
        y = y + 1;
    }
    return img;
}

# Encodes img as fmt n times.
fn _b_encode(name, img: *SlImage, fmt, n): i64 {
    var sink = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var len = 0;
        var t, v = _sl_encode_image(img, fmt, &len);
        sink = sink + len;
        selah_bytes_free(v);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# Decodes the bytes n times. chitra 1.3.1 keeps every decode's memory (ledger L16), so n stays small.
fn _b_decode(name, src, len, n): i64 {
    var sink = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var t, v = _sl_decode_image(src, len);
        var img: *SlImage = _sl_as_image(v);
        sink = sink + img.width;
        SlImage_free(img);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# convert_format PNG -> JPEG, n times.
fn _b_convert(src, len, n): i64 {
    var sink = 0;
    var b = bench_new("convert_format_png_to_jpeg_512");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var on = 0;
        var t, v = selah_convert_format(src, len, SL_FMT_JPEG, &on);
        sink = sink + on;
        selah_bytes_free(v);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

fn _b_codecs(): i64 {
    var img: *SlImage = _b_image();
    _b_encode("encode_png_512", img, SL_FMT_PNG, 20);
    _b_encode("encode_bmp_512", img, SL_FMT_BMP, 200);
    _b_encode("encode_jpeg_512", img, SL_FMT_JPEG, 20);
    var pn = 0;
    var pt, png = _sl_encode_image(img, SL_FMT_PNG, &pn);
    var jn = 0;
    var jt, jpg = _sl_encode_image(img, SL_FMT_JPEG, &jn);
    # The bytes decoded here, for the oracle's --bench to decode the same files.
    sys_mkdir("build", 493);
    sys_mkdir("build/bench", 493);
    file_write_all("build/bench/image512.png", png, pn);
    file_write_all("build/bench/image512.jpg", jpg, jn);
    _b_decode("decode_png_512", png, pn, 20);
    _b_decode("decode_jpeg_512", jpg, jn, 20);
    _b_convert(png, pn, 10);
    return 0;
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    _b_rect_new();
    _b_rect_contains_point();
    _b_rect_intersects();
    var plain = "Hello World 1234567890";
    var special = "<script>alert(\"xss\")</script> & 'more' <entities>";
    var sb = str_builder_new();
    var k = 0;
    while (k < 100) {
        str_builder_add_cstr(sb, plain);
        k = k + 1;
    }
    var long = str_builder_build(sb);
    _b_xml("xml_escape_plain", plain, strlen(plain), 1000000);
    _b_xml("xml_escape_special", special, strlen(special), 1000000);
    _b_xml("xml_escape_long", str_data(long), str_len(long), 100000);
    var clean = "This is a perfectly normal sentence with no sensitive data at all.";
    var pii = "Contact user@example.com at 192.168.1.100 or call 555-123-4567. Card: 4111111111111111";
    var lsb = str_builder_new();
    var r = 0;
    while (r < 100) {
        str_builder_add_cstr(lsb, clean);
        r = r + 1;
    }
    var ltext = str_builder_build(lsb);
    _b_redact("suggest_redactions_clean", clean, strlen(clean), 200000);
    _b_redact("suggest_redactions_pii", pii, strlen(pii), 200000);
    _b_redact("suggest_redactions_long", str_data(ltext), str_len(ltext), 5000);
    _b_extract();
    _b_m4();
    _b_m5();
    _b_codecs();
    return 0;
}

var r = main();
sys_exit_group(r);
