# selah benchmarks — the Rust criterion suite's benches (rust-old/benches/benchmarks.rs), same names and inputs, so
# docs/benchmarks-rust-v-cyrius.md can set them side by side. Benches join as their modules are ported (M1: rect
# operations, xml_escape; M2: suggest_redactions, extract_text_regions).
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.

include "tests/selah_src.cyr"

# rect_new: Rect::new(10, 20, 100, 50).
fn _b_rect_new(): i64 {
    var x: f32 = f32_from(10.0);
    var y: f32 = f32_from(20.0);
    var w: f32 = f32_from(100.0);
    var h: f32 = f32_from(50.0);
    var n = 1000000;
    var sink = 0;
    var b = bench_new("rect_new");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var r = SlRect_new(x, y, w, h);
        sink = sink + _sl_f32_bits(r.max_x);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# rect_contains_point: Rect::new(10, 10, 100, 50).contains_point((55, 35)).
fn _b_rect_contains_point(): i64 {
    var r = SlRect_new(f32_from(10.0), f32_from(10.0), f32_from(100.0), f32_from(50.0));
    var p = SlVec2_new(f32_from(55.0), f32_from(35.0));
    var n = 1000000;
    var sink = 0;
    var b = bench_new("rect_contains_point");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        if (r.contains_point(p)) { sink = sink + 1; }
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# rect_intersects: Rect::new(0, 0, 100, 100) against Rect::new(50, 50, 100, 100).
fn _b_rect_intersects(): i64 {
    var a = SlRect_new(f32_from(0.0), f32_from(0.0), f32_from(100.0), f32_from(100.0));
    var c = SlRect_new(f32_from(50.0), f32_from(50.0), f32_from(100.0), f32_from(100.0));
    var n = 1000000;
    var sink = 0;
    var b = bench_new("rect_intersects");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        if (a.intersects(&c)) { sink = sink + 1; }
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# xml_escape over text `p[0..len)`, `n` times, into one builder emptied each time (the bump allocator never frees,
# so a fresh String per call, as Rust's xml_escape makes, would grow the heap by the run's whole output).
fn _b_xml(name, p, len, n): i64 {
    var sb = str_builder_new();
    var sink = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        store64(sb + 8, 0);
        _sl_push_xml_escaped(sb, p, len);
        sink = sink + load64(sb + 8);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# suggest_redactions over `p[0..len)`, `n` times, each call's results in an arena reset after it (Rust frees its Vec).
fn _b_redact(name, p, len, n): i64 {
    var al = arena_allocator_growable(65536);
    var sink = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var v = selah_suggest_redactions_a(al, p, len);
        sink = sink + vec_len(v);
        reset_via(al);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# extract_text_regions_64k: 64 KiB alternating 64-byte runs of letters and of control bytes, as Rust's bench builds it.
fn _b_extract(): i64 {
    var data = alloc(65536);
    var k = 0;
    while (k < 65536) {
        if ((k / 64) % 2 == 0) { store8(data + k, 97 + k % 26); } else { store8(data + k, k % 31); }
        k = k + 1;
    }
    var al = arena_allocator_growable(262144);
    var n = 2000;
    var sink = 0;
    var b = bench_new("extract_text_regions_64k");
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        var o: *SlOcrResult = selah_extract_text_regions_a(al, data, 65536);
        sink = sink + str_len(o.text);
        reset_via(al);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return sink;
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    _b_rect_new();
    _b_rect_contains_point();
    _b_rect_intersects();
    var plain = "Hello World 1234567890";
    var special = "<script>alert(\"xss\")</script> & 'more' <entities>";
    var sb = str_builder_new();
    var k = 0;
    while (k < 100) {
        str_builder_add_cstr(sb, plain);
        k = k + 1;
    }
    var long = str_builder_build(sb);
    _b_xml("xml_escape_plain", plain, strlen(plain), 1000000);
    _b_xml("xml_escape_special", special, strlen(special), 1000000);
    _b_xml("xml_escape_long", str_data(long), str_len(long), 100000);
    var clean = "This is a perfectly normal sentence with no sensitive data at all.";
    var pii = "Contact user@example.com at 192.168.1.100 or call 555-123-4567. Card: 4111111111111111";
    var lsb = str_builder_new();
    var r = 0;
    while (r < 100) {
        str_builder_add_cstr(lsb, clean);
        r = r + 1;
    }
    var ltext = str_builder_build(lsb);
    _b_redact("suggest_redactions_clean", clean, strlen(clean), 200000);
    _b_redact("suggest_redactions_pii", pii, strlen(pii), 200000);
    _b_redact("suggest_redactions_long", str_data(ltext), str_len(ltext), 5000);
    _b_extract();
    return 0;
}

var r = main();
sys_exit_group(r);
