    test_group("test_ip_at_end_of_sentence");
    assert(_t_one("server is 10.0.0.1.", SL_TARGET_IP_ADDRESS, "10.0.0.1"), "trailing dot");
    assert(_t_one("host=192.168.0.7,", SL_TARGET_IP_ADDRESS, "192.168.0.7"), "key=value,");
    return 0;
}

fn _t_ip_not_double_reported_as_phone(): i64 {
    test_group("test_ip_not_double_reported_as_phone");
    var s = _t_sug("ip 192.168.100.200");
    assert(vec_len(s) == 1, "one");
    assert(_t_kind_at(s, 0) == SL_TARGET_IP_ADDRESS, "ip");
    return 0;
}

