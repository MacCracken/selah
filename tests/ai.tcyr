fn _t_suggestions_in_text_order(): i64 {
    test_group("test_suggestions_in_text_order");
    var s = _t_sug("10.0.0.1 then a@b.co then 555-123-4567");
    assert(vec_len(s) == 3, "three");
    assert(_t_kind_at(s, 0) == SL_TARGET_IP_ADDRESS, "ip first");
    assert(_t_kind_at(s, 1) == SL_TARGET_EMAIL, "email second");
    assert(_t_kind_at(s, 2) == SL_TARGET_PHONE, "phone third");
    return 0;
}

fn _t_suggest_redactions_unicode_no_panic(): i64 {
    test_group("test_suggest_redactions_unicode_no_panic");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "\xc3\xbcn\xc3\xafc\xc3\xb6d\xc3\xa9@\xe4\xbe\x8b\xe3\x81\x88.jp ");
    str_builder_add_cstr(sb, "(\xef\xbc\x95\xef\xbc\x95\xef\xbc\x95) ");
    str_builder_add_cstr(sb, "\xef\xbc\x94\xef\xbc\x91\xef\xbc\x91\xef\xbc\x91 \xe2\x80\x94 ");
    str_builder_add_cstr(sb, "\xf0\x9f\x8e\x89 user@\xe4\xbe\x8b\xe5\xad\x90.");
    str_builder_add_cstr(sb, "\xe5\x85\xac\xe5\x8f\xb8 \xc2\xaba@b.cd\xc2\xbb");
    var mixed = str_builder_build(sb);
    var all = selah_suggest_redactions(str_data(mixed), str_len(mixed));
    assert(vec_len(all) >= 0, "no fault on multibyte text");
    assert(_t_one("\xc2\xaba@b.cd\xc2\xbb", SL_TARGET_EMAIL, "a@b.cd"), "guillemets");
    return 0;
}

fn _t_extract_text_preserves_runs_and_separators(): i64 {
    test_group("test_extract_text_preserves_runs_and_separators");
    var o: *SlOcrResult = selah_extract_text_regions("\x00abcd\x01\x02efgh\x00ab\x00ijkl", 19);
    assert(_t_str_is(o.text, "abcd efgh ijkl"), "runs");
    return 0;
}

# doctest (suggest_redactions)
fn _t_doctest_suggest_redactions(): i64 {
    test_group("doctest ai::suggest_redactions");
    var s = _t_sug("contact user@example.com for info");
    assert(vec_len(s) == 1, "one");
    var g: *SlRedactionSuggestion = _sl_as_suggestion(vec_get(s, 0));
    assert(_t_str_is(g.matched_text, "user@example.com"), "matched");
    return 0;
}

# Cyrius-only: the _a forms put a call's results in an arena that a reset reclaims.
fn _t_arena_forms(): i64 {
    test_group("allocator forms");
    var al = arena_allocator(65536);
    var v = selah_suggest_redactions_a(al, "a@b.co 10.0.0.1", 15);
    assert(vec_len(v) == 2, "two");
    reset_via(al);
    var w = selah_suggest_smart_crop_a(al, 100, 50);
    assert(vec_len(w) == 5, "five after reset");
    return 0;
}

# Runs the suite; the exit code is the failure count, clamped.
fn main(): i64 {
    alloc_init();
    _t_extract_text_from_ascii_bytes();
    _t_extract_text_empty_input();
    _t_extract_text_binary_garbage();
    _t_detect_email();
    _t_detect_phone_with_separator();
    _t_no_phone_without_separator();
    _t_detect_ip_address();
    _t_detect_invalid_ip();
    _t_detect_credit_card();
    _t_no_false_credit_card();
    _t_detect_nothing_in_clean_text();
    _t_smart_crop_returns_five_suggestions();
    _t_smart_crop_zero_dimensions();
    _t_smart_crop_regions_within_bounds();
    _t_luhn_check_valid();
    _t_luhn_check_invalid();
    _t_email_no_tld();
    _t_email_short_tld();
    _t_email_numeric_tld();
    _t_credit_card_with_dashes();
    _t_ip_zero();
    _t_ip_broadcast();
    _t_ip_partial_invalid();
    _t_multiple_pii_types();
    _t_luhn_check_non_digit();
    _t_smart_crop_single_pixel();
    _t_email_with_surrounding_punctuation();
    _t_ip_at_end_of_sentence();
    _t_ip_not_double_reported_as_phone();
    _t_ip_rejects_extra_octets_and_long_parts();
    _t_credit_card_space_grouped();
    _t_credit_card_grouped_failing_luhn_not_matched();
    _t_credit_card_with_trailing_punctuation();
    _t_amex_dashed_is_card_not_phone();
    _t_phone_split_area_code();
    _t_phone_with_trailing_punctuation();
    _t_suggestions_in_text_order();
    _t_suggest_redactions_unicode_no_panic();
    _t_extract_text_preserves_runs_and_separators();
    _t_doctest_suggest_redactions();
    _t_arena_forms();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
