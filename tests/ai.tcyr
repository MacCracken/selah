fn _t_smart_crop_returns_five_suggestions(): i64 {
    test_group("test_smart_crop_returns_five_suggestions");
    assert(vec_len(selah_suggest_smart_crop(1920, 1080)) == 5, "five");
    return 0;
}

fn _t_smart_crop_zero_dimensions(): i64 {
    test_group("test_smart_crop_zero_dimensions");
    assert(vec_len(selah_suggest_smart_crop(0, 0)) == 0, "none");
    return 0;
}

fn _t_smart_crop_regions_within_bounds(): i64 {
    test_group("test_smart_crop_regions_within_bounds");
    var v = selah_suggest_smart_crop(1920, 1080);
    var i = 0;
    while (i < vec_len(v)) {
        var c: *SlSmartCropSuggestion = _sl_as_crop(vec_get(v, i));
        var x: f64 = c.region.x();
        var y: f64 = c.region.y();
        var w: f64 = c.region.width();
        var h: f64 = c.region.height();
        # Rust adds in f32: x() + width() as f32 sums; both are exact here, so f64 sums agree.
        assert(x >= 0.0 && y >= 0.0, "origin");
        assert(x + w <= 1920.0 && y + h <= 1080.0, "inside");
        i = i + 1;
    }
    return 0;
}

