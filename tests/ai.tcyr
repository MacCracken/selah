fn _t_email_with_surrounding_punctuation(): i64 {
    test_group("test_email_with_surrounding_punctuation");
    assert(_t_one("mail me at user@example.com.", SL_TARGET_EMAIL, "user@example.com"), "trailing dot");
    var v = _t_of_type("<admin@corp.io>, (ops@corp.io)", SL_TARGET_EMAIL);
    assert(vec_len(v) == 2, "two");
    assert(_t_str_is(vec_get(v, 0), "admin@corp.io") && _t_str_is(vec_get(v, 1), "ops@corp.io"), "both");
    return 0;
}

