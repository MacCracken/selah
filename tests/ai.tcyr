# ai.tcyr — rust-old/src/ai.rs's tests and doctest, ported (port plan M2). Golden parity: tests/golden/ai.tsv.

include "tests/selah_src.cyr"
include "tests/support.cyr"

# The suggestions of a cstring.
fn _t_sug(text): i64 {
    return selah_suggest_redactions(text, strlen(text));
}

# The matched texts (Strs) of the suggestions of `kind`, in order (Rust's of_type helper).
fn _t_of_type(text, kind): i64 {
    var all = _t_sug(text);
    var out = vec_new();
    var i = 0;
    while (i < vec_len(all)) {
        var s: *SlRedactionSuggestion = _sl_as_suggestion(vec_get(all, i));
        if (s.target.kind == kind) { vec_push(out, s.matched_text); }
        i = i + 1;
    }
    return out;
}

# 1 when of_type(text, kind) is exactly the one match `m`.
fn _t_one(text, kind, m): i64 {
    var v = _t_of_type(text, kind);
    return vec_len(v) == 1 && _t_str_is(vec_get(v, 0), m) == 1;
}

# The number of matches of `kind`.
fn _t_count(text, kind): i64 {
    return vec_len(_t_of_type(text, kind));
}

# The kind of the k-th suggestion.
fn _t_kind_at(v, k): i64 {
    var s: *SlRedactionSuggestion = _sl_as_suggestion(vec_get(v, k));
    return s.target.kind;
}

fn _t_extract_text_from_ascii_bytes(): i64 {
    test_group("test_extract_text_from_ascii_bytes");
    var o: *SlOcrResult = selah_extract_text_regions("....Hello World!....", 20);
    assert(_t_str_has(o.text, "Hello World!"), "text");
    assert(o.confidence > 0.0, "confidence");
    assert(o.is_stub == 1, "stub");
    return 0;
}

fn _t_extract_text_empty_input(): i64 {
    test_group("test_extract_text_empty_input");
    var o: *SlOcrResult = selah_extract_text_regions("", 0);
    assert(str_len(o.text) == 0, "empty");
    assert(o.confidence == 0.0, "confidence 0");
    return 0;
}

fn _t_extract_text_binary_garbage(): i64 {
    test_group("test_extract_text_binary_garbage");
    var data: u8[100];
    var i = 0;
    while (i < 100) {
        store8(&data + i, (i * 7) % 20);
        i = i + 1;
    }
    var o: *SlOcrResult = selah_extract_text_regions(&data, 100);
    assert(str_len(o.text) < 20, "little text");
    return 0;
}

fn _t_detect_email(): i64 {
    test_group("test_detect_email");
    assert(_t_one("contact user@example.com for info", SL_TARGET_EMAIL, "user@example.com"), "email");
