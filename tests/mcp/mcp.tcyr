fn _t_tool_redact_metadata_matches_reported_and_stripped(): i64 {
    test_group("test_tool_redact_metadata_matches_reported_and_stripped");
    _t_ctx();
    var dir = _t_dir();
    var img = _t_path(dir, "leaky.png");
    _t_write_png(img, 4, 4);
    var n = 0;
    var bytes = file_read_whole_max(img, 1048576, &n);
    var sb = str_builder_new();
    _sl_sb_bytes(sb, bytes, n);
    str_builder_putc(sb, 0);
    str_builder_add_cstr(sb, "contact admin@example.com");
    str_builder_putc(sb, 0);
    var leaky = str_builder_build(sb);
    file_write_all(img, str_data(leaky), str_len(leaky));
    var f, t = _t_run("selah_redact", _t_args(img, ""));
    assert(f == 0 && _t_str_has(_sl_json_as_str(_t_member(t, "warning")), "stub") == 1, "the stub warning");
    assert(bayan_json_v_arr_len(_t_member(t, "redactions")) == 0, "no redactions");
    var meta = _t_member(t, "metadata_matches");
    assert(bayan_json_v_arr_len(meta) == 1, "one metadata match");
    var m0 = bayan_json_v_arr_get(meta, 0);
    assert(_t_str_is(_sl_json_as_str(_sl_json_member(m0, "target_type")), "email") == 1, "email");
    assert(_t_str_is(_sl_json_as_str(_sl_json_member(m0, "matched_text")), "ad*************om") == 1, "masked");
    var wn = 0;
    var written = file_read_whole_max(_t_path(dir, "leaky_redacted.png"), 1048576, &wn);
    var leak = 0;
    var k = 0;
    while (k + 17 <= wn) {
        if (memeq(written + k, "admin@example.com", 17) == 1) { leak = 1; }
        k = k + 1;
    }
    assert(leak == 0, "embedded PII carried into the output");
    var it, iv = _sl_decode_image(written, wn);
    assert(is_ok(it) == 1, "the output decodes");
    return 0;
}

fn _t_inputs_must_be_images(): i64 {
    test_group("test_inputs_must_be_images");
    _t_ctx();
    var dir = _t_dir();
    var keyfile = _t_path(dir, "id_ed25519");
    var key = "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXk=\n";
    file_write_all(keyfile, key, strlen(key));
    var o = _t_path(dir, "o.png");
    var ob = str_builder_new();
    str_builder_add_cstr(ob, ",\"output\":");
    _sl_json_str(ob, o, strlen(o));
    var out_arg = str_data(str_builder_build(ob));
    var ab = str_builder_new();
    str_builder_add_cstr(ab, ",\"annotations\":[]");
    str_builder_add_cstr(ab, out_arg);
    var f1, t1 = _t_run("selah_ocr", _t_args(keyfile, ""));
    var f2, t2 = _t_run("selah_redact", _t_args(keyfile, out_arg));
    var f3, t3 = _t_run("selah_annotate", _t_args(keyfile, str_data(str_builder_build(ab))));
    assert(f1 == 1 && _t_str_has(t1, "not a supported image") == 1 && _t_str_has(t1, "PRIVATE KEY") == 0, "ocr");
    assert(f2 == 1 && _t_str_has(t2, "not a supported image") == 1 && _t_str_has(t2, "PRIVATE KEY") == 0, "redact");
    assert(f3 == 1 && _t_str_has(t3, "not a supported image") == 1 && _t_str_has(t3, "PRIVATE KEY") == 0,
      "annotate");
    return 0;
}

# {"output":"<p>"} as JSON, after the given prefix.
fn _t_out(prefix, p): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_cstr(sb, ",\"output\":");
    _sl_json_str(sb, p, strlen(p));
    return str_data(str_builder_build(sb));
}

fn _t_outputs_must_be_image_files(): i64 {
    test_group("test_outputs_must_be_image_files");
    _t_ctx();
    var dir = _t_dir();
    var img = _t_path(dir, "in.png");
    _t_write_png(img, 4, 4);
    var target = _t_path(dir, ".bashrc");
    file_write_all(target, "export SAFE=1\n", 14);
    var f, t = _t_run("selah_annotate", _t_args(img, _t_out(",\"annotations\":[]", target)));
    assert(f == 1 && _t_str_has(t, "image extension") == 1, "an image extension");
    var n = 0;
    var kept = file_read_whole_max(target, 64, &n);
    assert(n == 14 && memeq(kept, "export SAFE=1\n", 14) == 1, "untouched");
    var dir_out = _t_path(dir, "d.png");
    sys_mkdir(dir_out, 448);
    var f2, t2 = _t_run("selah_redact", _t_args(img, _t_out("", dir_out)));
    assert(f2 == 1 && _t_str_has(t2, "not a regular file") == 1, "a directory named like an image");
    var existing = _t_path(dir, "prev.png");
    _t_write_png(existing, 1, 1);
    var f3, t3 = _t_run("selah_redact", _t_args(img, _t_out("", existing)));
    assert(f3 == 0, "overwriting an existing image file is fine");
    return 0;
}

fn _t_output_symlink_refused(): i64 {
    test_group("test_output_symlink_refused");
    _t_ctx();
    var dir = _t_dir();
    var img = _t_path(dir, "in.png");
    _t_write_png(img, 4, 4);
    var victim = _t_path(dir, "victim.txt");
    file_write_all(victim, "keep me", 7);
    var link = _t_path(dir, "out.png");
    sys_symlink(victim, link);
    var f, t = _t_run("selah_annotate", _t_args(img, _t_out(",\"annotations\":[]", link)));
    assert(f == 1 && _t_str_has(t, "not a regular file") == 1, "refused");
    var n = 0;
    var kept = file_read_whole_max(victim, 64, &n);
    assert(n == 7 && memeq(kept, "keep me", 7) == 1, "the victim kept");
    return 0;
}

# _sl_mcp_output_path on JSON arguments and an input: (format, path Str).
fn _t_output_path(args, input, suffix): (i64, i64) {
    var v = _sl_json_parse(args, strlen(args));
    var path = 0;
    var msg = 0;
    var f = _sl_mcp_output_path(v, str_from(input), suffix, &path, &msg);
    return (f, path);
}

fn _t_default_output_without_extension_gets_png(): i64 {
    test_group("test_default_output_without_extension_gets_png");
    var f, p = _t_output_path("{}", "/data/shot", "annotated");
    assert(f == SL_FMT_PNG && _t_str_is(p, "/data/shot_annotated.png") == 1, "png added");
    var f2, p2 = _t_output_path("{}", "/data/a.webp", "redacted");
    assert(f2 == SL_FMT_WEBP, "webp kept");
    return 0;
}

