fn _t_tool_capture_validates_before_network(): i64 {
    test_group("test_tool_capture_validates_before_network");
    _t_ctx();
    var f1, t1 = _t_run("selah_capture", "{\"format\":\"tiff\"}");
    assert(f1 == 1 && _t_str_has(t1, "unsupported format") == 1, "tiff");
    var f2, t2 = _t_run("selah_capture", "{\"output\":\"../x.png\"}");
    assert(f2 == 1 && _t_str_has(t2, "path traversal") == 1, "traversal");
    var f3, t3 = _t_run("selah_capture", "{\"region\":{\"x\":0,\"y\":0,\"width\":0,\"height\":10}}");
    assert(f3 == 1 && _t_str_has(t3, "invalid region") == 1, "empty region");
    var f4, t4 = _t_run("selah_capture", "{\"region\":{\"x\":0}}");
    assert(f4 == 1 && _t_str_has(t4, "invalid region") == 1, "half a region");
    var f5, t5 = _t_run("selah_capture", "{\"output\":\"notes.txt\"}");
    assert(f5 == 1 && _t_str_has(t5, "image extension") == 1, "notes.txt");
    var f6, t6 = _t_run("selah_capture", "{\"output\":\"a.png\",\"format\":\"jpg\"}");
    assert(f6 == 1 && _t_str_has(t6, "extension") == 1, "a mismatch");
    return 0;
}

# A capture answer holding a w x h PNG.
fn _t_png_answer(w, h): i64 {
    var px = fl_calloc(w * h * 4);
    var plen = 0;
    var png = _sl_png_encode(px, w, h, &plen);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"image_data\":\"");
    str_builder_add_cstr(sb, bayan_base64_encode(png, plen));
    str_builder_add_cstr(sb, "\",\"width\":");
    str_builder_add_int(sb, w);
    str_builder_add_cstr(sb, ",\"height\":");
    str_builder_add_int(sb, h);
    str_builder_add_cstr(sb, ",\"format\":\"png\"}");
    return str_data(str_builder_build(sb));
}

fn _t_tool_capture_end_to_end_records_history(): i64 {
    test_group("test_tool_capture_end_to_end_records_history");
    var dir = _t_dir();
    var m = _mock_serve(200, _t_png_answer(3, 2));
    var store = SlHistoryStore_open(_t_path(dir, "history.jsonl"));
    var dd = selah_mcp_dispatcher(_mock_url(m), store);
    var outp = _t_path(dir, "cap.png");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"output\":");
    _sl_json_str(sb, outp, strlen(outp));
    str_builder_add_cstr(sb, ",\"region\":{\"x\":1,\"y\":2,\"width\":3,\"height\":4}}");
    var f, t = _t_run("selah_capture", str_data(str_builder_build(sb)));
    _mock_join(m);
    assert(f == 0 && bayan_json_v_int(_t_member(t, "width")) == 3, "width 3");
    assert(file_exists(outp) == 1, "the file is written");
    var path = _sl_json_as_str(_t_member(t, "path"));
    assert(load8(str_data(path)) == 47, "an absolute path");
    assert(_t_str_has(_mock_body(m), "\"region\":{\"x\":1,\"y\":2,\"width\":3,\"height\":4}") == 1, "the region sent");
    var lt, lv = SlHistoryStore_list(store, 10);
    assert(vec_len(lv) == 1, "recorded");
    var e: *SlHistoryEntry = _sl_as_history(vec_get(lv, 0));
    assert(_t_str_is(e.source, "region (3x4 at 1,2)") == 1, "the source");
    return 0;
}

fn _t_validate_path_rejects_traversal(): i64 {
    test_group("test_validate_path_rejects_traversal");
    var m = 0;
    assert(_sl_mcp_validate_path(str_from("../etc/passwd"), &m) == 0, "../etc/passwd");
    assert(_sl_mcp_validate_path(str_from("foo/../../bar"), &m) == 0, "foo/../../bar");
    assert(_sl_mcp_validate_path(str_from("screenshot.png"), &m) == 1, "screenshot.png");
    assert(_sl_mcp_validate_path(str_from("/tmp/screenshot.png"), &m) == 1, "/tmp/screenshot.png");
    assert(_sl_mcp_validate_path(str_from("subdir/file.png"), &m) == 1, "subdir/file.png");
    return 0;
}

fn _t_validate_path_rejects_empty_and_nul(): i64 {
    test_group("test_validate_path_rejects_empty_and_nul");
    var m = 0;
    assert(_sl_mcp_validate_path(str_from(""), &m) == 0, "empty");
    var nul = str_new("a\x00b", 3);
    assert(_sl_mcp_validate_path(nul, &m) == 0, "NUL");
    return 0;
}

fn _t_output_path_default_is_sibling_of_input(): i64 {
    test_group("test_output_path_default_is_sibling_of_input");
    var f, p = _t_output_path("{}", "/data/shots/a.png", "redacted");
    assert(_t_str_is(p, "/data/shots/a_redacted.png") == 1, "beside");
    var f2, p2 = _t_output_path("{}", "a.png", "annotated");
    assert(_t_str_is(p2, "a_annotated.png") == 1, "relative");
    var f3, p3 = _t_output_path("{\"output\":\"x.jpg\"}", "a.png", "s");
    assert(f3 == SL_FMT_JPEG && _t_str_is(p3, "x.jpg") == 1, "x.jpg");
    var f4, p4 = _t_output_path("{\"output\":5}", "a.png", "s");
    assert(f4 < 0, "a number");
    return 0;
}

fn _t_mask(s): i64 {
    return _sl_mask_pii(str_from(s));
}

fn _t_mask_pii(): i64 {
    test_group("test_mask_pii");
    assert(_t_str_is(_t_mask("user@example.com"), "us************om") == 1, "email");
    assert(_t_str_is(_t_mask("ab"), "**") == 1, "ab");
    assert(_t_str_is(_t_mask("abcde"), "ab*de") == 1, "abcde");
    return 0;
}

fn _t_mask_pii_multibyte_does_not_panic(): i64 {
    test_group("test_mask_pii_multibyte_does_not_panic");
    assert(_t_str_is(_t_mask("aü@x.com"), "aü****om") == 1, "aü");
    assert(_t_str_is(_t_mask("日本語メール"), "日本**ール") == 1, "CJK");
    assert(_t_str_is(_t_mask("ééé"), "***") == 1, "ééé");
    return 0;
}

fn _t_mask_pii_short(): i64 {
    test_group("test_mask_pii_single_char / _empty / _four_chars / _five_chars");
    assert(_t_str_is(_t_mask("x"), "*") == 1, "x");
    assert(_t_str_is(_t_mask(""), "") == 1, "empty");
    assert(_t_str_is(_t_mask("abcd"), "****") == 1, "abcd");
    assert(_t_str_is(_t_mask("abcde"), "ab*de") == 1, "abcde");
    return 0;
}

fn _t_validate_path_more(): i64 {
    test_group("test_validate_path_absolute / _relative_subdir / _double_traversal / _current_dir");
    var m = 0;
    assert(_sl_mcp_validate_path(str_from("/home/user/screenshot.png"), &m) == 1, "absolute");
    assert(_sl_mcp_validate_path(str_from("output/file.png"), &m) == 1, "subdir");
    assert(_sl_mcp_validate_path(str_from("a/../../etc/shadow"), &m) == 0, "double traversal");
    assert(_sl_mcp_validate_path(str_from("./screenshot.png"), &m) == 1, "current dir");
    return 0;
}

fn _t_error_content_format(): i64 {
    test_group("test_error_content_format");
    var r = _sl_mcp_error_content(str_from("something went wrong"));
    var v = _sl_json_parse(r, strlen(r));
    assert(bayan_json_v_bool(_sl_json_member(v, "isError")) != 0, "isError");
    var c = _sl_json_member(v, "content");
    assert(bayan_json_v_arr_len(c) == 1, "one block");
    var b = bayan_json_v_arr_get(c, 0);
    assert(_t_str_is(_sl_json_as_str(_sl_json_member(b, "type")), "text") == 1, "text");
    assert(_t_str_is(_sl_json_as_str(_sl_json_member(b, "text")), "something went wrong") == 1, "the message");
    return 0;
}

# ── Cyrius-only ──────────────────────────────────────────────────────────────────────

# chrono's parse_from_rfc3339 on a NUL-terminated string: its error kind, or 0 with the instant at out[0..2).
fn _t_strict(s, out): i64 {
    return _sl_rfc3339_strict(s, strlen(s), out, _sl_addr(out) + 8);
}

fn _t_rfc3339_strict(): i64 {
    test_group("chrono's strict RFC 3339 (selah_history's since)");
    var o: i64[2];
    assert(_t_strict("2025-11-15T00:00:00Z", &o) == 0 && o[0] == 1763164800 && o[1] == 0, "Z");
    assert(_t_strict("2025-11-15T02:00:00.5+02:00", &o) == 0 && o[0] == 1763164800 && o[1] == 500000000, "+02:00");
    assert(_t_strict("2016-12-31T23:59:60Z", &o) == 0 && o[1] == 1000000000, "a leap second");
    assert(_t_strict("yesterday", &o) == SL_CHRONO_TOO_SHORT, "premature end of input");
    assert(_t_strict("2025-11-15T00:00:00", &o) == SL_CHRONO_TOO_SHORT, "no offset");
    assert(_t_strict("2025-11-15T00:00:00Zx", &o) == SL_CHRONO_TOO_LONG, "trailing input");
    assert(_t_strict("2025-02-29T00:00:00Z", &o) == SL_CHRONO_OUT_OF_RANGE, "no 29 February in 2025");
    assert(_t_strict("2025-11-15X00:00:00Z", &o) == SL_CHRONO_INVALID, "a bad separator");
    assert(_t_strict("2025-11-15T00:00:00+99:00", &o) == SL_CHRONO_OUT_OF_RANGE, "+99:00");
    assert(_t_strict("2025-11-15T00:00:00+0200", &o) == SL_CHRONO_INVALID, "a colon is required");
    return 0;
}

fn _t_hoosh_engine(): i64 {
    test_group("selah_ocr engine hoosh, through the retargeted client");
    var dir = _t_dir();
    var img = _t_path(dir, "in.png");
    _t_write_png(img, 2, 2);
    _t_ctx();
    var f0, t0 = _t_run("selah_ocr", _t_args(img, ",\"engine\":\"hoosh\""));
    assert(f0 == 1 && _t_str_has(t0, "no model is set") == 1, "no model: refused before sending");
    var ans = "{\"choices\":[{\"message\":{\"content\":\"{\\\"text\\\":\\\"hi\\\",\\\"confidence\\\":0.75}\"}}]}";
    var m = _mock_serve(200, ans);
    selah_mcp_set_hoosh_config(SlHooshConfig_new(_mock_url(m), "vision"));
    var f, t = _t_run("selah_ocr", _t_args(img, ",\"engine\":\"hoosh\""));
    _mock_join(m);
    assert(f == 0 && _t_str_is(_sl_json_as_str(_t_member(t, "text")), "hi") == 1, "the model's text");
    assert(_t_str_is(_sl_json_as_str(_t_member(t, "engine")), "hoosh") == 1, "engine hoosh");
    assert(bayan_json_v_bool(_t_member(t, "is_stub")) == 0, "not a stub");
    return 0;
}

# Writes data[0..n) to fd whole.
fn _t_write_fd(fd, data, n): i64 {
    var w = 0;
    while (w < n) {
        var r = sys_write(fd, data + w, n - w);
        if (r <= 0) { return w; }
        w = w + r;
    }
    return w;
}

# A selah_annotate request on one line with `count` annotations.
fn _t_annotate_line(id, img, count): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"method\":\"tools/call\",\"params\":{\"name\":\"selah_annotate\",\"arguments\":");
    str_builder_add_cstr(sb, "{\"image_path\":");
    _sl_json_str(sb, img, strlen(img));
    str_builder_add_cstr(sb, ",\"annotations\":[");
    var i = 0;
    while (i < count) {
        if (i > 0) { str_builder_putc(sb, 44); }
        str_builder_add_cstr(sb, "{\"kind\":\"rectangle\",\"position\":{\"x\":1,\"y\":1,\"width\":2,\"height\":2}}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}}}\n");
    return str_builder_build(sb);
}

fn _t_stdio_end_to_end(): i64 {
    test_group("the stdio transport, end to end (bote's 128 KiB line)");
    var dir = _t_dir();
    var img = _t_path(dir, "in.png");
    _t_write_png(img, 4, 4);
    var ip: u8[16];
    var op: u8[16];
    sys_pipe(&ip);
    sys_pipe(&op);
    var pid = sys_fork();
    if (pid == 0) {
        sys_close(load32(&ip + 4));
        sys_close(load32(&op));
        var d = selah_mcp_dispatcher("http://127.0.0.1:9", 0);
        _stdio_serve(d, load32(&ip), load32(&op + 4));
        sys_exit(0);
    }
    sys_close(load32(&ip));
    sys_close(load32(&op + 4));
    # 1,300 bare rectangles (87,261 bytes with this path) fit bote's 131,072-byte line; 2,000 (134,161) do not.
    var small = _t_annotate_line(7, img, 1300);
    var big = _t_annotate_line(8, img, 2000);
    _t_write_fd(load32(&ip + 4), str_data(small), str_len(small));
    _t_write_fd(load32(&ip + 4), str_data(big), str_len(big));
    sys_close(load32(&ip + 4));
    var buf = fl_alloc(65536);
    var got = 0;
    while (got < 65535) {
        var r2 = sys_read(load32(&op), buf + got, 65535 - got);
        if (r2 <= 0) { break; }
        got = got + r2;
    }
    store8(buf + got, 0);
    var st: u8[8];
    sys_waitpid(pid, &st, 0);
    var out = str_from(buf);
    assert(str_len(small) < 131072 && str_len(big) > 131072, "the two sizes straddle the line");
    assert(_t_str_has(out, "\\\"annotation_count\\\":1300") == 1, "the request under the line is answered");
    assert(_t_str_has(out, "\\\"annotation_count\\\":2000") == 0, "the one over it is not run (UPSTREAM L23)");
    return 0;
}

# Runs the suite; the exit code is the failure count, clamped.
fn main(): i64 {
    alloc_init();
    _t_registry_has_five_tools();
    _t_dispatcher_tools_list();
    _t_read_only_tools_annotated();
    _t_dispatcher_initialize();
    _t_dispatcher_unknown_method();
    _t_dispatcher_tool_error_is_mcp_error_content();
    _t_tool_ocr_missing_path();
    _t_tool_ocr_local_and_unknown_engine();
    _t_tool_ocr_rejects_non_regular_file();
    _t_tool_history_without_store();
    _t_tool_history_lists_and_validates();
    _t_tool_annotate_missing_path();
    _t_tool_annotate_schema_shaped_input();
    _t_tool_annotate_output_format_from_extension();
    _t_tool_annotate_rejects_bad_annotations();
    _t_tool_annotate_rejects_output_traversal();
    _t_tool_redact_missing_path();
    _t_tool_redact_rejects_output_traversal();
    _t_tool_redact_metadata_matches_reported_and_stripped();
    _t_inputs_must_be_images();
    _t_outputs_must_be_image_files();
    _t_output_symlink_refused();
    _t_default_output_without_extension_gets_png();
    _t_tool_redact_invalid_target();
    _t_tool_capture_validates_before_network();
    _t_tool_capture_end_to_end_records_history();
    _t_validate_path_rejects_traversal();
    _t_validate_path_rejects_empty_and_nul();
    _t_output_path_default_is_sibling_of_input();
    _t_mask_pii();
    _t_mask_pii_multibyte_does_not_panic();
    _t_mask_pii_short();
    _t_validate_path_more();
    _t_error_content_format();
    _t_rfc3339_strict();
    _t_hoosh_engine();
    _t_stdio_end_to_end();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
