# mcp.tcyr — rust-old/src/mcp.rs's tests, ported (port plan M6). The handlers are called directly through
# _sl_mcp_run, as Rust's tests call tool_* (bypassing bote's schema check), and the dispatcher through bote's
# codec_process_message. test_run_async_inside_current_thread_runtime has no counterpart: the port has no async
# runtime to nest. Cyrius-only: the stdio transport end to end (bote's 128 KiB line, L23), the
# hoosh engine through a mock, serverInfo, and chrono's strict RFC 3339 reading.
# tests/mcp/test.cyml prepends bote for this directory.

include "tests/selah_src.cyr"
include "tests/support.cyr"
include "tests/mock_http.cyr"
include "src/mcp.cyr"

var _t_dirs = 0;

# A new temp directory (NUL-terminated).
fn _t_dir(): i64 {
    _t_dirs = _t_dirs + 1;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/selah_mcp_test_");
    str_builder_add_int(sb, sys_getpid());
    str_builder_putc(sb, 95);
    str_builder_add_int(sb, _t_dirs);
    var d = str_data(str_builder_build(sb));
    sys_mkdir(d, 448);
    return d;
}

fn _t_path(dir, name): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_putc(sb, 47);
    str_builder_add_cstr(sb, name);
    return str_data(str_builder_build(sb));
}

# Rust's write_png: an opaque white w x h PNG at path.
fn _t_write_png(path, w, h): i64 {
    var px = fl_alloc(w * h * 4);
    memset(px, 255, w * h * 4);
    var n = 0;
    var png = _sl_png_encode(px, w, h, &n);
    file_write_all(path, png, n);
    return 0;
}

# Runs a tool on JSON arguments (a NUL-terminated string). Returns (failed, text Str).
fn _t_run(tool, args): (i64, i64) {
    var f, t = _sl_mcp_run(tool, args);
    return (f, t);
}

# Arguments JSON from pieces: {"image_path":"<p>"<rest>}.
fn _t_args(p, rest): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"image_path\":");
    _sl_json_str(sb, p, strlen(p));
    str_builder_add_cstr(sb, rest);
    str_builder_putc(sb, 125);
    return str_data(str_builder_build(sb));
}

# The payload's member `key` (JSON text, a NUL-terminated string).
fn _t_member(payload, key): i64 {
    var v = _sl_json_parse(str_data(payload), str_len(payload));
    return _sl_json_member(v, key);
}

fn _t_ctx(): i64 {
    return selah_mcp_dispatcher("http://127.0.0.1:9", 0);
}

fn _t_registry_has_five_tools(): i64 {
    test_group("test_registry_has_five_tools");
    var defs = selah_mcp_tool_definitions();
    assert(vec_len(defs) == 5, "five");
    var names = "selah_capture selah_annotate selah_ocr selah_redact selah_history";
    var i = 0;
    var found = 0;
    while (i < 5) {
        if (_t_str_has(str_from(names), tool_def_name(vec_get(defs, i))) == 1) { found = found + 1; }
        i = i + 1;
    }
    assert(found == 5, "each name");
    return 0;
}

fn _t_dispatcher_tools_list(): i64 {
    test_group("test_dispatcher_tools_list");
    var d = selah_mcp_dispatcher("http://127.0.0.1:9", 0);
    var r = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", d, 0);
    var v = _sl_json_parse(r, strlen(r));
    var tools = _sl_json_member(_sl_json_member(v, "result"), "tools");
    assert(tools != 0 && bayan_json_v_arr_len(tools) == 5, "five tools listed");
    return 0;
}

fn _t_read_only_tools_annotated(): i64 {
    test_group("test_read_only_tools_annotated");
    var defs = selah_mcp_tool_definitions();
    var ocr = tool_def_annotations(vec_get(defs, 2));
    var hist = tool_def_annotations(vec_get(defs, 4));
    assert(ocr != 0 && ann_read_only_hint(ocr) == HINT_TRUE, "selah_ocr read-only");
    assert(ann_open_world_hint(ocr) == HINT_TRUE, "selah_ocr open-world (the hoosh engine)");
    assert(hist != 0 && ann_read_only_hint(hist) == HINT_TRUE, "selah_history read-only");
    assert(tool_def_annotations(vec_get(defs, 1)) == 0, "selah_annotate has none");
    return 0;
}

fn _t_dispatcher_initialize(): i64 {
    test_group("test_dispatcher_initialize");
    var d = selah_mcp_dispatcher("http://127.0.0.1:9", 0);
    var r = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}", d, 0);
    var res = _sl_json_member(_sl_json_parse(r, strlen(r)), "result");
    assert(_sl_json_member(res, "protocolVersion") != 0 && _sl_json_member(res, "serverInfo") != 0, "present");
    var name = _sl_json_as_str(_sl_json_member(_sl_json_member(res, "serverInfo"), "name"));
    assert(_t_str_is(name, "selah") == 1, "the server is selah (Rust's bote named itself)");
    return 0;
}

fn _t_dispatcher_unknown_method(): i64 {
    test_group("test_dispatcher_unknown_method");
    var d = selah_mcp_dispatcher("http://127.0.0.1:9", 0);
    var r = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"nonexistent\"}", d, 0);
    var err = _sl_json_member(_sl_json_parse(r, strlen(r)), "error");
    assert(err != 0 && bayan_json_v_int(_sl_json_member(err, "code")) == -32601, "-32601");
    return 0;
}

fn _t_dispatcher_tool_error_is_mcp_error_content(): i64 {
    test_group("test_dispatcher_tool_error_is_mcp_error_content");
    var d = selah_mcp_dispatcher("http://127.0.0.1:9", 0);
    var qb = str_builder_new();
    str_builder_add_cstr(qb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":");
    str_builder_add_cstr(qb, "{\"name\":\"selah_ocr\",\"arguments\":{\"image_path\":\"../etc/passwd\"}}}");
    var r = codec_process_message(str_data(str_builder_build(qb)), d, 0);
    var res = _sl_json_member(_sl_json_parse(r, strlen(r)), "result");
    assert(bayan_json_v_bool(_sl_json_member(res, "isError")) != 0, "isError");
    var text = _sl_json_as_str(_sl_json_member(bayan_json_v_arr_get(_sl_json_member(res, "content"), 0), "text"));
    assert(_t_str_has(text, "path traversal") == 1, "the reason");
    return 0;
}

