fn _t_tool_history_lists_and_validates(): i64 {
    test_group("test_tool_history_lists_and_validates");
    var dir = _t_dir();
    var store = SlHistoryStore_open(_t_path(dir, "history.jsonl"));
    var dd = selah_mcp_dispatcher("http://127.0.0.1:9", store);
    var i = 0;
    while (i < 3) {
        var id: u8[16];
        _sl_uuid_v4(&id);
        var ns = clock_epoch_ns();
        var e = SlHistoryEntry_new(&id, "/tmp/x.png", 10, ns / 1000000000, ns % 1000000000, "full screen", 11, 10,
          20, "png", 3);
        SlHistoryStore_record(store, e);
        i = i + 1;
    }
    var f, t = _t_run("selah_history", "{\"limit\":2}");
    var shots = _t_member(t, "screenshots");
    assert(f == 0 && bayan_json_v_arr_len(shots) == 2, "two");
    var dims = _sl_json_as_str(_sl_json_member(bayan_json_v_arr_get(shots, 0), "dimensions"));
    assert(_t_str_is(dims, "10x20") == 1, "10x20");
    var f2, t2 = _t_run("selah_history", "{\"since\":\"yesterday\"}");
    assert(f2 == 1 && _t_str_has(t2, "invalid since") == 1, "invalid since");
    var f3, t3 = _t_run("selah_history", "{\"limit\":-1}");
    assert(f3 == 1 && _t_str_has(t3, "non-negative") == 1, "non-negative");
    var f4, t4 = _t_run("selah_history", "{\"since\":\"2000-01-01T00:00:00Z\"}");
    assert(f4 == 0, "since 2000");
    return 0;
}

