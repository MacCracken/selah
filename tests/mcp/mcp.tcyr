fn _t_tool_ocr_local_and_unknown_engine(): i64 {
    test_group("test_tool_ocr_local_and_unknown_engine");
    _t_ctx();
    var dir = _t_dir();
    var img = _t_path(dir, "in.png");
    _t_write_png(img, 2, 2);
    var f, t = _t_run("selah_ocr", _t_args(img, ""));
    assert(f == 0 && _t_str_is(_sl_json_as_str(_t_member(t, "engine")), "local") == 1, "local");
    assert(bayan_json_v_bool(_t_member(t, "is_stub")) != 0, "stub");
    var f2, t2 = _t_run("selah_ocr", _t_args(img, ",\"engine\":\"magic\""));
    assert(f2 == 1 && _t_str_has(t2, "unknown OCR engine") == 1, "unknown engine");
    assert(_t_str_is(t2, "unknown OCR engine \"magic\" (use local or hoosh)") == 1, "Rust's text");
    return 0;
}

