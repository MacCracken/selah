        ",\"annotations\":[{\"kind\":\"blob\",\"position\":{\"x\":0,\"y\":0,\"width\":1,\"height\":1}}]"));
    assert(f == 1 && _t_str_has(t, "invalid annotation 0") == 1, "bad kind");
    var f2, t2 = _t_run("selah_annotate", _t_args(img,
        ",\"annotations\":[{\"kind\":\"arrow\",\"position\":{\"x\":1e39,\"y\":0,\"width\":1,\"height\":1}}]"));
    assert(f2 == 1, "bad rect");
    var f3, t3 = _t_run("selah_annotate", _t_args(img, ",\"annotations\":{}"));
    assert(f3 == 1 && _t_str_has(t3, "array") == 1, "not an array");
    return 0;
}

