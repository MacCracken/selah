fn _t_tool_annotate_schema_shaped_input(): i64 {
    test_group("test_tool_annotate_schema_shaped_input");
    _t_ctx();
    var dir = _t_dir();
    var img = _t_path(dir, "shot.png");
    _t_write_png(img, 8, 8);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ",\"annotations\":[{\"kind\":\"redaction\",\"position\":{\"x\":0,\"y\":0,\"width\":4,");
    str_builder_add_cstr(sb, "\"height\":4}},{\"kind\":\"Rectangle\",\"position\":{\"x\":1,\"y\":1,\"width\":5,");
    str_builder_add_cstr(sb, "\"height\":5},\"color\":{\"r\":0,\"g\":0,\"b\":255,\"a\":255}},{\"kind\":\"text\",");
    str_builder_add_cstr(sb, "\"position\":{\"x\":0,\"y\":0,\"width\":8,\"height\":8},\"text\":\"hi\"}]");
    var f, t = _t_run("selah_annotate", _t_args(img, str_data(str_builder_build(sb))));
    assert(f == 0 && bayan_json_v_int(_t_member(t, "annotation_count")) == 3, "three");
    assert(_t_str_is(_sl_json_as_str(_t_member(t, "path")), _t_path(dir, "shot_annotated.png")) == 1,
      "default output beside the input");
    var n = 0;
    var bytes = file_read_whole_max(_t_path(dir, "shot_annotated.png"), 1048576, &n);
    var it, iv = _sl_decode_image(bytes, n);
    var im: *SlImage = _sl_as_image(iv);
    assert(is_ok(it) == 1 && load32(im.pixels) == 4278190080, "pixel (0,0) is opaque black");
    return 0;
}

fn _t_tool_annotate_output_format_from_extension(): i64 {
    test_group("test_tool_annotate_output_format_from_extension");
    _t_ctx();
    var dir = _t_dir();
    var img = _t_path(dir, "in.png");
    _t_write_png(img, 4, 4);
    var outp = _t_path(dir, "out.jpg");
    var rb = str_builder_new();
    str_builder_add_cstr(rb, ",\"annotations\":[],\"output\":");
    _sl_json_str(rb, outp, strlen(outp));
    var f, t = _t_run("selah_annotate", _t_args(img, str_data(str_builder_build(rb))));
    assert(f == 0 && _t_str_is(_sl_json_as_str(_t_member(t, "format")), "jpg") == 1, "jpg");
    var n = 0;
    var bytes = file_read_whole_max(outp, 1048576, &n);
    assert(n > 2 && load8(bytes) == 255 && load8(bytes + 1) == 216, "a JPEG");
    return 0;
}

fn _t_tool_annotate_rejects_bad_annotations(): i64 {
    test_group("test_tool_annotate_rejects_bad_annotations");
