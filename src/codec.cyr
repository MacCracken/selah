# codec.cyr — image decode through chitra, the decode limits, encode dispatch and convert_format.
#
# Rust: rust-old/src/annotate.rs `decode_image`, `encode_image`, `convert_format` and the two limits. Port plan D1,
# D10; ADR 0002 #1, #3, #16; ADR 0003.
#
# Decoding:
#   1. The signature decides the format (Rust: `image`'s guess_format). PNG, JPEG and BMP go on; WebP is refused
#      with UnsupportedFormat (ADR 0002 #1); GIF and anything unrecognised are refused as Rust refuses them, with
#      AnnotationError. GIF never reaches chitra (ADR 0002 #3: the audit kept unsupported decoders off the
#      untrusted-input path).
#   2. The header's dimensions are checked against Rust's limits **before anything is allocated**: a side over
#      MAX_IMAGE_DIMENSION, or more than MAX_DECODE_ALLOC bytes for the larger of the decoder's native buffer and the
#      RGBA8 copy (a 16-bit PNG's native buffer is 6 or 8 bytes a pixel). chitra is never asked to decode an image
#      selah's limits refuse. A header too damaged to read is handed to chitra, which reports the real reason.
#   3. chitra decodes, with its budgeted entry point at MAX_DECODE_ALLOC; under a budget the budget governs size
#      (chitra 1.4.0), so selah's limits are the only ones that bind. Baseline and progressive JPEG decode. Its
#      refusals map to AnnotationError, except a 4-component (CMYK / YCCK) JPEG, which the format allows and chitra's
#      RGBA entry points leave to the consumer: UnsupportedFormat (ADR 0002 #16).
#
# Memory: chitra decodes through `_sl_chitra_allocator()`, the freelist. Its working buffers go back before the
# decode returns, and SlImage_free hands the pixels and chitra's record back through `chitra_image_free`.

# Rust's MAX_IMAGE_DIMENSION: the largest width or height accepted when decoding.
var SL_MAX_IMAGE_DIMENSION = 32768;
# Rust's MAX_DECODE_ALLOC: the largest decoded buffer, checked from the header before any pixels are allocated.
var SL_MAX_DECODE_ALLOC = 536870912;

# A decoded image: width × height RGBA8 pixels, row-major, no padding. `owner` is 0 when selah allocated `pixels`
# (on the freelist), otherwise the chitra image that holds them.
struct SlImage { width: i64; height: i64; pixels: i64; owner: i64; }

# An allocation as a *SlImage.
#must_use
fn _sl_as_image(p): *SlImage {
    return p;
}

# A new w × h image of transparent black on the freelist (free it with SlImage_free); 0 when the size is not
# positive or memory runs out.
fn SlImage_new(w, h): *SlImage {
    if (w <= 0 || h <= 0) { return 0; }
    var img: *SlImage = _sl_as_image(fl_alloc(sizeof(SlImage)));
    if (img == 0) { return 0; }
    var px = fl_calloc(w * h * 4);
    if (px == 0) {
        fl_free(img);
        return 0;
    }
    img.width = w;
    img.height = h;
    img.pixels = px;
    img.owner = 0;
    return img;
}

# Releases an image and its pixels (chitra's through chitra_image_free). Safe on 0.
fn SlImage_free(img: *SlImage): i64 {
    if (img == 0) { return 0; }
    if (img.owner != 0) {
        chitra_image_free(img.owner);
    } else {
        fl_free(img.pixels);
    }
    fl_free(img);
    return 0;
}

# ---------------------------------------------------------------- chitra's allocator
#
# chitra 1.4.0's `_via` entry points take a stdlib Allocator (lib/alloc.cyr's 40-byte vtable) for every allocation
# of a decode. selah's is the freelist, so a long-running consumer (the MCP server) gets each image back. chitra
# zeroes every block it takes, so `alloc_fn` need not; it never reallocates or resets.

# The vtable. `_sl_chitra_allocator` writes it on every call: every value is the same each time, so two threads
# filling it at once never leave a slot another reads in a different state.
var _sl_chitra_vt: i64[5];

# alloc_fn: a freelist block.
fn _sl_chitra_alloc(st, size): i64 {
    return fl_alloc(size);
}

# realloc_fn: a new block with the old contents, the old one freed (chitra never calls it).
fn _sl_chitra_realloc(st, old, old_size, new_size): i64 {
    var p = fl_alloc(new_size);
    if (p == 0) { return 0; }
    if (old != 0) {
        var m = old_size;
        if (new_size < m) { m = new_size; }
        if (m > 0) { memcpy(p, old, m); }
        fl_free(old);
    }
    return p;
}

# free_fn: back to the freelist.
fn _sl_chitra_release(st, ptr): i64 {
    return fl_free(ptr);
}

# reset_fn: nothing to rewind (chitra never calls it).
fn _sl_chitra_reset(st): i64 {
    return 0;
}

# The freelist as a stdlib Allocator, for chitra.
fn _sl_chitra_allocator(): i64 {
    var a = &_sl_chitra_vt;
    store64(a, &_sl_chitra_alloc);
    store64(a + 8, &_sl_chitra_realloc);
    store64(a + 16, &_sl_chitra_release);
    store64(a + 24, &_sl_chitra_reset);
    store64(a + 32, 0);
    return a;
}

# ---------------------------------------------------------------- the signature

# What the signature says (Rust: image's guess_format, then the formats selah enables).
enum SlSniff {
    SL_SNIFF_UNKNOWN = 0;
    SL_SNIFF_PNG = 1;
    SL_SNIFF_JPEG = 2;
    SL_SNIFF_BMP = 3;
    SL_SNIFF_GIF = 4;
    SL_SNIFF_WEBP = 5;
}

#must_use
fn _sl_sniff(src, n): i64 {
    if (n >= 8 && memeq(src, "\x89PNG\r\n\x1a\n", 8) == 1) { return SL_SNIFF_PNG; }
    if (n >= 3 && load8(src) == 255 && load8(src + 1) == 216 && load8(src + 2) == 255) { return SL_SNIFF_JPEG; }
    if (n >= 2 && load8(src) == 66 && load8(src + 1) == 77) { return SL_SNIFF_BMP; }
    if (n >= 6 && (memeq(src, "GIF87a", 6) == 1 || memeq(src, "GIF89a", 6) == 1)) { return SL_SNIFF_GIF; }
    if (n >= 12 && memeq(src, "RIFF", 4) == 1 && memeq(src + 8, "WEBP", 4) == 1) { return SL_SNIFF_WEBP; }
    return SL_SNIFF_UNKNOWN;
}

#must_use
#pure
fn _sl_rd_be16(p): i64 {
    return (load8(p) << 8) | load8(p + 1);
}

#must_use
#pure
fn _sl_rd_be32(p): i64 {
    return (load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3);
}

#must_use
#pure
fn _sl_rd_le16(p): i64 {
    return load8(p) | (load8(p + 1) << 8);
}

#must_use
#pure
fn _sl_rd_le32(p): i64 {
    return load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24);
}

# A little-endian i32 as a signed value.
#must_use
#pure
fn _sl_rd_le32s(p): i64 {
    var v = _sl_rd_le32(p);
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}

# ---------------------------------------------------------------- the header probe
#
# Each probe stores the declared width, height and the decoder's native bytes per pixel (Rust: `image`'s
# `total_bytes` / (w × h)) through `out` (i64[3]), and returns 1, or 0 when the header can't be read: then chitra
# decides, and reports the real reason.

# PNG: IHDR, and for a 16-bit RGB or grey image whether a tRNS precedes the first IDAT (`image` expands it to alpha).
fn _sl_probe_png(src, n, out): i64 {
    if (n < 33 || _sl_rd_be32(src + 8) != 13 || memeq(src + 12, "IHDR", 4) != 1) { return 0; }
    var w = _sl_rd_be32(src + 16);
    var h = _sl_rd_be32(src + 20);
    var depth = load8(src + 24);
    var ctype = load8(src + 25);
    var ch = 4;
    if (ctype == 0) { ch = 1; }
    if (ctype == 2) { ch = 3; }
    if (ctype == 4) { ch = 2; }
    if (depth == 16 && (ctype == 0 || ctype == 2)) {
        var pos = 33;
        while (pos + 8 <= n) {
            var clen = _sl_rd_be32(src + pos);
            if (memeq(src + pos + 4, "IDAT", 4) == 1) { break; }
            if (memeq(src + pos + 4, "tRNS", 4) == 1) {
                ch = ch + 1;
                break;
            }
            pos = pos + 12 + clen;
        }
    }
    var bpp = ch;
    if (depth == 16) { bpp = ch * 2; }
    store64(out, w);
    store64(out + 8, h);
    store64(out + 16, bpp);
    return 1;
}

# JPEG: the first SOFn's dimensions (T.81 B.2.2). A height of 0 (one a DNL marker sets later) is left to chitra.
fn _sl_probe_jpeg(src, n, out): i64 {
    var pos = 2;
    while (pos + 4 <= n) {
        if (load8(src + pos) != 255) { return 0; }
        var m = load8(src + pos + 1);
        if (m == 255) {
            pos = pos + 1;
            continue;
        }
        if (m == 1 || (m >= 208 && m <= 216)) {
            pos = pos + 2;
            continue;
        }
        if (m == 218 || m == 217) { return 0; }
        var seg = _sl_rd_be16(src + pos + 2);
        if (m >= 192 && m <= 207 && m != 196 && m != 200 && m != 204) {
            if (pos + 9 > n) { return 0; }
            store64(out, _sl_rd_be16(src + pos + 7));
            store64(out + 8, _sl_rd_be16(src + pos + 5));
            store64(out + 16, 4);
            return 1;
        }
        pos = pos + 2 + seg;
    }
    return 0;
}

# BMP: the DIB header's width and |height| (a negative height is a top-down image).
fn _sl_probe_bmp(src, n, out): i64 {
    if (n < 26) { return 0; }
    var dib = _sl_rd_le32(src + 14);
    var w = 0;
    var h = 0;
    if (dib == 12) {
        w = _sl_rd_le16(src + 18);
        h = _sl_rd_le16(src + 20);
    } else {
        w = _sl_rd_le32s(src + 18);
        h = _sl_rd_le32s(src + 22);
        if (h < 0) { h = -h; }
    }
    store64(out, w);
    store64(out + 8, h);
    store64(out + 16, 4);
    return 1;
}

# ---------------------------------------------------------------- decode

# "failed to load image: " followed by `what`, as a Str, through detail_out; fails with `code`.
fn _sl_load_fail(code, detail_out, what): Result {
    if (detail_out == 0) { return Err(code); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "failed to load image: ");
    str_builder_add_cstr(sb, what);
    return _sl_fail(code, detail_out, str_builder_build(sb));
}

# Decodes under the largest side `max_dim` and the largest decoded buffer `max_alloc` (Rust:
# `decode_image_with_limits`, which its tests call with smaller limits). _sl_decode_image below is the entry point.
fn _sl_decode_image_with_limits(src, n, max_dim, max_alloc, detail_out = 0): Result {
    var kind = _sl_sniff(src, n);
    if (kind == SL_SNIFF_WEBP) {
        return _sl_fail_cstr(SL_ERR_UNSUPPORTED_FORMAT, detail_out, "WebP decoding is not supported (ADR 0002 #1)");
    }
    if (kind == SL_SNIFF_GIF) {
        return _sl_load_fail(SL_ERR_ANNOTATION, detail_out, "The image format Gif is not supported");
    }
    if (kind == SL_SNIFF_UNKNOWN) {
        return _sl_load_fail(SL_ERR_ANNOTATION, detail_out, "The image format could not be determined");
    }

    var info: i64[3];
    var known = 0;
    if (kind == SL_SNIFF_PNG) { known = _sl_probe_png(src, n, &info); }
    if (kind == SL_SNIFF_JPEG) { known = _sl_probe_jpeg(src, n, &info); }
    if (kind == SL_SNIFF_BMP) { known = _sl_probe_bmp(src, n, &info); }
    if (known == 1 && info[0] > 0 && info[1] > 0) {
        var w = info[0];
        var h = info[1];
        if (w > max_dim || h > max_dim) {
            return _sl_load_fail(SL_ERR_ANNOTATION, detail_out, "Image size exceeds limit");
        }
        var bpp = info[2];
        if (bpp < 4) { bpp = 4; }
        var needed = w * h * bpp;
        if (needed > max_alloc) {
            if (detail_out == 0) { return Err(SL_ERR_ANNOTATION); }
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "failed to load image: ");
            str_builder_add_int(sb, w);
            str_builder_add_cstr(sb, "x");
            str_builder_add_int(sb, h);
            str_builder_add_cstr(sb, " needs ");
            str_builder_add_int(sb, needed);
            str_builder_add_cstr(sb, " bytes, limit ");
            str_builder_add_int(sb, max_alloc);
            return _sl_fail(SL_ERR_ANNOTATION, detail_out, str_builder_build(sb));
        }
    }

    var err = 0;
    var ci = chitra_image_decode_budget_via(_sl_chitra_allocator(), src, n, max_alloc, &err);
    if (ci == 0) {
        var code = chitra_err_code(err);
        if (code == CHITRA_ERR_JPEG_COMPONENTS) {
            return _sl_fail_cstr(SL_ERR_UNSUPPORTED_FORMAT, detail_out,
                "CMYK and YCCK JPEG are not supported (ADR 0002 #16)");
        }
        return _sl_load_fail(SL_ERR_ANNOTATION, detail_out, chitra_err_name(code));
    }
    # The probe already enforced the limits when it could read the header; this holds them when it could not.
    if (chitra_image_width(ci) > max_dim || chitra_image_height(ci) > max_dim) {
        chitra_image_free(ci);
        return _sl_load_fail(SL_ERR_ANNOTATION, detail_out, "Image size exceeds limit");
    }
    var img: *SlImage = _sl_as_image(fl_alloc(sizeof(SlImage)));
    if (img == 0) {
        chitra_image_free(ci);
        return _sl_load_fail(SL_ERR_ANNOTATION, detail_out, "out of memory");
    }
    img.width = chitra_image_width(ci);
    img.height = chitra_image_height(ci);
    img.pixels = chitra_image_pixels(ci);
    img.owner = ci;
    return Ok(img);
}

# Decodes PNG, JPEG or BMP bytes to RGBA8 under selah's limits (Rust: annotate.rs `decode_image`). Returns
# Ok(*SlImage) (free it with SlImage_free), or Err: AnnotationError for a refusal, UnsupportedFormat for WebP and
# CMYK JPEG.
fn _sl_decode_image(src, n, detail_out = 0): Result {
    return _sl_decode_image_with_limits(src, n, SL_MAX_IMAGE_DIMENSION, SL_MAX_DECODE_ALLOC, detail_out);
}

# ---------------------------------------------------------------- encode

# Encodes an image as `fmt` (Rust: annotate.rs `encode_image`): PNG and BMP as 8-bit RGBA, JPEG as RGB at quality 75
# with the alpha dropped. Returns Ok(bytes) on the freelist (free them with selah_bytes_free), their length stored at
# `len_out`; Err(UnsupportedFormat) for WebP (ADR 0002 #1), Err(AnnotationError) when the encoder fails.
fn _sl_encode_image(img: *SlImage, fmt, len_out, detail_out = 0): Result {
    store64(len_out, 0);
    if (img == 0) { return _sl_fail_cstr(SL_ERR_ANNOTATION, detail_out, "failed to encode image: no image"); }
    var out = 0;
    match fmt {
        SL_FMT_PNG => { out = _sl_png_encode(img.pixels, img.width, img.height, len_out); }
        SL_FMT_BMP => { out = _sl_bmp_encode(img.pixels, img.width, img.height, len_out); }
        SL_FMT_JPEG => { out = _sl_jpeg_encode(img.pixels, img.width, img.height, SL_JPEG_QUALITY, len_out); }
        SL_FMT_WEBP => {
            return _sl_fail_cstr(SL_ERR_UNSUPPORTED_FORMAT, detail_out, "WebP encoding is not supported (ADR 0002 #1)");
        }
        _ => { return _sl_fail_cstr(SL_ERR_UNSUPPORTED_FORMAT, detail_out, "unknown image format"); }
    }
    if (out == 0) {
        return _sl_fail_cstr(SL_ERR_ANNOTATION, detail_out, "failed to encode image: out of memory or out of range");
    }
    return Ok(out);
}

# Releases bytes returned by selah_convert_format (and later the facade). Safe on 0.
fn selah_bytes_free(p): i64 {
    if (p != 0) { fl_free(p); }
    return 0;
}

# Converts image bytes to another format (Rust: `convert_format`). Decodes under selah's limits, then encodes as
# `target`. Returns Ok(bytes) on the freelist (free them with selah_bytes_free), their length stored at `len_out`.
fn selah_convert_format(src, n, target, len_out, detail_out = 0): Result {
    store64(len_out, 0);
    var dt, dv = _sl_decode_image(src, n, detail_out);
    if (is_err_result(dt) == 1) { return Err(dv); }
    var img: *SlImage = _sl_as_image(dv);
    _sl_log_kv(SK_DEBUG, "converting image format", "target", selah_image_format_extension(target));
    var et, ev = _sl_encode_image(img, target, len_out, detail_out);
    SlImage_free(img);
    if (is_err_result(et) == 1) { return Err(ev); }
    return Ok(ev);
}
