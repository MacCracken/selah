# selah — Cyrius port
# Ported from 7160 lines of Rust

# Stdlib auto-included via cyrius.cyml

# Build smoke entry: selah is a library; [lib] (from M1) is what consumers include.
fn main() {
    alloc_init();
    println("selah ready");
    return 0;
}

var r = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(r);
