# --- error.cyr ---

# error.cyr — selah's error codes (Rust: `SelahError`, rust-old/src/error.rs).
#
# Port plan D7, ADR 0002 #10. A fallible function returns a value-form `Result`: `Ok(value)` or `Err(SL_ERR_*)`.
# Rust's variants carry a `String`; here the text goes through the caller's optional trailing `detail_out`
# argument (a pointer to one i64 slot): when it is non-zero, the failing function stores a `Str` there, the same
# text the Rust variant held. `selah_error_display` adds the variant's prefix, as Rust's Display does.
#
# Values are append-only and never renumbered (the Rust enum is #[non_exhaustive]).

enum SlError {
    SL_ERR_NONE = 0;
    SL_ERR_CAPTURE_FAILED = 1;
    SL_ERR_INVALID_REGION = 2;
    SL_ERR_UNSUPPORTED_FORMAT = 3;
    SL_ERR_ANNOTATION = 4;
    SL_ERR_IO = 5;
    SL_ERR_API = 6;
    # A JSON document selah reads was refused. Rust surfaces serde_json's error inside another variant, or (in
    # the from_json paths the port exposes) as serde_json::Error itself; the port's message is its own
    # (ADR 0002 #14).
    SL_ERR_SERDE = 7;
}

# The variant's name, as Rust spells it.
#must_use
fn selah_error_name(code): i64 {
    match code {
        SL_ERR_NONE => { return "None"; }
        SL_ERR_CAPTURE_FAILED => { return "CaptureFailed"; }
        SL_ERR_INVALID_REGION => { return "InvalidRegion"; }
        SL_ERR_UNSUPPORTED_FORMAT => { return "UnsupportedFormat"; }
        SL_ERR_ANNOTATION => { return "AnnotationError"; }
        SL_ERR_IO => { return "Io"; }
        SL_ERR_API => { return "Api"; }
        SL_ERR_SERDE => { return "serde"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# The prefix Rust's Display writes before the message ("capture failed: ").
#must_use
fn _sl_error_prefix(code): i64 {
    match code {
        SL_ERR_CAPTURE_FAILED => { return "capture failed: "; }
        SL_ERR_INVALID_REGION => { return "invalid region: "; }
        SL_ERR_UNSUPPORTED_FORMAT => { return "unsupported format: "; }
        SL_ERR_ANNOTATION => { return "annotation error: "; }
        SL_ERR_IO => { return "IO error: "; }
        SL_ERR_API => { return "API error: "; }
        SL_ERR_SERDE => { return "JSON error: "; }
        _ => { return "error: "; }
    }
    return "error: ";
}

# Appends Rust's Display of the error: the variant's prefix, then the message (`msg` a Str, or 0).
fn selah_error_fmt(sb, code, msg): i64 {
    str_builder_add_cstr(sb, _sl_error_prefix(code));
    if (msg != 0) { str_builder_add(sb, msg); }
    return 0;
}

# Rust's Display of the error as a new Str.
#must_use
fn selah_error_display(code, msg): Str {
    var sb = str_builder_new();
    selah_error_fmt(sb, code, msg);
    return str_builder_build(sb);
}

# A pointer as a plain address: typed-pointer arithmetic steps by sizeof(T), so byte offsets go through this.
#must_use
fn _sl_addr(p): i64 {
    return p;
}

# Store `msg` (a Str) through `detail_out` when the caller asked for it, and fail with `code`.
fn _sl_fail(code, detail_out, msg): Result {
    if (detail_out != 0) { store64(detail_out, msg); }
    return Err(code);
}

# As _sl_fail, from a NUL-terminated string.
fn _sl_fail_cstr(code, detail_out, cmsg): Result {
    if (detail_out != 0) { store64(detail_out, str_from(cmsg)); }
    return Err(code);
}

# --- log.cyr ---

# log.cyr — selah's tracing, through sakshi (Rust: `tracing`; port plan D11).
#
# The contract is bote's (bote/src/log.cyr):
# - Every line goes through sakshi, to sakshi's configured output (stderr unless the embedder says otherwise). Never
#   stdout: on the MCP stdio transport stdout is the JSON-RPC wire.
# - Library code never configures sakshi. selah calls `_sl_log_*`, and sakshi's level filter decides.
# - Levels: WARN for a refusal or anomaly selah survives (an unlocatable PII match, a lock timeout), INFO for an
#   outcome (an image captured, copied to the clipboard), DEBUG for one line per operation.
# - Never log a secret or content: no API key, image bytes, OCR text or annotation text. A size, a count, a format,
#   a status or a path does.

# A WARN line.
fn _sl_log_warn(msg): i64 {
    sakshi_warn(msg, strlen(msg));
    return 0;
}

# An INFO line.
fn _sl_log_info(msg): i64 {
    sakshi_info(msg, strlen(msg));
    return 0;
}

# A DEBUG line.
fn _sl_log_debug(msg): i64 {
    sakshi_debug(msg, strlen(msg));
    return 0;
}

# A line with one key/value field: `level` is sakshi's (SK_WARN, SK_INFO, SK_DEBUG); `val` a NUL-terminated string.
fn _sl_log_kv(level, msg, key, val): i64 {
    sakshi_log_kv(level, msg, strlen(msg), key, strlen(key), val, strlen(val));
    return 0;
}

# --- fmtf.cyr ---

# fmtf.cyr — float text as Rust prints it: the shortest round-trip digits, in Rust's Display and serde_json's forms.
#
# UPSTREAM(L1): cyrius issue 2026-11-13-derive-debug-and-shortest-float-digits. The stdlib has no shortest
# round-trip printer, so this is impetus's `src/fmtf.cyr` (its ADR 0010: Burger & Dybvig's free-format algorithm,
# "Printing Floating-Point Numbers Quickly and Accurately", 1996, on a small exact bignum), generalised over the
# format as pravash's is (`hidden`, `emin`) so it prints f32 in its own shortest digits too. It leaves when the
# stdlib ships a printer.
#
# selah writes f32 rect coordinates into SVG through Rust's `Display` and every float in its JSON through
# serde_json 1.0.154 (zmij). Both print the shortest digits that read back, choosing the closest to the exact value
# among them; they differ on an exact tie between two closest candidates (core rounds it up, zmij to the even
# digit) and in where the digits go. tests/golden/fmtf.tsv pins all four forms against Rust.
#
# Forms (each appends to a str_builder):
# - `_sl_fmt_f32_display`, `_sl_fmt_f64_display`: Rust's `{}` — always positional, no ".0" (`100`, `0.1`, `-0`),
#   `NaN`, `inf`, `-inf`.
# - `_sl_fmt_f32_json`, `_sl_fmt_f64_json`: serde_json — positional while the decimal exponent is in −5..=15 (f64) or
#   −6..=12 (f32), with ".0" on an integer (`100.0`, `0.00001`); otherwise `d.ddde±x` (`1e+16`, `1.5e-7`); `null` for
#   NaN and ±∞.

# ── bits ──────────────────────────────────────────────────────────────────────────────

# The 64 bits of an f64.
#must_use
fn _sl_f64_bits(x): i64 {
    return x;
}

# The 32 bits of an f32.
#must_use
fn _sl_f32_bits(x: f32): i64 {
    var c: f32 = x;
    return load32(&c) & 0xFFFFFFFF;
}

# Appends n bytes at p in one copy, through a Str header on the stack (str_builder has no (ptr, len) form).
fn _sl_sb_bytes(sb, p, n): i64 {
    if (n <= 0) { return 0; }
    var hdr: i64[2];
    hdr[0] = p;
    hdr[1] = n;
    return str_builder_add(sb, &hdr);
}

# ── bignum ────────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs. 40 limbs
# hold 2^1280; the algorithm's values stay below 2^1140. No leading zero limbs.

# a := v, for 0 <= v < 2^63.
fn _sl_bn_set(a, v): i64 {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _sl_bn_copy(dst, src): i64 {
    var n = load64(src);
    var i = 0;
    while (i <= n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _sl_bn_mul_small(a, m): i64 {
    var n = load64(a);
    var carry = 0;
    var i = 0;
    while (i < n) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
        i = i + 1;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _sl_bn_mul_pow10(a, k): i64 {
    var left = k;
    while (left >= 9) {
        _sl_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    while (left > 0) {
        m = m * 10;
        left = left - 1;
    }
    if (m > 1) { _sl_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _sl_bn_shl(a, k): i64 {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        var i = 0;
        while (i < n) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
            i = i + 1;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var j = n - 1;
        while (j >= 0) {
            store64(a + 8 + (j + q) * 8, load64(a + 8 + j * 8));
            j = j - 1;
        }
        var z = 0;
        while (z < q) {
            store64(a + 8 + z * 8, 0);
            z = z + 1;
        }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _sl_bn_sum(dst, a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    var i = 0;
    while (i < n) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
        i = i + 1;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _sl_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return -1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return -1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _sl_bn_sub(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    var i = 0;
    while (i < na) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
        i = i + 1;
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _sl_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ───────────────────────────────────

# The shortest decimal digits of the positive finite value f × 2^e that read back to it in its format, the closest
# to its exact value among them. `hidden` is the format's hidden bit (2^52, 2^23) and `emin` its least exponent
# (-1074, -149): f = hidden with e > emin is a power of two, whose lower neighbour is half as far. When the exact
# value lies exactly halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer) and 1 the even one (serde_json's zmij). Writes the ASCII digits to `digits` (17 bytes is enough) and
# returns (n, k), with value = 0.d1d2…dn × 10^k.
fn _sl_shortest(f, e, hidden, emin, digits, tie_even): (i64, i64) {
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != hidden) {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, e + 1);
            _sl_bn_set(&s, 2);
            _sl_bn_set(&mp, 1);
            _sl_bn_shl(&mp, e);
            _sl_bn_copy(&mm, &mp);
        } else {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, e + 2);
            _sl_bn_set(&s, 4);
            _sl_bn_set(&mp, 1);
            _sl_bn_shl(&mp, e + 1);
            _sl_bn_set(&mm, 1);
            _sl_bn_shl(&mm, e);
        }
    } else {
        if (e == emin || f != hidden) {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, 1);
            _sl_bn_set(&s, 1);
            _sl_bn_shl(&s, 1 - e);
            _sl_bn_set(&mp, 1);
            _sl_bn_set(&mm, 1);
        } else {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, 2);
            _sl_bn_set(&s, 1);
            _sl_bn_shl(&s, 2 - e);
            _sl_bn_set(&mp, 2);
            _sl_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small (the fixup below adds
    # the one).
    var lg: f64 = f64_from(e + _sl_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _sl_bn_mul_pow10(&s, k);
    } else {
        _sl_bn_mul_pow10(&r, -k);
        _sl_bn_mul_pow10(&mp, -k);
        _sl_bn_mul_pow10(&mm, -k);
    }
    _sl_bn_sum(&t, &r, &mp);
    var c = _sl_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _sl_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    loop {
        _sl_bn_mul_small(&r, 10);
        _sl_bn_mul_small(&mp, 10);
        _sl_bn_mul_small(&mm, 10);
        var d = 0;
        while (_sl_bn_cmp(&r, &s) >= 0) {
            _sl_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _sl_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _sl_bn_sum(&t, &r, &mp);
        var hi = _sl_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _sl_bn_copy(&t, &r);
                _sl_bn_shl(&t, 1);
                var half = _sl_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── layout ────────────────────────────────────────────────────────────────────────────

# Appends `count` copies of byte c.
fn _sl_sb_repeat(sb, c, count): i64 {
    var i = 0;
    while (i < count) {
        str_builder_putc(sb, c);
        i = i + 1;
    }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer gets ".0"
# (serde_json's form).
fn _sl_sb_positional(sb, digits, n, k, int_suffix): i64 {
    if (k <= 0) {
        str_builder_putc(sb, 48);
        str_builder_putc(sb, 46);
        _sl_sb_repeat(sb, 48, -k);
        _sl_sb_bytes(sb, digits, n);
        return 0;
    }
    if (k >= n) {
        _sl_sb_bytes(sb, digits, n);
        _sl_sb_repeat(sb, 48, k - n);
        if (int_suffix == 1) {
            str_builder_putc(sb, 46);
            str_builder_putc(sb, 48);
        }
        return 0;
    }
    _sl_sb_bytes(sb, digits, k);
    str_builder_putc(sb, 46);
    _sl_sb_bytes(sb, digits + k, n - k);
    return 0;
}

# Appends 0.d1…dn × 10^k in serde_json's form: positional while the decimal exponent is in lo..=hi (zmij's ranges:
# −5..=15 for f64, −6..=12 for f32, as tests/golden/fmtf.tsv measures), otherwise d.ddd e±x.
fn _sl_sb_json_digits(sb, digits, n, k, lo, hi): i64 {
    var ex = k - 1;
    if (ex >= lo && ex <= hi) {
        return _sl_sb_positional(sb, digits, n, k, 1);
    }
    str_builder_putc(sb, load8(digits));
    if (n > 1) {
        str_builder_putc(sb, 46);
        _sl_sb_bytes(sb, digits + 1, n - 1);
    }
    str_builder_putc(sb, 101);
    if (ex >= 0) {
        str_builder_putc(sb, 43);
        str_builder_add_int(sb, ex);
    } else {
        str_builder_putc(sb, 45);
        str_builder_add_int(sb, -ex);
    }
    return 0;
}

# The shortest digits of an f64 magnitude (positive, finite, non-zero bits).
fn _sl_f64_digits(mag, digits, tie_even): (i64, i64) {
    var be = (mag >> 52) & 0x7FF;
    var f = mag & 0xFFFFFFFFFFFFF;
    var e = -1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    return _sl_shortest(f, e, 0x10000000000000, -1074, digits, tie_even);
}

# The shortest digits of an f32 magnitude (positive, finite, non-zero bits).
fn _sl_f32_digits(mag, digits, tie_even): (i64, i64) {
    var be = (mag >> 23) & 0xFF;
    var f = mag & 0x7FFFFF;
    var e = -149;
    if (be != 0) {
        f = f | 0x800000;
        e = be - 150;
    }
    return _sl_shortest(f, e, 0x800000, -149, digits, tie_even);
}

# ── the four forms ────────────────────────────────────────────────────────────────────

# Appends x as Rust's `Display` (`{}`) writes an f64.
fn _sl_fmt_f64_display(sb, x: f64): i64 {
    if (x != x) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    var bits = _sl_f64_bits(x);
    if (bits < 0) { str_builder_putc(sb, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_putc(sb, 48);
        return 0;
    }
    var digits[24];
    var n, k = _sl_f64_digits(mag, &digits, 0);
    return _sl_sb_positional(sb, &digits, n, k, 0);
}

# Appends x as serde_json 1.0.154 writes an f64 (zmij); `null` for NaN and ±∞.
fn _sl_fmt_f64_json(sb, x: f64): i64 {
    var bits = _sl_f64_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _sl_f64_digits(mag, &digits, 1);
    return _sl_sb_json_digits(sb, &digits, n, k, -5, 15);
}

# Appends x as Rust's `Display` (`{}`) writes an f32: its own shortest digits.
fn _sl_fmt_f32_display(sb, x: f32): i64 {
    var w = _sl_f32_bits(x);
    var mag = w & 0x7FFFFFFF;
    if (mag > 0x7F800000) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    if (((w >> 31) & 1) == 1) { str_builder_putc(sb, 45); }
    if (mag == 0x7F800000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_putc(sb, 48);
        return 0;
    }
    var digits[24];
    var n, k = _sl_f32_digits(mag, &digits, 0);
    return _sl_sb_positional(sb, &digits, n, k, 0);
}

# Appends x as serde_json 1.0.154 writes an f32 (zmij, its own shortest digits); `null` for NaN and ±∞.
fn _sl_fmt_f32_json(sb, x: f32): i64 {
    var w = _sl_f32_bits(x);
    var mag = w & 0x7FFFFFFF;
    if (mag >= 0x7F800000) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (((w >> 31) & 1) == 1) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _sl_f32_digits(mag, &digits, 1);
    return _sl_sb_json_digits(sb, &digits, n, k, -6, 12);
}

# --- json.cyr ---

# json.cyr — JSON as selah's Rust crate writes and reads it (serde_json 1.0.154), on bayan.
#
# UPSTREAM(L2): `#derive(Serialize)` has open defects (cyrius issues 2026-11-07-derive-serialize-*,
# 2026-11-11-derive-*, 2026-11-12-derive-serialize-in-a-second-private-file-fails-to-compile), so the codecs are
# written by hand: these helpers, and each type's own to_json / from_json beside it.
#
# Writing: byte-identical to serde_json. Strings escape `"`, `\` and the C0 controls (`\b \t \n \f \r`, the rest as
# `\u00xx`, lowercase); everything else, `/`, DEL and UTF-8 included, is written as it is. Floats go through
# fmtf.cyr's serde_json forms.
#
# Reading: bayan's value tree (`bayan_json_v_parse_buf`) and the typed getters below, which accept what serde's
# derived impls accept for each field type, and refuse what they refuse. A refusal is `SL_ERR_SERDE`; the message is
# the port's own, not serde_json's (ADR 0002 #14), so golden rows compare the verdict.

# ── writing ───────────────────────────────────────────────────────────────────────────

var _SL_HEX = "0123456789abcdef";

# Appends bytes p[0..n) as a JSON string, quotes included.
fn _sl_json_str(sb, p, n): i64 {
    str_builder_putc(sb, 34);
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 34) {
            str_builder_putc(sb, 92);
            str_builder_putc(sb, 34);
        } elif (c == 92) {
            str_builder_putc(sb, 92);
            str_builder_putc(sb, 92);
        } elif (c < 32) {
            str_builder_putc(sb, 92);
            if (c == 8) { str_builder_putc(sb, 98); }
            elif (c == 9) { str_builder_putc(sb, 116); }
            elif (c == 10) { str_builder_putc(sb, 110); }
            elif (c == 12) { str_builder_putc(sb, 102); }
            elif (c == 13) { str_builder_putc(sb, 114); }
            else {
                str_builder_add_cstr(sb, "u00");
                str_builder_putc(sb, load8(_SL_HEX + (c >> 4)));
                str_builder_putc(sb, load8(_SL_HEX + (c & 15)));
            }
        } else {
            str_builder_putc(sb, c);
        }
        i = i + 1;
    }
    str_builder_putc(sb, 34);
    return 0;
}

# Appends a Str as a JSON string.
fn _sl_json_str_s(sb, s): i64 {
    return _sl_json_str(sb, str_data(s), str_len(s));
}

# Appends `"key":` for a NUL-terminated key (selah's keys need no escaping).
fn _sl_json_key(sb, key): i64 {
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, 34);
    str_builder_putc(sb, 58);
    return 0;
}

# ── reading ───────────────────────────────────────────────────────────────────────────

# Parse p[0..n) into a bayan value tree; 0 when it isn't one JSON document.
#must_use
fn _sl_json_parse(p, n): i64 {
    if (n < 0) { return 0; }
    return bayan_json_v_parse_buf(p, n);
}

# The member `key` of object v: 0 when v is not an object or has no such member.
#must_use
fn _sl_json_member(v, key): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == false) { return 0; }
    return bayan_json_v_obj_get_by_cstr(v, key);
}

# A JSON number as serde reads it into an f64 field: an integer converts (Rust `as f64`), a float is the parse's
# correctly rounded double. Writes the value through `out` and returns 1, or returns 0 for anything else.
fn _sl_json_as_f64(v, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT) {
        var d: f64 = f64_from(bayan_json_v_int(v));
        store64(out, d);
        return 1;
    }
    if (tag == JTAG_FLOAT) {
        store64(out, bayan_json_v_float(v));
        return 1;
    }
    return 0;
}

# A JSON number as serde reads it into a u8 field: an integer 0..=255 only (a float, even 1.0, is refused, as
# serde_json refuses it). Returns the value, or -1.
#must_use
fn _sl_json_as_u8(v): i64 {
    if (v == 0) { return -1; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return -1; }
    var x = bayan_json_v_int(v);
    if (x < 0 || x > 255) { return -1; }
    return x;
}

# A JSON string's Str, or 0 when v is not a string.
#must_use
fn _sl_json_as_str(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    return bayan_json_v_str(v);
}

# serde_json's externally tagged enum forms: a string is a unit variant's name; an object of exactly one member is
# `{"<variant>": <content>}`. Returns the variant's name (a Str) and stores its content value through `content_out`
# (0 for the string form), or returns 0 when v is neither.
fn _sl_json_variant(v, content_out): i64 {
    store64(content_out, 0);
    if (v == 0) { return 0; }
    var s = _sl_json_as_str(v);
    if (s != 0) { return s; }
    if (bayan_json_v_is_obj(v) == false || bayan_json_v_obj_len(v) != 1) { return 0; }
    store64(content_out, bayan_json_v_obj_val(v, 0));
    var k = bayan_json_v_obj_key(v, 0);
    return k;
}

# 1 when a variant's content is what serde accepts for a unit variant: the string form, or `null`.
#must_use
fn _sl_json_unit_content(content): i64 {
    if (content == 0) { return 1; }
    if (bayan_json_v_is_null(content) == true) { return 1; }
    return 0;
}

# A struct read from a JSON array, as serde's derived `visit_seq` does: element i, or 0 when v is not an array of
# exactly `len` elements.
#must_use
fn _sl_json_seq_elem(v, len, i): i64 {
    if (v == 0 || bayan_json_v_is_arr(v) == false) { return 0; }
    if (bayan_json_v_arr_len(v) != len) { return 0; }
    return bayan_json_v_arr_get(v, i);
}

# A struct field, from either serde form: object member `key`, or array element i of `len`.
#must_use
fn _sl_json_field(v, key, len, i): i64 {
    if (v != 0 && bayan_json_v_is_arr(v) == true) { return _sl_json_seq_elem(v, len, i); }
    return _sl_json_member(v, key);
}

# --- uuid.cyr ---

# uuid.cyr — selah's ids (Rust: uuid 1.29.2 `Uuid`), as 16 bytes in RFC 4122 order.
#
# Written hyphenated and lowercase (serde, Display) or simple (`Uuid::simple`, the SVG arrow-marker ids); read
# through serde, which takes `Uuid::parse_str`'s four forms: hyphenated (36), simple (32 hex), braced (`{…}`, 38)
# and URN (`urn:uuid:` + hyphenated, the prefix in any case), the hex digits in any case. tests/golden/uuid.tsv pins
# both directions.

# A random (version 4, RFC 4122 variant) id into out[0..16). Returns 1, or 0 when the kernel gives no entropy.
fn _sl_uuid_v4(out): i64 {
    if (random_bytes(out, 16) != 16) { return 0; }
    store8(out + 6, (load8(out + 6) & 0x0F) | 0x40);
    store8(out + 8, (load8(out + 8) & 0x3F) | 0x80);
    return 1;
}

# Appends the 16 bytes at b as lowercase hex, hyphenated (8-4-4-4-12) when `hyphens` is 1.
fn _sl_uuid_fmt(sb, b, hyphens): i64 {
    var i = 0;
    while (i < 16) {
        if (hyphens == 1 && (i == 4 || i == 6 || i == 8 || i == 10)) { str_builder_putc(sb, 45); }
        var x = load8(b + i);
        str_builder_putc(sb, load8(_SL_HEX + (x >> 4)));
        str_builder_putc(sb, load8(_SL_HEX + (x & 15)));
        i = i + 1;
    }
    return 0;
}

# The value of one hex digit, or -1.
#must_use
fn _sl_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}

# Parse 32 hex digits from p (skipping a hyphen at each of `hyphens`' positions when 1) into out. 1 on success.
fn _sl_uuid_hex(p, n, out, hyphens): i64 {
    var i = 0;
    var o = 0;
    while (i < n) {
        if (hyphens == 1 && (i == 8 || i == 13 || i == 18 || i == 23)) {
            if (load8(p + i) != 45) { return 0; }
            i = i + 1;
            continue;
        }
        var hi = _sl_hexval(load8(p + i));
        var lo = -1;
        if (i + 1 < n) { lo = _sl_hexval(load8(p + i + 1)); }
        if (hi < 0 || lo < 0) { return 0; }
        if (o >= 16) { return 0; }
        store8(out + o, (hi << 4) | lo);
        o = o + 1;
        i = i + 2;
    }
    if (o != 16) { return 0; }
    return 1;
}

# Parse an id in any of `Uuid::parse_str`'s forms into out[0..16). Returns 1, or 0 when it is none of them.
fn _sl_uuid_parse(p, n, out): i64 {
    if (n == 32) { return _sl_uuid_hex(p, 32, out, 0); }
    if (n == 36) { return _sl_uuid_hex(p, 36, out, 1); }
    if (n == 38 && load8(p) == 123 && load8(p + 37) == 125) { return _sl_uuid_hex(p + 1, 36, out, 1); }
    if (n == 45) {
        var pre = "urn:uuid:";
        var i = 0;
        while (i < 9) {
            var c = load8(p + i);
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != load8(pre + i)) { return 0; }
            i = i + 1;
        }
        return _sl_uuid_hex(p + 9, 36, out, 1);
    }
    return 0;
}

# --- rfc3339.cyr ---

# rfc3339.cyr — selah's timestamps (Rust: chrono 0.4.45 `DateTime<Utc>` through serde).
#
# UPSTREAM(L5): lib/chrono.cyr's iso8601 / iso8601_parse are whole seconds only. A history entry's timestamp keeps
# nanoseconds, so this module writes and reads them as chrono does:
# - writing (serde's `Serialize`): `YYYY-MM-DDTHH:MM:SS[.f]Z`, with the shortest of 0, 3, 6 or 9 fraction digits
#   (chrono's `SecondsFormat::AutoSi`);
# - reading (serde's `Deserialize`, i.e. `DateTime<FixedOffset>::from_str`, chrono's `parse_rfc3339_relaxed`), item
#   by item: every numeric item first skips Unicode whitespace; the year is 1–4 digits, or a sign and any digits;
#   month, day, hour, minute and second are 1–2 digits each; whitespace may surround each `-` and `:`; the date and
#   time are separated by `T`, `t` or one space; an optional `.` and at least one digit gives the nanoseconds (the
#   first nine digits count, the rest are skipped); then optional whitespace and `UTC` (any case), `Z`, `z`, or a
#   sign (`+`, `-`, U+2212) with two hour digits, any run of `:` and whitespace, and two minute digits; trailing
#   whitespace is allowed. Second 60 is a leap second: second 59 with 10^9 added to the nanoseconds.
# tests/golden/rfc3339.tsv pins both directions.

# Days since 1970-01-01 of a proleptic Gregorian date (Howard Hinnant's days_from_civil; any year).
#must_use
fn _sl_days_from_civil(y, m, d): i64 {
    var yy = y;
    if (m <= 2) { yy = yy - 1; }
    var era = yy / 400;
    if (yy < 0 && yy % 400 != 0) { era = era - 1; }
    var yoe = yy - era * 400;
    var mp = (m + 9) % 12;
    var doy = (153 * mp + 2) / 5 + d - 1;
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

# The civil date (y, m, d) of a day count since 1970-01-01 (civil_from_days).
fn _sl_civil_from_days(z0): (i64, i64, i64) {
    var z = z0 + 719468;
    var era = z / 146097;
    if (z < 0 && z % 146097 != 0) { era = era - 1; }
    var doe = z - era * 146097;
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y = yoe + era * 400;
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    var mp = (5 * doy + 2) / 153;
    var d = doy - (153 * mp + 2) / 5 + 1;
    var m = mp + 3;
    if (m > 12) { m = m - 12; }
    if (m <= 2) { y = y + 1; }
    return (y, m, d);
}

# Appends v as exactly `width` decimal digits (v >= 0).
fn _sl_sb_digits_n(sb, v, width): i64 {
    var buf[24];
    var i = width - 1;
    var x = v;
    while (i >= 0) {
        store8(&buf + i, 48 + x % 10);
        x = x / 10;
        i = i - 1;
    }
    return _sl_sb_bytes(sb, &buf, width);
}

# Appends the instant (unix seconds, nanoseconds 0..=1_999_999_999) as chrono's serde writes a DateTime<Utc>,
# without quotes.
fn _sl_rfc3339_fmt(sb, secs, nanos): i64 {
    var days = secs / 86400;
    var sod = secs % 86400;
    if (sod < 0) {
        sod = sod + 86400;
        days = days - 1;
    }
    var y, mo, d = _sl_civil_from_days(days);
    if (y >= 0 && y <= 9999) {
        _sl_sb_digits_n(sb, y, 4);
    } else {
        if (y < 0) { str_builder_putc(sb, 45); } else { str_builder_putc(sb, 43); }
        var ay = y;
        if (ay < 0) { ay = -ay; }
        if (ay < 10000) { _sl_sb_digits_n(sb, ay, 4); } else { str_builder_add_int(sb, ay); }
    }
    str_builder_putc(sb, 45);
    _sl_sb_digits_n(sb, mo, 2);
    str_builder_putc(sb, 45);
    _sl_sb_digits_n(sb, d, 2);
    str_builder_putc(sb, 84);
    var sec = sod % 60;
    var ns = nanos;
    # A leap second is stored as second 59 with 10^9 added; it prints as second 60.
    if (ns >= 1000000000) {
        sec = sec + 1;
        ns = ns - 1000000000;
    }
    _sl_sb_digits_n(sb, sod / 3600, 2);
    str_builder_putc(sb, 58);
    _sl_sb_digits_n(sb, (sod / 60) % 60, 2);
    str_builder_putc(sb, 58);
    _sl_sb_digits_n(sb, sec, 2);
    if (ns != 0) {
        str_builder_putc(sb, 46);
        if (ns % 1000000 == 0) {
            _sl_sb_digits_n(sb, ns / 1000000, 3);
        } elif (ns % 1000 == 0) {
            _sl_sb_digits_n(sb, ns / 1000, 6);
        } else {
            _sl_sb_digits_n(sb, ns, 9);
        }
    }
    str_builder_putc(sb, 90);
    return 0;
}

# ── parsing ──────────────────────────────────────────────────────────────────────────

# The length of the Unicode whitespace character (Rust's char::is_whitespace) at p[i..n), or 0.
#must_use
fn _sl_ws_len(p, i, n): i64 {
    if (i >= n) { return 0; }
    var c = load8(p + i);
    if (c == 32 || (c >= 9 && c <= 13)) { return 1; }
    if (c == 0xC2 && i + 1 < n) {
        var c2 = load8(p + i + 1);
        if (c2 == 0x85 || c2 == 0xA0) { return 2; }
        return 0;
    }
    if (c == 0xE1 && i + 2 < n && load8(p + i + 1) == 0x9A && load8(p + i + 2) == 0x80) { return 3; }
    if (c == 0xE2 && i + 2 < n) {
        var b1 = load8(p + i + 1);
        var b2 = load8(p + i + 2);
        if (b1 == 0x80 && ((b2 >= 0x80 && b2 <= 0x8A) || b2 == 0xA8 || b2 == 0xA9 || b2 == 0xAF)) { return 3; }
        if (b1 == 0x81 && b2 == 0x9F) { return 3; }
        return 0;
    }
    if (c == 0xE3 && i + 2 < n && load8(p + i + 1) == 0x80 && load8(p + i + 2) == 0x80) { return 3; }
    return 0;
}

# The index after any whitespace from i.
#must_use
fn _sl_skip_ws(p, i, n): i64 {
    var j = i;
    loop {
        var w = _sl_ws_len(p, j, n);
        if (w == 0) { return j; }
        j = j + w;
    }
    return j;
}

# chrono's scan::number: between `min` and `max` ASCII digits from i. Returns (value, next index), or (-1, -1).
fn _sl_scan_number(p, i, n, min, max): (i64, i64) {
    var v = 0;
    var k = 0;
    while (k < max && i + k < n) {
        var c = load8(p + i + k);
        if (c < 48 || c > 57) { break; }
        if (v > 92233720368547758) { return (-1, -1); }
        v = v * 10 + (c - 48);
        k = k + 1;
    }
    if (k < min) { return (-1, -1); }
    return (v, i + k);
}

# A numeric item: whitespace, then `width` digits at most (or, when `signed`, a sign and any number). Returns
# (value, next index), or (-1, -1) — a signed item's failure is (-1, -2), since -1 is a value.
fn _sl_rfc_num(p, i, n, width, signed): (i64, i64) {
    var j = _sl_skip_ws(p, i, n);
    if (signed == 1 && j < n && (load8(p + j) == 45 || load8(p + j) == 43)) {
        var neg = load8(p + j) == 45;
        var v, k = _sl_scan_number(p, j + 1, n, 1, 4611686018427387903);
        if (k < 0) { return (-1, -2); }
        if (neg) { return (-v, k); }
        return (v, k);
    }
    var v2, k2 = _sl_scan_number(p, j, n, 1, width);
    if (k2 < 0) { return (-1, -2); }
    return (v2, k2);
}

# A literal byte after optional whitespace (chrono's `Space("")` then `Literal`). The next index, or -1.
#must_use
fn _sl_rfc_lit(p, i, n, ch): i64 {
    var j = _sl_skip_ws(p, i, n);
    if (j >= n || load8(p + j) != ch) { return -1; }
    return j + 1;
}

# 1 when (y, m, d) is a real date.
#must_use
fn _sl_valid_date(y, m, d): i64 {
    if (m < 1 || m > 12 || d < 1) { return 0; }
    var dim = 31;
    if (m == 4 || m == 6 || m == 9 || m == 11) { dim = 30; }
    if (m == 2) {
        dim = 28;
        if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) { dim = 29; }
    }
    if (d > dim) { return 0; }
    return 1;
}

# Parse p[0..n) as chrono reads a DateTime<Utc> (the file header). Stores unix seconds and nanoseconds; returns 1,
# or 0 when chrono refuses it.
fn _sl_rfc3339_parse(p, n, secs_out, nanos_out): i64 {
    var y, i = _sl_rfc_num(p, 0, n, 4, 1);
    if (i < 0) { return 0; }
    i = _sl_rfc_lit(p, i, n, 45);
    if (i < 0) { return 0; }
    var mo, i2 = _sl_rfc_num(p, i, n, 2, 0);
    if (i2 < 0) { return 0; }
    i = _sl_rfc_lit(p, i2, n, 45);
    if (i < 0) { return 0; }
    var d, i3 = _sl_rfc_num(p, i, n, 2, 0);
    if (i3 < 0) { return 0; }
    i = i3;
    if (i >= n) { return 0; }
    var sep = load8(p + i);
    if (sep != 84 && sep != 116 && sep != 32) { return 0; }
    i = i + 1;
    var hh, i4 = _sl_rfc_num(p, i, n, 2, 0);
    if (i4 < 0) { return 0; }
    i = _sl_rfc_lit(p, i4, n, 58);
    if (i < 0) { return 0; }
    var mi, i5 = _sl_rfc_num(p, i, n, 2, 0);
    if (i5 < 0) { return 0; }
    i = _sl_rfc_lit(p, i5, n, 58);
    if (i < 0) { return 0; }
    var ss, i6 = _sl_rfc_num(p, i, n, 2, 0);
    if (i6 < 0) { return 0; }
    i = i6;
    var ns = 0;
    if (i < n && load8(p + i) == 46) {
        var v, k = _sl_scan_number(p, i + 1, n, 1, 9);
        if (k < 0) { return 0; }
        var digits = k - (i + 1);
        var scale = 1;
        var z = digits;
        while (z < 9) {
            scale = scale * 10;
            z = z + 1;
        }
        ns = v * scale;
        i = k;
        while (i < n && load8(p + i) >= 48 && load8(p + i) <= 57) { i = i + 1; }
    }
    i = _sl_skip_ws(p, i, n);
    # The offset.
    var off = 0;
    if (i + 3 <= n && (load8(p + i) | 32) == 117 && (load8(p + i + 1) | 32) == 116 && (load8(p + i + 2) | 32) == 99) {
        i = i + 3;
    } elif (i < n && (load8(p + i) == 90 || load8(p + i) == 122)) {
        i = i + 1;
    } else {
        var neg = 0;
        if (i < n && load8(p + i) == 43) {
            i = i + 1;
        } elif (i < n && load8(p + i) == 45) {
            neg = 1;
            i = i + 1;
        } elif (i + 3 <= n && load8(p + i) == 0xE2 && load8(p + i + 1) == 0x88 && load8(p + i + 2) == 0x92) {
            neg = 1;
            i = i + 3;
        } else {
            return 0;
        }
        if (i + 2 > n) { return 0; }
        var h1 = load8(p + i) - 48;
        var h2 = load8(p + i + 1) - 48;
        if (h1 < 0 || h1 > 9 || h2 < 0 || h2 > 9) { return 0; }
        i = i + 2;
        while (i < n && (load8(p + i) == 58 || _sl_ws_len(p, i, n) > 0)) {
            if (load8(p + i) == 58) { i = i + 1; } else { i = i + _sl_ws_len(p, i, n); }
        }
        if (i + 2 > n) { return 0; }
        var m1 = load8(p + i) - 48;
        var m2 = load8(p + i + 1) - 48;
        if (m1 < 0 || m1 > 5 || m2 < 0 || m2 > 9) { return 0; }
        i = i + 2;
        off = (h1 * 10 + h2) * 3600 + (m1 * 10 + m2) * 60;
        if (neg == 1) { off = -off; }
    }
    if (_sl_skip_ws(p, i, n) != n) { return 0; }
    # chrono's range checks (Parsed's setters, then the date and the offset).
    if (y < -262143 || y > 262142) { return 0; }
    if (hh > 23 || mi > 59 || ss > 60) { return 0; }
    if (off <= -86400 || off >= 86400) { return 0; }
    if (_sl_valid_date(y, mo, d) == 0) { return 0; }
    if (ss == 60) {
        ss = 59;
        ns = ns + 1000000000;
    }
    store64(secs_out, _sl_days_from_civil(y, mo, d) * 86400 + hh * 3600 + mi * 60 + ss - off);
    store64(nanos_out, ns);
    return 1;
}

# --- geometry.cyr ---

# geometry.cyr — selah's rectangle and point (Rust: rust-old/src/geometry.rs, a wrapper over hisab 1.4's Rect).
#
# Port plan D4, D5. hisab 3.4.1 (Cyrius) has no 2D rect, so SlRect is local. It keeps hisab's Rust layout,
# `{min, max}` in f32, so `SlRect_new(x, y, w, h)` stores `x + w` rounded to f32 exactly as Rust does, and
# width = max.x − min.x. Every operation is f32 arithmetic in Rust's order; tests/golden/geometry.tsv pins each one
# bit for bit (a NaN matches any NaN).
#
# Cyrius has no f32 return type, so the accessors (`x`, `y`, `width`, `height`, `area`) return an f64 holding the
# f32's exact value; `f32_from` of it gives the f32 back unchanged (ADR 0002 #15).
#
# JSON (serde's shape, kept for backward compatibility): `{"x":…,"y":…,"width":…,"height":…}`, each an f32 in
# serde_json's form. Reading takes that object or serde's array form `[x, y, width, height]`, each field as an f64
# narrowed `as f32`, then refuses a rect that is not finite, as Rust's custom Deserialize does.

struct SlVec2 { x: f32; y: f32; }
struct SlRect { min_x: f32; min_y: f32; max_x: f32; max_y: f32; }

# Rust's f32::min: the non-NaN operand when one is NaN; otherwise the lesser (glam 0.29.3's Vec2::min).
fn _sl_f32_min(a: f32, b: f32, out: *f32): i64 {
    var da: f64 = f32_to(a);
    var db: f64 = f32_to(b);
    if (db != db) { *out = a; return 0; }
    if (da != da) { *out = b; return 0; }
    if (da < db) { *out = a; return 0; }
    *out = b;
    return 0;
}

# Rust's f32::max: the non-NaN operand when one is NaN; otherwise the greater.
fn _sl_f32_max(a: f32, b: f32, out: *f32): i64 {
    var da: f64 = f32_to(a);
    var db: f64 = f32_to(b);
    if (db != db) { *out = a; return 0; }
    if (da != da) { *out = b; return 0; }
    if (da > db) { *out = a; return 0; }
    *out = b;
    return 0;
}

# 1 when the f32 is finite.
#must_use
fn _sl_f32_finite(a: f32): bool {
    var d: f64 = f32_to(a);
    return d - d == 0.0;
}

# Rust's normalized bounds of one axis, in f64: (min, max) = (f32::min(a, b), f32::max(a, b)) — the non-NaN operand
# when one is NaN; on equal operands (±0 included) b.
fn _sl_axis(a: f64, b: f64): (i64, i64) {
    var lo: f64 = b;
    var hi: f64 = b;
    if (b != b) {
        lo = a;
        hi = a;
    } elif (a == a) {
        if (a < b) { lo = a; }
        if (a > b) { hi = a; }
    }
    return (lo, hi);
}

impl SlVec2 {
    # A point.
    #must_use
    fn new(x: f32, y: f32): SlVec2 {
        var v: SlVec2;
        v.x = x;
        v.y = y;
        return v;
    }
}

impl SlRect {
    # Rust's Rect::new: min = (x, y), max = (x + width, y + height), each sum rounded to f32. A negative size is kept
    # (an arrow's direction).
    #must_use
    fn new(x: f32, y: f32, width: f32, height: f32): SlRect {
        var r: SlRect;
        r.min_x = x;
        r.min_y = y;
        r.max_x = x + width;
        r.max_y = y + height;
        return r;
    }

    # X of the origin corner (min.x), as the f32's exact f64.
    #must_use
    fn x(self): f64 {
        var d: f64 = f32_to(self.min_x);
        return d;
    }

    # Y of the origin corner (min.y), as the f32's exact f64.
    #must_use
    fn y(self): f64 {
        var d: f64 = f32_to(self.min_y);
        return d;
    }

    # The signed width, max.x − min.x in f32, as its exact f64.
    #must_use
    fn width(self): f64 {
        var w: f32 = self.max_x - self.min_x;
        var d: f64 = f32_to(w);
        return d;
    }

    # The signed height, max.y − min.y in f32, as its exact f64.
    #must_use
    fn height(self): f64 {
        var h: f32 = self.max_y - self.min_y;
        var d: f64 = f32_to(h);
        return d;
    }

    # |width| × |height| in f32, as its exact f64.
    #must_use
    fn area(self): f64 {
        var w: f32 = self.max_x - self.min_x;
        var h: f32 = self.max_y - self.min_y;
        var wd: f64 = f32_to(w);
        var hd: f64 = f32_to(h);
        var aw: f32 = f32_from(f64_abs(wd));
        var ah: f32 = f32_from(f64_abs(hd));
        var a: f32 = aw * ah;
        var d: f64 = f32_to(a);
        return d;
    }

    # (min + max) × 0.5, each component in f32 (hisab's Rect::center).
    #must_use
    fn center(self): SlVec2 {
        var half: f32 = f32_from(0.5);
        var cx: f32 = self.min_x + self.max_x;
        var cy: f32 = self.min_y + self.max_y;
        var c: SlVec2;
        c.x = cx * half;
        c.y = cy * half;
        return c;
    }

    # 1 when all four layout values are finite.
    #must_use
    fn is_finite(self): bool {
        if (_sl_f32_finite(self.min_x) == false) { return false; }
        if (_sl_f32_finite(self.min_y) == false) { return false; }
        if (_sl_f32_finite(self.max_x) == false) { return false; }
        return _sl_f32_finite(self.max_y);
    }

    # min = min(min, max), max = max(min, max), per component (Rust's f32::min / f32::max).
    #must_use
    fn normalized(self): SlRect {
        var r: SlRect;
        var t: f32 = self.min_x;
        _sl_f32_min(self.min_x, self.max_x, &t);
        r.min_x = t;
        _sl_f32_min(self.min_y, self.max_y, &t);
        r.min_y = t;
        _sl_f32_max(self.min_x, self.max_x, &t);
        r.max_x = t;
        _sl_f32_max(self.min_y, self.max_y, &t);
        r.max_y = t;
        return r;
    }

    # 1 when p lies in the normalized rect, edges included.
    #must_use
    fn contains_point(self, p: SlVec2): bool {
        var x0, x1 = _sl_axis(f32_to(self.min_x), f32_to(self.max_x));
        var y0, y1 = _sl_axis(f32_to(self.min_y), f32_to(self.max_y));
        var px: f64 = f32_to(p.x);
        var py: f64 = f32_to(p.y);
        var lx: f64 = x0;
        var hx: f64 = x1;
        var ly: f64 = y0;
        var hy: f64 = y1;
        return px >= lx && px <= hx && py >= ly && py <= hy;
    }

    # 1 when the normalized rects overlap with positive area (touching edges don't).
    #must_use
    fn intersects(self, other: *SlRect): bool {
        var a0, a1 = _sl_axis(f32_to(self.min_x), f32_to(self.max_x));
        var b0, b1 = _sl_axis(f32_to(other.min_x), f32_to(other.max_x));
        var ax0: f64 = a0;
        var ax1: f64 = a1;
        var bx0: f64 = b0;
        var bx1: f64 = b1;
        if ((ax0 < bx1 && ax1 > bx0) == false) { return false; }
        var c0, c1 = _sl_axis(f32_to(self.min_y), f32_to(self.max_y));
        var d0, d1 = _sl_axis(f32_to(other.min_y), f32_to(other.max_y));
        var ay0: f64 = c0;
        var ay1: f64 = c1;
        var by0: f64 = d0;
        var by1: f64 = d1;
        return ay0 < by1 && ay1 > by0;
    }

    # Appends serde's JSON for the rect: {"x":…,"y":…,"width":…,"height":…}.
    fn to_json(self, sb): i64 {
        var w: f32 = self.max_x - self.min_x;
        var h: f32 = self.max_y - self.min_y;
        str_builder_add_cstr(sb, "{\"x\":");
        _sl_fmt_f32_json(sb, self.min_x);
        str_builder_add_cstr(sb, ",\"y\":");
        _sl_fmt_f32_json(sb, self.min_y);
        str_builder_add_cstr(sb, ",\"width\":");
        _sl_fmt_f32_json(sb, w);
        str_builder_add_cstr(sb, ",\"height\":");
        _sl_fmt_f32_json(sb, h);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Rust's Rect::default(): new(0, 0, 0, 0).
#must_use
fn SlRect_default(): SlRect {
    var z: f32 = f32_from(0.0);
    return SlRect_new(z, z, z, z);
}

# Read a rect from a parsed JSON value into *out, as Rust's Deserialize does: an object {x, y, width, height}, or
# serde's array form [x, y, width, height]. Ok(0), or Err(SL_ERR_SERDE).
fn _sl_rect_from_value(v, out: *SlRect, detail_out): Result {
    if (v == 0 || (bayan_json_v_is_obj(v) == false && bayan_json_v_is_arr(v) == false)) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: expected a JSON object or array");
    }
    var x: f64 = 0.0;
    var y: f64 = 0.0;
    var w: f64 = 0.0;
    var h: f64 = 0.0;
    if (_sl_json_as_f64(_sl_json_field(v, "x", 4, 0), &x) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `x` is missing or not a number");
    }
    if (_sl_json_as_f64(_sl_json_field(v, "y", 4, 1), &y) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `y` is missing or not a number");
    }
    if (_sl_json_as_f64(_sl_json_field(v, "width", 4, 2), &w) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `width` is missing or not a number");
    }
    if (_sl_json_as_f64(_sl_json_field(v, "height", 4, 3), &h) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `height` is missing or not a number");
    }
    var r = SlRect_new(f32_from(x), f32_from(y), f32_from(w), f32_from(h));
    if (r.is_finite() == false) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect coordinates must be finite and within f32 range");
    }
    *out = r;
    return Ok(0);
}

# Read a rect from JSON text p[0..n) into *out. Ok(0), or Err(SL_ERR_SERDE).
fn SlRect_from_json(p, n, out: *SlRect, detail_out = 0): Result {
    var v = _sl_json_parse(p, n);
    if (v == 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: not a JSON document"); }
    return _sl_rect_from_value(v, out, detail_out);
}

# --- core.cyr ---

# core.cyr — selah's core types (Rust: rust-old/src/core.rs).
#
# Enums keep Rust's declaration order as explicit, append-only values (Rust: #[non_exhaustive]). An enum's methods are
# `selah_<snake enum>_<method>`; a struct is `Sl<Name>` with an impl block (port plan D9). Display impls are `fmt`,
# appending to a str_builder; serde's JSON shapes are kept byte for byte (tests/golden/core.tsv).

# ── AnnotationKind ────────────────────────────────────────────────────────────────────

enum SlAnnotationKind {
    SL_KIND_ARROW = 0;
    SL_KIND_RECTANGLE = 1;
    SL_KIND_CIRCLE = 2;
    SL_KIND_TEXT = 3;
    SL_KIND_HIGHLIGHT = 4;
    SL_KIND_REDACTION = 5;
    SL_KIND_FREEFORM = 6;
}

# Rust's Display: "arrow", "rectangle", … "freeform" (a cstring; "" for an unknown value).
#must_use
fn selah_annotation_kind_name(k): i64 {
    match k {
        SL_KIND_ARROW => { return "arrow"; }
        SL_KIND_RECTANGLE => { return "rectangle"; }
        SL_KIND_CIRCLE => { return "circle"; }
        SL_KIND_TEXT => { return "text"; }
        SL_KIND_HIGHLIGHT => { return "highlight"; }
        SL_KIND_REDACTION => { return "redaction"; }
        SL_KIND_FREEFORM => { return "freeform"; }
        _ => { return ""; }
    }
    return "";
}

# serde's variant name: "Arrow", "Rectangle", … "FreeForm" (a cstring; 0 for an unknown value).
#must_use
fn _sl_kind_serde_name(k): i64 {
    match k {
        SL_KIND_ARROW => { return "Arrow"; }
        SL_KIND_RECTANGLE => { return "Rectangle"; }
        SL_KIND_CIRCLE => { return "Circle"; }
        SL_KIND_TEXT => { return "Text"; }
        SL_KIND_HIGHLIGHT => { return "Highlight"; }
        SL_KIND_REDACTION => { return "Redaction"; }
        SL_KIND_FREEFORM => { return "FreeForm"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends Rust's Display of the kind.
fn selah_annotation_kind_fmt(sb, k): i64 {
    str_builder_add_cstr(sb, selah_annotation_kind_name(k));
    return 0;
}

# Appends serde's JSON for the kind ("\"Arrow\"").
fn selah_annotation_kind_to_json(sb, k): i64 {
    var name = _sl_kind_serde_name(k);
    if (name == 0) { return -1; }
    return _sl_json_str(sb, name, strlen(name));
}

# 1 when a[0..n) equals the NUL-terminated b.
#must_use
fn _sl_eq(a, n, b): i64 {
    if (strlen(b) != n) { return 0; }
    return memeq(a, b, n);
}

# a[0..n) with ASCII letters lowercased (Rust's to_ascii_lowercase), into a fresh buffer.
#must_use
fn _sl_ascii_lower(a, n): i64 {
    var out = alloc(n + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(a + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

# Appends Rust's Debug of a str (`"…"`): `\t \r \n \\ \" \0` escaped, other ASCII controls and DEL as `\u{x}`.
fn _sl_debug_str(sb, p, n): i64 {
    str_builder_putc(sb, 34);
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 9) { str_builder_add_cstr(sb, "\\t"); }
        elif (c == 13) { str_builder_add_cstr(sb, "\\r"); }
        elif (c == 10) { str_builder_add_cstr(sb, "\\n"); }
        elif (c == 92) { str_builder_add_cstr(sb, "\\\\"); }
        elif (c == 34) { str_builder_add_cstr(sb, "\\\""); }
        elif (c == 0) { str_builder_add_cstr(sb, "\\0"); }
        elif (c < 32 || c == 127) {
            str_builder_add_cstr(sb, "\\u{");
            if (c >= 16) { str_builder_putc(sb, load8(_SL_HEX + (c >> 4))); }
            str_builder_putc(sb, load8(_SL_HEX + (c & 15)));
            str_builder_putc(sb, 125);
        } else {
            str_builder_putc(sb, c);
        }
        i = i + 1;
    }
    str_builder_putc(sb, 34);
    return 0;
}

# Rust's FromStr for AnnotationKind: case-insensitive, with the aliases rect, ellipse, redact, free_form and
# free-form. Ok(kind), or Err(SL_ERR_ANNOTATION) with Rust's message.
fn selah_annotation_kind_parse(p, n, detail_out = 0): Result {
    var s = _sl_ascii_lower(p, n);
    if (s == 0) { return _sl_fail_cstr(SL_ERR_ANNOTATION, detail_out, "out of memory"); }
    if (_sl_eq(s, n, "arrow") == 1) { return Ok(SL_KIND_ARROW); }
    if (_sl_eq(s, n, "rectangle") == 1 || _sl_eq(s, n, "rect") == 1) { return Ok(SL_KIND_RECTANGLE); }
    if (_sl_eq(s, n, "circle") == 1 || _sl_eq(s, n, "ellipse") == 1) { return Ok(SL_KIND_CIRCLE); }
    if (_sl_eq(s, n, "text") == 1) { return Ok(SL_KIND_TEXT); }
    if (_sl_eq(s, n, "highlight") == 1) { return Ok(SL_KIND_HIGHLIGHT); }
    if (_sl_eq(s, n, "redaction") == 1 || _sl_eq(s, n, "redact") == 1) { return Ok(SL_KIND_REDACTION); }
    if (_sl_eq(s, n, "freeform") == 1 || _sl_eq(s, n, "free_form") == 1 || _sl_eq(s, n, "free-form") == 1) {
        return Ok(SL_KIND_FREEFORM);
    }
    if (detail_out != 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "unknown annotation kind ");
        _sl_debug_str(sb, s, n);
        str_builder_add_cstr(sb, " (use arrow, rectangle, circle, text, highlight, redaction, or freeform)");
        store64(detail_out, str_builder_build(sb));
    }
    return Err(SL_ERR_ANNOTATION);
}

# serde's Deserialize for AnnotationKind from a parsed JSON value: the variant name, as a string or as
# {"<name>": null}. Ok(kind) or Err(SL_ERR_SERDE).
fn _sl_kind_from_value(v, detail_out): Result {
    var content = 0;
    var s = _sl_json_variant(v, &content);
    if (s == 0 || _sl_json_unit_content(content) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation kind: expected a variant name");
    }
    var k = 0;
    while (k <= SL_KIND_FREEFORM) {
        if (_sl_eq(str_data(s), str_len(s), _sl_kind_serde_name(k)) == 1) { return Ok(k); }
        k = k + 1;
    }
    return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation kind: unknown variant");
}

# serde's Deserialize for AnnotationKind from JSON text. Ok(kind) or Err(SL_ERR_SERDE).
fn selah_annotation_kind_from_json(p, n, detail_out = 0): Result {
    var v = _sl_json_parse(p, n);
    if (v == 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation kind: not a JSON document"); }
    return _sl_kind_from_value(v, detail_out);
}

# ── ImageFormat ───────────────────────────────────────────────────────────────────────

enum SlImageFormat {
    SL_FMT_PNG = 0;
    SL_FMT_JPEG = 1;
    SL_FMT_BMP = 2;
    SL_FMT_WEBP = 3;
}

# Rust's ImageFormat::default(): Png.
#must_use
fn selah_image_format_default(): i64 {
    return SL_FMT_PNG;
}

# The file extension: "png", "jpg", "bmp", "webp" (also Rust's Display).
#must_use
fn selah_image_format_extension(f): i64 {
    match f {
        SL_FMT_PNG => { return "png"; }
        SL_FMT_JPEG => { return "jpg"; }
        SL_FMT_BMP => { return "bmp"; }
        SL_FMT_WEBP => { return "webp"; }
        _ => { return ""; }
    }
    return "";
}

# The MIME type.
#must_use
fn selah_image_format_mime_type(f): i64 {
    match f {
        SL_FMT_PNG => { return "image/png"; }
        SL_FMT_JPEG => { return "image/jpeg"; }
        SL_FMT_BMP => { return "image/bmp"; }
        SL_FMT_WEBP => { return "image/webp"; }
        _ => { return ""; }
    }
    return "";
}

# serde's variant name: "Png", "Jpeg", "Bmp", "WebP".
#must_use
fn _sl_format_serde_name(f): i64 {
    match f {
        SL_FMT_PNG => { return "Png"; }
        SL_FMT_JPEG => { return "Jpeg"; }
        SL_FMT_BMP => { return "Bmp"; }
        SL_FMT_WEBP => { return "WebP"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends Rust's Display of the format (its extension).
fn selah_image_format_fmt(sb, f): i64 {
    str_builder_add_cstr(sb, selah_image_format_extension(f));
    return 0;
}

# Appends serde's JSON for the format ("\"Png\"").
fn selah_image_format_to_json(sb, f): i64 {
    var name = _sl_format_serde_name(f);
    if (name == 0) { return -1; }
    return _sl_json_str(sb, name, strlen(name));
}

# Rust's FromStr for ImageFormat: case-insensitive png, jpg, jpeg, bmp, webp. Ok(format), or
# Err(SL_ERR_UNSUPPORTED_FORMAT) with Rust's message.
fn selah_image_format_parse(p, n, detail_out = 0): Result {
    var s = _sl_ascii_lower(p, n);
    if (s == 0) { return _sl_fail_cstr(SL_ERR_UNSUPPORTED_FORMAT, detail_out, "out of memory"); }
    if (_sl_eq(s, n, "png") == 1) { return Ok(SL_FMT_PNG); }
    if (_sl_eq(s, n, "jpg") == 1 || _sl_eq(s, n, "jpeg") == 1) { return Ok(SL_FMT_JPEG); }
    if (_sl_eq(s, n, "bmp") == 1) { return Ok(SL_FMT_BMP); }
    if (_sl_eq(s, n, "webp") == 1) { return Ok(SL_FMT_WEBP); }
    if (detail_out != 0) {
        var sb = str_builder_new();
        _sl_sb_bytes(sb, s, n);
        str_builder_add_cstr(sb, " (use png, jpg, bmp, or webp)");
        store64(detail_out, str_builder_build(sb));
    }
    return Err(SL_ERR_UNSUPPORTED_FORMAT);
}

# serde's Deserialize for ImageFormat from JSON text: the variant name, as a string or as {"<name>": null}.
# Ok(format) or Err(SL_ERR_SERDE).
fn selah_image_format_from_json(p, n, detail_out = 0): Result {
    var content = 0;
    var s = _sl_json_variant(_sl_json_parse(p, n), &content);
    if (s == 0 || _sl_json_unit_content(content) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "image format: expected a variant name");
    }
    var f = 0;
    while (f <= SL_FMT_WEBP) {
        if (_sl_eq(str_data(s), str_len(s), _sl_format_serde_name(f)) == 1) { return Ok(f); }
        f = f + 1;
    }
    return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "image format: unknown variant");
}

# ── paths (Rust's std::path on Unix: file_name, file_stem, extension) ─────────────────

# The file name of path p[0..n), as Rust's Path::file_name: the last component, when it is a normal one. Returns
# (start, length), or (-1, 0) when there is none ("", "/", ".", "..", "a/..").
fn _sl_path_file_name(p, n): (i64, i64) {
    var end = n;
    loop {
        while (end > 0 && load8(p + end - 1) == 47) { end = end - 1; }
        # A trailing "." component is dropped by Rust's components() (except a lone "." at the start: CurDir).
        if (end >= 2 && load8(p + end - 1) == 46 && load8(p + end - 2) == 47) {
            end = end - 2;
            continue;
        }
        break;
    }
    if (end == 0) { return (-1, 0); }
    var start = end;
    while (start > 0 && load8(p + start - 1) != 47) { start = start - 1; }
    var len = end - start;
    if (len == 1 && load8(p + start) == 46) { return (-1, 0); }
    if (len == 2 && load8(p + start) == 46 && load8(p + start + 1) == 46) { return (-1, 0); }
    return (start, len);
}

# Rust's rsplit_file_at_dot on a file name: (stem start, stem length, extension start, extension length); the
# extension start is -1 when there is none.
fn _sl_split_dot(p, s, len): (i64, i64, i64) {
    var dot = -1;
    var i = len - 1;
    while (i >= 0) {
        if (load8(p + s + i) == 46) {
            dot = i;
            break;
        }
        i = i - 1;
    }
    # No dot, or the only dot is the first byte (".hidden"): all stem, no extension.
    if (dot <= 0) { return (len, -1, 0); }
    return (dot, s + dot + 1, len - dot - 1);
}

# Rust's ImageFormat::from_path: the extension parsed as a format. Some(format) or None().
fn selah_image_format_from_path(p, n): Option {
    var s, len = _sl_path_file_name(p, n);
    if (s < 0) { return None(); }
    var stem_len, es, elen = _sl_split_dot(p, s, len);
    if (es < 0) { return None(); }
    var t, f = selah_image_format_parse(p + es, elen);
    if (is_err_result(t) == 1) { return None(); }
    return Some(f);
}

# Rust's derive_output_path: "<stem>_<suffix>.<ext>", or "<stem>_<suffix>" when the extension is empty.
#must_use
fn selah_derive_output_path(input, n, suffix, slen): Str {
    var sb = str_builder_new();
    var s, len = _sl_path_file_name(input, n);
    if (s >= 0) {
        var stem_len, es, elen = _sl_split_dot(input, s, len);
        _sl_sb_bytes(sb, input + s, stem_len);
        str_builder_putc(sb, 95);
        _sl_sb_bytes(sb, suffix, slen);
        if (es >= 0 && elen > 0) {
            str_builder_putc(sb, 46);
            _sl_sb_bytes(sb, input + es, elen);
        }
    } else {
        str_builder_putc(sb, 95);
        _sl_sb_bytes(sb, suffix, slen);
    }
    return str_builder_build(sb);
}

# ── xml_escape ────────────────────────────────────────────────────────────────────────

# Rust's XML_SPECIAL table: 1 for C0 controls but tab, LF and CR; & < > " '; and 0xEF, the lead byte of U+FFFE /
# U+FFFF. Built on first use (every builder writes the same bytes, so a race is harmless).
var _sl_xml_tab: u8[256];
var _sl_xml_tab_ready = 0;

fn _sl_xml_tab_init(): i64 {
    var c = 0;
    while (c < 256) {
        var v = 0;
        if (c < 32 && c != 9 && c != 10 && c != 13) { v = 1; }
        if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39 || c == 0xEF) { v = 1; }
        store8(&_sl_xml_tab + c, v);
        c = c + 1;
    }
    _sl_xml_tab_ready = 1;
    return 0;
}

# 1 when Rust's XML_SPECIAL table flags byte c.
#must_use
fn _sl_xml_special(c): i64 {
    if (_sl_xml_tab_ready == 0) { _sl_xml_tab_init(); }
    return load8(&_sl_xml_tab + c);
}

# Appends p[0..n) escaped for XML text and attributes, as Rust's push_xml_escaped: & < > " ' as entities; C0
# controls but tab, LF and CR, and the non-characters U+FFFE and U+FFFF, dropped (not allowed in XML 1.0).
fn _sl_push_xml_escaped(sb, p, n): i64 {
    if (_sl_xml_tab_ready == 0) { _sl_xml_tab_init(); }
    var tab = &_sl_xml_tab;
    var i = 0;
    while (i < n) {
        # A run of bytes that need nothing goes in one copy.
        var run = i;
        while (run < n && load8(tab + load8(p + run)) == 0) { run = run + 1; }
        if (run > i) {
            _sl_sb_bytes(sb, p + i, run - i);
            i = run;
            continue;
        }
        var c = load8(p + i);
        if (c == 38) { str_builder_add_cstr(sb, "&amp;"); }
        elif (c == 60) { str_builder_add_cstr(sb, "&lt;"); }
        elif (c == 62) { str_builder_add_cstr(sb, "&gt;"); }
        elif (c == 34) { str_builder_add_cstr(sb, "&quot;"); }
        elif (c == 39) { str_builder_add_cstr(sb, "&#x27;"); }
        elif (c == 0xEF) {
            # A three-byte character: U+FFFE / U+FFFF (EF BF BE / EF BF BF) are dropped, any other is kept.
            if (i + 2 < n && load8(p + i + 1) == 0xBF && (load8(p + i + 2) == 0xBE || load8(p + i + 2) == 0xBF)) {
                i = i + 3;
                continue;
            }
            var k = 0;
            while (k < 3 && i + k < n) {
                str_builder_putc(sb, load8(p + i + k));
                k = k + 1;
            }
            i = i + k;
            continue;
        }
        i = i + 1;
    }
    return 0;
}

# Rust's xml_escape as a new Str.
#must_use
fn selah_xml_escape(p, n): Str {
    var sb = str_builder_new();
    _sl_push_xml_escaped(sb, p, n);
    return str_builder_build(sb);
}

# ── Color ─────────────────────────────────────────────────────────────────────────────

struct SlColor { r: u8; g: u8; b: u8; a: u8; }

var SL_COLOR_RED: SlColor = SlColor { 255, 0, 0, 255 };
var SL_COLOR_GREEN: SlColor = SlColor { 0, 255, 0, 255 };
var SL_COLOR_BLUE: SlColor = SlColor { 0, 0, 255, 255 };
var SL_COLOR_BLACK: SlColor = SlColor { 0, 0, 0, 255 };
var SL_COLOR_WHITE: SlColor = SlColor { 255, 255, 255, 255 };
var SL_COLOR_YELLOW: SlColor = SlColor { 255, 255, 0, 128 };

impl SlColor {
    # A colour (each channel taken mod 256).
    #must_use
    fn new(r, g, b, a): SlColor {
        var c: SlColor;
        c.r = r & 255;
        c.g = g & 255;
        c.b = b & 255;
        c.a = a & 255;
        return c;
    }

    # Appends Rust's Display: "#rrggbbaa", lowercase.
    fn fmt(self, sb): i64 {
        str_builder_putc(sb, 35);
        var ch: i64[4];
        ch[0] = self.r;
        ch[1] = self.g;
        ch[2] = self.b;
        ch[3] = self.a;
        var i = 0;
        while (i < 4) {
            str_builder_putc(sb, load8(_SL_HEX + (ch[i] >> 4)));
            str_builder_putc(sb, load8(_SL_HEX + (ch[i] & 15)));
            i = i + 1;
        }
        return 0;
    }

    # Appends the CSS form: "rgba(r,g,b,A)" with A = a / 255 to two places (Rust's `{:.2}`). a·100/255 is never a
    # tie to two places, so the integer rounding round(a·100/255) is the f64 formatting's.
    fn css(self, sb): i64 {
        str_builder_add_cstr(sb, "rgba(");
        str_builder_add_int(sb, self.r);
        str_builder_putc(sb, 44);
        str_builder_add_int(sb, self.g);
        str_builder_putc(sb, 44);
        str_builder_add_int(sb, self.b);
        str_builder_putc(sb, 44);
        var q = (self.a * 200 + 255) / 510;
        str_builder_add_int(sb, q / 100);
        str_builder_putc(sb, 46);
        str_builder_putc(sb, 48 + (q / 10) % 10);
        str_builder_putc(sb, 48 + q % 10);
        str_builder_putc(sb, 41);
        return 0;
    }

    # Rust's to_css as a new Str.
    #must_use
    fn to_css(self): Str {
        var sb = str_builder_new();
        self.css(sb);
        return str_builder_build(sb);
    }

    # Appends serde's JSON: {"r":…,"g":…,"b":…,"a":…}.
    fn to_json(self, sb): i64 {
        str_builder_add_cstr(sb, "{\"r\":");
        str_builder_add_int(sb, self.r);
        str_builder_add_cstr(sb, ",\"g\":");
        str_builder_add_int(sb, self.g);
        str_builder_add_cstr(sb, ",\"b\":");
        str_builder_add_int(sb, self.b);
        str_builder_add_cstr(sb, ",\"a\":");
        str_builder_add_int(sb, self.a);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Rust's Color::default(): RED.
#must_use
fn SlColor_default(): SlColor {
    return SL_COLOR_RED;
}

# Read a colour from a parsed JSON value into *out: {r, g, b, a} or serde's array form [r, g, b, a], each an
# integer 0..=255. Ok(0) or Err(SL_ERR_SERDE).
fn _sl_color_from_value(v, out: *SlColor, detail_out): Result {
    if (v == 0 || (bayan_json_v_is_obj(v) == false && bayan_json_v_is_arr(v) == false)) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "color: expected a JSON object or array");
    }
    var r = _sl_json_as_u8(_sl_json_field(v, "r", 4, 0));
    var g = _sl_json_as_u8(_sl_json_field(v, "g", 4, 1));
    var b = _sl_json_as_u8(_sl_json_field(v, "b", 4, 2));
    var a = _sl_json_as_u8(_sl_json_field(v, "a", 4, 3));
    if (r < 0 || g < 0 || b < 0 || a < 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "color: each of r, g, b, a must be an integer 0..=255");
    }
    *out = SlColor_new(r, g, b, a);
    return Ok(0);
}

# Read a colour from JSON text into *out. Ok(0) or Err(SL_ERR_SERDE).
fn SlColor_from_json(p, n, out: *SlColor, detail_out = 0): Result {
    var v = _sl_json_parse(p, n);
    if (v == 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "color: not a JSON document"); }
    return _sl_color_from_value(v, out, detail_out);
}

# ── RedactionTarget ───────────────────────────────────────────────────────────────────

enum SlRedactionKind {
    SL_TARGET_EMAIL = 0;
    SL_TARGET_PHONE = 1;
    SL_TARGET_CREDIT_CARD = 2;
    SL_TARGET_IP_ADDRESS = 3;
    SL_TARGET_CUSTOM = 4;
}

# A redaction target: its kind, and for SL_TARGET_CUSTOM its label (a Str; 0 otherwise).
struct SlRedactionTarget { kind: i64; custom: i64; }

impl SlRedactionTarget {
    # A target of `kind`, with `custom` the label of a SL_TARGET_CUSTOM (else 0).
    #must_use
    fn new(kind, custom): SlRedactionTarget {
        var t: SlRedactionTarget;
        t.kind = kind;
        t.custom = custom;
        return t;
    }

    # The stable machine key: "email", "phone", "credit_card", "ip_address", "custom".
    #must_use
    fn key(self): i64 {
        match self.kind {
            SL_TARGET_EMAIL => { return "email"; }
            SL_TARGET_PHONE => { return "phone"; }
            SL_TARGET_CREDIT_CARD => { return "credit_card"; }
            SL_TARGET_IP_ADDRESS => { return "ip_address"; }
            _ => { return "custom"; }
        }
        return "custom";
    }

    # Appends Rust's Display: "email", "phone", "credit card", "IP address", "custom: <label>".
    fn fmt(self, sb): i64 {
        match self.kind {
            SL_TARGET_EMAIL => { str_builder_add_cstr(sb, "email"); }
            SL_TARGET_PHONE => { str_builder_add_cstr(sb, "phone"); }
            SL_TARGET_CREDIT_CARD => { str_builder_add_cstr(sb, "credit card"); }
            SL_TARGET_IP_ADDRESS => { str_builder_add_cstr(sb, "IP address"); }
            _ => {
                str_builder_add_cstr(sb, "custom: ");
                if (self.custom != 0) { str_builder_add(sb, self.custom); }
            }
        }
        return 0;
    }

    # Appends serde's JSON: "\"Email\"" … or {"Custom":"<label>"}.
    fn to_json(self, sb): i64 {
        match self.kind {
            SL_TARGET_EMAIL => { str_builder_add_cstr(sb, "\"Email\""); }
            SL_TARGET_PHONE => { str_builder_add_cstr(sb, "\"Phone\""); }
            SL_TARGET_CREDIT_CARD => { str_builder_add_cstr(sb, "\"CreditCard\""); }
            SL_TARGET_IP_ADDRESS => { str_builder_add_cstr(sb, "\"IpAddress\""); }
            _ => {
                str_builder_add_cstr(sb, "{\"Custom\":");
                if (self.custom != 0) {
                    _sl_json_str_s(sb, self.custom);
                } else {
                    str_builder_add_cstr(sb, "\"\"");
                }
                str_builder_putc(sb, 125);
            }
        }
        return 0;
    }
}

# Read a target from a parsed JSON value into *out: a unit variant as its name or {"<name>": null}, or
# {"Custom": "<label>"}. Ok(0) or Err(SL_ERR_SERDE).
fn _sl_target_from_value(v, out: *SlRedactionTarget, detail_out): Result {
    var content = 0;
    var s = _sl_json_variant(v, &content);
    if (s == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "redaction target: expected a variant");
    }
    var p = str_data(s);
    var n = str_len(s);
    if (_sl_eq(p, n, "Custom") == 1) {
        var label = _sl_json_as_str(content);
        if (label == 0) {
            return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "redaction target: Custom needs a string");
        }
        *out = SlRedactionTarget_new(SL_TARGET_CUSTOM, label);
        return Ok(0);
    }
    if (_sl_json_unit_content(content) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "redaction target: a unit variant takes no content");
    }
    var kind = -1;
    if (_sl_eq(p, n, "Email") == 1) { kind = SL_TARGET_EMAIL; }
    elif (_sl_eq(p, n, "Phone") == 1) { kind = SL_TARGET_PHONE; }
    elif (_sl_eq(p, n, "CreditCard") == 1) { kind = SL_TARGET_CREDIT_CARD; }
    elif (_sl_eq(p, n, "IpAddress") == 1) { kind = SL_TARGET_IP_ADDRESS; }
    if (kind < 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "redaction target: unknown variant"); }
    *out = SlRedactionTarget_new(kind, 0);
    return Ok(0);
}

# Read a target from JSON text into *out. Ok(0) or Err(SL_ERR_SERDE).
fn SlRedactionTarget_from_json(p, n, out: *SlRedactionTarget, detail_out = 0): Result {
    var v = _sl_json_parse(p, n);
    if (v == 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "redaction target: not a JSON document"); }
    return _sl_target_from_value(v, out, detail_out);
}

# ── CaptureSource ─────────────────────────────────────────────────────────────────────

enum SlCaptureSourceKind {
    SL_SOURCE_FULL_SCREEN = 0;
    SL_SOURCE_REGION = 1;
    SL_SOURCE_WINDOW = 2;
}

# Where a screenshot came from: the whole screen, a region, or a window (its id, a Str).
struct SlCaptureSource { kind: i64; region: SlRect; window: i64; }

impl SlCaptureSource {
    # Appends Rust's Display: "full screen", "region (WxH at X,Y)" (f32 Display), "window <id>".
    fn fmt(self, sb): i64 {
        match self.kind {
            SL_SOURCE_FULL_SCREEN => { str_builder_add_cstr(sb, "full screen"); }
            SL_SOURCE_REGION => {
                var w: f32 = self.region.max_x - self.region.min_x;
                var h: f32 = self.region.max_y - self.region.min_y;
                str_builder_add_cstr(sb, "region (");
                _sl_fmt_f32_display(sb, w);
                str_builder_putc(sb, 120);
                _sl_fmt_f32_display(sb, h);
                str_builder_add_cstr(sb, " at ");
                _sl_fmt_f32_display(sb, self.region.min_x);
                str_builder_putc(sb, 44);
                _sl_fmt_f32_display(sb, self.region.min_y);
                str_builder_putc(sb, 41);
            }
            _ => {
                str_builder_add_cstr(sb, "window ");
                if (self.window != 0) { str_builder_add(sb, self.window); }
            }
        }
        return 0;
    }
}

# ── Annotation ────────────────────────────────────────────────────────────────────────

# An annotation: a 16-byte id (RFC 4122 byte order, in id_a then id_b), its kind, its position, its colour, and its
# text (a Str, or 0 for Rust's None).
struct SlAnnotation { id_a: i64; id_b: i64; kind: i64; position: SlRect; color: SlColor; text: i64; }

# An allocation as a *SlAnnotation (the id's 16 bytes start at the struct's address: id_a is at offset 0).
#must_use
fn _sl_as_annotation(p): *SlAnnotation {
    return p;
}

# A new annotation with a random v4 id on the freelist (free it with SlAnnotation_free); 0 when out of memory or
# entropy.
#must_use
fn SlAnnotation_new(kind, position: SlRect, color: SlColor): *SlAnnotation {
    var a: *SlAnnotation = _sl_as_annotation(fl_alloc(sizeof(SlAnnotation)));
    if (a == 0) { return 0; }
    if (_sl_uuid_v4(_sl_addr(a)) == 0) {
        fl_free(a);
        return 0;
    }
    a.kind = kind;
    a.position = position;
    a.color = color;
    a.text = 0;
    return a;
}

# As SlAnnotation_new, with text (a Str).
#must_use
fn SlAnnotation_with_text(kind, position: SlRect, color: SlColor, text): *SlAnnotation {
    var a: *SlAnnotation = SlAnnotation_new(kind, position, color);
    if (a == 0) { return 0; }
    a.text = text;
    return a;
}

# Free an annotation made by SlAnnotation_new / _with_text / _from_json (its text is the caller's).
fn SlAnnotation_free(a: *SlAnnotation): i64 {
    if (a != 0) { fl_free(a); }
    return 0;
}

# Appends serde's JSON for the annotation: {"id":…,"kind":…,"position":…,"color":…,"text":…}.
fn SlAnnotation_to_json(a: *SlAnnotation, sb): i64 {
    str_builder_add_cstr(sb, "{\"id\":\"");
    _sl_uuid_fmt(sb, _sl_addr(a), 1);
    str_builder_add_cstr(sb, "\",\"kind\":");
    selah_annotation_kind_to_json(sb, a.kind);
    str_builder_add_cstr(sb, ",\"position\":");
    a.position.to_json(sb);
    str_builder_add_cstr(sb, ",\"color\":");
    a.color.to_json(sb);
    str_builder_add_cstr(sb, ",\"text\":");
    if (a.text == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        _sl_json_str_s(sb, a.text);
    }
    str_builder_putc(sb, 125);
    return 0;
}

# Read an annotation from a parsed JSON value, as Rust's derived Deserialize: an object whose id, kind, position and
# colour are required and whose text may be missing or null (None) or a string; or serde's array form of all five.
# Ok(annotation on the freelist) or Err(SL_ERR_SERDE).
fn _sl_annotation_from_value(v, detail_out): Result {
    if (v == 0 || (bayan_json_v_is_obj(v) == false && bayan_json_v_is_arr(v) == false)) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation: expected a JSON object or array");
    }
    var a: *SlAnnotation = _sl_as_annotation(fl_alloc(sizeof(SlAnnotation)));
    if (a == 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation: out of memory"); }
    var ids = _sl_json_as_str(_sl_json_field(v, "id", 5, 0));
    if (ids == 0 || _sl_uuid_parse(str_data(ids), str_len(ids), _sl_addr(a)) == 0) {
        fl_free(a);
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation: `id` is missing or not a UUID");
    }
    var kt, kv = _sl_kind_from_value(_sl_json_field(v, "kind", 5, 1), detail_out);
    if (is_err_result(kt) == 1) {
        fl_free(a);
        return Err(kv);
    }
    a.kind = kv;
    var rect: SlRect = SlRect_default();
    var rt, rv = _sl_rect_from_value(_sl_json_field(v, "position", 5, 2), &rect, detail_out);
    if (is_err_result(rt) == 1) {
        fl_free(a);
        return Err(rv);
    }
    a.position = rect;
    var col: SlColor = SlColor_default();
    var ct, cv = _sl_color_from_value(_sl_json_field(v, "color", 5, 3), &col, detail_out);
    if (is_err_result(ct) == 1) {
        fl_free(a);
        return Err(cv);
    }
    a.color = col;
    a.text = 0;
    var tv = _sl_json_field(v, "text", 5, 4);
    if (tv != 0 && bayan_json_v_is_null(tv) == false) {
        var ts = _sl_json_as_str(tv);
        if (ts == 0) {
            fl_free(a);
            return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation: `text` must be a string or null");
        }
        a.text = ts;
    }
    return Ok(a);
}

# Read an annotation from JSON text. Ok(annotation on the freelist) or Err(SL_ERR_SERDE).
fn SlAnnotation_from_json(p, n, detail_out = 0): Result {
    var v = _sl_json_parse(p, n);
    if (v == 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "annotation: not a JSON document"); }
    return _sl_annotation_from_value(v, detail_out);
}

