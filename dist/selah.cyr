# Moves to the next chunk of the chain, linking a new one when the chain ends. Returns 1, or 0 when out of memory.
fn _sl_scratch_next(st): i64 {
    var cur = load64(st);
    var nxt = 0;
    if (cur != 0) { nxt = load64(cur); }
    if (nxt == 0) {
