# --- fmtf.cyr ---

# fmtf.cyr — float text as Rust prints it: the shortest round-trip digits, in Rust's Display and serde_json's forms.
#
# UPSTREAM(L1): cyrius issue 2026-11-13-derive-debug-and-shortest-float-digits. The stdlib has no shortest
# round-trip printer, so this is impetus's `src/fmtf.cyr` (its ADR 0010: Burger & Dybvig's free-format algorithm,
# "Printing Floating-Point Numbers Quickly and Accurately", 1996, on a small exact bignum), generalised over the
# format as pravash's is (`hidden`, `emin`) so it prints f32 in its own shortest digits too. It leaves when the
# stdlib ships a printer.
#
# selah writes f32 rect coordinates into SVG through Rust's `Display` and every float in its JSON through
# serde_json 1.0.154 (zmij). Both print the shortest digits that read back, choosing the closest to the exact value
# among them; they differ on an exact tie between two closest candidates (core rounds it up, zmij to the even
# digit) and in where the digits go. tests/golden/fmtf.tsv pins all four forms against Rust.
#
# Forms (each appends to a str_builder):
# - `_sl_fmt_f32_display`, `_sl_fmt_f64_display`: Rust's `{}` — always positional, no ".0" (`100`, `0.1`, `-0`),
#   `NaN`, `inf`, `-inf`.
# - `_sl_fmt_f32_json`, `_sl_fmt_f64_json`: serde_json — positional while the decimal exponent is in −5..=15 (f64) or
#   −6..=12 (f32), with ".0" on an integer (`100.0`, `0.00001`); otherwise `d.ddde±x` (`1e+16`, `1.5e-7`); `null` for
#   NaN and ±∞.

# ── bits ──────────────────────────────────────────────────────────────────────────────

# The 64 bits of an f64.
#must_use
fn _sl_f64_bits(x): i64 {
    return x;
}

# The 32 bits of an f32.
#must_use
fn _sl_f32_bits(x: f32): i64 {
    var c: f32 = x;
    return load32(&c) & 0xFFFFFFFF;
}

# Appends n bytes at p in one copy, through a Str header on the stack (str_builder has no (ptr, len) form).
fn _sl_sb_bytes(sb, p, n): i64 {
    if (n <= 0) { return 0; }
    var hdr: i64[2];
    hdr[0] = p;
    hdr[1] = n;
    return str_builder_add(sb, &hdr);
}

# ── bignum ────────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs. 40 limbs
# hold 2^1280; the algorithm's values stay below 2^1140. No leading zero limbs.

# a := v, for 0 <= v < 2^63.
fn _sl_bn_set(a, v): i64 {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _sl_bn_copy(dst, src): i64 {
    var n = load64(src);
    var i = 0;
    while (i <= n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _sl_bn_mul_small(a, m): i64 {
    var n = load64(a);
    var carry = 0;
    var i = 0;
    while (i < n) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
        i = i + 1;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _sl_bn_mul_pow10(a, k): i64 {
    var left = k;
    while (left >= 9) {
        _sl_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    while (left > 0) {
        m = m * 10;
        left = left - 1;
    }
    if (m > 1) { _sl_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _sl_bn_shl(a, k): i64 {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        var i = 0;
        while (i < n) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
            i = i + 1;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var j = n - 1;
        while (j >= 0) {
            store64(a + 8 + (j + q) * 8, load64(a + 8 + j * 8));
            j = j - 1;
        }
        var z = 0;
        while (z < q) {
            store64(a + 8 + z * 8, 0);
            z = z + 1;
        }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _sl_bn_sum(dst, a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    var i = 0;
    while (i < n) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
        i = i + 1;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _sl_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return -1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return -1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _sl_bn_sub(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    var i = 0;
    while (i < na) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
        i = i + 1;
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _sl_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ───────────────────────────────────

# The shortest decimal digits of the positive finite value f × 2^e that read back to it in its format, the closest
# to its exact value among them. `hidden` is the format's hidden bit (2^52, 2^23) and `emin` its least exponent
# (-1074, -149): f = hidden with e > emin is a power of two, whose lower neighbour is half as far. When the exact
# value lies exactly halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer) and 1 the even one (serde_json's zmij). Writes the ASCII digits to `digits` (17 bytes is enough) and
# returns (n, k), with value = 0.d1d2…dn × 10^k.
fn _sl_shortest(f, e, hidden, emin, digits, tie_even): (i64, i64) {
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != hidden) {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, e + 1);
            _sl_bn_set(&s, 2);
            _sl_bn_set(&mp, 1);
            _sl_bn_shl(&mp, e);
            _sl_bn_copy(&mm, &mp);
        } else {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, e + 2);
            _sl_bn_set(&s, 4);
            _sl_bn_set(&mp, 1);
            _sl_bn_shl(&mp, e + 1);
            _sl_bn_set(&mm, 1);
            _sl_bn_shl(&mm, e);
        }
    } else {
        if (e == emin || f != hidden) {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, 1);
            _sl_bn_set(&s, 1);
            _sl_bn_shl(&s, 1 - e);
            _sl_bn_set(&mp, 1);
            _sl_bn_set(&mm, 1);
        } else {
            _sl_bn_set(&r, f);
            _sl_bn_shl(&r, 2);
            _sl_bn_set(&s, 1);
            _sl_bn_shl(&s, 2 - e);
            _sl_bn_set(&mp, 2);
            _sl_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small (the fixup below adds
    # the one).
    var lg: f64 = f64_from(e + _sl_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _sl_bn_mul_pow10(&s, k);
    } else {
        _sl_bn_mul_pow10(&r, -k);
        _sl_bn_mul_pow10(&mp, -k);
        _sl_bn_mul_pow10(&mm, -k);
    }
    _sl_bn_sum(&t, &r, &mp);
    var c = _sl_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _sl_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    loop {
        _sl_bn_mul_small(&r, 10);
        _sl_bn_mul_small(&mp, 10);
        _sl_bn_mul_small(&mm, 10);
        var d = 0;
        while (_sl_bn_cmp(&r, &s) >= 0) {
            _sl_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _sl_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _sl_bn_sum(&t, &r, &mp);
        var hi = _sl_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _sl_bn_copy(&t, &r);
                _sl_bn_shl(&t, 1);
                var half = _sl_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── layout ────────────────────────────────────────────────────────────────────────────

# Appends `count` copies of byte c.
fn _sl_sb_repeat(sb, c, count): i64 {
    var i = 0;
    while (i < count) {
        str_builder_putc(sb, c);
        i = i + 1;
    }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer gets ".0"
# (serde_json's form).
fn _sl_sb_positional(sb, digits, n, k, int_suffix): i64 {
    if (k <= 0) {
        str_builder_putc(sb, 48);
        str_builder_putc(sb, 46);
        _sl_sb_repeat(sb, 48, -k);
        _sl_sb_bytes(sb, digits, n);
        return 0;
    }
    if (k >= n) {
        _sl_sb_bytes(sb, digits, n);
        _sl_sb_repeat(sb, 48, k - n);
        if (int_suffix == 1) {
            str_builder_putc(sb, 46);
            str_builder_putc(sb, 48);
        }
        return 0;
    }
    _sl_sb_bytes(sb, digits, k);
    str_builder_putc(sb, 46);
    _sl_sb_bytes(sb, digits + k, n - k);
    return 0;
}

# Appends 0.d1…dn × 10^k in serde_json's form: positional while the decimal exponent is in lo..=hi (zmij's ranges:
# −5..=15 for f64, −6..=12 for f32, as tests/golden/fmtf.tsv measures), otherwise d.ddd e±x.
fn _sl_sb_json_digits(sb, digits, n, k, lo, hi): i64 {
    var ex = k - 1;
    if (ex >= lo && ex <= hi) {
        return _sl_sb_positional(sb, digits, n, k, 1);
    }
    str_builder_putc(sb, load8(digits));
    if (n > 1) {
        str_builder_putc(sb, 46);
        _sl_sb_bytes(sb, digits + 1, n - 1);
    }
    str_builder_putc(sb, 101);
    if (ex >= 0) {
        str_builder_putc(sb, 43);
        str_builder_add_int(sb, ex);
    } else {
        str_builder_putc(sb, 45);
        str_builder_add_int(sb, -ex);
    }
    return 0;
}

# The shortest digits of an f64 magnitude (positive, finite, non-zero bits).
fn _sl_f64_digits(mag, digits, tie_even): (i64, i64) {
    var be = (mag >> 52) & 0x7FF;
    var f = mag & 0xFFFFFFFFFFFFF;
    var e = -1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    return _sl_shortest(f, e, 0x10000000000000, -1074, digits, tie_even);
}

# The shortest digits of an f32 magnitude (positive, finite, non-zero bits).
fn _sl_f32_digits(mag, digits, tie_even): (i64, i64) {
    var be = (mag >> 23) & 0xFF;
    var f = mag & 0x7FFFFF;
    var e = -149;
    if (be != 0) {
        f = f | 0x800000;
        e = be - 150;
    }
    return _sl_shortest(f, e, 0x800000, -149, digits, tie_even);
}

# ── the four forms ────────────────────────────────────────────────────────────────────

# Appends x as Rust's `Display` (`{}`) writes an f64.
fn _sl_fmt_f64_display(sb, x: f64): i64 {
    if (x != x) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    var bits = _sl_f64_bits(x);
    if (bits < 0) { str_builder_putc(sb, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_putc(sb, 48);
        return 0;
    }
    var digits[24];
    var n, k = _sl_f64_digits(mag, &digits, 0);
    return _sl_sb_positional(sb, &digits, n, k, 0);
}

# Appends x as serde_json 1.0.154 writes an f64 (zmij); `null` for NaN and ±∞.
fn _sl_fmt_f64_json(sb, x: f64): i64 {
    var bits = _sl_f64_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _sl_f64_digits(mag, &digits, 1);
    return _sl_sb_json_digits(sb, &digits, n, k, -5, 15);
}

# The value of a positive f32 magnitude (bits) when it is an integer below 2^24, else -1. Such a value's shortest
# digits are its integer digits, so both writers below print it directly: the fast path for whole-number coordinates
# (SVG, layer files), with output identical to the general path.
#must_use
#pure
fn _sl_f32_small_int(mag): i64 {
    var e = (mag >> 23) - 127;
    if (e < 0 || e > 23) { return -1; }
    var m = (mag & 8388607) | 8388608;
    var sh = 23 - e;
    if ((m & ((1 << sh) - 1)) != 0) { return -1; }
    return m >> sh;
}

# Appends x as Rust's `Display` (`{}`) writes an f32: its own shortest digits.
fn _sl_fmt_f32_display(sb, x: f32): i64 {
    var w = _sl_f32_bits(x);
    var mag = w & 0x7FFFFFFF;
    if (mag > 0x7F800000) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    if (((w >> 31) & 1) == 1) { str_builder_putc(sb, 45); }
    if (mag == 0x7F800000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_putc(sb, 48);
        return 0;
    }
    var iv = _sl_f32_small_int(mag);
    if (iv > 0) {
        str_builder_add_int(sb, iv);
        return 0;
    }
    var digits[24];
    var n, k = _sl_f32_digits(mag, &digits, 0);
    return _sl_sb_positional(sb, &digits, n, k, 0);
}

# Appends x as serde_json 1.0.154 writes an f32 (zmij, its own shortest digits); `null` for NaN and ±∞.
fn _sl_fmt_f32_json(sb, x: f32): i64 {
    var w = _sl_f32_bits(x);
    var mag = w & 0x7FFFFFFF;
    if (mag >= 0x7F800000) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (((w >> 31) & 1) == 1) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var iv = _sl_f32_small_int(mag);
    if (iv > 0) {
        str_builder_add_int(sb, iv);
        str_builder_add_cstr(sb, ".0");
        return 0;
    }
    var digits[24];
    var n, k = _sl_f32_digits(mag, &digits, 1);
    return _sl_sb_json_digits(sb, &digits, n, k, -6, 12);
}

# Appends x as Rust's `Debug` (`{:?}`) writes an f32: positional with at least one fraction digit (`1.0`, `0.5`)
# while 1e-4 <= |x| < 1e16 (and for 0, `0.0`), otherwise the shortest exponential form (`1e16`, `1.5e-5`); `NaN`,
# `inf`, `-inf` (core's float_to_general_debug).
fn _sl_fmt_f32_debug(sb, x: f32): i64 {
    var w = _sl_f32_bits(x);
    var mag = w & 0x7FFFFFFF;
    if (mag > 0x7F800000) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    if (((w >> 31) & 1) == 1) { str_builder_putc(sb, 45); }
    if (mag == 0x7F800000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _sl_f32_digits(mag, &digits, 0);
    # 0x38D1B717 is the f32 nearest 1e-4 and 0x5A0E1BCA the one nearest 1e16: the bounds Rust compares against.
    if (mag >= 953267991 && mag < 1510874058) { return _sl_sb_positional(sb, &digits, n, k, 1); }
    str_builder_putc(sb, load8(&digits));
    if (n > 1) {
        str_builder_putc(sb, 46);
        _sl_sb_bytes(sb, &digits + 1, n - 1);
    }
    str_builder_putc(sb, 101);
    str_builder_add_int(sb, k - 1);
    return 0;
}

# --- json.cyr ---

# json.cyr — JSON as selah's Rust crate writes and reads it (serde_json 1.0.154), on bayan.
#
# UPSTREAM(L2): `#derive(Serialize)` has open defects (cyrius issues 2026-11-07-derive-serialize-*,
# 2026-11-11-derive-*, 2026-11-12-derive-serialize-in-a-second-private-file-fails-to-compile), so the codecs are
# written by hand: these helpers, and each type's own to_json / from_json beside it.
#
# Writing: byte-identical to serde_json. Strings escape `"`, `\` and the C0 controls (`\b \t \n \f \r`, the rest as
# `\u00xx`, lowercase); everything else, `/`, DEL and UTF-8 included, is written as it is. Floats go through
# fmtf.cyr's serde_json forms.
#
# Reading: bayan's value tree (`bayan_json_v_parse_buf`) and the typed getters below, which accept what serde's
# derived impls accept for each field type, and refuse what they refuse. A refusal is `SL_ERR_SERDE`; the message is
# the port's own, not serde_json's (ADR 0002 #14), so golden rows compare the verdict.

# ── writing ───────────────────────────────────────────────────────────────────────────

var _SL_HEX = "0123456789abcdef";

# The escape of each byte a JSON string escapes (`"`, `\`, and below 0x20), at slot 8c: its length, then serde_json's
# bytes (`\"`, `\\`, `\b`, `\t`, `\n`, `\f`, `\r`, else `\u00xx`). Length 0 for every other byte.
var _sl_json_esc: u8[2048];
var _sl_json_esc_ready = 0;

fn _sl_json_esc_init(): i64 {
    var c = 0;
    while (c < 256) {
        var e = &_sl_json_esc + c * 8;
        store8(e, 0);
        var x = 0;
        if (c == 34) { x = 34; }
        elif (c == 92) { x = 92; }
        elif (c == 8) { x = 98; }
        elif (c == 9) { x = 116; }
        elif (c == 10) { x = 110; }
        elif (c == 12) { x = 102; }
        elif (c == 13) { x = 114; }
        if (x != 0) {
            store8(e, 2);
            store8(e + 1, 92);
            store8(e + 2, x);
        } elif (c < 32) {
            store8(e, 6);
            store8(e + 1, 92);
            store8(e + 2, 117);
            store8(e + 3, 48);
            store8(e + 4, 48);
            store8(e + 5, load8(_SL_HEX + (c >> 4)));
            store8(e + 6, load8(_SL_HEX + (c & 15)));
        }
        c = c + 1;
    }
    _sl_json_esc_ready = 1;
    return 0;
}

# Appends bytes p[0..n) as a JSON string, quotes included, escaped as serde_json escapes; every other byte goes as it
# is. Runs that need nothing are found a word at a time (a SWAR test for a quote, a backslash or a byte below 0x20).
# The text is assembled in a 4 KiB chunk and handed to the builder a chunk at a time; a run longer than the chunk goes
# straight in.
fn _sl_json_str(sb, p, n): i64 {
    if (_sl_json_esc_ready == 0) { _sl_json_esc_init(); }
    var esc = &_sl_json_esc;
    var chunk: u8[4096];
    var o = &chunk;
    store8(o, 34);
    var t = 1;
    var i = 0;
    while (i < n) {
        var run = i;
        while (run + 8 <= n) {
            var w = load64(p + run);
            var q = w ^ 0x2222222222222222;
            var bs = w ^ 0x5C5C5C5C5C5C5C5C;
            var zq = (q - 0x0101010101010101) & (-1 ^ q);
            var zb = (bs - 0x0101010101010101) & (-1 ^ bs);
            var lt = (w - 0x2020202020202020) & (-1 ^ w);
            if (((zq | zb | lt) & 0x8080808080808080) != 0) { break; }
            run = run + 8;
        }
        while (run < n && load8(esc + load8(p + run) * 8) == 0) { run = run + 1; }
        var len = run - i;
        if (len > 0) {
            if (t + len > 4096) {
                _sl_sb_bytes(sb, o, t);
                t = 0;
            }
            if (len > 4096) {
                _sl_sb_bytes(sb, p + i, len);
            } else {
                memcpy(o + t, p + i, len);
                t = t + len;
            }
            i = run;
            continue;
        }
        var e = esc + load8(p + i) * 8;
        if (t + 6 > 4096) {
            _sl_sb_bytes(sb, o, t);
            t = 0;
        }
        store8(o + t, 92);
        store8(o + t + 1, load8(e + 2));
        if (load8(e) == 6) {
            store8(o + t + 2, load8(e + 3));
            store8(o + t + 3, load8(e + 4));
            store8(o + t + 4, load8(e + 5));
            store8(o + t + 5, load8(e + 6));
        }
        t = t + load8(e);
        i = i + 1;
    }
    if (t + 1 > 4096) {
        _sl_sb_bytes(sb, o, t);
        t = 0;
    }
    store8(o + t, 34);
    _sl_sb_bytes(sb, o, t + 1);
    return 0;
}

# Appends a Str as a JSON string.
fn _sl_json_str_s(sb, s): i64 {
    return _sl_json_str(sb, str_data(s), str_len(s));
}

# Appends `"key":` for a NUL-terminated key (selah's keys need no escaping).
fn _sl_json_key(sb, key): i64 {
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, 34);
    str_builder_putc(sb, 58);
    return 0;
}

# ── reading ───────────────────────────────────────────────────────────────────────────

# The length of the UTF-8 sequence at p[i] (its first byte 0x80 or above) by Rust's `str::from_utf8` rules (no
# overlong form, no surrogate, nothing past U+10FFFF), or 0 when no valid sequence starts there.
#must_use
fn _sl_utf8_seq(p, i, n): i64 {
    var c = load8(p + i);
    var len = 0;
    var lo = 128;
    var hi = 191;
    if (c >= 194 && c <= 223) {
        len = 2;
    } elif (c == 224) {
        len = 3;
        lo = 160;
    } elif (c >= 225 && c <= 236) {
        len = 3;
    } elif (c == 237) {
        len = 3;
        hi = 159;
    } elif (c >= 238 && c <= 239) {
        len = 3;
    } elif (c == 240) {
        len = 4;
        lo = 144;
    } elif (c >= 241 && c <= 243) {
        len = 4;
    } elif (c == 244) {
        len = 4;
        hi = 143;
    } else {
        return 0;
    }
    if (i + len > n) { return 0; }
    var b1 = load8(p + i + 1);
    if (b1 < lo || b1 > hi) { return 0; }
    var k = 2;
    while (k < len) {
        var b = load8(p + i + k);
        if (b < 128 || b > 191) { return 0; }
        k = k + 1;
    }
    return len;
}

# 1 when p[0..n) is UTF-8 (Rust's `str::from_utf8`).
#must_use
fn _sl_utf8_valid(p, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(p + i) < 128) {
            i = i + 1;
        } else {
            var l = _sl_utf8_seq(p, i, n);
            if (l == 0) { return 0; }
            i = i + l;
        }
    }
    return 1;
}

# 1 when the integer token d[0..n) (digits, after any sign) is beyond i64: more than 19 digits, or 19 digits above
# 9223372036854775807 (9223372036854775808 when negative).
#must_use
fn _sl_json_int_wide(d, n, neg): i64 {
    if (n < 19) { return 0; }
    if (n > 19) { return 1; }
    var lim = "9223372036854775807";
    if (neg == 1) { lim = "9223372036854775808"; }
    var i = 0;
    while (i < 19) {
        var a = load8(d + i);
        var b = load8(lim + i);
        if (a != b) {
            if (a > b) { return 1; }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# The integer token at p[i..): (end index, 1 when serde_json reads it as a float and bayan would not). serde_json
# reads a bare `-0` as the float -0.0 and an integer beyond i64 as u64 or f64, where bayan reads the integer 0 and
# refuses the token. A token with a fraction or exponent is a float to both: (end, 0).
fn _sl_json_num_tok(p, i, n): (i64, i64) {
    var s = i;
    var neg = 0;
    if (load8(p + s) == 45) {
        neg = 1;
        s = s + 1;
    }
    var j = s;
    while (j < n && load8(p + j) >= 48 && load8(p + j) <= 57) { j = j + 1; }
    var e = j;
    var fl = 0;
    while (e < n) {
        var c = load8(p + e);
        if ((c >= 48 && c <= 57) || c == 46 || c == 101 || c == 69 || c == 43 || c == 45) {
            if (c == 46 || c == 101 || c == 69) { fl = 1; }
            e = e + 1;
        } else {
            break;
        }
    }
    if (fl == 1 || e != j) { return (e, 0); }
    if (neg == 1 && j - s == 1 && load8(p + s) == 48) { return (j, 1); }
    return (j, _sl_json_int_wide(p + s, j - s, neg));
}

# The index just past the JSON string whose opening quote is at p[i0 - 1], scanning from i0; -1 when a byte inside it
# is not UTF-8 (Rust's `str::from_utf8` rules). Plain ASCII is skipped a word at a time: a word with no byte that is
# non-ASCII, a quote or a backslash (a SWAR test) has nothing to look at. An unterminated string ends at n (bayan
# refuses it).
fn _sl_json_str_end(p, i0, n): i64 {
    var i = i0;
    while (i < n) {
        if (i + 8 <= n) {
            var w = load64(p + i);
            var q = w ^ 0x2222222222222222;
            var bs = w ^ 0x5C5C5C5C5C5C5C5C;
            var zq = (q - 0x0101010101010101) & (-1 ^ q);
            var zb = (bs - 0x0101010101010101) & (-1 ^ bs);
            if (((w | zq | zb) & 0x8080808080808080) == 0) {
                i = i + 8;
                continue;
            }
        }
        var d = load8(p + i);
        if (d == 34) { return i + 1; }
        if (d == 92) {
            i = i + 2;
        } elif (d >= 128) {
            var l = _sl_utf8_seq(p, i, n);
            if (l == 0) { return -1; }
            i = i + l;
        } else {
            i = i + 1;
        }
    }
    return n;
}

# p[0..n) made ready for bayan to read as serde_json reads it, in one pass: (buffer, length), or (0, 0) when a string
# in it is not UTF-8 (serde_json requires that of every string it keeps; ADR 0002 #21) or a non-ASCII byte stands
# outside a string (not JSON). An integer token serde_json reads as a float gets `.0` appended so bayan reads a float
# too: a bare `-0` keeps its sign, and an integer past i64 is read as the nearest double instead of refused. The input
# comes back unchanged when no token needs it; a rewritten copy is allocated from `a`.
fn _sl_json_prep(a, p, n): (i64, i64) {
    var sb = 0;
    var from = 0;
    var i = 0;
    var hdr: i64[2];
    while (i < n) {
        var c = load8(p + i);
        if (c == 34) {
            i = _sl_json_str_end(p, i + 1, n);
            if (i < 0) { return (0, 0); }
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var e, wide = _sl_json_num_tok(p, i, n);
            if (wide == 1) {
                if (sb == 0) { sb = str_builder_new_a(a); }
                if (sb == 0) { return (0, 0); }
                hdr[0] = p + from;
                hdr[1] = e - from;
                str_builder_add_a(a, sb, &hdr);
                str_builder_add_cstr_a(a, sb, ".0");
                from = e;
            }
            i = e;
        } elif (c >= 128) {
            return (0, 0);
        } else {
            i = i + 1;
        }
    }
    if (sb == 0) { return (p, n); }
    hdr[0] = p + from;
    hdr[1] = n - from;
    str_builder_add_a(a, sb, &hdr);
    var s = str_builder_build_a(a, sb);
    return (str_data(s), str_len(s));
}

# Parse p[0..n) into a bayan value tree, prepared by _sl_json_prep; 0 when it isn't one JSON document.
#must_use
fn _sl_json_parse(p, n): i64 {
    return _sl_json_parse_a(default_alloc(), p, n);
}

# As _sl_json_parse, with the value tree (and any rewritten copy) allocated from `a`.
#must_use
fn _sl_json_parse_a(a, p, n): i64 {
    if (n < 0 || a == 0) { return 0; }
    var q, qn = _sl_json_prep(a, p, n);
    if (q == 0) { return 0; }
    return bayan_json_v_parse_buf_a(a, q, qn);
}

# The member `key` of object v: 0 when v is not an object or has no such member.
#must_use
fn _sl_json_member(v, key): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == false) { return 0; }
    return bayan_json_v_obj_get_by_cstr(v, key);
}

# A JSON number as serde reads it into an f64 field: an integer converts (Rust `as f64`), a float is the parse's
# correctly rounded double. A literal past the f64 range (`1e400`), which bayan reads as infinity, is refused, as
# serde_json refuses it (NumberOutOfRange). Writes the value through `out` and returns 1, or returns 0 for anything
# else.
fn _sl_json_as_f64(v, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT) {
        var d: f64 = f64_from(bayan_json_v_int(v));
        store64(out, d);
        return 1;
    }
    if (tag == JTAG_FLOAT) {
        var bits = bayan_json_v_float(v);
        if (((bits >> 52) & 2047) == 2047) { return 0; }
        store64(out, bits);
        return 1;
    }
    return 0;
}

# A JSON number as serde reads it into an unsigned integer field of at most `max`: an integer 0..=max only (a float,
# even 1.0 or -0, is refused, as serde_json refuses it). Returns the value, or -1.
#must_use
fn _sl_json_as_uint(v, max): i64 {
    if (v == 0) { return -1; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return -1; }
    var x = bayan_json_v_int(v);
    if (x < 0 || x > max) { return -1; }
    return x;
}

# A JSON number as serde reads it into a u8 field: an integer 0..=255 only (a float, even 1.0, is refused, as
# serde_json refuses it). Returns the value, or -1.
#must_use
fn _sl_json_as_u8(v): i64 {
    if (v == 0) { return -1; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return -1; }
    var x = bayan_json_v_int(v);
    if (x < 0 || x > 255) { return -1; }
    return x;
}

# A JSON string's Str, or 0 when v is not a string.
#must_use
fn _sl_json_as_str(v): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    return bayan_json_v_str(v);
}

# serde_json's externally tagged enum forms: a string is a unit variant's name; an object of exactly one member is
# `{"<variant>": <content>}`. Returns the variant's name (a Str) and stores its content value through `content_out`
# (0 for the string form), or returns 0 when v is neither.
fn _sl_json_variant(v, content_out): i64 {
    store64(content_out, 0);
    if (v == 0) { return 0; }
    var s = _sl_json_as_str(v);
    if (s != 0) { return s; }
    if (bayan_json_v_is_obj(v) == false || bayan_json_v_obj_len(v) != 1) { return 0; }
    store64(content_out, bayan_json_v_obj_val(v, 0));
    var k = bayan_json_v_obj_key(v, 0);
    return k;
}

# 1 when a variant's content is what serde accepts for a unit variant: the string form, or `null`.
#must_use
fn _sl_json_unit_content(content): i64 {
    if (content == 0) { return 1; }
    if (bayan_json_v_is_null(content) == true) { return 1; }
    return 0;
}

# A struct read from a JSON array, as serde's derived `visit_seq` does: element i, or 0 when v is not an array of
# exactly `len` elements.
#must_use
fn _sl_json_seq_elem(v, len, i): i64 {
    if (v == 0 || bayan_json_v_is_arr(v) == false) { return 0; }
    if (bayan_json_v_arr_len(v) != len) { return 0; }
    return bayan_json_v_arr_get(v, i);
}

# A struct field, from either serde form: object member `key`, or array element i of `len`.
#must_use
fn _sl_json_field(v, key, len, i): i64 {
    if (v != 0 && bayan_json_v_is_arr(v) == true) { return _sl_json_seq_elem(v, len, i); }
    return _sl_json_member(v, key);
}

# ── a Value's text ────────────────────────────────────────────────────────────────────

# -1, 0 or 1 as the bytes of Str a sort before, equal or after those of Str b.
#must_use
fn _sl_str_cmp(a, b): i64 {
    var an = str_len(a);
    var bn = str_len(b);
    var n = an;
    if (bn < n) { n = bn; }
    var i = 0;
    while (i < n) {
        var x = load8(str_data(a) + i);
        var y = load8(str_data(b) + i);
        if (x != y) {
            if (x < y) { return -1; }
            return 1;
        }
        i = i + 1;
    }
    if (an < bn) { return -1; }
    if (an > bn) { return 1; }
    return 0;
}

# Appends a bayan value as serde_json's Display writes a `Value`: compact, an object's keys in byte order (its Map is
# a BTreeMap), strings escaped as serde escapes them, integers as integers, floats in serde's f64 form.
fn _sl_json_value_fmt(sb, v): i64 {
    if (v == 0) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_NULL) {
        str_builder_add_cstr(sb, "null");
    } elif (tag == JTAG_BOOL) {
        if (bayan_json_v_bool(v) != 0) {
            str_builder_add_cstr(sb, "true");
        } else {
            str_builder_add_cstr(sb, "false");
        }
    } elif (tag == JTAG_INT) {
        str_builder_add_int(sb, bayan_json_v_int(v));
    } elif (tag == JTAG_FLOAT) {
        var d: f64 = 0.0;
        store64(&d, bayan_json_v_float(v));
        _sl_fmt_f64_json(sb, d);
    } elif (tag == JTAG_STR) {
        _sl_json_str_s(sb, bayan_json_v_str(v));
    } elif (tag == JTAG_ARR) {
        str_builder_putc(sb, 91);
        var n = bayan_json_v_arr_len(v);
        var i = 0;
        while (i < n) {
            if (i > 0) { str_builder_putc(sb, 44); }
            _sl_json_value_fmt(sb, bayan_json_v_arr_get(v, i));
            i = i + 1;
        }
        str_builder_putc(sb, 93);
    } else {
        var m = bayan_json_v_obj_len(v);
        var order = fl_alloc(m * 8 + 8);
        var k = 0;
        while (k < m) {
            var j = k;
            while (j > 0 && _sl_str_cmp(bayan_json_v_obj_key(v, load64(order + (j - 1) * 8)),
                bayan_json_v_obj_key(v, k)) > 0) {
                store64(order + j * 8, load64(order + (j - 1) * 8));
                j = j - 1;
            }
            store64(order + j * 8, k);
            k = k + 1;
        }
        str_builder_putc(sb, 123);
        var q = 0;
        while (q < m) {
            if (q > 0) { str_builder_putc(sb, 44); }
            var idx = load64(order + q * 8);
            _sl_json_str_s(sb, bayan_json_v_obj_key(v, idx));
            str_builder_putc(sb, 58);
            _sl_json_value_fmt(sb, bayan_json_v_obj_val(v, idx));
            q = q + 1;
        }
        str_builder_putc(sb, 125);
        fl_free(order);
    }
    return 0;
}

# --- uuid.cyr ---

# uuid.cyr — selah's ids (Rust: uuid 1.29.2 `Uuid`), as 16 bytes in RFC 4122 order.
#
# Written hyphenated and lowercase (serde, Display) or simple (`Uuid::simple`, the SVG arrow-marker ids); read
# through serde, which takes `Uuid::parse_str`'s four forms: hyphenated (36), simple (32 hex), braced (`{…}`, 38)
# and URN (`urn:uuid:` + hyphenated, the prefix in any case), the hex digits in any case. tests/golden/uuid.tsv pins
# both directions.

# A random (version 4, RFC 4122 variant) id into out[0..16). Returns 1, or 0 when the kernel gives no entropy.
fn _sl_uuid_v4(out): i64 {
    if (random_bytes(out, 16) != 16) { return 0; }
    store8(out + 6, (load8(out + 6) & 0x0F) | 0x40);
    store8(out + 8, (load8(out + 8) & 0x3F) | 0x80);
    return 1;
}

# Appends the 16 bytes at b as lowercase hex, hyphenated (8-4-4-4-12) when `hyphens` is 1.
fn _sl_uuid_fmt(sb, b, hyphens): i64 {
    var i = 0;
    while (i < 16) {
        if (hyphens == 1 && (i == 4 || i == 6 || i == 8 || i == 10)) { str_builder_putc(sb, 45); }
        var x = load8(b + i);
        str_builder_putc(sb, load8(_SL_HEX + (x >> 4)));
        str_builder_putc(sb, load8(_SL_HEX + (x & 15)));
        i = i + 1;
    }
    return 0;
}

# The value of one hex digit, or -1.
#must_use
fn _sl_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}

# Parse 32 hex digits from p (skipping a hyphen at each of `hyphens`' positions when 1) into out. 1 on success.
fn _sl_uuid_hex(p, n, out, hyphens): i64 {
    var i = 0;
    var o = 0;
    while (i < n) {
        if (hyphens == 1 && (i == 8 || i == 13 || i == 18 || i == 23)) {
            if (load8(p + i) != 45) { return 0; }
            i = i + 1;
            continue;
        }
        var hi = _sl_hexval(load8(p + i));
        var lo = -1;
        if (i + 1 < n) { lo = _sl_hexval(load8(p + i + 1)); }
        if (hi < 0 || lo < 0) { return 0; }
        if (o >= 16) { return 0; }
        store8(out + o, (hi << 4) | lo);
        o = o + 1;
        i = i + 2;
    }
    if (o != 16) { return 0; }
    return 1;
}

# Parse an id in any of `Uuid::parse_str`'s forms into out[0..16). Returns 1, or 0 when it is none of them.
fn _sl_uuid_parse(p, n, out): i64 {
    if (n == 32) { return _sl_uuid_hex(p, 32, out, 0); }
    if (n == 36) { return _sl_uuid_hex(p, 36, out, 1); }
    if (n == 38 && load8(p) == 123 && load8(p + 37) == 125) { return _sl_uuid_hex(p + 1, 36, out, 1); }
    if (n == 45) {
        var pre = "urn:uuid:";
        var i = 0;
        while (i < 9) {
            var c = load8(p + i);
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != load8(pre + i)) { return 0; }
            i = i + 1;
        }
        return _sl_uuid_hex(p + 9, 36, out, 1);
    }
    return 0;
}

# --- rfc3339.cyr ---

# rfc3339.cyr — selah's timestamps (Rust: chrono 0.4.45 `DateTime<Utc>` through serde).
#
# UPSTREAM(L5): lib/chrono.cyr's iso8601 / iso8601_parse are whole seconds only. A history entry's timestamp keeps
# nanoseconds, so this module writes and reads them as chrono does:
# - writing (serde's `Serialize`): `YYYY-MM-DDTHH:MM:SS[.f]Z`, with the shortest of 0, 3, 6 or 9 fraction digits
#   (chrono's `SecondsFormat::AutoSi`);
# - reading (serde's `Deserialize`, i.e. `DateTime<FixedOffset>::from_str`, chrono's `parse_rfc3339_relaxed`), item
#   by item: every numeric item first skips Unicode whitespace; the year is 1–4 digits, or a sign and any digits;
#   month, day, hour, minute and second are 1–2 digits each; whitespace may surround each `-` and `:`; the date and
#   time are separated by `T`, `t` or one space; an optional `.` and at least one digit gives the nanoseconds (the
#   first nine digits count, the rest are skipped); then optional whitespace and `UTC` (any case), `Z`, `z`, or a
#   sign (`+`, `-`, U+2212) with two hour digits, any run of `:` and whitespace, and two minute digits; trailing
#   whitespace is allowed. Second 60 is a leap second: second 59 with 10^9 added to the nanoseconds.
# tests/golden/rfc3339.tsv pins both directions.

# Days since 1970-01-01 of a proleptic Gregorian date (Howard Hinnant's days_from_civil; any year).
#must_use
fn _sl_days_from_civil(y, m, d): i64 {
    var yy = y;
    if (m <= 2) { yy = yy - 1; }
    var era = yy / 400;
    if (yy < 0 && yy % 400 != 0) { era = era - 1; }
    var yoe = yy - era * 400;
    var mp = (m + 9) % 12;
    var doy = (153 * mp + 2) / 5 + d - 1;
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

# The civil date (y, m, d) of a day count since 1970-01-01 (civil_from_days).
fn _sl_civil_from_days(z0): (i64, i64, i64) {
    var z = z0 + 719468;
    var era = z / 146097;
    if (z < 0 && z % 146097 != 0) { era = era - 1; }
    var doe = z - era * 146097;
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y = yoe + era * 400;
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    var mp = (5 * doy + 2) / 153;
    var d = doy - (153 * mp + 2) / 5 + 1;
    var m = mp + 3;
    if (m > 12) { m = m - 12; }
    if (m <= 2) { y = y + 1; }
    return (y, m, d);
}

# Appends v as exactly `width` decimal digits (v >= 0).
fn _sl_sb_digits_n(sb, v, width): i64 {
    var buf[24];
    var i = width - 1;
    var x = v;
    while (i >= 0) {
        store8(&buf + i, 48 + x % 10);
        x = x / 10;
        i = i - 1;
    }
    return _sl_sb_bytes(sb, &buf, width);
}

# Appends the instant (unix seconds, nanoseconds 0..=1_999_999_999) as chrono's serde writes a DateTime<Utc>,
# without quotes.
fn _sl_rfc3339_fmt(sb, secs, nanos): i64 {
    return _sl_rfc3339_fmt_x(sb, secs, nanos, 1);
}

# As _sl_rfc3339_fmt, as chrono's `to_rfc3339()` writes it: the offset as `+00:00`, not `Z` (the MCP payloads).
fn _sl_rfc3339_fmt_offset(sb, secs, nanos): i64 {
    return _sl_rfc3339_fmt_x(sb, secs, nanos, 0);
}

# The two forms: `zulu` 1 ends with `Z`, 0 with `+00:00`.
fn _sl_rfc3339_fmt_x(sb, secs, nanos, zulu): i64 {
    var days = secs / 86400;
    var sod = secs % 86400;
    if (sod < 0) {
        sod = sod + 86400;
        days = days - 1;
    }
    var y, mo, d = _sl_civil_from_days(days);
    if (y >= 0 && y <= 9999) {
        _sl_sb_digits_n(sb, y, 4);
    } else {
        if (y < 0) { str_builder_putc(sb, 45); } else { str_builder_putc(sb, 43); }
        var ay = y;
        if (ay < 0) { ay = -ay; }
        if (ay < 10000) { _sl_sb_digits_n(sb, ay, 4); } else { str_builder_add_int(sb, ay); }
    }
    str_builder_putc(sb, 45);
    _sl_sb_digits_n(sb, mo, 2);
    str_builder_putc(sb, 45);
    _sl_sb_digits_n(sb, d, 2);
    str_builder_putc(sb, 84);
    var sec = sod % 60;
    var ns = nanos;
    # A leap second is stored as second 59 with 10^9 added; it prints as second 60.
    if (ns >= 1000000000) {
        sec = sec + 1;
        ns = ns - 1000000000;
    }
    _sl_sb_digits_n(sb, sod / 3600, 2);
    str_builder_putc(sb, 58);
    _sl_sb_digits_n(sb, (sod / 60) % 60, 2);
    str_builder_putc(sb, 58);
    _sl_sb_digits_n(sb, sec, 2);
    if (ns != 0) {
        str_builder_putc(sb, 46);
        if (ns % 1000000 == 0) {
            _sl_sb_digits_n(sb, ns / 1000000, 3);
        } elif (ns % 1000 == 0) {
            _sl_sb_digits_n(sb, ns / 1000, 6);
        } else {
            _sl_sb_digits_n(sb, ns, 9);
        }
    }
    if (zulu == 1) {
        str_builder_putc(sb, 90);
    } else {
        str_builder_add_cstr(sb, "+00:00");
    }
    return 0;
}

# ── parsing ──────────────────────────────────────────────────────────────────────────

# The length of the Unicode whitespace character (Rust's char::is_whitespace) at p[i..n), or 0.
#must_use
fn _sl_ws_len(p, i, n): i64 {
    if (i >= n) { return 0; }
    var c = load8(p + i);
    if (c == 32 || (c >= 9 && c <= 13)) { return 1; }
    if (c == 0xC2 && i + 1 < n) {
        var c2 = load8(p + i + 1);
        if (c2 == 0x85 || c2 == 0xA0) { return 2; }
        return 0;
    }
    if (c == 0xE1 && i + 2 < n && load8(p + i + 1) == 0x9A && load8(p + i + 2) == 0x80) { return 3; }
    if (c == 0xE2 && i + 2 < n) {
        var b1 = load8(p + i + 1);
        var b2 = load8(p + i + 2);
        if (b1 == 0x80 && ((b2 >= 0x80 && b2 <= 0x8A) || b2 == 0xA8 || b2 == 0xA9 || b2 == 0xAF)) { return 3; }
        if (b1 == 0x81 && b2 == 0x9F) { return 3; }
        return 0;
    }
    if (c == 0xE3 && i + 2 < n && load8(p + i + 1) == 0x80 && load8(p + i + 2) == 0x80) { return 3; }
    return 0;
}

# The index after any whitespace from i.
#must_use
fn _sl_skip_ws(p, i, n): i64 {
    var j = i;
    loop {
        var w = _sl_ws_len(p, j, n);
        if (w == 0) { return j; }
        j = j + w;
    }
    return j;
}

# chrono's scan::number: between `min` and `max` ASCII digits from i. Returns (value, next index), or (-1, -1).
fn _sl_scan_number(p, i, n, min, max): (i64, i64) {
    var v = 0;
    var k = 0;
    while (k < max && i + k < n) {
        var c = load8(p + i + k);
        if (c < 48 || c > 57) { break; }
        if (v > 92233720368547758) { return (-1, -1); }
        v = v * 10 + (c - 48);
        k = k + 1;
    }
    if (k < min) { return (-1, -1); }
    return (v, i + k);
}

# A numeric item: whitespace, then `width` digits at most (or, when `signed`, a sign and any number). Returns
# (value, next index), or (-1, -1) — a signed item's failure is (-1, -2), since -1 is a value.
fn _sl_rfc_num(p, i, n, width, signed): (i64, i64) {
    var j = _sl_skip_ws(p, i, n);
    if (signed == 1 && j < n && (load8(p + j) == 45 || load8(p + j) == 43)) {
        var neg = load8(p + j) == 45;
        var v, k = _sl_scan_number(p, j + 1, n, 1, 4611686018427387903);
        if (k < 0) { return (-1, -2); }
        if (neg) { return (-v, k); }
        return (v, k);
    }
    var v2, k2 = _sl_scan_number(p, j, n, 1, width);
    if (k2 < 0) { return (-1, -2); }
    return (v2, k2);
}

# A literal byte after optional whitespace (chrono's `Space("")` then `Literal`). The next index, or -1.
#must_use
fn _sl_rfc_lit(p, i, n, ch): i64 {
    var j = _sl_skip_ws(p, i, n);
    if (j >= n || load8(p + j) != ch) { return -1; }
    return j + 1;
}

# 1 when (y, m, d) is a real date.
#must_use
fn _sl_valid_date(y, m, d): i64 {
    if (m < 1 || m > 12 || d < 1) { return 0; }
    var dim = 31;
    if (m == 4 || m == 6 || m == 9 || m == 11) { dim = 30; }
    if (m == 2) {
        dim = 28;
        if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) { dim = 29; }
    }
    if (d > dim) { return 0; }
    return 1;
}

# Parse p[0..n) as chrono reads a DateTime<Utc> (the file header). Stores unix seconds and nanoseconds; returns 1,
# or 0 when chrono refuses it.
fn _sl_rfc3339_parse(p, n, secs_out, nanos_out): i64 {
    var y, i = _sl_rfc_num(p, 0, n, 4, 1);
    if (i < 0) { return 0; }
    i = _sl_rfc_lit(p, i, n, 45);
    if (i < 0) { return 0; }
    var mo, i2 = _sl_rfc_num(p, i, n, 2, 0);
    if (i2 < 0) { return 0; }
    i = _sl_rfc_lit(p, i2, n, 45);
    if (i < 0) { return 0; }
    var d, i3 = _sl_rfc_num(p, i, n, 2, 0);
    if (i3 < 0) { return 0; }
    i = i3;
    if (i >= n) { return 0; }
    var sep = load8(p + i);
    if (sep != 84 && sep != 116 && sep != 32) { return 0; }
    i = i + 1;
    var hh, i4 = _sl_rfc_num(p, i, n, 2, 0);
    if (i4 < 0) { return 0; }
    i = _sl_rfc_lit(p, i4, n, 58);
    if (i < 0) { return 0; }
    var mi, i5 = _sl_rfc_num(p, i, n, 2, 0);
    if (i5 < 0) { return 0; }
    i = _sl_rfc_lit(p, i5, n, 58);
    if (i < 0) { return 0; }
    var ss, i6 = _sl_rfc_num(p, i, n, 2, 0);
    if (i6 < 0) { return 0; }
    i = i6;
    var ns = 0;
    if (i < n && load8(p + i) == 46) {
        var v, k = _sl_scan_number(p, i + 1, n, 1, 9);
        if (k < 0) { return 0; }
        var digits = k - (i + 1);
        var scale = 1;
        var z = digits;
        while (z < 9) {
            scale = scale * 10;
            z = z + 1;
        }
        ns = v * scale;
        i = k;
        while (i < n && load8(p + i) >= 48 && load8(p + i) <= 57) { i = i + 1; }
    }
    i = _sl_skip_ws(p, i, n);
    # The offset.
    var off = 0;
    if (i + 3 <= n && (load8(p + i) | 32) == 117 && (load8(p + i + 1) | 32) == 116 && (load8(p + i + 2) | 32) == 99) {
        i = i + 3;
    } elif (i < n && (load8(p + i) == 90 || load8(p + i) == 122)) {
        i = i + 1;
    } else {
        var neg = 0;
        if (i < n && load8(p + i) == 43) {
            i = i + 1;
        } elif (i < n && load8(p + i) == 45) {
            neg = 1;
            i = i + 1;
        } elif (i + 3 <= n && load8(p + i) == 0xE2 && load8(p + i + 1) == 0x88 && load8(p + i + 2) == 0x92) {
            neg = 1;
            i = i + 3;
        } else {
            return 0;
        }
        if (i + 2 > n) { return 0; }
        var h1 = load8(p + i) - 48;
        var h2 = load8(p + i + 1) - 48;
        if (h1 < 0 || h1 > 9 || h2 < 0 || h2 > 9) { return 0; }
        i = i + 2;
        while (i < n && (load8(p + i) == 58 || _sl_ws_len(p, i, n) > 0)) {
            if (load8(p + i) == 58) { i = i + 1; } else { i = i + _sl_ws_len(p, i, n); }
        }
        if (i + 2 > n) { return 0; }
        var m1 = load8(p + i) - 48;
        var m2 = load8(p + i + 1) - 48;
        if (m1 < 0 || m1 > 5 || m2 < 0 || m2 > 9) { return 0; }
        i = i + 2;
        off = (h1 * 10 + h2) * 3600 + (m1 * 10 + m2) * 60;
        if (neg == 1) { off = -off; }
    }
    if (_sl_skip_ws(p, i, n) != n) { return 0; }
    # chrono's range checks (Parsed's setters, then the date and the offset).
    if (y < -262143 || y > 262142) { return 0; }
    if (hh > 23 || mi > 59 || ss > 60) { return 0; }
    if (off <= -86400 || off >= 86400) { return 0; }
    if (_sl_valid_date(y, mo, d) == 0) { return 0; }
    if (ss == 60) {
        ss = 59;
        ns = ns + 1000000000;
    }
    store64(secs_out, _sl_days_from_civil(y, mo, d) * 86400 + hh * 3600 + mi * 60 + ss - off);
    store64(nanos_out, ns);
    return 1;
}

# --- geometry.cyr ---

# geometry.cyr — selah's rectangle and point (Rust: rust-old/src/geometry.rs, a wrapper over hisab 1.4's Rect).
#
# Port plan D4, D5. hisab 3.4.1 (Cyrius) has no 2D rect, so SlRect is local. It keeps hisab's Rust layout,
# `{min, max}` in f32, so `SlRect_new(x, y, w, h)` stores `x + w` rounded to f32 exactly as Rust does, and
# width = max.x − min.x. Every operation is f32 arithmetic in Rust's order; tests/golden/geometry.tsv pins each one
# bit for bit (a NaN matches any NaN).
#
# Cyrius has no f32 return type, so the accessors (`x`, `y`, `width`, `height`, `area`) return an f64 holding the
# f32's exact value; `f32_from` of it gives the f32 back unchanged (ADR 0002 #15).
#
# JSON (serde's shape, kept for backward compatibility): `{"x":…,"y":…,"width":…,"height":…}`, each an f32 in
# serde_json's form. Reading takes that object or serde's array form `[x, y, width, height]`, each field as an f64
# narrowed `as f32`, then refuses a rect that is not finite, as Rust's custom Deserialize does.

struct SlVec2 { x: f32; y: f32; }
struct SlRect { min_x: f32; min_y: f32; max_x: f32; max_y: f32; }

# Rust's f32::min: the non-NaN operand when one is NaN; otherwise the lesser (glam 0.29.3's Vec2::min).
fn _sl_f32_min(a: f32, b: f32, out: *f32): i64 {
    var da: f64 = f32_to(a);
    var db: f64 = f32_to(b);
    if (db != db) { *out = a; return 0; }
    if (da != da) { *out = b; return 0; }
    if (da < db) { *out = a; return 0; }
    *out = b;
    return 0;
}

# Rust's f32::max: the non-NaN operand when one is NaN; otherwise the greater.
fn _sl_f32_max(a: f32, b: f32, out: *f32): i64 {
    var da: f64 = f32_to(a);
    var db: f64 = f32_to(b);
    if (db != db) { *out = a; return 0; }
    if (da != da) { *out = b; return 0; }
    if (da > db) { *out = a; return 0; }
    *out = b;
    return 0;
}

# 1 when the f32 is finite.
#must_use
fn _sl_f32_finite(a: f32): bool {
    var d: f64 = f32_to(a);
    return d - d == 0.0;
}

# Rust's normalized bounds of one axis, in f64: (min, max) = (f32::min(a, b), f32::max(a, b)) — the non-NaN operand
# when one is NaN; on equal operands (±0 included) b.
fn _sl_axis(a: f64, b: f64): (i64, i64) {
    var lo: f64 = b;
    var hi: f64 = b;
    if (b != b) {
        lo = a;
        hi = a;
    } elif (a == a) {
        if (a < b) { lo = a; }
        if (a > b) { hi = a; }
    }
    return (lo, hi);
}

impl SlVec2 {
    # A point.
    #must_use
    fn new(x: f32, y: f32): SlVec2 {
        var v: SlVec2;
        v.x = x;
        v.y = y;
        return v;
    }
}

impl SlRect {
    # Rust's Rect::new: min = (x, y), max = (x + width, y + height), each sum rounded to f32. A negative size is kept
    # (an arrow's direction).
    #must_use
    fn new(x: f32, y: f32, width: f32, height: f32): SlRect {
        var r: SlRect;
        r.min_x = x;
        r.min_y = y;
        r.max_x = x + width;
        r.max_y = y + height;
        return r;
    }

    # X of the origin corner (min.x), as the f32's exact f64.
    #must_use
    fn x(self): f64 {
        var d: f64 = f32_to(self.min_x);
        return d;
    }

    # Y of the origin corner (min.y), as the f32's exact f64.
    #must_use
    fn y(self): f64 {
        var d: f64 = f32_to(self.min_y);
        return d;
    }

    # The signed width, max.x − min.x in f32, as its exact f64.
    #must_use
    fn width(self): f64 {
        var w: f32 = self.max_x - self.min_x;
        var d: f64 = f32_to(w);
        return d;
    }

    # The signed height, max.y − min.y in f32, as its exact f64.
    #must_use
    fn height(self): f64 {
        var h: f32 = self.max_y - self.min_y;
        var d: f64 = f32_to(h);
        return d;
    }

    # |width| × |height| in f32, as its exact f64.
    #must_use
    fn area(self): f64 {
        var w: f32 = self.max_x - self.min_x;
        var h: f32 = self.max_y - self.min_y;
        var wd: f64 = f32_to(w);
        var hd: f64 = f32_to(h);
        var aw: f32 = f32_from(f64_abs(wd));
        var ah: f32 = f32_from(f64_abs(hd));
        var a: f32 = aw * ah;
        var d: f64 = f32_to(a);
        return d;
    }

    # (min + max) × 0.5, each component in f32 (hisab's Rect::center).
    #must_use
    fn center(self): SlVec2 {
        var half: f32 = f32_from(0.5);
        var cx: f32 = self.min_x + self.max_x;
        var cy: f32 = self.min_y + self.max_y;
        var c: SlVec2;
        c.x = cx * half;
        c.y = cy * half;
        return c;
    }

    # 1 when all four layout values are finite.
    #must_use
    fn is_finite(self): bool {
        if (_sl_f32_finite(self.min_x) == false) { return false; }
        if (_sl_f32_finite(self.min_y) == false) { return false; }
        if (_sl_f32_finite(self.max_x) == false) { return false; }
        return _sl_f32_finite(self.max_y);
    }

    # min = min(min, max), max = max(min, max), per component (Rust's f32::min / f32::max).
    #must_use
    fn normalized(self): SlRect {
        var r: SlRect;
        var t: f32 = self.min_x;
        _sl_f32_min(self.min_x, self.max_x, &t);
        r.min_x = t;
        _sl_f32_min(self.min_y, self.max_y, &t);
        r.min_y = t;
        _sl_f32_max(self.min_x, self.max_x, &t);
        r.max_x = t;
        _sl_f32_max(self.min_y, self.max_y, &t);
        r.max_y = t;
        return r;
    }

    # 1 when p lies in the normalized rect, edges included.
    #must_use
    fn contains_point(self, p: SlVec2): bool {
        var x0, x1 = _sl_axis(f32_to(self.min_x), f32_to(self.max_x));
        var y0, y1 = _sl_axis(f32_to(self.min_y), f32_to(self.max_y));
        var px: f64 = f32_to(p.x);
        var py: f64 = f32_to(p.y);
        var lx: f64 = x0;
        var hx: f64 = x1;
        var ly: f64 = y0;
        var hy: f64 = y1;
        return px >= lx && px <= hx && py >= ly && py <= hy;
    }

    # 1 when the normalized rects overlap with positive area (touching edges don't).
    #must_use
    fn intersects(self, other: *SlRect): bool {
        var a0, a1 = _sl_axis(f32_to(self.min_x), f32_to(self.max_x));
        var b0, b1 = _sl_axis(f32_to(other.min_x), f32_to(other.max_x));
        var ax0: f64 = a0;
        var ax1: f64 = a1;
        var bx0: f64 = b0;
        var bx1: f64 = b1;
        if ((ax0 < bx1 && ax1 > bx0) == false) { return false; }
        var c0, c1 = _sl_axis(f32_to(self.min_y), f32_to(self.max_y));
        var d0, d1 = _sl_axis(f32_to(other.min_y), f32_to(other.max_y));
        var ay0: f64 = c0;
        var ay1: f64 = c1;
        var by0: f64 = d0;
        var by1: f64 = d1;
        return ay0 < by1 && ay1 > by0;
    }

    # Appends serde's JSON for the rect: {"x":…,"y":…,"width":…,"height":…}.
    fn to_json(self, sb): i64 {
        var w: f32 = self.max_x - self.min_x;
        var h: f32 = self.max_y - self.min_y;
        str_builder_add_cstr(sb, "{\"x\":");
        _sl_fmt_f32_json(sb, self.min_x);
        str_builder_add_cstr(sb, ",\"y\":");
        _sl_fmt_f32_json(sb, self.min_y);
        str_builder_add_cstr(sb, ",\"width\":");
        _sl_fmt_f32_json(sb, w);
        str_builder_add_cstr(sb, ",\"height\":");
        _sl_fmt_f32_json(sb, h);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Appends Rust's Debug of a rect (derived on selah's `Rect(hisab::Rect)`, glam's Vec2 Debug inside):
# `Rect(Rect { min: Vec2(x, y), max: Vec2(x, y) })`, each coordinate as f32 Debug.
fn _sl_rect_debug(sb, r: SlRect): i64 {
    str_builder_add_cstr(sb, "Rect(Rect { min: Vec2(");
    _sl_fmt_f32_debug(sb, r.min_x);
    str_builder_add_cstr(sb, ", ");
    _sl_fmt_f32_debug(sb, r.min_y);
    str_builder_add_cstr(sb, "), max: Vec2(");
    _sl_fmt_f32_debug(sb, r.max_x);
    str_builder_add_cstr(sb, ", ");
    _sl_fmt_f32_debug(sb, r.max_y);
    str_builder_add_cstr(sb, ") })");
    return 0;
}

# Rust's Rect::default(): new(0, 0, 0, 0).
#must_use
fn SlRect_default(): SlRect {
    var z: f32 = f32_from(0.0);
    return SlRect_new(z, z, z, z);
}

# Read a rect from a parsed JSON value into *out, as Rust's Deserialize does: an object {x, y, width, height}, or
# serde's array form [x, y, width, height]. Ok(0), or Err(SL_ERR_SERDE).
fn _sl_rect_from_value(v, out: *SlRect, detail_out): Result {
    if (v == 0 || (bayan_json_v_is_obj(v) == false && bayan_json_v_is_arr(v) == false)) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: expected a JSON object or array");
    }
    var x: f64 = 0.0;
    var y: f64 = 0.0;
    var w: f64 = 0.0;
    var h: f64 = 0.0;
    if (_sl_json_as_f64(_sl_json_field(v, "x", 4, 0), &x) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `x` is missing or not a number");
    }
    if (_sl_json_as_f64(_sl_json_field(v, "y", 4, 1), &y) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `y` is missing or not a number");
    }
    if (_sl_json_as_f64(_sl_json_field(v, "width", 4, 2), &w) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `width` is missing or not a number");
    }
    if (_sl_json_as_f64(_sl_json_field(v, "height", 4, 3), &h) == 0) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: `height` is missing or not a number");
    }
    var r = SlRect_new(f32_from(x), f32_from(y), f32_from(w), f32_from(h));
    if (r.is_finite() == false) {
        return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect coordinates must be finite and within f32 range");
    }
    *out = r;
    return Ok(0);
}

# Read a rect from JSON text p[0..n) into *out. Ok(0), or Err(SL_ERR_SERDE).
fn SlRect_from_json(p, n, out: *SlRect, detail_out = 0): Result {
    var v = _sl_json_parse(p, n);
    if (v == 0) { return _sl_fail_cstr(SL_ERR_SERDE, detail_out, "rect: not a JSON document"); }
    return _sl_rect_from_value(v, out, detail_out);
}

