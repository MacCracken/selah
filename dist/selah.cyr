# --- error.cyr ---

# error.cyr — selah's error codes (Rust: `SelahError`, rust-old/src/error.rs).
#
# Port plan D7, ADR 0002 #10. A fallible function returns a value-form `Result`: `Ok(value)` or `Err(SL_ERR_*)`.
# Rust's variants carry a `String`; here the text goes through the caller's optional trailing `detail_out`
# argument (a pointer to one i64 slot): when it is non-zero, the failing function stores a `Str` there, the same
# text the Rust variant held. `selah_error_display` adds the variant's prefix, as Rust's Display does.
#
# Values are append-only and never renumbered (the Rust enum is #[non_exhaustive]).

enum SlError {
    SL_ERR_NONE = 0;
    SL_ERR_CAPTURE_FAILED = 1;
    SL_ERR_INVALID_REGION = 2;
    SL_ERR_UNSUPPORTED_FORMAT = 3;
    SL_ERR_ANNOTATION = 4;
    SL_ERR_IO = 5;
    SL_ERR_API = 6;
    # A JSON document selah reads was refused. Rust surfaces serde_json's error inside another variant, or (in
    # the from_json paths the port exposes) as serde_json::Error itself; the port's message is its own
    # (ADR 0002 #14).
    SL_ERR_SERDE = 7;
}

# The variant's name, as Rust spells it.
#must_use
fn selah_error_name(code): i64 {
    match code {
        SL_ERR_NONE => { return "None"; }
        SL_ERR_CAPTURE_FAILED => { return "CaptureFailed"; }
        SL_ERR_INVALID_REGION => { return "InvalidRegion"; }
        SL_ERR_UNSUPPORTED_FORMAT => { return "UnsupportedFormat"; }
        SL_ERR_ANNOTATION => { return "AnnotationError"; }
        SL_ERR_IO => { return "Io"; }
        SL_ERR_API => { return "Api"; }
        SL_ERR_SERDE => { return "serde"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# The prefix Rust's Display writes before the message ("capture failed: ").
#must_use
fn _sl_error_prefix(code): i64 {
    match code {
        SL_ERR_CAPTURE_FAILED => { return "capture failed: "; }
        SL_ERR_INVALID_REGION => { return "invalid region: "; }
        SL_ERR_UNSUPPORTED_FORMAT => { return "unsupported format: "; }
        SL_ERR_ANNOTATION => { return "annotation error: "; }
        SL_ERR_IO => { return "IO error: "; }
        SL_ERR_API => { return "API error: "; }
        SL_ERR_SERDE => { return "JSON error: "; }
        _ => { return "error: "; }
    }
    return "error: ";
}

# Appends Rust's Display of the error: the variant's prefix, then the message (`msg` a Str, or 0).
fn selah_error_fmt(sb, code, msg): i64 {
    str_builder_add_cstr(sb, _sl_error_prefix(code));
    if (msg != 0) { str_builder_add(sb, msg); }
    return 0;
}

# Rust's Display of the error as a new Str.
#must_use
fn selah_error_display(code, msg): Str {
    var sb = str_builder_new();
    selah_error_fmt(sb, code, msg);
    return str_builder_build(sb);
}

# A pointer as a plain address: typed-pointer arithmetic steps by sizeof(T), so byte offsets go through this.
#must_use
fn _sl_addr(p): i64 {
    return p;
}

# Store `msg` (a Str) through `detail_out` when the caller asked for it, and fail with `code`.
fn _sl_fail(code, detail_out, msg): Result {
    if (detail_out != 0) { store64(detail_out, msg); }
    return Err(code);
}

# As _sl_fail, from a NUL-terminated string.
fn _sl_fail_cstr(code, detail_out, cmsg): Result {
    if (detail_out != 0) { store64(detail_out, str_from(cmsg)); }
    return Err(code);
}

# --- version_str.cyr ---

# version_str.cyr — selah's version at run time, from `VERSION` (sandhi's src/version_str.cyr pattern).
#
# `VERSION` is the source of truth; this literal must equal it, and tests/selah.tcyr fails when they disagree. The
# HTTP User-Agent is `selah/<version>`, as Rust's `concat!("selah/", env!("CARGO_PKG_VERSION"))`.
# CYRIUS_PKG_VERSION would not do: inside a consumer's build it is the consumer's version.

var SL_VERSION = "0.30.0";

# --- log.cyr ---

# log.cyr — selah's tracing, through sakshi (Rust: `tracing`; port plan D11).
#
# The contract is bote's (bote/src/log.cyr):
# - Every line goes through sakshi, to sakshi's configured output (stderr unless the embedder says otherwise). Never
#   stdout: on the MCP stdio transport stdout is the JSON-RPC wire.
# - Library code never configures sakshi. selah calls `_sl_log_*`, and sakshi's level filter decides.
# - Levels: WARN for a refusal or anomaly selah survives (an unlocatable PII match, a lock timeout), INFO for an
#   outcome (an image captured, copied to the clipboard), DEBUG for one line per operation.
# - Never log a secret or content: no API key, image bytes, OCR text or annotation text. A size, a count, a format,
#   a status or a path does.

# A WARN line.
fn _sl_log_warn(msg): i64 {
    sakshi_warn(msg, strlen(msg));
    return 0;
}

# An INFO line.
fn _sl_log_info(msg): i64 {
    sakshi_info(msg, strlen(msg));
    return 0;
}

# A DEBUG line.
fn _sl_log_debug(msg): i64 {
    sakshi_debug(msg, strlen(msg));
    return 0;
}

# A line with one key/value field: `level` is sakshi's (SK_WARN, SK_INFO, SK_DEBUG); `val` a NUL-terminated string.
fn _sl_log_kv(level, msg, key, val): i64 {
    sakshi_log_kv(level, msg, strlen(msg), key, strlen(key), val, strlen(val));
    return 0;
}

# --- scratch.cyr ---

# scratch.cyr — a per-call allocator on the freelist (port plan D10).
#
# UPSTREAM(L22): sandhi's buffered client reserves its whole response cap in the allocator it is given.
# UPSTREAM(L24): the freelist maps every block over 4 KiB afresh; the arenas keep one spare chunk (below).
#
# sandhi and bayan take an allocator (their `_a` forms). Their default is the bump heap, which never frees, so every
# request, response and parse would stay with the process for its lifetime: the shape L16 and L19 describe for chitra
# and bayan's base64. A scratch allocator is an arena whose memory comes from the freelist and goes back to it:
#   - small blocks are carved from 64 KiB chunks; `reset_via` rewinds to the first chunk and keeps the chain, so a
#     loop that resets per item (a history line) settles at its high-water mark and stops allocating;
#   - a block over 16 KiB gets its own freelist block, a fresh mapping, so a 256 MiB response cap costs only the pages
#     a response touches; the reset returns those to the OS;
#   - every block is zeroed (a fresh mapping already is);
#   - a free is a no-op, as in an arena: sandhi and bayan were written for arenas, so a block they free may still be
#     read (measured: freeing early corrupted the heap in tests/parity.tcyr);
#   - `_sl_scratch_free` returns everything.
# One freelist block holds the Allocator vtable (lib/alloc.cyr's 40-byte layout) and the state after it:
#   +40 current chunk   +48 position   +56 end   +64 first chunk   +72 big blocks (a freelist array)   +80 count
#   +88 capacity
# A chunk is { next, size } then its data. Not thread-safe: one per call, on one thread.
# One spare chunk outlives the arenas (_sl_scratch_spare): the freelist maps anything over 4 KiB afresh, so an arena per
# call would map and unmap a chunk each time, about 6 µs, plus about 2 µs for each page it touches (measured, M6).

const _SL_SCRATCH_CHUNK = 65536;
const _SL_SCRATCH_BIG = 16384;

# The spare chunk, or 0. Taken and given back with a compare-and-swap, so two threads never hold it at once.
var _sl_scratch_spare = 0;

# A chunk for an arena: the spare when there is one, else a fresh one (0 when out of memory).
fn _sl_scratch_chunk_take(): i64 {
    var sp = atomic_load(&_sl_scratch_spare);
    if (sp != 0 && atomic_cas(&_sl_scratch_spare, sp, 0) == 1) { return sp; }
    return fl_alloc(_SL_SCRATCH_CHUNK + 16);
}

# Gives a chunk back: it becomes the spare when there is none, else it returns to the freelist.
fn _sl_scratch_chunk_give(ch): i64 {
    if (atomic_cas(&_sl_scratch_spare, 0, ch) == 0) { fl_free(ch); }
    return 0;
}

# Records a big block. Returns 1, or 0 when the list cannot grow.
fn _sl_scratch_track(st, p): i64 {
    var n = load64(st + 40);
    var cap = load64(st + 48);
    if (n == cap) {
        var ncap = cap * 2;
        if (ncap < 16) { ncap = 16; }
        var nb = fl_alloc(ncap * 8);
        if (nb == 0) { return 0; }
        var old = load64(st + 32);
