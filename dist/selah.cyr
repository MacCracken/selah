            memcpy(nb, old, n * 8);
            fl_free(old);
        }
        store64(st + 32, nb);
        store64(st + 48, ncap);
    }
    store64(load64(st + 32) + n * 8, p);
    store64(st + 40, n + 1);
    return 1;
